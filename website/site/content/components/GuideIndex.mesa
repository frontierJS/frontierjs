<!--
  A package guide's landing page: what the guide is, and every page in it. A
  route's `index.meta.js` hands over the sections and the guide's name, base and
  copy; the sections are the list the sidebar reads.
-->
<script>
  import DocsShell from './DocsShell.mesa'

  export let data = null

  const sections = data?.sections ?? []
  const info     = data?.guide ?? { name: '', base: '', heading: '', lede: '' }
  const nav      = data?.nav
</script>

<DocsShell {nav} current={info.base}>
  <article class="prose">
    <p class="crumb"><a href="/docs/">Docs</a> / {info.name}</p>
    <h1>{info.heading}</h1>
    <p class="lede">{info.lede}</p>
    {#if sections.length}
      <p><a class="btn" href={sections[0].pages[0].href}>Start with {sections[0].pages[0].title}</a></p>
    {/if}

    {#each sections as s}
      <section class="sect">
        <h2>{s.section}</h2>
        <ul>
          {#each s.pages as p}
            <li><a href={p.href}>{p.title}</a></li>
          {/each}
        </ul>
      </section>
    {/each}
  </article>
</DocsShell>

<style>
  .prose { max-width: 48rem; line-height: 1.7; color: var(--ink-soft); }
  .crumb { font-size: .78rem; color: var(--ink-mute); margin: 0 0 .75rem; }
  .crumb a { color: inherit; }
  h1 { font-size: clamp(1.9rem, 4.5vw, 2.6rem); letter-spacing: -.03em; line-height: 1.1; margin: 0 0 1rem; color: var(--ink); }
  .lede { font-size: 1.1rem; }

  .sect { border-top: 1px solid var(--rule); margin-top: 1.75rem; padding-top: 1.25rem; }
  .sect h2 { font-size: 1.1rem; margin: 0 0 .5rem; color: var(--ink); }
  .sect ul { margin: 0; padding-left: 1.1rem; columns: 2 16rem; }
</style>
