---
title: FrontierJS — coming soon
description: One schema file seeds your database, your API, and your UI. FrontierJS is coming soon — read the journey while it gets there.
render: static
---
<!--
  The splash. One screen that says what is coming and hands the reader to the
  journey; the long-form case is /pitch/. No script beyond the layout's theme
  island, so the motion here is CSS and stops under reduced-motion.
-->
<script>
  import Marquee from '@frontierjs/site-kit/blocks/Marquee.mesa'
  import { derived } from '../data/derived.js'
</script>

<section id="top" class="splash">
  <div class="backdrop" aria-hidden="true">
    <div class="layer ground">
      <div class="map"></div>
      <div class="drift shadows"></div>
    </div>
    <div class="layer wisps"><div class="drift"></div></div>
    <div class="layer lows"><div class="drift"></div></div>
  </div>
  <div class="veil" aria-hidden="true"></div>
  <div class="glow" aria-hidden="true"></div>

  <div class="container inner">
    <!-- <p class="eyebrow">
      <span class="badge warning">Coming soon</span>
      FrontierJS
    </p> -->

    <h1>The Frontier<br><span class="accent">is coming.</span></h1>

    <p class="lede">
      One starting source of truth. Get your database, API and UI
      …with validation, authorization, pagination, live updates, migrations, typed clients and forms
      <strong>derived, not written</strong>.
    </p>

    <div class="cluster ctas">
      <a class="btn text-xl raised glass" href="/journey/">Follow the journey →</a>
    </div>
  </div>
</section>

<section class="derived" aria-labelledby="derived-title">
  <h2 id="derived-title" class="container">Derived from the schema, extended by you</h2>
  <Marquee label="Everything the schema derives" duration="860s" gap="1rem">
    {#each derived as d}
      <article class="feature">
        <h3>{d.title}</h3>
        <p>{d.line}</p>
        {#if d.tag}<code>{d.tag}</code>{/if}
      </article>
    {/each}
  </Marquee>
</section>

<style>
  .splash {
    position: relative; overflow: hidden; isolation: isolate;
    min-height: calc(100svh - var(--sticky-offset, 4rem));
    display: grid; align-items: center;
    padding: 4rem 0 5rem;
    font-family: var(--font-primary);
  }

  /* The territory map, toured: six stops and back to the first, so the loop
     has no seam. A stop is a zoom and the point it zooms toward, as a share of
     the box; zooming toward a point inside the box never uncovers an edge,
     which a translate past the scaled overhang would.

     Three cloud tiles ride the same tour. The shadows lie on the ground and
     scale with the map; the wisps and the low clouds scale by --depth times as
     much toward the same point, so on a dive they open past the camera faster
     than the land below them. Each tile also drifts on its own clock, and
     wraps, so the drift has no seam either.
     /splash-tune/ edits all of this live and prints the block back to paste. */
  .backdrop {
    position: absolute; inset: 0; z-index: -3;
    container-type: size;
    --tour-length: 180s;
    --tour-easing: ease-in-out;
    --stop0-zoom: 1.9;   --stop0-x: 72%; --stop0-y: 42%;
    --stop1-zoom: 2.3;   --stop1-x: 88%; --stop1-y: 24%;
    --stop2-zoom: 1.15;  --stop2-x: 60%; --stop2-y: 50%;
    --stop3-zoom: 2.0;   --stop3-x: 74%; --stop3-y: 74%;
    --stop4-zoom: 1.7;   --stop4-x: 94%; --stop4-y: 86%;
    --stop5-zoom: 1.0;   --stop5-x: 50%; --stop5-y: 50%;
    --shadow-opacity: .8;  --shadow-drift: 300s;
    --wisp-opacity: .7;    --wisp-drift: 200s;   --wisp-depth: 1.25;
    --low-opacity: .9;     --low-drift: 140s;    --low-depth: 1.4;
  }
  .layer {
    position: absolute; inset: 0;
    will-change: transform, transform-origin;
    animation: tour var(--tour-length) var(--tour-easing) infinite;
  }
  .ground { --depth: 1; }
  .wisps  { --depth: var(--wisp-depth); opacity: var(--wisp-opacity); }
  .lows   { --depth: var(--low-depth);  opacity: var(--low-opacity); }

  .map {
    position: absolute; inset: 0;
    background: url('/fjs-map-2.png') 70% 40% / cover no-repeat;
    filter: saturate(.9);
  }

  /* One tile is at least as tall as the box, so it repeats only sideways, and
     a drift of exactly one tile width lands where it started. */
  .drift {
    --tile: max(100cqw, 160cqh);
    position: absolute; top: 0; left: 0; height: 100%;
    width: calc(100% + var(--tile));
    background: var(--sprites) 0 50% / var(--tile) auto repeat-x;
    will-change: transform;
    animation: wind var(--drift) linear infinite;
  }
  .shadows {
    --sprites: url('/map/clouds-shadow.webp'); --drift: var(--shadow-drift);
    opacity: var(--shadow-opacity); mix-blend-mode: multiply;
  }
  .wisps .drift { --sprites: url('/map/clouds-wisp.webp'); --drift: var(--wisp-drift); }
  .lows .drift  { --sprites: url('/map/clouds-low.webp');  --drift: var(--low-drift); }

  @keyframes tour {
    0%, 100% { transform: scale(calc(1 + (var(--stop0-zoom) - 1) * var(--depth))); transform-origin: var(--stop0-x) var(--stop0-y); }
    16.667%  { transform: scale(calc(1 + (var(--stop1-zoom) - 1) * var(--depth))); transform-origin: var(--stop1-x) var(--stop1-y); }
    33.333%  { transform: scale(calc(1 + (var(--stop2-zoom) - 1) * var(--depth))); transform-origin: var(--stop2-x) var(--stop2-y); }
    50%      { transform: scale(calc(1 + (var(--stop3-zoom) - 1) * var(--depth))); transform-origin: var(--stop3-x) var(--stop3-y); }
    66.667%  { transform: scale(calc(1 + (var(--stop4-zoom) - 1) * var(--depth))); transform-origin: var(--stop4-x) var(--stop4-y); }
    83.333%  { transform: scale(calc(1 + (var(--stop5-zoom) - 1) * var(--depth))); transform-origin: var(--stop5-x) var(--stop5-y); }
  }
  @keyframes wind {
    to { transform: translateX(calc(-1 * var(--tile))); }
  }

  /* Mixed from --surface rather than a fixed white, so a dark theme dims the
     map instead of washing it out; the copy sits on the solid side. */
  .veil {
    position: absolute; inset: 0; z-index: -2;
    background:
      linear-gradient(to bottom, transparent 55%, var(--surface) 98%),
      linear-gradient(100deg,
        var(--surface) 0%,
        color-mix(in srgb, var(--surface) 88%, transparent) 38%,
        color-mix(in srgb, var(--surface) 55%, transparent) 70%,
        color-mix(in srgb, var(--surface) 35%, transparent) 100%);
  }
  @media (max-width: 48rem) {
    .veil {
      background:
        linear-gradient(to bottom, transparent 55%, var(--surface) 98%),
        color-mix(in srgb, var(--surface) 84%, transparent);
    }
  }

  /* Tinted from the theme's own primary, so every swatch in the topbar
     retints the splash rather than leaving a fixed color behind. */
  .glow {
    position: absolute; inset: -20% -10% auto auto; z-index: -1;
    width: min(60rem, 120vw); aspect-ratio: 1; border-radius: 50%;
    background: radial-gradient(closest-side,
      color-mix(in srgb, var(--color-primary) 28%, transparent),
      transparent 70%);
    filter: blur(20px);
    animation: drift 14s ease-in-out infinite alternate;
  }
  @keyframes drift {
    from { transform: translate(0, 0) scale(1); }
    to   { transform: translate(-12%, 18%) scale(1.15); }
  }

  .inner { display: grid; gap: 1.5rem; justify-items: start; padding-inline: 1.25rem; }

  .eyebrow {
    display: flex; align-items: center; gap: .75rem; margin: 0;
    font-size: .78rem; letter-spacing: .12em; text-transform: uppercase; color: var(--ink-mute);
  }
  .eyebrow .badge { letter-spacing: .06em; }

  h1 {
    font-size: clamp(2.75rem, 10vw, 6rem); line-height: .98; letter-spacing: -.04em;
    margin: 0;
  }
  .accent { color: var(--color-primary); }

  .lede { font-size: clamp(1.05rem, 2.2vw, 1.3rem); color: var(--ink-soft); max-width: 44ch; margin: 0; }

  .realms {
    list-style: none; padding: 0; margin: .5rem 0 0;
    display: flex; flex-wrap: wrap; align-items: center; gap: .6rem;
  }
  .realms li:not(.arrow) {
    display: flex; flex-direction: column; gap: .1rem;
    padding: .55rem .95rem; border-radius: var(--radius, 10px);
    border: 1px solid var(--rule-strong); background: var(--surface-raised);
    animation: rise .6s ease-out both;
  }
  .realms li:nth-child(3) { animation-delay: .15s; }
  .realms li:nth-child(5) { animation-delay: .3s; }
  .realms b { font-size: 1rem; }
  .realms span { font-size: .75rem; color: var(--ink-mute); }
  .realms .arrow { color: var(--ink-mute); }
  @keyframes rise {
    from { opacity: 0; transform: translateY(.5rem); }
    to   { opacity: 1; transform: none; }
  }

  .ctas { gap: .75rem; margin-top: .75rem; }
  /* An untoned ghost takes --color-primary, which is below AA on --surface in
     two shipped themes; the neutral ink is legible in all six. */
  .btn.ghost { color: var(--ink); }

  .promises {
    list-style: none; padding: 0; margin: 2rem 0 0;
    display: grid; gap: 1rem 2rem; width: 100%;
    grid-template-columns: repeat(auto-fit, minmax(15rem, 1fr));
    border-top: 1px solid var(--rule); padding-top: 1.5rem;
  }
  .promises li { font-size: .92rem; color: var(--ink-soft); }
  .promises b { color: var(--ink); display: block; margin-bottom: .2rem; }

  .derived { padding: 1rem 0 4rem; font-family: var(--font-primary); }
  .derived h2 {
    margin: 0 auto 1.25rem; padding-inline: 1.25rem;
    font-size: .78rem; font-weight: 600; letter-spacing: .12em; text-transform: uppercase;
    color: var(--ink-mute);
  }
  .feature {
    width: 17rem; flex-shrink: 0;
    display: flex; flex-direction: column; gap: .45rem;
    padding: 1.1rem 1.2rem; border-radius: var(--radius, 10px);
    border: 1px solid var(--rule-strong); background: var(--surface-raised);
  }
  .feature h3 { margin: 0; font-size: 1.05rem; letter-spacing: -.01em; color: var(--ink); }
  .feature p  { margin: 0; font-size: .88rem; line-height: 1.45; color: var(--ink-soft); }
  .feature code {
    margin-top: auto; align-self: flex-start;
    font-family: var(--font-mono, ui-monospace, Menlo, monospace); font-size: .75rem;
    color: var(--color-primary);
  }

  @media (prefers-reduced-motion: reduce) {
    .layer, .drift, .glow, .realms li { animation: none; }
  }
</style>
