  h1 { font-size: clamp(2rem, 5vw, 2.9rem); line-height: 1.08; letter-spacing: -.03em; margin: .3em 0 .5em; }
  .lede { font-size: 1.2rem; line-height: 1.6; color: var(--ink-soft); }

  section { padding-top: 1.5rem; margin-top: 1.5rem; scroll-margin-top: calc(var(--sticky-offset) + 1rem); }
  h2 { font-size: 1.45rem; letter-spacing: -.01em; margin: 0 0 .75rem; }
  section p, section li { font-size: 1.05rem; line-height: 1.75; color: var(--ink-soft); }
  section li + li { margin-top: .4rem; }
  .code { font-size: var(--text-xs); margin: 1.25rem 0; }

  .table-wrap { overflow-x: auto; margin: 1.25rem 0; }
  table { border-collapse: collapse; width: 100%; font-size: .95rem; }
  th, td { text-align: left; padding: .5rem .75rem .5rem 0; border-bottom: 1px solid var(--rule); vertical-align: top; }
  th { font-size: .8rem; text-transform: uppercase; letter-spacing: .06em; color: var(--ink-mute); font-weight: 600; }
  .ladder td:nth-child(odd) { color: var(--ink-mute); font-variant-numeric: tabular-nums; width: 2rem; }

  .axioms { list-style: none; padding: 0; }
  .axioms li { padding: .4rem 0; }

  .next { border-top: 1px solid var(--rule); margin-top: 3rem; padding-top: 1.5rem; }
  .next p { line-height: 1.75; color: var(--ink-soft); }
</style>
