title: "Concepts — FrontierJS docs"
description: "The FrontierJS mental model: one schema seeds three realms, Data, API and UI, and everything in an app traces back to it."
render: static
---
<!--
  Concepts: what a FrontierJS app is. Everything here is checkable inside one
  app's folder; what sits around an app (packages, fleet, tooling) is the
  Ecosystem page. The step-by-step proof of each idea is the tour, so a
  section here states the idea once and links there rather than walking it.
-->
<script>
  import DocsShell from '../../components/DocsShell.mesa'

  export let data = null

  const sample = data?.samples ?? {}
  const toc = [
    { href: '#schema', title: 'The schema' },
    { href: '#realms', title: 'Three realms' },
    { href: '#declare', title: 'Declare first' },
    { href: '#access', title: 'Access' },
    { href: '#chain', title: 'The chain' },
    { href: '#change', title: 'Change' },
    { href: '#surfaces', title: 'Surfaces' },
    { href: '#axioms', title: 'Three axioms' },
