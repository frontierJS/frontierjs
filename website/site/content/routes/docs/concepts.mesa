  section { border-top: 1px solid var(--rule); padding: 2rem 0 1rem; margin-top: 2rem; scroll-margin-top: calc(var(--sticky-offset) + 1rem); }
  h2 { font-size: 1.4rem; letter-spacing: -.01em; margin: 0 0 .75rem; }
  section p, section li { line-height: 1.65; color: var(--ink-soft); }
  section li + li { margin-top: .35rem; }
  .code { font-size: var(--text-xs); margin: 1rem 0; }
