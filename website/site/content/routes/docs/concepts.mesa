  .table-wrap { overflow-x: auto; margin: 1rem 0; }
  table { border-collapse: collapse; width: 100%; font-size: .925rem; }
  th, td { text-align: left; padding: .5rem .75rem .5rem 0; border-bottom: 1px solid var(--rule); vertical-align: top; }
  th { font-size: .8rem; text-transform: uppercase; letter-spacing: .06em; color: var(--ink-mute); font-weight: 600; }
  .ladder td:nth-child(odd) { color: var(--ink-mute); font-variant-numeric: tabular-nums; width: 2rem; }

  .axioms { list-style: none; padding: 0; }
