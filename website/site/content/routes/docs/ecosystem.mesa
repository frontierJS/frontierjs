  th { font-size: .8rem; text-transform: uppercase; letter-spacing: .06em; color: var(--ink-mute); font-weight: 600; }
  td:first-child { white-space: nowrap; font-weight: 600; }

  .figure { font-family: var(--font-mono, monospace); font-size: .9rem; color: var(--ink-soft); background: var(--surface-sunken); padding: 1rem 1.25rem; border-radius: .5rem; overflow-x: auto; }

  .next { border-top: 1px solid var(--rule); margin-top: 2rem; padding-top: 1.5rem; }
