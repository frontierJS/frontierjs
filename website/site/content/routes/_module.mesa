<!--
  The site shell — every page under content/routes/ renders inside it.

  Thirteen hand-written pages each carried a copy of this topbar, this footer
  and the same 429-byte theme script. One copy here is the single biggest thing
  the conversion buys.

  A layout on a static target holds no state: there is no application around
  these pages. Everything here is markup except the swatches, which are an
  island for exactly that reason.
-->
<script>
  import ThemeSwitch from '../islands/ThemeSwitch.mesa'
</script>

<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Rubik+Dirt&display=swap">

<a href="#top" class="skip-link">Skip to content</a>

<header class="topbar">
  <div class="container topbar-inner">
    <a class="brand" href="/">Frontier<span>JS</span></a>
    <nav class="navset" aria-label="Site">
      <a href="/start/">Start</a>
      <a href="/docs/">Docs</a>
      <a href="/packages/">Packages</a>
      <a href="/why/">Why</a>
      <a href="/journey/">Journey</a>
      <!-- A <details>, so the menu opens and closes with no script on the page.
           Linked from the launch pages, kept out of the top row. -->
      <details class="popover-anchor navmenu">
        <summary>Explore</summary>
        <div class="popover align-end">
          <ul class="navlist">
            <li><a class="navlink" href="/pitch/">The pitch</a></li>
            <li><a class="navlink" href="/tutor/">Tutorial</a></li>
            <li><a class="navlink" href="/seams/">The seams</a></li>
            <li><a class="navlink" href="/showroom/">Showroom</a></li>
            <li><a class="navlink" href="/before-after/">Before &amp; after</a></li>
            <li><a class="navlink" href="/the-story/">The story</a></li>
            <li><a class="navlink" href="/specs/">Specifications</a></li>
          </ul>
        </div>
      </details>
      <!-- Pages to fold into a launch page or cut before launch. A page leaves
           this menu when it is merged or deleted. -->
      <details class="popover-anchor navmenu">
        <summary>Drafts</summary>
        <div class="popover align-end">
          <div class="navlist-label">Folding into Why</div>
          <ul class="navlist">
            <li><a class="navlink" href="/comparisons/">Comparisons</a></li>
            <li><a class="navlink" href="/vs-laravel/">vs Laravel</a></li>
            <li><a class="navlink" href="/landscape/">Landscape</a></li>
          </ul>
          <div class="navlist-label">Design rounds</div>
          <ul class="navlist">
            <li><a class="navlink" href="/showroom2/">Walkthrough</a></li>
            <li><a class="navlink" href="/showroom3/">The ripple</a></li>
            <li><a class="navlink" href="/showroom4/">The loop</a></li>
            <li><a class="navlink" href="/showroom5/">The stack</a></li>
            <li><a class="navlink" href="/flow/">The flow</a></li>
            <li><a class="navlink" href="/map/">The map</a></li>
            <li><a class="navlink" href="/allegory/">The allegory</a></li>
          </ul>
          <div class="navlist-label">Hero drafts</div>
          <ul class="navlist">
            <li><a class="navlink" href="/index2/">Round one</a></li>
            <li><a class="navlink" href="/index3/">Round two</a></li>
          </ul>
          <div class="navlist-label">Tools</div>
          <ul class="navlist">
            <li><a class="navlink" href="/splash-tune/">Splash tuner</a></li>
          </ul>
        </div>
      </details>
      <a href="https://github.com/frontierjs/frontierjs">GitHub</a>
    </nav>
    <ThemeSwitch client:load />
  </div>
</header>

<slot />

<footer class="site-footer">
  <div class="container split">
    <span>FrontierJS — MIT licensed. Built with Bun and SQLite.</span>
    <span>This page is styled entirely by <code>@frontierjs/css</code>.</span>
  </div>
</footer>

<style>
  /* `.container` is @frontierjs/css's own class and the page content is a
     child component, so a scoped rule cannot reach it — the site's narrower
     measure has to be stated globally. This is the shape every site-wide tweak
     to a design-system class takes here. */
  :global(.container) { max-width: 68rem; }
  :global(html) { scroll-behavior: smooth; }
  /* How much of the viewport's top the sticky topbar holds. A page's sticky
     element sits at this offset; a hand-measured number goes stale the moment
     the bar's contents change, and the bar slides over whatever is pinned. */
  :global(:root) { --sticky-offset: 4rem; }
  :global(body) { background: var(--surface); color: var(--ink); }
  /* html:root outranks a theme class on <html>, so every swatch keeps the face. */
  :global(html:root) { --font-display: 'Rubik Dirt', system-ui, sans-serif; }

  .skip-link { position: absolute; left: -9999px; }
  .skip-link:focus {
    left: var(--space-4); top: var(--space-4); z-index: 60;
    background: var(--surface); padding: var(--space-2) var(--space-3);
    border-radius: var(--radius);
  }

  .topbar {
    position: sticky; top: 0; z-index: 50;
    background: color-mix(in srgb, var(--surface) 88%, transparent);
    backdrop-filter: blur(8px);
    border-bottom: 1px solid var(--rule);
    /* @frontierjs/css sets no font on body, so the bar took the browser's
       serif while the menu's popover, a surface, took --font-primary. */
    font-family: var(--font-primary);
    box-sizing: border-box; height: var(--sticky-offset);
  }
  .topbar-inner { display: flex; align-items: center; gap: 1.5rem; height: 100%; padding: 0 1.25rem; }

  .brand { font-weight: 700; letter-spacing: -.02em; margin-right: auto; text-decoration: none; color: var(--ink); }
  .brand span { color: var(--color-primary); }

  .navset { display: flex; gap: .25rem; }

  /* Below this the bar cannot hold one row, and a wrapped sticky bar is a
     third of a phone screen — so it scrolls away and the subnav pins at 0. */
  @media (max-width: 37rem) {
    :global(:root) { --sticky-offset: 0px; }
    .topbar { position: relative; height: auto; }
    .topbar-inner { padding-block: .75rem; }
    .navset { flex-wrap: wrap; }
  }
  .navset a { padding: .35rem .6rem; border-radius: 6px; color: var(--ink-soft); text-decoration: none; font-size: .875rem; }
  .navset a:hover { background: var(--surface-sunken); color: var(--ink); }

  /* The summary is dressed as a nav link, and the menu's own links are
     .navlink, so the .navset a rule must not reach into the popover. */
  .navmenu summary {
    padding: .35rem .6rem; border-radius: 6px; color: var(--ink-soft);
    font-size: .875rem; list-style: none; cursor: pointer;
  }
  .navmenu summary::-webkit-details-marker { display: none; }
  .navmenu summary::after { content: ' ▾'; font-size: .7em; }
  .navmenu summary:hover, .navmenu[open] summary { background: var(--surface-sunken); color: var(--ink); }
  .navmenu .popover { min-width: 13rem; padding: var(--space-sm); }
  .navmenu .popover a { padding: .3rem .6rem; font-size: .875rem; }
  .navmenu .navlist-label:not(:first-child) { margin-top: var(--space-sm); }
  /* A closed <details> hides its body, so hover has to reopen the body box
     itself; the summary click stays the way in for touch and keyboard. The
     bridge spans the popover's offset — without it the pointer leaves
     :hover crossing the gap and the menu shuts under it. */
  @media (hover: hover) {
    .navmenu:hover::details-content { display: block; content-visibility: visible; }
    .navmenu .popover::before {
      content: ''; position: absolute; inset-inline: 0;
      bottom: 100%; height: calc(var(--space-2xs) + 2px);
    }
  }

  /* A page's own section nav. Five pages carry one, so the rule is here rather
     than repeated — but it is :global() because the markup is in the PAGE, and
     a scoped rule hashes against this component. */
  :global(.subnav) {
    position: sticky; top: var(--sticky-offset); z-index: 45;
    background: color-mix(in srgb, var(--surface) 92%, transparent);
    backdrop-filter: blur(8px); border-bottom: 1px solid var(--rule);
  }
  /* An anchor jump has to clear the topbar AND the subnav, so a page with one
     gets the offset here rather than a scroll-margin it would tune by hand. */
  :global(html:has(.subnav)) { scroll-padding-top: calc(var(--sticky-offset) + 3rem); }
  :global(.subnav .container) { display: flex; gap: .15rem; overflow-x: auto; padding: .45rem 1.25rem; }
  :global(.subnav a) {
    white-space: nowrap; font-size: .78rem; text-decoration: none; color: var(--ink-mute);
    padding: .28rem .55rem; border-radius: 6px;
  }
  :global(.subnav a:hover) { background: var(--surface-sunken); color: var(--ink); }
  :global(.subnav a[aria-current]) { background: var(--surface-sunken); color: var(--ink); }

  :global(.pagenote) {
    display: flex; flex-wrap: wrap; gap: 1rem; justify-content: space-between;
    padding-top: 2rem; margin-top: 2rem; border-top: 1px solid var(--rule);
    font-size: .85rem; color: var(--ink-mute);
  }

  .site-footer { border-top: 1px solid var(--rule); padding: 2.5rem 0 3.5rem; color: var(--ink-mute); font-size: .875rem; }
</style>
