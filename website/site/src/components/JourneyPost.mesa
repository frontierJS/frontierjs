<!--
  The frame every journey post renders in: the way back, the measure, and the
  prose rules. The post's words are its own slot content, compiled in the
  post's scope, so the rules that dress them are :global() under .journey-post
  — a scoped rule here hashes against this component and reaches none of them.
-->
<article class="container journey-post">
  <a class="back" href="/journey/">← The journey</a>
  <slot />
  <footer class="foot">
    <a class="btn ghost" href="/journey/">← Every entry</a>
    <a class="btn primary raised" href="/pitch/">What we are building</a>
  </footer>
</article>

<style>
  .journey-post { max-width: 42rem; padding: 4rem 1.25rem 5rem; font-family: var(--font-primary); }
  .back { font-size: .875rem; color: var(--ink-mute); text-decoration: none; }
  .back:hover { color: var(--ink); }
  .foot { display: flex; flex-wrap: wrap; gap: .75rem; margin-top: 3.5rem; padding-top: 1.5rem; border-top: 1px solid var(--rule); }
  .btn.ghost { color: var(--ink); }

  :global(.journey-post time) { display: block; margin-top: 2rem; font-size: .8rem; color: var(--ink-mute); }
  :global(.journey-post h1) { font-size: clamp(2rem, 5vw, 2.9rem); line-height: 1.08; letter-spacing: -.03em; margin: .3em 0 .6em; }
  :global(.journey-post h2) { font-size: 1.35rem; letter-spacing: -.01em; margin: 2.2em 0 .5em; }
  :global(.journey-post p),
  :global(.journey-post li) { font-size: 1.075rem; line-height: 1.7; color: var(--ink-soft); }
  :global(.journey-post strong) { color: var(--ink); }
  :global(.journey-post ul) { padding-left: 1.25rem; }
</style>
