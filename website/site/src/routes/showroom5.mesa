---
title: "FrontierJS — the stack"
description: "Eight packages, one vocabulary. Every feature each one ships, and what it replaces."
render: static
publishes: 0
---
<!--
  The stack page. Every feature row AND every detail panel is prerendered.

  The hand-written version built all of it from JavaScript on load — sixteen
  tablists and sixteen detail cards, none of them in the file — so a crawler saw
  a page with one empty <div id="stack"> on it. That is the same shape the eight
  package stubs had, and the same fix: the data is read at build time and the
  markup is in the HTML. The island only moves the selection.
-->
<script>
  import FeatureTabs from '../islands/FeatureTabs.mesa'

  export let data = null

  const packages = data?.packages ?? []
</script>

<nav class="subnav" aria-label="Packages">
  <div class="container">
    {#each packages as p}
      <a href={`#${p.id}`}>{p.slug}</a>
    {/each}
  </div>
</nav>

<div class="container intro">
  <p class="eyebrow">The stack</p>
  <h1>Eight pieces. One vocabulary.</h1>
  <p class="pitch">
    Each stands alone — Litestone with any server, Mesa with any bundler. Together they
    share one model: <strong>Data &rarr; API &rarr; UI</strong>, seeded by a single schema.
  </p>
  <p class="hint">Click any feature to see what it does, and what it saves you wiring up.</p>

  <div class="map">
    {#each packages as p}
      <a class={p.tone} href={`/${p.slug}/`}><b>{p.name}</b><span>{p.realm}</span></a>
    {/each}
  </div>
</div>

{#each packages as p}
  <div class="pkg" id={p.id}>
    <div class="container">
      <div class="pkg-id">
        <h2><a class="pkg-link" href={`/${p.slug}/`}>{p.name} <span class="arrow">&rarr;</span></a></h2>
        <span class="badge {p.tone}">{p.realm}</span>
        <span class="who">{p.who}</span>
      </div>
      <p class="pitch">{p.pitch}</p>

      {#each p.groups as g}
        {#if g.title}
          <p class="hint grouptitle">{g.title}</p>
        {/if}
        <div class="body">
          <!--
            Both halves are in the file. `is-shown` picks which panel is visible
            and the island moves it; with no JavaScript the first one stays up
            and the rest are readable by anything that ignores the class.
          -->
          <div class="detail" data-panels={g.id} role="region" aria-live="polite">
            {#each g.rows as r}
              <div class="panel" class:is-shown={r.i === 0} data-i={r.i}>
                <h3>{r.k}</h3>
                <p class="sub">{@html r.v}</p>
                <p class="why">{r.why}</p>
                {#if r.code}
                  <pre class="code">{@html r.code}</pre>
                {/if}
                <div class="rep">
                  <h4>Replaces</h4>
                  {#if r.replaces.length}
                    <div class="list">{#each r.replaces as t}<span>{t}</span>{/each}</div>
                  {:else}
                    <p class="none">Nothing — there is no common equivalent to swap out.</p>
                  {/if}
                </div>
              </div>
            {/each}
          </div>

          <div class="rows" data-tabs={g.id} role="tablist" aria-label={`${p.name} features`}>
            {#each g.rows as r}
              <button class="row" role="tab" data-i={r.i} aria-selected={r.i === 0}>
                <span class="k">{r.k}</span><span class="v">{@html r.v}</span>
              </button>
            {/each}
          </div>
        </div>
      {/each}

      {#if p.chips.length}
        <div class="chips">
          {#each p.chips as c}
            <h3>{c.heading}</h3>
            <div class="chipline">{#each c.terms as t}<code>{t}</code>{/each}</div>
          {/each}
        </div>
      {/if}
    </div>
  </div>
{/each}

<FeatureTabs client:load />

<style>
h1 { font-size: clamp(1.8rem, 4.4vw, 2.6rem); line-height: 1.06; letter-spacing: -.03em; margin: .2em 0 .35em; }
.eyebrow { font-size: .76rem; letter-spacing: .12em; text-transform: uppercase; color: var(--ink-mute); margin: 0; }

.pkg { padding: 3.25rem 0; border-top: 1px solid var(--rule); scroll-margin-top: 7rem; }
.pkg-id { display: flex; align-items: baseline; gap: .7rem; flex-wrap: wrap; }
.pkg-id h2 { font-size: 1.65rem; letter-spacing: -.02em; margin: 0; }
.pkg-id .who { font-family: ui-monospace, Menlo, monospace; font-size: .76rem; color: var(--ink-mute); margin-left: auto; }
.pitch { font-size: 1rem; color: var(--ink-soft); max-width: 58ch; margin: .55rem 0 0; }

/* Detail on the left, feature list on the right. */
.body { display: grid; gap: 2rem; align-items: start; margin-top: 1.75rem; }
@media (min-width: 62rem) {
  .body { grid-template-columns: 1fr 1fr; }
  .detail { position: sticky; top: 7rem; }
}

/* ── Feature rows ──────────────────────────────────────────────────── */
.rows { display: grid; }
.row {
  display: grid; grid-template-columns: 7.25rem 1fr; gap: .75rem; width: 100%;
  text-align: left; font: inherit; cursor: pointer;
  background: transparent; border: 0; border-top: 1px solid var(--rule);
  padding: .5rem .6rem .5rem .55rem; border-left: 2px solid transparent;
  transition: background .13s ease, border-color .13s ease;
}
.row:first-child { border-top: 0; }
.row:hover { background: var(--surface-sunken); }
.row .k { font-size: .79rem; font-weight: 600; color: var(--ink); }
.row .v { font-size: .81rem; color: var(--ink-soft); line-height: 1.45; }
.row .v code { font-size: .75rem; }
.row[aria-selected="true"] {
  background: color-mix(in srgb, var(--color-primary) 9%, transparent);
  border-left-color: var(--color-primary);
}
.row[aria-selected="true"] .k { color: var(--color-primary); }

/* ── Detail card ───────────────────────────────────────────────────── */
.detail {
  border: 1px solid var(--rule); border-radius: 12px; padding: 1.15rem 1.25rem;
  background: var(--surface-raised);
}
.detail h3 { margin: 0; font-size: 1.05rem; letter-spacing: -.01em; }
.detail .sub { font-size: .8rem; color: var(--ink-mute); margin: .2rem 0 .85rem; }
.detail .why { font-size: .88rem; color: var(--ink-soft); line-height: 1.6; margin: 0; }
.detail pre { margin-top: .9rem; }
.rep { margin-top: 1.1rem; padding-top: .9rem; border-top: 1px solid var(--rule); }
.rep h4 {
  margin: 0 0 .4rem; font-size: .68rem; letter-spacing: .1em;
  text-transform: uppercase; color: var(--ink-mute);
}
.rep .list { display: flex; flex-wrap: wrap; gap: .3rem; }
.rep .list span {
  font-size: .74rem; padding: .14rem .5rem; border-radius: 999px;
  border: 1px solid var(--rule-strong); color: var(--ink-soft);
}
.rep .none { font-size: .8rem; color: var(--ink-mute); margin: 0; }

/* No code palette and no block rules here. A sample is the design
   system's code block wrapping glow's own code element, and
   @frontierjs/css styles both — a rule here would be a second
   answer to what code looks like. */
/* The one thing the design system cannot know: these sit in a dense
   grid, so they take the rung below the block default. */
.code { font-size: var(--text-xs); padding: var(--space-md) var(--space-lg); }

.chips { margin-top: 1.75rem; }
.chips h3 {
  font-size: .7rem; letter-spacing: .1em; text-transform: uppercase;
  color: var(--ink-mute); margin: 1rem 0 .4rem;
}
.chips h3:first-child { margin-top: 0; }
.chipline { display: flex; flex-wrap: wrap; gap: .28rem; }
.chipline code {
  font-size: .73rem; padding: .12rem .42rem; border-radius: 4px;
  background: color-mix(in srgb, var(--ink) 6%, transparent); color: var(--ink-soft);
}

.map { display: grid; gap: .5rem; grid-template-columns: repeat(auto-fit, minmax(10.5rem, 1fr)); margin-top: 1.75rem; }
.map a {
  text-decoration: none; border: 1px solid var(--rule); border-radius: 9px;
  padding: .6rem .7rem; background: var(--surface-raised); display: block;
  border-left: 3px solid var(--rule-strong);
}
.map a:hover { border-color: var(--rule-strong); }
.map a.d { border-left-color: var(--color-primary); }
.map a.a { border-left-color: var(--color-info); }
.map a.u { border-left-color: var(--color-success); }
.map a.t { border-left-color: var(--color-warning); }
.map b { display: block; font-size: .88rem; color: var(--ink); }
.map span { display: block; font-size: .73rem; color: var(--ink-mute); margin-top: .1rem; }

.hint { font-size: .76rem; color: var(--ink-mute); margin: .6rem 0 0; }

/* Panels are stacked and one is shown. Without JavaScript the first stays up,
   which is why they are `display:none` rather than absent from the file. */
.panel { display: none; }
.panel.is-shown { display: block; }

.intro { padding-top: 3rem; padding-bottom: .5rem; }
.intro .pitch { max-width: 62ch; }
.pkg-link { color: inherit; text-decoration: none; }
.pkg-link .arrow { font-size: .75em; color: var(--ink-mute); }
.grouptitle { margin-top: 2rem; }
</style>
