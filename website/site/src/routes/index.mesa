<style>
  /* Page layout only. Everything visual comes from @frontierjs/css tokens.
     The shell rules — topbar, brand, navset, footer — moved to _module.mesa. */
  section { scroll-margin-top: 5rem; padding: 5rem 0; border-top: 1px solid var(--rule); }
  section:first-of-type { border-top: 0; }

  .lede { font-size: 1.15rem; color: var(--ink-soft); max-width: 46ch; }
  .eyebrow { font-size: .78rem; letter-spacing: .12em; text-transform: uppercase; color: var(--ink-mute); }
  h1 { font-size: clamp(2.25rem, 6vw, 3.5rem); line-height: 1.05; letter-spacing: -.03em; margin: .4em 0 .3em; }
  h2 { font-size: clamp(1.6rem, 3.5vw, 2.2rem); letter-spacing: -.02em; margin: 0 0 .3em; }
  h3 { font-size: 1rem; margin: 0 0 .5rem; }

  /* No code palette and no block rules here. A sample is the design
     system's code block wrapping glow's own code element, and
     @frontierjs/css styles both — a rule here would be a second answer
     to what code looks like, and a scoped one would not reach the
     samples anyway: they arrive through {@html} and carry no hash. */

  .grid  { display: grid; gap: 1.5rem; }
  .cols3 { grid-template-columns: repeat(auto-fit, minmax(19rem, 1fr)); }
  .cols2 { grid-template-columns: repeat(auto-fit, minmax(22rem, 1fr)); }
  .hero  { display: grid; gap: 2.5rem; grid-template-columns: minmax(0,1fr); align-items: center; }
  @media (min-width: 60rem) { .hero { grid-template-columns: 1.05fr .95fr; } }

  .flow  { display: flex; align-items: center; gap: .6rem; flex-wrap: wrap; font-size: .9rem; }
  /* .hop, not .step — @frontierjs/css owns .step as a stepper item and would
     stretch these pills and draw a connector bar between them. */
  .flow .hop { border: 1px solid var(--rule-strong); border-radius: 999px; padding: .3rem .8rem; background: var(--surface-raised); }
  .flow .arrow { color: var(--ink-mute); }

  /* Untoned .btn.outlined paints --color-primary on --surface — 3.96:1 in the
     default theme and 1.99:1 in elite, both below AA. Take the neutral ink, as
     .btn.ghost already does and for the same reason. */
  .btn.outlined { color: var(--ink); border-color: var(--rule-strong); }

  .checks { list-style: none; padding: 0; margin: 0; display: grid; gap: .55rem; }
  .checks li { display: flex; gap: .6rem; align-items: flex-start; font-size: .92rem; }
  .checks li::before { content: "✓"; color: var(--color-success); font-weight: 700; flex: none; }
</style>
