        margin: 0.35em 0 0.3em;
      }
      h2 {
        font-size: clamp(1.35rem, 2.8vw, 1.75rem);
        letter-spacing: -0.02em;
        margin: 0 0 0.3em;
      }
      h3 {
        font-size: 0.95rem;
        margin: 0 0 0.45rem;
      }
      .eyebrow {
        font-size: 0.78rem;
        letter-spacing: 0.12em;
        text-transform: uppercase;
        color: var(--ink-mute);
        margin: 0;
      }
      .lede {
        font-size: 1.05rem;
        color: var(--ink-soft);
        max-width: 62ch;
        line-height: 1.6;
      }

      /* No code palette and no block rules here. A sample is the design
         system's code block wrapping glow's own code element, and
         @frontierjs/css styles both — a rule here would be a second
         answer to what code looks like. */
      /* The one thing the design system cannot know: these sit in a dense
         grid, so they take the rung below the block default. */
      .code { font-size: var(--text-xs); padding: var(--space-md) var(--space-lg); }

      /* ── the spine ──────────────────────────────────────────────────────── */
      .flow {
        position: relative;
      }
      /* The spine sits in the middle of the grid gap. .flow IS the .container, so
     its own padding-inline (1.25rem) has to be in the sum: 1.25 padding +
     7.5 rail + half of the 2.5rem gap = 10rem. Positioning it at the bare
     column width put it inside the rail and left the dots out over the text. */
      @media (min-width: 60rem) {
        .flow::before {
          content: '';
          position: absolute;
          left: 10rem;
          top: 0;
          bottom: 0;
          width: 2px;
          background: var(--rule);
          z-index: 0;
        }
      }

      .stop {
        position: relative;
        display: grid;
        gap: 1rem;
        padding: 1.5rem 0;
      }
      @media (min-width: 60rem) {
        .stop {
          grid-template-columns: 7.5rem minmax(0, 1fr);
          gap: 2.5rem;
          align-items: start;
        }
      }
      .stop .rail {
        position: relative;
        z-index: 1;
      }
      .stop .badge-realm {
        display: inline-block;
        font-size: 0.68rem;
        letter-spacing: 0.12em;
        text-transform: uppercase;
        padding: 0.2rem 0.5rem;
        border-radius: 5px;
        background: var(--surface-sunken);
        color: var(--ink-mute);
        border: 1px solid var(--rule);
      }
      .stop .noun {
        display: block;
        margin-top: 0.45rem;
        font-weight: 700;
        font-size: 1rem;
