      }
      .stop .where {
        display: block;
        margin-top: 0.2rem;
        font-size: 0.72rem;
        color: var(--ink-mute);
        font-family: ui-monospace, Menlo, monospace;
      }
      @media (min-width: 60rem) {
        .stop .rail::after {
          /* centered on the spine: rail right edge → half the gap. */
          content: '';
