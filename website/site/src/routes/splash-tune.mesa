---
title: Splash tuner — FrontierJS
description: Live controls for the map tour behind the splash.
render: static
robots: noindex
---
<!--
  The splash tuner. The real splash runs in the frame and the panel writes its
  tour variables onto that page's backdrop, so what is tuned here is the CSS
  that ships, not a copy of it. The block at the bottom is the text to paste
  over the tour variables in src/routes/index.mesa.
-->
<script>
  import SplashTuner from '../islands/SplashTuner.mesa'

  const stops = [0, 1, 2, 3, 4, 5]
  const decks = [
    { key: 'shadow', label: 'Cloud shadows', depth: false },
    { key: 'wisp',   label: 'High wisps',    depth: true },
    { key: 'low',    label: 'Low clouds',    depth: true },
  ]
</script>

<div class="tune" data-tune>
  <div class="stage">
    <iframe src="/" title="The splash, live" data-frame></iframe>
    <div class="aim" data-aim hidden>
      <p>Click the map to aim stop <b data-aim-label></b>. <kbd>Esc</kbd> cancels.</p>
    </div>
  </div>

  <aside class="panel dense">
    <h1>Splash tuner</h1>
    <p class="hint">
      Changes apply to the splash in the frame and are kept in this browser.
      Copy the block at the bottom over the tour variables in
      <code>src/routes/index.mesa</code> to ship them.
    </p>

    <div class="transport">
      <button type="button" class="btn" data-play>Pause</button>
      <span class="clock" data-clock>0:00 / 0:00</span>
    </div>
    <input class="scrub" type="range" min="0" max="1000" value="0" data-scrub aria-label="Position in the tour">

    <div class="globals">
      <label>Length <span><input type="number" min="10" max="900" step="5" data-length> s</span></label>
      <label>Easing
        <select data-easing>
          <option value="ease-in-out">ease-in-out</option>
          <option value="cubic-bezier(.65, 0, .35, 1)">smooth glide</option>
          <option value="cubic-bezier(.85, 0, .15, 1)">long holds</option>
          <option value="ease">ease</option>
          <option value="linear">linear</option>
        </select>
      </label>
      <label class="check"><input type="checkbox" data-veil-off> Hide the veil</label>
    </div>

    {#each stops as i}
      <fieldset class="stop" data-stop={i}>
        <legend>
          <span>Stop {i + 1}</span>
          <button type="button" class="btn ghost" data-go>Go</button>
          <button type="button" class="btn ghost" data-aim-at>Aim</button>
        </legend>
        <label>Zoom <input type="range" min="1" max="4" step="0.05" data-k="zoom"><output></output></label>
        <label>X <input type="range" min="0" max="100" step="1" data-k="x"><output></output></label>
        <label>Y <input type="range" min="0" max="100" step="1" data-k="y"><output></output></label>
      </fieldset>
    {/each}

    {#each decks as d}
      <fieldset class="stop deck">
        <legend><span>{d.label}</span></legend>
        <label>Show <input type="range" min="0" max="1" step="0.05" data-cloud={d.key} data-k="opacity"><output></output></label>
        <label>Wind <input type="range" min="20" max="600" step="10" data-cloud={d.key} data-k="drift"><output></output></label>
        {#if d.depth}
          <label>Depth <input type="range" min="0" max="3" step="0.05" data-cloud={d.key} data-k="depth"><output></output></label>
        {/if}
      </fieldset>
    {/each}
    <p class="hint">
      Wind is the seconds one tile takes to cross; less is faster. Depth is how
      much harder a deck zooms than the map: 1 rides with the land, above 1
      it rushes past the camera on a dive.
    </p>

    <div class="out">
      <textarea readonly rows="12" spellcheck="false" data-out aria-label="Tour variables to paste"></textarea>
      <div class="cluster">
        <button type="button" class="btn primary" data-copy>Copy</button>
        <button type="button" class="btn ghost" data-reset>Reset to the file</button>
      </div>
    </div>
  </aside>
</div>

<SplashTuner client:load />

<style>
  .tune {
    display: grid; grid-template-columns: minmax(0, 1fr) 21rem;
    height: calc(100svh - var(--sticky-offset, 4rem));
    font-family: var(--font-primary);
  }
  .stage { position: relative; min-height: 0; }
  iframe { display: block; width: 100%; height: 100%; border: 0; }

  .aim {
    position: absolute; inset: 0; cursor: crosshair;
    display: grid; place-items: start center; padding-top: 1rem;
    background: color-mix(in srgb, var(--color-primary) 8%, transparent);
    outline: 2px dashed var(--color-primary); outline-offset: -2px;
  }
  .aim[hidden] { display: none; }
  .aim p {
    margin: 0; padding: .4rem .8rem; border-radius: 999px; font-size: .85rem;
    background: var(--surface-raised); border: 1px solid var(--rule-strong);
  }

  /* The frame followed a link off the splash; there is nothing to tune. */
  .tune.detached .panel { opacity: .5; pointer-events: none; }

  .panel {
    overflow-y: auto; padding: 1rem 1.1rem 2rem;
    border-left: 1px solid var(--rule); background: var(--surface);
    display: grid; gap: .9rem; align-content: start;
  }
  h1 { font-size: 1.1rem; margin: 0; }
  .hint { font-size: .8rem; color: var(--ink-mute); margin: 0; }

  .transport { display: flex; align-items: center; justify-content: space-between; }
  .clock { font-variant-numeric: tabular-nums; font-size: .85rem; color: var(--ink-soft); }
  .btn.ghost { color: var(--ink); }

  input[type=range] { width: 100%; accent-color: var(--color-primary); }

  .globals { display: grid; gap: .5rem; font-size: .85rem; }
  .globals label { display: flex; align-items: center; justify-content: space-between; gap: .5rem; }
  .globals input[type=number] { width: 5rem; }
  .globals .check { justify-content: start; }

  .stop {
    margin: 0; padding: .5rem .75rem .7rem; display: grid; gap: .25rem;
    border: 1px solid var(--rule); border-radius: var(--radius, 10px);
    font-size: .8rem;
  }
  .stop.now { border-color: var(--color-primary); box-shadow: 0 0 0 1px var(--color-primary); }
  .stop.aiming { background: color-mix(in srgb, var(--color-primary) 8%, transparent); }
  legend { display: flex; align-items: center; gap: .35rem; padding: 0 .3rem; font-weight: 600; }
  legend span { margin-right: auto; }
  .stop label { display: grid; grid-template-columns: 2.6rem 1fr 2.6rem; align-items: center; gap: .4rem; }
  output { font-variant-numeric: tabular-nums; text-align: right; color: var(--ink-soft); }

  .out { display: grid; gap: .5rem; }
  textarea {
    width: 100%; box-sizing: border-box; resize: vertical;
    font: .72rem/1.45 var(--font-mono, ui-monospace, monospace);
  }

  @media (max-width: 52rem) {
    .tune { grid-template-columns: 1fr; grid-template-rows: 55svh auto; height: auto; }
    .panel { border-left: 0; border-top: 1px solid var(--rule); overflow: visible; }
  }
</style>
