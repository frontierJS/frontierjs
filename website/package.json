{
  "name": "@frontierjs/website",
  "version": "0.1.0",
  "private": true,
  "description": "frontierjs.com \u2014 the public site. site/ is its content/ folder; @frontierjs/site-kit builds it, one HTML file per route, prerendered.",
  "type": "module",
  "scripts": {
    "dev": "node scripts/stage-repl.mjs && site-kit dev site --port 8690 --host",
    "build": "node scripts/stage-repl.mjs && site-kit build site",
    "serve": "site-kit serve site --port 8790",
    "verify": "bun run build && node tests/verify.mjs",
    "verify:ask": "bun tests/verify-ask.mjs",
    "clean": "rm -rf site/dist",
    "test": "node ../scripts/tmp-run.mjs 'bun run verify'",
    "typecheck": "node ../scripts/typecheck.mjs",
    "deploy": "bun run test && site-kit deploy site"
  },
  "dependencies": {
    "@frontierjs/css": "workspace:*",
    "@frontierjs/mesa": "workspace:*",
    "@frontierjs/sierra": "workspace:*",
    "@frontierjs/site-kit": "workspace:*",
    "@frontierjs/toolbelt": "workspace:*"
  },
  "devDependencies": {
    "@frontierjs/cli": "workspace:*",
    "vite": "^8.3.2",
    "wrangler": "^4.145.0"
  }
}
