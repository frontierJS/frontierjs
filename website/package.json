{
  "name": "@frontierjs/website",
  "version": "0.1.0",
  "private": true,
  "description": "frontierjs.dev — the public site. A Sierra `site/` surface: one HTML file per route, prerendered.",
  "type": "module",
  "scripts": {
    "dev": "cd site && vite -c config/vite.config.js",
    "build": "cd site && bun --bun vite build -c config/vite.config.js",
    "preview": "cd site && bunx sierra site --serve --port 8790",
    "verify": "node site/test/verify.mjs",
    "clean": "rm -rf site/dist",
    "test": "bun run build",
    "typecheck": "node ../scripts/typecheck.mjs"
  },
  "dependencies": {
    "@frontierjs/css": "workspace:*",
    "@frontierjs/mesa": "workspace:*",
    "@frontierjs/sierra": "workspace:*",
    "@frontierjs/toolbelt": "workspace:*"
  },
  "devDependencies": {
    "vite": "^8.0.3"
  }
}
