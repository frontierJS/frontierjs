# Dependencies
node_modules/

# Bun
bun.lockb
.bunfig.toml

# Build outputs
dist/
build/
out/
# …but `build/` also matched packages/*/src/build/, which is SOURCE — Sierra's
# whole build pipeline (prerender.js, mesa-plugin.js, scanner-plugin.js…) and
# jetty's. 20 files were silently untracked; a fresh clone had no prerenderer.
# The directory itself must be re-included, not just its contents: git cannot
# re-include a file whose parent directory is excluded.
!packages/*/src/build/
!packages/*/src/build/**
*.js.map
*.d.ts.map

# TypeScript
*.tsbuildinfo

# Environment
.env
.env.*
!.env.example

# OS
.DS_Store
Thumbs.db

# Editor
.vscode/
.idea/
*.swp
*.swo

# Logs
*.log
npm-debug.log*

# Test outputs
coverage/
.nyc_output/

# Temporary
tmp/
temp/
.cache/

*.db*
*.vsix

# @frontierjs/css test driver (generated per run; removed unless --keep)
.fjs-test-run.html

# Audit trails written by litestone's logger driver. Operational data — actor
# ids, emails, before/after row snapshots. Protected fields are redacted, but
# the rest is real and belongs on the machine that produced it, not in git.
**/db/audit/
*.jsonl

# `fli ws:atlas --live` writes this: the same page plus git and registry state.
# It holds a clock and an answer from the network, so it can be neither
# byte-compared nor committed — its sibling `repo-atlas.snapshot.html` is the
# one CI checks.
repo-atlas.live.html

# mesa
_tmp_slots_*/