{
  "name": "@frontierjs/toolbelt",
  "version": "0.1.5",
  "description": "FrontierJS pure-function kits — zero dependencies, no I/O, importable from any package",
  "type": "module",
  "scripts": {
    "test": "bun test/run.js",
    "typecheck": "node ../../scripts/typecheck.mjs"
  },
  "exports": {
    "./bearer": {
      "types": "./src/bearer/bearer.d.ts",
      "default": "./src/bearer/bearer.js"
    },
    "./cells": {
      "types": "./src/cells/cells.d.ts",
      "default": "./src/cells/cells.js"
    },
    "./cron": {
      "types": "./src/cron/cron.d.ts",
      "default": "./src/cron/cron.js"
    },
    "./datetime": {
      "types": "./src/datetime/datetime.d.ts",
      "default": "./src/datetime/datetime.js"
    },
    "./directives": {
      "types": "./src/directives/directives.d.ts",
      "default": "./src/directives/directives.js"
    },
    "./gate": {
      "types": "./src/gate/gate.d.ts",
      "default": "./src/gate/gate.js"
    },
    "./geo": {
      "types": "./src/geo/geo.d.ts",
      "default": "./src/geo/geo.js"
    },
    "./frontmatter": "./src/frontmatter/frontmatter.js",
    "./glow": "./src/glow/glow.js",
    "./history": "./src/history/history.js",
    "./hooks": "./src/hooks/hooks.js",
    "./ids": {
      "types": "./src/ids/ids.d.ts",
      "default": "./src/ids/ids.js"
    },
    "./inflect": "./src/inflect/inflect.js",
    "./json": "./src/json/json.js",
    "./jsonschema": "./src/jsonschema/jsonschema.js",
    "./match": "./src/match/match.js",
    "./mime": {
      "types": "./src/mime/mime.d.ts",
      "default": "./src/mime/mime.js"
    },
    "./predicate": "./src/predicate/predicate.js",
    "./query": {
      "types": "./src/query/query.d.ts",
      "default": "./src/query/query.js"
    },
    "./transforms": "./src/transforms/transforms.js",
    "./redact": {
      "types": "./src/redact/redact.d.ts",
      "default": "./src/redact/redact.js"
    },
    "./search": "./src/search/search.js",
    "./signature": "./src/signature/signature.js",
    "./sse": {
      "types": "./src/sse/sse.d.ts",
      "default": "./src/sse/sse.js"
    },
    "./trace": {
      "types": "./src/trace/trace.d.ts",
      "default": "./src/trace/trace.js"
    },
    "./units": "./src/units/units.js"
  },
  "files": [
    "src",
    "README.md",
    "LICENSE"
  ],
  "keywords": [
    "frontierjs",
    "utils",
    "toolbelt",
    "syntax-highlighting"
  ],
  "license": "MIT",
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/frontierJS/frontierjs.git",
    "directory": "packages/toolbelt"
  }
}
