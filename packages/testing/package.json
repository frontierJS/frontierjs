{
  "name": "@frontierjs/testing",
  "version": "0.1.8",
  "description": "The Testing realm for FrontierJS — one environment across Data and API.",
  "type": "module",
  "license": "MIT",
  "author": "FrontierJS",
  "exports": {
    ".": "./src/index.ts",
    "./drive": "./src/drive.ts"
  },
  "files": [
    "src",
    "AGENTS.md",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "test": "node ../../scripts/tmp-run.mjs 'bun test'",
    "typecheck": "node ../../scripts/typecheck.mjs"
  },
  "engines": {
    "bun": ">=1.4.0"
  },
  "peerDependencies": {
    "@frontierjs/junction": "^0.1.0",
    "@frontierjs/litestone": "^1.1.0",
    "@frontierjs/mesa": "^0.1.6"
  },
  "peerDependenciesMeta": {
    "@frontierjs/mesa": {
      "optional": true
    }
  },
  "devDependencies": {
    "bun-types": "^1.3.14",
    "@frontierjs/junction": "workspace:*",
    "@frontierjs/litestone": "workspace:*",
    "@frontierjs/mesa": "workspace:*"
  },
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/frontierJS/frontierjs.git",
    "directory": "packages/testing"
  }
}
