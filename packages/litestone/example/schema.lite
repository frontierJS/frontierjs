/// schema.lite — Litestone example schema
/// Demonstrates: multi-DB, JSONL, logger driver, row-level policies,
///               field-level @allow, enums, functions, generated columns,
///               soft delete, FTS5, relations, gates
///
/// Model names are PascalCase and singular — always. The client accessor is
/// the camelCase of the model name: model Lead → db.lead.
///
/// Run:  bun seed.ts          — seed all databases
///       bun seed.ts --studio — seed + open studio

// ─── Databases ────────────────────────────────────────────────────────────────
//
//   main       — core app database (accounts, users, products, etc.)
//   analytics  — separate SQLite database for aggregated metrics
//   logs       — JSONL append-only request log (no migrations, just write)
//   audit      — logger driver, auto-managed schema, all @@log / @log writes here

database main {
  path env("MAIN_DB_PATH", "./example.db")
}

database analytics {
  path env("ANALYTICS_DB_PATH", "./analytics.db")
}

database logs {
  path      env("LOGS_PATH", "./logs/")
  driver    jsonl
  retention 30d
}

database audit {
  path      env("AUDIT_PATH", "./audit/")
  driver    logger
  retention 90d
}

// ─── Enums ────────────────────────────────────────────────────────────────────

enum Plan {
  starter
  pro
  enterprise
}

enum Role {
  admin
  member
  viewer
}

enum LeadStatus {
  active
  converted
  archived
}

// ─── Functions ────────────────────────────────────────────────────────────────

function slug(text: String): String {
  @@expr("lower(trim(replace(replace(replace({text}, ' ', '-'), '.', ''), ',', '')))")
}

function fullName(first: String, last: String): String {
  @@expr("trim(COALESCE({first}, '') || ' ' || COALESCE({last}, ''))")
}

function initials(first: String, last: String): String {
  @@expr("upper(substr(COALESCE({first},'?'),1,1)) || upper(substr(COALESCE({last},'?'),1,1))")
}

function discounted(price: Int, pct: Float): Int {
  @@expr("CAST({price} * (1.0 - {pct}) AS INTEGER)")
}

// ─── Accounts ─────────────────────────────────────────────────────────────────

model Account {
  id        Int  @id
  name      String
  slug      String   @slug(name)
  plan      Plan     @default(starter)
  meta      Json?
  createdAt DateTime @default(now())

  @@db(main)
  @@index([slug])
  @@gate(read: READER, write: ADMINISTRATOR, delete: OWNER)
  @@allow('read', auth() != null)
}

// ─── Users ────────────────────────────────────────────────────────────────────
// Demonstrates:
//   @@allow / @@deny   — row-level access policy
//   @allow('read')     — field-level: salary only visible to admins
//   @secret            — encrypted + guarded + audit logged (via @log(audit))
//   @@log(audit)       — model-level audit log: create/update/delete

model User {
  id          Int   @id
  account     Account   @relation(fields: [accountId], references: [id], onDelete: Cascade)
  accountId   Int
  email       String    @unique @email @lower
  firstName   String?   @trim
  lastName    String?   @trim
  displayName String    @fullName(firstName, lastName)
  initials    String    @initials(firstName, lastName)
  role        Role      @default(member)
  salary      Float?    @allow('read', auth().role == 'admin')
  apiKey      String?   @secret
  prefs       Json?
  createdAt   DateTime  @default(now())
  deletedAt   DateTime?

  @@db(main)
  @@softDelete
  @@index([accountId])
  @@index([email])
  @@index([displayName])
  @@gate(read: READER, write: USER, delete: OWNER)
  @@allow('read',   accountId == auth().accountId)
  @@allow('update', id == auth().id || auth().role == 'admin')
  @@allow('delete', auth().role == 'admin')
  @@log(audit)
}

// ─── Products ─────────────────────────────────────────────────────────────────

model Product {
  id        Int  @id
  account   Account  @relation(fields: [accountId], references: [id], onDelete: Cascade)
  accountId Int
  name      String
  slug      String   @slug(name)
  price     Int
  discount  Float    @default(0.0)
  salePrice Int      @discounted(price, discount)
  createdAt DateTime @default(now())
  deletedAt DateTime?

  @@db(main)
  @@softDelete
  @@index([slug])
  @@index([salePrice])
  @@gate(read: VISITOR, write: USER, delete: OWNER)
  @@allow('read', true)
}

// ─── Leads ────────────────────────────────────────────────────────────────────

model Lead {
  id        Int    @id
  account   Account    @relation(fields: [accountId], references: [id], onDelete: Cascade)
  accountId Int
  firstName String?    @trim
  lastName  String?    @trim
  fullName  String     @fullName(firstName, lastName)
  email     String?    @email
  phone     String?
  status    LeadStatus @default(active)
  score     Float?     @gte(0) @lte(100)
  notes     String?
  createdAt DateTime   @default(now())
  deletedAt DateTime?

  @@db(main)
  @@softDelete
  @@index([accountId])
  @@index([status])
  @@index([fullName])
  @@gate(read: CREATOR, create: CREATOR, update: USER, delete: OWNER)
  @@allow('read',   accountId == auth().accountId)
  @@allow('create', accountId == auth().accountId)
  @@allow('update', accountId == auth().accountId)
  @@deny('update',  status == 'archived')
}

// ─── Messages ─────────────────────────────────────────────────────────────────

model Message {
  id        Int  @id
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId    Int
  account   Account  @relation(fields: [accountId], references: [id], onDelete: Cascade)
  accountId Int
  title     String?
  body      String
  channel   String   @default("email")
  isRead    Boolean  @default(false)
  sentAt    DateTime @default(now())
  deletedAt DateTime?

  @@db(main)
  @@softDelete
  @@fts([body, title])
  @@index([userId])
  @@index([accountId])
  @@index([channel])
  @@gate(read: READER, write: USER, delete: ADMINISTRATOR)
  @@allow('read', accountId == auth().accountId)
}

// ─── Analytics — separate SQLite database ─────────────────────────────────────
// Page view aggregations live in analytics.db, not the main app db.
// Queried via db.pageView — routes automatically to the analytics connection.

model PageView {
  id        Int  @id
  path      String
  accountId Int?
  userId    Int?
  country   String?
  device    String?
  duration  Int?
  createdAt DateTime @default(now())

  @@db(analytics)
  @@index([path])
  @@index([accountId])
  @@index([createdAt])
  @@allow('read',   auth() != null)
  @@allow('create', true)
}

model DailyStat {
  id          Int  @id
  date        String
  accountId   Int?
  views       Int  @default(0)
  uniqueUsers Int  @default(0)
  avgDuration Float?
  updatedAt   DateTime @updatedAt

  @@db(analytics)
  @@unique([date, accountId])
  @@index([date])
  @@allow('read', auth() != null)
}

// ─── Request log — JSONL database ─────────────────────────────────────────────
// Append-only HTTP request log. No migrations needed — JSONL driver manages files.
// retention 30d prunes rows older than 30 days on startup.
// Writes append to ./logs/apiRequest.jsonl

model ApiRequest {
  method    String
  path      String
  status    Int
  duration  Int
  userId    Int?
  accountId Int?
  ip        String?
  userAgent String?
  error     String?
  createdAt DateTime @default(now())

  @@db(logs)
}

// ─── Audit log — logger database ─────────────────────────────────────────────
// driver logger auto-creates auditLogs in audit.db with the unified log shape.
// User model writes here via @secret (expands to @log(audit)) and @@log(audit).
// Query via: db.auditLogs.findMany({ where: { model: 'User' } })
