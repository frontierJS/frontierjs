{
  // .lite language, parser and SQLite client — mixed TS and JS.
  //
  // checkJs stays off, and a file opts in with a `// @ts-check` pragma on its
  // first line once it is clean. The package ceiling is the `litestone` entry in
  // scripts/typecheck-baselines.json, absent meaning 0 (Invariant 14).
  "extends": "../../tsconfig.base.json",
  "compilerOptions": { "checkJs": false },
  "include": ["src/**/*.ts", "src/**/*.js", "test/**/*.js"]
}
