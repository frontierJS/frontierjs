{
  "name": "@frontierjs/litestone",
  "version": "1.1.22",
  "description": "SQLite ORM for Bun — schema-first, type-safe, no third-party dependencies",
  "type": "module",
  "license": "MIT",
  "author": "FrontierJS",
  "homepage": "https://github.com/frontierjs/litestone",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/frontierjs/litestone.git"
  },
  "keywords": [
    "sqlite",
    "bun",
    "orm",
    "database",
    "schema",
    "migrations",
    "query-builder",
    "type-safe",
    "litestream",
    "json-schema",
    "row-level-security",
    "policies",
    "soft-delete",
    "fts5"
  ],
  "bin": {
    "litestone": "./src/tools/cli.js"
  },
  "imports": {
    "#sql-engine": {
      "browser": "./src/engines/none.js",
      "default": "./src/engines/bun-sqlite.js"
    },
    "#host": {
      "browser": "./src/host/browser.js",
      "default": "./src/host/node.js"
    }
  },
  "exports": {
    ".": {
      "import": "./src/index.js",
      "types": "./src/index.d.ts"
    },
    "./engine": {
      "types": "./src/core/engine.d.ts",
      "import": "./src/core/engine.js"
    },
    "./browser": {
      "types": "./src/browser/client.d.ts",
      "import": "./src/browser/client.js"
    },
    "./browser/worker": {
      "types": "./src/browser/worker.d.ts",
      "import": "./src/browser/worker.js"
    },
    "./engines/sqlite-wasm": {
      "types": "./src/engines/sqlite-wasm.d.ts",
      "import": "./src/engines/sqlite-wasm.js"
    },
    "./migrate": {
      "types": "./src/core/migrate.d.ts",
      "import": "./src/core/migrate.js"
    },
    "./migrations": {
      "import": "./src/core/migrations.js",
      "types": "./src/core/migrations.d.ts"
    },
    "./parser": {
      "types": "./src/core/parser.d.ts",
      "import": "./src/core/parser.js"
    },
    "./device-schema": {
      "types": "./src/device-schema.d.ts",
      "import": "./src/device-schema.js"
    },
    "./import": {
      "types": "./src/import/index.d.ts",
      "import": "./src/import/index.js"
    },
    "./jsonschema": {
      "types": "./src/jsonschema.d.ts",
      "import": "./src/jsonschema.js"
    },
    "./export": {
      "types": "./src/export.d.ts",
      "import": "./src/export.js"
    },
    "./ddl": {
      "types": "./src/core/ddl.d.ts",
      "import": "./src/core/ddl.js"
    },
    "./testing": {
      "import": "./src/testing.js",
      "types": "./src/testing.d.ts"
    },
    "./types": {
      "types": "./src/tools/typegen.d.ts",
      "import": "./src/tools/typegen.js"
    },
    "./storage": {
      "import": "./src/storage/index.js",
      "types": "./src/storage/index.d.ts"
    },
    "./replicate": {
      "import": "./src/tools/replicate.js",
      "types": "./src/tools/replicate.d.ts"
    },
    "./repl": {
      "import": "./src/tools/repl.js",
      "types": "./src/tools/repl.d.ts"
    },
    "./transform": {
      "import": "./src/transform/framework.js",
      "types": "./src/transform/framework.d.ts"
    },
    "./external-ref": {
      "types": "./src/plugins/external-ref.d.ts",
      "import": "./src/plugins/external-ref.js"
    },
    "./references/*": "./references/*"
  },
  "main": "./src/index.js",
  "files": [
    "src/",
    "references/",
    "README.md",
    "AGENTS.md",
    "catalog.snapshot.md",
    "LICENSE"
  ],
  "publishConfig": {
    "access": "public"
  },
  "engines": {
    "bun": ">=1.4.0"
  },
  "scripts": {
    "dev": "bun src/tools/cli.js",
    "test": "node ../../scripts/tmp-run.mjs 'node ../../scripts/emit-types.mjs --check && bun test test/ && bun bench/statements.mjs'",
    "types": "node ../../scripts/emit-types.mjs",
    "test:watch": "bun test --watch test/",
    "test:smoke": "bun test test/cli-smoke.test.ts",
    "test:browser": "node test/browser/verify-browser-client.mjs",
    "bench": "bun bench/audit-bench.mjs",
    "bench:core": "bun bench/audit-bench.mjs baseline",
    "bench:ablation": "bun bench/ablation.mjs",
    "bench:statements": "bun bench/statements.mjs",
    "build:binary": "bun scripts/build-binary.js",
    "build:binary:all": "bun scripts/build-binary.js --all --clean",
    "build:lib": "bun scripts/build-lib.js",
    "build:lib:testing": "bun scripts/build-lib.js --with-testing",
    "typecheck": "node ../../scripts/typecheck.mjs",
    "verify:studio": "s=0; node test/verify-studio-access.mjs || s=1; node test/verify-studio-explore.mjs || s=1; node test/verify-studio-models.mjs || s=1; node test/verify-studio-compare.mjs || s=1; node test/verify-studio-preview.mjs || s=1; node test/verify-studio-advisor.mjs || s=1; exit $s",
    "verify:studio:access": "node test/verify-studio-access.mjs",
    "verify:studio:explore": "node test/verify-studio-explore.mjs",
    "verify:studio:models": "node test/verify-studio-models.mjs",
    "verify:studio:compare": "node test/verify-studio-compare.mjs",
    "verify:studio:preview": "node test/verify-studio-preview.mjs",
    "verify:studio:advisor": "node test/verify-studio-advisor.mjs"
  },
  "types": "./src/index.d.ts",
  "dependencies": {
    "@frontierjs/toolbelt": "workspace:*"
  },
  "devDependencies": {
    "@sqlite.org/sqlite-wasm": "^3.53.4-build1"
  }
}
