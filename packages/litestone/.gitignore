# Dependencies
node_modules/

# SQLite databases + WAL/SHM sidecars (runtime artifacts)
*.db
*.db-wal
*.db-shm

# Litestone runtime output dirs — ROOT-ANCHORED so they never match
# source dirs like src/storage/ (the FileStorage plugin source).
/storage/
/audit/
/logs/

*.log
.DS_Store
.env
.env.*

# Corpus fixtures fetched on demand — only triggerdev.lite is committed, and the
# gap report is regenerated by fetch.mjs rather than tracked.
test/fixtures/corpus/calcom.lite
test/fixtures/corpus/documenso.lite
test/fixtures/corpus/gaps.json
# maidtech is a private source: not fetchable and not published, so it is a
# local fixture rather than a target anybody else can regenerate.
test/fixtures/corpus/maidtech.lite
