# Dependencies
node_modules/

# SQLite databases + WAL/SHM sidecars (runtime artifacts)
*.db
*.db-wal
*.db-shm

# Litestone runtime output dirs — ROOT-ANCHORED so they never match
# source dirs like src/storage/ (the FileStorage plugin source).
/storage/
/audit/
/logs/

*.log
.DS_Store
.env
.env.*

# Corpus fixtures fetched on demand — FETCHED in fixtures/corpus/tiers.js — and
# the gap report, which fetch.mjs regenerates rather than git tracking it.
test/fixtures/corpus/calcom.lite
test/fixtures/corpus/documenso.lite
test/fixtures/corpus/employees.lite
test/fixtures/corpus/gitlab.lite
test/fixtures/corpus/gaps.json
# maidtech is a private source: not fetchable and not published, so it is a
# local fixture rather than a target anybody else can regenerate. It must NOT
# sit in the tree — a hidden source file is what the hygiene phase exists to
# catch, and `generatedIgnored` cannot cover it because that list is for
# generated files only. Point FRONTIER_CORPUS_LOCAL at the directory holding it.
# This rule stays as a guard against dropping it back in.
test/fixtures/corpus/maidtech.lite
test/browser/dist/
test/browser/dist-audit/
