  occurredAt                         DateTime
  idempotencyKeyId                   String?
  idempotencyKey                     IdempotencyKey?                    @relation(fields: [idempotencyKeyId], references: [id])
  stackTrace                         String?
  internalErrorMessage               String?
  traceId                            String?
  hidden                             Boolean                            @default(false)

  @@index([statusCode])
  @@index([errorCode])
  @@index([accountId])
  @@index([actorId])
  @@index([userAgent])
  @@index([normalizedRoute])
  @@index([idempotencyKeyId])
  @@index([occurredAt])
  @@index([targetAccountId])
  @@index([targetAccountId, actorId])
  @@index([targetAccountId, identityType])
  @@index([clientIpString])
  @@index([targetAccountId, errorCode])
  @@index([targetAccountId, statusCode])
  @@index([accountId, actorId])
  @@index([accountId, statusCode])
  @@index([accountId, errorCode])
  @@gate("8")
}

