// OpenMRP — the data model of an open-source manufacturing ERP, expressed in .lite.
//
// Derived mechanically from the MySQL schema of https://github.com/open-mrp/api
// (Apache 2.0), `shared/db/migrations/0001_initial.sql`, and then given the
// declarations an FJS app would carry: a gate ladder per model, @@softDelete
// where the table had a deleted_at column, @version where it had a version one.
//
// A SCALE FIXTURE, not a design. 188 models, 1910 columns, 295 relations,
// 10 implicit many-to-many pairs. Nothing here is a claim about how an MRP should
// be modelled, and four things about it are the converter rather than the source:
//
//   · a @relation is emitted only where the (table, target) pair is
//     unambiguous, so a table with two foreign keys to one target keeps them
//     as plain columns — Prisma and .lite both want a labelled relation there
//   · column names are camelCase with no @map, because this is a new schema
//     rather than one attached to their database
//   · every decimal is a Float, which is wrong for money and right for a
//     fixture: .lite has no Decimal, and 45 of these columns are Prisma's
//     unqualified decimal(65,30) rather than a stated precision
//   · `@@index([deletedAt])` is dropped where the model soft-deletes, which
//     @@softDelete already builds and litestone refuses at parse (FJS-480 —
//     the source table declared exactly that index)

model InventoryIssueStatus {
  id                                 String                             @id @default(cuid())
  code                               String                             @unique
  name                               String
  createdAt                          DateTime                           @default(now())
  updatedAt                          DateTime                           @updatedAt

  @@gate("2.4.4.5")
}

model Account {
  id                                 String                             @id @default(cuid())
  name                               String
  accountTypeCode                    String
  onboardingStatusCode               String
  accountBillingId                   String?                            @unique
  accountBilling                     AccountBilling?                    @relation(fields: [accountBillingId], references: [id])
  defaultBillingAddressId            String?                            @unique
  defaultShippingAddressId           String?                            @unique
  updatedAt                          DateTime                           @updatedAt
  createdAt                          DateTime                           @default(now())
  accountPlanId                      String?
  accountPlan                        AccountPlan?                       @relation(fields: [accountPlanId], references: [id])
  internalStripeCustomerId           String?
  internalStripeSubscriptionId       String?
  subscriptionStatus                 String?
  subscriptionCurrentPeriodEnd       DateTime?
  accountAddresses                   AccountAddress[]
  accountIntegrations                AccountIntegration[]
  accountInventorySettings           AccountInventorySetting[]
  accountProductionScheduleSettings  AccountProductionScheduleSetting[]
  accountUsers                       AccountUser[]
  agentTokenBillings                 AgentTokenBilling[]
  announcements                      Announcement[]
  attributes                         Attribute[]
  auditEvents                        AuditEvent[]
  batches                            Batch[]
  carriers                           Carrier[]
  carrierOptions                     CarrierOption[]
  carrierTransitEstimates            CarrierTransitEstimate[]
  changeLogs                         ChangeLog[]
  conversations                      Conversation[]
  conversationDmKeys                 ConversationDmKey[]
  conversationLinks                  ConversationLink[]
  conversationParticipants           ConversationParticipant[]
  dcLocations                        DcLocation[]
  deliveries                         Delivery[]
  demandOverrides                    DemandOverride[]
  departments                        Department[]
  ediRuns                            EdiRun[]
  ediTransmissions                   EdiTransmission[]
  emailDomains                       EmailDomain[]
  emailInboxes                       EmailInbox[]
  emailLogs                          EmailLog[]
  emailMessages                      EmailMessage[]
  errorLogs                          ErrorLog[]
  hubspotCompanyReviews              HubspotCompanyReview[]
  hubspotSyncJobs                    HubspotSyncJob[]
  hubspotSyncRecords                 HubspotSyncRecord[]
  inventoryChangeLogs                InventoryChangeLog[]
  inventoryIssues                    InventoryIssue[]
  inventoryLogs                      InventoryLog[]
  invoices                           Invoice[]
  items                              Item[]
  itemCategories                     ItemCategory[]
  jobs                               Job[]
  journalPostings                    JournalPosting[]
  lots                               Lot[]
  machines                           Machine[]
  machineDowntimeEvents              MachineDowntimeEvent[]
  messages                           Message[]
  messageAttachments                 MessageAttachment[]
  messagingBlocks                    MessagingBlock[]
  messagingGroups                    MessagingGroup[]
  messagingGroupMembers              MessagingGroupMember[]
  messagingReports                   MessagingReport[]
  notifications                      Notification[]
  notificationPreferences            NotificationPreference[]
  operatingCalendars                 OperatingCalendar[]
  operatingCalendarClosures          OperatingCalendarClosure[]
  orderDiscounts                     OrderDiscount[]
  paymentTerms                       PaymentTerm[]
  picks                              Pick[]
  portalDomains                      PortalDomain[]
  productLines                       ProductLine[]
  productLineTargets                 ProductLineTarget[]
  productionRuns                     ProductionRun[]
  productionSchedules                ProductionSchedule[]
  productionScheduleDerivedLines     ProductionScheduleDerivedLine[]
  productionScheduleDeviations       ProductionScheduleDeviation[]
  productionScheduleFinishedPolicies ProductionScheduleFinishedPolicy[]
  productionScheduleFinishingLines   ProductionScheduleFinishingLine[]
  productionScheduleItemPolicies     ProductionScheduleItemPolicy[]
  productionScheduleItemSettings     ProductionScheduleItemSetting[]
  productionScheduleLines            ProductionScheduleLine[]
  productionScheduleLineOrders       ProductionScheduleLineOrder[]
  productionScheduleResourceSettings ProductionScheduleResourceSetting[]
  productionShifts                   ProductionShift[]
  productionSteps                    ProductionStep[]
  properties                         Property[]
  quantityDiscounts                  QuantityDiscount[]
  receivingOrders                    ReceivingOrder[]
  registrationFlows                  RegistrationFlow[]
  registrationSessions               RegistrationSession[]
  requestLogs                        RequestLog[]
  roles                              Role[]
  sandboxAccounts                    SandboxAccount[]
  scanningStations                   ScanningStation[]
  settlements                        Settlement[]
  shipments                          Shipment[]
  shippingCases                      ShippingCase[]
  shippingTerms                      ShippingTerm[]
  storageLocations                   StorageLocation[]
  supportRoutes                      SupportRoute[]
  sysProperties                      SysProperty[]
  targets                            Target[]
  territories                        Territory[]
  tokenPackPurchases                 TokenPackPurchase[]
  transactions                       Transaction[]
  units                              Unit[]
  unitGroups                         UnitGroup[]

  @@index([accountTypeCode])
  @@index([onboardingStatusCode])
  @@gate("2.4.4.5")
}

model AccountAddress {
  id                                 String                             @id @default(cuid())
  accountId                          String
  account                            Account                            @relation(fields: [accountId], references: [id])
  addressId                          String
  address                            Address                            @relation(fields: [addressId], references: [id])
  createdAt                          DateTime                           @default(now())
  updatedAt                          DateTime                           @updatedAt

  @@unique([accountId, addressId])
  @@index([addressId])
  @@gate("2.4.4.5")
}

model AccountBilling {
  id                                 String                             @id @default(cuid())
  accountPlanId                      String
  accountPlan                        AccountPlan                        @relation(fields: [accountPlanId], references: [id])
  internalStripeCustomerId           String?
  internalStripeSubscriptionId       String?
  subscriptionStatus                 String?
  subscriptionCurrentPeriodEnd       DateTime?
  stripeBillingProfileId             String?
  stripeBillingCadenceId             String?
  stripePricingPlanSubscriptionId    String?
  servicingStatus                    String?
  collectionStatus                   String?
  agentMonthlySpendingCapCents       Int?
  createdAt                          DateTime                           @default(now())
  updatedAt                          DateTime                           @updatedAt
  accounts                           Account[]

  @@index([accountPlanId])
  @@index([internalStripeCustomerId])
  @@gate("4.5.5.6")
}

model AccountBranding {
  id                                 String                             @id @default(cuid())
  ownerAccountId                     String                             @unique
  supportEmail                       String?
  logoUrl                            String?
  faviconUrl                         String?
  phoneNumber                        String?
  facebookHandle                     String?
  instagramHandle                    String?
  linkedinHandle                     String?
  twitterHandle                      String?
  websiteUrl                         String?
  updatedAt                          DateTime                           @updatedAt
  createdAt                          DateTime                           @default(now())

  @@gate("2.4.4.5")
}

model AccountGroup {
  id                                 String                             @id @default(cuid())
  ownerAccountId                     String
  name                               String
  description                        String?
  commissionStatusCode               String
  freightStatusCode                  String
  accountGroupTypeCode               String
  registrationFlowId                 String?
  registrationFlow                   RegistrationFlow?                  @relation(fields: [registrationFlowId], references: [id])
  updatedAt                          DateTime                           @updatedAt
  createdAt                          DateTime                           @default(now())
  defaultLeadTimeDays                Int?
  fulfillmentPolicyCode              String?
  receiveCalendarId                  String?
  accountGroupProductLines           AccountGroupProductLine[]
  accountGroupQuantityDiscounts      AccountGroupQuantityDiscount[]
  accountRelations                   AccountRelation[]
  accountRelationPriceGroups         AccountRelationPriceGroup[]

  @@index([registrationFlowId])
  @@index([ownerAccountId])
  @@index([accountGroupTypeCode])
  @@index([receiveCalendarId])
  @@gate("2.4.4.5")
}

model AccountGroupProductLine {
  id                                 String                             @id @default(cuid())
  accountGroupId                     String
  accountGroup                       AccountGroup                       @relation(fields: [accountGroupId], references: [id])
  productLineId                      String
  productLine                        ProductLine                        @relation(fields: [productLineId], references: [id])
  createdAt                          DateTime                           @default(now())
  updatedAt                          DateTime                           @updatedAt

  @@unique([accountGroupId, productLineId])
  @@index([productLineId])
  @@gate("2.4.4.5")
}

model AccountGroupQuantityDiscount {
  id                                 String                             @id @default(cuid())
  accountGroupId                     String
  accountGroup                       AccountGroup                       @relation(fields: [accountGroupId], references: [id])
  quantityDiscountId                 String
  quantityDiscount                   QuantityDiscount                   @relation(fields: [quantityDiscountId], references: [id])
  createdAt                          DateTime                           @default(now())
  updatedAt                          DateTime                           @updatedAt

  @@unique([accountGroupId, quantityDiscountId])
  @@index([quantityDiscountId])
  @@gate("2.4.4.5")
}

model AccountIntegration {
  id                                 String                             @id @default(cuid())
  accountId                          String
  account                            Account                            @relation(fields: [accountId], references: [id])
  integrationCode                    String
  name                               String
  credentialsV2                      String
  isActive                           Boolean                            @default(true)
  createdAt                          DateTime                           @default(now())
  updatedAt                          DateTime                           @updatedAt

  @@unique([accountId, integrationCode])
  @@index([integrationCode])
  @@index([isActive])
  @@gate("2.4.4.5")
}

model AccountInventorySetting {
  id                                 String                             @id @default(cuid())
  accountId                          String                             @unique
  account                            Account                            @relation(fields: [accountId], references: [id])
  inventoryPolicyCode                String
  createdAt                          DateTime                           @default(now())
  updatedAt                          DateTime                           @updatedAt

  @@index([inventoryPolicyCode])
  @@gate("2.4.4.5")
}

model AccountPlan {
  id                                 Int                                @id
  typeId                             String                             @unique
  name                               String
  planTypeCode                       String
  version                            Int                                @version
  pricePerSeat                       Float
  pricePerMonth                      Float?
  seatMinimum                        Int?
  stripePricingPlanId                String?
  registrationLimit                  Int?
  displayFeatures                    Json
  displayOrder                       Int                                @default(0)
  isHighlighted                      Boolean                            @default(false)
  buttonText                         String                             @default("Get Started")
  includesPreviousPlan               String?
  isPubliclyVisible                  Boolean                            @default(false)
  effectiveAt                        DateTime
  expiresAt                          DateTime?
  createdAt                          DateTime                           @default(now())
  updatedAt                          DateTime                           @updatedAt
  accounts                           Account[]
  accountBillings                    AccountBilling[]
  accountPlanFeatures                AccountPlanFeature[]
  accountPlanLimits                  AccountPlanLimit[]

  @@index([planTypeCode, effectiveAt])
  @@index([isPubliclyVisible])
  @@gate("4.5.5.6")
}

model AccountPlanFeature {
  id                                 Int                                @id
  accountPlanId                      String
  accountPlan                        AccountPlan                        @relation(fields: [accountPlanId], references: [id])
  key                                String
  enabled                            Boolean                            @default(false)
  createdAt                          DateTime                           @default(now())
  updatedAt                          DateTime                           @updatedAt

  @@unique([accountPlanId, key])
  @@gate("2.4.4.5")
}

model AccountPlanLimit {
  id                                 Int                                @id
  accountPlanId                      String
  accountPlan                        AccountPlan                        @relation(fields: [accountPlanId], references: [id])
  key                                String
  value                              Int?
  createdAt                          DateTime                           @default(now())
  updatedAt                          DateTime                           @updatedAt

  @@unique([accountPlanId, key])
  @@gate("2.4.4.5")
}

model AccountPortal {
  id                                 String                             @id @default(cuid())
  ownerAccountId                     String                             @unique
  slug                               String                             @unique
  updatedAt                          DateTime                           @updatedAt
  createdAt                          DateTime                           @default(now())

  @@gate("2.4.4.5")
}

model AccountPrice {
  id                                 String                             @id @default(cuid())
  createdAt                          DateTime                           @default(now())
  updatedAt                          DateTime                           @updatedAt
  ownerAccountId                     String
  unitValueId                        String                             @unique
  productLineId                      String
  productLine                        ProductLine                        @relation(fields: [productLineId], references: [id])
  recipientAccountId                 String
  accountPriceAttributes             AccountPriceAttribute[]
  accountPriceItemCategories         AccountPriceItemCategory[]

  @@index([recipientAccountId])
  @@index([ownerAccountId])
  @@index([productLineId])
  @@index([ownerAccountId, recipientAccountId])
  @@gate("2.4.4.5")
}

model AccountPriceAttribute {
  id                                 String                             @id @default(cuid())
  accountPriceId                     String
  accountPrice                       AccountPrice                       @relation(fields: [accountPriceId], references: [id])
  attributeId                        String
  attribute                          Attribute                          @relation(fields: [attributeId], references: [id])
  createdAt                          DateTime                           @default(now())
  updatedAt                          DateTime                           @updatedAt

  @@unique([accountPriceId, attributeId])
  @@index([attributeId])
  @@gate("2.4.4.5")
}

model AccountPriceItemCategory {
  id                                 String                             @id @default(cuid())
  accountPriceId                     String
  accountPrice                       AccountPrice                       @relation(fields: [accountPriceId], references: [id])
  itemCategoryId                     String
  itemCategory                       ItemCategory                       @relation(fields: [itemCategoryId], references: [id])
  createdAt                          DateTime                           @default(now())
  updatedAt                          DateTime                           @updatedAt

  @@unique([accountPriceId, itemCategoryId])
  @@index([itemCategoryId])
  @@gate("2.4.4.5")
}

model AccountProductionScheduleSetting {
  id                                 String                             @id @default(cuid())
  accountId                          String                             @unique
  account                            Account                            @relation(fields: [accountId], references: [id])
  constraintDepartmentId             String?
  planningHorizonWeeks               Int                                @default(13)
  frozenWeeks                        Int                                @default(1)
  weekStartDay                       Int                                @default(1)
  demandWindowMonths                 Int                                @default(12)
  forecastHistoryMonths              Int                                @default(24)
  forecastMonths                     Int                                @default(12)
  demandBasisCode                    String                             @default("trailing_12")
  forecastZ                          Float                              @default(1)
  changeoverAvgMinutes               Float                              @default(30)
  changeoverMinMinutes               Float                              @default(15)
  changeoverMaxMinutes               Float                              @default(90)
  changeoverLaborRate                Float                              @default(20)
  holdingRatePct                     Float                              @default(0.25)
  serviceLevelZ                      Float                              @default(1.645)
  finishLeadTimeWeeks                Float                              @default(6)
  defaultConstraintLeadTimeWeeks     Float                              @default(1.3)
  maxWeeksSupply                     Float                              @default(12)
  maxFlowDepth                       Int                                @default(10)
  shiftsPerDay                       Int                                @default(2)
  hoursPerShift                      Float                              @default(7)
  workDaysPerWeek                    Int                                @default(5)
  weeksPerYear                       Int                                @default(52)
  capacityHeadroomPct                Float                              @default(0.9)
  defaultLotUnits                    Float                              @default(60)
  isEnabled                          Boolean                            @default(false)
  generationCron                     String?
  generationTimezone                 String                             @default("UTC")
  autoPublish                        Boolean                            @default(false)
  lastGeneratedAt                    DateTime?
  createdAt                          DateTime                           @default(now())
  updatedAt                          DateTime                           @updatedAt
  defaultCustomerLeadTimeDays        Int                                @default(30)
  defaultFulfillmentPolicyCode       String                             @default("make_to_stock")
  recommendationAdiThreshold         Float                              @default(1.32)
  recommendationConcentrationPct     Float                              @default(0.8)
  recommendationCv2Threshold         Float                              @default(0.49)
  recommendationDormantMonths        Int                                @default(12)
  recommendationHighValueUnitCost    Float                              @default(50)
  recommendationSlowMoverCogs        Float                              @default(5000)
  receiveCalendarId                  String?
  shipCalendarId                     String?

  @@index([isEnabled, generationCron])
  @@index([shipCalendarId])
  @@index([receiveCalendarId])
  @@gate("2.4.4.5")
}

model AccountRelation {
  id                                 String                             @id @default(cuid())
  ownerAccountId                     String
  counterpartyAccountId              String
  accountRelationRoleCode            String
  externalNumber                     String
  isEdiEnabled                       Boolean                            @default(false)
  stripeCustomerId                   String?
  stripeEmail                        String?
  hubspotCompanyId                   String?
  notes                              String?
  updatedAt                          DateTime                           @updatedAt
  createdAt                          DateTime                           @default(now())
  parentAccountRelationId            String?
  alias                              String?
  defaultBillingAddressId            String?
  defaultShippingAddressId           String?
  commissionStatusCode               String?
  freightStatusCode                  String?
  defaultCarrierId                   String?
  defaultCarrierOptionId             String?
  defaultSalesRepId                  String?
  accountStatusCode                  String?
  paymentTermId                      String?
  paymentTerm                        PaymentTerm?                       @relation(fields: [paymentTermId], references: [id])
  accountGroupId                     String?
  accountGroup                       AccountGroup?                      @relation(fields: [accountGroupId], references: [id])
  priorityCode                       String
  shippingTermId                     String?
  shippingTerm                       ShippingTerm?                      @relation(fields: [shippingTermId], references: [id])
  carrierBillingType                 String?
  carrierBillingAccount              String?
  creditLimitId                      String?                            @unique
  defaultLeadTimeDays                Int?
  fulfillmentPolicyCode              String?
  receiveCalendarId                  String?
  accountRelationNotificationPreferences AccountRelationNotificationPreference[]
  accountRelationPriceGroups         AccountRelationPriceGroup[]
  accountRelationProductLines        AccountRelationProductLine[]

  @@unique([ownerAccountId, counterpartyAccountId, accountRelationRoleCode])
  @@index([parentAccountRelationId])
  @@index([shippingTermId])
  @@index([accountGroupId])
  @@index([accountStatusCode])
  @@index([defaultCarrierOptionId])
  @@index([priorityCode])
  @@index([counterpartyAccountId])
  @@index([defaultCarrierId])
  @@index([defaultSalesRepId])
  @@index([paymentTermId])
  @@index([defaultBillingAddressId])
  @@index([defaultShippingAddressId])
  @@index([ownerAccountId, accountRelationRoleCode])
  @@index([ownerAccountId, accountStatusCode])
  @@index([ownerAccountId, accountGroupId])
  @@index([ownerAccountId, defaultSalesRepId])
  @@index([receiveCalendarId])
  @@gate("2.4.4.5")
}

model AccountRelationNotificationPreference {
  id                                 String                             @id @default(cuid())
  accountRelationId                  String
  accountRelation                    AccountRelation                    @relation(fields: [accountRelationId], references: [id])
  recipientAccountUserId             String
  notificationTypeCode               String
  createdAt                          DateTime                           @default(now())
  updatedAt                          DateTime                           @updatedAt

  @@index([accountRelationId])
  @@index([notificationTypeCode])
  @@index([recipientAccountUserId])
  @@gate("2.4.4.5")
}

model AccountRelationNotificationType {
  id                                 String                             @id @default(cuid())
  code                               String                             @unique
  name                               String
  createdAt                          DateTime                           @default(now())
  updatedAt                          DateTime                           @updatedAt

  @@gate("1.5.5.6")
}

model AccountRelationPriceGroup {
  id                                 String                             @id @default(cuid())
  accountRelationId                  String
  accountRelation                    AccountRelation                    @relation(fields: [accountRelationId], references: [id])
  accountGroupId                     String
  accountGroup                       AccountGroup                       @relation(fields: [accountGroupId], references: [id])
  createdAt                          DateTime                           @default(now())
  updatedAt                          DateTime                           @updatedAt

  @@unique([accountRelationId, accountGroupId])
  @@index([accountGroupId])
  @@gate("2.4.4.5")
}

model AccountRelationProductLine {
  id                                 String                             @id @default(cuid())
  accountRelationId                  String
  accountRelation                    AccountRelation                    @relation(fields: [accountRelationId], references: [id])
  productLineId                      String
  productLine                        ProductLine                        @relation(fields: [productLineId], references: [id])
  createdAt                          DateTime                           @default(now())
  updatedAt                          DateTime                           @updatedAt

  @@unique([accountRelationId, productLineId])
  @@index([productLineId])
  @@gate("2.4.4.5")
}

model AccountStatus {
  id                                 String                             @id @default(cuid())
  code                               String                             @unique
  name                               String
  createdAt                          DateTime                           @default(now())
  updatedAt                          DateTime                           @updatedAt

  @@gate("1.5.5.6")
}

model AccountUser {
  id                                 String                             @id @default(cuid())
  userId                             String
  user                               User                               @relation(fields: [userId], references: [id])
  departmentId                       String?
  department                         Department?                        @relation(fields: [departmentId], references: [id])
  lastUsedAt                         DateTime?
  statusCode                         String                             @default("active")
  createdAt                          DateTime                           @default(now())
  updatedAt                          DateTime                           @updatedAt
  roleId                             String?
  role                               Role?                              @relation(fields: [roleId], references: [id])
  accountId                          String
  account                            Account                            @relation(fields: [accountId], references: [id])
  isCommissionEligible               Boolean                            @default(false)
  announcementReceipts               AnnouncementReceipt[]
  conversationParticipants           ConversationParticipant[]
  hubspotAccountUserLinks            HubspotAccountUserLink[]
  messageReceipts                    MessageReceipt[]
  messagingGroupMembers              MessagingGroupMember[]
  notificationPreferences            NotificationPreference[]
  orderEmailContacts                 OrderEmailContact[]

  @@unique([userId, accountId])
  @@index([departmentId])
  @@index([roleId])
  @@index([statusCode])
  @@index([accountId, statusCode])
  @@gate("2.4.4.5")
}

model ActionType {
  id                                 String                             @id @default(cuid())
  createdAt                          DateTime                           @default(now())
  name                               String
  code                               String                             @unique
  updatedAt                          DateTime                           @updatedAt

  @@gate("1.5.5.6")
}

model Address {
  id                                 String                             @id @default(cuid())
  name                               String
  phone                              String?
  email                              String?
  isDropShip                         Boolean                            @default(false)
  geolocationId                      String
  geolocation                        Geolocation                        @relation(fields: [geolocationId], references: [id])
  createdAt                          DateTime                           @default(now())
  updatedAt                          DateTime                           @updatedAt
  receiveCalendarId                  String?
  accountAddresses                   AccountAddress[]
  storageLocations                   StorageLocation[]

  @@index([geolocationId])
  @@index([receiveCalendarId])
  @@gate("2.4.4.5")
}

model AdjustmentType {
  id                                 String                             @id @default(cuid())
  name                               String
  code                               String                             @unique
  createdAt                          DateTime                           @default(now())
  updatedAt                          DateTime                           @updatedAt

  @@gate("1.5.5.6")
}

model AgentTokenBilling {
  id                                 String                             @id @default(cuid())
  accountId                          String
  account                            Account                            @relation(fields: [accountId], references: [id])
  periodStart                        DateTime
  periodEnd                          DateTime
  totalInputTokens                   Int                                @default(0)
  totalOutputTokens                  Int                                @default(0)
  totalTokens                        Int                                @default(0)
  tokensReportedToStripe             Int                                @default(0)
  stripeMeteredItemId                String?
  runCount                           Int                                @default(0)
  createdAt                          DateTime                           @default(now())
  updatedAt                          DateTime                           @updatedAt

  @@unique([accountId, periodStart])
  @@gate("8")
}

model Announcement {
  id                                 String                             @id @default(cuid())
  scope                              String
  accountId                          String?
  account                            Account?                           @relation(fields: [accountId], references: [id])
  category                           String
  templateKey                        String?
  templateParams                     Json?
  title                              String
  body                               String?
  linkResourceType                   String?
  linkResourceId                     String?
  priority                           String                             @default("normal")
  audience                           Json?
  publishAt                          DateTime
  expiresAt                          DateTime?
  createdBy                          String?
  createdAt                          DateTime                           @default(now())
  updatedAt                          DateTime                           @updatedAt
  announcementReceipts               AnnouncementReceipt[]

  @@index([scope, accountId, publishAt, expiresAt])
  @@index([expiresAt])
  @@gate("2.4.4.5")
}

model AnnouncementReceipt {
  id                                 String                             @id @default(cuid())
  announcementId                     String
  announcement                       Announcement                       @relation(fields: [announcementId], references: [id])
  accountUserId                      String
  accountUser                        AccountUser                        @relation(fields: [accountUserId], references: [id])
  seenAt                             DateTime?
  readAt                             DateTime?
  dismissedAt                        DateTime?
  createdAt                          DateTime                           @default(now())

  @@unique([announcementId, accountUserId])
  @@gate("2.4.4.5")
}

model ApiKey {
  id                                 Int                                @id
  typeId                             String                             @unique
  keyId                              String                             @unique
  name                               String?
  secretHash                         Bytes                              @unique
  redactedValue                      String
  ownerAccountId                     String
  roleId                             String
  role                               Role                               @relation(fields: [roleId], references: [id])
  createdAt                          DateTime                           @default(now())
  updatedAt                          DateTime                           @updatedAt
  lastUsedAt                         DateTime?
  expiresAt                          DateTime?
  revokedAt                          DateTime?
  docApiKeys                         DocApiKey[]

  @@index([ownerAccountId])
  @@index([roleId])
  @@index([ownerAccountId, revokedAt])
  @@index([ownerAccountId, expiresAt])
  @@gate("8")
}

model Attribute {
