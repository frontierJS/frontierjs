  lastError                          String?
  lockedAt                           DateTime?
  lockOwner                          String?
  editedAt                           DateTime?
  deletedAt                          DateTime?
  metadata                           Json?
  createdAt                          DateTime                           @default(now())
  updatedAt                          DateTime                           @updatedAt
  emailMessages                      EmailMessage[]
  messageAttachments                 MessageAttachment[]
  messageInboxes                     MessageInbox[]
  messageOutboxes                    MessageOutbox[]
  messageReceipts                    MessageReceipt[]
  messagingReports                   MessagingReport[]

  @@unique([conversationId, sequence], nullsDistinct: true)
  @@unique([conversationId, clientMessageId], nullsDistinct: true)
  @@index([conversationId])
  @@index([conversationId, replyToMessageId])
  @@index([accountId, linkResourceType, linkResourceId])
  @@index([accountId, eventType, createdAt])
  @@index([accountId, agentRunId])
  @@index([status, scheduledFor])
  @@index([conversationId, status])
  @@index([accountId, status, scheduledFor, id])
  @@softDelete
  @@gate("2.4.4.5")
}

