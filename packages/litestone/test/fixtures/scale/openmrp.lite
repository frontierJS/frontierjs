model RequestLog {
  id                                 String                             @id @default(cuid())
  method                             String
  host                               String
  path                               String
  normalizedRoute                    String
  queryJson                          Json?
  requestBodyJson                    Json?
  responseBodyJson                   Json?
  statusCode                         Int
  latencyUs                          Int
  targetAccountId                    String?
  publicEndpoint                     Boolean                            @default(true)
  apiVersion                         String?
  accountId                          String?
  account                            Account?                           @relation(fields: [accountId], references: [id])
  actorId                            String?
  actorType                          String?
  identityType                       String?
  clientIp                           Bytes?
  clientIpString                     String?
  userAgent                          String?
  referrer                           String?
  errorCode                          String?
  errorMessage                       String?
