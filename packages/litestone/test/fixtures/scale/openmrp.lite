  shippingTerm                       ShippingTerm?                      @relation(fields: [shippingTermId], references: [id])
  salesOrderStatusCode               String
  salesOrderTypeCode                 String
  paymentTermId                      String?
  paymentTerm                        PaymentTerm?                       @relation(fields: [paymentTermId], references: [id])
  productionRunId                    String?
  productionRun                      ProductionRun?                     @relation(fields: [productionRunId], references: [id])
  orderDiscountId                    String?
  orderDiscount                      OrderDiscount?                     @relation(fields: [orderDiscountId], references: [id])
  buyerAccountId                     String
  sellerAccountId                    String
  ownerAccountId                     String
  completedAt                        DateTime?
  expiredAt                          DateTime?
  firstShipAt                        DateTime?
  issuedAt                           DateTime?
  promisedAt                         DateTime?
  createdAt                          DateTime                           @default(now())
  updatedAt                          DateTime                           @updatedAt
  leadTimeDays                       Int?
  leadTimeSourceCode                 String?
  shipByDate                         DateTime?
  transitDays                        Int?
  transitSourceCode                  String?
  calendarAdjustmentDays             Int?
  leadTimeOverrideDays               Int?
  shipByCutoffAt                     DateTime?
  shipByOverrideDate                 DateTime?
  deliveries                         Delivery[]
  invoices                           Invoice[]
  orderEmailContacts                 OrderEmailContact[]
  orderPaymentIntents                OrderPaymentIntent[]
  picks                              Pick[]
  productionScheduleLineOrders       ProductionScheduleLineOrder[]
  salesOrderLines                    SalesOrderLine[]
  shipments                          Shipment[]

  @@unique([ownerAccountId, salesOrderTypeCode, number])
  @@index([ownerAccountId])
  @@index([ownerAccountId, sellerAccountId, salesOrderTypeCode])
  @@index([sellerAccountId])
  @@index([buyerAccountId])
  @@index([billingAddressId])
  @@index([productionRunId])
  @@index([shippingAddressId])
  @@index([salesOrderTypeCode])
  @@index([orderDiscountId])
  @@index([carrierId])
  @@index([carrierOptionId])
  @@index([salesRepId])
  @@index([shippingTermId])
  @@index([number])
  @@index([paymentTermId])
  @@index([issuedAt])
  @@index([completedAt])
  @@index([salesOrderStatusCode])
  @@index([priorityCode])
  @@index([ownerAccountId, salesOrderStatusCode])
  @@index([ownerAccountId, buyerAccountId])
  @@index([ownerAccountId, salesRepId])
  @@index([ownerAccountId, sellerAccountId])
  @@index([ownerAccountId, customerPoNumber])
  @@index([ownerAccountId, issuedAt])
  @@index([ownerAccountId, salesOrderStatusCode, shipByDate, id])
  @@gate("2.4.4.5")
}

