  account                            Account                            @relation(fields: [accountId], references: [id])
  sequence                           Int?
  kind                               String                             @default("chat")
  status                             String                             @default("sent")
  visibility                         String                             @default("internal")
  senderParticipantId                String?
  clientMessageId                    String?
  body                               String?
  subject                            String?
  channel                            String?
  preview                            String?
  eventType                          String?
  templateKey                        String?
