  state                              String
  salesRepId                         String
  accountId                          String
  account                            Account                            @relation(fields: [accountId], references: [id])
  productLineId                      String?
  productLine                        ProductLine?                       @relation(fields: [productLineId], references: [id])
  createdAt                          DateTime                           @default(now())
  updatedAt                          DateTime                           @updatedAt

  @@index([salesRepId])
  @@index([productLineId])
  @@index([accountId])
  @@gate("2.4.4.5")
}

model TokenPackPurchase {
  id                                 String                             @id @default(cuid())
  accountId                          String
  account                            Account                            @relation(fields: [accountId], references: [id])
  packId                             String
  tokenCount                         Int
  priceCents                         Int
  stripePaymentIntentId              String?
  stripeCheckoutSessionId            String?
  status                             String                             @default("pending")
  createdAt                          DateTime                           @default(now())
  updatedAt                          DateTime                           @updatedAt

  @@index([accountId])
  @@index([status])
  @@index([accountId, status])
  @@gate("4.5.5.6")
}

model Transaction {
  id                                 String                             @id @default(cuid())
  customerAccountId                  String
  amountId                           String                             @unique
  note                               String?
  transactionMethodCode              String?
  transactionTypeCode                String
  isFullyAllocated                   Boolean                            @default(false)
  responsibleUserId                  String?
  accountId                          String
  account                            Account                            @relation(fields: [accountId], references: [id])
  createdAt                          DateTime                           @default(now())
  updatedAt                          DateTime                           @updatedAt
  adjustmentTypeCode                 String?
  stripePaymentId                    String?                            @unique
  fundsReceivedAt                    DateTime?
  number                             String
  transactionAllocations             TransactionAllocation[]

  @@index([transactionMethodCode])
  @@index([transactionTypeCode])
  @@index([adjustmentTypeCode])
  @@index([customerAccountId])
  @@index([responsibleUserId])
  @@index([accountId, createdAt])
  @@index([accountId, transactionTypeCode])
  @@index([accountId, customerAccountId])
  @@index([accountId, transactionMethodCode])
  @@index([accountId, adjustmentTypeCode])
  @@gate("4.5.5.6")
}

model TransactionAllocation {
  id                                 String                             @id @default(cuid())
  transactionId                      String
  transaction                        Transaction                        @relation(fields: [transactionId], references: [id])
  amountId                           String                             @unique
  invoiceId                          String
  invoice                            Invoice                            @relation(fields: [invoiceId], references: [id])
  settlementId                       String?
  settlement                         Settlement?                        @relation(fields: [settlementId], references: [id])
  createdAt                          DateTime                           @default(now())
  updatedAt                          DateTime                           @updatedAt
  note                               String?

  @@index([settlementId])
  @@index([transactionId])
  @@index([invoiceId])
  @@index([createdAt])
  @@gate("4.5.5.6")
}

model TransactionMethod {
  id                                 String                             @id @default(cuid())
  name                               String
  code                               String                             @unique
  createdAt                          DateTime                           @default(now())
  updatedAt                          DateTime                           @updatedAt

  @@gate("1.5.5.6")
}

model TransactionType {
  id                                 String                             @id @default(cuid())
  name                               String
  code                               String                             @unique
  isCommissionAffected               Boolean                            @default(false)
  createdAt                          DateTime                           @default(now())
  updatedAt                          DateTime                           @updatedAt

  @@gate("1.5.5.6")
}

model Unit {
  id                                 String                             @id @default(cuid())
  name                               String
  createdAt                          DateTime                           @default(now())
  updatedAt                          DateTime                           @updatedAt
  accountId                          String?
  account                            Account?                           @relation(fields: [accountId], references: [id])
  abbreviation                       String
  unitDimensionCode                  String
  ratioNumerator                     Float                              @default(1)
  ratioDenominator                   Float                              @default(1)
  offsetNumerator                    Float                              @default(0)
  offsetDenominator                  Float                              @default(1)
  isBaseUnit                         Boolean                            @default(false)
  demandOverrides                    DemandOverride[]
  productionScheduleItemPolicies     ProductionScheduleItemPolicy[]
  quantities                         Quantity[]
  unitGroupUnits                     UnitGroupUnit[]
  quantityDiscounts                  QuantityDiscount[]

  @@unique([accountId, abbreviation], nullsDistinct: true)
  @@unique([accountId, name], nullsDistinct: true)
  @@index([accountId, id, createdAt])
  @@index([unitDimensionCode])
  @@gate("1.5.5.6")
}

model UnitGroup {
  id                                 String                             @id @default(cuid())
  name                               String
  notes                              String?
  createdAt                          DateTime                           @default(now())
  updatedAt                          DateTime                           @updatedAt
  baseUnitId                         String
  accountId                          String?
  account                            Account?                           @relation(fields: [accountId], references: [id])
  unitTypeCode                       String
  itemCategories                     ItemCategory[]
  productLines                       ProductLine[]
  unitGroupUnits                     UnitGroupUnit[]

  @@unique([accountId, name], nullsDistinct: true)
  @@index([baseUnitId])
  @@index([accountId])
  @@index([unitTypeCode])
  @@gate("1.5.5.6")
}

model UnitGroupUnit {
  id                                 String                             @id @default(cuid())
  createdAt                          DateTime                           @default(now())
  updatedAt                          DateTime                           @updatedAt
  unitGroupId                        String
  unitGroup                          UnitGroup                          @relation(fields: [unitGroupId], references: [id])
  unitId                             String
  unit                               Unit                               @relation(fields: [unitId], references: [id])
  discountPercentage                 Float                              @default(0)
  discountFixed                      Float                              @default(0)
  isVisible                          Boolean                            @default(true)

  @@unique([unitId, unitGroupId])
  @@index([unitGroupId])
  @@gate("2.4.4.5")
}

model UnitType {
  id                                 String                             @id @default(cuid())
  createdAt                          DateTime                           @default(now())
  updatedAt                          DateTime                           @updatedAt
  name                               String?
  code                               String                             @unique

  @@gate("1.5.5.6")
}

model User {
  id                                 String                             @id @default(cuid())
  email                              String?                            @unique
  name                               String?
  username                           String?                            @unique
  hashedPassword                     String?
  emailVerified                      DateTime?
  imageUrl                           String?
  statusCode                         String                             @default("active")
  createdAt                          DateTime                           @default(now())
  updatedAt                          DateTime                           @updatedAt
  accountUsers                       AccountUser[]
  portalRegistrationSessions         PortalRegistrationSession[]
  refreshTokens                      RefreshToken[]
  registrationSessions               RegistrationSession[]

  @@index([statusCode])
  @@gate("2.4.4.5")
}
