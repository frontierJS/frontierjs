model BackgroundWorkerTask {
  id String @id @default(cuid())
  slug String
  description String?
  friendlyId String @unique
  filePath String
  exportName String?
  worker BackgroundWorker @relation(fields: [workerId], references: [id], onDelete: Cascade, onUpdate: Cascade)
