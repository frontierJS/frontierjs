  @@index([userId])
}

enum OrganizationAccessTokenType {
  USER
  SYSTEM
}

model OrganizationAccessToken {
  id String @id @default(cuid())
  name String
  type OrganizationAccessTokenType @default(USER)
  hashedToken String @unique
  organization Organization @relation(fields: [organizationId], references: [id])
  organizationId String
  expiresAt DateTime?
  revokedAt DateTime?
  lastAccessedAt DateTime?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([organizationId, type, createdAt])
}

model Organization {
  id String @id @default(cuid())
  slug String @unique
  title String
  maximumExecutionTimePerRunInMs Int @default(900000)
  maximumConcurrencyLimit Int @default(10)
