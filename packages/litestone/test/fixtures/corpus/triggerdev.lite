  expiresAt DateTime? @map("expires_at")
  updatedAt DateTime @updatedAt @map("updated_at")
  createdAt DateTime @map("created_at") @default(now())

  @@index([runtimeEnvironmentId, revokedAt, createdAt])
  @@map("api_keys")
}

model RevokedApiKey {
  id String @id @default(cuid())
  apiKey String
