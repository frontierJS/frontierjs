enum TaskRunStatus {
  DELAYED
  PENDING
  PENDING_VERSION
  WAITING_FOR_DEPLOY
  DEQUEUED
  EXECUTING
  WAITING_TO_RESUME
  RETRYING_AFTER_FAILURE
  PAUSED
  CANCELED
  INTERRUPTED
  COMPLETED_SUCCESSFULLY
  COMPLETED_WITH_ERRORS
  SYSTEM_FAILURE
