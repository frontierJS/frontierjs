  localAccountId Int @map("local_account_id")
  localAccount Account @relation(fields: [localAccountId], references: [id], onDelete: Cascade)
  notify Boolean?
  relationshipSeveranceEventId Int @map("relationship_severance_event_id")
  relationshipSeveranceEvent RelationshipSeveranceEvent @relation(fields: [relationshipSeveranceEventId], references: [id], onDelete: Cascade)
  remoteAccountId Int @map("remote_account_id")
  remoteAccount Account @relation(fields: [remoteAccountId], references: [id], onDelete: Cascade)
  showReblogs Boolean? @map("show_reblogs")
  updatedAt DateTime @map("updated_at")
  @@index([localAccountId, relationshipSeveranceEventId])
  @@unique([relationshipSeveranceEventId, localAccountId, direction, remoteAccountId])
  @@index([remoteAccountId])
}

