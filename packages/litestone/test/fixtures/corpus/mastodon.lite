model StatusTrend {
  id Int @id @default(autoincrement())
  accountId Int @map("account_id")
  account Account @relation(fields: [accountId], references: [id], onDelete: Cascade)
  allowed Boolean @default(false)
  language String?
  rank Int @default(0)
  score Float @default(0.0)
  statusId Int @map("status_id")
  status Status @relation(fields: [statusId], references: [id], onDelete: Cascade)
  @@index([accountId])
  @@unique([statusId])
}

model Status {
  id Int @id @default(autoincrement())
  accountId Int @map("account_id")
  account Account @relation(fields: [accountId], references: [id], onDelete: Cascade)
  applicationId Int? @map("application_id")
  conversationId Int? @map("conversation_id")
  createdAt DateTime @map("created_at")
  deletedAt DateTime? @map("deleted_at")
  editedAt DateTime? @map("edited_at")
  fetchedRepliesAt DateTime? @map("fetched_replies_at")
  inReplyToAccountId Int? @map("in_reply_to_account_id")
  inReplyToAccount Account? @relation(fields: [inReplyToAccountId], references: [id], onDelete: SetNull)
  inReplyToId Int? @map("in_reply_to_id")
  inReplyTo Status? @relation(fields: [inReplyToId], references: [id], onDelete: SetNull)
  language String?
  local Boolean?
  orderedMediaAttachmentIds Int[]? @map("ordered_media_attachment_ids")
  pollId Int? @map("poll_id")
  quoteApprovalPolicy Int @map("quote_approval_policy") @default(0)
  reblogOfId Int? @map("reblog_of_id")
  reblogOf Status? @relation(fields: [reblogOfId], references: [id], onDelete: Cascade)
  reply Boolean @default(false)
  sensitive Boolean @default(false)
  spoilerText String @map("spoiler_text") @default("")
  text String @default("")
  trendable Boolean?
  updatedAt DateTime @map("updated_at")
  uri String?
  url String?
  visibility Int @default(0)
  @@index([accountId, visibility, updatedAt])
  @@index([accountId])
  @@index([conversationId])
  @@index([deletedAt])
  @@index([language, accountId])
  @@index([inReplyToAccountId])
  @@index([inReplyToId])
  @@index([reblogOfId, accountId])
}

