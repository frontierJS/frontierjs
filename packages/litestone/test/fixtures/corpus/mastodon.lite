  updatedAt DateTime @map("updated_at")
  username String
  @@index([normalizedUsername])
}

model User {
  id Int @id @default(autoincrement())
  accountId Int @map("account_id")
  account Account @relation(fields: [accountId], references: [id], onDelete: Cascade)
  ageVerifiedAt DateTime? @map("age_verified_at")
  approved Boolean @default(true)
  chosenLanguages String[]? @map("chosen_languages")
  confirmationSentAt DateTime? @map("confirmation_sent_at")
  confirmationToken String? @map("confirmation_token")
  confirmedAt DateTime? @map("confirmed_at")
  consumedTimestep Int? @map("consumed_timestep")
  createdAt DateTime @map("created_at")
  createdByApplicationId Int? @map("created_by_application_id")
  createdByApplication OauthApplication? @relation(fields: [createdByApplicationId], references: [id], onDelete: SetNull)
  currentSignInAt DateTime? @map("current_sign_in_at")
  disabled Boolean @default(false)
  email String @default("")
  encryptedPassword String @map("encrypted_password") @default("")
  inviteId Int? @map("invite_id")
  invite Invite? @relation(fields: [inviteId], references: [id], onDelete: SetNull)
  lastEmailedAt DateTime? @map("last_emailed_at")
  lastSignInAt DateTime? @map("last_sign_in_at")
  locale String?
  otpBackupCodes String[]? @map("otp_backup_codes")
  otpRequiredForLogin Boolean @map("otp_required_for_login") @default(false)
  otpSecret String? @map("otp_secret")
  requireTosInterstitial Boolean @map("require_tos_interstitial") @default(false)
  resetPasswordSentAt DateTime? @map("reset_password_sent_at")
  resetPasswordToken String? @map("reset_password_token")
  roleId Int? @map("role_id")
  role UserRole? @relation(fields: [roleId], references: [id], onDelete: SetNull)
  settings String?
  signInCount Int @map("sign_in_count") @default(0)
  signInToken String? @map("sign_in_token")
  signInTokenSentAt DateTime? @map("sign_in_token_sent_at")
  signUpIp String? @map("sign_up_ip")
  skipSignInToken Boolean? @map("skip_sign_in_token")
  timeZone String? @map("time_zone")
  unconfirmedEmail String? @map("unconfirmed_email")
  updatedAt DateTime @map("updated_at")
  webauthnId String? @map("webauthn_id")
  @@index([accountId])
  @@unique([confirmationToken])
  @@index([createdByApplicationId])
  @@unique([email])
  @@index([roleId])
  @@index([unconfirmedEmail])
}

model WebPushSubscription {
  id Int @id @default(autoincrement())
  accessTokenId Int @map("access_token_id")
