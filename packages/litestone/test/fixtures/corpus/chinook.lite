model Album {
  Artist  Artist  @relation(fields: [ArtistId], references: [ArtistId])
  AlbumId  Int  @id
  Title  String
  ArtistId  Int
  @@map("Album")
  @@noStrict
}

model Artist {
  ArtistId  Int  @id
  Name  String?
  @@map("Artist")
  @@noStrict
}

