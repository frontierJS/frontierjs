  Quantity  Int
  @@map("InvoiceLine")
  @@noStrict
}

model MediaType {
  MediaTypeId  Int  @id
  Name  String?
  @@map("MediaType")
  @@noStrict
}

model Playlist {
  PlaylistId  Int  @id
