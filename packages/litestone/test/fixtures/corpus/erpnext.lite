  uom String?
  uomRef UOM? @relation(fields: [uom], references: [id])
  stockCapacity Float? @map("stock_capacity")
  conversionFactor Float? @map("conversion_factor") @default(1)
  owner String?
  creation DateTime?
  modified DateTime?
  modifiedBy String? @map("modified_by")
  docstatus Int?
  idx Int?
}

