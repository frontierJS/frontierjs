model SupplierScorecardScoringCriteria {
  id String @id @map("name")
  criteriaName String @map("criteria_name")
  criteriaNameRef SupplierScorecardCriteria @relation(fields: [criteriaName], references: [id])
  score Float?
  weight Float
  maxScore Float? @map("max_score") @default(100)
  formula String?
  owner String?
  creation DateTime?
  modified DateTime?
  modifiedBy String? @map("modified_by")
  docstatus Int?
  idx Int?
  parent String?
  parenttype String?
  parentfield String?
}

model RequestForQuotation {
  id String @id @map("name")
  namingSeries String @map("naming_series")
  company String
  companyRef Company @relation(fields: [company], references: [id])
  vendor String?
  vendorRef Supplier? @relation(fields: [vendor], references: [id])
  transactionDate DateTime @map("transaction_date") @default(now())
  emailTemplate String? @map("email_template")
  messageForSupplier String? @map("message_for_supplier") @default("Please supply the specified items at the best possible rates")
  tcName String? @map("tc_name")
  tcNameRef TermsAndConditions? @relation(fields: [tcName], references: [id])
  terms String?
  selectPrintHeading String? @map("select_print_heading")
  letterHead String? @map("letter_head")
  opportunity String?
  opportunityRef Opportunity? @relation(fields: [opportunity], references: [id])
  status RequestForQuotationStatus
  amendedFrom String? @map("amended_from")
  amendedFromRef RequestForQuotation? @relation(fields: [amendedFrom], references: [id])
  scheduleDate DateTime? @map("schedule_date")
  incoterm String?
  incotermRef Incoterm? @relation(fields: [incoterm], references: [id])
  namedPlace String? @map("named_place")
  sendAttachedFiles Boolean? @map("send_attached_files") @default(true)
  sendDocumentPrint Boolean? @map("send_document_print") @default(false)
  billingAddress String? @map("billing_address")
  billingAddressDisplay String? @map("billing_address_display")
  hasUnitPriceItems Boolean? @map("has_unit_price_items") @default(false)
  subject String @default("Request for Quotation")
  mfsHtml String? @map("mfs_html")
  useHtml Boolean? @map("use_html") @default(false)
  shippingAddress String? @map("shipping_address")
  shippingAddressDisplay String? @map("shipping_address_display")
  title String?
  owner String?
  creation DateTime?
  modified DateTime?
  modifiedBy String? @map("modified_by")
  docstatus Int?
  idx Int?
}

model PurchaseOrder {
  id String @id @map("name")
  title String?
  namingSeries String @map("naming_series")
  supplier String
  supplierRef Supplier @relation(fields: [supplier], references: [id])
  supplierName String? @map("supplier_name")
  company String
  companyRef Company @relation(fields: [company], references: [id])
  transactionDate DateTime @map("transaction_date") @default(now())
  scheduleDate DateTime? @map("schedule_date")
  orderConfirmationNo String? @map("order_confirmation_no")
  orderConfirmationDate DateTime? @map("order_confirmation_date")
  amendedFrom String? @map("amended_from")
  amendedFromRef PurchaseOrder? @relation(fields: [amendedFrom], references: [id])
  customer String?
  customerRef Customer? @relation(fields: [customer], references: [id])
  customerName String? @map("customer_name")
  customerContactPerson String? @map("customer_contact_person")
  customerContactDisplay String? @map("customer_contact_display")
  customerContactMobile String? @map("customer_contact_mobile")
  customerContactEmail String? @map("customer_contact_email")
  supplierAddress String? @map("supplier_address")
  contactPerson String? @map("contact_person")
  addressDisplay String? @map("address_display")
  contactDisplay String? @map("contact_display")
  contactMobile String? @map("contact_mobile")
  contactEmail String? @map("contact_email")
  shippingAddress String? @map("shipping_address")
  shippingAddressDisplay String? @map("shipping_address_display")
  currency String
  conversionRate Float @map("conversion_rate")
  buyingPriceList String? @map("buying_price_list")
  buyingPriceListRef PriceList? @relation(fields: [buyingPriceList], references: [id])
  priceListCurrency String? @map("price_list_currency")
  plcConversionRate Float? @map("plc_conversion_rate")
  ignorePricingRule Boolean? @map("ignore_pricing_rule") @default(false)
  setWarehouse String? @map("set_warehouse")
  setWarehouseRef Warehouse? @relation(fields: [setWarehouse], references: [id])
  isSubcontracted Boolean? @map("is_subcontracted") @default(false)
  supplierWarehouse String? @map("supplier_warehouse")
  supplierWarehouseRef Warehouse? @relation(fields: [supplierWarehouse], references: [id])
  scanBarcode String? @map("scan_barcode")
  totalQty Float? @map("total_qty")
  baseTotal Float? @map("base_total")
  baseNetTotal Float? @map("base_net_total")
  total Float?
  netTotal Float? @map("net_total")
  totalNetWeight Float? @map("total_net_weight")
  taxesAndCharges String? @map("taxes_and_charges")
  taxesAndChargesRef PurchaseTaxesAndChargesTemplate? @relation(fields: [taxesAndCharges], references: [id])
  shippingRule String? @map("shipping_rule")
  shippingRuleRef ShippingRule? @relation(fields: [shippingRule], references: [id])
  otherChargesCalculation String? @map("other_charges_calculation")
  baseTaxesAndChargesAdded Float? @map("base_taxes_and_charges_added")
  baseTaxesAndChargesDeducted Float? @map("base_taxes_and_charges_deducted")
  baseTotalTaxesAndCharges Float? @map("base_total_taxes_and_charges")
  taxesAndChargesAdded Float? @map("taxes_and_charges_added")
  taxesAndChargesDeducted Float? @map("taxes_and_charges_deducted")
  totalTaxesAndCharges Float? @map("total_taxes_and_charges")
  applyDiscountOn String? @map("apply_discount_on")
  baseDiscountAmount Float? @map("base_discount_amount")
  additionalDiscountPercentage Float? @map("additional_discount_percentage")
  discountAmount Float? @map("discount_amount")
  baseGrandTotal Float? @map("base_grand_total")
  baseRoundingAdjustment Float? @map("base_rounding_adjustment")
  baseInWords String? @map("base_in_words")
  baseRoundedTotal Float? @map("base_rounded_total")
  grandTotal Float? @map("grand_total")
  roundingAdjustment Float? @map("rounding_adjustment")
  roundedTotal Float? @map("rounded_total")
  disableRoundedTotal Boolean? @map("disable_rounded_total") @default(false)
  inWords String? @map("in_words")
  advancePaid Float? @map("advance_paid")
  paymentTermsTemplate String? @map("payment_terms_template")
  paymentTermsTemplateRef PaymentTermsTemplate? @relation(fields: [paymentTermsTemplate], references: [id])
  tcName String? @map("tc_name")
  tcNameRef TermsAndConditions? @relation(fields: [tcName], references: [id])
  terms String?
  status String
  refSq String? @map("ref_sq")
  refSqRef SupplierQuotation? @relation(fields: [refSq], references: [id])
  partyAccountCurrency String? @map("party_account_currency")
  interCompanyOrderReference String? @map("inter_company_order_reference")
  interCompanyOrderReferenceRef SalesOrder? @relation(fields: [interCompanyOrderReference], references: [id])
  perReceived Float? @map("per_received")
  perBilled Float? @map("per_billed")
  letterHead String? @map("letter_head")
  selectPrintHeading String? @map("select_print_heading")
  groupSameItems Boolean? @map("group_same_items") @default(false)
  language String?
  fromDate DateTime? @map("from_date")
  toDate DateTime? @map("to_date")
  autoRepeat String? @map("auto_repeat")
  taxCategory String? @map("tax_category")
  taxCategoryRef TaxCategory? @relation(fields: [taxCategory], references: [id])
  setReserveWarehouse String? @map("set_reserve_warehouse")
  setReserveWarehouseRef Warehouse? @relation(fields: [setReserveWarehouse], references: [id])
  billingAddress String? @map("billing_address")
  billingAddressDisplay String? @map("billing_address_display")
  isInternalSupplier Boolean? @map("is_internal_supplier") @default(false)
  representsCompany String? @map("represents_company")
  representsCompanyRef Company? @relation(fields: [representsCompany], references: [id])
  costCenter String? @map("cost_center")
  costCenterRef CostCenter? @relation(fields: [costCenter], references: [id])
  project String?
  projectRef Project? @relation(fields: [project], references: [id])
  setFromWarehouse String? @map("set_from_warehouse")
  setFromWarehouseRef Warehouse? @relation(fields: [setFromWarehouse], references: [id])
  incoterm String?
  incotermRef Incoterm? @relation(fields: [incoterm], references: [id])
  namedPlace String? @map("named_place")
  advancePaymentStatus String? @map("advance_payment_status")
  hasUnitPriceItems Boolean? @map("has_unit_price_items") @default(false)
  dispatchAddress String? @map("dispatch_address")
  dispatchAddressDisplay String? @map("dispatch_address_display")
  supplierGroup String? @map("supplier_group")
  supplierGroupRef SupplierGroup? @relation(fields: [supplierGroup], references: [id])
  lastScannedWarehouse String? @map("last_scanned_warehouse")
  mps String?
  mpsRef MasterProductionSchedule? @relation(fields: [mps], references: [id])
  transactionTime DateTime? @map("transaction_time") @default(now())
  owner String?
  creation DateTime?
  modified DateTime?
  modifiedBy String? @map("modified_by")
  docstatus Int?
  idx Int?
}

model SupplierQuotation {
  id String @id @map("name")
  title String?
  namingSeries String @map("naming_series")
  supplier String
  supplierRef Supplier @relation(fields: [supplier], references: [id])
  supplierName String? @map("supplier_name")
  transactionDate DateTime @map("transaction_date") @default(now())
  amendedFrom String? @map("amended_from")
  amendedFromRef SupplierQuotation? @relation(fields: [amendedFrom], references: [id])
  company String
  companyRef Company @relation(fields: [company], references: [id])
  supplierAddress String? @map("supplier_address")
  contactPerson String? @map("contact_person")
  addressDisplay String? @map("address_display")
  contactDisplay String? @map("contact_display")
  contactMobile String? @map("contact_mobile")
  contactEmail String? @map("contact_email")
  currency String
  conversionRate Float @map("conversion_rate")
  buyingPriceList String? @map("buying_price_list")
  buyingPriceListRef PriceList? @relation(fields: [buyingPriceList], references: [id])
  priceListCurrency String? @map("price_list_currency")
  plcConversionRate Float? @map("plc_conversion_rate")
  ignorePricingRule Boolean? @map("ignore_pricing_rule") @default(false)
  totalQty Float? @map("total_qty")
  baseTotal Float? @map("base_total")
  baseNetTotal Float? @map("base_net_total")
