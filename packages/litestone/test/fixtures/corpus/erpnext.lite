  itemCode String @map("item_code")
  itemCodeRef Item @relation(fields: [itemCode], references: [id])
  itemName String? @map("item_name")
  warehouse String
  warehouseRef Warehouse @relation(fields: [warehouse], references: [id])
  capacity Float @default(0)
  stockUom String? @map("stock_uom")
  stockUomRef UOM? @relation(fields: [stockUom], references: [id])
  priority Int? @default(1)
  company String
  companyRef Company @relation(fields: [company], references: [id])
