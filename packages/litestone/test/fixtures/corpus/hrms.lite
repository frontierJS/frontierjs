model SalarySlip {
  id String @id @map("name")
  postingDate DateTime @map("posting_date") @default(now())
  employee String
  employeeName String @map("employee_name")
  department String?
  designation String?
  branch String?
  status SalarySlipStatus?
  journalEntry String? @map("journal_entry")
  payrollEntry String? @map("payroll_entry")
  payrollEntryRef PayrollEntry? @relation(fields: [payrollEntry], references: [id])
  company String
  letterHead String? @map("letter_head")
  salarySlipBasedOnTimesheet Boolean? @map("salary_slip_based_on_timesheet") @default(false)
  startDate DateTime? @map("start_date")
  endDate DateTime? @map("end_date")
  salaryStructure String @map("salary_structure")
  salaryStructureRef SalaryStructure @relation(fields: [salaryStructure], references: [id])
  payrollFrequency SalarySlipPayrollFrequency? @map("payroll_frequency")
  totalWorkingDays Float @map("total_working_days")
  leaveWithoutPay Float? @map("leave_without_pay")
  paymentDays Float @map("payment_days")
  totalWorkingHours Float? @map("total_working_hours")
  hourRate Float? @map("hour_rate")
  bankName String? @map("bank_name")
  bankAccountNo String? @map("bank_account_no")
  deductTaxForUnsubmittedTaxExemptionProof Boolean? @map("deduct_tax_for_unsubmitted_tax_exemption_proof") @default(false)
  grossPay Float? @map("gross_pay")
  netPay Float? @map("net_pay")
  roundedTotal Float? @map("rounded_total")
  amendedFrom String? @map("amended_from")
  amendedFromRef SalarySlip? @relation(fields: [amendedFrom], references: [id])
  modeOfPayment String? @map("mode_of_payment")
  absentDays Float? @map("absent_days")
  unmarkedDays Float? @map("unmarked_days")
  currency String
  totalDeduction Float? @map("total_deduction")
  totalInWords String? @map("total_in_words")
  baseHourRate Float? @map("base_hour_rate")
  baseGrossPay Float? @map("base_gross_pay")
  exchangeRate Float @map("exchange_rate") @default(1.0)
  baseTotalDeduction Float? @map("base_total_deduction")
  baseNetPay Float? @map("base_net_pay")
  baseRoundedTotal Float? @map("base_rounded_total")
  baseTotalInWords String? @map("base_total_in_words")
  yearToDate Float? @map("year_to_date")
  monthToDate Float? @map("month_to_date")
  baseYearToDate Float? @map("base_year_to_date")
  baseMonthToDate Float? @map("base_month_to_date")
  grossYearToDate Float? @map("gross_year_to_date")
  baseGrossYearToDate Float? @map("base_gross_year_to_date")
  ctc Float?
  incomeFromOtherSources Float? @map("income_from_other_sources")
  totalEarnings Float? @map("total_earnings")
  nonTaxableEarnings Float? @map("non_taxable_earnings")
  deductionsBeforeTaxCalculation Float? @map("deductions_before_tax_calculation")
  taxExemptionDeclaration Float? @map("tax_exemption_declaration")
  standardTaxExemptionAmount Float? @map("standard_tax_exemption_amount")
  annualTaxableAmount Float? @map("annual_taxable_amount")
  incomeTaxDeductedTillDate Float? @map("income_tax_deducted_till_date")
  futureIncomeTaxDeductions Float? @map("future_income_tax_deductions")
  currentMonthIncomeTax Float? @map("current_month_income_tax")
  totalIncomeTax Float? @map("total_income_tax")
  salaryWithholding String? @map("salary_withholding")
  salaryWithholdingRef SalaryWithholding? @relation(fields: [salaryWithholding], references: [id])
  salaryWithholdingCycle String? @map("salary_withholding_cycle")
  currentPayrollPeriod String? @map("current_payroll_period")
  currentPayrollPeriodRef PayrollPeriod? @relation(fields: [currentPayrollPeriod], references: [id])
  owner String?
  creation DateTime?
  modified DateTime?
  modifiedBy String? @map("modified_by")
  docstatus Int?
  idx Int?
}

