model LeaveEncashment {
  id String @id @map("name")
  leavePeriod String @map("leave_period")
  leavePeriodRef LeavePeriod @relation(fields: [leavePeriod], references: [id])
  employee String
  employeeName String? @map("employee_name")
  department String?
  leaveType String @map("leave_type")
  leaveTypeRef LeaveType @relation(fields: [leaveType], references: [id])
  leaveAllocation String? @map("leave_allocation")
  leaveAllocationRef LeaveAllocation? @relation(fields: [leaveAllocation], references: [id])
  leaveBalance Float? @map("leave_balance")
  amendedFrom String? @map("amended_from")
  amendedFromRef LeaveEncashment? @relation(fields: [amendedFrom], references: [id])
  encashmentAmount Float? @map("encashment_amount")
  encashmentDate DateTime? @map("encashment_date") @default(now())
  additionalSalary String? @map("additional_salary")
  additionalSalaryRef AdditionalSalary? @relation(fields: [additionalSalary], references: [id])
  currency String
  company String
  encashmentDays Float? @map("encashment_days")
  actualEncashableDays Float? @map("actual_encashable_days")
  payableAccount String? @map("payable_account")
  payViaPaymentEntry Boolean? @map("pay_via_payment_entry") @default(false)
  paidAmount Float? @map("paid_amount") @default(0.0)
  status LeaveEncashmentStatus?
  postingDate DateTime? @map("posting_date") @default(now())
  expenseAccount String? @map("expense_account")
  costCenter String? @map("cost_center")
  owner String?
  creation DateTime?
  modified DateTime?
  modifiedBy String? @map("modified_by")
  docstatus Int?
  idx Int?
}

