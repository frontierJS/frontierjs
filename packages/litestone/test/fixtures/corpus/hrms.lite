  salaryPer JobOpeningSalaryPer? @map("salary_per")
  publishApplicationsReceived Boolean? @map("publish_applications_received") @default(true)
  preventDuplicateApplicant Boolean? @map("prevent_duplicate_applicant") @default(false)
