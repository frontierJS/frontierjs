model Goal {
  id String @id @map("name")
  employee String
  startDate DateTime @map("start_date")
  progress Float?
  status GoalStatus?
  description String?
  lft Int?
  rgt Int?
  isGroup Boolean? @map("is_group") @default(false)
  oldParent String? @map("old_parent")
  oldParentRef Goal? @relation(fields: [oldParent], references: [id])
  parentGoal String? @map("parent_goal")
  parentGoalRef Goal? @relation(fields: [parentGoal], references: [id])
  kra String?
  kraRef KRA? @relation(fields: [kra], references: [id])
  appraisalCycle String? @map("appraisal_cycle")
  appraisalCycleRef AppraisalCycle? @relation(fields: [appraisalCycle], references: [id])
  employeeName String? @map("employee_name")
  user String?
  endDate DateTime? @map("end_date")
  goalName String @map("goal_name")
  company String?
  owner String?
  creation DateTime?
  modified DateTime?
  modifiedBy String? @map("modified_by")
  docstatus Int?
  idx Int?
}

model HRTelemetryMilestone {
  id String @id @map("name")
  event String @unique
  owner String?
  creation DateTime?
  modified DateTime?
  modifiedBy String? @map("modified_by")
  docstatus Int?
  idx Int?
}

model ShiftAssignmentTool {
  id String @id @map("name")
  action ShiftAssignmentToolAction
  company String
  shiftType String? @map("shift_type")
  shiftTypeRef ShiftType? @relation(fields: [shiftType], references: [id])
  status ShiftAssignmentToolStatus?
  startDate DateTime? @map("start_date")
  endDate DateTime? @map("end_date")
  branch String?
  department String?
  designation String?
  employmentType String? @map("employment_type")
  employmentTypeRef EmploymentType? @relation(fields: [employmentType], references: [id])
  shiftTypeFilter String? @map("shift_type_filter")
  shiftTypeFilterRef ShiftType? @relation(fields: [shiftTypeFilter], references: [id])
  approver String?
  fromDate DateTime? @map("from_date")
  toDate DateTime? @map("to_date")
  grade String?
  gradeRef EmployeeGrade? @relation(fields: [grade], references: [id])
  shiftLocation String? @map("shift_location")
  shiftLocationRef ShiftLocation? @relation(fields: [shiftLocation], references: [id])
  shiftSchedule String? @map("shift_schedule")
  shiftScheduleRef ShiftSchedule? @relation(fields: [shiftSchedule], references: [id])
  owner String?
  creation DateTime?
  modified DateTime?
  modifiedBy String? @map("modified_by")
  docstatus Int?
  idx Int?
}

model ExpenseTaxesAndCharges {
  id String @id @map("name")
  accountHead String @map("account_head")
  costCenter String? @map("cost_center")
  description String
  rate Float?
  taxAmount Float? @map("tax_amount")
  total Float?
  project String?
  baseTotal Float? @map("base_total")
  baseTaxAmount Float? @map("base_tax_amount")
  owner String?
  creation DateTime?
  modified DateTime?
  modifiedBy String? @map("modified_by")
  docstatus Int?
  idx Int?
  parent String?
  parenttype String?
  parentfield String?
}

model HolidayListAssignment {
  id String @id @map("name")
  amendedFrom String? @map("amended_from")
  amendedFromRef HolidayListAssignment? @relation(fields: [amendedFrom], references: [id])
  holidayList String @map("holiday_list")
  namingSeries String @map("naming_series")
  employeeName String? @map("employee_name")
  assignedTo String @map("assigned_to")
  employeeCompany String? @map("employee_company")
  applicableFor HolidayListAssignmentApplicableFor @map("applicable_for")
  holidayListStart DateTime? @map("holiday_list_start")
  holidayListEnd DateTime? @map("holiday_list_end")
  fromDate DateTime @map("from_date")
  owner String?
  creation DateTime?
  modified DateTime?
  modifiedBy String? @map("modified_by")
  docstatus Int?
  idx Int?
}

model Attendance {
  id String @id @map("name")
  namingSeries String @map("naming_series")
  employee String
  employeeName String? @map("employee_name")
  workingHours Float? @map("working_hours")
  status AttendanceStatus
  leaveType String? @map("leave_type")
  leaveTypeRef LeaveType? @relation(fields: [leaveType], references: [id])
  leaveApplication String? @map("leave_application")
  leaveApplicationRef LeaveApplication? @relation(fields: [leaveApplication], references: [id])
  attendanceDate DateTime @map("attendance_date")
  company String
  department String?
  shift String?
  shiftRef ShiftType? @relation(fields: [shift], references: [id])
  attendanceRequest String? @map("attendance_request")
  attendanceRequestRef AttendanceRequest? @relation(fields: [attendanceRequest], references: [id])
  amendedFrom String? @map("amended_from")
  amendedFromRef Attendance? @relation(fields: [amendedFrom], references: [id])
  lateEntry Boolean? @map("late_entry") @default(false)
  earlyExit Boolean? @map("early_exit") @default(false)
  inTime DateTime? @map("in_time")
  outTime DateTime? @map("out_time")
  halfDayStatus AttendanceHalfDayStatus? @map("half_day_status")
  modifyHalfDayStatus Boolean? @map("modify_half_day_status") @default(false)
  overtimeType String? @map("overtime_type")
  overtimeTypeRef OvertimeType? @relation(fields: [overtimeType], references: [id])
  standardWorkingHours Float? @map("standard_working_hours")
  actualOvertimeDuration Float? @map("actual_overtime_duration")
  owner String?
  creation DateTime?
  modified DateTime?
  modifiedBy String? @map("modified_by")
  docstatus Int?
  idx Int?
}

