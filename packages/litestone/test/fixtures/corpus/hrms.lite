  effectiveFrom DateTime @map("effective_from")
  allowTaxExemption Boolean? @map("allow_tax_exemption") @default(false)
  amendedFrom String? @map("amended_from")
  amendedFromRef IncomeTaxSlab? @relation(fields: [amendedFrom], references: [id])
  disabled Boolean? @default(false)
  standardTaxExemptionAmount Float? @map("standard_tax_exemption_amount")
  company String?
  currency String
  taxReliefLimit Float? @map("tax_relief_limit")
  owner String?
  creation DateTime?
  modified DateTime?
  modifiedBy String? @map("modified_by")
  docstatus Int?
  idx Int?
}

