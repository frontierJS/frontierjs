  payrollFrequency SalaryWithholdingPayrollFrequency? @map("payroll_frequency")
  numberOfWithholdingCycles Int @map("number_of_withholding_cycles")
  postingDate DateTime @map("posting_date") @default(now())
  fromDate DateTime @map("from_date")
  toDate DateTime @map("to_date")
  dateOfJoining DateTime? @map("date_of_joining")
  relievingDate DateTime? @map("relieving_date")
  reasonForWithholdingSalary String? @map("reason_for_withholding_salary")
  amendedFrom String? @map("amended_from")
  amendedFromRef SalaryWithholding? @relation(fields: [amendedFrom], references: [id])
  status SalaryWithholdingStatus?
  owner String?
  creation DateTime?
  modified DateTime?
  modifiedBy String? @map("modified_by")
  docstatus Int?
  idx Int?
}

model EmployeeTaxExemptionDeclarationCategory {
  id String @id @map("name")
  exemptionSubCategory String @map("exemption_sub_category")
  exemptionSubCategoryRef EmployeeTaxExemptionSubCategory @relation(fields: [exemptionSubCategory], references: [id])
  exemptionCategory String @map("exemption_category")
  exemptionCategoryRef EmployeeTaxExemptionCategory @relation(fields: [exemptionCategory], references: [id])
  maxAmount Float @map("max_amount")
  amount Float
  owner String?
  creation DateTime?
  modified DateTime?
  modifiedBy String? @map("modified_by")
  docstatus Int?
  idx Int?
  parent String?
  parenttype String?
  parentfield String?
}

model EmployeeTaxExemptionProofSubmission {
  id String @id @map("name")
  employee String
  employeeName String? @map("employee_name")
  department String?
  submissionDate DateTime @map("submission_date") @default(now())
  payrollPeriod String @map("payroll_period")
  payrollPeriodRef PayrollPeriod @relation(fields: [payrollPeriod], references: [id])
  company String
  totalActualAmount Float? @map("total_actual_amount")
  exemptionAmount Float? @map("exemption_amount")
  attachments String?
  amendedFrom String? @map("amended_from")
  amendedFromRef EmployeeTaxExemptionProofSubmission? @relation(fields: [amendedFrom], references: [id])
  currency String
  owner String?
  creation DateTime?
  modified DateTime?
  modifiedBy String? @map("modified_by")
  docstatus Int?
  idx Int?
}
