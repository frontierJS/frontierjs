  allowMessagesAfterResolved Boolean? @map("allow_messages_after_resolved") @default(true)
  autoAssignmentConfig Json? @map("auto_assignment_config")
  lockToSingleConversation Boolean @map("lock_to_single_conversation") @default(false)
  portalId Int? @map("portal_id")
  portal Portal? @relation(fields: [portalId], references: [id])
  senderNameType Int @map("sender_name_type") @default(0)
  businessName String? @map("business_name")
  csatConfig Json @map("csat_config")
  @@index([accountId])
  @@index([channelId, channelType])
  @@index([portalId])
}

