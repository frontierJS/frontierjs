model Message {
  id Int @id @default(autoincrement())
  content String?
  accountId Int @map("account_id")
  inboxId Int @map("inbox_id")
  conversationId Int @map("conversation_id")
  messageType Int @map("message_type")
  createdAt DateTime @map("created_at")
  updatedAt DateTime @map("updated_at")
  private Boolean @default(false)
  status Int? @default(0)
  sourceId String? @map("source_id")
  contentType Int @map("content_type") @default(0)
  contentAttributes Json? @map("content_attributes")
  senderType String? @map("sender_type")
  senderId Int? @map("sender_id") @big
  externalSourceIds Json? @map("external_source_ids")
  additionalAttributes Json? @map("additional_attributes")
  processedMessageContent String? @map("processed_message_content")
  sentiment Json?
  @@index([accountId, contentType, createdAt])
  @@index([accountId, createdAt, messageType])
  @@index([accountId, inboxId])
  @@index([accountId])
  @@index([content])
  @@index([conversationId, accountId, createdAt])
  @@index([conversationId, accountId, messageType, createdAt])
  @@index([conversationId])
  @@index([createdAt])
  @@index([inboxId])
  @@index([senderType, senderId, createdAt])
  @@index([senderType, senderId])
  @@index([sourceId])
}

