model User {
  id Int @id @default(autoincrement())
  provider String @default("email")
  uid String @default("")
  encryptedPassword String @map("encrypted_password") @default("")
  resetPasswordToken String? @map("reset_password_token")
  resetPasswordSentAt DateTime? @map("reset_password_sent_at")
  rememberCreatedAt DateTime? @map("remember_created_at")
  signInCount Int @map("sign_in_count") @default(0)
  currentSignInAt DateTime? @map("current_sign_in_at")
  lastSignInAt DateTime? @map("last_sign_in_at")
  currentSignInIp String? @map("current_sign_in_ip")
  lastSignInIp String? @map("last_sign_in_ip")
  confirmationToken String? @map("confirmation_token")
  confirmedAt DateTime? @map("confirmed_at")
  confirmationSentAt DateTime? @map("confirmation_sent_at")
  unconfirmedEmail String? @map("unconfirmed_email")
  name String
  displayName String? @map("display_name")
  email String?
  tokens Json?
  createdAt DateTime @map("created_at")
  updatedAt DateTime @map("updated_at")
  pubsubToken String? @map("pubsub_token")
  availability Int? @default(0)
  uiSettings Json? @map("ui_settings")
  customAttributes Json? @map("custom_attributes")
  type String?
  messageSignature String? @map("message_signature")
  otpSecret String? @map("otp_secret")
  consumedTimestep Int? @map("consumed_timestep")
  otpRequiredForLogin Boolean? @map("otp_required_for_login") @default(false)
  otpBackupCodes String? @map("otp_backup_codes")
  deviceTrustVersion Int @map("device_trust_version") @default(0)
  @@index([email])
  @@index([otpRequiredForLogin])
  @@unique([otpSecret])
  @@unique([pubsubToken])
  @@unique([resetPasswordToken])
  @@unique([uid, provider])
}

