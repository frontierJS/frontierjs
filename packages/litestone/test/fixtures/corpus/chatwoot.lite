// chatwoot — the data model of chatwoot/chatwoot, expressed in .lite.
//
// Derived mechanically from db/schema.rb (MIT (outside enterprise/)) at
// acaca48fad85 (2026-11-26) by
// `litestone import --from rails`. A CORPUS FIXTURE, not a design:
// nothing here is a claim about how any of it should be modelled, and every
// place the conversion made a choice the source did not is recorded in
// gaps.json. 112 models. Regenerate with fetch.mjs.

model AccessToken {
  id Int @id @default(autoincrement())
  ownerType String? @map("owner_type")
  ownerId Int? @map("owner_id") @big
  token String?
  createdAt DateTime @map("created_at")
  updatedAt DateTime @map("updated_at")
  @@index([ownerType, ownerId])
  @@unique([token])
}

model AccountSamlSetting {
  id Int @id @default(autoincrement())
  accountId Int @map("account_id")
  ssoUrl String? @map("sso_url")
  certificate String?
  spEntityId String? @map("sp_entity_id")
  idpEntityId String? @map("idp_entity_id")
  roleMappings Json? @map("role_mappings")
  createdAt DateTime @map("created_at")
  updatedAt DateTime @map("updated_at")
  metadataUrl String? @map("metadata_url")
  metadataRefreshedAt DateTime? @map("metadata_refreshed_at")
  @@index([accountId])
}

model AccountUser {
  id Int @id @default(autoincrement())
  accountId Int? @map("account_id")
  userId Int? @map("user_id")
  role Int? @default(0)
  inviterId Int? @map("inviter_id") @big
  createdAt DateTime @map("created_at")
  updatedAt DateTime @map("updated_at")
  activeAt DateTime? @map("active_at")
  availability Int @default(0)
  autoOffline Boolean @map("auto_offline") @default(true)
  customRoleId Int? @map("custom_role_id")
  agentCapacityPolicyId Int? @map("agent_capacity_policy_id") @big
  acceptsConversations Boolean @map("accepts_conversations") @default(true)
  acceptsCalls Boolean @map("accepts_calls") @default(true)
  @@unique([accountId, userId], nullsDistinct: true)
  @@index([accountId])
  @@index([agentCapacityPolicyId])
  @@index([customRoleId])
  @@index([userId])
}

model Account {
  id Int @id @default(autoincrement())
  name String
  createdAt DateTime @map("created_at")
  updatedAt DateTime @map("updated_at")
  locale Int? @default(0)
  domain String?
  supportEmail String? @map("support_email")
  featureFlags Int @map("feature_flags") @default(0) @big
  autoResolveDuration Int? @map("auto_resolve_duration")
  limits Json?
  customAttributes Json? @map("custom_attributes")
  status Int? @default(0)
  internalAttributes Json @map("internal_attributes")
  settings Json?
  featureFlagsExt1 Int @map("feature_flags_ext_1") @default(0) @big
  @@index([status])
}

model ActionMailboxInboundEmail {
  id Int @id @default(autoincrement())
  status Int @default(0)
  messageId String @map("message_id")
  messageChecksum String @map("message_checksum")
  createdAt DateTime @map("created_at")
  updatedAt DateTime @map("updated_at")
  @@unique([messageId, messageChecksum])
}

model ActiveStorageAttachment {
  id Int @id @default(autoincrement())
  name String
  recordType String @map("record_type")
  recordId Int @map("record_id") @big
  blobId Int @map("blob_id")
  blob ActiveStorageBlob @relation(fields: [blobId], references: [id])
  createdAt DateTime @map("created_at")
  @@index([blobId])
  @@unique([recordType, recordId, name, blobId])
}

model ActiveStorageBlob {
  id Int @id @default(autoincrement())
  key String
  filename String
  contentType String? @map("content_type")
  metadata String?
  byteSize Int @map("byte_size") @big
  checksum String?
  createdAt DateTime @map("created_at")
  serviceName String @map("service_name")
  @@unique([key])
}

model ActiveStorageVariantRecord {
  id Int @id @default(autoincrement())
  blobId Int @map("blob_id")
  blob ActiveStorageBlob @relation(fields: [blobId], references: [id])
  variationDigest String @map("variation_digest")
  @@unique([blobId, variationDigest])
}

model AgentBotInbox {
  id Int @id @default(autoincrement())
  inboxId Int? @map("inbox_id")
  agentBotId Int? @map("agent_bot_id")
  status Int? @default(0)
  createdAt DateTime @map("created_at")
  updatedAt DateTime @map("updated_at")
  accountId Int? @map("account_id")
}

model AgentBot {
  id Int @id @default(autoincrement())
  name String?
  description String?
  outgoingUrl String? @map("outgoing_url")
  createdAt DateTime @map("created_at")
  updatedAt DateTime @map("updated_at")
  accountId Int? @map("account_id")
  botType Int? @map("bot_type") @default(0)
  botConfig Json? @map("bot_config")
  secret String?
  @@index([accountId])
}

model AgentCapacityPolicy {
  id Int @id @default(autoincrement())
  accountId Int @map("account_id")
  name String
  description String?
  exclusionRules Json @map("exclusion_rules")
  createdAt DateTime @map("created_at")
  updatedAt DateTime @map("updated_at")
  @@index([accountId])
}

model AgentSession {
  id Int @id @default(autoincrement())
  sessionType Int @map("session_type")
  subjectType String @map("subject_type")
  subjectId Int @map("subject_id") @big
  resultType String? @map("result_type")
  resultId Int? @map("result_id") @big
  accountId Int @map("account_id")
  assistantId Int @map("assistant_id") @big
  userId Int? @map("user_id")
  llmModel String? @map("llm_model")
  creditsConsumed Float? @map("credits_consumed")
  faqIds Json? @map("faq_ids")
  documentIds Json? @map("document_ids")
  scenarioIds Json? @map("scenario_ids")
  runContext Json? @map("run_context")
  createdAt DateTime @map("created_at")
  updatedAt DateTime @map("updated_at")
  citedDocumentIds Json @map("cited_document_ids")
  usedFaqIds Json @map("used_faq_ids")
  @@index([accountId, resultType, resultId])
  @@index([accountId, sessionType, createdAt])
  @@index([accountId, subjectType, subjectId])
  @@index([accountId])
  @@index([assistantId])
  @@index([citedDocumentIds])
  @@index([documentIds])
  @@index([usedFaqIds])
  @@index([userId])
}

model AppliedSla {
  id Int @id @default(autoincrement())
  accountId Int @map("account_id")
  slaPolicyId Int @map("sla_policy_id") @big
  conversationId Int @map("conversation_id")
  createdAt DateTime @map("created_at")
  updatedAt DateTime @map("updated_at")
  slaStatus Int? @map("sla_status") @default(0)
  completedAt DateTime? @map("completed_at")
  @@unique([accountId, slaPolicyId, conversationId])
  @@index([accountId])
  @@index([conversationId])
  @@index([slaPolicyId])
}

model ArticleEmbedding {
  id Int @id @default(autoincrement())
  articleId Int @map("article_id")
  term String
  embedding String?
  createdAt DateTime @map("created_at")
  updatedAt DateTime @map("updated_at")
  @@index([embedding])
}

model Article {
  id Int @id @default(autoincrement())
  accountId Int @map("account_id")
  portalId Int @map("portal_id")
  categoryId Int? @map("category_id")
  folderId Int? @map("folder_id")
  title String?
  description String?
  content String?
  status Int?
  views Int?
  createdAt DateTime @map("created_at")
  updatedAt DateTime @map("updated_at")
  authorId Int? @map("author_id") @big
  associatedArticleId Int? @map("associated_article_id") @big
  meta Json?
  slug String
  position Int?
  locale String @default("en")
  draftTitle String? @map("draft_title")
  draftContent String? @map("draft_content")
  @@index([accountId])
  @@index([associatedArticleId])
  @@index([authorId])
  @@index([categoryId])
  @@index([portalId])
  @@unique([slug])
  @@index([status])
  @@index([views])
}

model AssignmentPolicy {
  id Int @id @default(autoincrement())
  accountId Int @map("account_id")
  name String
  description String?
  assignmentOrder Int @map("assignment_order") @default(0)
  conversationPriority Int @map("conversation_priority") @default(0)
  fairDistributionLimit Int @map("fair_distribution_limit") @default(100)
  fairDistributionWindow Int @map("fair_distribution_window") @default(3600)
  enabled Boolean @default(true)
  createdAt DateTime @map("created_at")
  updatedAt DateTime @map("updated_at")
  excludeOlderThanHours Int? @map("exclude_older_than_hours") @default(168)
  @@unique([accountId, name])
  @@index([accountId])
  @@index([enabled])
}

model Attachment {
  id Int @id @default(autoincrement())
  fileType Int? @map("file_type") @default(0)
  externalUrl String? @map("external_url")
  coordinatesLat Float? @map("coordinates_lat") @default(0.0)
  coordinatesLong Float? @map("coordinates_long") @default(0.0)
  messageId Int @map("message_id")
  accountId Int @map("account_id")
  createdAt DateTime @map("created_at")
  updatedAt DateTime @map("updated_at")
  fallbackTitle String? @map("fallback_title")
  extension String?
  meta Json?
  @@index([accountId])
  @@index([messageId])
}

model Audit {
  id Int @id @default(autoincrement())
  auditableId Int? @map("auditable_id") @big
  auditableType String? @map("auditable_type")
  associatedId Int? @map("associated_id") @big
  associatedType String? @map("associated_type")
  userId Int? @map("user_id")
  userType String? @map("user_type")
  username String?
  action String?
  auditedChanges Json? @map("audited_changes")
  version Int? @default(0)
  comment String?
  remoteAddress String? @map("remote_address")
  requestUuid String? @map("request_uuid")
  createdAt DateTime? @map("created_at")
  city String?
  country String?
  countryCode String? @map("country_code")
  @@index([associatedType, associatedId, createdAt])
  @@index([associatedType, associatedId])
  @@index([auditableType, auditableId, version])
  @@index([createdAt])
  @@index([requestUuid])
  @@index([userId, userType])
}

model AutomationRulePendingExecution {
  id Int @id @default(autoincrement())
  automationRuleId Int @map("automation_rule_id")
  conversationId Int @map("conversation_id")
  accountId Int @map("account_id")
  messageId Int? @map("message_id")
  dueAt DateTime @map("due_at")
  episodeKey String @map("episode_key")
  status Int @default(0)
  skipReason String? @map("skip_reason")
  createdAt DateTime @map("created_at")
  updatedAt DateTime @map("updated_at")
  @@index([accountId])
  @@unique([automationRuleId, conversationId, episodeKey])
  @@index([automationRuleId])
  @@index([conversationId])
  @@index([status, dueAt])
  @@index([status, updatedAt])
}

model AutomationRule {
  id Int @id @default(autoincrement())
  accountId Int @map("account_id")
  name String
  description String?
  eventName String @map("event_name")
  conditions Json @default("{}")
  actions Json @default("{}")
  createdAt DateTime @map("created_at")
  updatedAt DateTime @map("updated_at")
  active Boolean @default(true)
  executionDelay Int? @map("execution_delay")
  monitorId Int? @map("monitor_id") @big
  monitorEventActivatedAt DateTime? @map("monitor_event_activated_at")
  @@index([accountId])
  @@index([monitorId])
}

model Call {
  id Int @id @default(autoincrement())
  accountId Int @map("account_id")
  inboxId Int @map("inbox_id") @big
  conversationId Int @map("conversation_id")
  contactId Int @map("contact_id")
  messageId Int? @map("message_id")
  acceptedByAgentId Int? @map("accepted_by_agent_id") @big
  providerCallId String @map("provider_call_id")
  provider Int @default(0)
  direction Int
  status String @default("ringing")
  startedAt DateTime? @map("started_at")
  durationSeconds Int? @map("duration_seconds")
  endReason String? @map("end_reason")
  meta Json?
  transcript String?
  createdAt DateTime @map("created_at")
  updatedAt DateTime @map("updated_at")
  ringState Json @map("ring_state")
  @@index([accountId, contactId])
  @@index([accountId, conversationId])
  @@index([accountId, createdAt])
  @@index([messageId])
  @@index([provider, createdAt])
  @@unique([provider, providerCallId])
}

model CampaignRecipient {
  id Int @id @default(autoincrement())
  accountId Int @map("account_id")
  account Account @relation(fields: [accountId], references: [id], onDelete: Cascade)
  campaignId Int @map("campaign_id")
  campaign Campaign @relation(fields: [campaignId], references: [id], onDelete: Cascade)
  contactId Int @map("contact_id")
  contact Contact @relation(fields: [contactId], references: [id], onDelete: Cascade)
  inboxId Int @map("inbox_id")
  inbox Inbox @relation(fields: [inboxId], references: [id], onDelete: Cascade)
  sourceId String? @map("source_id")
  status Int @default(0)
  errorCode String? @map("error_code")
  errorTitle String? @map("error_title")
  errorMessage String? @map("error_message")
  messageContent String? @map("message_content")
  sentAt DateTime? @map("sent_at")
  deliveredAt DateTime? @map("delivered_at")
  readAt DateTime? @map("read_at")
  failedAt DateTime? @map("failed_at")
  createdAt DateTime @map("created_at")
  updatedAt DateTime @map("updated_at")
  contactInboxId Int? @map("contact_inbox_id") @big
  sendAttemptedAt DateTime? @map("send_attempted_at")
  @@index([accountId, campaignId])
  @@index([accountId])
  @@unique([campaignId, contactId])
  @@index([campaignId, status])
  @@index([campaignId])
  @@index([contactId])
  @@index([contactInboxId])
  @@index([inboxId])
  @@unique([sourceId], where: sourceId != null)
}

model Campaign {
  id Int @id @default(autoincrement())
  displayId Int @map("display_id")
  title String
  description String?
  message String
  senderId Int? @map("sender_id")
  enabled Boolean? @default(true)
  accountId Int @map("account_id")
  inboxId Int @map("inbox_id") @big
  triggerRules Json? @map("trigger_rules")
  createdAt DateTime @map("created_at")
  updatedAt DateTime @map("updated_at")
  campaignType Int @map("campaign_type") @default(0)
  campaignStatus Int @map("campaign_status") @default(0)
  audience Json?
  scheduledAt DateTime? @map("scheduled_at")
  triggerOnlyDuringBusinessHours Boolean? @map("trigger_only_during_business_hours") @default(false)
  templateParams Json? @map("template_params")
  startedAt DateTime? @map("started_at")
  completedAt DateTime? @map("completed_at")
  whatsappCursor Int? @map("whatsapp_cursor") @big
  @@index([accountId])
  @@index([campaignStatus])
  @@index([campaignType])
  @@index([inboxId])
  @@index([scheduledAt])
}

model CannedResponse {
  id Int @id @default(autoincrement())
  accountId Int @map("account_id")
  shortCode String? @map("short_code")
  content String?
  createdAt DateTime @map("created_at")
  updatedAt DateTime @map("updated_at")
}

model CaptainAssistantResponse {
  id Int @id @default(autoincrement())
  question String
  answer String
  embedding String?
  assistantId Int @map("assistant_id") @big
  documentableId Int? @map("documentable_id") @big
  accountId Int @map("account_id")
  createdAt DateTime @map("created_at")
  updatedAt DateTime @map("updated_at")
  status Int @default(1)
  documentableType String? @map("documentable_type")
  edited Boolean @default(false)
  @@index([accountId])
  @@index([assistantId])
  @@index([documentableId, documentableType])
  @@index([status])
}

model CaptainAssistant {
  id Int @id @default(autoincrement())
  name String
  accountId Int @map("account_id")
  description String?
  createdAt DateTime @map("created_at")
  updatedAt DateTime @map("updated_at")
  config Json
  responseGuidelines Json? @map("response_guidelines")
  guardrails Json?
  @@index([accountId])
}

model CaptainCustomTool {
  id Int @id @default(autoincrement())
  accountId Int @map("account_id")
  slug String
  title String
  description String?
  httpMethod String @map("http_method") @default("GET")
  endpointUrl String @map("endpoint_url")
  requestTemplate String? @map("request_template")
  responseTemplate String? @map("response_template")
  authType String? @map("auth_type") @default("none")
  authConfig Json? @map("auth_config")
  paramSchema Json? @map("param_schema")
  enabled Boolean @default(true)
  createdAt DateTime @map("created_at")
  updatedAt DateTime @map("updated_at")
  assistantId Int? @map("assistant_id") @big
  headers Json
  sourceMetadata Json? @map("source_metadata")
  settings Json
  @@index([accountId])
  @@unique([assistantId, slug], nullsDistinct: true)
}

model CaptainDocument {
  id Int @id @default(autoincrement())
  name String?
  externalLink String @map("external_link")
  content String?
  assistantId Int @map("assistant_id") @big
  accountId Int @map("account_id")
  createdAt DateTime @map("created_at")
  updatedAt DateTime @map("updated_at")
  status Int @default(0)
  metadata Json?
  syncStatus Int? @map("sync_status")
  lastSyncedAt DateTime? @map("last_synced_at")
  lastSyncAttemptedAt DateTime? @map("last_sync_attempted_at")
  @@index([accountId, assistantId, syncStatus, lastSyncedAt])
  @@index([accountId, syncStatus])
  @@index([accountId])
  @@index([assistantId])
  @@index([status])
}

model CaptainFaqObservation {
  id Int @id @default(autoincrement())
  accountId Int @map("account_id")
  conversationId Int @map("conversation_id")
  faqSuggestionId Int? @map("faq_suggestion_id") @big
  generatedQuestion String @map("generated_question")
  generatedAnswer String @map("generated_answer")
  language String @default("en")
  status Int @default(0)
  createdAt DateTime @map("created_at")
  updatedAt DateTime @map("updated_at")
  @@index([accountId])
  @@index([conversationId])
  @@index([faqSuggestionId])
}

model CaptainFaqSuggestion {
  id Int @id @default(autoincrement())
  question String
  answer String
  embedding String?
  assistantId Int @map("assistant_id") @big
  accountId Int @map("account_id")
  language String @default("en")
  sourceCount Int @map("source_count") @default(0)
  status Int @default(0)
  createdAt DateTime @map("created_at")
  updatedAt DateTime @map("updated_at")
  @@index([accountId])
  @@index([accountId, assistantId, status, language])
  @@index([assistantId])
  @@index([embedding])
}

model CaptainInbox {
  id Int @id @default(autoincrement())
  captainAssistantId Int @map("captain_assistant_id")
  inboxId Int @map("inbox_id") @big
  createdAt DateTime @map("created_at")
  updatedAt DateTime @map("updated_at")
  @@unique([captainAssistantId, inboxId])
  @@index([captainAssistantId])
  @@index([inboxId])
}

model CaptainMcpServer {
  id Int @id @default(autoincrement())
  accountId Int @map("account_id")
  assistantId Int @map("assistant_id") @big
  url String
  name String
  authType String @map("auth_type") @default("none")
  authHeader String? @map("auth_header")
  authConfig Json? @map("auth_config")
  oauthCredentials Json? @map("oauth_credentials")
  status String @default("active")
  lastError String? @map("last_error")
  enabled Boolean @default(true)
  createdAt DateTime @map("created_at")
  updatedAt DateTime @map("updated_at")
  @@index([accountId])
  @@unique([assistantId, url])
}

model CaptainMcpTool {
  id Int @id @default(autoincrement())
  accountId Int @map("account_id")
  mcpServerId Int @map("mcp_server_id") @big
  name String
  captainName String @map("captain_name")
  approvedDefinition Json @map("approved_definition")
  approvedDigest String @map("approved_digest")
  paramSources Json @map("param_sources")
  settings Json
  enabled Boolean @default(true)
  createdAt DateTime @map("created_at")
  updatedAt DateTime @map("updated_at")
  reviewState String @map("review_state") @default("current")
  @@index([accountId])
  @@unique([captainName])
  @@unique([mcpServerId, name])
}

model CaptainMessageReport {
  id Int @id @default(autoincrement())
  accountId Int @map("account_id")
  conversationId Int @map("conversation_id")
  messageId Int @map("message_id")
  userId Int @map("user_id")
  reportReason String @map("report_reason")
  description String?
  createdAt DateTime @map("created_at")
  updatedAt DateTime @map("updated_at")
  @@index([accountId])
  @@index([conversationId])
  @@index([messageId])
  @@index([userId])
}

model CaptainScenario {
  id Int @id @default(autoincrement())
  title String?
  description String?
  instruction String?
  tools Json?
  enabled Boolean @default(true)
  assistantId Int @map("assistant_id") @big
  accountId Int @map("account_id")
  createdAt DateTime @map("created_at")
  updatedAt DateTime @map("updated_at")
  @@index([accountId])
  @@index([assistantId, enabled])
  @@index([assistantId])
  @@index([enabled])
}

model Category {
  id Int @id @default(autoincrement())
  accountId Int @map("account_id")
  portalId Int @map("portal_id")
  name String?
  description String?
  position Int?
  createdAt DateTime @map("created_at")
  updatedAt DateTime @map("updated_at")
  locale String? @default("en")
  slug String
  parentCategoryId Int? @map("parent_category_id") @big
  associatedCategoryId Int? @map("associated_category_id") @big
  icon String? @default("")
  iconColor String? @map("icon_color") @default("")
  @@index([associatedCategoryId])
  @@index([locale, accountId])
  @@index([locale])
  @@index([parentCategoryId])
  @@unique([slug, locale, portalId], nullsDistinct: true)
}

model ChannelApi {
  id Int @id @default(autoincrement())
  accountId Int @map("account_id")
  webhookUrl String? @map("webhook_url")
  createdAt DateTime @map("created_at")
  updatedAt DateTime @map("updated_at")
  identifier String?
  hmacToken String? @map("hmac_token")
  hmacMandatory Boolean? @map("hmac_mandatory") @default(false)
  additionalAttributes Json? @map("additional_attributes")
  secret String?
  @@unique([hmacToken])
  @@unique([identifier])
}

model ChannelEmail {
  id Int @id @default(autoincrement())
  accountId Int @map("account_id")
  email String
  forwardToEmail String @map("forward_to_email")
  createdAt DateTime @map("created_at")
  updatedAt DateTime @map("updated_at")
  imapEnabled Boolean? @map("imap_enabled") @default(false)
  imapAddress String? @map("imap_address") @default("")
  imapPort Int? @map("imap_port") @default(0)
  imapLogin String? @map("imap_login") @default("")
  imapPassword String? @map("imap_password") @default("")
  imapEnableSsl Boolean? @map("imap_enable_ssl") @default(true)
  smtpEnabled Boolean? @map("smtp_enabled") @default(false)
  smtpAddress String? @map("smtp_address") @default("")
  smtpPort Int? @map("smtp_port") @default(0)
  smtpLogin String? @map("smtp_login") @default("")
  smtpPassword String? @map("smtp_password") @default("")
  smtpDomain String? @map("smtp_domain") @default("")
  smtpEnableStarttlsAuto Boolean? @map("smtp_enable_starttls_auto") @default(true)
  smtpAuthentication String? @map("smtp_authentication") @default("login")
  smtpOpensslVerifyMode String? @map("smtp_openssl_verify_mode") @default("none")
  smtpEnableSslTls Boolean? @map("smtp_enable_ssl_tls") @default(false)
  providerConfig Json? @map("provider_config")
  provider String?
  imapAuthentication String? @map("imap_authentication") @default("plain")
  verifiedForSending Boolean @map("verified_for_sending") @default(false)
  @@unique([email])
  @@unique([forwardToEmail])
}

model ChannelFacebookPage {
  id Int @id @default(autoincrement())
  pageId String @map("page_id")
  userAccessToken String @map("user_access_token")
  pageAccessToken String @map("page_access_token")
  accountId Int @map("account_id")
  createdAt DateTime @map("created_at")
  updatedAt DateTime @map("updated_at")
  instagramId String? @map("instagram_id")
  providerName String? @map("provider_name")
  @@unique([pageId, accountId])
  @@index([pageId])
}

model ChannelInstagram {
