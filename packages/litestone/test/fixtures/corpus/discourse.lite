  timeoutSeconds Int @map("timeout_seconds") @default(30)
  lastHealthStatus String? @map("last_health_status")
  lastHealthError String? @map("last_health_error")
  lastCheckedAt DateTime? @map("last_checked_at")
  lastToolsSyncedAt DateTime? @map("last_tools_synced_at")
