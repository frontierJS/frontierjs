  createdById Int? @map("created_by_id")
  createdAt DateTime @map("created_at")
  updatedAt DateTime @map("updated_at")
  authType String @map("auth_type") @default("header_secret")
  oauthClientRegistration String? @map("oauth_client_registration") @default("client_metadata_document")
  oauthClientId String? @map("oauth_client_id")
  oauthClientSecretAiSecretId Int? @map("oauth_client_secret_ai_secret_id")
  oauthScopes String? @map("oauth_scopes")
  oauthGrantedScopes String? @map("oauth_granted_scopes")
  oauthTokenType String? @map("oauth_token_type")
  oauthAccessTokenExpiresAt DateTime? @map("oauth_access_token_expires_at")
  oauthAuthorizationEndpoint String? @map("oauth_authorization_endpoint")
  oauthTokenEndpoint String? @map("oauth_token_endpoint")
  oauthRevocationEndpoint String? @map("oauth_revocation_endpoint")
  oauthIssuer String? @map("oauth_issuer")
  oauthResourceMetadataUrl String? @map("oauth_resource_metadata_url")
  oauthStatus String @map("oauth_status") @default("disconnected")
  oauthLastError String? @map("oauth_last_error")
  oauthLastAuthorizedAt DateTime? @map("oauth_last_authorized_at")
  oauthLastRefreshedAt DateTime? @map("oauth_last_refreshed_at")
  oauthRegistrationEndpoint String? @map("oauth_registration_endpoint")
  oauthAuthorizationParams Json @map("oauth_authorization_params")
  oauthTokenParams Json @map("oauth_token_params")
  oauthRequireRefreshToken Boolean @map("oauth_require_refresh_token") @default(false)
  oauthTokenEndpointAuthMethodsSupported Json @map("oauth_token_endpoint_auth_methods_supported") @default("[]")

  @@index([aiSecretId])
  @@unique([name])
