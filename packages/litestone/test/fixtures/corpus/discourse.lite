  textColor String @map("text_color") @default("FFFFFF")
  readRestricted Boolean @map("read_restricted") @default(false)
  autoCloseHours Float? @map("auto_close_hours")
  postCount Int @map("post_count") @default(0)
  latestPostId Int? @map("latest_post_id")
  latestTopicId Int? @map("latest_topic_id")
  position Int?
  parentCategoryId Int? @map("parent_category_id")
  postsYear Int? @map("posts_year") @default(0)
  postsMonth Int? @map("posts_month") @default(0)
  postsWeek Int? @map("posts_week") @default(0)
  emailIn String? @map("email_in")
  emailInAllowStrangers Boolean? @map("email_in_allow_strangers") @default(false)
  topicsDay Int? @map("topics_day") @default(0)
  postsDay Int? @map("posts_day") @default(0)
  allowBadges Boolean @map("allow_badges") @default(true)
  nameLower String @map("name_lower")
  autoCloseBasedOnLastPost Boolean? @map("auto_close_based_on_last_post") @default(false)
  topicTemplate String? @map("topic_template")
  containsMessages Boolean? @map("contains_messages")
  sortOrder String? @map("sort_order")
  sortAscending Boolean? @map("sort_ascending")
  uploadedLogoId Int? @map("uploaded_logo_id")
  uploadedBackgroundId Int? @map("uploaded_background_id")
  topicFeaturedLinkAllowed Boolean? @map("topic_featured_link_allowed") @default(true)
  allTopicsWiki Boolean @map("all_topics_wiki") @default(false)
  showSubcategoryList Boolean? @map("show_subcategory_list") @default(false)
  numFeaturedTopics Int? @map("num_featured_topics") @default(3)
  defaultView String? @map("default_view")
  subcategoryListStyle String? @map("subcategory_list_style") @default("rows_with_featured_topics")
  defaultTopPeriod String? @map("default_top_period") @default("all")
