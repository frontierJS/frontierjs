  uploadedLogoDarkId Int? @map("uploaded_logo_dark_id")
  uploadedBackgroundDarkId Int? @map("uploaded_background_dark_id")
  styleType Int @map("style_type") @default(0)
  emoji String?
  icon String?
  locale String?
