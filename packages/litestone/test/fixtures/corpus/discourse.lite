  updatedAt DateTime @map("updated_at")
  userId Int @map("user_id")
  topicsYear Int? @map("topics_year") @default(0)
  topicsMonth Int? @map("topics_month") @default(0)
  topicsWeek Int? @map("topics_week") @default(0)
  slug String
