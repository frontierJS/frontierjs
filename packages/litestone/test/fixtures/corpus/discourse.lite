model UserOption {
  id String @id @default(cuid())
  userId Int @map("user_id")
  mailingListMode Boolean @map("mailing_list_mode") @default(false)
  emailDigests Boolean? @map("email_digests")
  externalLinksInNewTab Boolean @map("external_links_in_new_tab") @default(false)
  enableQuoting Boolean @map("enable_quoting") @default(true)
  dynamicFavicon Boolean @map("dynamic_favicon") @default(false)
  automaticallyUnpinTopics Boolean @map("automatically_unpin_topics") @default(true)
  digestAfterMinutes Int? @map("digest_after_minutes")
  autoTrackTopicsAfterMsecs Int? @map("auto_track_topics_after_msecs")
  newTopicDurationMinutes Int? @map("new_topic_duration_minutes")
  lastRedirectedToTopAt DateTime? @map("last_redirected_to_top_at")
  emailPreviousReplies Int @map("email_previous_replies") @default(2)
  emailInReplyTo Boolean @map("email_in_reply_to") @default(true)
  likeNotificationFrequency Int @map("like_notification_frequency") @default(1)
  mailingListModeFrequency Int @map("mailing_list_mode_frequency") @default(1)
  includeTl0InDigests Boolean? @map("include_tl0_in_digests") @default(false)
  notificationLevelWhenReplying Int? @map("notification_level_when_replying")
  themeKeySeq Int @map("theme_key_seq") @default(0)
  allowPrivateMessages Boolean @map("allow_private_messages") @default(true)
  homepageId Int? @map("homepage_id")
  themeIds Int[] @map("theme_ids")
  hideProfileAndPresence Boolean @map("hide_profile_and_presence") @default(false)
  textSizeKey Int @map("text_size_key") @default(0)
  textSizeSeq Int @map("text_size_seq") @default(0)
  emailLevel Int @map("email_level") @default(1)
  emailMessagesLevel Int @map("email_messages_level") @default(0)
  titleCountModeKey Int @map("title_count_mode_key") @default(0)
  enableDefer Boolean @map("enable_defer") @default(false)
  timezone String?
  enableAllowedPmUsers Boolean @map("enable_allowed_pm_users") @default(false)
  darkSchemeId Int? @map("dark_scheme_id")
  skipNewUserTips Boolean @map("skip_new_user_tips") @default(false)
  colorSchemeId Int? @map("color_scheme_id")
  defaultCalendar Int @map("default_calendar") @default(0)
  chatEnabled Boolean @map("chat_enabled") @default(true)
  onlyChatPushNotifications Boolean? @map("only_chat_push_notifications")
  oldestSearchLogDate DateTime? @map("oldest_search_log_date")
  chatSound String? @map("chat_sound")
  dismissedChannelRetentionReminder Boolean? @map("dismissed_channel_retention_reminder")
  dismissedDmRetentionReminder Boolean? @map("dismissed_dm_retention_reminder")
  bookmarkAutoDeletePreference Int @map("bookmark_auto_delete_preference") @default(3)
  ignoreChannelWideMention Boolean? @map("ignore_channel_wide_mention")
  chatEmailFrequency Int @map("chat_email_frequency") @default(1)
  seenPopups Int[]? @map("seen_popups")
  policyEmailFrequency Int @map("policy_email_frequency") @default(0)
  chatHeaderIndicatorPreference Int @map("chat_header_indicator_preference") @default(0)
  sidebarLinkToFilteredList Boolean @map("sidebar_link_to_filtered_list") @default(false)
  sidebarShowCountOfNewItems Boolean @map("sidebar_show_count_of_new_items") @default(false)
  watchedPrecedenceOverMuted Boolean @map("watched_precedence_over_muted") @default(false)
  chatSeparateSidebarMode Int @map("chat_separate_sidebar_mode") @default(0)
  showThreadTitlePrompts Boolean @map("show_thread_title_prompts") @default(true)
  autoImageCaption Boolean @map("auto_image_caption") @default(false)
  enableSmartLists Boolean @map("enable_smart_lists") @default(true)
  hideProfile Boolean @map("hide_profile") @default(false)
  hidePresence Boolean @map("hide_presence") @default(false)
  chatSendShortcut Int @map("chat_send_shortcut") @default(0)
  notificationLevelWhenAssigned Int @map("notification_level_when_assigned") @default(3)
  chatQuickReactionType Int @map("chat_quick_reaction_type") @default(0)
  chatQuickReactionsCustom String? @map("chat_quick_reactions_custom")
  aiSearchDiscoveries Boolean @map("ai_search_discoveries") @default(true)
  compositionMode Int @map("composition_mode") @default(1)
  interfaceColorMode Int @map("interface_color_mode") @default(1)
  enableMarkdownMonospaceFont Boolean @map("enable_markdown_monospace_font") @default(true)
  notifyOnLinkedPosts Boolean @map("notify_on_linked_posts") @default(true)
  discourseRewindSharePublicly Boolean @map("discourse_rewind_share_publicly") @default(false)
  discourseRewindDismissedAt DateTime? @map("discourse_rewind_dismissed_at")
  discourseRewindEnabled Boolean @map("discourse_rewind_enabled") @default(true)
  notifyOnSolved Boolean @map("notify_on_solved") @default(true)
  showOriginalContent Boolean @map("show_original_content") @default(false)
  enableUpcomingChangeAvailableNotifications Boolean @map("enable_upcoming_change_available_notifications") @default(true)
  chatAnnounceNewMessages Boolean @map("chat_announce_new_messages") @default(true)
  chatNewMessageSound Boolean @map("chat_new_message_sound") @default(false)
  pushNotificationLevel Int @map("push_notification_level") @default(1)
  automaticallyTranslate Boolean @map("automatically_translate") @default(true)
  understoodLanguages String[] @map("understood_languages")
  sendShortcut Int @map("send_shortcut") @default(0)

  @@unique([userId])
  @@index([userId, defaultCalendar])
  @@index([watchedPrecedenceOverMuted])
}

