enum AiModerationSettingType {
  spam
  nsfw
  custom
}

enum HotlinkedMediaStatus {
  downloaded
  too_large
  download_failed
  upload_create_failed
}

model AccessControlList {
  id Int @id
  targetType String @map("target_type")
  targetId Int @map("target_id")
  owner String
  permission String
  allowedUserIds Int[] @map("allowed_user_ids")
  allowedGroupIds Int[] @map("allowed_group_ids")
  createdAt DateTime @map("created_at")
  updatedAt DateTime @map("updated_at")

  @@index([allowedGroupIds])
  @@index([allowedUserIds])
  @@unique([targetType, targetId, permission])
}

model AdPluginHouseAd {
  id Int @id
  name String
  html String
  visibleToLoggedInUsers Boolean @map("visible_to_logged_in_users") @default(true)
  visibleToAnons Boolean @map("visible_to_anons") @default(true)
  createdAt DateTime @map("created_at")
  updatedAt DateTime @map("updated_at")

  @@unique([name])
  @@index([visibleToAnons])
  @@index([visibleToLoggedInUsers])
}

model AdPluginHouseAdsCategory {
  id String @id @default(cuid())
  adPluginHouseAdId Int @map("ad_plugin_house_ad_id")
  adPluginHouseAd AdPluginHouseAd @relation(fields: [adPluginHouseAdId], references: [id], onDelete: Cascade)
  categoryId Int @map("category_id")
  category Category @relation(fields: [categoryId], references: [id], onDelete: Cascade)

  @@index([adPluginHouseAdId, categoryId])
}

model AdPluginHouseAdsGroup {
  id String @id @default(cuid())
  adPluginHouseAdId Int @map("ad_plugin_house_ad_id")
  adPluginHouseAd AdPluginHouseAd @relation(fields: [adPluginHouseAdId], references: [id], onDelete: Cascade)
  groupId Int @map("group_id")
  group Group @relation(fields: [groupId], references: [id], onDelete: Cascade)

  @@index([adPluginHouseAdId, groupId])
}

model AdPluginHouseAdsRoute {
  id String @id @default(cuid())
  adPluginHouseAdId Int @map("ad_plugin_house_ad_id")
  adPluginHouseAd AdPluginHouseAd @relation(fields: [adPluginHouseAdId], references: [id])
  routeName String @map("route_name")

  @@unique([adPluginHouseAdId, routeName])
}

model AdPluginImpression {
  id Int @id
  adType Int @map("ad_type")
  adPluginHouseAdId Int? @map("ad_plugin_house_ad_id")
  adPluginHouseAd AdPluginHouseAd? @relation(fields: [adPluginHouseAdId], references: [id], onDelete: Cascade)
  placement String
  userId Int? @map("user_id")
  user User? @relation(fields: [userId], references: [id], onDelete: SetNull)
  createdAt DateTime @map("created_at")
  updatedAt DateTime @map("updated_at")
  clickedAt DateTime? @map("clicked_at")

  @@index([adPluginHouseAdId])
  @@index([adType])
  @@index([adType, placement])
  @@index([clickedAt])
  @@index([createdAt])
  @@index([userId])
}

model AdminDashboardReport {
  id Int @id
  position Int
  source String
  identifier String
  createdAt DateTime @map("created_at")
  updatedAt DateTime @map("updated_at")

  @@index([position])
  @@unique([source, identifier])
}

model AdminDashboardSection {
  id Int @id
  sectionId String @map("section_id")
  position Int
  visible Boolean @default(true)
  createdAt DateTime @map("created_at")
  updatedAt DateTime @map("updated_at")
  settings Json

  @@unique([sectionId])
}

model AdminNotice {
  id Int @id
  subject Int
  priority Int
  identifier String
  details Json
  createdAt DateTime @map("created_at")
  updatedAt DateTime @map("updated_at")

  @@index([identifier])
  @@index([subject])
}

model AiAgentMcpServer {
  id Int @id
  aiAgentId Int @map("ai_agent_id")
  aiMcpServerId Int @map("ai_mcp_server_id")
  createdAt DateTime @map("created_at")
  updatedAt DateTime @map("updated_at")
  selectedToolNames Json? @map("selected_tool_names")

  @@unique([aiAgentId, aiMcpServerId])
  @@index([aiMcpServerId])
}

model AiAgent {
  id Int @id
  name String
  description String
  systemPrompt String @map("system_prompt")
  allowedGroupIds Int[] @map("allowed_group_ids")
  createdById Int? @map("created_by_id")
  enabled Boolean @default(true)
  createdAt DateTime @map("created_at")
  updatedAt DateTime @map("updated_at")
  system Boolean @default(false)
  priority Boolean @default(false)
  temperature Float?
  topP Float? @map("top_p")
  userId Int? @map("user_id")
  visionEnabled Boolean @map("vision_enabled") @default(false)
  visionMaxPixels Int @map("vision_max_pixels") @default(1048576)
  ragChunkTokens Int @map("rag_chunk_tokens") @default(374)
  ragChunkOverlapTokens Int @map("rag_chunk_overlap_tokens") @default(10)
  ragConversationChunks Int @map("rag_conversation_chunks") @default(10)
  tools Json @default("[]")
  forcedToolCount Int @map("forced_tool_count") @default("-1")
  allowChatChannelMentions Boolean @map("allow_chat_channel_mentions") @default(false)
  allowChatDirectMessages Boolean @map("allow_chat_direct_messages") @default(false)
  allowTopicMentions Boolean @map("allow_topic_mentions") @default(false)
  allowPersonalMessages Boolean @map("allow_personal_messages") @default(true)
  forceDefaultLlm Boolean @map("force_default_llm") @default(false)
  ragLlmModelId Int? @map("rag_llm_model_id")
  defaultLlmId Int? @map("default_llm_id")
  questionConsolidatorLlmId Int? @map("question_consolidator_llm_id")
  responseFormat Json? @map("response_format")
  examples Json?
  showThinking Boolean @map("show_thinking") @default(true)
  maxTurnTokens Int? @map("max_turn_tokens")
  compressionThreshold Int @map("compression_threshold") @default(80)
  requireApproval Boolean @map("require_approval") @default(false)
  thinkingEffort String? @map("thinking_effort")
  subagentIds Int[] @map("subagent_ids")

  @@unique([name])
}

model AiApiAuditLog {
  id Int @id
  providerId Int @map("provider_id")
  userId Int? @map("user_id")
  requestTokens Int? @map("request_tokens")
  responseTokens Int? @map("response_tokens")
  rawRequestPayload String? @map("raw_request_payload")
  rawResponsePayload String? @map("raw_response_payload")
  createdAt DateTime @map("created_at")
  updatedAt DateTime @map("updated_at")
  topicId Int? @map("topic_id")
  postId Int? @map("post_id")
  featureName String? @map("feature_name")
  languageModel String? @map("language_model")
  featureContext Json? @map("feature_context")
  durationMsecs Int? @map("duration_msecs")
  cacheWriteTokens Int? @map("cache_write_tokens")
  cacheReadTokens Int? @map("cache_read_tokens")
  llmId Int? @map("llm_id")
  responseStatus Int? @map("response_status")
  requestAttempts Json? @map("request_attempts")
  estimatedCost Float? @map("estimated_cost")
  timeToFirstTokenMsecs Int? @map("time_to_first_token_msecs")

  @@index([id])
  @@index([featureName, id])
  @@index([userId, id])
  @@index([createdAt, featureName])
  @@index([createdAt, languageModel])
  @@index([createdAt, userId])
  @@index([llmId])
  @@index([postId])
  @@index([topicId])
}

model AiApiRequestStat {
  id Int @id
  bucketDate DateTime @map("bucket_date")
  userId Int? @map("user_id")
  providerId Int @map("provider_id")
  llmId Int? @map("llm_id")
  languageModel String? @map("language_model")
  featureName String? @map("feature_name")
  requestTokens Int @map("request_tokens") @default(0)
  responseTokens Int @map("response_tokens") @default(0)
  cacheReadTokens Int @map("cache_read_tokens") @default(0)
  cacheWriteTokens Int @map("cache_write_tokens") @default(0)
  usageCount Int @map("usage_count") @default(1)
  rolledUp Boolean @map("rolled_up") @default(false)
  createdAt DateTime @map("created_at")
  updatedAt DateTime @map("updated_at")
  estimatedCost Float? @map("estimated_cost")

  @@index([bucketDate, featureName])
  @@index([bucketDate, languageModel])
  @@index([bucketDate, llmId])
  @@index([bucketDate, rolledUp])
  @@index([bucketDate, userId])
  @@index([createdAt, featureName])
  @@index([createdAt, languageModel])
  @@index([createdAt, userId])
}

