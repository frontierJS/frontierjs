  plan Plan @relation(fields: [planId], references: [id])
  status Int
  canceledAt DateTime? @map("canceled_at")
  terminatedAt DateTime? @map("terminated_at")
  startedAt DateTime? @map("started_at")
  createdAt DateTime @map("created_at")
  updatedAt DateTime @map("updated_at")
  previousSubscriptionId String? @map("previous_subscription_id")
  name String?
  externalId String @map("external_id")
  billingTime Int @map("billing_time") @default(0)
  subscriptionAt DateTime? @map("subscription_at")
  endingAt DateTime? @map("ending_at")
  trialEndedAt DateTime? @map("trial_ended_at")
  organizationId String @map("organization_id")
  organization Organization @relation(fields: [organizationId], references: [id])
  onTerminationCreditNote SubscriptionOnTerminationCreditNote? @map("on_termination_credit_note")
  onTerminationInvoice SubscriptionOnTerminationInvoice @map("on_termination_invoice") @default(generate)
  paymentMethodId String? @map("payment_method_id")
  paymentMethod PaymentMethod? @relation(fields: [paymentMethodId], references: [id])
  paymentMethodType PaymentMethodTypes @map("payment_method_type") @default(provider)
  skipInvoiceCustomSections Boolean @map("skip_invoice_custom_sections") @default(false)
  progressiveBillingDisabled Boolean @map("progressive_billing_disabled") @default(false)
  lastReceivedEventOn DateTime? @map("last_received_event_on")
  cancelationReason SubscriptionCancelationReasons? @map("cancelation_reason")
  incompletedAt DateTime? @map("incompleted_at")
  activatedAt DateTime? @map("activated_at")
  billingEntityId String? @map("billing_entity_id")
  billingEntity BillingEntity? @relation(fields: [billingEntityId], references: [id])
  consolidateInvoice Boolean @map("consolidate_invoice") @default(true)
  skipDailyUsage Boolean @map("skip_daily_usage") @default(false)
  cancellationReason SubscriptionCancellationReasons? @map("cancellation_reason")
  purchaseOrderNumber String? @map("purchase_order_number")
  billingAnchorDate DateTime? @map("billing_anchor_date")
  paymentTerm Json? @map("payment_term")

  @@index([planId, status])
  @@index([billingEntityId])
  @@index([customerId])
  @@index([endingAt], where: status == true && endingAt != null)
  @@index([externalId])
  @@index([lastReceivedEventOn])
  @@index([id], where: lastReceivedEventOn == null)
  @@index([organizationId])
  @@index([paymentMethodId])
  @@index([planId])
  @@index([previousSubscriptionId, status])
  @@index([startedAt])
  @@index([startedAt, endingAt])
  @@index([status])
}

