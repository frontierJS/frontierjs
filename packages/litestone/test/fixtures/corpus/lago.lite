model Invoice {
  id String @id @default(uuid())
  createdAt DateTime @map("created_at")
  updatedAt DateTime @map("updated_at")
  issuingDate DateTime? @map("issuing_date")
  taxesAmountCents Int @map("taxes_amount_cents") @default(0) @big
  totalAmountCents Int @map("total_amount_cents") @default(0) @big
  invoiceType Int @map("invoice_type") @default(0)
  paymentStatus Int @map("payment_status") @default(0)
  number String @default("")
  sequentialId Int? @map("sequential_id")
  file String?
  customerId String? @map("customer_id")
  customer Customer? @relation(fields: [customerId], references: [id])
  taxesRate Float @map("taxes_rate") @default(0.0)
  status Int @default(1)
  timezone String @default("UTC")
  paymentAttempts Int @map("payment_attempts") @default(0)
  readyForPaymentProcessing Boolean @map("ready_for_payment_processing") @default(true)
  organizationId String @map("organization_id")
  organization Organization @relation(fields: [organizationId], references: [id])
  versionNumber Int @map("version_number") @default(4)
  currency String?
  feesAmountCents Int @map("fees_amount_cents") @default(0) @big
  couponsAmountCents Int @map("coupons_amount_cents") @default(0) @big
  creditNotesAmountCents Int @map("credit_notes_amount_cents") @default(0) @big
  prepaidCreditAmountCents Int @map("prepaid_credit_amount_cents") @default(0) @big
  subTotalExcludingTaxesAmountCents Int @map("sub_total_excluding_taxes_amount_cents") @default(0) @big
  subTotalIncludingTaxesAmountCents Int @map("sub_total_including_taxes_amount_cents") @default(0) @big
  paymentDueDate DateTime? @map("payment_due_date")
  netPaymentTerm Int? @map("net_payment_term") @default(0)
  voidedAt DateTime? @map("voided_at")
  organizationSequentialId Int @map("organization_sequential_id") @default(0)
  readyToBeRefreshed Boolean @map("ready_to_be_refreshed") @default(false)
  paymentDisputeLostAt DateTime? @map("payment_dispute_lost_at")
  skipCharges Boolean @map("skip_charges") @default(false)
  paymentOverdue Boolean? @map("payment_overdue") @default(false)
  negativeAmountCents Int @map("negative_amount_cents") @default(0) @big
  progressiveBillingCreditAmountCents Int @map("progressive_billing_credit_amount_cents") @default(0) @big
  taxStatus TaxStatus? @map("tax_status")
  totalPaidAmountCents Int @map("total_paid_amount_cents") @default(0) @big
  selfBilled Boolean @map("self_billed") @default(false)
  appliedGracePeriod Int? @map("applied_grace_period")
  billingEntityId String @map("billing_entity_id")
  billingEntity BillingEntity @relation(fields: [billingEntityId], references: [id])
  billingEntitySequentialId Int? @map("billing_entity_sequential_id")
  finalizedAt DateTime? @map("finalized_at")
  voidedInvoiceId String? @map("voided_invoice_id")
  xmlFile String? @map("xml_file")
  expectedFinalizationDate DateTime? @map("expected_finalization_date")
  prepaidGrantedCreditAmountCents Int? @map("prepaid_granted_credit_amount_cents") @big
  prepaidPurchasedCreditAmountCents Int? @map("prepaid_purchased_credit_amount_cents") @big
  paymentMethodId String? @map("payment_method_id")
  paymentMethod PaymentMethod? @relation(fields: [paymentMethodId], references: [id])
  skipAutomaticPayment Boolean? @map("skip_automatic_payment")
  purchaseOrderNumber String? @map("purchase_order_number")
  paymentTerm Json? @map("payment_term")
  paymentTermSource String? @map("payment_term_source")
  searchTerms String? @map("search_terms")
  x402PaymentToken String? @map("x402_payment_token")
  x402ConnectionId String? @map("x402_connection_id")
  x402Connection X402Connection? @relation(fields: [x402ConnectionId], references: [id])
  progressiveBillingTrigger InvoiceProgressiveBillingTrigger? @map("progressive_billing_trigger")
  prepaidCreditBeforeTaxAmountCents Int @map("prepaid_credit_before_tax_amount_cents") @default(0) @big
  prepaidCreditAfterTaxAmountCents Int @map("prepaid_credit_after_tax_amount_cents") @default(0) @big

  @@check("(netPaymentTerm >= 0)")
  @@index([organizationId, status])
  @@index([organizationId, issuingDate, createdAt, id])
  @@unique([customerId, billingEntityId, sequentialId], nullsDistinct: true)
  @@index([number])
  @@index([organizationId, createdAt])
  @@index([customerId, organizationId])
  @@index([organizationId, invoiceType, issuingDate, createdAt, id])
  @@index([paymentDueDate])
  @@index([paymentMethodId])
  @@index([readyToBeRefreshed], where: readyToBeRefreshed == true)
  @@index([voidedInvoiceId])
  @@index([x402ConnectionId], where: x402ConnectionId != null)
  @@unique([x402PaymentToken], where: x402PaymentToken != null)
}

