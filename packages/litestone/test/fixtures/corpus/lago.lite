model Invoice {
  id String @id @default(uuid())
  createdAt DateTime @map("created_at")
  updatedAt DateTime @map("updated_at")
  issuingDate DateTime? @map("issuing_date")
  taxesAmountCents Int @map("taxes_amount_cents") @default(0)
  totalAmountCents Int @map("total_amount_cents") @default(0)
  invoiceType Int @map("invoice_type") @default(0)
  paymentStatus Int @map("payment_status") @default(0)
  number String @default("")
  sequentialId Int? @map("sequential_id")
  file String?
  customerId String? @map("customer_id")
  customer Customer? @relation(fields: [customerId], references: [id])
  taxesRate Float @map("taxes_rate") @default(0.0)
  status Int @default(1)
  timezone String @default("UTC")
  paymentAttempts Int @map("payment_attempts") @default(0)
  readyForPaymentProcessing Boolean @map("ready_for_payment_processing") @default(true)
  organizationId String @map("organization_id")
  organization Organization @relation(fields: [organizationId], references: [id])
  versionNumber Int @map("version_number") @default(4)
  currency String?
  feesAmountCents Int @map("fees_amount_cents") @default(0)
  couponsAmountCents Int @map("coupons_amount_cents") @default(0)
  creditNotesAmountCents Int @map("credit_notes_amount_cents") @default(0)
  prepaidCreditAmountCents Int @map("prepaid_credit_amount_cents") @default(0)
  subTotalExcludingTaxesAmountCents Int @map("sub_total_excluding_taxes_amount_cents") @default(0)
  subTotalIncludingTaxesAmountCents Int @map("sub_total_including_taxes_amount_cents") @default(0)
  paymentDueDate DateTime? @map("payment_due_date")
  netPaymentTerm Int @map("net_payment_term") @default(0)
  voidedAt DateTime? @map("voided_at")
  organizationSequentialId Int @map("organization_sequential_id") @default(0)
  readyToBeRefreshed Boolean @map("ready_to_be_refreshed") @default(false)
  paymentDisputeLostAt DateTime? @map("payment_dispute_lost_at")
  skipCharges Boolean @map("skip_charges") @default(false)
  paymentOverdue Boolean? @map("payment_overdue") @default(false)
  negativeAmountCents Int @map("negative_amount_cents") @default(0)
  progressiveBillingCreditAmountCents Int @map("progressive_billing_credit_amount_cents") @default(0)
  taxStatus TaxStatus? @map("tax_status")
  totalPaidAmountCents Int @map("total_paid_amount_cents") @default(0)
  selfBilled Boolean @map("self_billed") @default(false)
  appliedGracePeriod Int? @map("applied_grace_period")
  billingEntityId String @map("billing_entity_id")
  billingEntity BillingEntity @relation(fields: [billingEntityId], references: [id])
  billingEntitySequentialId Int? @map("billing_entity_sequential_id")
  finalizedAt DateTime? @map("finalized_at")
  voidedInvoiceId String? @map("voided_invoice_id")
  xmlFile String? @map("xml_file")
  expectedFinalizationDate DateTime? @map("expected_finalization_date")
  prepaidGrantedCreditAmountCents Int? @map("prepaid_granted_credit_amount_cents")
  prepaidPurchasedCreditAmountCents Int? @map("prepaid_purchased_credit_amount_cents")
  paymentMethodId String? @map("payment_method_id")
  paymentMethod PaymentMethod? @relation(fields: [paymentMethodId], references: [id])
  skipAutomaticPayment Boolean? @map("skip_automatic_payment")
  purchaseOrderNumber String? @map("purchase_order_number")
  paymentTerm Json? @map("payment_term")
  paymentTermSource String? @map("payment_term_source")
  searchTerms String? @map("search_terms")

  @@check("(netPaymentTerm >= 0)")
  @@index([organizationId, status])
  @@index([organizationId, issuingDate, createdAt, id])
  @@unique([customerId, billingEntityId, sequentialId], nullsDistinct: true)
  @@index([number])
  @@index([customerId, organizationId])
  @@index([paymentDueDate])
  @@index([paymentMethodId])
  @@index([readyToBeRefreshed])
  @@index([voidedInvoiceId])
}

model Plan {
  id String @id @default(uuid())
  organizationId String @map("organization_id")
  organization Organization @relation(fields: [organizationId], references: [id])
  name String
  createdAt DateTime @map("created_at")
  updatedAt DateTime @map("updated_at")
  code String
  interval Int?
  description String?
  amountCents Int? @map("amount_cents")
  amountCurrency String @map("amount_currency")
  trialPeriod Float? @map("trial_period")
  payInAdvance Boolean? @map("pay_in_advance") @default(false)
  billChargesMonthly Boolean? @map("bill_charges_monthly")
  parentId String? @map("parent_id")
  parent Plan? @relation(fields: [parentId], references: [id])
  deletedAt DateTime? @map("deleted_at")
  pendingDeletion Boolean @map("pending_deletion") @default(false)
  invoiceDisplayName String? @map("invoice_display_name")
  billFixedChargesMonthly Boolean? @map("bill_fixed_charges_monthly") @default(false)
  pricingType PlanPricingType @map("pricing_type")

  @@check("((pricingType <> 'legacy') OR ((interval IS NOT NULL) AND (amountCents IS NOT NULL) AND (payInAdvance IS NOT NULL)))")
  @@index([billFixedChargesMonthly])
  @@index([createdAt])
  @@index([deletedAt])
  @@index([organizationId])
  @@index([parentId])
}

model Subscription {
