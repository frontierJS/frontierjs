model PricingUnitUsage {
  id String @id @default(uuid())
  organizationId String @map("organization_id")
  organization Organization @relation(fields: [organizationId], references: [id])
  feeId String @map("fee_id")
  fee Fee @relation(fields: [feeId], references: [id])
  pricingUnitId String @map("pricing_unit_id")
  pricingUnit PricingUnit @relation(fields: [pricingUnitId], references: [id])
  shortName String @map("short_name")
  amountCents Int @map("amount_cents")
  preciseAmountCents Float @map("precise_amount_cents") @default(0.0)
  unitAmountCents Int @map("unit_amount_cents") @default(0)
  conversionRate Float @map("conversion_rate") @default(0.0)
  createdAt DateTime @map("created_at")
  updatedAt DateTime @map("updated_at")
  preciseUnitAmount Float @map("precise_unit_amount") @default(0.0)

  @@index([feeId])
  @@index([organizationId])
  @@index([pricingUnitId])
}

model PricingUnit {
  id String @id @default(uuid())
  name String
  code String
  shortName String @map("short_name")
  description String?
  organizationId String @map("organization_id")
  organization Organization @relation(fields: [organizationId], references: [id])
  createdAt DateTime @map("created_at")
  updatedAt DateTime @map("updated_at")

  @@unique([code, organizationId])
  @@index([organizationId])
}

model ProductCategory {
  id String @id @default(uuid())
  organizationId String @map("organization_id")
  organization Organization @relation(fields: [organizationId], references: [id])
  code String
