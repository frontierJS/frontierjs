model WebhookEndpoint {
  id String @id @default(uuid())
  organizationId String @map("organization_id")
  organization Organization @relation(fields: [organizationId], references: [id])
  webhookUrl String @map("webhook_url")
  createdAt DateTime @map("created_at")
  updatedAt DateTime @map("updated_at")
  signatureAlgo Int @map("signature_algo") @default(0)
  eventTypes String[]? @map("event_types")
  name String?

  @@index([organizationId])
  @@unique([webhookUrl, organizationId])
}

model Webhook {
  id String @id @default(uuid())
  objectId String? @map("object_id")
  objectType String? @map("object_type")
  status Int @default(0)
  retries Int @default(0)
  httpStatus Int? @map("http_status")
  endpoint String?
  webhookType String? @map("webhook_type")
  payload Json?
  response Json?
  lastRetriedAt DateTime? @map("last_retried_at")
  createdAt DateTime @map("created_at")
  updatedAt DateTime @map("updated_at")
  webhookEndpointId String? @map("webhook_endpoint_id")
  webhookEndpoint WebhookEndpoint? @relation(fields: [webhookEndpointId], references: [id])
  organizationId String @map("organization_id")
  organization Organization @relation(fields: [organizationId], references: [id])
  payloadKey String? @map("payload_key")
  responseKey String? @map("response_key")

  @@index([organizationId, webhookEndpointId, webhookType, updatedAt])
  @@index([webhookEndpointId, updatedAt, createdAt])
  @@index([webhookEndpointId, status, updatedAt])
  @@index([objectType, objectId, webhookType])
  @@index([organizationId])
  @@index([webhookEndpointId])
}
