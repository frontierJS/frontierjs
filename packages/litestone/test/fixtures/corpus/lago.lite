  hmacKey String @map("hmac_key")
  authenticationMethods String[] @map("authentication_methods")
  auditLogsPeriod Int? @map("audit_logs_period") @default(30)
  preFilterEvents Boolean @map("pre_filter_events") @default(false)
  clickhouseDeduplicationEnabled Boolean @map("clickhouse_deduplication_enabled") @default(false)
  featureFlags String[] @map("feature_flags")
  maxWallets Int? @map("max_wallets")
  slug String

  @@check("(invoiceGracePeriod >= 0)")
  @@check("(netPaymentTerm >= 0)")
  @@unique([apiKey])
  @@unique([hmacKey])
  @@unique([slug])
}

