  @@check("((remainingAmountCents >= 0) OR (remainingAmountCents IS NULL))")
  @@index([billingEntityId])
  @@index([creditNoteId])
  @@index([invoiceId])
  @@index([organizationId])
  @@index([paymentMethodId])
  @@index([voidedInvoiceId])
  @@index([walletId])
}

