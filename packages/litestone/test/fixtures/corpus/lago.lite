  updatedAt DateTime @map("updated_at")

  @@arc([planWalletId, catalogWalletId])
  @@index([organizationId])
}

model CatalogWalletTransaction {
  id String @id @default(uuid())
  organizationId String @map("organization_id")
  organization Organization @relation(fields: [organizationId], references: [id])
  catalogWalletId String @map("catalog_wallet_id")
  catalogWallet CatalogWallet @relation(fields: [catalogWalletId], references: [id])
  creditAllocationId String? @map("credit_allocation_id")
  creditAllocation CatalogWalletCreditAllocation? @relation(fields: [creditAllocationId], references: [id])
  invoiceId String? @map("invoice_id")
  invoice Invoice? @relation(fields: [invoiceId], references: [id])
  direction CatalogWalletTransactionDirection
  status CatalogWalletTransactionStatus
  reason CatalogWalletTransactionReason
  allocationType CatalogWalletTransactionAllocationType? @map("allocation_type")
  priority Int @default(50)
  purchaseAmountCents Int? @map("purchase_amount_cents") @big
  creditAmountCents Int @map("credit_amount_cents") @big
  remainingCreditAmountCents Int? @map("remaining_credit_amount_cents") @big
  invoiceRequiresSuccessfulPayment Boolean? @map("invoice_requires_successful_payment")
  sourceCycleStartedAt DateTime? @map("source_cycle_started_at")
  idempotencyKey String? @map("idempotency_key")
  requestDigest String? @map("request_digest")
  settledAt DateTime? @map("settled_at")
  failedAt DateTime? @map("failed_at")
  createdAt DateTime @map("created_at")
  updatedAt DateTime @map("updated_at")

  @@check("CASE reason WHEN 'credit_allocation' THEN ((((creditAllocationId IS NULL) + (allocationType IS NULL)) = 0) AND ((allocationType = 'billing_cycle') = (sourceCycleStartedAt IS NOT NULL))) ELSE (((creditAllocationId IS NOT NULL) + (allocationType IS NOT NULL) + (sourceCycleStartedAt IS NOT NULL)) = 0) END")
  @@check("((creditAmountCents > 0) AND (purchaseAmountCents >= 0))")
  @@check("((status = 'failed') = (failedAt IS NOT NULL))")
  @@check("(remainingCreditAmountCents >= 0)")
  @@check("(remainingCreditAmountCents <= creditAmountCents)")
  @@check("((status = 'settled') = (settledAt IS NOT NULL))")
  @@index([catalogWalletId, createdAt, id])
  @@index([creditAllocationId])
  @@index([invoiceId])
  @@index([organizationId])
}

model CatalogWallet {
