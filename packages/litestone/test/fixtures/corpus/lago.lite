  depletedOngoingBalance Boolean @map("depleted_ongoing_balance") @default(false)
  invoiceRequiresSuccessfulPayment Boolean @map("invoice_requires_successful_payment") @default(false)
  lockVersion Int @map("lock_version") @default(0)
  readyToBeRefreshed Boolean @map("ready_to_be_refreshed") @default(false)
  organizationId String @map("organization_id")
  organization Organization @relation(fields: [organizationId], references: [id])
  allowedFeeTypes String[] @map("allowed_fee_types")
  lastOngoingBalanceSyncAt DateTime? @map("last_ongoing_balance_sync_at")
  priority Int @default(50)
  paidTopUpMinAmountCents Int? @map("paid_top_up_min_amount_cents")
  paidTopUpMaxAmountCents Int? @map("paid_top_up_max_amount_cents")
