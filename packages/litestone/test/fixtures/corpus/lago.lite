  product Product? @relation(fields: [productId], references: [id])
  productFilterId String? @map("product_filter_id")
  productFilter ProductFilter? @relation(fields: [productFilterId], references: [id])
  code String
  trigger CatalogWalletCreditAllocationTrigger
  billingCycles Int? @map("billing_cycles")
  thresholdAmountCents Int? @map("threshold_amount_cents") @big
  creditAmountCents Int @map("credit_amount_cents") @big
  purchaseAmountCents Int? @map("purchase_amount_cents") @big
  priority Int @default(50)
  invoiceRequiresSuccessfulPayment Boolean? @map("invoice_requires_successful_payment")
  deletedAt DateTime? @map("deleted_at")
  createdAt DateTime @map("created_at")
  updatedAt DateTime @map("updated_at")

  @@check("(billingCycles >= 1)")
  @@check("(creditAmountCents > 0)")
  @@index([organizationId])
  @@unique([catalogWalletId, code], where: deletedAt == null)
}

