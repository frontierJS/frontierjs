  endedAt DateTime @map("ended_at")
  createdAt DateTime @map("created_at")
  updatedAt DateTime @map("updated_at")
  prorationRatio Float @map("proration_ratio")

  @@check("(endedAt > startedAt)")
  @@unique([billingOperationId, position])
  @@index([organizationId])
  @@index([rateCardRateId])
  @@index([rateOverrideId])
}

model BillingOperation {
  id String @id @default(uuid())
  organizationId String @map("organization_id")
  organization Organization @relation(fields: [organizationId], references: [id])
  customerId String @map("customer_id")
  customer Customer @relation(fields: [customerId], references: [id])
  contractRateCardId String @map("contract_rate_card_id")
  contractRateCard ContractRateCard @relation(fields: [contractRateCardId], references: [id])
  invoiceId String? @map("invoice_id")
  invoice Invoice? @relation(fields: [invoiceId], references: [id])
  actionType String @map("action_type")
  reason BillingOperationReason
  billingAt DateTime @map("billing_at")
  cancelledAt DateTime? @map("cancelled_at")
  cancellationReason BillingOperationCancellationReason? @map("cancellation_reason")
  targetCycleStartedAt DateTime @map("target_cycle_started_at")
  processedAt DateTime? @map("processed_at")
  createdAt DateTime @map("created_at")
  updatedAt DateTime @map("updated_at")
  coverageStartedAt DateTime? @map("coverage_started_at")
  coverageEndedAt DateTime? @map("coverage_ended_at")

  @@index([contractRateCardId])
  @@index([customerId])
  @@index([invoiceId])
  @@index([organizationId])
  @@index([contractRateCardId, billingAt], where: processedAt == null && cancelledAt == null)
  @@index([organizationId, billingAt, id], where: processedAt == null && cancelledAt == null)
  @@index([organizationId, customerId, billingAt, id], where: processedAt == null && cancelledAt == null)
}

model BillingSegment {
  id String @id @default(uuid())
  organizationId String @map("organization_id")
  organization Organization @relation(fields: [organizationId], references: [id])
  contractId String @map("contract_id")
  contract Contract @relation(fields: [contractId], references: [id])
  customerId String @map("customer_id")
  customer Customer @relation(fields: [customerId], references: [id])
  contractRateCardId String @map("contract_rate_card_id")
  contractRateCard ContractRateCard @relation(fields: [contractRateCardId], references: [id])
  invoiceId String? @map("invoice_id")
  invoice Invoice? @relation(fields: [invoiceId], references: [id])
  rateCardRateId String? @map("rate_card_rate_id")
  rateCardRate RateCardRate? @relation(fields: [rateCardRateId], references: [id])
  rateOverrideId String? @map("rate_override_id")
  rateOverride RateOverride? @relation(fields: [rateOverrideId], references: [id])
  pricingUnitId String? @map("pricing_unit_id")
  pricingUnit PricingUnit? @relation(fields: [pricingUnitId], references: [id])
  rateProperties Json @map("rate_properties")
  currency String
  billingAt DateTime @map("billing_at")
  startedAt DateTime @map("started_at")
  endedAt DateTime @map("ended_at")
  cycleStartedAt DateTime @map("cycle_started_at")
  prorationRatio Float @map("proration_ratio") @default(1.0)
  status BillingSegmentStatus @default(pending)
  createdAt DateTime @map("created_at")
  updatedAt DateTime @map("updated_at")

  @@check("(cycleStartedAt <= startedAt)")
  @@check("(startedAt <= endedAt)")
  @@check("((rateCardRateId IS NOT NULL) OR (rateOverrideId IS NOT NULL))")
  @@index([contractId, billingAt, status])
  @@index([contractRateCardId, cycleStartedAt])
  @@unique([contractRateCardId, startedAt])
  @@index([contractId])
  @@index([contractRateCardId])
  @@index([status, customerId])
  @@index([customerId])
  @@index([invoiceId])
  @@index([organizationId])
  @@index([rateOverrideId])
}

model CachedAggregation {
  id String @id @default(uuid())
  organizationId String @map("organization_id")
  timestamp DateTime
  externalSubscriptionId String @map("external_subscription_id")
  chargeId String? @map("charge_id")
  groupId String? @map("group_id")
  group Group? @relation(fields: [groupId], references: [id])
  currentAggregation Float? @map("current_aggregation")
  maxAggregation Float? @map("max_aggregation")
  maxAggregationWithProration Float? @map("max_aggregation_with_proration")
  createdAt DateTime @map("created_at")
  updatedAt DateTime @map("updated_at")
  groupedBy Json @map("grouped_by")
  chargeFilterId String? @map("charge_filter_id")
  currentAmount Float? @map("current_amount")
  eventTransactionId String? @map("event_transaction_id")
  presentationBreakdowns Json @map("presentation_breakdowns") @default("[]")
  contractId String? @map("contract_id")
  contract Contract? @relation(fields: [contractId], references: [id])
