model DailyUsage {
  id String @id @default(uuid())
  organizationId String @map("organization_id")
  organization Organization @relation(fields: [organizationId], references: [id])
  customerId String @map("customer_id")
  customer Customer @relation(fields: [customerId], references: [id])
  subscriptionId String? @map("subscription_id")
  subscription Subscription? @relation(fields: [subscriptionId], references: [id])
  externalSubscriptionId String? @map("external_subscription_id")
  fromDatetime DateTime @map("from_datetime")
  toDatetime DateTime @map("to_datetime")
  usage Json @default("\"{}\"")
  createdAt DateTime @map("created_at")
  updatedAt DateTime @map("updated_at")
  refreshedAt DateTime @map("refreshed_at")
  usageDiff Json @map("usage_diff") @default("\"{}\"")
  usageDate DateTime? @map("usage_date")
  contractId String? @map("contract_id")
  contract Contract? @relation(fields: [contractId], references: [id])
  contractRateCardId String? @map("contract_rate_card_id")
  contractRateCard ContractRateCard? @relation(fields: [contractRateCardId], references: [id])
  externalContractId String? @map("external_contract_id")

  @@check("(((subscriptionId IS NOT NULL) AND (externalSubscriptionId IS NOT NULL) AND (contractId IS NULL) AND (contractRateCardId IS NULL) AND (externalContractId IS NULL)) OR ((subscriptionId IS NULL) AND (externalSubscriptionId IS NULL) AND (contractId IS NOT NULL) AND (contractRateCardId IS NOT NULL) AND (externalContractId IS NOT NULL)))")
  @@index([organizationId, externalSubscriptionId])
  @@index([contractId, usageDate], where: contractId != null)
  @@index([contractRateCardId, usageDate], where: contractId != null)
  @@index([customerId])
  @@index([organizationId])
  @@index([organizationId, externalContractId], where: contractId != null)
  @@index([subscriptionId])
  @@index([subscriptionId, usageDate])
  @@index([usageDate])
}

