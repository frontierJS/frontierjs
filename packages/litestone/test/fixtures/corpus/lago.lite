  appliedDunningCampaign DunningCampaign? @relation(fields: [appliedDunningCampaignId], references: [id])
  excludeFromDunningCampaign Boolean @map("exclude_from_dunning_campaign") @default(false)
  lastDunningCampaignAttempt Int @map("last_dunning_campaign_attempt") @default(0)
  lastDunningCampaignAttemptAt DateTime? @map("last_dunning_campaign_attempt_at")
