model BillableMetricFilter {
  id String @id @default(uuid())
  billableMetricId String @map("billable_metric_id")
  billableMetric BillableMetric @relation(fields: [billableMetricId], references: [id])
  key String
  values String[]
  createdAt DateTime @map("created_at")
  updatedAt DateTime @map("updated_at")
  deletedAt DateTime? @map("deleted_at")
  organizationId String @map("organization_id")
  organization Organization @relation(fields: [organizationId], references: [id])

  @@index([billableMetricId])
  @@index([deletedAt])
  @@index([organizationId])
}

model BillableMetric {
  id String @id @default(uuid())
  organizationId String @map("organization_id")
  organization Organization @relation(fields: [organizationId], references: [id])
  name String
  code String
  description String?
  properties Json?
  aggregationType Int @map("aggregation_type")
  createdAt DateTime @map("created_at")
  updatedAt DateTime @map("updated_at")
  fieldName String? @map("field_name")
  deletedAt DateTime? @map("deleted_at")
  recurring Boolean @default(false)
  weightedInterval BillableMetricWeightedInterval? @map("weighted_interval")
  customAggregator String? @map("custom_aggregator")
  expression String?
  roundingFunction BillableMetricRoundingFunction? @map("rounding_function")
  roundingPrecision Int? @map("rounding_precision")

  @@index([organizationId, createdAt, id], where: deletedAt == null)
  @@index([deletedAt])
  @@index([organizationId, code, expression])
  @@index([organizationId])
  @@unique([organizationId, code], where: deletedAt == null)
}

model BillingEntity {
  id String @id @default(uuid())
  organizationId String @map("organization_id")
  organization Organization @relation(fields: [organizationId], references: [id])
  addressLine1 String? @map("address_line1")
  addressLine2 String? @map("address_line2")
  city String?
  country String?
  zipcode String?
  state String?
  timezone String @default("UTC")
  defaultCurrency String @map("default_currency") @default("USD")
  documentLocale String @map("document_locale") @default("en")
  documentNumberPrefix String? @map("document_number_prefix")
  documentNumbering EntityDocumentNumbering @map("document_numbering") @default(per_customer)
  finalizeZeroAmountInvoice Boolean @map("finalize_zero_amount_invoice") @default(true)
  invoiceFooter String? @map("invoice_footer")
  invoiceGracePeriod Int @map("invoice_grace_period") @default(0)
  netPaymentTerm Int? @map("net_payment_term") @default(0)
  email String?
  emailSettings String[] @map("email_settings")
  euTaxManagement Boolean? @map("eu_tax_management") @default(false)
  legalName String? @map("legal_name")
  legalNumber String? @map("legal_number")
  logo String?
  name String
  code String
  taxIdentificationNumber String? @map("tax_identification_number")
  vatRate Float @map("vat_rate") @default(0.0)
  archivedAt DateTime? @map("archived_at")
  deletedAt DateTime? @map("deleted_at")
  createdAt DateTime @map("created_at")
  updatedAt DateTime @map("updated_at")
  appliedDunningCampaignId String? @map("applied_dunning_campaign_id")
  appliedDunningCampaign DunningCampaign? @relation(fields: [appliedDunningCampaignId], references: [id], onDelete: SetNull)
  einvoicing Boolean @default(false)
  subscriptionInvoiceIssuingDateAnchor SubscriptionInvoiceIssuingDateAnchors @map("subscription_invoice_issuing_date_anchor") @default(next_period_start)
  subscriptionInvoiceIssuingDateAdjustment SubscriptionInvoiceIssuingDateAdjustments @map("subscription_invoice_issuing_date_adjustment") @default(align_with_finalization_date)
  phone String?
  paymentTerm Json? @map("payment_term")

  @@index([appliedDunningCampaignId])
  @@unique([code, organizationId], where: deletedAt == null && archivedAt == null)
  @@index([organizationId])
}

