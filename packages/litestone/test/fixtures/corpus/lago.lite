  dunningCurrencyAttempts Json @map("dunning_currency_attempts")
  paymentTerm Json? @map("payment_term")

  @@check("(invoiceGracePeriod >= 0)")
  @@check("(netPaymentTerm >= 0)")
  @@index([organizationId, createdAt, id])
  @@index([accountType])
  @@index([appliedDunningCampaignId])
  @@index([awaitingWalletRefresh])
  @@index([billingEntityId])
  @@index([deletedAt])
  @@index([organizationId, externalId])
  @@index([organizationId])
  @@index([sequentialId])
}

