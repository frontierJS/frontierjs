  product Product? @relation(fields: [productId], references: [id])
  productFilterId String? @map("product_filter_id")
  productFilter ProductFilter? @relation(fields: [productFilterId], references: [id])

  @@check("((chargeId IS NOT NULL) OR ((contractId IS NOT NULL) AND (productId IS NOT NULL)))")
  @@index([contractId, productId, productFilterId, timestamp], where: contractId != null)
  @@index([chargeId])
  @@index([organizationId, eventTransactionId])
  @@index([externalSubscriptionId])
}

