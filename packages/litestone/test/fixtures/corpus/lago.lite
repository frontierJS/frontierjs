model Coupon {
  id String @id @default(uuid())
  organizationId String @map("organization_id")
  name String
  code String
  status Int @default(0)
  terminatedAt DateTime? @map("terminated_at")
  amountCents Int? @map("amount_cents") @big
  amountCurrency String? @map("amount_currency")
  expiration Int
  createdAt DateTime @map("created_at")
  updatedAt DateTime @map("updated_at")
  couponType Int @map("coupon_type") @default(0)
  percentageRate Int? @map("percentage_rate") @scale(5)
  frequency Int @default(0)
  frequencyDuration Int? @map("frequency_duration")
  expirationAt DateTime? @map("expiration_at")
  reusable Boolean @default(true)
  limitedPlans Boolean @map("limited_plans") @default(false)
  deletedAt DateTime? @map("deleted_at")
  limitedBillableMetrics Boolean @map("limited_billable_metrics") @default(false)
  description String?

