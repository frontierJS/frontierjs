  name String
  facilitator X402Facilitator @default(coinbase_cdp)
  secrets String
  payoutAddresses Json @map("payout_addresses")
  networks String[]
  asset X402Asset @default(usdc)
  autoCreateCustomers Boolean @map("auto_create_customers") @default(true)
  deletedAt DateTime? @map("deleted_at")
  createdAt DateTime @map("created_at")
  updatedAt DateTime @map("updated_at")
  allowedOrigins String[] @map("allowed_origins")

  @@unique([organizationId, code], where: deletedAt == null)
}

model X402Settlement {
  id String @id @default(uuid())
  organizationId String @map("organization_id")
  organization Organization @relation(fields: [organizationId], references: [id])
  x402ConnectionId String @map("x402_connection_id")
  x402Connection X402Connection @relation(fields: [x402ConnectionId], references: [id])
  customerId String? @map("customer_id")
  customer Customer? @relation(fields: [customerId], references: [id])
  subscriptionId String? @map("subscription_id")
  subscription Subscription? @relation(fields: [subscriptionId], references: [id])
  walletTransactionId String? @map("wallet_transaction_id")
  walletTransaction WalletTransaction? @relation(fields: [walletTransactionId], references: [id])
  paymentId String? @map("payment_id")
  payment Payment? @relation(fields: [paymentId], references: [id])
  invoiceId String? @map("invoice_id")
  invoice Invoice? @relation(fields: [invoiceId], references: [id])
  kind X402SettlementKind
  status X402SettlementStatus @default(pending)
  settledBy X402SettlementSettledBy @map("settled_by") @default(lago)
  network String
  asset String
  payerAddress String @map("payer_address")
  payeeAddress String @map("payee_address")
  settledAmountAtomic Int @map("settled_amount_atomic") @scale(0)
  settledAmountCents Int @map("settled_amount_cents") @big
  transactionHash String? @map("transaction_hash")
  reconcileAfter DateTime? @map("reconcile_after")
  paymentDigest String @map("payment_digest")
  purchaseSettings Json? @map("purchase_settings")
  payload Json
  errorReason String? @map("error_reason")
  createdAt DateTime @map("created_at")
  updatedAt DateTime @map("updated_at")
  requestKeyDigest String? @map("request_key_digest")

  @@check("((kind <> 'credit_purchase') OR (purchaseSettings IS NOT NULL))")
  @@check("((walletTransactionId IS NULL) OR (subscriptionId IS NOT NULL))")
  @@check("((kind <> 'invoice_payment') OR (invoiceId IS NOT NULL))")
  @@check("((kind <> 'invoice_payment') OR (requestKeyDigest IS NULL))")
  @@check("((settledBy = 'lago') OR ((kind = 'credit_purchase') AND (status = 'settled')))")
  @@check("((status <> 'pending') OR (reconcileAfter IS NOT NULL))")
  @@check("((status <> 'settled') OR (transactionHash IS NOT NULL))")
  @@index([customerId])
  @@index([invoiceId])
  @@index([organizationId])
  @@unique([paymentId], where: paymentId != null)
  @@index([reconcileAfter])
  @@index([id])
  @@index([x402ConnectionId])
}

model X402SignInNonce {
  id String @id @default(uuid())
  organizationId String @map("organization_id")
  organization Organization @relation(fields: [organizationId], references: [id])
  agentAddress String @map("agent_address")
  nonce String
  createdAt DateTime @map("created_at")
  updatedAt DateTime @map("updated_at")

  @@index([createdAt])
  @@unique([organizationId, agentAddress, nonce])
}
