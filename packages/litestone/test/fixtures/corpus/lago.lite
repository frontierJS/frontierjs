  description String?
  invoiceDisplayName String? @map("invoice_display_name")
  deletedAt DateTime? @map("deleted_at")
  createdAt DateTime @map("created_at")
  updatedAt DateTime @map("updated_at")

  @@index([deletedAt])
  @@index([organizationId])
}

model ProductFilterValue {
  id String @id @default(uuid())
  organizationId String @map("organization_id")
  organization Organization @relation(fields: [organizationId], references: [id])
  productFilterId String @map("product_filter_id")
  productFilter ProductFilter @relation(fields: [productFilterId], references: [id])
  billableMetricFilterId String @map("billable_metric_filter_id")
  billableMetricFilter BillableMetricFilter @relation(fields: [billableMetricFilterId], references: [id])
  value String?
  deletedAt DateTime? @map("deleted_at")
  createdAt DateTime @map("created_at")
  updatedAt DateTime @map("updated_at")

  @@index([billableMetricFilterId])
  @@index([deletedAt])
  @@index([organizationId])
  @@index([productFilterId])
}

model ProductFilter {
  id String @id @default(uuid())
  organizationId String @map("organization_id")
  organization Organization @relation(fields: [organizationId], references: [id])
  productId String @map("product_id")
  product Product @relation(fields: [productId], references: [id])
  name String
  code String
  description String?
  invoiceDisplayName String? @map("invoice_display_name")
  deletedAt DateTime? @map("deleted_at")
  createdAt DateTime @map("created_at")
  updatedAt DateTime @map("updated_at")

  @@index([deletedAt])
  @@index([organizationId])
  @@index([productId])
}

model Product {
  id String @id @default(uuid())
  organizationId String @map("organization_id")
  organization Organization @relation(fields: [organizationId], references: [id])
  productCategoryId String? @map("product_category_id")
  productCategory ProductCategory? @relation(fields: [productCategoryId], references: [id])
  billableMetricId String? @map("billable_metric_id")
  billableMetric BillableMetric? @relation(fields: [billableMetricId], references: [id])
  addOnId String? @map("add_on_id")
  addOn AddOn? @relation(fields: [addOnId], references: [id])
  chargeId String? @map("charge_id")
  charge Charge? @relation(fields: [chargeId], references: [id])
  productType ProductType @map("product_type")
  code String
  name String
  invoiceDisplayName String? @map("invoice_display_name")
  description String?
  deletedAt DateTime? @map("deleted_at")
  createdAt DateTime @map("created_at")
  updatedAt DateTime @map("updated_at")

  @@index([addOnId])
  @@index([billableMetricId])
  @@index([chargeId])
  @@index([deletedAt])
  @@index([organizationId])
  @@index([productCategoryId])
}

model QuantifiedEvent {
  id String @id @default(uuid())
  externalSubscriptionId String @map("external_subscription_id")
  externalId String? @map("external_id")
  addedAt DateTime @map("added_at")
  removedAt DateTime? @map("removed_at")
  createdAt DateTime @map("created_at")
  updatedAt DateTime @map("updated_at")
  billableMetricId String? @map("billable_metric_id")
  properties Json
  deletedAt DateTime? @map("deleted_at")
  groupId String? @map("group_id")
  group Group? @relation(fields: [groupId], references: [id])
  organizationId String @map("organization_id")
  organization Organization @relation(fields: [organizationId], references: [id])
  groupedBy Json @map("grouped_by")
  chargeFilterId String? @map("charge_filter_id")

  @@index([billableMetricId])
  @@index([chargeFilterId])
  @@index([deletedAt])
  @@index([externalId])
  @@index([groupId])
  @@index([organizationId])
  @@index([organizationId, externalSubscriptionId, billableMetricId])
}

model QuoteOwner {
  id Int @id
  organizationId String @map("organization_id")
  organization Organization @relation(fields: [organizationId], references: [id])
  quoteId String @map("quote_id")
  quote Quote @relation(fields: [quoteId], references: [id])
  userId String @map("user_id")
  user User @relation(fields: [userId], references: [id])
  createdAt DateTime @map("created_at")
  updatedAt DateTime @map("updated_at")

  @@index([organizationId])
  @@index([userId])
  @@unique([quoteId, userId])
}

model QuoteVersion {
  id String @id @default(uuid())
  organizationId String @map("organization_id")
  organization Organization @relation(fields: [organizationId], references: [id])
  quoteId String @map("quote_id")
  quote Quote @relation(fields: [quoteId], references: [id])
  sequentialId Int @map("sequential_id")
  status QuoteStatus
  approvedAt DateTime? @map("approved_at")
  voidedAt DateTime? @map("voided_at")
  voidReason QuoteVoidReason? @map("void_reason")
  billingItems Json? @map("billing_items")
  content String?
  shareToken String? @map("share_token")
  createdAt DateTime @map("created_at")
  updatedAt DateTime @map("updated_at")
  currency String?
  mentionVariables Json? @map("mention_variables")
  billingEntityId String? @map("billing_entity_id")
  billingEntity BillingEntity? @relation(fields: [billingEntityId], references: [id])

  @@check("((status = 'approved') = (approvedAt IS NOT NULL))")
  @@check("(sequentialId > 0)")
  @@check("((status = 'voided') = ((voidReason IS NOT NULL) AND (voidedAt IS NOT NULL)))")
  @@index([billingEntityId])
  @@index([organizationId])
  @@index([quoteId])
  @@unique([quoteId, sequentialId])
}

model Quote {
  id String @id @default(uuid())
  organizationId String @map("organization_id")
  organization Organization @relation(fields: [organizationId], references: [id])
  customerId String @map("customer_id")
  customer Customer @relation(fields: [customerId], references: [id])
  subscriptionId String? @map("subscription_id")
  subscription Subscription? @relation(fields: [subscriptionId], references: [id])
  number String
  sequentialId Int @map("sequential_id")
  orderType QuoteOrderType @map("order_type")
  createdAt DateTime @map("created_at")
  updatedAt DateTime @map("updated_at")

  @@check("(sequentialId > 0)")
  @@index([customerId])
  @@index([subscriptionId])
  @@unique([organizationId, number])
  @@unique([organizationId, sequentialId])
}

model RateCardRate {
  id String @id @default(uuid())
  organizationId String @map("organization_id")
  organization Organization @relation(fields: [organizationId], references: [id])
  rateCardId String @map("rate_card_id")
  rateCard RateCard @relation(fields: [rateCardId], references: [id])
  code String
  effectiveFrom DateTime @map("effective_from")
  rateModel RateCardRateModel @map("rate_model")
  rateProperties Json @map("rate_properties")
  minAmountCents Int @map("min_amount_cents") @default(0)
  billingIntervalCount Int @map("billing_interval_count") @default(1)
  billingIntervalUnit RateCardRateBillingIntervalUnit @map("billing_interval_unit")
  appliedPricingUnitConversionRate Float? @map("applied_pricing_unit_conversion_rate")
  deletedAt DateTime? @map("deleted_at")
  createdAt DateTime @map("created_at")
  updatedAt DateTime @map("updated_at")

  @@check("(billingIntervalCount >= 1)")
  @@index([deletedAt])
  @@index([organizationId])
  @@index([rateCardId])
}

model RateCard {
  id String @id @default(uuid())
  organizationId String @map("organization_id")
  organization Organization @relation(fields: [organizationId], references: [id])
  productId String @map("product_id")
  product Product @relation(fields: [productId], references: [id])
  productFilterId String? @map("product_filter_id")
  productFilter ProductFilter? @relation(fields: [productFilterId], references: [id])
  code String
  name String
  description String?
  currency String
  billingTiming RateCardBillingTiming @map("billing_timing")
  proration Boolean @default(false)
  displayOnInvoice Boolean @map("display_on_invoice") @default(true)
  regroupPaidFees RateCardRegroupPaidFees @map("regroup_paid_fees")
  appliedPricingUnitCode String? @map("applied_pricing_unit_code")
  walletTargetable Boolean? @map("wallet_targetable")
  deletedAt DateTime? @map("deleted_at")
  createdAt DateTime @map("created_at")
  updatedAt DateTime @map("updated_at")

  @@index([deletedAt])
  @@index([organizationId])
  @@index([productFilterId])
  @@index([productId])
}

model RateOverride {
  id String @id @default(uuid())
  organizationId String @map("organization_id")
  organization Organization @relation(fields: [organizationId], references: [id])
  rateModel RateCardRateModel @map("rate_model")
  rateProperties Json @map("rate_properties")
  minAmountCents Int @map("min_amount_cents") @default(0)
  billingIntervalCount Int? @map("billing_interval_count")
  billingIntervalUnit RateCardRateBillingIntervalUnit? @map("billing_interval_unit")
  pricingUnitConversionRate Float? @map("pricing_unit_conversion_rate")
  deletedAt DateTime? @map("deleted_at")
  createdAt DateTime @map("created_at")
  updatedAt DateTime @map("updated_at")

  @@index([deletedAt])
  @@index([organizationId])
}

model RatePhase {
  id String @id @default(uuid())
  organizationId String @map("organization_id")
  organization Organization @relation(fields: [organizationId], references: [id])
  planRateCardId String? @map("plan_rate_card_id")
  planRateCard PlanRateCard? @relation(fields: [planRateCardId], references: [id])
  subscriptionRateCardId String? @map("subscription_rate_card_id")
  subscriptionRateCard SubscriptionRateCard? @relation(fields: [subscriptionRateCardId], references: [id])
  code String
  position Int
  billingIntervalCycleCount Int? @map("billing_interval_cycle_count")
  rateOverrideId String? @map("rate_override_id")
  rateOverride RateOverride? @relation(fields: [rateOverrideId], references: [id])
  deletedAt DateTime? @map("deleted_at")
  createdAt DateTime @map("created_at")
  updatedAt DateTime @map("updated_at")
  name String?

  @@check("((planRateCardId IS NULL) <> (subscriptionRateCardId IS NULL))")
  @@index([deletedAt])
  @@index([organizationId])
  @@index([planRateCardId])
  @@index([subscriptionRateCardId])
}

model RecurringTransactionRule {
  id String @id @default(uuid())
  walletId String @map("wallet_id")
  wallet Wallet @relation(fields: [walletId], references: [id])
  trigger Int @default(0)
  paidCredits Int @map("paid_credits") @scale(5) @default(0.0)
  grantedCredits Int @map("granted_credits") @scale(5) @default(0.0)
  thresholdCredits Int? @map("threshold_credits") @scale(5) @default(0.0)
  interval Int? @default(0)
  createdAt DateTime @map("created_at")
  updatedAt DateTime @map("updated_at")
  method Int @default(0)
  targetOngoingBalance Int? @map("target_ongoing_balance") @scale(5)
  startedAt DateTime? @map("started_at")
  invoiceRequiresSuccessfulPayment Boolean @map("invoice_requires_successful_payment") @default(false)
  transactionMetadata Json? @map("transaction_metadata") @default("[]")
  expirationAt DateTime? @map("expiration_at")
  terminatedAt DateTime? @map("terminated_at")
  status Int? @default(0)
  organizationId String @map("organization_id")
  organization Organization @relation(fields: [organizationId], references: [id])
  ignorePaidTopUpLimits Boolean @map("ignore_paid_top_up_limits") @default(false)
  transactionName String? @map("transaction_name")
  paymentMethodId String? @map("payment_method_id")
  paymentMethod PaymentMethod? @relation(fields: [paymentMethodId], references: [id])
  paymentMethodType PaymentMethodTypes @map("payment_method_type")
  skipInvoiceCustomSections Boolean @map("skip_invoice_custom_sections") @default(false)
  grantsTargetTopUp Boolean? @map("grants_target_top_up")
  purchaseOrderNumber String? @map("purchase_order_number")

  @@index([expirationAt])
  @@index([organizationId])
  @@index([paymentMethodId])
  @@index([startedAt])
  @@index([walletId])
}

model RecurringTransactionRulesInvoiceCustomSection {
  id String @id @default(uuid())
  organizationId String @map("organization_id")
  organization Organization @relation(fields: [organizationId], references: [id])
  recurringTransactionRuleId String @map("recurring_transaction_rule_id")
  recurringTransactionRule RecurringTransactionRule @relation(fields: [recurringTransactionRuleId], references: [id])
  invoiceCustomSectionId String @map("invoice_custom_section_id")
  invoiceCustomSection InvoiceCustomSection @relation(fields: [invoiceCustomSectionId], references: [id])
  createdAt DateTime @map("created_at")
  updatedAt DateTime @map("updated_at")

  @@index([invoiceCustomSectionId])
  @@index([organizationId])
  @@index([recurringTransactionRuleId])
  @@unique([recurringTransactionRuleId, invoiceCustomSectionId])
}

model Refund {
  id String @id @default(uuid())
  paymentId String @map("payment_id")
  payment Payment @relation(fields: [paymentId], references: [id])
  creditNoteId String? @map("credit_note_id")
  creditNote CreditNote? @relation(fields: [creditNoteId], references: [id])
  paymentProviderId String? @map("payment_provider_id")
  paymentProvider PaymentProvider? @relation(fields: [paymentProviderId], references: [id])
  paymentProviderCustomerId String @map("payment_provider_customer_id")
  paymentProviderCustomer PaymentProviderCustomer @relation(fields: [paymentProviderCustomerId], references: [id])
  amountCents Int @map("amount_cents") @default(0)
  amountCurrency String @map("amount_currency")
  status String
  providerRefundId String @map("provider_refund_id")
  createdAt DateTime @map("created_at")
  updatedAt DateTime @map("updated_at")
  organizationId String @map("organization_id")
  organization Organization @relation(fields: [organizationId], references: [id])
  refundableType String? @map("refundable_type")
  refundableId String? @map("refundable_id")
  reason String?

  @@check("((creditNoteId IS NOT NULL) OR ((refundableType IS NOT NULL) AND (refundableId IS NOT NULL)))")
  @@index([creditNoteId])
  @@index([organizationId])
  @@index([paymentId])
  @@index([paymentProviderCustomerId])
  @@index([paymentProviderId])
  @@index([refundableType, refundableId])
}

model Role {
  id String @id @default(uuid())
  organizationId String? @map("organization_id")
  code String
  admin Boolean @default(false)
  permissions String[]
  name String
  description String?
  createdAt DateTime @map("created_at")
  updatedAt DateTime @map("updated_at")
  deletedAt DateTime? @map("deleted_at")

  @@index([organizationId])
}

model SchemaMigration {
  version String @id
}

model SubscriptionActivationRule {
  id String @id @default(uuid())
  organizationId String @map("organization_id")
  organization Organization @relation(fields: [organizationId], references: [id])
  subscriptionId String @map("subscription_id")
  subscription Subscription @relation(fields: [subscriptionId], references: [id])
  type SubscriptionActivationRuleTypes
  timeoutHours Int @map("timeout_hours") @default(0)
  status SubscriptionActivationRuleStatuses
  expiresAt DateTime? @map("expires_at")
  createdAt DateTime @map("created_at")
  updatedAt DateTime @map("updated_at")

  @@unique([subscriptionId, type])
  @@index([status, expiresAt])
  @@index([organizationId])
}

model SubscriptionFixedChargeUnitsOverride {
  id String @id @default(uuid())
  organizationId String @map("organization_id")
  organization Organization @relation(fields: [organizationId], references: [id])
  subscriptionId String @map("subscription_id")
  subscription Subscription @relation(fields: [subscriptionId], references: [id])
  fixedChargeId String @map("fixed_charge_id")
  fixedCharge FixedCharge @relation(fields: [fixedChargeId], references: [id])
  units Float @default(0.0)
  deletedAt DateTime? @map("deleted_at")
  createdAt DateTime @map("created_at")
  updatedAt DateTime @map("updated_at")

  @@index([fixedChargeId])
  @@index([organizationId])
  @@index([subscriptionId])
  @@index([deletedAt])
}

model SubscriptionRateCard {
  id String @id @default(uuid())
  organizationId String @map("organization_id")
  organization Organization @relation(fields: [organizationId], references: [id])
  subscriptionId String @map("subscription_id")
  subscription Subscription @relation(fields: [subscriptionId], references: [id])
  rateCardId String @map("rate_card_id")
  rateCard RateCard @relation(fields: [rateCardId], references: [id])
  billingAnchorDate DateTime @map("billing_anchor_date")
  nextBillingAt DateTime @map("next_billing_at")
  startedAt DateTime @map("started_at")
  endedAt DateTime? @map("ended_at")
  units Float?
  deletedAt DateTime? @map("deleted_at")
  createdAt DateTime @map("created_at")
  updatedAt DateTime @map("updated_at")

  @@check("((endedAt IS NULL) OR (startedAt <= endedAt))")
  @@index([deletedAt])
  @@index([nextBillingAt])
  @@index([organizationId])
  @@index([rateCardId])
  @@index([subscriptionId])
}

model SubscriptionsInvoiceCustomSection {
  id String @id @default(uuid())
  organizationId String @map("organization_id")
  organization Organization @relation(fields: [organizationId], references: [id])
  subscriptionId String @map("subscription_id")
  subscription Subscription @relation(fields: [subscriptionId], references: [id])
  invoiceCustomSectionId String @map("invoice_custom_section_id")
  invoiceCustomSection InvoiceCustomSection @relation(fields: [invoiceCustomSectionId], references: [id])
  createdAt DateTime @map("created_at")
  updatedAt DateTime @map("updated_at")

  @@index([invoiceCustomSectionId])
  @@index([organizationId])
  @@index([subscriptionId])
  @@unique([subscriptionId, invoiceCustomSectionId])
}

model UsageMonitoringAlert {
  id String @id @default(uuid())
  organizationId String @map("organization_id")
  organization Organization @relation(fields: [organizationId], references: [id])
  subscriptionExternalId String? @map("subscription_external_id")
  billableMetricId String? @map("billable_metric_id")
  billableMetric BillableMetric? @relation(fields: [billableMetricId], references: [id])
  alertType UsageMonitoringAlertTypes @map("alert_type")
  previousValue Int @map("previous_value") @scale(5) @default(0.0)
  lastProcessedAt DateTime? @map("last_processed_at")
  name String?
  code String
  deletedAt DateTime? @map("deleted_at")
  createdAt DateTime @map("created_at")
  updatedAt DateTime @map("updated_at")
  walletId String? @map("wallet_id")
  wallet Wallet? @relation(fields: [walletId], references: [id])
  direction UsageMonitoringAlertDirection

  @@arc([subscriptionExternalId, walletId])
  @@index([billableMetricId])
  @@index([organizationId])
  @@index([subscriptionExternalId])
  @@index([walletId])
}

model UsageMonitoringSubscriptionActivity {
  id Int @id
  organizationId String @map("organization_id")
  organization Organization @relation(fields: [organizationId], references: [id])
  subscriptionId String @map("subscription_id")
  subscription Subscription @relation(fields: [subscriptionId], references: [id])
  enqueued Boolean @default(false)
  insertedAt DateTime @map("inserted_at") @default(now())
  enqueuedAt DateTime? @map("enqueued_at")

  @@index([organizationId, enqueued])
  @@index([organizationId])
  @@unique([subscriptionId])
}

model UserDevice {
  id String @id @default(uuid())
  userId String @map("user_id")
