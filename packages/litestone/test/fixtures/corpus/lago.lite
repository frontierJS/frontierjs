  maxWallets Int? @map("max_wallets")
  slug String
  paginationMaxPageSize Int? @map("pagination_max_page_size")
  documentUrlExpirationDays Int @map("document_url_expiration_days") @default(30)
  customerPortalLockedFields String[] @map("customer_portal_locked_fields")
  selfServe Boolean @map("self_serve") @default(false)
  environment OrganizationEnvironment @default(production)
  productionOrganizationId String? @map("production_organization_id")
  productionOrganization Organization? @relation(fields: [productionOrganizationId], references: [id])
  activationStatus OrganizationActivationStatus @map("activation_status") @default(active)

  @@check("((activationStatus = 'active') OR (selfServe AND (environment = 'production')))")
  @@check("(((environment = 'production') AND (productionOrganizationId IS NULL)) OR ((environment = 'sandbox') AND (productionOrganizationId IS NOT NULL)))")
  @@check("(invoiceGracePeriod >= 0)")
  @@check("(netPaymentTerm >= 0)")
  @@check("((productionOrganizationId IS NULL) OR (productionOrganizationId <> id))")
  @@unique([apiKey])
  @@unique([hmacKey])
  @@unique([productionOrganizationId])
  @@unique([slug])
}

