model Customer {
  id String @id @default(uuid())
  externalId String @map("external_id")
  name String?
  organizationId String @map("organization_id")
  organization Organization @relation(fields: [organizationId], references: [id])
  createdAt DateTime @map("created_at")
  updatedAt DateTime @map("updated_at")
  country String?
  addressLine1 String? @map("address_line1")
  addressLine2 String? @map("address_line2")
  state String?
  zipcode String?
  email String?
  city String?
  url String?
  phone String?
  logoUrl String? @map("logo_url")
  legalName String? @map("legal_name")
  legalNumber String? @map("legal_number")
  vatRate Float? @map("vat_rate")
  paymentProvider String? @map("payment_provider")
  slug String?
  sequentialId Int? @map("sequential_id") @big
  currency String?
  invoiceGracePeriod Int? @map("invoice_grace_period")
  timezone String?
  deletedAt DateTime? @map("deleted_at")
  documentLocale String? @map("document_locale")
  taxIdentificationNumber String? @map("tax_identification_number")
  netPaymentTerm Int? @map("net_payment_term")
  externalSalesforceId String? @map("external_salesforce_id")
  paymentProviderCode String? @map("payment_provider_code")
  shippingAddressLine1 String? @map("shipping_address_line1")
  shippingAddressLine2 String? @map("shipping_address_line2")
  shippingCity String? @map("shipping_city")
  shippingZipcode String? @map("shipping_zipcode")
  shippingState String? @map("shipping_state")
  shippingCountry String? @map("shipping_country")
  finalizeZeroAmountInvoice Int @map("finalize_zero_amount_invoice") @default(0)
  firstname String?
  lastname String?
  customerType CustomerType? @map("customer_type")
  appliedDunningCampaignId String? @map("applied_dunning_campaign_id")
  appliedDunningCampaign DunningCampaign? @relation(fields: [appliedDunningCampaignId], references: [id])
  excludeFromDunningCampaign Boolean @map("exclude_from_dunning_campaign") @default(false)
  lastDunningCampaignAttempt Int @map("last_dunning_campaign_attempt") @default(0)
  lastDunningCampaignAttemptAt DateTime? @map("last_dunning_campaign_attempt_at")
  skipInvoiceCustomSections Boolean @map("skip_invoice_custom_sections") @default(false)
  accountType CustomerAccountType @map("account_type") @default(customer)
  billingEntityId String @map("billing_entity_id")
  billingEntity BillingEntity @relation(fields: [billingEntityId], references: [id])
  paymentReceiptCounter Int @map("payment_receipt_counter") @default(0) @big
  subscriptionInvoiceIssuingDateAnchor SubscriptionInvoiceIssuingDateAnchors? @map("subscription_invoice_issuing_date_anchor")
  subscriptionInvoiceIssuingDateAdjustment SubscriptionInvoiceIssuingDateAdjustments? @map("subscription_invoice_issuing_date_adjustment")
  awaitingWalletRefresh Boolean @map("awaiting_wallet_refresh") @default(false)
  dunningCurrencyAttempts Json @map("dunning_currency_attempts")
  paymentTerm Json? @map("payment_term")
  x402AgentAddress String? @map("x402_agent_address")

  @@check("(invoiceGracePeriod >= 0)")
  @@check("(netPaymentTerm >= 0)")
  @@index([organizationId, createdAt, id])
  @@index([accountType])
  @@index([appliedDunningCampaignId])
  @@index([awaitingWalletRefresh])
  @@index([billingEntityId])
  @@index([deletedAt])
  @@index([organizationId, externalId])
  @@unique([externalId, organizationId], where: deletedAt == null)
  @@index([organizationId], where: deletedAt == null)
  @@index([sequentialId])
}

