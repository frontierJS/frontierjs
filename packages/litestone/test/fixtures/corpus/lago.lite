model TemplatePublicEnrichedEvent {
  id String @id
  organizationId String @map("organization_id")
  eventId String @map("event_id")
  transactionId String @map("transaction_id")
  externalSubscriptionId String @map("external_subscription_id")
  code String
  timestamp DateTime
  subscriptionId String @map("subscription_id")
  planId String @map("plan_id")
  chargeId String @map("charge_id")
  chargeFilterId String? @map("charge_filter_id")
  properties Json
  groupedBy Json @map("grouped_by")
  value String?
  decimalValue Float @map("decimal_value")
  enrichedAt DateTime @map("enriched_at")
}

model ActiveStorageAttachment {
  id String @id @default(uuid())
  name String
  recordType String @map("record_type")
  blobId String @map("blob_id")
  blob ActiveStorageBlob @relation(fields: [blobId], references: [id])
  createdAt DateTime @map("created_at")
  recordId String? @map("record_id")

  @@index([blobId])
  @@unique([recordType, recordId, name, blobId], nullsDistinct: true)
}

model ActiveStorageBlob {
  id String @id @default(uuid())
  key String
  filename String
  contentType String? @map("content_type")
  metadata String?
  serviceName String @map("service_name")
  byteSize Int @map("byte_size")
  checksum String?
  createdAt DateTime @map("created_at")

  @@unique([key])
}

model ActiveStorageVariantRecord {
  id String @id @default(uuid())
  blobId String @map("blob_id")
  blob ActiveStorageBlob @relation(fields: [blobId], references: [id])
  variationDigest String @map("variation_digest")

  @@unique([blobId, variationDigest])
}

