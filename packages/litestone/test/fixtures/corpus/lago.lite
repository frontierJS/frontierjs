model TemplatePublicEnrichedEvent {
  id String @id
  organizationId String @map("organization_id")
  eventId String @map("event_id")
  transactionId String @map("transaction_id")
  externalSubscriptionId String @map("external_subscription_id")
  code String
  timestamp DateTime
  subscriptionId String @map("subscription_id")
  planId String @map("plan_id")
  chargeId String @map("charge_id")
  chargeFilterId String? @map("charge_filter_id")
  properties Json
  groupedBy Json @map("grouped_by")
  value String?
  decimalValue Float @map("decimal_value")
  enrichedAt DateTime @map("enriched_at")
}

model ActiveStorageAttachment {
  id String @id @default(uuid())
  name String
  recordType String @map("record_type")
  blobId String @map("blob_id")
  blob ActiveStorageBlob @relation(fields: [blobId], references: [id])
  createdAt DateTime @map("created_at")
  recordId String? @map("record_id")

  @@index([blobId])
  @@unique([recordType, recordId, name, blobId], nullsDistinct: true)
}

model ActiveStorageBlob {
  id String @id @default(uuid())
  key String
  filename String
  contentType String? @map("content_type")
  metadata String?
  serviceName String @map("service_name")
  byteSize Int @map("byte_size") @big
  checksum String?
  createdAt DateTime @map("created_at")

  @@unique([key])
}

model ActiveStorageVariantRecord {
  id String @id @default(uuid())
  blobId String @map("blob_id")
  blob ActiveStorageBlob @relation(fields: [blobId], references: [id])
  variationDigest String @map("variation_digest")

  @@unique([blobId, variationDigest])
}

model AddOn {
  id String @id @default(uuid())
  organizationId String @map("organization_id")
  organization Organization @relation(fields: [organizationId], references: [id])
  name String
  code String
  description String?
  amountCents Int @map("amount_cents") @big
  amountCurrency String @map("amount_currency")
  createdAt DateTime @map("created_at")
  updatedAt DateTime @map("updated_at")
  deletedAt DateTime? @map("deleted_at")
  invoiceDisplayName String? @map("invoice_display_name")

  @@index([deletedAt])
  @@index([organizationId])
  @@unique([organizationId, code], where: deletedAt == null)
}

model AddOnsTax {
  id String @id @default(uuid())
  addOnId String @map("add_on_id")
  addOn AddOn @relation(fields: [addOnId], references: [id])
  taxId String @map("tax_id")
  tax Tax @relation(fields: [taxId], references: [id])
  createdAt DateTime @map("created_at")
  updatedAt DateTime @map("updated_at")
  organizationId String @map("organization_id")
  organization Organization @relation(fields: [organizationId], references: [id])

  @@index([addOnId])
  @@unique([addOnId, taxId])
  @@index([organizationId])
  @@index([taxId])
}

model AdjustedFee {
  id String @id @default(uuid())
  feeId String? @map("fee_id")
  fee Fee? @relation(fields: [feeId], references: [id])
  invoiceId String @map("invoice_id")
  invoice Invoice @relation(fields: [invoiceId], references: [id])
  subscriptionId String? @map("subscription_id")
  subscription Subscription? @relation(fields: [subscriptionId], references: [id])
  chargeId String? @map("charge_id")
  charge Charge? @relation(fields: [chargeId], references: [id])
  invoiceDisplayName String? @map("invoice_display_name")
  feeType Int? @map("fee_type")
  adjustedUnits Boolean @map("adjusted_units") @default(false)
  adjustedAmount Boolean @map("adjusted_amount") @default(false)
  units Float @default(0.0)
  unitAmountCents Int @map("unit_amount_cents") @default(0) @big
  properties Json
  createdAt DateTime @map("created_at")
  updatedAt DateTime @map("updated_at")
  groupId String? @map("group_id")
  group Group? @relation(fields: [groupId], references: [id])
  groupedBy Json @map("grouped_by")
  chargeFilterId String? @map("charge_filter_id")
  unitPreciseAmountCents Float @map("unit_precise_amount_cents") @default(0.0)
  organizationId String @map("organization_id")
  organization Organization @relation(fields: [organizationId], references: [id])
  fixedChargeId String? @map("fixed_charge_id")
  fixedCharge FixedCharge? @relation(fields: [fixedChargeId], references: [id])

  @@index([chargeFilterId])
  @@index([chargeId])
  @@index([feeId])
  @@index([groupId])
  @@index([invoiceId])
  @@index([organizationId])
  @@index([subscriptionId])
}

model AgentClaim {
  id String @id @default(uuid())
  organizationId String @map("organization_id")
  organization Organization @relation(fields: [organizationId], references: [id])
  registrationId String @map("registration_id")
  registration AgentRegistration @relation(fields: [registrationId], references: [id], onDelete: Cascade)
  status AgentClaimStatus @default(issued)
  codeHash String @map("code_hash")
  email String?
  verificationCodeHash String? @map("verification_code_hash")
  verificationExpiresAt DateTime? @map("verification_expires_at")
  verifiedAt DateTime? @map("verified_at")
  createdAt DateTime @map("created_at")
  updatedAt DateTime @map("updated_at")
  emailHash String? @map("email_hash")

  @@check("((status <> 'verified') OR (verifiedAt IS NOT NULL))")
  @@unique([codeHash])
  @@index([organizationId])
  @@index([registrationId])
}

model AgentFreeCreditGrant {
  id String @id @default(uuid())
  organizationId String @map("organization_id")
  organization Organization @relation(fields: [organizationId], references: [id])
  integrationId String @map("integration_id")
  integration Integration @relation(fields: [integrationId], references: [id])
  registrationId String @map("registration_id")
  registration AgentRegistration @relation(fields: [registrationId], references: [id], onDelete: Cascade)
  walletTransactionId String? @map("wallet_transaction_id")
  walletTransaction WalletTransaction? @relation(fields: [walletTransactionId], references: [id])
  emailHash String @map("email_hash")
  amountCents Int @map("amount_cents") @big
  createdAt DateTime @map("created_at")
  updatedAt DateTime @map("updated_at")

  @@unique([integrationId, emailHash])
  @@index([organizationId])
  @@index([registrationId])
  @@index([walletTransactionId])
}

model AgentRegistration {
  id String @id @default(uuid())
  organizationId String @map("organization_id")
  organization Organization @relation(fields: [organizationId], references: [id])
  integrationId String @map("integration_id")
