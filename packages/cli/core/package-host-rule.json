{
  "phase": "http_request_dynamic_redirect",
  "zone": "frontierjs.com",
  "dns": { "type": "AAAA", "name": "packages", "content": "100::", "proxied": true },
  "rule": {
    "description": "packages.frontierjs.com/<tag>/<stem>-<version>.tgz mirrors the GitHub release path (FJS-D1620)",
    "expression": "(http.host eq \"packages.frontierjs.com\")",
    "action": "redirect",
    "action_parameters": {
      "from_value": {
        "status_code": 302,
        "target_url": {
          "expression": "concat(\"https://github.com/frontierJS/frontierjs/releases/download\", http.request.uri.path)"
        },
        "preserve_query_string": false
      }
    },
    "enabled": true
  }
}
