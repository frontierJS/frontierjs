<script>
  // The fixture Dock — a REAL Mesa component.
  //
  // It used to be plain JavaScript in a `.mesa` file, which built only because
  // the compiler was never found and the plugin fell through to stub mode. So
  // jetty's Mesa path was not exercised by anything, and the bug that hid it —
  // a compiler lookup that probed two fixed directories and never walked up —
  // survived every run of this suite. Keep this file Mesa: it is the only thing
  // here that compiles.
  //
  // It has no connection of its own. `harbor` is the port to the service
  // worker, supplied by auto-gen, and every call goes through it.
  import { createResource, login, logout, getConnectionState } from '@frontierjs/jetty/resources'

  export let harbor = null

  const CYCLE = ['active', 'pending', 'inactive']

  let status   = harbor ? 'connected' : 'no harbor'
  let session  = getConnectionState()
  let leads    = []
  let messages = []
  let email    = 'demo@example.com'
  let password = ''
  let error    = ''

  const leadsResource = createResource('leads', {
    hooks: {
      around: {
        all: [async (ctx, next) => {
          status = `…${ctx.method}`
          await next()
          status = 'ok'
        }],
      },
    },
  })

  leadsResource.store.subscribe((rows) => { leads = [...(rows ?? [])] })

  if (harbor) {
    harbor.on('session', (p) => {
      status  = 'session ✓'
      session = { authenticated: p?.authenticated, user: p?.user }
    })
    harbor.on('hello-from-run', (p) => { messages = [...messages, p?.message ?? ''] })
    harbor.onDisconnect(() => status = 'disconnected')
    harbor.onReconnect(()  => status = 'reconnected')
  }

  async function attempt(fn) {
    try { await fn() } catch (e) { status = `err: ${e.message}` }
  }

  const doLogin  = () => attempt(async () => { error = ''; await login({ email, password }) })
                          .catch(e => error = e.message)
  const doLogout = () => attempt(() => logout())
  const load     = () => attempt(() => leadsResource.load())
  const add      = () => attempt(() => leadsResource.service.create({
    name: `New Lead ${leads.length + 1}`, status: 'new', ownerId: 1,
  }))
  const cycle    = (row) => attempt(() => leadsResource.service.patch(row.id, {
    status: CYCLE[(CYCLE.indexOf(row.status) + 1) % CYCLE.length],
  }))
  const drop     = (row) => attempt(() => leadsResource.service.remove(row.id))
</script>

<div class="dock">
  <h1>Fixture Dock — Resources</h1>

  <div class="meta">
    <div>Status: <code>{status}</code></div>
    <div>User: <code>{session?.authenticated ? (session.user?.name ?? session.user?.email) : '—'}</code></div>
  </div>

  {#if session?.authenticated}
    <button onclick={doLogout}>Logout</button>
  {:else}
    <div class="login">
      <input bind:value={email} placeholder="email" />
      <input bind:value={password} type="password" placeholder="password (try: demo)" />
      <button onclick={doLogin}>Login</button>
      <span class="error">{error}</span>
    </div>
  {/if}

  <div class="bar">
    <strong>Leads</strong>
    <button onclick={load}>Load</button>
    <button onclick={add}>+ Add</button>
  </div>

  <div class="leads">
    {#each leads as row (row.id)}
      <div class="lead">
        <span><strong>{row.name}</strong> — {row.status}</span>
        <button onclick={() => cycle(row)}>cycle</button>
        <button onclick={() => drop(row)}>×</button>
      </div>
    {:else}
      <div class="empty">No leads loaded</div>
    {/each}
  </div>

  {#each messages as message, i (i)}
    <div class="message">📨 {message}</div>
  {/each}
</div>

<style>
  .dock    { font: 14px system-ui, sans-serif; padding: 1rem; min-width: 380px; }
  h1       { font-size: 1.1rem; margin: 0 0 0.5rem; }
  .meta    { display: grid; gap: 0.25rem; font-size: 0.85rem; padding-bottom: 0.5rem;
             margin-bottom: 0.75rem; border-bottom: 1px solid #ccc; }
  code     { background: #eee; padding: 2px 6px; border-radius: 3px; }
  .login   { display: grid; gap: 4px; margin-bottom: 0.75rem; }
  .error   { color: #c33; font-size: 0.85rem; }
  .bar     { display: flex; gap: 0.4rem; align-items: center; margin-bottom: 0.5rem; }
  .leads   { border: 1px solid #ddd; border-radius: 4px; min-height: 80px;
             max-height: 200px; overflow-y: auto; font-size: 0.85rem; }
  .lead    { display: flex; align-items: center; gap: 4px; padding: 4px 8px;
             border-bottom: 1px solid #eee; }
  .lead span { flex: 1; }
  .empty   { padding: 0.5rem; color: #999; }
  .message { margin-top: 0.5rem; padding: 6px 10px; background: #eef; border-radius: 4px; }
</style>
