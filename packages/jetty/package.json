{
  "name": "@frontierjs/jetty",
  "version": "0.0.3",
  "description": "Browser extension framework for FrontierJS. MV3, Mesa runtime.",
  "type": "module",
  "main": "./src/index.js",
  "exports": {
    ".": "./src/index.js",
    "./browser": "./src/browser/index.js",
    "./runtime": "./src/runtime/index.js",
    "./resources": "./src/resources/index.js",
    "./island": "./src/island/index.js",
    "./audit": "./src/audit/index.js"
  },
  "bin": {
    "jetty-build-ext": "./bin/build-ext.js",
    "jetty-dev-ext": "./bin/dev-ext.js",
    "jetty-info": "./bin/info.js",
    "jetty-audit": "./bin/audit.js",
    "jetty-manifest": "./bin/manifest.js"
  },
  "files": [
    "src",
    "bin",
    "docs",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build:fixture": "node bin/build-ext.js --root=test/fixtures/basic-ext --browser=chrome",
    "build:fixture:firefox": "node bin/build-ext.js --root=test/fixtures/basic-ext --browser=firefox",
    "build:fixture:both": "node bin/build-ext.js --root=test/fixtures/basic-ext --browser=both",
    "dev:fixture": "node bin/dev-ext.js --root=test/fixtures/basic-ext --browser=chrome --verbose",
    "dev:fixture:both": "node bin/dev-ext.js --root=test/fixtures/basic-ext --browser=both --verbose",
    "test:phase0": "node test/phase0.test.js",
    "test:phase1": "node test/phase1.test.js",
    "test:phase2": "node test/phase2.test.js",
    "test:phase2.5": "node test/phase2.5.test.js",
    "test:phase3": "node test/phase3.test.js",
    "test:phase4": "node test/phase4.test.js",
    "test:phase5": "node test/phase5.test.js",
    "test:phase6": "node test/phase6.test.js",
    "test:phase7": "node test/phase7.test.js",
    "test": "node test/phase0.test.js && node test/phase1.test.js && node test/phase2.test.js && node test/phase2.5.test.js && node test/phase3.test.js && node test/phase4.test.js && node test/phase5.test.js && node test/phase6.test.js && node test/phase7.test.js && node test/phase8.test.js",
    "test:bun:phase0": "bun test/phase0.test.js",
    "test:bun:phase1": "bun test/phase1.test.js",
    "test:bun:phase2": "bun test/phase2.test.js",
    "test:bun:phase2.5": "bun test/phase2.5.test.js",
    "test:bun:phase3": "bun test/phase3.test.js",
    "test:bun:phase4": "bun test/phase4.test.js",
    "test:bun:phase5": "bun test/phase5.test.js",
    "test:bun:phase6": "bun test/phase6.test.js",
    "test:bun:phase7": "bun test/phase7.test.js",
    "test:bun": "bun test/phase0.test.js && bun test/phase1.test.js && bun test/phase2.test.js && bun test/phase2.5.test.js && bun test/phase3.test.js && bun test/phase4.test.js && bun test/phase5.test.js && bun test/phase6.test.js && bun test/phase7.test.js && bun test/phase8.test.js",
    "test:phase8": "node test/phase8.test.js",
    "test:bun:phase8": "bun test/phase8.test.js",
    "typecheck": "node ../../scripts/typecheck.mjs"
  },
  "dependencies": {
    "@frontierjs/toolbelt": "workspace:*",
    "chokidar": "^5.0.0",
    "vite": "^8.0.10",
    "ws": "^8.20.0"
  },
  "peerDependencies": {
    "@frontierjs/mesa": "^0.1.0",
    "@frontierjs/junction": "^0.1.0"
  },
  "peerDependenciesMeta": {
    "@frontierjs/mesa": {
      "optional": true
    },
    "@frontierjs/junction": {
      "optional": true
    }
  },
  "optionalDependencies": {
    "@frontierjs/mesa": "file:../mesa",
    "@frontierjs/junction": "file:../junction"
  },
  "engines": {
    "node": ">=20"
  },
  "devDependencies": {
    "@frontierjs/junction": "workspace:*",
    "@frontierjs/mesa": "workspace:*",
    "fake-indexeddb": "^6.2.5",
    "jsdom": "^29.1.1"
  },
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/frontierJS/frontierjs.git",
    "directory": "packages/jetty"
  }
}
