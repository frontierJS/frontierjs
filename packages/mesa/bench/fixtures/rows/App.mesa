<script>
  import * as ops from '../shared/data.js'

  // ── State ──────────────────────────────────────────────────────────────────
  //
  // rows     — the current list, replaced (never mutated) by every operation.
  // selected — the highlighted row's id, 0 for none. One scalar, as the
  //            js-framework-benchmark rules require: a per-row flag is refused.

  let rows     = []
  let selected = 0

  // The first six ids are js-framework-benchmark's and the runner clicks them
  // by id; the rest are the keyed reorders `../shared/data.js` defines.
  const buttons = [
    { id: 'run',           label: 'Create 1,000 rows',     fn: () => { rows = ops.run(); selected = 0 } },
    { id: 'runlots',       label: 'Create 10,000 rows',    fn: () => { rows = ops.runLots(); selected = 0 } },
    { id: 'add',           label: 'Append 1,000 rows',     fn: () => { rows = ops.add(rows) } },
    { id: 'update',        label: 'Update every 10th row', fn: () => { rows = ops.update(rows) } },
    { id: 'clear',         label: 'Clear',                 fn: () => { rows = ops.clear(); selected = 0 } },
    { id: 'swaprows',      label: 'Swap Rows',             fn: () => { rows = ops.swapRows(rows) } },
    { id: 'reverse',       label: 'Reverse',               fn: () => { rows = ops.reverse(rows) } },
    { id: 'shuffle',       label: 'Shuffle',               fn: () => { rows = ops.shuffle(rows) } },
    { id: 'rotate',        label: 'Rotate',                fn: () => { rows = ops.rotate(rows) } },
    { id: 'prepend100',    label: 'Prepend 100',           fn: () => { rows = ops.prepend100(rows) } },
    { id: 'insertmid100',  label: 'Insert 100 mid',        fn: () => { rows = ops.insertMid100(rows) } },
    { id: 'removefirst',   label: 'Remove first',          fn: () => { rows = ops.removeFirst(rows) } },
    { id: 'removeevery10', label: 'Remove every 10th',     fn: () => { rows = ops.removeEvery10(rows) } },
  ]

  function select(id) {
    selected = id
  }

  function remove(id) {
    rows = ops.remove(rows, id)
  }
</script>

<div id="main">
  <div class="container">

    <div class="jumbotron">
      <div class="row">
        <div class="col-md-6">
          <h1>Mesa keyed</h1>
        </div>
        <div class="col-md-6">
          <div class="row">
            {#each buttons as b (b.id)}
              <div class="col-sm-6 smallpad">
                <button type="button" class="btn btn-primary btn-block" id={b.id} on:click={b.fn}>{b.label}</button>
              </div>
            {/each}
          </div>
        </div>
      </div>
    </div>

    <table class="table table-hover table-striped test-data">
      <tbody>
        {#each rows as row (row.id)}
          <tr data-id={row.id} class:danger={selected === row.id}>
            <td class="col-md-1">{row.id}</td>
            <td class="col-md-4">
              <a class="lbl" on:click={() => select(row.id)}>{row.label}</a>
            </td>
            <td class="col-md-1">
              <a class="remove" on:click={() => remove(row.id)}>
                <span class="glyphicon glyphicon-remove" aria-hidden="true"></span>
              </a>
            </td>
            <td class="col-md-6"></td>
          </tr>
        {/each}
      </tbody>
    </table>

    <span class="preloadicon glyphicon glyphicon-remove" aria-hidden="true"></span>

  </div>
</div>
