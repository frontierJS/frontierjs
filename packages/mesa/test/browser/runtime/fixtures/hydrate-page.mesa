<script>
  import Kid from './hydrate-kid.mesa'
  import Shell from './hydrate-shell.mesa'
  $context.theme = 'dark'
  let n = 2
  let show = true
  let items = [{ id: 'a', t: 'x' }, { id: 'b', t: 'y' }]
  const add = () => { items = [...items, { id: 'c', t: 'z' }] }
</script>
<h1 data-tag="static">Static</h1>
<p data-tag="count" class:on={n > 2}>Hello {n} and {n * 2}</p>
<button id="inc" data-tag="inc" onclick={() => n++}>go</button>
<ul data-tag="list">{#each items as it (it.id)}<li data-tag={"row-" + it.id}>{it.t}</li>{/each}</ul>
<button id="add" onclick={add}>add</button>
<div>{#if show}<b data-tag="branch">shown</b>{/if}</div>
<button id="flip" onclick={() => show = !show}>flip</button>
<section><Kid /></section>
<Shell><span data-tag="slotted">in {n}</span></Shell>
