<script>
  // The DOM's dirty flag — `el.checked` and `el.value` stop tracking their
  // attribute the moment either is written to, so removing the attribute is
  // not what turns a control off.
  //
  // Reachable only in a real browser: happy-dom has no dirty flag, so every
  // assertion here passes against a runtime that only calls removeAttribute.
  let on   = false
  // `null`, not `''` — an empty string is a value and takes the ordinary
  // property path. Only a null/false binding reaches the branch that removes
  // the attribute, which is the one that has to reset the property too.
  let text = 'seeded'
</script>

<input id="box" type="checkbox" checked={on} />
<input id="field" type="text" value={text} />

<button type="button" id="on"    on:click={() => { on = true }}>on</button>
<button type="button" id="off"   on:click={() => { on = false }}>off</button>
<button type="button" id="clear" on:click={() => { text = null }}>clear</button>

<!-- ARIA: `false` is a statement, not an absence. -->
<button id="aria" aria-expanded={on} aria-selected={on} aria-hidden={null} aria-label={on ? 'on' : false}>aria</button>

<output id="state">{String(on)}</output>
