<script>
  // namespaced-attributes.mesa — `xlink:` and `xml:` are real namespaces.
  //
  // `setAttribute('xlink:href', …)` makes an attribute whose literal NAME holds
  // a colon, in no namespace. Chrome renders the icon anyway, which is why this
  // survived; an XHTML document or a standalone `.svg` does not, and there the
  // reference is simply absent.
  //
  // Asserted in a browser because happy-dom normalizes the colon form INTO the
  // namespace on its own, so under it the bug and the fix look identical.
  let target = '#one'

  function swap() { target = '#two' }
</script>

<svg id="sprite" width="0" height="0" style="position:absolute">
  <symbol id="one"><rect width="10" height="10" /></symbol>
  <symbol id="two"><circle cx="5" cy="5" r="5" /></symbol>
</svg>

<svg id="icon" width="10" height="10">
  <use id="use" xlink:href={target} />
</svg>

<svg id="labelled" width="10" height="10">
  <text id="text" xml:lang="en">hi</text>
</svg>

<svg id="invented" width="10" height="10">
  <text id="other" foo:bar="x">hi</text>
</svg>

<button id="swap" on:click={swap}>swap</button>
