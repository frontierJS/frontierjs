<script>
  let dlg
  let side
  let doomed
  let closes = 0
  let cancels = 0
  let rv = ''
  let keys = ''
  let extra = 0
  let locked = false
  let alive = true
  let listening = true
</script>

<p>closes {closes} cancels {cancels} rv {rv} extra {extra}</p>
<p>keys {keys}</p>
<div>
  <button type="button" onclick={() => dlg.showModal()}>Open</button>
  <button type="button" onclick={() => side.show()}>Side</button>
  <button type="button" onclick={() => doomed.showModal()}>Doom</button>
  <button type="button" onclick={() => listening = false}>Mute</button>
</div>
<dialog
  bind:this={dlg}
  onclose={() => { closes++; rv = dlg.returnValue }}
  oncancel={(e) => { cancels++; if (locked) e.preventDefault() }}
  onclick={(e) => { if (e.target === dlg) dlg.close('backdrop') }}
>
  <p>Modal body</p>
  <button type="button" onclick={() => locked = !locked}>Lock</button>
  <button type="button" onclick={() => dlg.close('done')}>Done</button>
</dialog>
<dialog bind:this={side}>
  <p>Side body</p>
  <button type="button" onclick={() => side.close()}>Hide</button>
</dialog>
{#if alive}
  <section>
    <dialog bind:this={doomed}>
      <p>Doomed body</p>
      <button type="button" onclick={() => alive = false}>Kill</button>
    </dialog>
  </section>
{/if}
<p>Behind the dialogs</p>
{#each [1, 2, 3, 4, 5, 6] as n}
  <p>{'.'.repeat(48)}</p>
{/each}
<mesa:window onkeydown={(e) => keys += e.key === 'Escape' ? 'E' : e.key.length === 1 ? e.key : ''} />
{#if listening}
  <mesa:window onkeydown={() => extra++} />
{/if}
