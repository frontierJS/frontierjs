<script>
  let log = []
  let open = false
  let box = null
  const note = (s) => { log = [...log, s].slice(-6) }
  const away = (e) => { if (box && !box.contains(e.target)) open = false }
</script>

<mesa:window onclick|capture={away} />
<p>log {log.join(' ')}</p>
<p>open {open}</p>
<div onfocusin={(e) => note('in:' + e.target.name)} onfocusout={(e) => note('out:' + e.target.name)}>
  <input name="a" onfocus={() => note('focus:a')} onblur={() => note('blur:a')} />
  <input name="b" />
</div>
<input name="c" />
<div bind:this={box}>
  <button onclick={() => open = true}>show</button>
  {#if open}<button onclick={() => note('inner')}>inner</button>{/if}
</div>
<button onclick={() => note('elsewhere')}>outside</button>
