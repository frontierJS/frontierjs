<script>
  let hidden = true
  let gap = 1
  const flip = () => { hidden = !hidden; gap++ }
</script>
<div style:gap={gap} style:flex-direction="row">
  <p style:display={hidden ? 'none' : null} style:visibility="hidden">Shown</p>
  <button on:click={flip} style:padding="{gap}ch">Flip</button>
  <p>hidden: {hidden}</p>
</div>
