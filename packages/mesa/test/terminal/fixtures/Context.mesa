<script>
  import Provide from './Provide.mesa'
  import Hear from './Hear.mesa'
  let on = false
  let items = ['x']
</script>
<button onclick={() => { on = true; items = ['x', 'a'] }}>open</button>
<button onclick={() => items = []}>empty</button>
<Provide {on} {items}><Hear where="slot" /></Provide>
