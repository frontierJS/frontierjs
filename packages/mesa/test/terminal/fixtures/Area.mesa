<script>
  let heard = '-'
  let inputs = 0
  let changed = '-'
  let submits = 0
  let start = '-'
  let note = 'x'
  let writes = 0
  let typed = '-'

  const onInput = (e) => { inputs++; heard = JSON.stringify(e.target.value) }
  const onChange = (e) => { changed = JSON.stringify(e.target.value) }
  const onNote = (e) => { writes++; note = e.target.value; typed = JSON.stringify(note) }
  const set = () => { note = 'p\nq' }
</script>

<p>heard {heard} inputs {inputs}</p>
<p>changed {changed} submits {submits}</p>
<p>start {start} writes {writes} typed {typed}</p>
<form onsubmit|preventDefault={() => submits++} oninput={onInput} onchange={onChange}>
  <textarea name="t" onclick={() => {}}></textarea>
  <button>Save</button>
</form>
<textarea name="s" onfocus={(e) => start = JSON.stringify(e.target.value)}>
first
second</textarea>
<button type="button" onclick={set}>Set</button>
<textarea name="n" value={note} oninput={onNote}></textarea>
