<script>
  let value = ''
  let held = 0
  let moved = 0
  let around = 0
  let target = '-'
  let row = 0
  let scrolls = 0
  let kept = 'kept'
  let start = '-'
  let drops = 0

  const hold = (e) => e.preventDefault()
  const heard = (e) => { around++; target = e.target.__tag }
</script>

<p>value {value} held {held} moved {moved}</p>
<p>around {around} target {target} row {row} scrolls {scrolls} start {start}</p>
<div onmousedown={heard}>
  <input name="a" oninput={(e) => value = e.target.value} />
  <button type="button" onmousedown={hold} onclick={() => held++}>Hold</button>
  <button type="button" onclick={() => moved++}>Move</button>
</div>
<p onmousedown={() => row++} ontouchstart={() => row += 10}>Row</p>
<div ondrop={() => drops++}>
  <p ondragenter={() => drops++} ondragover|preventDefault={() => drops++} ondragleave={() => drops++}>Drop drops {drops}</p>
</div>
<textarea name="t" onscroll={() => scrolls++} onfocus={(e) => start = JSON.stringify(e.target.value)}>one</textarea>
<textarea name="v" value={kept}>{kept}</textarea>
