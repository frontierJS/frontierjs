<script>
  let log = []
  let late = false
  const note = (s) => { log = [...log, s].slice(-4) }
</script>

<mesa:window onkeydown={(e) => { if (e.key === 'l') late = !late }} />
<p>log {log.join(' ')}</p>
<div onmouseenter={() => note('+box')} onmouseleave={() => note('-box')}>
  <p onmouseenter={() => note('+a')} onmouseleave={() => note('-a')}>alpha</p>
  <p onmouseenter={() => note('+b')} onmouseleave={(e) => note('-b>' + (e.relatedTarget?.__tag ?? 'none'))}>bravo</p>
  <p>charlie</p>
</div>
<p>see <a href="/x" onmouseenter={() => note('+link')} onmouseleave={() => note('-link')}>docs</a> here</p>
{#if late}<p onmouseenter={() => note('+late')}>arrival</p>{/if}
<p>floor</p>
