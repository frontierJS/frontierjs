<script>
  let rows = ['ann', 'bo', 'cy']
  let active = -1
  let moves = 0
  let heard = 0
  let picked = '-'
</script>

<p>active {active} moves {moves} heard {heard} picked {picked}</p>
<ul onmousemove={() => heard++}>
  {#each rows as row, i}
    <li onmousemove={() => { moves++; if (active !== i) active = i }} onclick={() => picked = row}>{i === active ? '>' : '-'} {row}</li>
  {/each}
</ul>
