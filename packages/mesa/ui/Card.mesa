<script>
  export let title    = null
  export let subtitle = null
  export let pad      = '20px'
  export let shadow   = true
  export let children = null
  export let header   = null
  export let footer   = null
</script>

<div style="
  background:#fff;
  border:1px solid #e5e7eb;
  border-radius:10px;
  padding:{pad};
  box-shadow:{shadow ? '0 1px 4px rgba(0,0,0,.06)' : 'none'};
">
  {#if header}
    {@render header?.()}
  {:else if title || subtitle}
    <div style="margin-bottom:14px">
      {#if title}
        <h3 style="margin:0 0 2px;font-size:15px;font-weight:600;color:#111827">{title}</h3>
      {/if}
      {#if subtitle}
        <p style="margin:0;font-size:13px;color:#6b7280">{subtitle}</p>
      {/if}
    </div>
  {/if}

  {@render children?.()}

  {#if footer}
    <div style="margin-top:16px;padding-top:14px;border-top:1px solid #f3f4f6">
      {@render footer?.()}
    </div>
  {/if}
</div>
