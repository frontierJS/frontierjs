{
  "name": "@frontierjs/mesa",
  "version": "0.1.3",
  "type": "module",
  "license": "MIT",
  "description": "Mesa — reactive UI language compiler and runtime",
  "main": "./src/compiler.js",
  "module": "./src/compiler.js",
  "exports": {
    ".": {
      "import": "./src/compiler.js"
    },
    "./runtime.js": {
      "import": "./src/runtime.js"
    },
    "./runtime": {
      "import": "./src/runtime.js"
    },
    "./compiler.js": {
      "import": "./src/compiler.js"
    },
    "./compiler": {
      "import": "./src/compiler.js"
    },
    "./compiler-md.js": {
      "import": "./src/compiler-md.js"
    },
    "./compiler-md": {
      "import": "./src/compiler-md.js"
    },
    "./render.js": {
      "import": "./src/render.js"
    },
    "./render": {
      "import": "./src/render.js"
    },
    "./css-inliner.js": {
      "import": "./src/css-inliner.js"
    },
    "./css-inliner": {
      "import": "./src/css-inliner.js"
    },
    "./render-component.js": {
      "import": "./src/render-component.js"
    },
    "./render-component": {
      "import": "./src/render-component.js"
    },
    "./vite": {
      "import": "./mesa-vite/index.js"
    },
    "./vite/client": {
      "import": "./mesa-vite/client.js"
    },
    "./vite/swap": {
      "import": "./mesa-vite/swap.js"
    },
    "./vite/hmr": {
      "import": "./mesa-vite/hmr.js"
    }
  },
  "scripts": {
    "test": "node test/spec-check.mjs && vitest run && node test/browser/runtime/run.mjs && node test/browser/vite/run.mjs",
    "test:watch": "vitest",
    "test:browser": "node test/browser/runtime/run.mjs && node test/browser/vite/run.mjs",
    "test:browser:runtime": "node test/browser/runtime/run.mjs",
    "test:browser:vite": "node test/browser/vite/run.mjs",
    "test:browser:repl": "node test/browser/repl/run.mjs",
    "serve:runtime": "node test/browser/runtime/run.mjs --serve",
    "serve:vite": "node test/browser/vite/run.mjs --serve",
    "serve": "npx serve ../..",
    "typecheck": "node ../../scripts/typecheck.mjs"
  },
  "dependencies": {
    "@frontierjs/toolbelt": "workspace:*",
    "acorn": "^8.0.0",
    "astring": "^1.0.0",
    "css-select": "^7.0.0",
    "css-tree": "^2.0.0",
    "css-what": "^8.0.0",
    "happy-dom": "^20.11.6",
    "rehype-slug": "^6.0.0",
    "rehype-stringify": "^10.0.1",
    "remark-gfm": "^4.0.1",
    "remark-parse": "^11.0.0",
    "remark-rehype": "^11.1.2",
    "unified": "^11.0.5"
  },
  "peerDependencies": {
    "vite": ">=4.0.0"
  },
  "peerDependenciesMeta": {
    "vite": {
      "optional": true
    }
  },
  "devDependencies": {
    "vite": "^8.0.10",
    "vitest": "^2.0.0"
  },
  "_built": "2026-05-05",
  "files": [
    "src",
    "mesa-vite",
    "README.md",
    "LICENSE"
  ],
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/frontierJS/frontierjs.git",
    "directory": "packages/mesa"
  }
}
