<script>
  // ConfirmationPopover.mesa
  // Inline confirmation before destructive actions. Appears anchored to the trigger.
  // Portaled to body — works inside overflow:hidden containers.
  //
  // Usage:
  //   <ConfirmationPopover onconfirm={deleteItem}>
  //     {#snippet trigger()}
  //       <Btn variant="danger">Delete</Btn>
  //     {/snippet}
  //   </ConfirmationPopover>
  //
  //   <ConfirmationPopover
  //     title="Remove member?"
  //     message="They will lose access immediately."
  //     confirmLabel="Remove"
  //     onconfirm={removeMember}
  //     oncancel={() => {}}
  //   >
  //     {#snippet trigger()}<Btn>Remove</Btn>{/snippet}
  //   </ConfirmationPopover>

  export let title        = 'Are you sure?'
  export let message      = 'This action cannot be undone.'
  export let confirmLabel = 'Confirm'
  export let cancelLabel  = 'Cancel'
  export let variant      = 'danger'   // 'danger' | 'warning' | 'primary'
  export let onconfirm    = undefined
  export let oncancel     = undefined
  export let trigger      = null       // snippet

  let open      = false
  let x         = 0
  let y         = 0
  let triggerEl
  let panelEl

  const variantMap = {
    danger:  'bg-red-600 hover:bg-red-700 focus-visible:ring-red-500 text-white',
    warning: 'bg-yellow-500 hover:bg-yellow-600 focus-visible:ring-yellow-400 text-white',
    primary: 'bg-blue-600 hover:bg-blue-700 focus-visible:ring-blue-500 text-white',
  }
  const confirmClass = variantMap[variant] ?? variantMap.danger

  const panelAnim = $.entrance({
    in:  el => el.animate(
      [{ opacity: 0, transform: 'scale(0.95) translateY(-4px)' },
       { opacity: 1, transform: 'scale(1) translateY(0)' }],
      { duration: 140, easing: 'cubic-bezier(0.16,1,0.3,1)', fill: 'forwards' }
    ),
    out: el => el.animate(
      [{ opacity: 1, transform: 'scale(1)' }, { opacity: 0, transform: 'scale(0.95)' }],
      { duration: 100, fill: 'forwards' }
    ).finished,
  })

  function openPopover() {
    if (open) return
    open = true
    requestAnimationFrame(position)
    document.addEventListener('click', onClickAway, { capture: true })
  }

  function position() {
    if (!triggerEl || !panelEl) return
    const tr  = triggerEl.getBoundingClientRect()
    const pr  = panelEl.getBoundingClientRect()
    const winW = window.innerWidth
    const winH = window.innerHeight

    // Prefer below trigger, flip above if clipped
    y = tr.bottom + pr.height + 8 > winH ? tr.top - pr.height - 8 : tr.bottom + 8

    // Prefer left-aligned, flip if clipped
    x = tr.left + pr.width > winW - 8 ? tr.right - pr.width : tr.left
  }

  function close() {
    open = false
    document.removeEventListener('click', onClickAway, { capture: true })
  }

  function onClickAway(e) {
    if (triggerEl?.contains(e.target) || panelEl?.contains(e.target)) return
    close()
  }

  function handleConfirm() {
    close()
    onconfirm?.()
  }

  function handleCancel() {
    close()
    oncancel?.()
  }

  $onDestroy(() => {
    document.removeEventListener('click', onClickAway, { capture: true })
  })
</script>

<mesa:window on:keydown={(e) => { if (e.key === 'Escape' && open) close() }} />

<div bind:this={triggerEl} class="inline-block" {class} on:click|stopPropagation={openPopover}>
  {@render trigger?.()}
</div>

{#if open}
  <mesa:portal to={document.body}>
    <div
      bind:this={panelEl}
      class="fixed z-[150] w-64 rounded-xl border border-gray-200 bg-white p-4
             shadow-xl outline-none"
      style:left="{x}px"
      style:top="{y}px"
      {@attach panelAnim}
      role="dialog"
      aria-modal="false"
      aria-label={title}
    >
      <p class="text-sm font-semibold text-gray-900 mb-1">{title}</p>
      {#if message}
        <p class="text-xs text-gray-500 mb-4 leading-snug">{message}</p>
      {/if}
      <div class="flex items-center justify-end gap-2">
        <button
          type="button"
          class="px-3 py-1.5 rounded-lg text-xs font-medium text-gray-600
                 hover:bg-gray-100 transition-colors
                 focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-gray-400"
          on:click={handleCancel}
        >
          {cancelLabel}
        </button>
        <button
          type="button"
          class="px-3 py-1.5 rounded-lg text-xs font-medium transition-colors
                 focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-offset-1
                 {confirmClass}"
          on:click={handleConfirm}
        >
          {confirmLabel}
        </button>
      </div>
    </div>
  </mesa:portal>
{/if}
