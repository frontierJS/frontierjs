<script>
  // Modal.mesa
  // Dialog overlay. Uses mesa:portal to escape stacking contexts.
  // Traps focus inside the panel while open. Restores focus on close.
  //
  // Usage:
  //   let open = false
  //
  //   <Button onclick={() => open = true}>Open</Button>
  //
  //   <Modal bind:open title="Confirm deletion" size="sm">
  //     <p>This action cannot be undone.</p>
  //     {#snippet footer()}
  //       <Button variant="danger" onclick={deleteItem}>Delete</Button>
  //       <Button variant="ghost" onclick={() => open = false}>Cancel</Button>
  //     {/snippet}
  //   </Modal>

  export let open     = false
  export let title    = ''
  export let size     = 'md'     // 'xs' | 'sm' | 'md' | 'lg' | 'xl' | 'full'
  export let footer   = null
  export let onclose  = undefined

  const sizeMap = {
    xs:   'max-w-xs',
    sm:   'max-w-sm',
    md:   'max-w-md',
    lg:   'max-w-lg',
    xl:   'max-w-xl',
    full: 'max-w-[calc(100vw-2rem)]',
  }
  const panelSize = sizeMap[size] ?? sizeMap.md

  // Body scroll lock
  $: open, () => {
    document.body.style.overflow = open ? 'hidden' : ''
    $onCleanup(() => { document.body.style.overflow = '' })
  }

  // Save triggering element — restore focus on close
  // var: non-reactive, DOM ref bookkeeping only
  var _previousFocus = null

  $: open, () => {
    if (open) {
      _previousFocus = document.activeElement
      requestAnimationFrame(() => panelEl?.focus())
    } else {
      _previousFocus?.focus()
    }
  }

  let panelEl

  const backdropAnim = $.entrance({
    in:  el => el.animate([{ opacity: 0 }, { opacity: 1 }], { duration: 150, fill: 'forwards' }),
    out: el => el.animate([{ opacity: 1 }, { opacity: 0 }], { duration: 120, fill: 'forwards' }).finished,
  })

  const panelAnim = $.entrance({
    in:  el => el.animate(
      [{ opacity: 0, transform: 'scale(0.95) translateY(-12px)' },
       { opacity: 1, transform: 'scale(1) translateY(0)' }],
      { duration: 220, easing: 'cubic-bezier(0.16,1,0.3,1)', fill: 'forwards' }
    ),
    out: el => el.animate(
      [{ opacity: 1, transform: 'scale(1)' }, { opacity: 0, transform: 'scale(0.96)' }],
      { duration: 150, fill: 'forwards' }
    ).finished,
  })

  function close() {
    open = false
    onclose?.()
  }

  function handleBackdrop(e) {
    if (e.target === e.currentTarget) close()
  }

  function handleKeydown(e) {
    if (e.key === 'Escape') { close(); return }
    if (e.key !== 'Tab' || !panelEl) return

    const focusable = Array.from(
      panelEl.querySelectorAll(
        'button:not([disabled]), [href], input:not([disabled]), select:not([disabled]), textarea:not([disabled]), [tabindex]:not([tabindex="-1"])'
      )
    ).filter(el => el.offsetParent !== null)

    if (!focusable.length) { e.preventDefault(); return }
    const first = focusable[0]
    const last  = focusable[focusable.length - 1]

    if (e.shiftKey) {
      if (document.activeElement === first) { e.preventDefault(); last.focus() }
    } else {
      if (document.activeElement === last) { e.preventDefault(); first.focus() }
    }
  }
</script>

{#if open}
  <mesa:portal to={document.body}>
    <div
      class="fixed inset-0 z-50 flex items-center justify-center p-4
             bg-black/50 backdrop-blur-[2px]"
      {@attach backdropAnim}
      on:click={handleBackdrop}
      on:keydown={handleKeydown}
    >
      <div
        bind:this={panelEl}
        class="relative w-full {panelSize} rounded-2xl bg-white shadow-2xl
               flex flex-col max-h-[90vh] outline-none"
        {class}
        role="dialog"
        aria-modal="true"
        aria-labelledby="modal-title"
        tabindex="-1"
        {@attach panelAnim}
      >
        <!-- Header -->
        <div class="flex shrink-0 items-center justify-between px-6 py-4 border-b border-gray-100">
          <h2 id="modal-title" class="text-base font-semibold text-gray-900">{title}</h2>
          <button
            type="button"
            class="rounded-lg p-1.5 text-gray-400 hover:text-gray-600 hover:bg-gray-100
                   transition-colors focus-visible:outline-none focus-visible:ring-2
                   focus-visible:ring-blue-500"
            aria-label="Close modal"
            on:click={close}
          >
            <svg class="h-4 w-4" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 20 20" fill="currentColor">
              <path d="M6.28 5.22a.75.75 0 0 0-1.06 1.06L8.94 10l-3.72 3.72a.75.75 0 1 0 1.06 1.06L10 11.06l3.72 3.72a.75.75 0 1 0 1.06-1.06L11.06 10l3.72-3.72a.75.75 0 0 0-1.06-1.06L10 8.94 6.28 5.22z" />
            </svg>
          </button>
        </div>

        <!-- Body -->
        <div class="overflow-y-auto flex-1 px-6 py-5">
          <slot />
        </div>

        <!-- Footer -->
        {#if footer}
          <div class="shrink-0 flex items-center justify-end gap-2 px-6 py-4
                      border-t border-gray-100 bg-gray-50/60 rounded-b-2xl">
            {@render footer?.()}
          </div>
        {/if}
      </div>
    </div>
  </mesa:portal>
{/if}
