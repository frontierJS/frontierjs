<script>
  // DropdownItem.mesa
  // An action row inside DropdownMenu. Automatically closes the menu after
  // selection by consuming the parent's close() from context.
  //
  // Usage:
  //   <DropdownItem onclick={edit}>Edit</DropdownItem>
  //
  //   <DropdownItem variant="destructive" onclick={remove}>Delete</DropdownItem>
  //
  //   <!-- With icon and keyboard shortcut hint -->
  //   <DropdownItem kbd="⌘ D" onclick={duplicate}>
  //     {#snippet icon()}<IconCopy />{/snippet}
  //     Duplicate
  //   </DropdownItem>
  //
  //   <!-- Link item -->
  //   <DropdownItem href="/settings">Settings</DropdownItem>
  //
  //   <DropdownItem disabled>Coming soon</DropdownItem>

  export let variant  = 'default'    // 'default' | 'destructive'
  export let disabled = false
  export let kbd      = ''           // keyboard shortcut label shown on the right
  export let href     = undefined    // renders as <a> when set
  export let icon     = null         // snippet — leading icon (16×16)
  export let onclick  = undefined

  // Consume close() from nearest DropdownMenu ancestor.
  // const — always tracks provider (Rule 25a). Safe no-op if used outside a DropdownMenu.
  const close = $context.close

  const base = [
    'flex w-full items-center gap-2.5 px-3 py-1.5 mx-1 text-sm rounded-md w-[calc(100%-0.5rem)]',
    'transition-colors select-none',
    'focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-inset focus-visible:ring-blue-500',
  ].join(' ')

  const variantMap = {
    default:     'text-gray-700 hover:bg-gray-100 focus-visible:bg-gray-100',
    destructive: 'text-red-600 hover:bg-red-50 focus-visible:bg-red-50',
  }

  const itemClass = `${base} ${variantMap[variant] ?? variantMap.default}`

  function handleClick(e) {
    if (disabled) return
    onclick?.(e)
    close?.()
  }
</script>

{#if href && !disabled}
  <a
    href={href}
    role="menuitem"
    tabindex="-1"
    class="{itemClass} {class}"
    on:click={handleClick}
  >
    {#if icon}
      <span class="h-4 w-4 shrink-0 text-current opacity-60" aria-hidden="true">
        {@render icon?.()}
      </span>
    {/if}
    <span class="flex-1 truncate"><slot /></span>
    {#if kbd}
      <kbd class="ml-auto shrink-0 text-xs text-gray-400 font-sans tracking-wide">{kbd}</kbd>
    {/if}
  </a>
{:else}
  <button
    type="button"
    role="menuitem"
    tabindex="-1"
    disabled={disabled}
    aria-disabled={disabled}
    class="{itemClass} disabled:opacity-40 disabled:cursor-not-allowed {class}"
    on:click={handleClick}
  >
    {#if icon}
      <span class="h-4 w-4 shrink-0 text-current opacity-60" aria-hidden="true">
        {@render icon?.()}
      </span>
    {/if}
    <span class="flex-1 truncate text-left"><slot /></span>
    {#if kbd}
      <kbd class="ml-auto shrink-0 text-xs text-gray-400 font-sans tracking-wide">{kbd}</kbd>
    {/if}
  </button>
{/if}
