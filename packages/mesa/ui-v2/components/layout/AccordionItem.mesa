<script>
  // AccordionItem.mesa
  // Must be a direct or indirect child of Accordion.mesa.
  // Uses CSS grid-template-rows trick for smooth height animation with zero JS.
  //
  // The grid-template-rows value is driven by a reactive template binding —
  // when isOpen changes, the class changes, CSS transition handles the animation.
  //
  // Usage: see Accordion.mesa

  export let id       = ''
  export let label    = ''
  export let disabled = false
  // Consume context from nearest Accordion ancestor
  // const → always tracks provider (Rule 25a)
  const openIds = $context.openIds   // reactive — re-derives when Accordion.toggle() runs
  const toggle  = $context.toggle    // function — static ref, mutates Accordion's openIds signal
  const divided = $context.divided   // static from context

  // Derived: is this specific item open?
  // openIds is reactive (tracks context), id is export var snapshot → isOpen re-derives when openIds changes
  const isOpen = !!openIds[id]

  function handleClick() {
    if (!disabled) toggle(id)
  }

  function handleKeyDown(e) {
    if (e.key === 'Enter' || e.key === ' ') {
      e.preventDefault()
      handleClick()
    }
  }
</script>

<div class="bg-white {!divided ? 'rounded-xl border border-gray-200' : ''}" {class}>

  <!-- Header button -->
  <button
    type="button"
    aria-expanded={isOpen}
    aria-controls="{id}-panel"
    id="{id}-header"
    disabled={disabled}
    class="flex w-full items-center justify-between px-5 py-4 text-left
           font-medium text-gray-900 text-sm transition-colors
           hover:bg-gray-50 focus-visible:outline-none focus-visible:ring-2
           focus-visible:ring-inset focus-visible:ring-blue-500
           disabled:opacity-50 disabled:cursor-not-allowed
           {isOpen ? 'text-blue-700' : ''}"
    on:click={handleClick}
    on:keydown={handleKeyDown}
  >
    <span>{label}</span>

    <!-- Chevron — rotates 180° when open -->
    <svg
      class="h-4 w-4 shrink-0 text-gray-500 transition-transform duration-200
             {isOpen ? 'rotate-180 text-blue-600' : ''}"
      xmlns="http://www.w3.org/2000/svg"
      viewBox="0 0 20 20"
      fill="currentColor"
      aria-hidden="true"
    >
      <path fill-rule="evenodd" d="M5.22 8.22a.75.75 0 0 1 1.06 0L10 11.94l3.72-3.72a.75.75 0 1 1 1.06 1.06l-4.25 4.25a.75.75 0 0 1-1.06 0L5.22 9.28a.75.75 0 0 1 0-1.06z" clip-rule="evenodd" />
    </svg>
  </button>

  <!-- Panel — CSS grid height animation, no JS needed -->
  <!-- grid-template-rows: 0fr collapses the inner div to zero height;
       1fr expands it to full height. transition-[grid-template-rows] animates it. -->
  <div
    id="{id}-panel"
    role="region"
    aria-labelledby="{id}-header"
    style:grid-template-rows={isOpen ? '1fr' : '0fr'}
    class="grid overflow-hidden transition-[grid-template-rows] duration-200 ease-in-out"
  >
    <div class="min-h-0 overflow-hidden">
      <div class="px-5 pb-5 text-sm text-gray-600 leading-relaxed">
        <slot />
      </div>
    </div>
  </div>

</div>
