<script>
  // TabPanel.mesa
  // Content region for a Tab. Hidden (not destroyed) when inactive unless
  // `unmount` is true, in which case {#if} removes it from the DOM.
  //
  // Default: CSS visibility — panel stays mounted, screen readers can't see hidden panels.
  // unmount=true: DOM removal — use when panels have expensive setup ($onMount, async, etc.)
  //
  // Usage:
  //   <TabPanel id="general">
  //     <GeneralSettings />
  //   </TabPanel>

  export let id      = ''
  export let unmount = false   // true = destroy DOM on hide; false = CSS hide only
  // const — always tracks when Tabs changes activeId (Rule 25a)
  const activeId = $context.activeId
  const isActive = activeId === id
</script>

{#if unmount}
  {#if isActive}
    <div
      id="panel-{id}"
      role="tabpanel"
      aria-labelledby="tab-{id}"
      tabindex="0"
      class="focus-visible:outline-none"
      {class}
    >
      <slot />
    </div>
  {/if}
{:else}
  <div
    id="panel-{id}"
    role="tabpanel"
    aria-labelledby="tab-{id}"
    tabindex="0"
    hidden={!isActive}
    class="focus-visible:outline-none {isActive ? '' : 'hidden'}"
    {class}
  >
    <slot />
  </div>
{/if}
