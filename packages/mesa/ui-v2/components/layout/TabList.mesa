<script>
  // TabList.mesa
  // Renders the row of Tab buttons. Handles keyboard navigation by delegating
  // arrow keys to Tabs context via adjacent() + DOM focus.
  //
  // variants:
  //   'underline' — bottom border indicator (default, like your Tabs/Tab.svelte)
  //   'pills'     — rounded filled background on active tab
  //   'boxed'     — card-style with outer border

  export let variant  = 'underline'  // 'underline' | 'pills' | 'boxed'
  const adjacent = $context.adjacent    // fn(id, delta) → adjacent tab id

  const wrapperMap = {
    underline: 'flex border-b border-gray-200 gap-0',
    pills:     'flex gap-1 p-1 bg-gray-100 rounded-xl',
    boxed:     'flex border border-gray-200 rounded-lg overflow-hidden divide-x divide-gray-200',
  }
  const wrapperClass = wrapperMap[variant] ?? wrapperMap.underline

  // Provide variant down to Tab components
  $context.tabVariant = variant

  // Capture context accessors at top level — can't use $context inside functions (Rule 25)
  const getActiveId = $context.activeId    // reactive getter (const tracks provider)
  const setActive   = $context.setActive

  function handleKeyDown(e) {
    if (e.key !== 'ArrowLeft' && e.key !== 'ArrowRight') return
    const active = typeof getActiveId === 'function' ? getActiveId() : getActiveId
    const delta  = e.key === 'ArrowRight' ? 1 : -1
    const next   = adjacent(active, delta)
    if (!next) return
    e.preventDefault()
    setActive?.(next)
    // Focus the newly active tab button — query by data-tab-id attr
    const nextEl = document.querySelector(`[data-tab-id="${next}"]`)
    nextEl?.focus()
  }
</script>

<div
  role="tablist"
  class={wrapperClass}
  {class}
  on:keydown={handleKeyDown}
>
  <slot />
</div>
