<script>
  // Button.mesa
  // Polymorphic button with variant, size, loading state, and icon support.
  //
  // Variants: primary | secondary | ghost | danger | outline | link
  // Sizes:    xs | sm | md | lg
  //
  // Icon-only buttons:
  //   <Button icon><IconTrash /></Button>
  //
  // Leading/trailing icons via snippets:
  //   <Button>
  //     {#snippet leading()}<IconPlus />{/snippet}
  //     Add item
  //   </Button>

  export let variant  = 'primary'
  export let size     = 'md'
  export let type     = 'button'
  export let disabled = false
  export let loading  = false
  export let icon     = false    // true = icon-only (square, no text padding)
  export let href     = undefined  // renders as <a> when set
  export let leading  = null     // snippet — icon before label
  export let trailing = null     // snippet — icon after label
  export let onclick  = undefined

  const base = [
    'inline-flex items-center justify-center font-medium transition-colors duration-150',
    'focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-offset-2',
    'disabled:opacity-50 disabled:pointer-events-none',
    'select-none',
  ].join(' ')

  const variantMap = {
    primary:   'bg-blue-600 text-white hover:bg-blue-700 active:bg-blue-800 focus-visible:ring-blue-500',
    secondary: 'bg-gray-100 text-gray-800 hover:bg-gray-200 active:bg-gray-300 focus-visible:ring-gray-400',
    ghost:     'text-gray-700 hover:bg-gray-100 active:bg-gray-200 focus-visible:ring-gray-400',
    danger:    'bg-red-600 text-white hover:bg-red-700 active:bg-red-800 focus-visible:ring-red-500',
    outline:   'border border-gray-300 bg-white text-gray-700 hover:bg-gray-50 active:bg-gray-100 focus-visible:ring-gray-400',
    link:      'text-blue-600 hover:text-blue-700 hover:underline underline-offset-2 focus-visible:ring-blue-500 px-0',
  }

  // Pad sizes — icon=true uses a square variant
  const sizeMap = {
    xs: { text: 'h-7  text-xs  rounded-md gap-1',    pad: 'px-2.5', sq: 'w-7  p-1'    },
    sm: { text: 'h-8  text-xs  rounded-md gap-1.5',  pad: 'px-3',   sq: 'w-8  p-1.5'  },
    md: { text: 'h-9  text-sm  rounded-lg gap-2',    pad: 'px-4',   sq: 'w-9  p-2'    },
    lg: { text: 'h-11 text-base rounded-lg gap-2.5', pad: 'px-5',   sq: 'w-11 p-2.5'  },
  }

  const sz      = sizeMap[size]  ?? sizeMap.md
  const vClass  = variantMap[variant] ?? variantMap.primary
  const padClass = icon ? sz.sq : `${sz.pad} ${sz.text}`

  // Icon size derived from button size
  const iconSizeMap = { xs: 'h-3 w-3', sm: 'h-3.5 w-3.5', md: 'h-4 w-4', lg: 'h-5 w-5' }
  const iconSize    = iconSizeMap[size] ?? iconSizeMap.md

  function handleClick(e) {
    if (!loading) onclick?.(e)
  }
</script>

{#if href && !disabled}
  <a
    href={href}
    class="{base} {vClass} {padClass}"
    {class}
    role="button"
  >
    {#if loading}
      {@render spinnerIcon()}
    {:else}
      {#if leading}<span class={iconSize}>{@render leading?.()}</span>{/if}
      <slot />
      {#if trailing}<span class={iconSize}>{@render trailing?.()}</span>{/if}
    {/if}
  </a>
{:else}
  <button
    type={type}
    disabled={disabled || loading}
    aria-busy={loading}
    class="{base} {vClass} {padClass}"
    {class}
    on:click={handleClick}
  >
    {#if loading}
      {@render spinnerIcon()}
      {#if !icon}<span class="opacity-70">Loading…</span>{/if}
    {:else}
      {#if leading}<span class={iconSize}>{@render leading?.()}</span>{/if}
      <slot />
      {#if trailing}<span class={iconSize}>{@render trailing?.()}</span>{/if}
    {/if}
  </button>
{/if}

{#snippet spinnerIcon()}
  <svg
    class="animate-spin {iconSize} shrink-0"
    xmlns="http://www.w3.org/2000/svg"
    fill="none"
    viewBox="0 0 24 24"
    aria-hidden="true"
  >
    <circle class="opacity-25" cx="12" cy="12" r="10" stroke="currentColor" stroke-width="4" />
    <path class="opacity-75" fill="currentColor" d="M4 12a8 8 0 018-8V0C5.373 0 0 5.373 0 12h4z" />
  </svg>
{/snippet}
