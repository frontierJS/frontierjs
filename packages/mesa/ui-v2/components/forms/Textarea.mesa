<script>
  // Textarea.mesa
  // Multi-line text input with optional auto-resize.
  // Field composition pattern: label prop triggers self-wrapping in Field.
  //
  // bind:this exposes: focus()

  import Field from './Field.mesa'
  import { nameToLabel, uid } from '../../utils.js'

  export let value       = ''
  export let placeholder = ''
  export let rows        = 3
  export let maxlength   = undefined
  export let disabled    = false
  export let required    = undefined
  export let readonly    = false
  export let resize      = true      // allow manual resize via drag
  export let autogrow    = false     // auto-expand height to content

  // Field integration
  export let name     = ''
  export let label    = ''
  export let hint     = ''
  export let error    = ''
  export let errors   = undefined
  export let badge    = undefined
  export let help     = undefined

  export var id = ''
  const textareaId = id || uid('textarea')
  const autoLabel  = nameToLabel(name)

  const ringClass = error || errors?.[name]
    ? 'border-red-300 focus:border-red-400 focus:ring-red-200 bg-red-50/30'
    : 'border-gray-300 focus:border-blue-400 focus:ring-blue-100 bg-white'

  let el
  export function focus() { el?.focus() }

  function handleInput(e) {
    value = e.target.value
    if (autogrow) {
      e.target.style.height = 'auto'
      e.target.style.height = `${e.target.scrollHeight}px`
    }
  }
  // Native event callbacks
  export let onchange = undefined
  export let onblur   = undefined
  export let onfocus  = undefined
</script>

{#snippet control()}
  <textarea
    bind:this={el}
    id={textareaId}
    name={name || undefined}
    rows={rows}
    maxlength={maxlength}
    placeholder={placeholder}
    disabled={disabled}
    required={required}
    readonly={readonly}
    aria-invalid={!!(error || errors?.[name])}
    class="block w-full rounded-md border px-3 py-2 text-sm shadow-sm transition-colors
           placeholder:text-gray-400 focus:outline-none focus:ring-2 focus:ring-offset-0
           disabled:bg-gray-50 disabled:text-gray-500 disabled:cursor-not-allowed
           read-only:bg-gray-50
           {resize ? '' : 'resize-none'}
           {ringClass}"
    on:input={handleInput}
    on:change={onchange}
    on:blur={onblur}
    on:focus={onfocus}
  >{value}</textarea>

  {#if maxlength}
    <p class="mt-1 text-right text-xs text-gray-400">
      {value.length} / {maxlength}
    </p>
  {/if}
{/snippet}

{#if label || (name && !label && autoLabel)}
  {@const resolvedLabel = label || autoLabel}
  <Field
    id={textareaId}
    name={name}
    label={resolvedLabel}
    required={required}
    badge={badge}
    help={help}
    hint={hint}
    error={error}
    errors={errors}
    {class}
  >
    {@render control()}
  </Field>
{:else}
  <div {class}>
    {@render control()}
  </div>
{/if}
