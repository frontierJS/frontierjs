<script>
  // Checkbox.mesa
  // A single checkbox with optional label and description.
  // Does not use Field internally (checkboxes have a different label layout).
  //
  // For a group of checkboxes with bind:group, use CheckboxGroup (planned v1.1).
  // For a toggle switch aesthetic, use Switch.mesa.

  import { uid } from '../../utils.js'

  export let checked     = false
  export let label       = ''
  export let description = ''  // secondary line under label
  export let name        = undefined
  export let value       = undefined  // for bind:group use on parent
  export let disabled    = false
  export let required    = undefined
  export let error       = ''
  export let onchange    = undefined

  export var id = ''
  const checkId = id || uid('check')

  function handleChange(e) {
    checked = e.target.checked
    onchange?.(checked)
  }
</script>

<div class="flex flex-col gap-1" {class}>
  <div class="flex items-start gap-3">

    <!-- The checkbox itself — vertically centred to the first line of label text -->
    <div class="flex h-5 shrink-0 items-center">
      <input
        id={checkId}
        type="checkbox"
        name={name}
        value={value}
        checked={checked}
        disabled={disabled}
        required={required}
        class="h-4 w-4 rounded border-gray-300 text-blue-600 shadow-sm
               focus:ring-2 focus:ring-blue-500 focus:ring-offset-0
               disabled:cursor-not-allowed disabled:opacity-50
               {error ? 'border-red-400' : ''}"
        on:change={handleChange}
      />
    </div>

    {#if label || description}
      <div class="flex flex-col gap-0.5 {disabled ? 'opacity-50' : ''}">
        {#if label}
          <label for={checkId} class="text-sm font-medium text-gray-700 leading-5 cursor-pointer select-none">
            {label}
          </label>
        {/if}
        {#if description}
          <p class="text-xs text-gray-500 leading-snug">{description}</p>
        {/if}
      </div>
    {/if}
  </div>

  {#if error}
    <p class="text-xs text-red-600 flex items-center gap-1 ml-7" role="alert">
      <svg class="w-3 h-3 shrink-0" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 20 20" fill="currentColor">
        <path fill-rule="evenodd" d="M18 10a8 8 0 1 1-16 0 8 8 0 0 1 16 0Zm-8-5a.75.75 0 0 1 .75.75v4.5a.75.75 0 0 1-1.5 0v-4.5A.75.75 0 0 1 10 5Zm0 10a1 1 0 1 0 0-2 1 1 0 0 0 0 2Z" clip-rule="evenodd" />
      </svg>
      {error}
    </p>
  {/if}
</div>
