<script>
  // FileUpload.mesa
  // Drag-and-drop file input with click-to-browse, file preview list,
  // per-file progress, and remove. Does not upload — provides the File objects
  // via onchange for the parent to handle.
  //
  // Usage — basic:
  //   <FileUpload onchange={(files) => handleFiles(files)} />
  //
  // Usage — images only, multiple:
  //   <FileUpload accept="image/*" multiple onchange={uploadImages} />
  //
  // Usage — with Field label:
  //   <FileUpload label="Attachments" name="files" multiple onchange={fn} />
  //
  // Usage — show progress per file (pass progressMap):
  //   <!-- progressMap: { [filename]: 0-100 } -->
  //   <FileUpload {files} progressMap={uploadProgress} multiple />

  import Field from './Field.mesa'
  import { uid } from '../../utils.js'

  export let accept       = '*/*'     // MIME types e.g. 'image/*' or '.pdf,.doc'
  export let multiple     = false
  export let maxSizeMB    = 0         // 0 = no limit
  export let label        = ''
  export let name         = ''
  export let hint         = ''
  export let error        = ''
  export let errors       = undefined
  export let disabled     = false
  export let files        = []        // File[] — bindable, current selection
  export let progressMap  = {}        // { [filename]: 0-100 } — optional upload progress
  export let onchange     = undefined // (files: File[]) => void

  export var id = ''
  const inputId = id || uid('file')

  let dragging     = false
  let inputEl
  let localError   = ''

  function formatBytes(bytes) {
    if (bytes < 1024)         return `${bytes} B`
    if (bytes < 1024 ** 2)   return `${(bytes / 1024).toFixed(1)} KB`
    return `${(bytes / 1024 ** 2).toFixed(1)} MB`
  }

  function isImage(file) {
    return file.type.startsWith('image/')
  }

  function validate(fileList) {
    if (maxSizeMB <= 0) return ''
    const oversized = fileList.find(f => f.size > maxSizeMB * 1024 * 1024)
    if (oversized) return `"${oversized.name}" exceeds ${maxSizeMB} MB`
    return ''
  }

  function addFiles(newFiles) {
    if (disabled) return
    const list = Array.from(newFiles)
    const err  = validate(list)
    if (err) { localError = err; return }
    localError = ''
    files = multiple ? [...files, ...list] : list
    onchange?.(files)
  }

  function removeFile(i) {
    files = files.filter((_, idx) => idx !== i)
    onchange?.(files)
    localError = ''
  }

  function handleDrop(e) {
    e.preventDefault()
    dragging = false
    if (e.dataTransfer?.files.length) addFiles(e.dataTransfer.files)
  }

  function handleInputChange(e) {
    if (e.target.files?.length) {
      addFiles(e.target.files)
      e.target.value = ''   // reset so same file can be re-selected
    }
  }

  const displayError = localError || error || errors?.[name] || ''
</script>

{#snippet dropzone()}
  <div class="flex flex-col gap-3">
    <!-- Drop area -->
    <div
      class="relative flex flex-col items-center justify-center gap-2 rounded-xl border-2
             border-dashed px-6 py-8 text-center transition-colors cursor-pointer
             {dragging   ? 'border-blue-400 bg-blue-50'    : 'border-gray-300 hover:border-gray-400 bg-gray-50/50'}
             {disabled   ? 'opacity-50 pointer-events-none' : ''}
             {displayError ? 'border-red-300' : ''}"
      role="button"
      tabindex="0"
      aria-label="Upload file area"
      on:dragover|preventDefault={() => dragging = true}
      on:dragleave={() => dragging = false}
      on:drop={handleDrop}
      on:click={() => inputEl?.click()}
      on:keydown={(e) => { if (e.key === 'Enter' || e.key === ' ') inputEl?.click() }}
    >
      <svg
        class="h-8 w-8 {dragging ? 'text-blue-400' : 'text-gray-400'} transition-colors"
        viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5"
        stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"
      >
        <path d="M12 16V4m0 0-3 3m3-3 3 3"/>
        <path d="M20 16.7A5 5 0 0 0 18 7h-1.26A8 8 0 1 0 4 15.25"/>
      </svg>

      <div>
        <p class="text-sm font-medium text-gray-700">
          {dragging ? 'Drop to upload' : 'Drag & drop or click to browse'}
        </p>
        <p class="text-xs text-gray-400 mt-0.5">
          {accept !== '*/*' ? accept : 'Any file type'}
          {maxSizeMB > 0 ? ` · Max ${maxSizeMB} MB` : ''}
          {multiple ? ' · Multiple allowed' : ''}
        </p>
      </div>

      <input
        bind:this={inputEl}
        id={inputId}
        type="file"
        accept={accept}
        multiple={multiple}
        disabled={disabled}
        class="sr-only"
        on:change={handleInputChange}
      />
    </div>

    {#if displayError}
      <p class="text-xs text-red-600 flex items-center gap-1" role="alert">
        <svg class="w-3.5 h-3.5 shrink-0" viewBox="0 0 20 20" fill="currentColor">
          <path fill-rule="evenodd" d="M18 10a8 8 0 1 1-16 0 8 8 0 0 1 16 0Zm-8-5a.75.75 0 0 1 .75.75v4.5a.75.75 0 0 1-1.5 0v-4.5A.75.75 0 0 1 10 5Zm0 10a1 1 0 1 0 0-2 1 1 0 0 0 0 2Z" clip-rule="evenodd"/>
        </svg>
        {displayError}
      </p>
    {/if}

    <!-- File list -->
    {#if files.length}
      <ul class="flex flex-col gap-2">
        {#each files as file, i (file.name + i)}
          {@const progress = progressMap[file.name] ?? null}
          <li class="flex items-center gap-3 rounded-lg border border-gray-200 bg-white p-3">
            <!-- Thumbnail or icon -->
            {#if isImage(file)}
              <img
                src={URL.createObjectURL(file)}
                alt={file.name}
                class="h-10 w-10 rounded-md object-cover shrink-0 border border-gray-100"
              />
            {:else}
              <div class="flex h-10 w-10 shrink-0 items-center justify-center rounded-md bg-gray-100">
                <svg class="h-5 w-5 text-gray-500" viewBox="0 0 20 20" fill="currentColor">
                  <path d="M3 3.5A1.5 1.5 0 0 1 4.5 2h6.879a1.5 1.5 0 0 1 1.06.44l4.122 4.12A1.5 1.5 0 0 1 17 7.622V16.5a1.5 1.5 0 0 1-1.5 1.5h-11A1.5 1.5 0 0 1 3 16.5v-13Z"/>
                </svg>
              </div>
            {/if}

            <!-- Info -->
            <div class="flex-1 min-w-0">
              <p class="text-xs font-medium text-gray-800 truncate">{file.name}</p>
              <p class="text-xs text-gray-400">{formatBytes(file.size)}</p>
              {#if progress !== null}
                <div class="mt-1.5 h-1 w-full rounded-full bg-gray-200 overflow-hidden">
                  <div
                    class="h-full rounded-full transition-all duration-300
                           {progress >= 100 ? 'bg-green-500' : 'bg-blue-500'}"
                    style:width="{progress}%"
                  ></div>
                </div>
              {/if}
            </div>

            <!-- Remove -->
            {#if progress === null || progress >= 100}
              <button
                type="button"
                class="shrink-0 rounded-md p-1 text-gray-400 hover:text-gray-600
                       hover:bg-gray-100 transition-colors
                       focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-blue-500"
                aria-label="Remove {file.name}"
                on:click={() => removeFile(i)}
              >
                <svg class="h-4 w-4" viewBox="0 0 20 20" fill="currentColor">
                  <path d="M6.28 5.22a.75.75 0 0 0-1.06 1.06L8.94 10l-3.72 3.72a.75.75 0 1 0 1.06 1.06L10 11.06l3.72 3.72a.75.75 0 1 0 1.06-1.06L11.06 10l3.72-3.72a.75.75 0 0 0-1.06-1.06L10 8.94 6.28 5.22z"/>
                </svg>
              </button>
            {/if}
          </li>
        {/each}
      </ul>
    {/if}
  </div>
{/snippet}

{#if label || name}
  <Field
    id={inputId}
    name={name}
    label={label || name}
    hint={hint}
    {class}
  >
    {@render dropzone()}
  </Field>
{:else}
  <div {class}>
    {@render dropzone()}
  </div>
{/if}
