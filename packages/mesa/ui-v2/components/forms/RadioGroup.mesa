<script>
  // RadioGroup.mesa
  // A group of radio options rendered as selectable cards.
  // Supports inline (horizontal) and stacked (vertical) layouts.
  //
  // items: { value, label, description?, disabled? }[]
  //
  // Usage:
  //   <RadioGroup
  //     bind:value={plan}
  //     label="Billing cycle"
  //     items={[
  //       { value: 'monthly', label: 'Monthly', description: '$12/mo' },
  //       { value: 'yearly',  label: 'Yearly',  description: '$99/yr' },
  //     ]}
  //   />

  import Field from './Field.mesa'
  import { uid } from '../../utils.js'

  export let items    = []
  export let value    = null
  export let label    = ''
  export let hint     = ''
  export let error    = ''
  export let errors   = undefined
  export let name     = ''
  export let disabled = false
  export let layout   = 'stacked'  // 'stacked' | 'inline'
  export let onchange = undefined

  export var id = ''
  const groupName = name || uid('radio')

  function handleChange(e) {
    value = e.target.value
    onchange?.(value)
  }
</script>

{#snippet group()}
  <div
    role="radiogroup"
    class="{layout === 'inline' ? 'flex flex-wrap gap-3' : 'flex flex-col gap-2'}"
  >
    {#each items as item (item.value)}
      {@const isSelected = value === item.value}
      {@const isDisabled = disabled || item.disabled}

      <label
        class="flex items-start gap-3 rounded-lg border px-4 py-3 cursor-pointer
               transition-colors select-none
               {isSelected
                 ? 'border-blue-500 bg-blue-50 ring-1 ring-blue-500'
                 : 'border-gray-200 bg-white hover:border-gray-300 hover:bg-gray-50'}
               {isDisabled ? 'opacity-50 cursor-not-allowed pointer-events-none' : ''}"
      >
        <div class="flex h-5 items-center shrink-0 mt-0.5">
          <input
            type="radio"
            name={groupName}
            value={item.value}
            checked={isSelected}
            disabled={isDisabled}
            class="h-4 w-4 border-gray-300 text-blue-600
                   focus:ring-2 focus:ring-blue-500 focus:ring-offset-0"
            on:change={handleChange}
          />
        </div>
        <div class="flex flex-col gap-0.5">
          <span class="text-sm font-medium text-gray-800">{item.label}</span>
          {#if item.description}
            <span class="text-xs text-gray-500 leading-snug">{item.description}</span>
          {/if}
        </div>
      </label>
    {/each}
  </div>
{/snippet}

{#if label}
  <Field
    name={name}
    label={label}
    hint={hint}
    error={error}
    errors={errors}
    {class}
  >
    {@render group()}
  </Field>
{:else}
  <div {class}>
    {@render group()}
  </div>
{/if}
