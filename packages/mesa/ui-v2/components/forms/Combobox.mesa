<script>
  // Combobox.mesa
  // Searchable single-value select. The user can type to filter options,
  // and optionally confirm any typed value (allowNew).
  // Sits between Select (no search) and MultiSelect (multi-value).
  //
  // Usage — basic:
  //   <Combobox bind:value={country} options={countries} placeholder="Search country…" />
  //
  // Usage — with Field:
  //   <Combobox label="Timezone" name="tz" bind:value {options} {errors} />
  //
  // Usage — allow new values:
  //   <Combobox bind:value allowNew placeholder="Select or type a tag…" {options} />

  import Field from '../forms/Field.mesa'
  import { uid } from '../../utils.js'

  export let value       = undefined    // scalar — bindable
  export let options     = []           // string[] | { value, label, disabled? }[]
  export let placeholder = 'Search…'
  export let allowNew    = false        // confirm any typed string as value
  export let disabled    = false
  export let clearable   = true

  // Field integration
  export let name     = ''
  export let label    = ''
  export let hint     = ''
  export let error    = ''
  export let errors   = undefined
  export let badge    = undefined
  export let help     = undefined
  export let onchange = undefined

  export var id = ''
  const inputId = id || uid('cb')

  // Normalise options
  function normalise(o) {
    if (typeof o === 'string' || typeof o === 'number') return { value: o, label: String(o) }
    return { value: o.value, label: o.label ?? o.textContent ?? String(o.value), disabled: o.disabled ?? false }
  }

  const normOptions = options.map(normalise)

  // Find the display label for the current value
  function labelFor(v) {
    return normOptions.find(o => o.value === v)?.label ?? (v != null ? String(v) : '')
  }

  let query    = labelFor(value)
  let open     = false
  let activeIdx = 0
  let inputEl
  let containerEl
  var _clickHandler = null

  // Derived — filter options by query
  const filtered = query.trim()
    ? normOptions.filter(o => o.label.toLowerCase().includes(query.toLowerCase()))
    : normOptions

  // Reset active index when filter changes
  $: query, () => { activeIdx = 0 }

  // Sync query label when value changes externally
  $: value, () => { query = labelFor(value) }

  function select(opt) {
    value = opt.value
    query = opt.label
    open  = false
    onchange?.(value)
  }

  function clear() {
    value = undefined
    query = ''
    open  = false
    onchange?.(undefined)
    inputEl?.focus()
  }

  function handleInput() {
    open = true
    if (!query) { value = undefined; onchange?.(undefined) }
  }

  function handleKeydown(e) {
    if (e.key === 'Escape') { open = false; query = labelFor(value); return }
    if (e.key === 'ArrowDown') { e.preventDefault(); open = true; activeIdx = Math.min(activeIdx + 1, filtered.length - 1); return }
    if (e.key === 'ArrowUp')   { e.preventDefault(); activeIdx = Math.max(activeIdx - 1, 0); return }
    if (e.key === 'Enter') {
      e.preventDefault()
      if (filtered[activeIdx]) { select(filtered[activeIdx]); return }
      if (allowNew && query.trim()) {
        value = query.trim()
        open  = false
        onchange?.(value)
      }
    }
  }

  function handleBlur() {
    setTimeout(() => {
      if (!containerEl?.contains(document.activeElement)) {
        open  = false
        // Revert query to current value label if input was changed but not confirmed
        query = labelFor(value)
      }
    }, 150)
  }

  const dropdownAnim = $.entrance({
    in:  el => el.animate([{ opacity: 0, transform: 'translateY(-4px)' }, { opacity: 1, transform: 'translateY(0)' }], { duration: 120, easing: 'ease-out', fill: 'forwards' }),
    out: el => el.animate([{ opacity: 1 }, { opacity: 0 }], { duration: 80, fill: 'forwards' }).finished,
  })
</script>

{#snippet control()}
  <div bind:this={containerEl} class="relative">
    <div class="relative">
      <input
        bind:this={inputEl}
        bind:value={query}
        id={inputId}
        type="text"
        autocomplete="off"
        spellcheck="false"
        placeholder={placeholder}
        disabled={disabled}
        class="block w-full rounded-md border px-3 py-2 pr-16 text-sm shadow-sm
               transition-colors placeholder:text-gray-400
               focus:outline-none focus:ring-2 focus:ring-offset-0
               disabled:bg-gray-50 disabled:cursor-not-allowed
               {open ? 'border-blue-400 ring-2 ring-blue-100' : 'border-gray-300'}
               {error || errors?.[name] ? 'border-red-300 ring-red-100' : 'focus:border-blue-400 focus:ring-blue-100'}"
        role="combobox"
        aria-expanded={open}
        aria-haspopup="listbox"
        aria-autocomplete="list"
        on:input={handleInput}
        on:focus={() => open = true}
        on:blur={handleBlur}
        on:keydown={handleKeydown}
      />

      <!-- Trailing icons -->
      <div class="absolute inset-y-0 right-0 flex items-center pr-2 gap-0.5">
        {#if clearable && (value != null || query)}
          <button
            type="button"
            class="p-1 rounded text-gray-400 hover:text-gray-600 transition-colors
                   focus-visible:outline-none focus-visible:ring-1 focus-visible:ring-blue-500"
            aria-label="Clear"
            on:click={clear}
          >
            <svg class="h-3.5 w-3.5" viewBox="0 0 20 20" fill="currentColor">
              <path d="M6.28 5.22a.75.75 0 0 0-1.06 1.06L8.94 10l-3.72 3.72a.75.75 0 1 0 1.06 1.06L10 11.06l3.72 3.72a.75.75 0 1 0 1.06-1.06L11.06 10l3.72-3.72a.75.75 0 0 0-1.06-1.06L10 8.94 6.28 5.22z"/>
            </svg>
          </button>
        {/if}
        <svg class="h-4 w-4 text-gray-400 transition-transform {open ? 'rotate-180' : ''}" viewBox="0 0 20 20" fill="currentColor" aria-hidden="true">
          <path fill-rule="evenodd" d="M5.22 8.22a.75.75 0 0 1 1.06 0L10 11.94l3.72-3.72a.75.75 0 1 1 1.06 1.06l-4.25 4.25a.75.75 0 0 1-1.06 0L5.22 9.28a.75.75 0 0 1 0-1.06z" clip-rule="evenodd"/>
        </svg>
      </div>
    </div>

    {#if open}
      <ul
        class="absolute left-0 right-0 top-full z-50 mt-1 max-h-48 overflow-y-auto
               rounded-lg border border-gray-200 bg-white shadow-lg py-1 outline-none"
        role="listbox"
        aria-label="Options"
        {@attach dropdownAnim}
        style:scrollbar-width="thin"
      >
        {#if filtered.length === 0}
          <li class="px-3 py-2 text-sm text-gray-400 text-center">
            {allowNew && query.trim() ? `Press Enter to use "${query.trim()}"` : 'No options'}
          </li>
        {:else}
          {#each filtered as opt, i (opt.value)}
            {@const isActive   = i === activeIdx}
            {@const isSelected = opt.value === value}
            <li
              class="flex items-center justify-between px-3 py-2 text-sm cursor-pointer
                     transition-colors
                     {isActive   ? 'bg-blue-50 text-blue-700' : 'text-gray-700 hover:bg-gray-50'}
                     {opt.disabled ? 'opacity-40 pointer-events-none' : ''}"
              role="option"
              aria-selected={isSelected}
              on:mouseenter={() => activeIdx = i}
              on:click={() => select(opt)}
            >
              {opt.label}
              {#if isSelected}
                <svg class="h-4 w-4 text-blue-600 shrink-0" viewBox="0 0 20 20" fill="currentColor">
                  <path fill-rule="evenodd" d="M16.704 4.153a.75.75 0 0 1 .143 1.052l-8 10.5a.75.75 0 0 1-1.127.075l-4.5-4.5a.75.75 0 0 1 1.06-1.06l3.894 3.893 7.48-9.817a.75.75 0 0 1 1.05-.143Z" clip-rule="evenodd"/>
                </svg>
              {/if}
            </li>
          {/each}
        {/if}
      </ul>
    {/if}
  </div>
{/snippet}

{#if label || name}
  <Field
    id={inputId}
    name={name}
    label={label || name}
    hint={hint}
    error={error}
    errors={errors}
    badge={badge}
    help={help}
    {class}
  >
    {@render control()}
  </Field>
{:else}
  <div {class}>
    {@render control()}
  </div>
{/if}
