<script module>
  // ── Module-level helpers — shared across all MultiSelect instances ──────────

  /** Simple weighted text search — scores by position of match, prefers prefix */
  export function scoreMatch(text, query) {
    if (!query) return 1
    const t = text.toLowerCase()
    const q = query.toLowerCase()
    const i = t.indexOf(q)
    if (i === -1) return 0
    // Prefix match scores higher than mid-string match
    return i === 0 ? 2 : 1
  }

  /** Filter and sort options by query string */
  export function filterOptions(options, query) {
    if (!query?.trim()) return options
    return options
      .map(o => ({ ...o, _score: scoreMatch(o.textContent, query) + scoreMatch(String(o.value), query) }))
      .filter(o => o._score > 0)
      .sort((a, b) => b._score - a._score)
  }
</script>

<script>
  // MultiSelect.mesa
  // Token input with dropdown. Supports single/multiple selection, async search,
  // keyboard navigation, min/max constraints, and new-value creation.
  //
  // OPTIONS shape:
  //   string | number | { value, label, disabled? }
  //
  // USAGE — basic multiple:
  //   <MultiSelect bind:value={tags} options={['React', 'Vue', 'Svelte']} multiple />
  //
  // USAGE — with Field wrapper:
  //   <MultiSelect label="Skills" name="skills" bind:value {options} multiple {errors} />
  //
  // USAGE — async search:
  //   <MultiSelect bind:value asyncOptions={{ trigger: searchFn, delay: 200, min: 1 }} />

  import Field from '../forms/Field.mesa'
  import { uid } from '../../utils.js'

  // ── Props ───────────────────────────────────────────────────────────────────

  export let value        = undefined    // scalar (single) or array (multiple)
  export let options      = []           // string[]|number[]|{value,label,disabled?}[]
  export let multiple     = false
  export let placeholder  = 'Select…'
  export let readonly     = false
  export let disabled     = false
  export let type         = 'string'     // 'string' | 'number' — coerces values
  export let min          = undefined    // min selections (for multiple)
  export let max          = undefined    // max selections (for multiple)
  export let allowNew     = false        // allow creating new values by typing
  export let clearable    = true         // show clear-all × when selections exist
  export let closeOnSelect = !multiple  // auto-close after single selection

  // Field integration
  export let name     = ''
  export let label    = ''
  export let hint     = ''
  export let error    = ''
  export let errors   = undefined
  export let badge    = undefined
  export let help     = undefined

  // Async search: { trigger: (query) => Promise<options[]>, delay?: number, min?: number }
  export let asyncOptions = undefined

  export let onchange = undefined   // (value) => void

  export var id = ''
  const inputId = id || uid('ms')

  // ── Internal state ───────────────────────────────────────────────────────────

  let inputValue  = ''
  let open        = false
  let activeIndex = 0       // keyboard cursor in filtered list
  let inputEl
  let containerEl
  var _debounceTimer = undefined

  // Coerce value to correct type
  function coerce(v) {
    return type === 'number' ? Number(v) : String(v)
  }

  // Normalise options to { value, textContent, disabled }
  function normalise(opt) {
    if (typeof opt === 'string' || typeof opt === 'number') {
      return { value: coerce(opt), textContent: String(opt), disabled: false }
    }
    return {
      value:       coerce(opt.value),
      textContent: opt.label ?? opt.textContent ?? String(opt.value),
      disabled:    opt.disabled ?? false,
    }
  }

  // ── Derived state ─────────────────────────────────────────────────────────────

  // Normalised options map — value → option object
  const optionsMap = {}

  // Build options map from the options prop
  $: options, () => {
    const normalised = (Array.isArray(options) ? options : []).map(normalise)
    for (const o of normalised) optionsMap[o.value] = o
  }

  // Selected values as a Set for O(1) lookup
  const selectedValues = new Set(
    multiple
      ? (Array.isArray(value) ? value : []).map(coerce)
      : value != null ? [coerce(value)] : []
  )

  // Sync selected set when value prop changes from outside
  $: value, () => {
    selectedValues.clear()
    const vals = multiple ? (Array.isArray(value) ? value : []) : value != null ? [value] : []
    for (const v of vals) selectedValues.add(coerce(v))
  }

  // Selected option objects in order of selection
  const selectedItems = [...selectedValues]
    .map(v => optionsMap[v])
    .filter(Boolean)

  // Re-derive selected items when selectedValues changes
  $: selectedValues, () => {
    // Trigger re-render — selectedItems is recomputed reactively
  }

  // Filtered dropdown options
  const filtered = (() => {
    const all = Object.values(optionsMap)
    const results = filterOptions(all, inputValue)
    // Don't show already-selected in single mode
    if (!multiple) return results.filter(o => !selectedValues.has(o.value))
    return results
  })()

  // Reset cursor when filter changes
  $: inputValue, () => { activeIndex = 0 }

  // ── Constraints ───────────────────────────────────────────────────────────────

  const canAdd    = () => !max || selectedValues.size < max
  const canRemove = () => !min || selectedValues.size > min

  // ── Selection actions ──────────────────────────────────────────────────────

  function add(opt) {
    if (readonly || disabled || !canAdd()) return
    selectedValues.add(opt.value)
    optionsMap[opt.value] = opt
    commitValue()
    if (closeOnSelect) open = false
    if (closeOnSelect) inputValue = ''
  }

  function remove(val) {
    if (readonly || disabled || !canRemove()) return
    selectedValues.delete(coerce(val))
    commitValue()
  }

  function clearAll() {
    if (readonly || disabled) return
    selectedValues.clear()
    inputValue = ''
    commitValue()
  }

  function commitValue() {
    const vals = [...selectedValues]
    value = multiple ? vals : (vals[0] ?? undefined)
    onchange?.(value)
  }

  // ── Dropdown visibility ──────────────────────────────────────────────────────

  function openDropdown() {
    if (readonly || disabled || (!canAdd() && !multiple)) return
    open = true
    inputEl?.focus()
  }

  function closeDropdown() {
    open = false
    activeIndex = 0
  }

  // ── Keyboard navigation ──────────────────────────────────────────────────────

  function handleKeydown(e) {
    if (e.key === 'Escape') { closeDropdown(); return }

    if (e.key === 'ArrowDown') {
      e.preventDefault()
      open = true
      activeIndex = Math.min(activeIndex + 1, filtered.length - 1)
      return
    }

    if (e.key === 'ArrowUp') {
      e.preventDefault()
      activeIndex = Math.max(activeIndex - 1, 0)
      return
    }

    if (e.key === 'Enter') {
      e.preventDefault()
      if (!open) { open = true; return }
      const target = filtered[activeIndex]
      if (target) {
        selectedValues.has(target.value) ? remove(target.value) : add(target)
      } else if (allowNew && inputValue.trim()) {
        const newOpt = { value: coerce(inputValue.trim()), textContent: inputValue.trim(), disabled: false }
        add(newOpt)
        inputValue = ''
      }
      return
    }

    if (e.key === 'Backspace' && !inputValue && canRemove() && selectedValues.size) {
      const last = [...selectedValues].at(-1)
      remove(last)
      return
    }

    open = true
  }

  function handleBlur(e) {
    // Delay close so option click fires first
    setTimeout(() => {
      if (!containerEl?.contains(document.activeElement)) closeDropdown()
    }, 150)
  }

  // ── Async search ──────────────────────────────────────────────────────────────

  $: inputValue, () => {
    if (!asyncOptions) return
    clearTimeout(_debounceTimer)
    const q = inputValue?.trim() ?? ''
    if (q.length < (asyncOptions.min ?? 1)) return
    _debounceTimer = setTimeout(async () => {
      const results = await asyncOptions.trigger(q)
      const normalised = (results ?? []).map(normalise)
      for (const o of normalised) optionsMap[o.value] = o
    }, asyncOptions.delay ?? 200)
  }

  // ── Click outside ────────────────────────────────────────────────────────────

  var _outsideHandler = null
  $onMount(() => {
    _outsideHandler = (e) => {
      if (containerEl && !containerEl.contains(e.target)) closeDropdown()
    }
    document.addEventListener('click', _outsideHandler, { capture: true })
  })
  $onDestroy(() => {
    document.removeEventListener('click', _outsideHandler, { capture: true })
    clearTimeout(_debounceTimer)
  })

  // ── Dropdown animation ────────────────────────────────────────────────────────

  const dropdownAnim = $.entrance({
    in:  el => el.animate(
      [{ opacity: 0, transform: 'translateY(-4px)' }, { opacity: 1, transform: 'translateY(0)' }],
      { duration: 120, easing: 'ease-out', fill: 'forwards' }
    ),
    out: el => el.animate(
      [{ opacity: 1 }, { opacity: 0 }],
      { duration: 80, fill: 'forwards' }
    ).finished,
  })
</script>

{#snippet control()}
  <div
    bind:this={containerEl}
    class="relative"
  >
    <!-- Token input area -->
    <div
      class="flex flex-wrap items-center gap-1.5 min-h-[2.25rem] w-full rounded-md border
             px-2.5 py-1.5 text-sm shadow-sm transition-colors cursor-text
             {open ? 'border-blue-400 ring-2 ring-blue-100' : 'border-gray-300'}
             {error || errors?.[name] ? 'border-red-300 ring-red-100' : ''}
             {disabled ? 'bg-gray-50 cursor-not-allowed opacity-60' : 'bg-white'}"
      role="button"
      tabindex="-1"
      on:click={openDropdown}
    >
      <!-- Selected tokens -->
      {#each [...selectedValues] as val (val)}
        {@const opt = optionsMap[val]}
        {#if opt}
          <span
            class="inline-flex items-center gap-1 rounded-md bg-gray-100 px-2 py-0.5
                   text-xs font-medium text-gray-700"
          >
            {opt.textContent}
            {#if !readonly && !disabled}
              <button
                type="button"
                class="rounded text-gray-400 hover:text-gray-600 transition-colors
                       focus-visible:outline-none focus-visible:ring-1 focus-visible:ring-blue-500"
                aria-label="Remove {opt.textContent}"
                on:click|stopPropagation={() => remove(val)}
              >
                <svg class="h-3 w-3" viewBox="0 0 20 20" fill="currentColor">
                  <path d="M6.28 5.22a.75.75 0 0 0-1.06 1.06L8.94 10l-3.72 3.72a.75.75 0 1 0 1.06 1.06L10 11.06l3.72 3.72a.75.75 0 1 0 1.06-1.06L11.06 10l3.72-3.72a.75.75 0 0 0-1.06-1.06L10 8.94 6.28 5.22z"/>
                </svg>
              </button>
            {/if}
          </span>
        {/if}
      {/each}

      <!-- Search input -->
      {#if !readonly && !disabled}
        <input
          bind:this={inputEl}
          bind:value={inputValue}
          id={inputId}
          type="text"
          autocomplete="off"
          spellcheck="false"
          placeholder={selectedValues.size === 0 ? placeholder : ''}
          class="flex-1 min-w-[6rem] border-0 bg-transparent p-0 text-sm text-gray-700
                 placeholder:text-gray-400 focus:outline-none focus:ring-0"
          aria-expanded={open}
          aria-haspopup="listbox"
          aria-autocomplete="list"
          on:keydown={handleKeydown}
          on:blur={handleBlur}
          on:focus={() => open = true}
        />
      {/if}

      <!-- Trailing icons -->
      <div class="ml-auto flex items-center gap-1 shrink-0">
        {#if clearable && selectedValues.size > 0 && !readonly && !disabled}
          <button
            type="button"
            class="rounded p-0.5 text-gray-400 hover:text-gray-600 transition-colors
                   focus-visible:outline-none focus-visible:ring-1 focus-visible:ring-blue-500"
            aria-label="Clear all"
            on:click|stopPropagation={clearAll}
          >
            <svg class="h-3.5 w-3.5" viewBox="0 0 20 20" fill="currentColor">
              <path d="M6.28 5.22a.75.75 0 0 0-1.06 1.06L8.94 10l-3.72 3.72a.75.75 0 1 0 1.06 1.06L10 11.06l3.72 3.72a.75.75 0 1 0 1.06-1.06L11.06 10l3.72-3.72a.75.75 0 0 0-1.06-1.06L10 8.94 6.28 5.22z"/>
            </svg>
          </button>
        {/if}
        <!-- Chevron -->
        <svg
          class="h-4 w-4 text-gray-400 transition-transform {open ? 'rotate-180' : ''}"
          viewBox="0 0 20 20" fill="currentColor" aria-hidden="true"
        >
          <path fill-rule="evenodd" d="M5.22 8.22a.75.75 0 0 1 1.06 0L10 11.94l3.72-3.72a.75.75 0 1 1 1.06 1.06l-4.25 4.25a.75.75 0 0 1-1.06 0L5.22 9.28a.75.75 0 0 1 0-1.06z" clip-rule="evenodd"/>
        </svg>
      </div>
    </div>

    <!-- Dropdown -->
    {#if open}
      <div
        class="absolute left-0 right-0 top-full z-50 mt-1 rounded-lg border border-gray-200
               bg-white shadow-lg overflow-hidden"
        {@attach dropdownAnim}
        role="listbox"
        aria-multiselectable={multiple}
      >
        <!-- Options — use {#virtual each} when list > 100 items would be ideal;
             for now standard each with max-height scroll -->
        <ul class="max-h-48 overflow-y-auto py-1" style:scrollbar-width="thin">
          {#if filtered.length === 0}
            <li class="px-3 py-2 text-sm text-gray-400 text-center">
              {allowNew && inputValue.trim()
                ? `Press Enter to add "${inputValue.trim()}"`
                : 'No options'}
            </li>
          {:else}
            {#each filtered as opt, i (opt.value)}
              {@const isSelected = selectedValues.has(opt.value)}
              {@const isActive   = i === activeIndex}
              <li
                class="flex items-center justify-between px-3 py-2 text-sm cursor-pointer
                       transition-colors
                       {isActive   ? 'bg-blue-50 text-blue-700' : 'text-gray-700'}
                       {isSelected ? 'font-medium' : ''}
                       {opt.disabled ? 'opacity-40 cursor-not-allowed pointer-events-none' : 'hover:bg-gray-50'}"
                role="option"
                aria-selected={isSelected}
                on:mouseenter={() => activeIndex = i}
                on:click|preventDefault={() => isSelected ? remove(opt.value) : add(opt)}
              >
                <span>{opt.textContent}</span>
                {#if isSelected}
                  <svg class="h-4 w-4 text-blue-600 shrink-0" viewBox="0 0 20 20" fill="currentColor">
                    <path fill-rule="evenodd" d="M16.704 4.153a.75.75 0 0 1 .143 1.052l-8 10.5a.75.75 0 0 1-1.127.075l-4.5-4.5a.75.75 0 0 1 1.06-1.06l3.894 3.893 7.48-9.817a.75.75 0 0 1 1.05-.143Z" clip-rule="evenodd"/>
                  </svg>
                {/if}
              </li>
            {/each}
          {/if}
        </ul>
      </div>
    {/if}
  </div>
{/snippet}

{#if label || (name && !label)}
  <Field
    id={inputId}
    name={name}
    label={label || name}
    hint={hint}
    error={error}
    errors={errors}
    badge={badge}
    help={help}
    {class}
  >
    {@render control()}
  </Field>
{:else}
  <div {class}>
    {@render control()}
  </div>
{/if}
