<script>
  // Input.mesa
  // Flexible text input. When a label prop is provided, the component self-wraps
  // in <Field>, giving you label + input + hint + error in one declaration.
  //
  // Naked (inside explicit Field):
  //   <Field label="Email" name="email" {errors}>
  //     <Input type="email" bind:value={email} />
  //   </Field>
  //
  // Shorthand (Field implicit):
  //   <Input label="Email" name="email" type="email" bind:value={email} {errors} />
  //
  // bind:this exposes: focus(), select()

  import Field from './Field.mesa'
  import { nameToLabel, uid } from '../../utils.js'

  // Core input props
  export let value       = ''
  export let type        = 'text'
  export let placeholder = ''
  export let disabled    = false
  export let required    = undefined
  export let readonly    = false
  export let pattern     = undefined
  export let min         = undefined
  export let max         = undefined
  export let step        = undefined
  export let autocomplete = undefined
  export let icon        = undefined   // trailing icon name (svg slot)
  export let datalist    = undefined   // string[] — renders <datalist>

  // Field integration props (only used when label is set)
  export let name     = ''
  export let label    = ''             // '' = naked, no Field wrapper
  export let hint     = ''
  export let error    = ''
  export let errors   = undefined
  export let badge    = undefined
  export let help     = undefined
  export let removable = false
  export let onremovekey = undefined  // forwarded to Field's × button
  // Native event callbacks — called when the underlying <input> fires
  export let onchange  = undefined
  export let onblur    = undefined
  export let onfocus   = undefined
  export let onkeydown = undefined
  export let onkeypress = undefined

  // id — snapshot at mount, stable for label association
  export var id = ''

  const inputId   = id || uid('input')
  const listId    = datalist ? `${inputId}-list` : undefined
  const autoLabel = nameToLabel(name)

  // Derived from error state — controls ring color
  const ringClass = error || errors?.[name]
    ? 'border-red-300 focus:border-red-400 focus:ring-red-200 bg-red-50/30'
    : 'border-gray-300 focus:border-blue-400 focus:ring-blue-100 bg-white'

  // Exported methods — exposed via bind:this on this component
  let inputEl
  export function focus()  { inputEl?.focus() }
  export function select() { inputEl?.select() }

  function handleInput(e) {
    value = type === 'number' ? Number(e.target.value) : e.target.value
  }
</script>

<!-- Snippet: the raw input element — rendered either inside Field or standalone -->
{#snippet control()}
  <input
    bind:this={inputEl}
    id={inputId}
    name={name || undefined}
    type={type}
    value={value}
    placeholder={placeholder}
    disabled={disabled}
    required={required}
    readonly={readonly}
    pattern={pattern}
    min={min}
    max={max}
    step={step}
    autocomplete={autocomplete}
    list={listId}
    aria-invalid={!!(error || errors?.[name])}
    class="block w-full rounded-md border px-3 py-2 text-sm shadow-sm transition-colors
           placeholder:text-gray-400 focus:outline-none focus:ring-2 focus:ring-offset-0
           disabled:bg-gray-50 disabled:text-gray-500 disabled:cursor-not-allowed
           read-only:bg-gray-50 read-only:text-gray-600
           {icon ? 'pr-9' : ''}
           {ringClass}"
    on:input={handleInput}
    on:change={onchange}
    on:blur={onblur}
    on:focus={onfocus}
    on:keydown={onkeydown}
    on:keypress={onkeypress}
  />
  {#if icon}
    <span class="pointer-events-none absolute inset-y-0 right-0 flex items-center pr-2.5 text-gray-400">
      {@render icon?.()}
    </span>
  {/if}
{/snippet}

{#if label || name}
  {@const resolvedLabel = label || autoLabel}
  <Field
    id={inputId}
    name={name}
    label={resolvedLabel}
    required={required}
    badge={badge}
    help={help}
    hint={hint}
    error={error}
    errors={errors}
    type={type}
    removable={removable}
    onremovekey={onremovekey}
    {class}
  >
    {@render control()}
  </Field>
{:else}
  <div class="relative" {class}>
    {@render control()}
  </div>
{/if}

{#if datalist}
  <datalist id={listId}>
    {#each datalist as opt (opt)}
      <option value={opt} />
    {/each}
  </datalist>
{/if}
