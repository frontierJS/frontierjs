<script>
  // Label.mesa
  // Standalone label component. Used internally by Field and directly where needed.
  //
  // Props:
  //   label    — display text (required to render anything)
  //   id       — for="" attribute linking to input
  //   required — boolean; when false AND badge not set, shows "(Optional)"
  //   badge    — explicit override badge text e.g. "Required", "Beta", "New"
  //              when set, always shown regardless of required prop
  //   help     — string or { text, icon? } — tooltip icon at end of label
  //   type     — forwarded from input; suppresses Optional for checkbox/radio/search
  //   children — extra content appended inline (e.g. remove-key × button)
  export let label    = ''
  export let id       = undefined
  export let required = undefined  // undefined = not specified, false = show optional
  export let badge    = undefined  // explicit badge text
  export let help     = undefined  // string or { text }
  // type is snapshot at mount — label style decisions are fixed at init
  // (a label for a checkbox doesn't become a label for a text input)
  export var type = undefined

  // Static: which types suppress the "(Optional)" hint
  const suppressOptional = ['checkbox', 'radio', 'search', 'hidden', 'file'].includes(type)

  // Derived: badge display text.
  // Explicit badge prop always wins. Otherwise show "(Optional)" when not required
  // and type doesn't suppress it. Required fields show nothing extra.
  const badgeText = badge ?? (!required && !suppressOptional ? 'Optional' : null)

  const helpText = typeof help === 'string' ? help : help?.text
</script>

{#if label}
  <label
    for={id}
    class="inline-flex items-center gap-1.5 text-xs font-semibold text-gray-700
           {type === 'checkbox' || type === 'radio' ? 'cursor-pointer' : ''}"
    {class}
  >
    {label}

    {#if badgeText}
      <span class="text-[10px] font-normal italic text-gray-400 leading-none">
        ({badgeText})
      </span>
    {/if}

    <slot />

    {#if helpText}
      <span
        class="inline-flex items-center text-gray-400 hover:text-gray-600
               cursor-help transition-colors"
        title={helpText}
        aria-label={helpText}
      >
        <!-- Question mark circle icon -->
        <svg class="w-3.5 h-3.5" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 20 20" fill="currentColor" aria-hidden="true">
          <path fill-rule="evenodd" d="M18 10a8 8 0 1 1-16 0 8 8 0 0 1 16 0ZM8.94 6.94a.75.75 0 1 1-1.061-1.061 3 3 0 1 1 2.871 5.026v.345a.75.75 0 0 1-1.5 0v-.5c0-.72.57-1.172 1.081-1.287A1.5 1.5 0 1 0 8.94 6.94ZM10 15a1 1 0 1 0 0-2 1 1 0 0 0 0 2Z" clip-rule="evenodd" />
        </svg>
      </span>
    {/if}
  </label>
{/if}
