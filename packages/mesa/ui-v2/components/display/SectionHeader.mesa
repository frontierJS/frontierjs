<script>
  // SectionHeader.mesa
  // Title + optional subtitle + optional trailing action area.
  // Used at the top of pages, settings sections, card groups.
  //
  // Usage:
  //   <SectionHeader title="Team members" sub="Manage who has access" />
  //
  //   <SectionHeader title="API Keys">
  //     {#snippet action()}
  //       <Button size="sm">New key</Button>
  //     {/snippet}
  //   </SectionHeader>
  //
  //   <SectionHeader title="Billing" size="sm" border />

  export let title    = ''
  export let sub      = ''
  export let size     = 'md'     // 'sm' | 'md' | 'lg'
  export let border   = false    // bottom border + extra pb
  export let action   = null     // snippet — rendered trailing right

  const titleSizeMap = { sm: 'text-sm font-semibold', md: 'text-base font-semibold', lg: 'text-lg font-semibold' }
  const subSizeMap   = { sm: 'text-xs', md: 'text-sm', lg: 'text-sm' }

  const titleClass = titleSizeMap[size] ?? titleSizeMap.md
  const subClass   = subSizeMap[size]   ?? subSizeMap.md

  const hasAction = action || children
</script>

<div
  class="flex items-start justify-between gap-4
         {border ? 'border-b border-gray-200 pb-4' : ''}"
  {class}
>
  <div class="flex flex-col gap-0.5 min-w-0">
    {#if title}
      <h2 class="text-gray-900 leading-snug {titleClass}">{title}</h2>
    {/if}
    {#if sub}
      <p class="text-gray-500 leading-snug {subClass}">{sub}</p>
    {/if}
  </div>

  {#if hasAction}
    <div class="flex shrink-0 items-center gap-2">
      {#if action}
        {@render action?.()}
      {:else}
        <slot />
      {/if}
    </div>
  {/if}
</div>
