<script>
  // Pill.mesa
  // Small readonly label chip. Covers general status labels and plan badges.
  // For interactive dismissible chips, use Tag.mesa.
  //
  // color: semantic name or 'plan' shorthand via `plan` prop
  //
  // Usage:
  //   <Pill color="green">Active</Pill>
  //   <Pill color="blue">New</Pill>
  //   <Pill plan="pro" />          ← PlanBadge shorthand
  //   <Pill plan="enterprise" />

  export let color    = 'gray'   // 'gray'|'green'|'red'|'yellow'|'blue'|'purple'|'orange'|'cyan'
  export let size     = 'sm'     // 'xs'|'sm'|'md'
  export let dot      = false    // show a leading Dot
  export let plan     = ''       // 'free'|'pro'|'business'|'enterprise' — overrides color+children
  // Plan → color + label map — static, computed once
  const planMap = {
    free:       { color: 'gray',   label: 'Free'       },
    pro:        { color: 'blue',   label: 'Pro'         },
    business:   { color: 'purple', label: 'Business'    },
    enterprise: { color: 'slate',  label: 'Enterprise'  },
  }

  // Resolved values — plan prop overrides color and children
  const resolvedPlan  = plan ? planMap[plan] : null
  const resolvedColor = resolvedPlan?.color ?? color
  const planLabel     = resolvedPlan?.label ?? ''

  const sizeMap = {
    xs: 'px-1.5 py-0.5 text-[10px] gap-1',
    sm: 'px-2   py-0.5 text-xs     gap-1',
    md: 'px-2.5 py-1   text-sm     gap-1.5',
  }

  const colorMap = {
    gray:   'bg-gray-100   text-gray-600   border border-gray-200',
    green:  'bg-green-50   text-green-700  border border-green-200',
    red:    'bg-red-50     text-red-700    border border-red-200',
    yellow: 'bg-yellow-50  text-yellow-700 border border-yellow-200',
    blue:   'bg-blue-50    text-blue-700   border border-blue-200',
    purple: 'bg-purple-50  text-purple-700 border border-purple-200',
    orange: 'bg-orange-50  text-orange-700 border border-orange-200',
    cyan:   'bg-cyan-50    text-cyan-700   border border-cyan-200',
    slate:  'bg-slate-800  text-white      border border-slate-700',
  }

  const dotColorMap = {
    gray: 'gray', green: 'green', red: 'red', yellow: 'yellow',
    blue: 'blue', purple: 'blue', orange: 'orange', cyan: 'blue', slate: 'gray',
  }

  const szKey   = size in sizeMap ? size : 'sm'
  const szClass = sizeMap[szKey]
  const colClass = colorMap[resolvedColor] ?? colorMap.gray
  const dotColor = dotColorMap[resolvedColor] ?? 'gray'
</script>

<span
  class="inline-flex items-center font-medium rounded-full {szClass} {colClass}"
  {class}
>
  {#if dot}
    <span class="h-1.5 w-1.5 rounded-full bg-current opacity-70 shrink-0"></span>
  {/if}
  {#if planLabel}
    {planLabel}
  {:else}
    <slot />
  {/if}
</span>
