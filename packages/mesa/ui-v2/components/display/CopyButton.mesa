<script>
  // CopyButton.mesa
  // Copies text to clipboard. Shows a ✓ checkmark for `feedbackDuration` ms.
  // Can render as an icon-only button or with a label.
  //
  // Usage — icon only (most common, e.g. next to API keys):
  //   <CopyButton text={apiKey} />
  //
  // Usage — with label:
  //   <CopyButton text={snippet} label="Copy" />
  //
  // Usage — custom trigger snippet:
  //   <CopyButton text={code}>
  //     {#snippet trigger(copied)}
  //       <span>{copied ? 'Copied!' : 'Copy code'}</span>
  //     {/snippet}
  //   </CopyButton>

  export let text             = ''       // text to copy
  export let label            = ''       // optional button label
  export let feedbackDuration = 2000    // ms to show ✓ before reverting
  export let variant          = 'ghost' // passed to button styling
  export let size             = 'sm'
  export let trigger          = null    // optional snippet(copied: boolean)
  export let oncopy           = undefined // (text) => void — callback after copy

  let copied = false
  var _timer = null

  async function copy() {
    if (!text) return
    try {
      await navigator.clipboard.writeText(text)
    } catch {
      // Fallback for older browsers / non-HTTPS
      const el = document.createElement('textarea')
      el.value = text
      el.style.cssText = 'position:fixed;opacity:0'
      document.body.appendChild(el)
      el.select()
      document.execCommand('copy')
      document.body.removeChild(el)
    }
    copied = true
    oncopy?.(text)
    clearTimeout(_timer)
    _timer = setTimeout(() => { copied = false }, feedbackDuration)
  }

  $onDestroy(() => clearTimeout(_timer))

  // Button sizing — mirrors Btn
  const sizeMap = {
    xs: 'h-6 w-6 p-1   rounded',
    sm: 'h-7 w-7 p-1.5 rounded-md',
    md: 'h-8 w-8 p-2   rounded-md',
  }
  const sz = label ? '' : (sizeMap[size] ?? sizeMap.sm)

  const base = 'inline-flex items-center justify-center gap-1.5 font-medium text-xs transition-colors focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-blue-500 focus-visible:ring-offset-1'
  const variantClass = copied
    ? 'text-green-600 bg-green-50 hover:bg-green-100'
    : 'text-gray-500 hover:text-gray-700 hover:bg-gray-100'
</script>

<button
  type="button"
  class="{base} {variantClass} {sz} {label ? 'px-2.5' : ''}"
  {class}
  aria-label={label || (copied ? 'Copied!' : 'Copy to clipboard')}
  on:click={copy}
>
  {#if trigger}
    {@render trigger?.(copied)}
  {:else}
    {#if copied}
      <!-- Checkmark -->
      <svg class="h-3.5 w-3.5 shrink-0" viewBox="0 0 20 20" fill="currentColor" aria-hidden="true">
        <path fill-rule="evenodd" d="M16.704 4.153a.75.75 0 0 1 .143 1.052l-8 10.5a.75.75 0 0 1-1.127.075l-4.5-4.5a.75.75 0 0 1 1.06-1.06l3.894 3.893 7.48-9.817a.75.75 0 0 1 1.05-.143Z" clip-rule="evenodd"/>
      </svg>
    {:else}
      <!-- Clipboard icon -->
      <svg class="h-3.5 w-3.5 shrink-0" viewBox="0 0 20 20" fill="currentColor" aria-hidden="true">
        <path fill-rule="evenodd" d="M13.887 3.182c.396.037.79.08 1.183.128C16.194 3.45 17 4.414 17 5.517V16.25A2.25 2.25 0 0 1 14.75 18.5h-9.5A2.25 2.25 0 0 1 3 16.25V5.517c0-1.103.806-2.068 1.93-2.207.393-.048.787-.09 1.183-.128A3.001 3.001 0 0 1 9 1.5h2c1.373 0 2.531.923 2.887 2.182ZM7.5 4.75a1.5 1.5 0 0 1 1.5-1.5h2a1.5 1.5 0 0 1 1.5 1.5v.25h-5v-.25Z" clip-rule="evenodd"/>
      </svg>
    {/if}
    {#if label}
      <span>{copied ? 'Copied!' : label}</span>
    {/if}
  {/if}
</button>
