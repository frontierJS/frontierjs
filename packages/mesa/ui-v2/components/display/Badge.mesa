<script>
  // Badge.mesa
  // Compact count or label badge. Can float over a parent element (absolute)
  // or render inline. Evolved from your Badge.svelte <sup> pattern.
  //
  // Usage — inline:
  //   <Badge>3</Badge>
  //   <Badge color="red">99+</Badge>
  //
  // Usage — floating over icon (position="absolute"):
  //   <div class="relative inline-flex">
  //     <IconBell />
  //     <Badge position="absolute" color="red">4</Badge>
  //   </div>

  export let color    = 'gray'      // 'gray'|'red'|'blue'|'green'|'yellow'|'purple'
  export let size     = 'sm'        // 'xs' | 'sm' | 'md'
  export let position = 'inline'    // 'inline' | 'absolute'
  const colorMap = {
    gray:   'bg-gray-100 text-gray-600 ring-gray-200',
    red:    'bg-red-500  text-white    ring-red-600',
    blue:   'bg-blue-500 text-white    ring-blue-600',
    green:  'bg-green-500 text-white   ring-green-600',
    yellow: 'bg-yellow-400 text-yellow-900 ring-yellow-500',
    purple: 'bg-purple-500 text-white  ring-purple-600',
  }

  const sizeMap = {
    xs: 'px-1   py-px  text-[9px]  min-w-[1rem]   h-4',
    sm: 'px-1.5 py-0.5 text-[10px] min-w-[1.25rem] h-5',
    md: 'px-2   py-0.5 text-xs     min-w-[1.5rem]  h-6',
  }

  const col = colorMap[color] ?? colorMap.gray
  const sz  = sizeMap[size]   ?? sizeMap.sm

  // Absolute positioning: top-right corner of a positioned parent
  const posClass = position === 'absolute'
    ? 'absolute -top-1.5 -right-1.5 z-10'
    : 'inline-flex'
</script>

<span
  class="inline-flex items-center justify-center rounded-full font-semibold tabular-nums
         ring-1 ring-inset leading-none
         {posClass} {col} {sz}"
  {class}
>
  <slot />
</span>
