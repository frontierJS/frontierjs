<script>
  // Pagination.mesa
  // Page controls for tables and lists. Shows a sliding window of pages
  // with ellipsis compression. Bindable currentPage.
  //
  // Usage:
  //   <Pagination bind:page={currentPage} total={450} perPage={25} />
  //
  //   <!-- With callback -->
  //   <Pagination
  //     page={currentPage}
  //     total={totalRows}
  //     perPage={pageSize}
  //     onchange={(p) => loadPage(p)}
  //   />
  //
  //   <!-- Compact (no page buttons, just prev/next + label) -->
  //   <Pagination compact bind:page total={200} perPage={20} />

  export let page     = 1        // bindable — current page (1-indexed)
  export let total    = 0        // total item count
  export let perPage  = 25       // items per page
  export let window   = 5        // max visible page buttons (odd number works best)
  export let compact  = false    // prev/next only with "Page X of Y" label
  export let showInfo = true     // "Showing X–Y of Z"
  export let onchange = undefined // (page: number) => void

  // Total page count — derived from total + perPage
  const pageCount = Math.max(1, Math.ceil(total / perPage))

  // Items shown on current page — for the info label
  const rangeStart = Math.min((page - 1) * perPage + 1, total)
  const rangeEnd   = Math.min(page * perPage, total)

  // Generate the visible page window — array of numbers and 'ellipsis' markers
  const pages = (() => {
    if (pageCount <= window) return Array.from({ length: pageCount }, (_, i) => i + 1)

    const half  = Math.floor(window / 2)
    let start   = Math.max(1, page - half)
    let end     = Math.min(pageCount, start + window - 1)

    // Adjust start if end is at max
    if (end === pageCount) start = Math.max(1, end - window + 1)

    const result = []
    if (start > 1)         { result.push(1); if (start > 2) result.push('...') }
    for (let i = start; i <= end; i++) result.push(i)
    if (end < pageCount)   { if (end < pageCount - 1) result.push('...'); result.push(pageCount) }
    return result
  })()

  function goTo(p) {
    if (p < 1 || p > pageCount || p === page) return
    page = p
    onchange?.(p)
  }

  const btnBase = 'inline-flex items-center justify-center h-8 min-w-[2rem] rounded-md text-sm font-medium transition-colors focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-blue-500 focus-visible:ring-offset-1 disabled:opacity-40 disabled:pointer-events-none'
  const btnActive   = 'bg-blue-600 text-white shadow-sm'
  const btnInactive = 'text-gray-600 hover:bg-gray-100'
  const btnNav      = 'px-2 text-gray-500 hover:bg-gray-100 hover:text-gray-700'
</script>

<div class="flex flex-col gap-2" {class}>
  <div class="flex items-center justify-between gap-4 flex-wrap">
    {#if showInfo && total > 0}
      <p class="text-xs text-gray-500 shrink-0">
        Showing <span class="font-medium text-gray-700">{rangeStart}–{rangeEnd}</span>
        of <span class="font-medium text-gray-700">{total}</span>
      </p>
    {:else}
      <div></div>
    {/if}

    <nav class="flex items-center gap-1" aria-label="Pagination">
      <!-- Previous -->
      <button
        type="button"
        class="{btnBase} {btnNav} px-2.5"
        disabled={page <= 1}
        aria-label="Previous page"
        on:click={() => goTo(page - 1)}
      >
        <svg class="h-4 w-4" viewBox="0 0 20 20" fill="currentColor" aria-hidden="true">
          <path fill-rule="evenodd" d="M11.78 5.22a.75.75 0 0 1 0 1.06L8.06 10l3.72 3.72a.75.75 0 1 1-1.06 1.06l-4.25-4.25a.75.75 0 0 1 0-1.06l4.25-4.25a.75.75 0 0 1 1.06 0Z" clip-rule="evenodd"/>
        </svg>
        {#if !compact}<span class="hidden sm:inline text-xs">Prev</span>{/if}
      </button>

      {#if compact}
        <span class="px-3 text-xs text-gray-600 font-medium">
          Page {page} of {pageCount}
        </span>
      {:else}
        <!-- Page buttons -->
        {#each pages as p (p + '-' + page)}
          {#if p === '...'}
            <span class="px-1 text-gray-400 text-sm select-none">…</span>
          {:else}
            <button
              type="button"
              class="{btnBase} px-2.5 {p === page ? btnActive : btnInactive}"
              aria-label="Page {p}"
              aria-current={p === page ? 'page' : undefined}
              on:click={() => goTo(p)}
            >
              {p}
            </button>
          {/if}
        {/each}
      {/if}

      <!-- Next -->
      <button
        type="button"
        class="{btnBase} {btnNav} px-2.5"
        disabled={page >= pageCount}
        aria-label="Next page"
        on:click={() => goTo(page + 1)}
      >
        {#if !compact}<span class="hidden sm:inline text-xs">Next</span>{/if}
        <svg class="h-4 w-4" viewBox="0 0 20 20" fill="currentColor" aria-hidden="true">
          <path fill-rule="evenodd" d="M8.22 5.22a.75.75 0 0 1 1.06 0l4.25 4.25a.75.75 0 0 1 0 1.06l-4.25 4.25a.75.75 0 0 1-1.06-1.06L11.94 10 8.22 6.28a.75.75 0 0 1 0-1.06Z" clip-rule="evenodd"/>
        </svg>
      </button>
    </nav>
  </div>
</div>
