<script>
  // Stat.mesa
  // Raw metric display — value, label, optional sub-text, optional trend indicator.
  // Composes into StatCard for the full bordered tile.
  //
  // Usage:
  //   <Stat label="Total revenue" value="$48,295" sub="+12% from last month" trend="up" />
  //   <Stat label="Active users" value={count} />

  export let label  = ''
  export let value  = ''
  export let sub    = ''
  export let trend  = ''     // 'up' | 'down' | 'flat' | ''
  export let color  = ''     // '' | 'green' | 'red' | 'blue' | 'yellow' — tints the value

  const trendMap = {
    up:   { icon: '↑', class: 'text-green-600' },
    down: { icon: '↓', class: 'text-red-600'   },
    flat: { icon: '→', class: 'text-gray-400'  },
  }

  const valueColorMap = {
    '':      'text-gray-900',
    green:   'text-green-600',
    red:     'text-red-600',
    blue:    'text-blue-600',
    yellow:  'text-yellow-600',
  }

  const t          = trendMap[trend] ?? null
  const valueColor = valueColorMap[color] ?? valueColorMap['']
</script>

<div class="flex flex-col gap-1" {class}>
  {#if label}
    <p class="text-xs font-medium text-gray-500 uppercase tracking-wide leading-none">
      {label}
    </p>
  {/if}

  <div class="flex items-baseline gap-2">
    <span class="text-2xl font-bold tabular-nums leading-none {valueColor}">
      {value}
    </span>
    {#if t}
      <span class="text-sm font-medium {t.class}">{t.icon}</span>
    {/if}
  </div>

  {#if sub}
    <p class="text-xs text-gray-500 leading-snug">{sub}</p>
  {/if}
</div>
