<script>
  // Mono.mesa
  // Inline monospace text — for code snippets, IDs, paths, keys.
  // Renders as <code> for semantics.
  //
  // Usage:
  //   <Mono>npm install @mesa/runtime</Mono>
  //   <Mono size="xs">user_8x92ka</Mono>
  //   The config lives at <Mono>~/.config/mesa.json</Mono>

  export let size     = 'sm'    // 'xs' | 'sm' | 'base'
  const sizeMap = { xs: 'text-[11px]', sm: 'text-xs', base: 'text-sm' }
  const sz = sizeMap[size] ?? sizeMap.sm
</script>

<code
  class="rounded bg-gray-100 px-1.5 py-0.5 font-mono {sz}
         text-gray-800 ring-1 ring-inset ring-gray-200"
  {class}
>
  <slot />
</code>
