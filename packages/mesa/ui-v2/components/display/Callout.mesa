<script>
  // Callout.mesa
  // Inline aside for tips, notes, warnings. Not dismissible — persistent contextual info.
  // Lighter visual weight than Alert (no icon emphasis, no dismiss button).
  // Use Alert for system feedback; use Callout for editorial/instructional content.
  //
  // Usage:
  //   <Callout>Enable 2FA in Settings > Security before continuing.</Callout>
  //
  //   <Callout type="warning" title="Breaking change">
  //     This API will be removed in v3.0.
  //   </Callout>
  //
  //   <Callout type="tip">
  //     You can also use <Mono>⌘K</Mono> to open the command palette.
  //   </Callout>

  export let type     = 'info'   // 'info' | 'tip' | 'warning' | 'error' | 'note'
  export let title    = ''
  const styleMap = {
    info:    { wrap: 'bg-blue-50 border-blue-200',   title: 'text-blue-800',  body: 'text-blue-700',  icon: 'text-blue-500'   },
    tip:     { wrap: 'bg-green-50 border-green-200', title: 'text-green-800', body: 'text-green-700', icon: 'text-green-500'  },
    warning: { wrap: 'bg-amber-50 border-amber-200', title: 'text-amber-800', body: 'text-amber-700', icon: 'text-amber-500'  },
    error:   { wrap: 'bg-red-50 border-red-200',     title: 'text-red-800',   body: 'text-red-700',   icon: 'text-red-500'    },
    note:    { wrap: 'bg-gray-50 border-gray-200',   title: 'text-gray-800',  body: 'text-gray-600',  icon: 'text-gray-400'   },
  }

  const iconPathMap = {
    info:    'M11.25 11.25l.041-.02a.75.75 0 0 1 1.063.852l-.708 2.836a.75.75 0 0 0 1.063.853l.041-.021M21 12a9 9 0 1 1-18 0 9 9 0 0 1 18 0Zm-9-3.75h.008v.008H12V8.25Z',
    tip:     'M12 18v-5.25m0 0a6.01 6.01 0 0 0 1.5-.189m-1.5.189a6.01 6.01 0 0 1-1.5-.189m3.75 7.478a12.06 12.06 0 0 1-4.5 0m3.75 2.355a14.998 14.998 0 0 1-3 0M15 6.75a3 3 0 1 1-6 0 3 3 0 0 1 6 0Z',
    warning: 'M12 9v3.75m-9.303 3.376c-.866 1.5.217 3.374 1.948 3.374h14.71c1.73 0 2.813-1.874 1.948-3.374L13.949 3.378c-.866-1.5-3.032-1.5-3.898 0L2.697 16.126ZM12 15.75h.007v.008H12v-.008Z',
    error:   'M12 9v3.75m9-.75a9 9 0 1 1-18 0 9 9 0 0 1 18 0Zm-9 3.75h.008v.008H12v-.008Z',
    note:    'M16.862 4.487l1.687-1.688a1.875 1.875 0 1 1 2.652 2.652L10.582 16.07a4.5 4.5 0 0 1-1.897 1.13L6 18l.8-2.685a4.5 4.5 0 0 1 1.13-1.897l8.932-8.931Zm0 0L19.5 7.125',
  }

  const s    = styleMap[type]    ?? styleMap.info
  const path = iconPathMap[type] ?? iconPathMap.info
</script>

<aside
  class="flex gap-3 rounded-xl border px-4 py-3.5 {s.wrap}"
  {class}
>
  <svg
    class="mt-0.5 h-4 w-4 shrink-0 {s.icon}"
    xmlns="http://www.w3.org/2000/svg"
    fill="none"
    viewBox="0 0 24 24"
    stroke-width="1.5"
    stroke="currentColor"
    aria-hidden="true"
  >
    <path stroke-linecap="round" stroke-linejoin="round" d={path} />
  </svg>

  <div class="flex-1 min-w-0 text-sm {s.body} leading-relaxed">
    {#if title}
      <p class="font-semibold {s.title} mb-0.5">{title}</p>
    {/if}
    <slot />
  </div>
</aside>
