<script>
  // Tag.mesa
  // Interactive dismissible chip. Used in filter bars, tag inputs,
  // multi-select displays. For readonly labels, use Pill.
  //
  // Usage:
  //   <Tag onremove={() => removeTag(t)}>Design</Tag>
  //   <Tag color="blue" onremove={fn}>React</Tag>
  //   <Tag readonly>Archived</Tag>

  export let color    = 'gray'   // same palette as Pill
  export let readonly = false    // hide dismiss button
  export let onremove = undefined
  const colorMap = {
    gray:   'bg-gray-100  text-gray-700  hover:bg-gray-200',
    blue:   'bg-blue-50   text-blue-700  hover:bg-blue-100',
    green:  'bg-green-50  text-green-700 hover:bg-green-100',
    red:    'bg-red-50    text-red-700   hover:bg-red-100',
    yellow: 'bg-yellow-50 text-yellow-700 hover:bg-yellow-100',
    purple: 'bg-purple-50 text-purple-700 hover:bg-purple-100',
    orange: 'bg-orange-50 text-orange-700 hover:bg-orange-100',
  }

  const btnColorMap = {
    gray:   'hover:bg-gray-300   text-gray-500',
    blue:   'hover:bg-blue-200   text-blue-500',
    green:  'hover:bg-green-200  text-green-500',
    red:    'hover:bg-red-200    text-red-500',
    yellow: 'hover:bg-yellow-200 text-yellow-500',
    purple: 'hover:bg-purple-200 text-purple-500',
    orange: 'hover:bg-orange-200 text-orange-500',
  }

  const col    = colorMap[color]    ?? colorMap.gray
  const btnCol = btnColorMap[color] ?? btnColorMap.gray
</script>

<span
  class="inline-flex items-center gap-1 rounded-md px-2 py-0.5 text-xs font-medium
         transition-colors {col}"
  {class}
>
  <slot />

  {#if !readonly}
    <button
      type="button"
      class="ml-0.5 -mr-0.5 rounded p-0.5 transition-colors {btnCol}
             focus-visible:outline-none focus-visible:ring-1 focus-visible:ring-current"
      aria-label="Remove"
      on:click={onremove}
    >
      <svg class="h-2.5 w-2.5" viewBox="0 0 20 20" fill="currentColor" aria-hidden="true">
        <path d="M6.28 5.22a.75.75 0 0 0-1.06 1.06L8.94 10l-3.72 3.72a.75.75 0 1 0 1.06 1.06L10 11.06l3.72 3.72a.75.75 0 1 0 1.06-1.06L11.06 10l3.72-3.72a.75.75 0 0 0-1.06-1.06L10 8.94 6.28 5.22z"/>
      </svg>
    </button>
  {/if}
</span>
