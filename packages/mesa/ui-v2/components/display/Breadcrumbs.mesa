<script>
  // Breadcrumbs.mesa
  // Navigation trail. Last item is always non-interactive (current page).
  // Truncates long middle sections when maxItems is set.
  //
  // ITEMS shape:
  //   { label: string, href?: string, icon?: snippet }
  //   If href is omitted, the item renders as plain text.
  //
  // Usage:
  //   <Breadcrumbs items={[
  //     { label: 'Home',     href: '/' },
  //     { label: 'Settings', href: '/settings' },
  //     { label: 'API Keys' },
  //   ]} />
  //
  // Usage — custom separator:
  //   <Breadcrumbs {items} separator="/" />
  //
  // Usage — truncate long trails:
  //   <Breadcrumbs {items} maxItems={3} />

  export let items     = []    // { label, href?, icon? }[]
  export let separator = ''    // '' = chevron SVG | any string = custom
  export let maxItems  = 0     // 0 = show all; N = show first + … + last N

  // Truncate middle items if maxItems is set
  const visible = (() => {
    if (!maxItems || items.length <= maxItems) return items
    const keep = maxItems - 1
    return [items[0], { label: '…', href: undefined, _ellipsis: true }, ...items.slice(-keep)]
  })()
</script>

<nav aria-label="Breadcrumb" {class}>
  <ol class="flex items-center flex-wrap gap-1">
    {#each visible as item, i (i)}
      {@const isLast = i === visible.length - 1}

      <li class="flex items-center gap-1">
        <!-- Separator — not before first item -->
        {#if i > 0}
          {#if separator}
            <span class="text-gray-400 text-xs select-none" aria-hidden="true">{separator}</span>
          {:else}
            <svg class="h-3.5 w-3.5 text-gray-300 shrink-0" viewBox="0 0 20 20" fill="currentColor" aria-hidden="true">
              <path fill-rule="evenodd" d="M8.22 5.22a.75.75 0 0 1 1.06 0l4.25 4.25a.75.75 0 0 1 0 1.06l-4.25 4.25a.75.75 0 0 1-1.06-1.06L11.94 10 8.22 6.28a.75.75 0 0 1 0-1.06Z" clip-rule="evenodd"/>
            </svg>
          {/if}
        {/if}

        <!-- Crumb -->
        {#if item._ellipsis}
          <span class="text-xs text-gray-400 px-1">…</span>

        {:else if isLast || !item.href}
          <span
            class="text-xs font-medium {isLast ? 'text-gray-700' : 'text-gray-500'}"
            aria-current={isLast ? 'page' : undefined}
          >
            {item.label}
          </span>

        {:else}
          <a
            href={item.href}
            class="text-xs font-medium text-gray-500 hover:text-gray-700
                   transition-colors rounded focus-visible:outline-none
                   focus-visible:ring-2 focus-visible:ring-blue-500"
          >
            {item.label}
          </a>
        {/if}
      </li>
    {/each}
  </ol>
</nav>
