<script>
  // AvatarGroup.mesa
  // Stacked overlapping avatars. Shows the first `max` avatars and a "+N" overflow
  // count when there are more.
  //
  // USERS shape:
  //   { name: string, src?: string, status?: string }
  //
  // Usage:
  //   <AvatarGroup users={teamMembers} />
  //   <AvatarGroup users={members} max={4} size="sm" />
  //   <AvatarGroup users={assignees} size="xs" showCount />

  import Avatar from './Avatar.mesa'

  export let users    = []    // { name, src?, status? }[]
  export let max      = 5     // max avatars shown before +N
  export let size     = 'sm'  // 'xs' | 'sm' | 'md' | 'lg'
  export let showCount = true  // show the total count tooltip

  const visible   = users.slice(0, max)
  const overflow  = users.length - visible.length

  // Per-size: ring width + negative margin for overlap
  const sizeMap = {
    xs: { ring: 'ring-2',      ml: '-ml-1.5', overflow: 'h-6 w-6 text-[9px]'  },
    sm: { ring: 'ring-2',      ml: '-ml-2',   overflow: 'h-8 w-8 text-[10px]' },
    md: { ring: 'ring-[3px]',  ml: '-ml-2.5', overflow: 'h-9 w-9 text-xs'     },
    lg: { ring: 'ring-[3px]',  ml: '-ml-3',   overflow: 'h-11 w-11 text-xs'   },
  }

  const sz = sizeMap[size] ?? sizeMap.sm
</script>

<div
  class="flex items-center"
  {class}
  title={showCount ? `${users.length} member${users.length !== 1 ? 's' : ''}` : undefined}
>
  {#each visible as user, i (i)}
    <div class="{i > 0 ? sz.ml : ''} {sz.ring} ring-white rounded-full shrink-0">
      <Avatar src={user.src} name={user.name} status={user.status} size={size} />
    </div>
  {/each}

  {#if overflow > 0}
    <div
      class="{sz.ml} {sz.ring} {sz.overflow} ring-white rounded-full shrink-0
             bg-gray-100 text-gray-600 font-semibold
             flex items-center justify-center"
      aria-label="{overflow} more"
    >
      +{overflow}
    </div>
  {/if}
</div>
