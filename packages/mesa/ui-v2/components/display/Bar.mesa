<script>
  // Bar.mesa
  // Horizontal percentage fill bar. CPU/mem/disk style.
  // `size="sm"` gives the compact MiniBar variant — no label, inline.
  //
  // Color thresholds: auto-colors red/yellow/green based on value when
  // `color="auto"` (default). Override with a fixed color name.
  //
  // Usage — full UsageBar:
  //   <Bar label="CPU" value={74} unit="%" />
  //   <Bar label="Memory" value={8.2} max={16} unit="GB" />
  //
  // Usage — compact MiniBar (inline, no label):
  //   <Bar value={42} size="sm" />
  //   <Bar value={92} size="sm" color="auto" />

  export let value   = 0        // current value
  export let max     = 100      // maximum value (value/max = fill %)
  export let label   = ''       // left label — hidden when size="sm"
  export let unit    = ''       // appended to value display: "74%" or "8.2 GB"
  export let color   = 'auto'   // 'auto'|'blue'|'green'|'yellow'|'red'|'purple'
  export let size    = 'md'     // 'sm' | 'md'
  export let showVal = true     // show numeric value label (md only)

  // Clamp 0–100
  const pct = Math.min(100, Math.max(0, (value / max) * 100))
  const displayVal = unit ? `${value}${unit}` : `${Math.round(pct)}%`

  // Auto-threshold: green < 60, yellow < 80, red >= 80
  const autoColor = pct >= 80 ? 'red' : pct >= 60 ? 'yellow' : 'green'

  const resolvedColor = color === 'auto' ? autoColor : color

  const trackColorMap = {
    blue:   'bg-blue-500',
    green:  'bg-green-500',
    yellow: 'bg-yellow-400',
    red:    'bg-red-500',
    purple: 'bg-purple-500',
    gray:   'bg-gray-400',
  }

  const trackClass = trackColorMap[resolvedColor] ?? trackColorMap.blue

  const isCompact = size === 'sm'
</script>

{#if isCompact}
  <!-- MiniBar — compact inline, no label -->
  <div
    class="h-1.5 w-full rounded-full bg-gray-200 overflow-hidden"
    role="progressbar"
    aria-valuenow={value}
    aria-valuemin={0}
    aria-valuemax={max}
    {class}
  >
    <div
      class="h-full rounded-full transition-all duration-500 {trackClass}"
      style:width="{pct}%"
    ></div>
  </div>

{:else}
  <!-- Full UsageBar — label + track + value -->
  <div class="flex flex-col gap-1.5" {class}>
    {#if label || showVal}
      <div class="flex items-center justify-between gap-2">
        {#if label}
          <span class="text-xs font-medium text-gray-600 truncate">{label}</span>
        {/if}
        {#if showVal}
          <span class="text-xs font-mono text-gray-500 shrink-0">{displayVal}</span>
        {/if}
      </div>
    {/if}

    <div
      class="h-2 w-full rounded-full bg-gray-200 overflow-hidden"
      role="progressbar"
      aria-valuenow={value}
      aria-valuemin={0}
      aria-valuemax={max}
      aria-label={label || displayVal}
    >
      <div
        class="h-full rounded-full transition-all duration-500 {trackClass}"
        style:width="{pct}%"
      ></div>
    </div>
  </div>
{/if}
