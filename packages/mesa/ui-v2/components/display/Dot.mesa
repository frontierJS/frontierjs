<script>
  // Dot.mesa
  // Colored status indicator. Optionally pulses for live/active states.
  //
  // color: 'green' | 'red' | 'yellow' | 'gray' | 'blue' | 'orange'
  // size:  'xs' | 'sm' | 'md' | 'lg'
  //
  // Usage:
  //   <Dot color="green" />
  //   <Dot color="yellow" pulse />
  //   <Dot color="green" label="Active" />   ← sr-only label for a11y

  export let color  = 'gray'   // 'green'|'red'|'yellow'|'gray'|'blue'|'orange'
  export let size   = 'sm'     // 'xs'|'sm'|'md'|'lg'
  export let pulse  = false    // animate-pulse for live/active states
  export let label  = ''       // sr-only accessible label

  const sizeMap = { xs: 'h-1.5 w-1.5', sm: 'h-2 w-2', md: 'h-2.5 w-2.5', lg: 'h-3 w-3' }

  const colorMap = {
    green:  'bg-green-500',
    red:    'bg-red-500',
    yellow: 'bg-yellow-400',
    gray:   'bg-gray-400',
    blue:   'bg-blue-500',
    orange: 'bg-orange-400',
  }

  const sz  = sizeMap[size]  ?? sizeMap.sm
  const col = colorMap[color] ?? colorMap.gray
</script>

<span
  class="relative inline-flex shrink-0 {sz}"
  {class}
  aria-hidden={!label}
>
  {#if pulse}
    <!-- Outer ring pulse -->
    <span class="absolute inline-flex h-full w-full animate-ping rounded-full {col} opacity-60"></span>
  {/if}
  <span class="relative inline-flex rounded-full {sz} {col}"></span>
  {#if label}
    <span class="sr-only">{label}</span>
  {/if}
</span>
