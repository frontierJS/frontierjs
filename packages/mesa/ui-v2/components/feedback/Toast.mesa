<script>
  // Toast.mesa
  // Individual toast notification. Rendered by Toaster.mesa — not used directly.
  // Includes an animated progress bar that drains over `duration` ms,
  // giving the user a visual cue of how long they have to read it.

  export let id        = 0
  export let message   = ''
  export let type      = 'info'
  export let duration  = 3500   // ms — drives progress bar width animation
  export let ondismiss = undefined

  const styleMap = {
    info:    { wrap: 'bg-white border-blue-200',   icon: 'text-blue-500',   bar: 'bg-blue-500'   },
    success: { wrap: 'bg-white border-green-200',  icon: 'text-green-500',  bar: 'bg-green-500'  },
    warning: { wrap: 'bg-white border-yellow-300', icon: 'text-yellow-500', bar: 'bg-yellow-400' },
    error:   { wrap: 'bg-white border-red-200',    icon: 'text-red-500',    bar: 'bg-red-500'    },
  }

  const iconPathMap = {
    info:    'M11.25 11.25l.041-.02a.75.75 0 0 1 1.063.852l-.708 2.836a.75.75 0 0 0 1.063.853l.041-.021M21 12a9 9 0 1 1-18 0 9 9 0 0 1 18 0Zm-9-3.75h.008v.008H12V8.25Z',
    success: 'M9 12.75 11.25 15 15 9.75M21 12a9 9 0 1 1-18 0 9 9 0 0 1 18 0Z',
    warning: 'M12 9v3.75m-9.303 3.376c-.866 1.5.217 3.374 1.948 3.374h14.71c1.73 0 2.813-1.874 1.948-3.374L13.949 3.378c-.866-1.5-3.032-1.5-3.898 0L2.697 16.126ZM12 15.75h.007v.008H12v-.008Z',
    error:   'M12 9v3.75m9-.75a9 9 0 1 1-18 0 9 9 0 0 1 18 0Zm-9 3.75h.008v.008H12v-.008Z',
  }

  const s    = styleMap[type]    ?? styleMap.info
  const path = iconPathMap[type] ?? iconPathMap.info

  const toastAnim = $.entrance({
    in:  el => el.animate(
      [{ opacity: 0, transform: 'translateX(110%)' },
       { opacity: 1, transform: 'translateX(0)' }],
      { duration: 300, easing: 'cubic-bezier(0.16,1,0.3,1)', fill: 'forwards' }
    ),
    out: el => el.animate(
      [{ opacity: 1, transform: 'translateX(0)',    maxHeight: '200px', marginBottom: '0.5rem' },
       { opacity: 0, transform: 'translateX(110%)', maxHeight: '0px',   marginBottom: '0rem'  }],
      { duration: 250, easing: 'ease-in', fill: 'forwards' }
    ).finished,
  })

  function dismiss() {
    ondismiss?.(id)
  }
</script>

<div
  class="flex flex-col overflow-hidden rounded-xl border shadow-lg
         w-80 max-w-[90vw] {s.wrap}"
  role="alert"
  aria-live="polite"
  {@attach toastAnim}
>
  <!-- Main content row -->
  <div class="flex items-start gap-3 px-4 py-3">
    <!-- Type icon -->
    <svg class="mt-0.5 h-5 w-5 shrink-0 {s.icon}" xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor" aria-hidden="true">
      <path stroke-linecap="round" stroke-linejoin="round" d={path} />
    </svg>

    <!-- Message -->
    <p class="flex-1 text-sm text-gray-800 leading-snug pt-0.5">{message}</p>

    <!-- Dismiss -->
    <button
      type="button"
      class="shrink-0 rounded-md p-1 text-gray-400 hover:text-gray-600 hover:bg-gray-100
             transition-colors focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-blue-500"
      aria-label="Dismiss notification"
      on:click={dismiss}
    >
      <svg class="h-3.5 w-3.5" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 20 20" fill="currentColor">
        <path d="M6.28 5.22a.75.75 0 0 0-1.06 1.06L8.94 10l-3.72 3.72a.75.75 0 1 0 1.06 1.06L10 11.06l3.72 3.72a.75.75 0 1 0 1.06-1.06L11.06 10l3.72-3.72a.75.75 0 0 0-1.06-1.06L10 8.94 6.28 5.22z" />
      </svg>
    </button>
  </div>

  <!-- Progress drain bar — CSS animation driven by duration prop -->
  {#if duration > 0}
    <div class="h-0.5 w-full bg-gray-100 overflow-hidden">
      <div
        class="h-full {s.bar} origin-left"
        style:animation="drain {duration}ms linear forwards"
      ></div>
    </div>
  {/if}
</div>

<style>
  @keyframes drain {
    from { transform: scaleX(1); }
    to   { transform: scaleX(0); }
  }
</style>
