<script>
  // Skeleton.mesa
  // Loading placeholder. Renders a pulsing gray shape.
  //
  // Shapes match common UI elements — use `variant` for the most common,
  // or compose custom skeletons with the bare `<Skeleton>` block.
  //
  // Usage — inline shapes:
  //   <Skeleton variant="text" width="60%" />
  //   <Skeleton variant="avatar" size="md" />
  //   <Skeleton variant="button" />
  //
  // Usage — custom block:
  //   <Skeleton class="h-48 w-full rounded-xl" />
  //
  // Usage — pre-built card skeleton:
  //   <Skeleton variant="card" />
  //
  // Usage — pre-built stat skeleton:
  //   <Skeleton variant="stat" />

  export let variant = 'block'  // 'block'|'text'|'avatar'|'button'|'card'|'stat'
  export let width   = undefined
  export let height  = undefined
  export let size    = 'md'     // for 'avatar': 'xs'|'sm'|'md'|'lg'

  const avatarSizeMap = { xs: 'h-6 w-6', sm: 'h-8 w-8', md: 'h-10 w-10', lg: 'h-14 w-14' }
  const avatarSz = avatarSizeMap[size] ?? avatarSizeMap.md
</script>

{#if variant === 'text'}
  <div
    class="h-3.5 rounded bg-gray-200 animate-pulse"
    style:width={width ?? '100%'}
    {class}
  ></div>

{:else if variant === 'avatar'}
  <div class="rounded-full bg-gray-200 animate-pulse shrink-0 {avatarSz}" {class}></div>

{:else if variant === 'button'}
  <div
    class="h-9 rounded-lg bg-gray-200 animate-pulse"
    style:width={width ?? '6rem'}
    {class}
  ></div>

{:else if variant === 'card'}
  <!-- Pre-built card skeleton -->
  <div class="rounded-xl border border-gray-100 bg-white p-5 flex flex-col gap-3 animate-pulse" {class}>
    <div class="flex items-center gap-3">
      <div class="h-9 w-9 rounded-lg bg-gray-200 shrink-0"></div>
      <div class="flex flex-col gap-1.5 flex-1">
        <div class="h-3.5 w-24 rounded bg-gray-200"></div>
        <div class="h-3 w-16 rounded bg-gray-100"></div>
      </div>
    </div>
    <div class="h-2 w-full rounded bg-gray-100"></div>
    <div class="h-2 w-4/5 rounded bg-gray-100"></div>
  </div>

{:else if variant === 'stat'}
  <!-- Pre-built stat card skeleton -->
  <div class="rounded-xl border border-gray-100 bg-white p-5 flex flex-col gap-2 animate-pulse" {class}>
    <div class="h-3 w-20 rounded bg-gray-200"></div>
    <div class="h-8 w-28 rounded bg-gray-200"></div>
    <div class="h-2.5 w-16 rounded bg-gray-100"></div>
  </div>

{:else}
  <!-- Bare block — size via class or explicit w/h -->
  <div
    class="rounded bg-gray-200 animate-pulse {class}"
    style:width={width}
    style:height={height}
  ></div>
{/if}
