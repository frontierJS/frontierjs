<script>
  // Square.mesa — the square: the tavern and three houses along the top, the
  // fountain in the middle, the hedges and flowers along the bottom; and east
  // of the first screen, three more houses, the well, the market stall and the
  // signpost, which the view pans to as a figure walks there (6.1); right of
  // the fountain, the notice board (7.5), which the route's `Notices` reads. The
  // tavern's door is the left house's, and the workshop's (Phase 11) is the
  // house beside it, with its sign; the town hall is the first house past
  // the first screen, with its own. Three edges are borders
  // (`IDEAS/haven.md` 6.2): east onto the road, west into the woods, and a
  // gap in the hedge south down to the docks. The picture this draws is
  // `square.frame.txt`, which `scenes.test.js` pins.
  import Scene from '@/components/Scene.mesa'
  import Piece from '@/components/Piece.mesa'
  import Row   from '@/components/Row.mesa'
  import Door  from '@/components/Door.mesa'
  import Pacer from '@/components/Pacer.mesa'
  import { piece } from '@/pieces/index.js'
  import { framed } from '@/pieces/frame.js'
  import { tree }  from '@/pieces/tree.js'
  import { lamp }  from '@/pieces/lamp.js'
  import { bench } from '@/pieces/bench.js'
  import { noticeBoard } from '@/pieces/board.js'
  import { flower } from '@/pieces/flower.js'
  import { signpost } from '@/pieces/signpost.js'
  import { hedge } from '@/pieces/hedge.js'
  import { house, well, stall, fountain, basin } from '@/pieces/town.js'

  // No two houses are one size, so each is its own block; the tavern's sign
  // is part of its house.
  const tavern = piece('tavern', String.raw`
   ~'
   ||
  _||_________________________
 //\/\/\/\/\/\/\/\/\/\/\/\/\/\\
/______________________________\
 | ★ [ THE GOLDEN TANKARD ] ★ |
 |  []    []   ♪ ♫  []    []  |
 |                            |
 |  []    []   .-.  []    []  |
 |_____________|n|____________|
`, String.raw`
   kk
   cc
  rccrrrrrrrrrrrrrrrrrrrrrrrrr
 rRRRRRRRRRRRRRRRRRRRRRRRRRRRRr
rrrrrrrrrrrrrrrrrrrrrrrrrrrrrrrr
 w s S sss ssssss sssssss S s w
 w  yy    yy   m m  yy    yy  w
 w                            w
 w  yy    yy   ddd  yy    yy  w
 wwwwwwwwwwwwwwdddwwwwwwwwwwwww
`)

  // The workshop and the town hall (`IDEAS/haven.md` Phase 15, the first
  // house east of the first screen) are one house with another sign.
  const workshop = house('WORKSHOP')
  const townhall = house('TOWN HALL')

  const houseB = piece('house', String.raw`
   ~'
   ||
  _||___________
 //\/\/\/\/\/\/\\
/________________\
 |  []      []  |
 |              |
 |  []      []  |
 |      .-.     |
 |______|n|_____|
`, String.raw`
   kk
   cc
  rccrrrrrrrrrrr
 rRRRRRRRRRRRRRRr
rrrrrrrrrrrrrrrrrr
 w  yy      yy  w
 w              w
 w  yy      yy  w
 w      ddd     w
 wwwwwwwdddwwwwww
`)

  const houseC = piece('house', String.raw`
   ~'
   ||
  _||_______
 //\/\/\/\/\\
/____________\
 | []    [] |
 |          |
 | [] .-.   |
 |____|n|___|
`, String.raw`
   kk
   cc
  rccrrrrrrr
 rRRRRRRRRRRr
rrrrrrrrrrrrrr
 w yy    yy w
 w          w
 w yy ddd   w
 wwwwwdddwwww
`)

  // One drawing, two pieces: the rim is a wall, the water inside
  // is walked through, and three cells of water break the front rim as the
  // way in. A cell has one owner, so each takes its own paint keys. The jet is
  // the top two rows and floor like the water: a figure stands on the spray,
  // drawn over it rather than hidden under it.
  // The square's own frame: two and a third screens wide, where the shared
  // `frame` is one screen. The houses stand a long stride apart and the plaza
  // between them is bare floor, so it is a place to cross rather than a row to
  // squeeze along.
  const frame = framed(223, 26)

  const PALETTE = {
    f: { fg: '#6b7280' },
    r: { fg: '#c2410c' },
    R: { fg: ['#9a3412', '#b45309', '#9a3412'] },
    c: { fg: '#7c2d12' },
    k: { fg: ['#9ca3af', '#d1d5db', '#6b7280'], chars: "~'.~", ms: 450, wave: true },
    w: { fg: '#d6b98c' },
    d: { fg: '#92400e' },
    S: { fg: '#a16207' },
    s: { fg: '#fbbf24' },
    y: { fg: ['#fde047', '#facc15', '#fde047', '#fbbf24'], ms: 700, flicker: true, light: 1 },
    t: { fg: '#166534' },
    T: { fg: ['#22c55e', '#16a34a', '#15803d', '#16a34a'], chars: '&&%&', ms: 900, wave: true },
    u: { fg: '#78350f' },
    l: { fg: '#9ca3af' },
    e: { fg: '#a16207' },
    j: { fg: ['#e0f2fe', '#7dd3fc', '#bae6fd'], chars: ".':'", ms: 180, flicker: true },
    b: { fg: ['#38bdf8', '#7dd3fc', '#0ea5e9'], chars: '~-~', ms: 350, wave: true },
    G: { fg: ['#22c55e', '#16a34a', '#15803d'], ms: 1100, wave: true },
    p: { fg: ['#f472b6', '#facc15', '#c084fc', '#fb7185'], ms: 1500, flicker: true, dye: true },
    m: { fg: ['#c4b5fd', '#a78bfa', '#e9d5ff'], chars: '♪♫', ms: 800, flicker: true },
  }
</script>

<Scene slug="square" palette={PALETTE} spawn={{ x: 64, y: 22 }}>
  <Piece of={frame} />
  <Door  x={223} y={1} h={24} to="/road/" />
  <Door  x={1}   y={1} h={24} to="/woods/" />
  <Door  x={47}  y={25} w={6} to="/docks/" />
  <Piece of={tavern} x={6}  y={1} />
  <Door  x={22} y={10} to="/tavern/" />
  <Piece of={workshop} x={48} y={2} />
  <Door  x={58} y={10} to="/workshop/" />
  <Piece of={houseB} x={78} y={1} />
  <Piece of={houseC} x={106} y={2} />
  <Piece of={fountain} x={55} y={12} />
  <Piece of={basin} x={55} y={12} />
  <Piece of={tree} x={4}  y={13} />
  <Piece of={tree} x={109} y={13} />
  <Piece of={lamp} x={21} y={14} />
  <Piece of={lamp} x={88} y={14} />
  <Piece of={bench} x={57} y={20} />
  <Piece of={bench} x={69} y={20} />
  <Piece of={noticeBoard} x={96} y={13} />
  <Row of={hedge} y={23} x={5} n={10} />
  <Row of={hedge} y={23} x={21} n={12} />
  <Row of={hedge} y={23} x={37} n={10} />
  <Row of={hedge} y={23} x={53} n={10} />
  <Row of={hedge} y={23} x={67} n={12} />
  <Row of={hedge} y={23} x={83} n={10} />
  <Row of={hedge} y={23} x={99} n={12} />
  <Row of={hedge} y={23} x={115} n={10} />
  <Row of={flower} y={24} x={6}  n={14} step={3} />
  <Row of={flower} y={24} x={54} n={26} step={3} />
  <Piece of={townhall} x={130} y={2} />
  <Door  x={140} y={10} to="/townhall/" />
  <Piece of={houseB} x={160} y={1} />
  <Piece of={houseC} x={188} y={2} />
  <Piece of={tree} x={124} y={13} />
  <Piece of={tree} x={186} y={12} />
  <Piece of={lamp} x={138} y={14} />
  <Piece of={lamp} x={176} y={14} />
  <Piece of={well} x={146} y={13} />
  <Door  x={149} y={16} to="/canal/" />
  <Piece of={stall} x={158} y={14} />
  <Piece of={bench} x={144} y={20} />
  <Piece of={bench} x={164} y={20} />
  <Piece of={signpost('[east]>')} x={213} y={20} />
  <Row of={hedge} y={23} x={129} n={12} />
  <Row of={hedge} y={23} x={145} n={10} />
  <Row of={hedge} y={23} x={161} n={12} />
  <Row of={hedge} y={23} x={177} n={10} />
  <Row of={hedge} y={23} x={193} n={12} />
  <Row of={hedge} y={23} x={209} n={10} />
  <Row of={flower} y={24} x={138} n={26} step={3} />
  <Pacer name="pigeons" y={11} from={72} to={130} ms={240} rest={40} flee={30} fg="#94a3b8"
    right={["'> ,>", ",> '>"]}
    left={["<' <,", "<, <'"]}
    sit={["<' ,>", "<, ,>", "<' '>", "<' ,>"]} />
  <slot />
</Scene>
