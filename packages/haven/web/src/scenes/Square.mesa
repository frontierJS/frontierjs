<script>
  // Square.mesa — the square: the tavern and three houses along the top, the
  // fountain in the middle, the hedges and flowers along the bottom. The
  // tavern's door is the left house's. The picture this draws is
  // `square.frame.txt`, which `scenes.test.js` pins.
  import Scene from '@/components/Scene.mesa'
  import Piece from '@/components/Piece.mesa'
  import Row   from '@/components/Row.mesa'
  import Door  from '@/components/Door.mesa'
  import { piece } from '@/pieces/index.js'
  import { frame } from '@/pieces/frame.js'
  import { tree }  from '@/pieces/tree.js'
  import { lamp }  from '@/pieces/lamp.js'
  import { bench } from '@/pieces/bench.js'

  // No two houses are one size, so each is its own block; the tavern's sign
  // is part of its house.
  const tavern = piece('tavern', String.raw`
   ~'
   ||
  _||_________________________
 //\/\/\/\/\/\/\/\/\/\/\/\/\/\\
/______________________________\
 |   [ THE GOLDEN TANKARD ]   |
 |  []    []        []    []  |
 |                            |
 |  []    []   .-.  []    []  |
 |_____________|n|____________|
`, String.raw`
   kk
   cc
  rccrrrrrrrrrrrrrrrrrrrrrrrrr
 rRRRRRRRRRRRRRRRRRRRRRRRRRRRRr
rrrrrrrrrrrrrrrrrrrrrrrrrrrrrrrr
 w   S sss ssssss sssssss S   w
 w  yy    yy        yy    yy  w
 w                            w
 w  yy    yy   ddd  yy    yy  w
 wwwwwwwwwwwwwwdddwwwwwwwwwwwww
`)

  const houseA = piece('house', String.raw`
   ~'
   ||
  _||_____________
 //\/\/\/\/\/\/\/\\
/__________________\
 |  []   []   []  |
 |                |
 |  []   .-.  []  |
 |_______|n|______|
`, String.raw`
   kk
   cc
  rccrrrrrrrrrrrrr
 rRRRRRRRRRRRRRRRRr
rrrrrrrrrrrrrrrrrrrr
 w  yy   yy   yy  w
 w                w
 w  yy   ddd  yy  w
 wwwwwwwwdddwwwwwww
`)

  const houseB = piece('house', String.raw`
   ~'
   ||
  _||___________
 //\/\/\/\/\/\/\\
/________________\
 |  []      []  |
 |              |
 |  []      []  |
 |      .-.     |
 |______|n|_____|
`, String.raw`
   kk
   cc
  rccrrrrrrrrrrr
 rRRRRRRRRRRRRRRr
rrrrrrrrrrrrrrrrrr
 w  yy      yy  w
 w              w
 w  yy      yy  w
 w      ddd     w
 wwwwwwwdddwwwwww
`)

  const houseC = piece('house', String.raw`
   ~'
   ||
  _||_______
 //\/\/\/\/\\
/____________\
 | []    [] |
 |          |
 | [] .-.   |
 |____|n|___|
`, String.raw`
   kk
   cc
  rccrrrrrrr
 rRRRRRRRRRRr
rrrrrrrrrrrrrr
 w yy    yy w
 w          w
 w yy ddd   w
 wwwwwdddwwww
`)

  const fountain = piece('fountain', String.raw`
      .  :  .
       ' | '
   .-----=-----.
 .'~~~~~~~~~~~~~'.
(~~~~~~~~~~~~~~~~~)
 '.~~~~~~~~~~~~~.'
   '-----------'
`, String.raw`
      j  j  j
       j j j
   sssssssssssss
 sbbbbbbbbbbbbbbbs
sbbbbbbbbbbbbbbbbbs
 sbbbbbbbbbbbbbbbs
   sssssssssssss
`)

  const hedge  = piece('hedge', ',', 'g')
  const flower = piece('flower', '*', 'p')

  const PALETTE = {
    f: { fg: '#6b7280' },
    r: { fg: '#c2410c' },
    R: { fg: ['#9a3412', '#b45309', '#9a3412'] },
    c: { fg: '#7c2d12' },
    k: { fg: ['#9ca3af', '#d1d5db', '#6b7280'], chars: "~'.~", ms: 450, wave: true },
    w: { fg: '#d6b98c' },
    d: { fg: '#92400e' },
    S: { fg: '#a16207' },
    s: { fg: '#fbbf24' },
    y: { fg: ['#fde047', '#facc15', '#fde047', '#fbbf24'], ms: 700, flicker: true },
    t: { fg: '#166534' },
    T: { fg: ['#22c55e', '#16a34a', '#15803d', '#16a34a'], chars: '&&%&', ms: 900, wave: true },
    u: { fg: '#78350f' },
    l: { fg: '#9ca3af' },
    e: { fg: '#a16207' },
    j: { fg: ['#e0f2fe', '#7dd3fc', '#bae6fd'], chars: ".':'", ms: 180, flicker: true },
    b: { fg: ['#38bdf8', '#7dd3fc', '#0ea5e9'], chars: '~-~', ms: 350, wave: true },
    g: { fg: ['#22c55e', '#16a34a', '#15803d'], ms: 1100, wave: true },
    p: { fg: ['#f472b6', '#facc15', '#c084fc', '#fb7185'], ms: 1500, flicker: true },
  }
</script>

<Scene slug="square" palette={PALETTE} spawn={{ x: 31, y: 21 }}>
  <Piece of={frame} />
  <Piece of={tavern} x={4}  y={1} />
  <Door  x={20} y={10} to="/tavern/" />
  <Piece of={houseA} x={40} y={2} />
  <Piece of={houseB} x={61} y={1} />
  <Piece of={houseC} x={81} y={2} />
  <Piece of={fountain} x={42} y={12} />
  <Piece of={tree} x={3}  y={13} />
  <Piece of={tree} x={83} y={13} />
  <Piece of={lamp} x={19} y={14} />
  <Piece of={lamp} x={75} y={14} />
  <Piece of={bench} x={44} y={20} />
  <Piece of={bench} x={56} y={20} />
  <Row of={hedge} y={23} x={5}  n={10} />
  <Row of={hedge} y={23} x={21} n={12} />
  <Row of={hedge} y={23} x={37} n={10} />
  <Row of={hedge} y={23} x={53} n={10} />
  <Row of={hedge} y={23} x={67} n={12} />
  <Row of={hedge} y={23} x={83} n={10} />
  <Row of={flower} y={24} x={6} n={29} step={3} />
</Scene>
