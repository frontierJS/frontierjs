<script>
  // Glade.mesa — the glade past the woods' fence: a pond, a ring of standing
  // stones, a fairy ring, and the old oak. It is reached only through a loose
  // plank in the woods' west wall, a hidden door (`IDEAS/haven.md` 6.6), and
  // the way back is the door in its east wall. The oak's foot opens at full
  // night onto the cellar under the tavern, a `night` door at each end, so by
  // day it is trunk. The picture this draws is `glade.frame.txt`, the glade by
  // day, which `scenes.test.js` pins. A deer grazes the south edge; shot at,
  // it bolts out of the scene (`pacerNow` in `api/src/pacer.ts`).
  import Scene from '@/components/Scene.mesa'
  import Piece from '@/components/Piece.mesa'
  import Door  from '@/components/Door.mesa'
  import Pacer from '@/components/Pacer.mesa'
  import { piece } from '@/pieces/index.js'
  import { frame } from '@/pieces/frame.js'
  import { tree }  from '@/pieces/tree.js'
  import { shroom } from '@/pieces/shroom.js'
  import { oak } from '@/pieces/growth.js'
  import { stone } from '@/pieces/stone.js'

  // In winter the pond freezes: ice `v` with a crack `k` and a glint `g`, a
  // floor piece, so a figure walks out onto it. The server walks it only in its
  // own winter (`world.json` carries that season's walls), the same clock
  // `/fish` reads. The ice leaves four cells in the middle bare for the `hole`,
  // water a line is cast into; a line cast there in winter can bring up a
  // penguin (`api/src/fishing.ts`).
  const ICE = {
    v: { fg: '#e0f2fe' },
    k: { fg: '#7dd3fc' },
    g: { fg: ['#ffffff', '#e0f2fe', '#bae6fd'], chars: '*.*', ms: 1700, flicker: true },
    h: { fg: ['#0369a1', '#075985', '#0c4a6e'], chars: '~-~', ms: 600, wave: true },
  }

  const frozen = piece('pond', String.raw`
   .-============-.
 .====*=====/=======.
(======/\    =======*)
 '=======*=========='
   '-============-'
`, String.raw`
   svvvvvvvvvvvvvvs
 svvvgvvvvvkvvvvvvvs
svvvvvvkk    vvvvvvvgs
 svvvvvvvgvvvvvvvvvvs
   svvvvvvvvvvvvvvs
`, { floor: true, palette: ICE })

  const pond = piece('pond', String.raw`
   .-~~~~~~~~~~~~-.
 .~~~~~~~~~~~~~~~~~~.
(~~~~~~~~~~~~~~~~~~~~)
 '~~~~~~~~~~~~~~~~~~'
   '-~~~~~~~~~~~~-'
`, String.raw`
   sbbbbbbbbbbbbbbs
 sbbbbbbbbbbbbbbbbbbs
sbbbbbbbbbbbbbbbbbbbbs
 sbbbbbbbbbbbbbbbbbbs
   sbbbbbbbbbbbbbbs
`, { seasons: { winter: frozen } })

  // Nothing in summer, where the pond holds those cells itself.
  const holeIce = piece('hole', '(~~)', 'vhhv', { palette: ICE })
  const hole = piece('hole', ' ', ' ', { seasons: { winter: holeIce } })

  const PALETTE = {
    f: { fg: '#6b7280' },
    d: { fg: '#92400e' },
    u: { fg: '#78350f' },
    s: { fg: '#9ca3af' },
    l: { fg: '#9ca3af' },
    b: { fg: ['#38bdf8', '#7dd3fc', '#0ea5e9'], chars: '~-~', ms: 350, wave: true },
    p: { fg: ['#f472b6', '#fb7185', '#f472b6', '#e879f9'], ms: 1500, flicker: true },
    t: { fg: '#166534' },
    T: { fg: ['#22c55e', '#16a34a', '#15803d', '#16a34a'], chars: '&&%&', ms: 900, wave: true },
  }
</script>

<Scene slug="glade" palette={PALETTE} spawn={{ x: 88, y: 12 }}>
  <Piece of={frame} />
  <Door  x={96} y={12} to="/woods/" />
  <Piece of={oak}  x={36} y={1} />
  <Door  x={49} y={9} to="/cellar/" night />
  <Door  x={30} y={25} to="/canal/" />
  <Piece of={pond} x={6} y={15} />
  <Piece of={hole} x={15} y={17} />
  <Piece of={tree} x={4}  y={1} />
  <Piece of={tree} x={78} y={1} />
  <Piece of={tree} x={82} y={17} />
  <Piece of={stone} x={66} y={11} />
  <Piece of={stone} x={74} y={9} />
  <Piece of={stone} x={74} y={19} />
  <Piece of={stone} x={58} y={14} />
  <Piece of={stone} x={66} y={18} />
  <Piece of={shroom} x={34} y={16} />
  <Piece of={shroom} x={40} y={14} />
  <Piece of={shroom} x={46} y={16} />
  <Piece of={shroom} x={40} y={19} />
  <Pacer name="deer" y={22} from={3} to={78} ms={420} rest={20} flee={60} fg="#b45309"
    right={['~(==)Y', '~(=-)Y']}
    left={['Y(==)~', 'Y(-=)~']}
    sit={['~(==)v', '~(==)v', '~(==)Y', '~(==)v']} />
  <Pacer name="rabbit" night={false} y={24} from={4} to={60} ms={160} rest={40} flee={25} fg="#d6d3d1"
    right={['(\\_/)']}
    left={['(\\_/)']}
    sit={['(\\_/)', '(\\_/)', '(\\./)', '(\\_/)']} />
  <Pacer name="firefly" night sky="summer" y={14} from={6} to={30} ms={500} rest={6} fg="#facc15"
    right={['*', '.']} left={['.', '*']} sit={['*', '.', '*', '*']} />
  <Pacer name="firefly2" night sky="summer" y={20} from={8} to={34} ms={430} rest={8} fg="#fde047"
    right={['.', '*']} left={['*', '.']} sit={['.', '*', '.', '*']} />
  <Pacer name="firefly3" night sky="summer" y={10} from={40} to={70} ms={560} rest={5} fg="#facc15"
    right={['*', '*', '.']} left={['.', '*', '*']} sit={['*', '.', '.', '*']} />
  <Pacer name="heron" sky="twilight-rain" y={20} from={6} to={28} ms={900} rest={60} flee={30} fg="#94a3b8"
    right={["_/'"]}
    left={["'\\_"]}
    sit={["_/'", "_/'", '_/.', "_/'"]} />
  <Pacer name="stag" sky="full-moon-snow" y={24} from={30} to={80} ms={600} rest={40} flee={60} fg="#f8fafc"
    right={['~(==)W', '~(=-)W']}
    left={['W(==)~', 'W(-=)~']}
    sit={['~(==)W', '~(==)W', '~(==)w', '~(==)W']} />
</Scene>
