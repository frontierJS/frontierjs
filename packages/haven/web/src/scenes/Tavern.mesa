<script>
  // Tavern.mesa — the tavern: the bar and its shelves across the whole back
  // wall, the hearth with a rug before it where the cat paces, tables,
  // barrels, the stairs, and the door back out to the square in the bottom
  // wall. The rug has a hidden door in
  // it, the way down to the cellar (`IDEAS/haven.md` 6.5): stepping on that
  // cell is the only sign of it. The picture this draws is
  // `tavern.frame.txt`, which `scenes.test.js` pins.
  import Scene from '@/components/Scene.mesa'
  import { INDOORS } from '@/stage.js'
  import Piece from '@/components/Piece.mesa'
  import Door  from '@/components/Door.mesa'
  import Pacer from '@/components/Pacer.mesa'
  import { piece }  from '@/pieces/index.js'
  import { frame }  from '@/pieces/frame.js'
  import { table }  from '@/pieces/table.js'
  import { barrel } from '@/pieces/barrel.js'
  import { bar }    from '@/pieces/bar.js'

  // The shelves, the hearth, its rug and the stairs are the tavern's own; the
  // bar is a piece of its own (`pieces/bar.js`), since `components/Bar.mesa`
  // finds it by import; the tables and barrels are pieces any scene may use.
  // The shelves are the wall behind the bar, as wide as the bar: three rows of
  // bottles, a bottle every third cell, so the board chalked over them
  // (`components/Bar.mesa`) has the room to be read.
  const SHELF_W = 92
  const INNER = SHELF_W - 2
  const BOTTLES = Array.from({ length: 30 }, (_, i) => 1 + i * 3)
  const shelfRow = (pick) => {
    const r = Array(INNER).fill(' ')
    BOTTLES.forEach((x, i) => { r[x] = pick(i) })
    return `|${r.join('')}|`
  }
  const edge = (l, r) => `${l}${'-'.repeat(INNER)}${r}`
  const ink = (shift) => (i) => 'cep'[(i + shift) % 3]
  const shelves = piece('shelves', [
    edge('.', '.'),
    shelfRow((i) => (i % 2 ? '0' : 'U')),
    edge('|', '|'),
    shelfRow((i) => (i % 2 ? '!' : 'i')),
    edge('|', '|'),
    shelfRow((i) => (i % 2 ? '0' : 'U')),
    edge("'", "'"),
  ].join('\n'), [
    'w'.repeat(SHELF_W),
    shelfRow(ink(0)).replace(/\|/g, 'w'),
    'w'.repeat(SHELF_W),
    shelfRow(ink(1)).replace(/\|/g, 'w'),
    'w'.repeat(SHELF_W),
    shelfRow(ink(2)).replace(/\|/g, 'w'),
    'w'.repeat(SHELF_W),
  ].join('\n'))

  const hearth = piece('hearth', String.raw`
  _______________________
 |###########⚜###########|
 |##.-----------------.##|
 |##|  ^^^ ^^^^^ ^^^  |##|
 |##| ^^^^^^^^^^^^^^^ |##|
 |##|_=_=_=_=_=_=_=_=_|##|
[=========================]
`, String.raw`
  sssssssssssssssssssssss
 sSSSSSSSSSSSWSSSSSSSSSSSs
 sSSsssssssssssssssssssSSs
 sSSs  hhh hhhhh hhh  sSSs
 sSSs hhhhhhhhhhhhhhh sSSs
 sSSsuuuuuuuuuuuuuuuuusSSs
sssssssssssssssssssssssssss
`)

  // The rug is floor, walked on, and painted all the same.
  const rug = piece('rug', String.raw`
;;;;;;;;;;;;;;;;;;;;;;;
;::❦::::::::::::::::::;
;::::::::::::::::::❦::;
;;;;;;;;;;;;;;;;;;;;;;;
`, String.raw`
mmmmmmmmmmmmmmmmmmmmmmm
mMMMMMMMMMMMMMMMMMMMMMm
mMMMMMMMMMMMMMMMMMMMMMm
mmmmmmmmmmmmmmmmmmmmmmm
`, { floor: true })

  const stairs = piece('stairs', String.raw`
            ____
        ____|
    ____|
____|
`, String.raw`
            uuuu
        uuuuu
    uuuuu
uuuuu
`)

  const PALETTE = {
    f: { fg: '#6b7280' },
    d: { fg: '#92400e' },
    w: { fg: '#b45309' },
    W: { fg: '#d97706' },
    t: { fg: '#a16207' },
    u: { fg: '#854d0e' },
    s: { fg: '#9ca3af' },
    S: { fg: '#57534e' },
    c: { fg: '#22d3ee' },
    e: { fg: '#a3e635' },
    p: { fg: '#f472b6' },
    y: { fg: ['#fde047', '#fbbf24', '#fef08a'], chars: 'i!i', ms: 300, flicker: true },
    m: { fg: '#7f1d1d' },
    M: { fg: '#b91c1c' },
    h: { fg: ['#ef4444', '#f97316', '#facc15', '#fb923c'], chars: '^*^"', ms: 110, flicker: true, light: 6 },
  }
</script>

<Scene slug="tavern" layers={INDOORS} palette={PALETTE} spawn={{ x: 48, y: 24 }}>
  <Piece of={frame} />
  <Door  x={48} y={25} to="/" />
  <Piece of={shelves} x={3}  y={1} />
  <Piece of={bar}     x={3}  y={9} />
  <Piece of={hearth}  x={63} y={18} />
  <Piece of={rug}     x={65} y={14} />
  <Door  x={75} y={15} to="/cellar/" hidden />
  <Piece of={table}   x={9}  y={14} />
  <Piece of={table}   x={29} y={14} />
  <Piece of={table}   x={49} y={16} />
  <Piece of={table}   x={9}  y={18} />
  <Piece of={table}   x={29} y={18} />
  <Piece of={stairs}  x={2}  y={21} />
  <Piece of={barrel}  x={90} y={14} />
  <Piece of={barrel}  x={90} y={17} />
  <Piece of={barrel}  x={90} y={20} />
  <Pacer name="cat" y={16} from={66} to={86} ms={260} rest={14} fg="#f59e0b"
    right={['-=^.^=', '~=^.^=']}
    left={['=^.^=-', '=^.^=~']}
    sit={['=^.^=', '=^.^=', '=^.^=', '=^-^=']} />
  <slot />
</Scene>
