<script>
  // Docks.mesa — the docks south of the square: a stone quay with crates,
  // barrels, bollards and lamps, a pier out over the water, and the ferry
  // moored beside it, a gangplank from the pier to its deck. Stepping aboard
  // is the door to the island. A plank of the pier crumbles once a figure has stepped
  // on it and off again (`crumbles`, `stage.js`). The north edge is a border into the square
  // (`IDEAS/haven.md` 6.2), and the square's south edge is the run back.
  // The picture this draws is `docks.frame.txt`, which `scenes.test.js`
  // pins.
  import Scene from '@/components/Scene.mesa'
  import Piece from '@/components/Piece.mesa'
  import Door  from '@/components/Door.mesa'
  import Pacer from '@/components/Pacer.mesa'
  import { piece }  from '@/pieces/index.js'
  import { frame }  from '@/pieces/frame.js'
  import { lamp }   from '@/pieces/lamp.js'
  import { barrel } from '@/pieces/barrel.js'
  import { crate }  from '@/pieces/crate.js'
  import { plank }  from '@/pieces/plank.js'
  import { signpost, sign } from '@/pieces/signpost.js'
  import { ferry, FERRY, GANGWAY, hull } from '@/pieces/ferry.js'

  // The water is one block with the pier, the ferry and its plank cut out of
  // it, since a cell has one owner; `BOAT` and `PLANK` are where the tree
  // below places them.
  const PIER  = { x: 46, w: 8, rows: 13 }
  const BOAT  = { x: 56, y: 12 }
  const PLANK = { x: PIER.x + PIER.w, y: BOAT.y + GANGWAY.dy, w: BOAT.x + GANGWAY.dx - PIER.x - PIER.w }
  const aboard = (x, y) => x >= BOAT.x && x < BOAT.x + FERRY.w && y >= BOAT.y && y < BOAT.y + FERRY.h && hull(x - BOAT.x, y - BOAT.y)
  const dry = (x, y) => (y < 9 + PIER.rows && x >= PIER.x && x < PIER.x + PIER.w)
    || (y === PLANK.y && x >= PLANK.x && x < PLANK.x + PLANK.w)
    || aboard(x, y)
  const rows = [...Array(16)].map((_, dy) => [...Array(92)].map((_, dx) => dry(3 + dx, 9 + dy) ? ' ' : '~').join(''))
  const water = piece('water', rows.join('\n'), rows.map((r) => r.replace(/~/g, 'b')).join('\n'))

  const quay = (width) => piece('quay', '_'.repeat(width), 'q'.repeat(width))
  const quayW = quay(43)
  const quayE = quay(41)

  const pier = piece('pier', [...Array(PIER.rows)].map(() => '='.repeat(PIER.w)).join('\n'),
    [...Array(PIER.rows)].map(() => 'u'.repeat(PIER.w)).join('\n'),
    { floor: true, crumbles: { ch: '~', key: 'b' } })

  const bollard = piece('bollard', 'o', 'q')

  const PALETTE = {
    f: { fg: '#6b7280' },
    d: { fg: '#92400e' },
    q: { fg: '#9ca3af' },
    u: { fg: '#92400e' },
    w: { fg: '#b45309' },
    e: { fg: '#a16207' },
    l: { fg: '#9ca3af' },
    y: { fg: ['#fde047', '#facc15', '#fde047', '#fbbf24'], ms: 700, flicker: true, light: 1 },
    b: { fg: ['#38bdf8', '#7dd3fc', '#0ea5e9'], chars: '~-~', ms: 350, wave: true },
  }
</script>

<Scene slug="docks" palette={PALETTE} spawn={{ x: 49, y: 5 }}>
  <Piece of={frame} />
  <Door  x={47} y={0} w={6} to="/" />
  <Piece of={quayW} x={3}  y={8} />
  <Piece of={quayE} x={54} y={8} />
  <Piece of={water} x={3}  y={9} />
  <Piece of={pier}  x={46} y={9} />
  <Piece of={ferry} x={56} y={12} />
  <Piece of={plank(PLANK.w)} x={54} y={16} />
  <Door  x={57} y={16} to="/island/" hidden />
  <Door  x={1}  y={5} to="/canal/" />
  <Piece of={crate} x={10} y={3} />
  <Piece of={crate} x={18} y={3} />
  <Piece of={barrel} x={30} y={4} />
  <Piece of={barrel} x={36} y={4} />
  <Piece of={lamp} x={60} y={3} />
  <Piece of={lamp} x={84} y={3} />
  <Piece of={bollard} x={20} y={7} />
  <Piece of={bollard} x={70} y={7} />
  <Piece of={signpost('^[square]')} x={66} y={1} />
  <Piece of={sign('[ferry]')} x={46} y={7} />
  <Pacer name="crab" y={7} from={22} to={44} ms={300} rest={30} flee={50} fg="#dc2626"
    right={['(\\/)°°(\\/)', '(/\\)°°(/\\)']}
    left={['(\\/)°°(\\/)', '(/\\)°°(/\\)']}
    sit={['(\\/)°°(\\/)', '(\\/)..(\\/)', '(\\/)°°(\\/)', '(\\/)°°(\\/)']} />
  <Pacer name="gull" night={false} y={2} from={26} to={62} ms={200} rest={20} flee={30} fg="#e5e7eb"
    right={['~v~', '-v-']}
    left={['~v~', '-v-']}
    sit={['_v_', '_v_', '~v~', '_v_']} />
  <Pacer name="otter" night y={7} from={50} to={68} ms={260} rest={40} flee={40} fg="#92400e"
    right={['~~(°>', '~-(°>']}
    left={['<°)~~', '<°)-~']}
    sit={['~~(°>', '~~(°>', '~~(°^', '~~(°>']} />
</Scene>
