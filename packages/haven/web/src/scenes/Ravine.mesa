<script>
  // Ravine.mesa — the ravine past the lane's end, a canyon in bands: the far
  // rim and its buttes along the top, side canyons cut down through the
  // cream, buff, red and redwall cliffs to the dark rock of the inner gorge,
  // and a green river along its floor. The near rim is where a figure walks
  // in, and a switchback trail goes down the near wall to a beach by the
  // water with a fire on it. The west edge at the rim's rows is a border into
  // the lane, and the lane's east edge there the run back. The picture this
  // draws is `ravine.frame.txt`, which `scenes.test.js` pins. A mule grazes
  // the rim; shot at, it bolts out of the scene (`pacerNow` in
  // `api/src/pacer.ts`).
  import Scene from '@/components/Scene.mesa'
  import Piece from '@/components/Piece.mesa'
  import Door  from '@/components/Door.mesa'
  import Pacer from '@/components/Pacer.mesa'
  import { piece } from '@/pieces/index.js'
  import { frame } from '@/pieces/frame.js'

  // The canyon is one wall from the far rim to the near one. Each band is a
  // row, so a band's letter is its row's: a glyph moved off its row takes the
  // wrong rock's color. The trail and the beach are the blanks in it, filled
  // by the floor piece below at the same corner's row 13, and the river's two
  // rows are blank here too, filled by the river piece.
  const canyon = piece('canyon', String.raw`
                                                                    ______
         _____________                _________              ______/===-==\______
________/=====-=======\___       ____/=========\____________/========-==========-\____________
=-==========-==========-==\_____/=-==========-==========-==========-==========-==========-====
--=---=---=--=-\:::::/--=---=---=--=---=---=--=---=---=--=---=---=--=---=---=--=---\:::::/=---
::'::'::':'::':\:::::/::'::'::':'::'::'::':'::'::':\:::::/::'::':'::'::'::':'::'::'\:::::/'::'
'::'::':'::'::':\:::/:'::'::':'::'::'::':'::'::'::':\:::/:'::':'::'::'::':'::'::'::'\:::/::'::
|||!!|||||||||!!\:::/||||!!|||||||||!!|||||||||!!|||\:::/|!!|||||||||!!|||||||||!!||\:::/||!!|
--_-_--_--_--_-_-\:/-_--_-_--_--_--_-_--_--_--_-_--_-\:/-_-_--_--_--_-_--_--_--_-_--_\:/--_-_-
\/\/\/\/\/\/\/\/\\:/\/\/\/\/\/\/\/\/\/\/\/\/\/\/\/\/\\:/\/\/\/\/\/\/\/\/\/\/\/\/\/\/\\:/\/\/\/


/\/\/\/\/\/\/\/\/\/\/\                                     \/\/\/\/\/\/\/\/\/\/\/\/\/\/\/\/\/\
\/\/\/\/\/\/\/\/\/\/\/\/\/\/\/\/\/\/\/\/\/\/\/\/\/\/\/\/       /\/\/\/\/\/\/\/\/\/\/\/\/\/\/\/
-_-_--_--_--_-_--_--_--_-_--_--_--_-_--_--_--_-_--_--_--_-_--_ -_--_-_--_--_--_-_--_--_--_-_--
|||||||||!!|||||||||!!||||||                                   |!!|||||||||!!|||||||||!!||||||
::'::'::':'::'::'::':'::'::' :':'::'::'::':'::'::'::':'::'::'::':'::'::'::':'::'::'::':'::'::'
--=---=--=---=---=--=---=---                 -=---=--=---=---=--=---=---=--=---=---=--=---=---
====-==========-==========-==========-====== ===-==========-==========-==========-==========-=
`, String.raw`
                                                                    KKKKKK
         KKKKKKKKKKKKK                KKKKKKKKK              KKKKKKKKKKKKKKKKKKKK
KKKKKKKKKKKKKKKKKKKKKKKKKK       KKKKKKKKKKKKKKKKKKKKKKKKKKKKKKKKKKKKKKKKKKKKKKKKKKKKKKKKKKKKK
KKKKKKKKKKKKKKKKKKKKKKKKKKKKKKKKKKKKKKKKKKKKKKKKKKKKKKKKKKKKKKKKKKKKKKKKKKKKKKKKKKKKKKKKKKKKKK
cccccccccccccccSSSSSSScccccccccccccccccccccccccccccccccccccccccccccccccccccccccccccSSSSSSScccc
rrrrrrrrrrrrrrrSSSSSSSrrrrrrrrrrrrrrrrrrrrrrrrrrrrrSSSSSSSrrrrrrrrrrrrrrrrrrrrrrrrrSSSSSSSrrrr
rrrrrrrrrrrrrrrrSSSSSrrrrrrrrrrrrrrrrrrrrrrrrrrrrrrrSSSSSrrrrrrrrrrrrrrrrrrrrrrrrrrrSSSSSrrrrr
RRRRRRRRRRRRRRRRSSSSSRRRRRRRRRRRRRRRRRRRRRRRRRRRRRRRSSSSSRRRRRRRRRRRRRRRRRRRRRRRRRRRSSSSSRRRRR
gggggggggggggggggSSSgggggggggggggggggggggggggggggggggSSSgggggggggggggggggggggggggggggSSSgggggg
vvvvvvvvvvvvvvvvvSSSvvvvvvvvvvvvvvvvvvvvvvvvvvvvvvvvvSSSvvvvvvvvvvvvvvvvvvvvvvvvvvvvvSSSvvvvvv


vvvvvvvvvvvvvvvvvvvvvv                                     vvvvvvvvvvvvvvvvvvvvvvvvvvvvvvvvvvv
vvvvvvvvvvvvvvvvvvvvvvvvvvvvvvvvvvvvvvvvvvvvvvvvvvvvvvvv       vvvvvvvvvvvvvvvvvvvvvvvvvvvvvvv
gggggggggggggggggggggggggggggggggggggggggggggggggggggggggggggg ggggggggggggggggggggggggggggggg
RRRRRRRRRRRRRRRRRRRRRRRRRRRR                                   RRRRRRRRRRRRRRRRRRRRRRRRRRRRRRR
rrrrrrrrrrrrrrrrrrrrrrrrrrrr rrrrrrrrrrrrrrrrrrrrrrrrrrrrrrrrrrrrrrrrrrrrrrrrrrrrrrrrrrrrrrrrr
cccccccccccccccccccccccccccc                 ccccccccccccccccccccccccccccccccccccccccccccccccc
KKKKKKKKKKKKKKKKKKKKKKKKKKKKKKKKKKKKKKKKKKKK KKKKKKKKKKKKKKKKKKKKKKKKKKKKKKKKKKKKKKKKKKKKKKKKK
`)

  const trail = piece('trail', String.raw`
                       ,,.,,.,,.,,.,,.,,.,,.,,.,,.,,.,,.,,.
                                                        .......
                                                              .
                            ...................................
                            .
                            .................
                                            .
`, String.raw`
                       nnnnnnnnnnnnnnnnnnnnnnnnnnnnnnnnnnnn
                                                        ooooooo
                                                              o
                            ooooooooooooooooooooooooooooooooooo
                            o
                            ooooooooooooooooo
                                            o
`, { floor: true })

  // Its own piece rather than the canyon's two blank rows, because `/fish`
  // reads the piece a cast lands in (`api/src/fishing.ts`, `WATER`).
  const river = piece('river', '~'.repeat(94) + '\n' + '~'.repeat(94), 'w'.repeat(94) + '\n' + 'w'.repeat(94))

  const fire = piece('fire', '^', 'h')

  const sign = piece('sign', String.raw`
 ____________
| THE RAVINE |
 '-||----||-'
`, String.raw`
 dddddddddddd
d sss ssssss d
 dddddddddddd
`)

  const trailhead = piece('trailhead', String.raw`
[trail]
   |
`, String.raw`
eeeeeee
   l
`, { floor: true })

  const telescope = piece('telescope', String.raw`
 __
[__]>
  |
 /|\
`, String.raw`
 qq
qqqqq
  q
 qqq
`)

  const railing = piece('railing', '|--'.repeat(7) + '|', 'e'.repeat(22))

  const juniper = piece('juniper', String.raw`
 .%%.
(%%%%)
  ||
`, String.raw`
 jJJj
jJJJJj
  uu
`)

  const boulder = piece('boulder', '(__)', 'bbbb')

  const PALETTE = {
    f: { fg: '#6b7280' },
    K: { fg: ['#f5deb3', '#fbe7c6', '#f5deb3', '#eed2a0'], ms: 2500, wave: true },
    c: { fg: '#e0b872' },
    r: { fg: '#d9622b' },
    R: { fg: '#b03a1a' },
    g: { fg: '#8f9a6b' },
    v: { fg: '#8b6f9a' },
    S: { fg: '#7c2d12' },
    w: { fg: ['#0f766e', '#14b8a6', '#0d9488'], chars: '~-~', ms: 400, wave: true },
    n: { fg: '#e7c48a' },
    o: { fg: ['#a16207', '#854d0e', '#a16207'], ms: 2000, wave: true },
    h: { fg: ['#f97316', '#fb923c', '#fde047', '#fb923c'], ms: 300, flicker: true, light: 3 },
    d: { fg: '#92400e' },
    s: { fg: '#fbbf24' },
    e: { fg: '#a16207' },
    l: { fg: '#9ca3af' },
    q: { fg: '#9ca3af' },
    b: { fg: '#a8a29e' },
    u: { fg: '#78350f' },
    j: { fg: '#3f6212' },
    J: { fg: ['#4d7c0f', '#65a30d', '#4d7c0f', '#3f6212'], chars: '%%&%', ms: 1100, wave: true },
  }
</script>

<Scene slug="ravine" palette={PALETTE} spawn={{ x: 4, y: 22 }}>
  <Piece of={frame} />
  <Door  x={1} y={20} h={5} to="/lane/" />
  <Piece of={canyon} x={2} y={1} />
  <Piece of={river} x={2} y={11} />
  <Piece of={trail} x={2} y={13} />
  <Piece of={fire} x={24} y={13} />
  <Piece of={sign} x={8} y={20} />
  <Piece of={juniper} x={26} y={21} />
  <Piece of={boulder} x={36} y={22} />
  <Piece of={trailhead} x={48} y={20} />
  <Piece of={telescope} x={60} y={20} />
  <Piece of={railing} x={68} y={20} />
  <Piece of={juniper} x={76} y={22} />
  <Piece of={juniper} x={89} y={21} />
  <Pacer name="mule" y={24} from={3} to={40} ms={520} rest={24} flee={60} fg="#a16207"
    right={['~(__)P', '~(__)p']}
    left={['P(__)~', 'p(__)~']}
    sit={['~(__)P', '~(__)P', '~(__)b', '~(__)P']} />
</Scene>
