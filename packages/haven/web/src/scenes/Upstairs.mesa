<script>
  // Upstairs.mesa — the loft over the tavern, up the stairs: a stage across
  // the back wall with a five-piece band on it, notes drifting over a dance
  // floor whose tiles change color, and tables along both sides. The band is
  // scenery, the way the cat is: the guitarist and bassist strum, the drummer
  // and the keys hit, the singer waves, and nobody is told where anything is.
  // The scene names `lamplight`, so the chandelier warms the band and the
  // dance floor, and the sconces the back corners.
  // The picture this draws is `upstairs.frame.txt`, which `scenes.test.js` pins.
  import Scene from '@/components/Scene.mesa'
  import { INDOORS } from '@/lib/scene/stage.js'
  import Piece from '@/components/Piece.mesa'
  import Door  from '@/components/Door.mesa'
  import { piece, withSeasons } from '@/pieces/index.js'
  import { framed } from '@/pieces/frame.js'
  import { table }  from '@/pieces/table.js'
  import { barrel } from '@/pieces/barrel.js'
  import { sconce } from '@/pieces/sconce.js'
  import { chandelier } from '@/pieces/chandelier.js'
  import { stairs } from '@/pieces/stairs.js'
  import { PARTS }  from '@/lib/band/band.js'

  // Arms and strumming hands are cells that cycle between two glyphs (`chars`
  // in the palette), so the band plays with no clock of its own. Two cells of
  // one pair are given opposite orders, so a drummer's arms are never both up.
  // Their `ms` are an eighth and a beat at 100 bpm from the epoch `band.js`
  // counts from, so they move on the beat of a song drawn at that tempo and
  // drift against the others; a palette's `ms` cannot follow the song.
  const guitarist = piece('guitarist', String.raw`
 ☻
/|\=--
/ \
`, String.raw`
 s
ppaiii
p p
`)

  const singer = piece('singer', String.raw`
 ☻  o
/|\ |
/ \_|_
`, String.raw`
 s  i
cca i
c ciii
`)

  const drummer = piece('drummer', String.raw`
*  \☻/  *
(~)[O](~)
  /   \
`, String.raw`
k  asd  k
rrriiirrr
  r   r
`)

  const bassist = piece('bassist', String.raw`
 ☻
/|\===--
/ \
`, String.raw`
 s
eeaiiiii
e e
`)

  const keys = piece('keys', String.raw`
  ☻
 \|/
[=|=|=|=]
`, String.raw`
  s
 aod
iiiiiiiii
`)

  // The members, left to right along the stage, as the tags below place them
  // (the editor reads a flat list of tags, so no `{#each}`). Each stands on
  // y = 10, and the boards are drawn around the cells they hold, since two
  // pieces never claim one cell; a member moved here and not below is refused
  // at mount.
  const BAND = [
    { of: guitarist, x: 22, y: 10 },
    { of: singer,    x: 32, y: 10 },
    { of: drummer,   x: 44, y: 10 },
    { of: bassist,   x: 59, y: 10 },
    { of: keys,      x: 68, y: 10 },
  ]
  const STAGE = { x: 18, y: 9, w: 60, h: 5 }
  const held = new Set(BAND.flatMap((m) => m.of.cells.map((c) => `${m.x + c.dx},${m.y + c.dy}`)))
  const boards = (pick) => Array.from({ length: STAGE.h }, (_, r) =>
    Array.from({ length: STAGE.w }, (_, c) => (held.has(`${STAGE.x + c},${STAGE.y + r}`) ? ' ' : pick(r, c))).join(''))
  const planks = piece('boards',
    boards((r) => (r === STAGE.h - 1 ? '=' : '.')).join('\n'),
    boards((r) => (r === STAGE.h - 1 ? 'K' : 'k')).join('\n'),
    { floor: true })

  // The curtain behind them, one row under the top wall, with the band's name.
  const NAME = '[ THE LAST CALL ]'
  const hung = (fill) => {
    const lead = Math.floor((STAGE.w - NAME.length) / 2)
    return `${fill.repeat(lead)}${NAME}${fill.repeat(STAGE.w - NAME.length - lead)}`
  }
  const side = Math.floor((STAGE.w - NAME.length) / 2)
  const curtain = piece('curtain', hung('~'), `${'q'.repeat(side)}${'B'.repeat(NAME.length)}${'q'.repeat(STAGE.w - NAME.length - side)}`)

  // The year dresses the loft, never moves a wall. Summer is the scene's own
  // letters; every other season brings letters no scene names, one set to a
  // piece: the curtain's cloth, the dance floor's tiles, the chandelier's
  // flames, and what drifts over the room in place of notes.
  const cloth = (fg) => ({ paint: { q: 'V' }, palette: { V: { fg } } })
  const dressed = withSeasons(curtain, {
    spring: cloth('#15803d'),
    fall:   cloth('#9a3412'),
    winter: cloth('#1d4ed8'),
  })

  // The scope over the stage: a trace per member, each lane labelled in its
  // member's paint, which is where `Band.mesa` reads the lane's ink. The
  // traces are drawn in `inner` by the band, so the picture is the box bare.
  // Hung above the curtain, the loft is taller than a 30-row terminal shows,
  // and the band pins the box to the view's top while it is panned off.
  const LANES = { guitar: 'p', singer: 'c', drums: 'r', bass: 'e', keys: 'o' }
  const lane = (fill, label) => `${fill[0]} ${label.padEnd(6)} ${' '.repeat(STAGE.w - 11)} ${fill[0]}`
  const scope = {
    ...piece('scope', [
      `.${'-'.repeat(STAGE.w - 2)}.`,
      ...PARTS.map((p) => lane('|', p)),
      `'${'-'.repeat(STAGE.w - 2)}'`,
    ].join('\n'), [
      'l'.repeat(STAGE.w),
      ...PARTS.map((p) => lane('l', LANES[p].repeat(p.length))),
      'l'.repeat(STAGE.w),
    ].join('\n')),
    inner: { dx: 9, dy: 1, w: STAGE.w - 11, h: PARTS.length },
    inks:  PARTS.map((p) => LANES[p]),
  }

  // The loft is the frame of a one-screen room with the scope's seven rows on top.
  const frame = framed(96, 33)

  const floor = { x: 30, y: 17, w: 36, h: 5 }
  const tiles = (pick) => Array.from({ length: floor.h }, (_, r) =>
    Array.from({ length: floor.w }, (_, c) => pick((r + c) % 2)).join('')).join('\n')
  const dance = piece('dance floor', tiles(() => '+'), tiles((p) => 'gG'[p]), { floor: true })
  const checks = (a, b, chars) => ({
    paint: { g: 'A', G: 'D' },
    palette: { A: { fg: a, chars, ms: 600 }, D: { fg: b, chars: [...chars].reverse().join(''), ms: 600 } },
  })
  const tiled = withSeasons(dance, {
    spring: checks(['#f9a8d4', '#86efac', '#fde047', '#c4b5fd'], ['#86efac', '#f9a8d4', '#c4b5fd', '#fde047'], '+x'),
    fall:   checks(['#f97316', '#d97706', '#b45309', '#facc15'], ['#facc15', '#b45309', '#d97706', '#f97316'], '+x'),
    winter: checks(['#e0f2fe', '#7dd3fc', '#bfdbfe', '#ffffff'], ['#ffffff', '#bae6fd', '#7dd3fc', '#e0f2fe'], '*+'),
  })

  const glow = (fg, light) => ({ paint: { C: 'H' }, palette: { H: { fg, ms: 900, flicker: true, light } } })
  const lit = withSeasons(chandelier, {
    spring: glow(['#fef9c3', '#fde68a', '#fef08a', '#fef9c3'], 5),
    fall:   glow(['#fb923c', '#f97316', '#fbbf24', '#fb923c'], 6),
    winter: glow(['#fde047', '#facc15', '#fb923c', '#fde047'], 7),
  })

  // Notes in the air over the room between the stage and the dance floor, each
  // letter a note cycling through the four at a different place in the turn.
  const NOTES = 'nNm'
  // The chandelier hangs in the same rows, and the notes keep a cell clear of
  // it; one moved here and not below, or there and not here, overlaps and is
  // refused at mount.
  const NOTES_AT = { x: STAGE.x, y: 14 }
  const CHANDELIER = { x: 43, y: 14 }
  const ring = {
    x0: CHANDELIER.x - 1, x1: CHANDELIER.x + Math.max(...chandelier.cells.map((c) => c.dx)) + 1,
    y0: CHANDELIER.y,     y1: CHANDELIER.y + Math.max(...chandelier.cells.map((c) => c.dy)),
  }
  const clear = (x, y) => x < ring.x0 || x > ring.x1 || y < ring.y0 || y > ring.y1
  const air = (row) => Array.from({ length: STAGE.w }, (_, c) =>
    ((c + row * 3) % 9 === 0 && clear(NOTES_AT.x + c, NOTES_AT.y + row) ? '♪' : ' ')).join('')
  const rows = [0, 1, 2].map(air)
  const notes = piece('notes', rows.join('\n'),
    rows.map((r, i) => [...r].map((ch, c) => (ch === ' ' ? ' ' : NOTES[(Math.floor((c + i * 3) / 9) + i) % 3])).join('')).join('\n'),
    { overhead: 3 })

  // Petals, leaves and snow drift where the notes do, on the same cells.
  const drift = (chars, a, b, c) => ({
    art: { '♪': chars[0] },
    paint: { n: 'I', N: 'J', m: 'L' },
    palette: { I: { fg: a, chars, ms: 600 }, J: { fg: b, chars: chars.slice(1) + chars[0], ms: 600 }, L: { fg: c, chars: chars.slice(2) + chars.slice(0, 2), ms: 600 } },
  })
  const drifting = withSeasons(notes, {
    spring: drift('✿❀✾❁', ['#f9a8d4', '#fef9c3', '#fda4af', '#ffffff'], ['#ffffff', '#f9a8d4', '#fde047', '#fda4af'], ['#fde047', '#f9a8d4', '#ffffff', '#c4b5fd']),
    fall:   drift('❧☙❦❧', ['#f97316', '#c2410c', '#d97706', '#92400e'], ['#d97706', '#f97316', '#92400e', '#c2410c'], ['#b45309', '#d97706', '#f97316', '#c2410c']),
    winter: drift('❄❅❆*', ['#ffffff', '#e0f2fe', '#bae6fd', '#ffffff'], ['#e0f2fe', '#ffffff', '#ffffff', '#bae6fd'], ['#bae6fd', '#ffffff', '#e0f2fe', '#ffffff']),
  })

  const PALETTE = {
    f: { fg: '#6b7280' },
    l: { fg: '#9ca3af' },
    u: { fg: '#854d0e' },
    t: { fg: '#a16207' },
    c: { fg: '#22d3ee' },
    y: { fg: ['#fde047', '#fbbf24', '#fef08a'], chars: 'i!i', ms: 300, flicker: true },
    k: { fg: '#78350f' },
    K: { fg: '#b45309' },
    q: { fg: '#b91c1c' },
    B: { fg: '#fde047' },
    s: { fg: '#fcd34d' },
    i: { fg: '#a16207' },
    p: { fg: '#f472b6' },
    e: { fg: '#a3e635' },
    r: { fg: '#ef4444' },
    o: { fg: '#fb923c' },
    a: { fg: '#fcd34d', chars: '\\|', ms: 300 },
    d: { fg: '#fcd34d', chars: '/_', ms: 300 },
    n: { fg: ['#f472b6', '#22d3ee', '#a3e635', '#fde047'], chars: '♪♫♩♬', ms: 600 },
    N: { fg: ['#fde047', '#f472b6', '#22d3ee', '#a3e635'], chars: '♫♩♬♪', ms: 600 },
    m: { fg: ['#a3e635', '#fde047', '#f472b6', '#22d3ee'], chars: '♩♬♪♫', ms: 600 },
    g: { fg: ['#f472b6', '#22d3ee', '#a3e635', '#fde047'], chars: '+x', ms: 600 },
    G: { fg: ['#fde047', '#a3e635', '#22d3ee', '#f472b6'], chars: 'x+', ms: 600 },
  }
</script>

<Scene slug="upstairs" layers={[...INDOORS, 'lamplight']} palette={PALETTE} spawn={{ x: 30, y: 30 }}>
  <Piece of={frame} />
  <Piece of={stairs} x={2} y={28} />
  <Door  x={17} y={28} to="/tavern/" />
  <Piece of={scope}   x={18} y={1} />
  <Piece of={dressed} x={18} y={8} />
  <Piece of={planks}  x={18} y={9} />
  <Piece of={guitarist} x={22} y={10} />
  <Piece of={singer}    x={32} y={10} />
  <Piece of={drummer}   x={44} y={10} />
  <Piece of={bassist}   x={59} y={10} />
  <Piece of={keys}      x={68} y={10} />
  <Piece of={sconce} x={8}  y={1} />
  <Piece of={sconce} x={86} y={1} />
  <Piece of={drifting} x={18} y={14} />
  <Piece of={lit} x={43} y={14} />
  <Piece of={tiled}  x={30} y={17} />
  <Piece of={table}  x={6}  y={17} />
  <Piece of={table}  x={6}  y={21} />
  <Piece of={table}  x={80} y={17} />
  <Piece of={table}  x={80} y={21} />
  <Piece of={table}  x={29} y={25} />
  <Piece of={table}  x={49} y={25} />
  <Piece of={table}  x={69} y={25} />
  <Piece of={barrel} x={90} y={27} />
  <slot />
</Scene>
