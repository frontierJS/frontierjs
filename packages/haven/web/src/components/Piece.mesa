<script>
  // Piece.mesa — one piece placed on the scene it is inside (`FJS-D997`): its
  // glyphs are claimed on the stage at `x, y`, and a change of `x` or `y`
  // moves them. It draws nothing itself — `#paint` draws the stage.
  export let of  // a piece() block
  export let x = 0
  export let y = 0

  const scene = $context.scene
  var mark = scene.stamp(of, x, y)
  $: mark.move(x, y)
  $.onDestroy(() => mark.remove())
</script>
