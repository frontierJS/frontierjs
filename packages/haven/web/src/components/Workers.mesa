<script>
  // Workers.mesa — the Claude sessions working on this machine, each a figure
  // at the bench of the package it last edited (`IDEAS/haven.md` Phase 11),
  // read from `#workers` and drawn on this screen only — never sent, as the
  // tavern's runner is never sent. Two or more at one bench are about to edit
  // one package in a shared tree, so that bench says how many, and since a
  // figure here is drawn whatever the fog, it is seen from the door.
  //
  // A session stopped on a permission prompt or a question is `?`, and its
  // bench says so: it is waiting on you, and nothing else on this machine
  // shows that until you tab to it. A session that has stopped is `✓`.
  //
  // Standing beside a worker reads it: what it asks, else its last words,
  // else the file it last touched, and how long ago. No key does this,
  // because the line input holds the keys and a letter pressed beside a
  // worker would be typed into the line. A session that is one of the
  // study's tabs reads out with its number in the study's bar, `[2]`.
  //
  // A route places this (`routes/workshop.mesa`) and never the scene file:
  // the scene's picture is pinned, and the directory differs per machine.
  import { at } from '#cell'
  import { studyTabs } from '#study'
  import { readWorkers } from '#workers'

  const scene = $context.scene
  const POLL_MS = 1000
  // The figures a bench has room for beside its count.
  const SEATS = 3

  let workers = readWorkers()
  let tabs = studyTabs()
  let now  = Date.now()
  let view = scene.view
  let me   = scene.seer
  $.onDestroy(scene.subscribe(() => { view = scene.view; me = scene.seer }))
  $.onDestroy(scene.task('workers', (ms) => { workers = readWorkers({ now: ms }); tabs = studyTabs(); now = ms }, { every: POLL_MS }))

  const glyph = (w) => (w.asking ? '?' : w.said ? '✓' : '✻')

  /** What standing beside a worker reads. */
  function reading(w, now, tabs) {
    const s = tabs.has(w.session) ? `[${tabs.get(w.session)}] ${w.session.slice(0, 4)}` : w.session.slice(0, 4)
    if (w.asking) return `${s} asks: ${w.asking.why} · ${ago(now - w.asking.at)}`
    if (w.said) return `${s} done: ${w.said.text} · ${ago(now - w.said.at)}`
    return w.file ? `${s} ${w.file} · ${ago(now - w.at)}` : `${s} working · ${ago(now - w.seen)}`
  }

  const ago = (ms) => (ms < 60_000 ? `${Math.max(0, Math.round(ms / 1000))}s ago` : `${Math.round(ms / 60_000)}m ago`)

  /** What is drawn, in the view's cells: a figure per worker, a count over a crowded bench, and the worker beside `me` read out. */
  function placed(ws, v, me, now, tabs) {
    const benches = new Map(scene.marks.filter((m) => m.kind === 'piece' && m.piece.bench).map((m) => [m.piece.bench, m]))
    const byBench = new Map()
    for (const w of ws) if (benches.has(w.bench)) byBench.set(w.bench, [...(byBench.get(w.bench) ?? []), w])
    const out = []
    const figures = []
    for (const [name, all] of byBench) {
      const b = benches.get(name)
      // One asking is seated before the rest, so a full bench never hides it.
      const here = [...all.filter((w) => w.asking), ...all.filter((w) => !w.asking)]
      here.slice(0, SEATS).forEach((w, i) => {
        const f = { w, ...b.spot(`slot-${i}`) }
        figures.push(f)
        out.push({ key: `w:${w.session}`, x: f.x, y: f.y, text: glyph(w), layer: 11 })
      })
      const asks = here.filter((w) => w.asking).length
      const says = [here.length > 1 && `! ${here.length} here`, asks && `? ${asks} waiting on you`].filter(Boolean)
      if (says.length) {
        out.push({ key: `n:${name}`, ...b.spot(`slot-${Math.min(here.length, SEATS)}`), text: `(${says.join(' · ')})`, layer: 12, surface: true })
      }
    }
    const near = me && figures.find((f) => Math.abs(f.x - me.x) <= 1 && Math.abs(f.y - me.y) <= 1)
    if (near) {
      const text = reading(near.w, now, tabs)
      out.push({ key: 'read', x: near.x, y: near.y + 1, text, layer: 12, surface: true })
    }
    // A figure off the view is not drawn; a line is kept inside it, as a bubble is.
    return out
      .filter((o) => o.y >= v.y && o.y < v.y + v.h && (o.surface || (o.x >= v.x && o.x < v.x + v.w)))
      .map((o) => {
        const text = o.text.slice(0, v.w)
        return { ...o, text, x: Math.max(0, Math.min(o.x - v.x, v.w - text.length)), y: o.y - v.y }
      })
  }
</script>

{#each placed(workers, view, me, now, tabs) as o (o.key)}
  {#if o.surface}
    <p class="surface" {@attach at(o.x, o.y, o.layer)}>{o.text}</p>
  {:else}
    <p {@attach at(o.x, o.y, o.layer)}>{o.text}</p>
  {/if}
{/each}
