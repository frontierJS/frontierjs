<script>
  // Bubbles.mesa — the newest line of each member standing here, over where
  // they stand (`crowd.js` holds the rule: only a line this figure hears, a
  // speaker outside the view marked on the edge toward them). Placed by
  // `Scene.mesa` with the presence it made; the lines are the messages store
  // the scene loaded.
  import { useStore } from '@frontierjs/sierra/resource'
  import { messages } from '@/resources/Message.mesa'
  import { bubbles } from '@/crowd.js'
  import { at } from '#cell'

  export let here
  export let x
  export let y
  export let view
  export let spawn

  const { get: lines, unsubscribe } = useStore(messages.store)
  $.onDestroy(unsubscribe)
</script>

{#each bubbles(here.get(), lines(), x, y, view, spawn) as b (b.key)}
  <p class="surface" {@attach at(b.x, b.y, 12)}>{b.text}</p>
{/each}
