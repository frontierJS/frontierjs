<script>
  // Scene.mesa — one room drawn (`FJS-D997`): a stage its children claim
  // cells on — `<Piece>`, `<Row>`, `<Door>`, `<Pacer>`, through
  // `$context.scene` — painted in the scene's palette and kept moving; and,
  // when a `WalkIn` has set `$context.room`, the room on it: a figure for
  // every member standing here, a bubble over each with the newest line they
  // said, and the line this member is typing. With no room it is a picture,
  // which is what `scenes.test.js` renders against `<name>.frame.txt`.
  //
  // `#paint` and `#cell` are the package's subpath imports: the browser
  // condition picks the `.browser.js` twin, every other runtime the
  // terminal's (`FJS-D985`), so this file is the same on both targets. The
  // figures are `at()` boxes in the same box the stage is painted in, so a
  // figure's cell is the stage's cell less the view's corner.
  //
  // A scene may be bigger than a screen (6.1): the stage's `view` is the
  // slice drawn, and this figure is the one it follows, so it pans when the
  // figure nears an edge. A figure outside the view is not drawn, and a
  // speaker outside it is their line as a marker on the edge facing them,
  // so a line is never lost to the pan. The figure is also the one that
  // SEES (6.3): the stage lights what it can see, and another figure
  // standing in the dark is not drawn — their line is, over the dark cell,
  // if it is one this figure hears.
  //
  // A line is heard within earshot of its speaker, a `!` line by the whole
  // room, and a whisper by the member it names (`api/src/hearing.ts`, 7.1).
  // The server sends a line to those who hear it; the lines loaded from the
  // room's history are every line, so a bubble is drawn only for a speaker
  // this figure hears from where each stands now.
  //
  // A line beginning `/` is a command and never a Message. What it can name
  // is `$context.commands` (`commands.js`), the one registry: the actors in
  // this scene add their verbs to it — `Whisper` the `/w`, `Mod` the `/ban`,
  // `WorldMap` the `/map`, `History` the PageUp and PageDown, and whatever a
  // route places (`Taskmaster`, `Ledger`) — and this file reads it for the
  // line, Tab, the hints and the keys. The bubbles, the nameplates and the
  // booth are actors too (`Bubbles`, `Nameplates`, `Sitting`).
  //
  // Arrows walk while the input line is empty and edit it while it is not, so
  // a line being typed is never walked away from by a Left meant for it. In
  // the terminal shell's NORMAL mode h j k l arrive as the arrows, and a step
  // is prevented so the shell does not also move focus for a j or a k. A step
  // onto a door is a navigation carrying where it was stepped through
  // (`from`, `x`, `y` in the query), the next route's walk-in cycles the
  // socket into that room, and its scene stands the figure beside the door
  // that leads back (`arrival()` in stage.js) — a border is crossed at the
  // matching row, and a door is come out of. The arrival is read at mount,
  // once the pieces have claimed their cells, and the figure moved to it;
  // the presence itself is made here, in the component's own scope, since
  // one made in `$.onMount` has no owner and its leave never runs.
  //
  // In NORMAL a `/` enters INSERT with the slash typed (Shell.mesa), and Tab
  // completes the command word of a line that is only `/` and a partial word;
  // the matches are listed under the input as they narrow.
  //
  // The map (`IDEAS/haven.md` 6.4) is a command, not a key: a letter would be
  // typed into the line, as in the workshop. Walking into a room keeps its
  // picture for the map (`#seen`).
  //
  // `a s d f` are the left hand's (`IDEAS/haven.md` 9.4), read only where the
  // shell took the letter as NORMAL: it prevents a printable key it will not
  // type, so a key that arrives prevented is a home-row key, and one that
  // arrives free is a letter going into the line (INSERT, or a browser, which
  // has no NORMAL). `f` and a letter walks to the nearest member in the light
  // whose nick starts with it, a step a tick, until beside them, a key, or Esc;
  // `s` and a character draws this figure as it for SHAPE_MS. Facing is the way
  // this figure last turned, one more presence key beside `{ x, y }`, which an
  // arrow into a wall also sets.
  //
  // A bolt (`d`, 9.5) is the server's answer, told to the whole room as one
  // `bolt` event: every screen draws the flight cell by cell and, as it
  // lands, flickers the struck figures, moves THIS figure if it is one of
  // them (the only screen that may, since a position is its owner's), breaks
  // the pieces and scorches the walls it laid. A joiner is handed what still
  // lasts by `rooms.traces`, with the footprints.
  //
  // A step onto a cell whose palette entry `dye`s (the square's flowers)
  // takes that cell's color as it is drawn at that moment, and the figure
  // wears it as `ink`, a presence key, on every screen. It is kept in
  // `worn` across doors, since each scene is a fresh mount and its presence
  // is seeded with it; nothing keeps it past the process.
  //
  // The map and the room's history are modes (`commands.open`): while one is
  // open the home row is off, and its Esc is read before a step.
  import { presence }    from '@frontierjs/sierra/presence'
  import { getClient }    from '@frontierjs/sierra/resource'
  import { goto, page }  from '@frontierjs/sierra/router'
  import { members }     from '@/resources/Member.mesa'
  import { messages }    from '@/resources/Message.mesa'
  import { rooms }       from '@/resources/Room.mesa'
  import { createStage, arrival, OUTDOORS, worn } from '@/stage.js'
  import { remember }    from '@/map.js'
  import { createCommands, complete, matches, partial } from '@/commands.js'
  import { cellOf, figures, inView } from '@/crowd.js'
  import { facingOf, FIRST_FACING } from '../../../api/src/facing.ts'
  import { SHAPE_MS }    from '../../../api/src/shape.ts'
  import { STUN_MS }     from '../../../api/src/bolt.ts'
  import { createHomeRow, PENDING_MS } from '@/home-row.js'
  import { findByNick, pathBeside } from '@/paths.js'
  import { stepped, TRACES } from '../../../api/src/memory.ts'
  import WorldMap        from '@/components/WorldMap.mesa'
  import History         from '@/components/History.mesa'
  import Bubbles         from '@/components/Bubbles.mesa'
  import Nameplates      from '@/components/Nameplates.mesa'
  import Sitting         from '@/components/Sitting.mesa'
  import Whisper         from '@/components/Whisper.mesa'
  import Mod             from '@/components/Mod.mesa'
  import { at, tint }    from '#cell'
  import { paint }       from '#paint'

  export let slug
  export let palette
  export let spawn
  // The layers `look()` folds (`stage.js`): a roof names INDOORS.
  export let layers = OUTDOORS

  var stage = createStage({ slug, palette, spawn, layers })
  $context.scene = stage
  // A verb's answer is the note under the art.
  var commands = createCommands()
  $context.commands = commands

  // A snapshot: the room is set before this mounts and never changes under
  // it. Read reactively it would make `here` derived, and a derived presence
  // is made again on every step — a second subscribe and an empty roster.
  var room = $context.room

  const STEP = { ArrowLeft: [-1, 0], ArrowRight: [1, 0], ArrowUp: [0, -1], ArrowDown: [0, 1] }

  let x = spawn.x
  let y = spawn.y
  // Read through the stage's subscription rather than from `x` and `y`: a
  // piece mounting after this script changes the extent, and the view with it.
  let view = stage.view
  $.onDestroy(stage.subscribe(() => { view = stage.view }))
  $: stage.follow(x, y)
  $: { if (here) stage.see(x, y) }
  let draft = ''
  let note  = ''
  let facing = FIRST_FACING
  let shape  = null
  let ink    = worn.ink
  let nicks = {}
  $: hints = matches(draft, commands.words({ x, y }))

  // A pane sits inside the frame's walls; its last row is the footer.
  const PANE = { x: 1, y: 1, w: 94, h: 24 }

  // Seeded from the spawn and never from `x` and `y`, and a `var`: a
  // top-level const that reads a prop or a `let` is derived — made when it is
  // first read, inside whatever effect reads it, and again on every step.
  var here = room ? presence(`room:${room.id}`, { meta: { ...spawn, ...(worn.ink && { ink: worn.ink }) } }) : null
  $.onMount(() => {
    if (!here) return
    remember(stage, page.pathname)
    const { from, x: fx, y: fy, stand } = page.query
    const start = arrival(stage, { from, x: fx, y: fy, stand })
    if (start.x === x && start.y === y) return
    x = start.x
    y = start.y
    here.updateMeta(meta())
  })
  $.onDestroy(() => {
    stopFind()
    clearTimeout(shapeTimer)
    clearTimeout(dueTimer)
    clearInterval(flickTimer)
    for (const t of timers) clearTimeout(t)
  })

  if (room) {
    messages.load({ roomId: room.id }, { orderBy: '-createdAt', limit: 50 })
      .catch((e) => { note = e.message })
  }

  // Footprints (`IDEAS/haven.md` 7.4): the room's memory of steps once, at the
  // walk-in, then every step taken here laid as it is seen -- this figure's
  // and each other's, by the `stepped()` the server lays them by -- so the
  // server is asked once and a step costs no frame of its own.
  if (room) {
    rooms.service.invoke('traces', room.id)
      .then((all = []) => {
        const kind = (k) => all.filter((t) => t.kind === k)
        stage.tread(kind('step'))
        stage.shatter(kind('struck'))
        stage.scorch(kind('scorch'))
      })
      .catch(() => {})
  }
  const tread = (cells) => {
    const now = Date.now()
    stage.tread(cells.map((c) => ({ ...c, at: now, until: now + TRACES.step.ms })))
  }
  // Each figure's last cell, by connection, to tell its next move from a jump.
  const stood = new Map()
  function trackSteps(others) {
    const laid = []
    for (const m of others) {
      const c = cell(m)
      if (stepped(stood.get(m.connectionId), c)) laid.push(c)
      stood.set(m.connectionId, c)
    }
    if (laid.length) tread(laid)
  }

  // A figure and a line carry a member id; the nick is read once per member.
  const asked = new Set()
  function askNicks(ids) {
    for (const id of ids) {
      if (asked.has(id)) continue
      asked.add(id)
      members.service.get(id)
        .then((row) => { nicks = { ...nicks, [id]: row.nick } })
        .catch(() => {})
    }
  }
  $: { if (here) askNicks(here.get().members.map((m) => m.userId)) }

  const glyph  = (m, names) => (names[m.userId] ?? '?')[0].toUpperCase()
  const cell = (m) => cellOf(m, spawn)

  // A table's candle burns only while a stool of it is taken.
  $: { if (here) stage.occupy([{ x, y }, ...here.get().others.map(cell)]) }
  $: { if (here) trackSteps(here.get().others) }

  // The shell focuses a route's first control when it mounts it, and this
  // scene mounts later, once the room's row is read.
  const focus = (el) => el.focus()

  // ─── the home row ──────────────────────────────────────────────────────────
  // Handles, not state a template reads: `var`, so none is derived.
  var row = createHomeRow()
  var walking = null
  var shapeTimer = null
  var dueTimer = null
  // 120 ms a step is under the room's 10 moves a second.
  const FIND_MS = 120

  function meta() {
    return { x, y, facing, ...(shape && { shape }), ...(ink && { ink }) }
  }

  function moveTo(nx, ny) {
    facing = facingOf({ x, y }, { x: nx, y: ny }) ?? facing
    const walked = stepped({ x, y }, { x: nx, y: ny })
    x = nx
    y = ny
    ink = worn.ink = stage.dyeAt(x, y, Date.now()) ?? ink
    here.updateMeta(meta())
    if (walked) tread([{ x, y }])
  }

  function stopFind() {
    clearInterval(walking)
    walking = null
  }

  /** One step toward the member `id`, from where each stands now: they may have moved. */
  function stepToward(id) {
    const m = here.get().others.find((o) => o.userId === id)
    const path = m && pathBeside(stage, { x, y }, cell(m))
    if (!path?.length) stopFind()
    else moveTo(path[0].x, path[0].y)
  }

  function find(letter) {
    const figs = here.get().others
      .filter((m) => nicks[m.userId] && stage.light(cell(m).x, cell(m).y) === 'lit')
      .map((m) => ({ id: m.userId, nick: nicks[m.userId], ...cell(m) }))
    const found = findByNick(stage, { x, y }, figs, letter)
    if (!found) { note = `nobody here is called ${letter}…`; return }
    note = ''
    if (!found.path.length) return
    walking = setInterval(() => stepToward(found.figure.id), FIND_MS)
  }

  function shapeshift(ch) {
    clearTimeout(shapeTimer)
    shape = ch
    shapeTimer = ch ? setTimeout(() => { shape = null; here.updateMeta(meta()) }, SHAPE_MS) : null
    here.updateMeta(meta())
    note = ch ? `you are ${ch} for a minute` : 'you are yourself again'
  }

  // ─── the bolt ──────────────────────────────────────────────────────────────
  // One cell of a flight a FLY_MS, kept HOLD_MS once it has landed. Each bolt
  // has its own timers: a second one arriving mid-flight must not take the
  // first one's landing with it.
  const FLY_MS   = 30
  const HOLD_MS  = 150
  const FLICK_MS = 100
  const BEAM_INK = '#ffe680'
  let beam  = []
  let stun  = {}
  let flick = false
  var timers = new Set()
  var flickTimer = null
  var shots = 0

  function later(fn, ms) {
    const t = setTimeout(() => { timers.delete(t); fn() }, ms)
    timers.add(t)
  }

  function flicker() {
    if (flickTimer) return
    flickTimer = setInterval(() => {
      const t = Date.now()
      stun = Object.fromEntries(Object.entries(stun).filter(([, until]) => until > t))
      flick = !flick
      if (!Object.keys(stun).length) { clearInterval(flickTimer); flickTimer = null; flick = false }
    }, FLICK_MS)
  }

  /** What a bolt does once it has crossed its cells. */
  function land(blast) {
    const me = here.get().self?.userId
    const t = Date.now()
    for (const s of blast.struck ?? []) {
      stun = { ...stun, [s.id]: t + STUN_MS }
      if (me != null && String(s.id) === String(me)) {
        stopFind()
        x = s.to.x
        y = s.to.y
        here.updateMeta(meta())
      }
    }
    if (blast.struck?.length) flicker()
    const laid = blast.laid ?? []
    stage.shatter(laid.filter((l) => l.kind === 'struck' && l.id))
    stage.scorch(laid.filter((l) => l.kind === 'scorch'))
    if (blast.yowl) note = 'the cat yowls'
  }

  function onBolt(name, blast) {
    if (name !== 'bolt' || !Array.isArray(blast?.flights)) return
    const shot = ++shots
    const longest = Math.max(0, ...blast.flights.map((f) => f.path.length))
    for (const f of blast.flights) {
      const ch = f.facing === 'n' || f.facing === 's' ? '|' : '-'
      f.path.forEach((c, i) => later(() => { beam = [...beam, { key: `${shot}:${c.x},${c.y}`, shot, x: c.x, y: c.y, ch }] }, (i + 1) * FLY_MS))
    }
    later(() => land(blast), longest * FLY_MS)
    later(() => { beam = beam.filter((b) => b.shot !== shot) }, longest * FLY_MS + HOLD_MS)
  }

  if (room) {
    const client = getClient()
    client?.on('event', onBolt)
    $.onDestroy(() => client?.off('event', onBolt))
  }

  /** The beam's cells in the view and not in the dark, at their cell of the view. */
  const flying = (cells, v) => cells
    .filter((b) => inView(b, v) && stage.light(b.x, b.y) !== 'dark')
    .map((b) => ({ key: b.key, ch: b.ch, x: b.x - v.x, y: b.y - v.y }))

  /** A struck figure's glyph is an `x` on every other beat of its second. */
  const face = (id, glyph, stunned, beat) => (stunned[id] && beat ? 'x' : glyph)

  async function fire(volley, way) {
    try {
      await rooms.service.invoke('bolt', null, { roomId: room.id, ...(way && { facing: way }), ...(volley && { volley: true }) })
      note = ''
    } catch (e) { note = e.message }
  }

  function run(a) {
    if (a === true || !a?.act) return
    stopFind()
    if (a.act === 'bolt')   fire(false, a.facing)
    if (a.act === 'volley') fire(true)
    if (a.act === 'find')   find(a.letter)
    if (a.act === 'shape')  shapeshift(a.ch)
    if (a.act === 'chalk')  note = 'chalk is not drawn yet'
  }

  /** Whether the key was the home row's; a late `d`'s bolt runs, and the key that outran it is asked again. */
  function homeRow(e) {
    if (!room || draft || commands.mode) return false
    if (!row.pending && !(e.defaultPrevented && e.key.length === 1)) return false
    clearTimeout(dueTimer)
    const r = row.key(e.key)
    if (r === null) return false
    e.preventDefault()
    run(r)
    if (r.after === null) return false
    run(r.after)
    if (row.pending === 'd') dueTimer = setTimeout(() => run(row.due()), PENDING_MS + 10)
    return true
  }

  const keydown = (e) => {
    if (room && e.key === 'Tab' && partial(draft) !== null) {
      e.preventDefault()
      draft = complete(draft, commands.words({ x, y }))
      return
    }
    if (room && commands.press(e.key, { x, y }, e)) return
    if (walking && e.key === 'Escape') {
      e.preventDefault()
      stopFind()
      return
    }
    if (homeRow(e)) return
    if (commands.mode && commands.modeKey(e)) {
      e.preventDefault()
      return
    }
    const step = STEP[e.key]
    if (!step || !room || draft) return
    e.preventDefault()
    stopFind()
    const nx = x + step[0]
    const ny = y + step[1]
    const turned = facingOf({ x, y }, { x: nx, y: ny })
    const door = stage.doorAt(nx, ny, Date.now())
    if (door) { goto(door.to, { from: page.pathname, x: nx, y: ny }); return }
    if (!stage.walkable(nx, ny)) {
      if (turned !== facing) { facing = turned; here.updateMeta(meta()) }
      return
    }
    moveTo(nx, ny)
  }

  async function command(line) {
    const word = line.slice(1).split(/\s+/)[0]
    const found = commands.find(word, { x, y })
    if (!found) return `no command /${word} — ${commands.helps({ x, y }).join(', ')}`
    if (!found.reached) return 'nobody here to answer'
    return (await found.verb.run({ line, args: line.slice(1 + word.length).trim(), at: { x, y } })) ?? ''
  }

  async function say() {
    const body = draft.trim()
    if (!body) return
    draft = ''
    note  = ''
    try {
      if (body.startsWith('/')) note = await command(body)
      else await messages.save({ roomId: room.id, body })
    } catch (e) { note = e.message }
  }
</script>

<mesa:window on:keydown={keydown} />
<div {@attach paint(stage)}>
  <slot />
  {#if here}
    {#each figures(here.get(), view, stage, spawn) as f (f.m.connectionId)}
      <p {@attach at(f.x, f.y)} {@attach tint(f.m.meta?.ink)}>{face(f.m.userId, f.m.meta?.shape ?? glyph(f.m, nicks), stun, flick)}</p>
    {/each}
    <Nameplates {here} {nicks} {x} {y} {view} {stage} {spawn} />
    <p {@attach at(x - view.x, y - view.y, 11)} {@attach tint(ink)}>{face(here.get().self?.userId, shape ?? '@', stun, flick)}</p>
    {#each flying(beam, view) as b (b.key)}
      <p {@attach at(b.x, b.y, 10)} {@attach tint(BEAM_INK)}>{b.ch}</p>
    {/each}
    <Bubbles {here} {x} {y} {view} {spawn} />
    <WorldMap {stage} route={page.pathname} {x} {y} box={PANE} />
    <History {room} {nicks} box={PANE} {askNicks} />
    <Sitting {stage} {here} {x} {y} {spawn} tell={(text) => { note = text }} />
    <Whisper {room} {here} />
    <Mod />
  {/if}
</div>
{#if here}
  <p>{room.name} · {here.get().count} here{#each here.get().others as m (m.connectionId)} · {nicks[m.userId] ?? '…'}{/each}</p>
  {#if note}<p>{note}</p>{/if}
  {#if hints.length && partial(draft) !== null}<p>{hints.map((c) => `/${c}`).join('  ')} · Tab completes</p>{/if}
  <form on:submit|preventDefault={say}>
    <input {@attach focus} bind:value={draft} placeholder="arrows walk, type and Enter says, PageUp reads back" />
  </form>
{/if}
