<script>
  // Scene.mesa — one room drawn (`FJS-D997`): a stage its children claim
  // cells on — `<Piece>`, `<Row>`, `<Door>`, `<Pacer>`, through
  // `$context.scene` — painted in the scene's palette and kept moving; and,
  // when a `WalkIn` has set `$context.room`, the room on it: a figure for
  // every member standing here, a bubble over each with the newest line they
  // said, and the line this member is typing. With no room it is a picture,
  // which is what `scenes.test.js` renders against `<name>.frame.txt`.
  //
  // `#paint` and `#cell` are the package's subpath imports: the browser
  // condition picks the `.browser.js` twin, every other runtime the
  // terminal's (`FJS-D985`), so this file is the same on both targets. The
  // figures are `at()` boxes in the same box the stage is painted in, so a
  // figure's cell is the stage's cell less the view's corner.
  //
  // A scene may be bigger than a screen (6.1): the stage's `view` is the
  // slice drawn, and this figure is the one it follows, so it pans when the
  // figure nears an edge. A figure outside the view is not drawn, and a
  // speaker outside it is their line as a marker on the edge facing them,
  // so a line is never lost to the pan.
  //
  // A line beginning `/` is a command and never a Message: `/ban <nick>` and
  // `/unban <nick>` are an ordinary patch of the member's `bannedAt`, which the
  // schema admits a mod to and drops for anyone else (`FJS-D22`) — so the
  // answer, not the call, says whether it happened.
  //
  // Arrows walk while the input line is empty and edit it while it is not, so
  // a line being typed is never walked away from by a Left meant for it. In
  // the terminal shell's NORMAL mode h j k l arrive as the arrows, and a step
  // is prevented so the shell does not also move focus for a j or a k. A step
  // onto a door is a navigation, and the next route's walk-in cycles the
  // socket into that room.
  //
  // PageUp opens the room's history over the art and pages back through it,
  // PageDown pages forward and closes it past the newest line, as a
  // terminal's own scrollback does; Esc closes it. The pane reads the same
  // store the bubbles do, newest first, and grows it by a page when the
  // window reaches the oldest line loaded. The keys are prevented so the
  // terminal's page does not scroll under the pane and the shell does not
  // leave the route on the Esc.
  import { presence }    from '@frontierjs/sierra/presence'
  import { useStore }    from '@frontierjs/sierra/resource'
  import { goto }        from '@frontierjs/sierra/router'
  import { members }     from '@/resources/Member.mesa'
  import { messages }    from '@/resources/Message.mesa'
  import { createStage } from '@/stage.js'
  import { at }          from '#cell'
  import { paint }       from '#paint'

  export let slug
  export let palette
  export let spawn

  var stage = createStage({ slug, palette, spawn })
  $context.scene = stage

  // A snapshot: the room is set before this mounts and never changes under
  // it. Read reactively it would make `here` derived, and a derived presence
  // is made again on every step — a second subscribe and an empty roster.
  var room = $context.room

  const STEP = { ArrowLeft: [-1, 0], ArrowRight: [1, 0], ArrowUp: [0, -1], ArrowDown: [0, 1] }

  let x = spawn.x
  let y = spawn.y
  // Read through the stage's subscription rather than from `x` and `y`: a
  // piece mounting after this script changes the extent, and the view with it.
  let view = stage.view
  $.onDestroy(stage.subscribe(() => { view = stage.view }))
  $: stage.follow(x, y)
  let draft = ''
  let note  = ''
  let nicks = {}

  // The pane sits inside the frame's walls; its last row is the footer.
  const PANE = { x: 1, y: 1, w: 94, h: 24 }
  const ROWS = PANE.h - 1
  let pane = false
  let back = 0

  // Seeded from the spawn and never from `x` and `y`, and a `var`: a
  // top-level const that reads a prop or a `let` is derived — made when it is
  // first read, inside whatever effect reads it, and again on every step.
  var here = room ? presence(`room:${room.id}`, { meta: { ...spawn } }) : null

  const { get: lines, unsubscribe } = useStore(messages.store)
  $.onDestroy(unsubscribe)
  if (room) {
    messages.load({ roomId: room.id }, { orderBy: '-createdAt', limit: 50 })
      .catch((e) => { note = e.message })
  }

  // A figure and a line carry a member id; the nick is read once per member.
  const asked = new Set()
  function askNicks(ids) {
    for (const id of ids) {
      if (asked.has(id)) continue
      asked.add(id)
      members.service.get(id)
        .then((row) => { nicks = { ...nicks, [id]: row.nick } })
        .catch(() => {})
    }
  }
  $: { if (here) askNicks(here.get().members.map((m) => m.userId)) }
  $: { if (pane) askNicks(lines().map((l) => l.memberId)) }

  const glyph  = (m, names) => (names[m.userId] ?? '?')[0].toUpperCase()
  const cell   = (m) => ({ x: m.meta?.x ?? spawn.x, y: m.meta?.y ?? spawn.y })
  const inView = (c, v) => c.x >= v.x && c.x < v.x + v.w && c.y >= v.y && c.y < v.y + v.h

  /** The other figures on screen, each at its cell of the view. */
  const figures = (h, v) => h.others.filter((m) => inView(cell(m), v)).map((m) => ({ m, x: cell(m).x - v.x, y: cell(m).y - v.y }))

  /**
   * The newest line of each member standing here, over where they stand, in
   * the view's cells. A speaker outside the view is their line pushed to the
   * edge they are past, marked with the way to them.
   */
  function bubbles(h, said, sx, sy, v) {
    const me = h.self?.userId
    const where = new Map(h.others.map((m) => [String(m.userId), cell(m)]))
    if (me != null) where.set(String(me), { x: sx, y: sy })
    const out = []
    const seen = new Set()
    for (const line of said ?? []) {
      const who = String(line.memberId)
      if (seen.has(who) || !where.has(who)) continue
      seen.add(who)
      const at = where.get(who)
      let text = `(${line.body})`
      if (!inView(at, v)) {
        if (at.x >= v.x + v.w) text = `${text}>`
        else if (at.x < v.x)   text = `<${text}`
        else if (at.y < v.y)   text = `^${text}`
        else                   text = `v${text}`
      }
      const bx = Math.max(0, Math.min(at.x - v.x, v.w - text.length))
      const by = Math.max(0, Math.min(at.y - v.y - 1, v.h - 1))
      out.push({ key: `${who}:${line.id}`, x: bx, y: by, text })
    }
    return out
  }

  /** The pane's rows: a window of ROWS lines ending `b` lines before the newest, oldest first. */
  function history(said, b, names) {
    const all = [...(said ?? [])].reverse()
    const end = Math.max(0, all.length - b)
    return all.slice(Math.max(0, end - ROWS), end).map((l) => ({
      key:  l.id,
      text: `${names[l.memberId] ?? '…'}: ${l.body}`.slice(0, PANE.w),
    }))
  }

  async function turn(older) {
    if (!older) {
      if (back === 0) pane = false
      else back = Math.max(0, back - ROWS)
      return
    }
    if (!pane) { pane = true; back = 0; return }
    const want = back + ROWS
    if (want + ROWS > lines().length && messages.hasMore()) await messages.more()
    back = Math.min(want, Math.max(0, lines().length - ROWS))
  }

  // The shell focuses a route's first control when it mounts it, and this
  // scene mounts later, once the room's row is read.
  const focus = (el) => el.focus()

  const keydown = (e) => {
    if (room && (e.key === 'PageUp' || e.key === 'PageDown')) {
      e.preventDefault()
      turn(e.key === 'PageUp')
      return
    }
    if (pane && e.key === 'Escape') {
      e.preventDefault()
      pane = false
      return
    }
    const step = STEP[e.key]
    if (!step || !room || draft) return
    e.preventDefault()
    const nx = x + step[0]
    const ny = y + step[1]
    const door = stage.doorAt(nx, ny)
    if (door) { goto(door.to); return }
    if (!stage.walkable(nx, ny)) return
    x = nx
    y = ny
    here.updateMeta({ x, y })
  }

  const COMMANDS = {
    ban:   { bannedAt: () => new Date().toISOString(), done: 'is banned',  refused: 'only a mod bans' },
    unban: { bannedAt: () => null,                     done: 'is back',    refused: 'only a mod lifts a ban' },
  }

  async function command(line) {
    const [word, nick] = line.slice(1).split(/\s+/)
    const cmd = COMMANDS[word]
    if (!cmd) return `no command /${word} — /ban <nick>, /unban <nick>`
    if (!nick) return `/${word} <nick>`
    const who = (await members.service.find({ nick: nick.toLowerCase() })).data?.[0]
    if (!who) return `nobody here is called ${nick}`
    const after = await members.service.patch(who.id, { bannedAt: cmd.bannedAt() })
    const set = (after?.bannedAt ?? null) !== null
    return set === (word === 'ban') ? `${who.nick} ${cmd.done}` : cmd.refused
  }

  async function say() {
    const body = draft.trim()
    if (!body) return
    draft = ''
    note  = ''
    try {
      if (body.startsWith('/')) note = await command(body)
      else await messages.save({ roomId: room.id, body })
    } catch (e) { note = e.message }
  }
</script>

<mesa:window on:keydown={keydown} />
<div {@attach paint(stage)}>
  <slot />
  {#if here}
    {#each figures(here.get(), view) as f (f.m.connectionId)}
      <p {@attach at(f.x, f.y)}>{glyph(f.m, nicks)}</p>
    {/each}
    <p {@attach at(x - view.x, y - view.y, 11)}>@</p>
    {#each bubbles(here.get(), lines(), x, y, view) as b (b.key)}
      <p class="surface" {@attach at(b.x, b.y, 12)}>{b.text}</p>
    {/each}
    {#if pane}
      <div class="surface pane" {@attach at(PANE.x, PANE.y, 13, [PANE.w, PANE.h])}>
        {#each history(lines(), back, nicks) as l (l.key)}
          <p>{l.text}</p>
        {/each}
        <p>— {room.name} · {back ? `${back} newer below` : 'the newest'} · PageUp older · PageDown newer · Esc closes —</p>
      </div>
    {/if}
  {/if}
</div>
{#if here}
  <p>{room.name} · {here.get().count} here{#each here.get().others as m (m.connectionId)} · {nicks[m.userId] ?? '…'}{/each}</p>
  {#if note}<p>{note}</p>{/if}
  <form on:submit|preventDefault={say}>
    <input {@attach focus} bind:value={draft} placeholder="arrows walk, type and Enter says, PageUp reads back" />
  </form>
{/if}

<style>
  /* A browser's paragraph carries a margin; a pane's row is one cell tall. */
  .pane p { margin: 0; line-height: inherit; white-space: pre; overflow: hidden }
</style>
