<script>
  // Crier.mesa — the crier's newest line (`api/src/crier.ts`, `IDEAS/haven.md`
  // 8.3) across the top of the view for `CRY_MS` after it was said. The crier
  // stands nowhere, so `Bubbles` has no figure to hang it over, and a line in
  // the history is not a cry: a newcomer's own welcome is said at the login,
  // before their socket joins the room, so it reaches them only through the
  // lines the scene loaded and is told apart from an old one by its age.
  //
  // Placed by the square's route, inside the scene's slot, since the crier
  // speaks in the square alone.
  import { members }  from '@/resources/Member.mesa'
  import { cells, clip } from '@/lib/scene/cells.js'
  import { at } from '#cell'
  import { CRIER, CRY_MS } from '#shared/crier.ts'

  const scene = $context.scene
  let view = scene.view
  $.onDestroy(scene.subscribe(() => { view = scene.view }))

  // The room's lines, which the scene holds; slot content gets no prop from it.
  var roomLines = $context.roomLines
  const lines = () => roomLines?.rows ?? []

  let names = {}
  const asked = new Set()
  function askNames(ids) {
    for (const id of ids) {
      if (asked.has(id)) continue
      asked.add(id)
      members.service.get(id).then((row) => { names = { ...names, [id]: row.nick } }).catch(() => {})
    }
  }

  // Bumped when the cry on screen runs out, so it is read again.
  let tick = 0

  /** The newest line the crier said within CRY_MS, newest first in the store. */
  function cryOf(said, who) {
    const now = Date.now()
    const fresh = (said ?? []).filter((l) => now - Date.parse(l.createdAt) < CRY_MS)
    askNames(fresh.map((l) => l.memberId))
    return fresh.find((l) => who[l.memberId] === CRIER) ?? null
  }

  $: cry = (tick, cryOf(lines(), names))
  $: deadline = cry ? Date.parse(cry.createdAt) + CRY_MS : Infinity
  // `tick` is in the key: a timer that fires a millisecond early leaves the
  // deadline unchanged, and keyed on it alone the cry would never be cleared.
  $.after(deadline - Date.now(), () => { tick++ }, { key: `${deadline}:${tick}`, when: deadline < Infinity })

  /** Row 1, inside the frame's top wall, centered in the view. */
  function shown(line, v) {
    if (!line) return []
    const text = clip(`${CRIER}: ${line.body}`, v.w - 2)
    return [{ key: line.id, text, x: Math.max(0, Math.floor((v.w - cells(text)) / 2)), y: 1 }]
  }
</script>

{#each shown(cry, view) as c (c.key)}
  <p class="surface" {@attach at(c.x, c.y, 12)}>{c.text}</p>
{/each}
