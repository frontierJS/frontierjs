<script>
  // Workshop.mesa — the workshop, through the house beside the tavern: a
  // bench for every package in the repo, one for `example/` and one for the
  // rest of the tree, `frontierjs`, and the door back out to the square in the
  // bottom wall. Each name is a lamp, so every bench is read from the door.
  // The Claude sessions editing on this machine stand at them
  // (`components/Workers.mesa`), placed by the route and never by this file;
  // so is the taskmaster, whose desk is the one piece here by the door on the
  // left (`components/Taskmaster.mesa`).
  // On each bench lie its package's open issues from ISSUES.md: a slip for
  // each, piled by severity, S1 to S4 left to right (`pieces/ledger.js`,
  // counts from `bun run ledger`). A package with none has no table of its
  // own: it is listed under `(no work)` along the bottom. Where every bench
  // stands comes from the counts (`pieces/workshop.js`), so the room is as
  // tall as the piles need and is a screen wide and several tall; the view
  // pans up it. The picture this draws is `workshop.frame.txt`, which
  // `scenes.test.js` pins, beside a test that every package has its bench.
  import Scene from '@/components/Scene.mesa'
  import { INDOORS } from '@/lib/scene/stage.js'
  import Piece from '@/components/Piece.mesa'
  import Door  from '@/components/Door.mesa'
  import { framed }          from '@/pieces/frame.js'
  import { layoutWorkshop }  from '@/pieces/workshop.js'
  import { LEDGER }          from '@/lib/hash/ledger.data.js'

  // The route hands a fresh count after `/ledger` and mounts the room again,
  // since where every bench stands follows the counts.
  export let ledger = LEDGER

  const shop = layoutWorkshop(ledger)

  // Wider and taller than a screen, so this scene's `frame` is its own, as the
  // square's is.
  const frame = framed(shop.width, shop.height)

  const PALETTE = {
    f: { fg: '#6b7280' },
    d: { fg: '#92400e' },
    w: { fg: '#a16207' },
    n: { fg: ['#fde68a', '#fcd34d', '#fde68a', '#fef3c7'], ms: 1400, wave: true, light: 1 },
    1: { fg: '#ef4444' },
    2: { fg: '#f97316' },
    3: { fg: '#eab308' },
    4: { fg: '#22d3ee' },
  }
</script>

<Scene slug="workshop" layers={INDOORS} palette={PALETTE} spawn={shop.spawn}>
  <Piece of={frame} />
  <Door  x={shop.door.x} y={shop.door.y} to="/" />
  {#each shop.benches as b (b.name)}
    <Piece of={b.bench}  x={b.x} y={b.y} />
    <Piece of={b.ledger} x={b.x} y={b.y - b.ledger.art.split('\n').length} />
  {/each}
  {#if shop.listing}
    <Piece of={shop.heading} x={shop.listing.x} y={shop.listing.y} />
  {/if}
  {#each shop.idle as b (b.name)}
    <Piece of={b.bench} x={b.x} y={b.y} />
  {/each}
  <Piece of={shop.desk.piece} x={shop.desk.x} y={shop.desk.y} />
  <Piece of={shop.legend.piece} x={shop.legend.x} y={shop.legend.y} />
  <slot />
</Scene>
