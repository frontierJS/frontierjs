<script>
  // Profile.mesa — the foot of the screen as this member's own card
  // (`IDEAS/haven.md` 9.9) as three boxes (`hud.js`): who they are and which
  // way they face, a hotbar of what they carry, and the room as a minimap.
  // It takes the rows a screen has left under the art, so a terminal exactly
  // as tall as the scene (`--frame`, a drive's pty) draws none, and `/inv`
  // says the same in the note for a screen too short for it. A browser has no
  // such rows (`FOOT` in `#paint`), so there it is `/inv` alone.
  //
  // What is carried is the server's (`members.inventory`) and refills on its
  // clock, which no event announces, so the card asks again every REFRESH_MS
  // and as soon as a bolt of this member's lands or a pickup of theirs is lifted. Drawn on this screen only.
  import { getClient } from '@frontierjs/sierra/resource'
  import { members }   from '@/resources/Member.mesa'
  import { ITEMS }     from '../../../api/src/inventory.ts'
  import { coarse, SCALE } from '@/lib/scene/map.js'
  import { hud, HEIGHT } from '@/lib/scene/hud.js'
  import { FOOT }      from '#paint'

  export let here
  export let nicks
  export let stage
  export let room
  export let facing
  export let glyph
  export let route
  export let x
  export let y

  const REFRESH_MS = 30_000
  const WAY = { n: 'north', e: 'east', s: 'south', w: 'west' }

  var verbs  = $context.commands
  var client = getClient()
  var timer  = null
  let held = {}

  async function load() {
    try { held = await members.service.invoke('inventory', null, {}) } catch { /* the card keeps its last count */ }
  }

  function onOwn(name, told) {
    if ((name === 'bolt' || name === 'pickup') && String(told?.by) === String(here.get().self?.userId)) load()
  }

  load()
  timer = setInterval(load, REFRESH_MS)
  client?.on('event', onOwn)
  $.onDestroy(() => { clearInterval(timer); client?.off('event', onOwn) })

  // The pieces have claimed their cells by the time the scene is mounted, as
  // `Scene.mesa` keeps the same snap then; drawing it again on every step
  // would be a `picture()` of the whole stage per key.
  let snap = { rows: [] }
  $.onMount(() => { snap = coarse(stage, route) })

  const ITEM_NAMES = Object.keys(ITEMS)
  const rows = (width, x, y) => hud({
    w: width, nick: nicks[here.get().self?.userId] ?? '…', glyph, room: room.name, way: WAY[facing] ?? '—',
    items: ITEM_NAMES.filter((i) => i in held), held, mini: snap.rows, at: { x: Math.floor(x / SCALE.x), y: Math.floor(y / SCALE.y) },
  })

  // The stage's size is set by `#paint` after this mounts, so it is read again
  // on every change of the stage, as `Scene.mesa` reads its view.
  let spare = stage.size.h - stage.view.h
  $.onDestroy(stage.subscribe(() => { spare = stage.size.h - stage.view.h }))

  async function list() {
    await load()
    const rows = Object.entries(held).filter(([, n]) => n > 0).map(([item, n]) => `${n} ${n === 1 ? item : ITEMS[item]?.many ?? item}`)
    return rows.length ? `you carry ${rows.join(', ')}` : 'you carry nothing'
  }

  $.onDestroy(verbs.add({ word: 'inv', aliases: ['inventory'], help: '/inv — what you carry', run: list }))
</script>

{#if FOOT && spare >= HEIGHT}
  {#each rows(stage.size.w, x, y) as row, i (i)}
    <pre>{row}</pre>
  {/each}
{/if}
