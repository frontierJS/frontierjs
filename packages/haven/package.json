{
  "name": "@frontierjs/haven",
  "version": "0.1.0",
  "private": true,
  "description": "Haven \u2014 a place in the terminal anyone with fli installed can walk into. An FJS application, not a library.",
  "type": "module",
  "imports": {
    "#paint": {
      "browser": "./web/src/paint.browser.js",
      "default": "./web/src/paint.js"
    },
    "#cell": {
      "browser": "./web/src/cell.browser.js",
      "default": "./web/src/cell.js"
    },
    "#sign-in": {
      "browser": "./web/src/sign-in.browser.js",
      "default": "./web/src/sign-in.js"
    },
    "#errand": {
      "browser": "./web/src/errand.browser.js",
      "default": "./web/src/errand.js"
    },
    "#workers": {
      "browser": "./web/src/workers.browser.js",
      "default": "./web/src/workers.js"
    },
    "#taskmaster": {
      "browser": "./web/src/taskmaster.browser.js",
      "default": "./web/src/taskmaster.js"
    },
    "#ledger": {
      "browser": "./web/src/ledger.browser.js",
      "default": "./web/src/ledger.js"
    },
    "#seen": {
      "browser": "./web/src/seen.browser.js",
      "default": "./web/src/seen.js"
    }
  },
  "license": "MIT",
  "author": "FrontierJS",
  "scripts": {
    "dev": "bun run api & bun run web & wait",
    "api": "HAVEN_SESSION_KEY=${HAVEN_SESSION_KEY:-haven-dev-only} HAVEN_WS_PER_IP=${HAVEN_WS_PER_IP:-16} bun --watch api/index.ts",
    "web": "cd web && vite -c config/vite.config.js",
    "scenes": "vite -c editor/vite.config.js",
    "start": "bun api/index.ts",
    "share": "bun scripts/share.mjs",
    "tui": "cd web && bun ../node_modules/@frontierjs/sierra/src/tools/tui.js",
    "test": "node ../../scripts/tmp-run.mjs 'bun test'",
    "frames": "bun web/test/frames.mjs",
    "ledger": "bun scripts/ledger.mjs",
    "townhall": "bun scripts/townhall.mjs",
    "agents": "bun agents/agents.js",
    "verify:explore": "bun web/test/verify-explore.mjs",
    "verify:browser": "bun web/test/verify-browser.mjs",
    "verify:scenes": "bun editor/test/verify-scenes.mjs",
    "verify:workshop": "bun web/test/verify-workshop.mjs",
    "verify:taskmaster": "bun web/test/verify-taskmaster.mjs",
    "verify:ledger": "bun web/test/verify-ledger.mjs",
    "verify:townhall": "bun web/test/verify-townhall.mjs",
    "verify:map": "bun web/test/verify-map.mjs",
    "verify:nameplate": "bun web/test/verify-nameplate.mjs",
    "verify:home-row": "bun web/test/verify-home-row.mjs",
    "verify:bolt": "bun web/test/verify-bolt.mjs",
    "verify:cellar": "bun web/test/verify-cellar.mjs",
    "verify:glade": "bun web/test/verify-glade.mjs",
    "verify:booth": "bun web/test/verify-booth.mjs",
    "verify:emoji": "bun web/test/verify-emoji.mjs",
    "verify:hearing": "bun web/test/verify-hearing.mjs",
    "verify:steps": "bun web/test/verify-steps.mjs",
    "verify:view": "bun web/test/verify-view.mjs",
    "verify:errand": "bun web/test/verify-errand.mjs",
    "verify:bar": "bun web/test/verify-bar.mjs",
    "verify:fresh": "bun tests/verify-fresh.mjs",
    "typecheck": "node ../../scripts/typecheck.mjs",
    "db:types": "bunx litestone types --schema db/schema.lite --audience=system --out db/schema.d.ts"
  },
  "dependencies": {
    "@frontierjs/junction": "workspace:*",
    "@frontierjs/litestone": "workspace:*",
    "@frontierjs/mesa": "workspace:*",
    "@frontierjs/sierra": "workspace:*",
    "@frontierjs/toolbelt": "workspace:*",
    "@opentui/core": "0.5.17"
  },
  "engines": {
    "bun": ">=1.4.0"
  },
  "devDependencies": {
    "@frontierjs/css": "workspace:*",
    "@frontierjs/testing": "workspace:*",
    "bun-types": "^1.3.14",
    "vite": "^8.3.2"
  }
}
