/// Haven — Litestone schema
///
/// THE SEED. Three models: a Member is somebody who walked in, a Room is a
/// scene they stand in, a Message is a line they said there. A MOVE is not
/// here — it is a raw channel frame and never a row (`IDEAS/haven.md`).
///
/// ACCESS — every model declares @@gate, read as R.C.U.D.
///
///   0 STRANGER   no principal: sees nothing of Haven
///   3 CREATOR    a signed-in Member. A member carries no `role`, so the stock
///                grader puts every one of them here (`FJS-D197`)
///   4 USER       a mod: a member whose `role` is `mod`. The ladder ranks a
///                role's presence and not its value, so what a mod may do is
///                said by predicate (`auth().role == 'mod'`), never by level
///   8 SYSTEM     asSystem(): the login that verified a signature, the seed
///                that lays out the rooms, retention, the session a login mints
///   9 LOCKED     nothing — a said line is never rewritten
///
/// A BAN IS A POLICY, not a level and not a hook (Invariant 6). `bannedAt` is a
/// claim off the `@@auth` model, so a banned member's reads filter to nothing —
/// an empty room — and everyone else stops seeing them and what they said. A
/// gate would have refused with a 403 instead, which tells a spammer exactly
/// when to make a new key. A mod sets it through an ordinary `members.patch`:
/// the row policy admits a mod to any member's row and the field policy admits
/// a mod to that column, so no service method and no hook holds the standing.
///
/// `auth().bannedAt == null` is the IS NULL form and answers a boolean, so an
/// absent claim admits. Spelled `auth().bannedAt != null` inside a `@@deny` it
/// would fire on UNKNOWN as well and lock out every principal that does not
/// carry the column.

import "@frontierjs/litestone/references/Grant.lite"

database main  { path env("DATABASE_URL", "./db/haven.db") }

database audit { path env("AUDIT_PATH", "./db/audit/") driver trail retention 90d }

model Member {
  id        Int       @id

  /// What the bubble is signed with. Lowercase so `Sam` and `sam` are one
  /// figure in the square rather than two.
  nick      String    @unique @trim @lower @length(2, 16) @regex("^[a-z0-9_-]+$", "letters, digits, - and _")

  /// The machine's key, written once at the first login. A member is the same
  /// person tomorrow because the key is, so it never moves.
  publicKey String    @unique @immutable

  /// The standing: `mod`, or none. Read off the row on every call and every
  /// socket frame (`api/src/principal.ts`), written by the login from
  /// `HAVEN_MODS` and by nothing below the system: the caller being graded
  /// must never write the column the grade is read from.
  role      String?   @guarded @regex("^mod$", "a role is mod")

  /// Set by a mod, cleared by a mod (`null` lifts the ban). Never by the member
  /// it names, since that would be a caller writing their own grade.
  bannedAt  DateTime? @allow('write', auth().role == 'mod')

  createdAt DateTime  @default(now())

  messages  Message[]
  sessions  Session[]

  @@auth

  /// Created by the login after the signature verifies; a member edits their
  /// own nick and nothing else. A mod reaches every row, the banned included —
  /// a ban is lifted by naming the member, who is otherwise nobody's row.
  @@gate("3.8.3.8")
  @@allow('read', auth().bannedAt == null && (bannedAt == null || auth().role == 'mod'))
  @@allow('update', id == auth().id || auth().role == 'mod')

  @@trail(audit)
}

model Room {
  id       Int       @id

  /// The scene's name in the client — `square`, `tavern`. The art is the
  /// client's; the row is what a channel and a history pane hang off.
  slug     String    @unique @lower @length(2, 24) @regex("^[a-z0-9-]+$")
  name     String    @length(1, 40)

  /// A booth is a room for two (`api/src/booth.ts`): the lower and the higher
  /// member id of the pair, set together by the system and by nothing else.
  /// Both null is a scene anybody may enter. A pair, not a list, because a
  /// booth has two seats; the ids are plain columns and not relations, since a
  /// second relation to Member would need a name on both sides for a fact
  /// only the read policy below uses.
  pairLoId Int?
  pairHiId Int?

  messages Message[]

  /// A room is a channel bound to this row (`api/src/rooms.ts`), so the read
  /// policy is the join: a banned member is refused the room and evicted from
  /// one they stand in on the next write. A booth is joined by its pair alone
  /// — to anyone else it is no row, and the socket joins it to nothing.
  @@gate("3.8")
  @@allow('read', auth().bannedAt == null && (pairLoId == null || pairLoId == auth().id || pairHiId == auth().id))
}

model Message {
  id        Int      @id
  roomId    Int
  room      Room     @relation(fields: [roomId], references: [id])

  /// A stamp rather than a default, so a payload naming somebody else's id is
  /// overwritten with the caller's own.
  memberId  Int      @createdBy
  member    Member   @relation(fields: [memberId], references: [id])

  body      String   @trim @length(1, 280)
  createdAt DateTime @default(now())

  /// A whisper's listener (`/w <nick> <line>`). Null is a line said aloud. A
  /// plain column and not a relation, as Room's pair is: only the read policy
  /// below uses it, and a second relation to Member would need a name on both
  /// sides. Whoever it names reads the line, and so does its speaker.
  toId      Int?

  /// The tavern's history pane and the newest-line-per-member bubble both read
  /// a room in time order.
  @@index([roomId, createdAt])

  /// Said by a member, rewritten by nothing, removed only by retention — a
  /// room's newest lines kept by count, `api/src/retention.ts`, and never a
  /// `retention` on `main`, which would sweep members and rooms with them.
  @@gate("3.3.9.8")
  ///
  /// A line in a booth is read and said by its pair alone: the room's own
  /// columns are the policy, so `messages.find` by a stranger who learned the
  /// room id answers empty and a `create` into it writes nothing. A whisper is
  /// read by its speaker and the member it names and by nobody else, a mod
  /// included -- distance is fan-out only (`FJS-D992`), so privacy is this.
  @@allow('read', auth().bannedAt == null && member.bannedAt == null && (room.pairLoId == null || room.pairLoId == auth().id || room.pairHiId == auth().id) && (toId == null || toId == auth().id || memberId == auth().id))
  @@allow('create', auth().bannedAt == null && (room.pairLoId == null || room.pairLoId == auth().id || room.pairHiId == auth().id))

  @@trail(audit)
}

/// What a login mints once the signature verifies (`api/src/login.ts`), and
/// what `verifySession` reads a token back to. A Grant: the token leaves in the
/// login's answer and only its digest is stored. Nothing below the system
/// reads or writes one — a member holds the token, never the row.
model Session {
  id        Int      @id
  memberId  Int
  member    Member   @relation(fields: [memberId], references: [id])
  createdAt DateTime @default(now())

  @@trait(Grant)

  /// Required where the trait leaves it open: the key re-mints one in a
  /// signature, so a session that never expires buys nothing and is a standing
  /// hole for a token that leaked.
  expiresAt DateTime

  @@gate("8")
}
