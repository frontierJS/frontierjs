{
  "name": "@frontierjs/junction",
  "version": "0.1.1",
  "description": "A pragmatic, batteries-included Bun framework",
  "type": "module",
  "main": "./index.ts",
  "exports": {
    ".": "./index.ts",
    "./transport": "./src/transport/http.ts",
    "./config": "./src/config/index.ts",
    "./errors": "./src/core/errors.ts",
    "./hooks": "./src/core/hooks.ts",
    "./service": "./src/core/service.ts",
    "./schema": "./src/core/schema.ts",
    "./env": "./src/core/env.ts",
    "./logger": "./src/core/logger.ts",
    "./litestone": "./src/core/litestone.ts",
    "./events": "./src/events/index.ts",
    "./cache": "./src/cache/index.ts",
    "./scheduler": "./src/scheduler/index.ts",
    "./workers": "./src/workers/index.ts",
    "./filestorage": "./src/storage/filestorage/index.ts",
    "./database": "./src/storage/database/index.ts",
    "./mail": "./src/mail/index.ts",
    "./ai": "./src/ai/index.ts",
    "./testing": "./src/testing/index.ts",
    "./openapi": "./src/plugins/openapi/index.ts",
    "./webhooks": "./src/plugins/webhooks/index.ts",
    "./manifest": "./src/plugins/manifest/index.ts",
    "./devtools": "./src/plugins/devtools/index.ts",
    "./client": "./src/client/index.ts",
    "./email": "./src/plugins/email/index.ts",
    "./channels": "./src/transport/channels.ts",
    "./middleware": "./src/transport/middleware.ts",
    "./health": "./src/transport/health.ts",
    "./auth": "./src/auth/types.ts"
  },
  "bin": {
    "junction": "./tools/cli.ts"
  },
  "files": [
    "index.ts",
    "src/",
    "tools/",
    "!tools/check-*.mjs",
    "README.md",
    "LICENSE"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/frontierJS/frontierjs.git",
    "directory": "packages/junction"
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "init": "bun run tools/init.ts",
    "dev": "bun run --watch example/app.ts",
    "start": "NODE_ENV=production bun run example/app.ts",
    "test": "bun test tests/",
    "typecheck": "node ../../scripts/typecheck.mjs",
    "test:example": "bun test example/test.ts",
    "test:all": "bun test tests/ example/test.ts",
    "repl": "bun run tools/repl.ts",
    "build:app": "bun run tools/build-app.ts",
    "setup": "bun run tools/setup.ts",
    "setup:audit": "bun run tools/setup.ts audit"
  },
  "peerDependencies": {
    "@frontierjs/litestone": "^1.1.0"
  },
  "peerDependenciesMeta": {
    "@frontierjs/litestone": {
      "optional": true
    }
  },
  "devDependencies": {
    "@frontierjs/litestone": "workspace:*"
  },
  "engines": {
    "bun": ">=1.0.0"
  },
  "keywords": [
    "junction",
    "framework",
    "bun",
    "typescript",
    "sqlite",
    "feathers"
  ],
  "license": "MIT",
  "_built": "2026-05-27"
}
