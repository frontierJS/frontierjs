{
  "name": "@frontierjs/junction",
  "version": "0.1.8",
  "description": "The API realm of FrontierJS — services, the hook pipeline and HTTP/WS transport over a Litestone schema, on Bun",
  "type": "module",
  "main": "./index.ts",
  "exports": {
    ".": "./index.ts",
    "./litestone": "./src/core/litestone.ts",
    "./cache": "./src/cache/index.ts",
    "./scheduler": "./src/scheduler/index.ts",
    "./mail": "./src/mail/index.ts",
    "./ai": "./src/ai/index.ts",
    "./testing": "./src/testing/index.ts",
    "./openapi": "./src/plugins/openapi/index.ts",
    "./otlp": "./src/plugins/otlp/index.ts",
    "./webhooks": "./src/plugins/webhooks/index.ts",
    "./public-url": "./src/core/public-url.ts",
    "./envelope": "./src/core/envelope.ts",
    "./manifest": "./src/plugins/manifest/index.ts",
    "./outbox": "./src/plugins/outbox/index.ts",
    "./backfill": "./src/plugins/backfill/index.ts",
    "./commitments": "./src/plugins/commitments/index.ts",
    "./devtools": "./src/plugins/devtools/index.ts",
    "./export": "./src/plugins/export/index.ts",
    "./search": "./src/plugins/search/index.ts",
    "./metrics": "./src/plugins/metrics/index.ts",
    "./client": "./src/client/index.ts",
    "./outbox.lite": "./db/outbox.lite",
    "./backfill.lite": "./db/backfill.lite",
    "./metrics.lite": "./db/metrics.lite"
  },
  "bin": {
    "junction": "./tools/cli.ts"
  },
  "files": [
    "AGENTS.md",
    "index.ts",
    "src/",
    "db",
    "tools/",
    "!tools/check-*.mjs",
    "README.md",
    "LICENSE"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/frontierJS/frontierjs.git",
    "directory": "packages/junction"
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "dev": "bun run --watch example/app.ts",
    "start": "NODE_ENV=production bun run example/app.ts",
    "test": "node ../../scripts/tmp-run.mjs 'bun test test/'",
    "typecheck": "node ../../scripts/typecheck.mjs",
    "test:example": "bun test ./example/test.ts",
    "test:all": "bun test test/ ./example/test.ts",
    "test:browser": "node test/browser/verify-devtools.mjs",
    "repl": "bun run tools/repl.ts",
    "verify:otlp": "bun test/verify-otlp.mjs"
  },
  "peerDependencies": {
    "@frontierjs/litestone": "^1.1.0"
  },
  "peerDependenciesMeta": {
    "@frontierjs/litestone": {
      "optional": true
    }
  },
  "devDependencies": {
    "@frontierjs/litestone": "workspace:*"
  },
  "engines": {
    "bun": ">=1.4.0"
  },
  "keywords": [
    "junction",
    "framework",
    "bun",
    "typescript",
    "sqlite",
    "feathers"
  ],
  "license": "MIT",
  "_built": "2026-05-27",
  "dependencies": {
    "@frontierjs/toolbelt": "workspace:*"
  }
}
