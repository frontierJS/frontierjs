{
  "name": "@frontierjs/email-kit",
  "version": "0.1.2",
  "type": "module",
  "description": "Mesa email component kit — table-based email components with CSS inlining for transactional email",
  "main": "./index.js",
  "exports": {
    ".": {
      "import": "./index.js"
    },
    "./render": {
      "import": "./render.js"
    },
    "./components/*.mesa": {
      "import": "./components/*.mesa"
    },
    "./components/*": {
      "import": "./components/*.mesa"
    }
  },
  "scripts": {
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "node ../../scripts/typecheck.mjs"
  },
  "peerDependencies": {
    "@frontierjs/mesa": "^0.1.0"
  },
  "devDependencies": {
    "happy-dom": "^20.11.6",
    "vitest": "^2.0.0"
  },
  "keywords": [
    "mesa",
    "email",
    "transactional",
    "mjml",
    "react-email"
  ],
  "license": "MIT",
  "_built": "2026-04-13",
  "files": [
    "index.js",
    "render.js",
    "components",
    "README.md",
    "LICENSE"
  ],
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/frontierJS/frontierjs.git",
    "directory": "packages/email-kit"
  }
}
