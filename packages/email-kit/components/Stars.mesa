<script>
  export let count  = 5     // number of filled stars (0–5)
  export let total  = 5     // total stars shown
  export let color  = '#f59e0b'
  export let empty  = '#dddddd'
  export let size   = 20
  export let align  = 'left'
  export let padding = '8px 16px'

  // Pre-compute the stars array so {#each} gets plain objects, not index signals.
  // This avoids the i() function call pattern that breaks in server render.
  const stars = Array.from({ length: total }, (_, i) => ({ filled: i < count }))
</script>

<!--
  Stars — inline SVG star rating. Email-safe (no external image dependency).

  <Stars count={5} />
  <Stars count={4} color="#ee380d" size={16} />
-->

<tr>
  <td align="{align}" style="padding:{padding};">
    <span style="display:inline-block;white-space:nowrap;line-height:1;">
      {#each stars as star}
        <svg
          xmlns="http://www.w3.org/2000/svg"
          width="{size}"
          height="{size}"
          viewBox="0 0 24 24"
          style="display:inline-block;vertical-align:middle;margin:0 1px;"
        >
          <path
            d="M12 2l3.09 6.26L22 9.27l-5 4.87 1.18 6.88L12 17.77l-6.18 3.25L7 14.14 2 9.27l6.91-1.01L12 2z"
            fill="{star.filled ? color : empty}"
            stroke="{star.filled ? color : empty}"
            stroke-width="1"
          />
        </svg>
      {/each}
    </span>
  </td>
</tr>
