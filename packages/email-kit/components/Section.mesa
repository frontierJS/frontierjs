<script>
  export let bgcolor  = undefined   // background color for the section
  // Spacer rows go INSIDE the section table. Emitted as siblings of it they
  // have no table ancestor, so every client discards them and the padding
  // silently does nothing — the rendered string keeps them, which is why it
  // held for so long. Inside, the section's own bgcolor runs through them too.
  export let padding  = undefined   // shorthand: adds spacer rows top and bottom
  export let align    = 'center'
</script>

<!--
  Section — full-width table that stacks vertically.
  Use inside <Email>. Contains Rows and Columns.

  <Section bgcolor="#f9f9f9">
    <Row> ... </Row>
  </Section>
-->

<table
  role="presentation"
  cellspacing="0"
  cellpadding="0"
  border="0"
  width="100%"
  align="{align}"
  style="border-collapse:collapse;{bgcolor ? `background-color:${bgcolor};` : ''}">
  <tbody>
    {#if padding}
    <tr><td style="font-size:0;line-height:0;height:{typeof padding === 'number' ? padding : 24}px;">&nbsp;</td></tr>
    {/if}
    <slot />
    {#if padding}
    <tr><td style="font-size:0;line-height:0;height:{typeof padding === 'number' ? padding : 24}px;">&nbsp;</td></tr>
    {/if}
  </tbody>
</table>
