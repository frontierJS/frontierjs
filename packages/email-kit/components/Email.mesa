<script module>
  // Named exports from <script module> are real ES module exports.
  // Consumers can set these via data props; renderComponent captures them.
  // Example: renderComponent(src, { data: { subject: 'Hello' } })
  // and the template uses: export const subject = data.subject ?? 'No subject'
</script>

<script>
  export let subject     = ''
  export let preview     = ''      // hidden preheader text (shows in inbox preview)
  export let bgcolor     = '#f4f4f4'
  export let width       = 600
  export let fontFamily  = 'Helvetica, Arial, sans-serif'
</script>

<!--
  Mesa Email component — full email document body content.
  renderComponent(source, { target: 'email' }) wraps this in <!DOCTYPE html><html>...
  and inlines all CSS for maximum email client compatibility.

  Usage:
    <Email subject="Welcome!" preview="Thanks for signing up.">
      <Section> ... </Section>
    </Email>
-->

<!-- Preheader: hidden text that shows as inbox preview snippet -->
{#if preview}
<div style="display:none;font-size:1px;line-height:1px;max-height:0;max-width:0;opacity:0;overflow:hidden;mso-hide:all;">
  {preview}&nbsp;&#847;&nbsp;&#847;&nbsp;&#847;&nbsp;&#847;&nbsp;&#847;
</div>
{/if}

<!-- Outer wrapper — full-width background -->
<table
  role="presentation"
  cellspacing="0"
  cellpadding="0"
  border="0"
  width="100%"
  style="margin:0;padding:0;background-color:{bgcolor};">
  <tbody>
    <tr>
      <td align="center" style="padding:24px 0;">
        <!-- 600px content container -->
        <table
          role="presentation"
          cellspacing="0"
          cellpadding="0"
          border="0"
          width="{width}"
          class="email-container"
          style="max-width:{width}px;background-color:#ffffff;border-radius:4px;overflow:hidden;">
          <tbody>
            <tr>
              <td style="font-family:{fontFamily};font-size:16px;color:#444444;">
                <slot />
              </td>
            </tr>
          </tbody>
        </table>
      </td>
    </tr>
  </tbody>
</table>

<style>
/*
 * Mesa Email Base Styles
 * Safe to embed in <head> — Outlook/MSO reads it, modern clients use it for @media.
 * All layout-critical styles are also inlined by renderComponent(target:'email').
 */

/* ── Reset ── */
body, table, td, a {
  -webkit-text-size-adjust: 100%;
  -ms-text-size-adjust: 100%;
}
table, td {
  mso-table-lspace: 0pt;
  mso-table-rspace: 0pt;
}
img {
  -ms-interpolation-mode: bicubic;
  border: 0;
  outline: none;
  text-decoration: none;
}
body {
  margin: 0;
  padding: 0;
  width: 100% !important;
}

/* ── Container ── */
.email-container {
  max-width: 600px;
  margin: 0 auto;
}

/* ── Typography ── */
h1, h2, h3, h4, h5, h6 {
  font-family: Helvetica, Arial, sans-serif;
  font-weight: 700;
  margin: 0;
  padding: 0;
  color: #222222;
}
h1 { font-size: 30px; line-height: 1.15; padding: 24px 16px; text-align: center; letter-spacing: 0.5px; }
h2 { font-size: 24px; line-height: 1.2;  padding: 20px 16px; text-align: center; }
h3 { font-size: 20px; line-height: 1.25; padding: 16px 16px; }
h4 { font-size: 18px; line-height: 1.3;  padding: 12px 16px; }
h5 { font-size: 16px; line-height: 1.4;  padding: 10px 16px; }
h6 { font-size: 14px; line-height: 1.4;  padding: 8px 16px; color: #888888; }

p {
  font-family: Helvetica, Arial, sans-serif;
  font-size: 16px;
  line-height: 1.6;
  color: #444444;
  margin: 0;
  padding: 8px 16px;
}
ul, ol {
  font-family: Helvetica, Arial, sans-serif;
  font-size: 16px;
  line-height: 1.6;
  color: #444444;
  margin: 0;
  padding: 8px 24px;
}
li { padding: 4px 0; }

a {
  color: #9fc612;
  text-decoration: none;
}

/* ── Button ── */
.email-btn {
  display: inline-block;
  font-family: Helvetica, Arial, sans-serif;
  font-size: 14px;
  font-weight: 700;
  letter-spacing: 1.5px;
  line-height: 1;
  text-decoration: none;
  border-radius: 4px;
  padding: 12px 24px;
  mso-padding-alt: 0;
}

/* ── Two-column layout ── */
.two-col td { width: 50%; vertical-align: top; }

/* ── Responsive visibility ── */
.mobile-only { display: none !important; max-height: 0; overflow: hidden; mso-hide: all; }
.desktop-only { display: block; }

/* ── Mobile breakpoints ── */
@media only screen and (max-width: 600px) {
  .email-container { width: 100% !important; }

  .two-col td {
    width: 100% !important;
    display: block !important;
  }

  .desktop-only {
    display: none !important;
    max-height: 0 !important;
    overflow: hidden !important;
    mso-hide: all !important;
  }
  .mobile-only {
    display: block !important;
    max-height: none !important;
    overflow: visible !important;
  }

  img.fluid {
    width: 100% !important;
    height: auto !important;
    max-width: 100% !important;
  }

  h1 { font-size: 28px !important; }
  h2 { font-size: 24px !important; }
  h3 { font-size: 20px !important; }
  p, li, ul, ol { font-size: 16px !important; }
  .email-btn { font-size: 16px !important; padding: 14px 28px !important; }
}

</style>
