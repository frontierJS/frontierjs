<script>
  export let bgcolor  = undefined
  export let align    = undefined
  export let valign   = 'top'
</script>

<!--
  Row — a single <tr> inside a Section.
  Put one or more Columns inside.

  <Row>
    <Column>content</Column>
  </Row>
-->

<tr
  valign="{valign}"
  style="{bgcolor ? `background-color:${bgcolor};` : ''}{align ? `text-align:${align};` : ''}">
  <slot />
</tr>
