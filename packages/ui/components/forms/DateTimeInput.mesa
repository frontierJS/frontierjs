<script module>
  // ── ISO-8601 ⇄ the control's local wall clock ────────────────────────────
  //
  // `<input type="datetime-local">` has no zone: it reads and writes a wall
  // clock and nothing else. Litestone stores an INSTANT — ISO-8601 with an
  // offset — so handing one straight to the element truncates the offset and
  // reading `el.value` back hands the server a wall clock it will parse as
  // UTC. Both halves shift the value, in opposite directions and by different
  // amounts, which is why `Input` refuses to map the format at all.
  //
  // The conversion is exact in both directions in ONE zone: the reader's own
  // by default, or the IANA zone the caller names with `timeZone`. An instant
  // does not carry the zone it was authored in, so the app that works in its
  // account's zone says so; without it, the control and the app's own labels
  // show different hours for the same instant. The addon names the zone being
  // shown, because "14:30" without one is the ambiguity this whole file exists
  // to close.

  const _p = (n) => String(n).padStart(2, '0')

  // The wall clock `d` reads in `timeZone`; undefined is the browser's own.
  function _wall(d, timeZone) {
    if (!timeZone) {
      return { y: d.getFullYear(), mo: d.getMonth() + 1, d: d.getDate(),
               h: d.getHours(), mi: d.getMinutes(), s: d.getSeconds() }
    }
    const got = {}
    const parts = new Intl.DateTimeFormat('en-US', {
      timeZone, hourCycle: 'h23', year: 'numeric', month: '2-digit', day: '2-digit',
      hour: '2-digit', minute: '2-digit', second: '2-digit',
    }).formatToParts(d)
    for (const part of parts) got[part.type] = Number(part.value)
    return { y: got.year, mo: got.month, d: got.day, h: got.hour, mi: got.minute, s: got.second }
  }

  /**
   * An instant → the string the element takes. `''` for an absent or
   * unparseable value, which is what the element shows for "nothing".
   *
   * @param {string|Date|null|undefined} value
   * @param {{seconds?: boolean, timeZone?: string}} [opts]  `seconds` includes `:ss`, for a stored value that has them; `timeZone` is an IANA zone, the browser's own when absent
   */
  export function toLocalInput(value, { seconds = false, timeZone = undefined } = {}) {
    const d = _asDate(value)
    if (!d) return ''
    const w   = _wall(d, timeZone)
    const ymd = `${String(w.y).padStart(4, '0')}-${_p(w.mo)}-${_p(w.d)}`
    const hm  = `${_p(w.h)}:${_p(w.mi)}`
    return seconds ? `${ymd}T${hm}:${_p(w.s)}` : `${ymd}T${hm}`
  }

  /**
   * The element's string → an instant, as ISO-8601 with an offset.
   *
   * `new Date('2026-08-16T14:30')` is parsed as LOCAL — a date-time with no
   * offset is local by the language spec, where a date ALONE ('2026-08-16') is
   * UTC. That asymmetry is the whole reason this is a named function with a
   * test on it rather than an inline `new Date()`.
   *
   * An incomplete entry answers `''`: `datetime-local` reports an empty value
   * for every state short of a whole date and time. The component tells a
   * partial from a cleared box by `validity.badInput`, which this string
   * cannot carry.
   *
   * With a `timeZone` the wall clock is read in THAT zone. The offset of a zone
   * depends on the instant, which is the thing being solved for, so it is
   * estimated at the wall clock read as UTC and re-estimated at the first
   * answer; a time that falls in a DST gap or fold lands on one of its two
   * neighbors rather than failing.
   */
  export function fromLocalInput(local, { timeZone = undefined } = {}) {
    if (!local) return ''
    if (!timeZone) {
      const d = new Date(local)
      return Number.isNaN(d.getTime()) ? '' : d.toISOString()
    }
    const m = /^(\d{4})-(\d\d)-(\d\d)T(\d\d):(\d\d)(?::(\d\d)(?:\.(\d{1,3}))?)?$/.exec(local)
    if (!m) return ''
    const [y, mo, day, h, mi, s, ms] = m.slice(1).map((n) => Number(n ?? 0))
    const asUtc = Date.UTC(y, mo - 1, day, h, mi, s, ms)
    if (Number.isNaN(asUtc)) return ''
    const offsetAt = (t) => {
      const w = _wall(new Date(t), timeZone)
      return Date.UTC(w.y, w.mo - 1, w.d, w.h, w.mi, w.s) - Math.floor(t / 1000) * 1000
    }
    const first = asUtc - offsetAt(asUtc)
    return new Date(asUtc - offsetAt(first)).toISOString()
  }

  /**
   * Is this wall clock one the zone skipped? 02:30 on the night clocks spring
   * forward never happens, and `fromLocalInput` answers the instant beside it,
   * so the box would say 02:30 and the record hold 03:30. A time that does not
   * survive the round trip is in the gap. A fold (two instants for one wall
   * clock) survives it and is not reported here.
   */
  export function inDstGap(local, { timeZone = undefined } = {}) {
    if (!local) return false
    const iso = fromLocalInput(local, { timeZone })
    if (!iso) return false
    const asked = local.slice(0, 19)
    return toLocalInput(iso, { seconds: true, timeZone }) !== (asked.length === 16 ? `${asked}:00` : asked)
  }

  /**
   * Does this value carry seconds worth showing?
   *
   * The element hides its seconds segment unless `step` says otherwise, so a
   * stored `09:30:45` would be edited down to `09:30:00` by someone who only
   * came to change the day. Asked of the VALUE rather than declared, because
   * the schema says `DateTime` and not how precise this column's rows are.
   */
  export function hasSeconds(value) {
    const d = _asDate(value)
    return !!d && (d.getSeconds() !== 0 || d.getMilliseconds() !== 0)
  }

  /**
   * The short name of the zone being shown — the browser's own, or `timeZone`
   * — `GMT+1`, `MST`, `AEST`. Falls back to the offset where `Intl` cannot
   * name it, or to the zone's own name when one was stated.
   *
   * Named AT `value`: the same zone is CST in January and CDT in July, so a
   * stored summer instant labeled from today reads the wrong abbreviation for
   * half the year. No value, or one that does not parse, is now.
   */
  export function localZoneLabel(value = undefined, timeZone = undefined) {
    const date = _asDate(value) ?? new Date()
    try {
      const parts = new Intl.DateTimeFormat(undefined, { timeZoneName: 'short', timeZone }).formatToParts(date)
      const named = parts.find(p => p.type === 'timeZoneName')?.value
      if (named) return named
    } catch {
      // Intl is present everywhere this runs; the guard is for a locale with
      // no short name, where formatToParts throws rather than omitting it.
    }
    if (timeZone) return timeZone
    const offset = -date.getTimezoneOffset()
    const sign   = offset < 0 ? '-' : '+'
    const abs    = Math.abs(offset)
    return `UTC${sign}${String(Math.floor(abs / 60)).padStart(2, '0')}:${String(abs % 60).padStart(2, '0')}`
  }

  function _asDate(value) {
    if (value === '' || value === null || value === undefined) return null
    const d = value instanceof Date ? value : new Date(value)
    return Number.isNaN(d.getTime()) ? null : d
  }
</script>

<script>
  // DateTimeInput.mesa
  // The control a `DateTime` column gets.
  //
  // Same shape as Input — naked inside an explicit Field, or self-wrapping when
  // a `label` or a `name` is given — and the same resolutions off `$context.form`.
  // What it adds is the zone: the value travels as an instant and the element
  // shows a wall clock, so the two conversions above happen at each edge and
  // the reader is told which zone they are looking at.
  //
  //   <Form {resource}>
  //     <DateTimeInput
  //       name="scheduledFor"
  //       value={record.scheduledFor}
  //       onvalue={(iso) => record.scheduledFor = iso}
  //     />
  //   </Form>
  //
  // `bind:` takes a writable top-level `let` in the CALLER, so a field of a
  // record is written back through `onvalue` rather than bound — which is also
  // the shape that makes the conversion visible at the call site.
  //
  // Inside a generated form nothing is written at all: Sierra's control table
  // answers `datetime` for `format: date-time` and the kit binds it here.
  //
  // ── Why there is no `oninput` ────────────────────────────────────────────
  //
  // A handler taking the native event would read `e.target.value` and get the
  // wall clock — the exact value this component exists to stop anyone sending.
  // `onvalue(iso)` is the one that carries the value. `onblur`/`onfocus` are
  // forwarded because they carry none.
  //
  // bind:this exposes: focus()

  import Field from './Field.mesa'
  import { uid, resolveError, resolveRule, stated, nativeValidationGuard, lockedBy } from '../../utils.js'

  export let value    = ''            // ISO-8601 with an offset, or a Date, or ''
  export let disabled = undefined  // undefined = ask the form; false overrides it
  export let required = undefined
  export let readonly = false
  export let min      = undefined     // an instant, same as `value`
  export let max      = undefined
  export let step     = undefined     // seconds; derived from the value when unstated
  export let showZone = true
  // An IANA zone ('America/Chicago') the wall clock is read and written in.
  // Absent is the browser's own; an app that works in its account's zone
  // states it, or the control shows a different hour than its own labels.
  export let timeZone = undefined

  // Field integration
  export let name        = ''
  // `undefined` is "not stated" and `''` is "no label, deliberately". They have
  // to be different values: a default of '' makes the two indistinguishable, so
  // the documented suppression below cannot be expressed at all.
  export let label       = undefined
  export let hint        = ''
  export let error       = ''
  export let errors      = undefined
  export let badge       = undefined
  export let help        = undefined
  export let removable   = false
  export let onremovekey = undefined

  export let onvalue = undefined      // (iso: string) => void — '' when cleared, not called while partial
  export let onblur  = undefined
  export let onfocus = undefined

  export var id = ''
  const inputId = id || uid('datetime')

  const form = $context.form

  // A <Form> above this control locks it two ways — the caller disabled the
  // form, or a save is in flight — and both mean the same thing to a field.
  // A stated prop still wins, including `disabled={false}` on a saving form.
  const resolvedDisabled = stated(disabled, lockedBy(form, name)) ?? false
  const rule = resolveRule(form, name)

  // What the control itself refuses, as opposed to what the server said.
  let localError = ''

  const displayError = resolveError(form, name, error, errors) || localError
  const resolvedRequired = stated(required, rule?.required)

  // A column whose rows carry seconds gets a seconds segment; one that does not
  // keeps the shorter control. `step` stated by the caller wins either way.
  const seconds       = hasSeconds(value)
  const resolvedStep  = stated(step, seconds ? 1 : undefined)
  const localValue    = toLocalInput(value, { seconds, timeZone })
  const zone          = localZoneLabel(value, timeZone)

  // A bound converts the same way the value does, and an ABSENT one has to
  // stay absent: `toLocalInput(undefined)` is `''`, and `min=""` is an
  // attribute the element then carries with no constraint in it.
  const localMin = min === undefined ? undefined : toLocalInput(min, { seconds, timeZone })
  const localMax = max === undefined ? undefined : toLocalInput(max, { seconds, timeZone })

  let inputEl
  export function focus() { inputEl?.focus() }

  // A segment backspaced reports '' with `badInput` set, the same '' a cleared
  // box reports. Written through, it clears the record, and the re-render
  // writes '' to the element and wipes every segment the person did not touch.
  function handleInput(e) {
    if (e.target.validity?.badInput) {
      setLocalError('Enter a whole date and time')
      return
    }
    if (inDstGap(e.target.value, { timeZone })) {
      setLocalError(`${e.target.value.slice(11, 16)} does not exist on that date in ${localZoneLabel(fromLocalInput(e.target.value, { timeZone }), timeZone)}`)
      return
    }
    setLocalError('')
    value = fromLocalInput(e.target.value, { timeZone })
    onvalue?.(value)
  }

  // A refusal never retracted is a form that can never be submitted again.
  function setLocalError(message) {
    localError = message
    form?.reportInvalid?.(name, message)
  }
  $.onDestroy(() => { if (localError) form?.reportInvalid?.(name, null) })
</script>

{#snippet control()}
  <!-- .field-row joins the control to its addon; the zone is part of reading the value. -->
  <div class="field-row">
    <input
      bind:this={inputEl}
      class="field"
      id={inputId}
      name={name || undefined}
      type="datetime-local"
      value={localValue}
      disabled={resolvedDisabled}
      required={resolvedRequired}
      {@attach nativeValidationGuard}
      readonly={readonly}
      step={resolvedStep}
      min={localMin}
      max={localMax}
      aria-invalid={!!displayError || null}
      on:input={handleInput}
      on:blur={onblur}
      on:focus={onfocus}
      {...$attributes}
    />

    {#if showZone}
      <!--
        `.field-addon` already sizes and tones itself, so there is no local rule
        here — the package owns what an addon looks like. `fjs-dt-zone` is a
        selector hook and nothing else.

        Not aria-hidden: the zone is part of what the value MEANS, and a reader
        who cannot see the addon is the one who most needs telling.
      -->
      <span class="field-addon fjs-dt-zone">{zone}</span>
    {/if}
  </div>
{/snippet}

{#if label || name}
  <!--
    label and required go through unresolved where the caller stated nothing —
    Field reads the same rule off the same form. `|| undefined` because '' is a
    real answer that suppresses the label.
  -->
  <Field
    id={inputId}
    name={name}
    label={label}
    required={resolvedRequired}
    badge={badge}
    help={help}
    hint={hint}
    error={error || localError}
    errors={errors}
    removable={removable}
    onremovekey={onremovekey}
    {class}
  >
    {@render control()}
  </Field>
{:else}
  {@render control()}
{/if}
