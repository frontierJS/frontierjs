<script>
  // Select.mesa
  // Native <select> with option normalization and Field composition.
  //
  // `.field` styles a <select> directly, so the chevron is the UA's — the
  // appearance:none reset and the hand-drawn arrow are gone. That also means
  // the picker renders natively on mobile rather than as a styled box with
  // the platform's own list on top of it.
  //
  // Options accept either:
  //   string[]                       → { value: s, label: s }
  //   { value, label, disabled? }[]  → used as-is
  //
  // Groups:
  //   { group: string, options: [...] }[]  → rendered as <optgroup>
  //
  // bind:this exposes: focus()

  import Field from './Field.mesa'
  import { nameToLabel, uid, resolveError, resolveRule, stated, nativeValidationGuard, truncationNote, withNote, optionsNote, lockedBy } from '../../utils.js'

  export let value       = null
  export let options     = []          // flat or grouped (see above)
  export let placeholder = 'Select…'   // set to '' to suppress
  export let disabled    = undefined  // undefined = ask the form; false overrides it
  export let required    = undefined
  export let multiple    = false

  // Field integration
  export let name     = ''
  // `undefined` is "not stated" and `''` is "no label, deliberately". They have
  // to be different values: a default of '' makes the two indistinguishable, so
  // the documented suppression below cannot be expressed at all.
  export let label    = undefined
  export let hint     = ''
  export let error    = ''
  export let errors   = undefined
  export let badge    = undefined
  export let help     = undefined

  export var id = ''
  const selectId  = id || uid('select')
  const autoLabel = nameToLabel(name)

  const form = $context.form

  // A <Form> above this control locks it two ways — the caller disabled the
  // form, or a save is in flight — and both mean the same thing to a field.
  // A stated prop still wins, including `disabled={false}` on a saving form.
  const resolvedDisabled = stated(disabled, lockedBy(form, name)) ?? false
  const rule = resolveRule(form, name)

  // Inside a <Form> the option list is a schema fact, like the label and the
  // `required` beside it. Stated options always win; this is the fallback,
  // not an override.
  //
  // Two sources, and the order matters. An enum column carries its members on
  // the rule — `fields.status.enum` exists because `{"$ref":"#/$defs/…"}` was
  // resolved against the registry — so it answers synchronously and paints
  // with no flash of empty. A foreign key's options are ROWS, which only the
  // form can fetch, so they arrive later and only when the caller stated none
  // and the rule could not answer.
  const _sync = rule?.options ?? rule?.enum ?? null

  let _fetched = []
  let _total   = null
  let _error   = null
  if (!options?.length && !_sync && name && form?.optionsFor)
    form.optionsFor(name).then(r => {
      _fetched = r?.options ?? []
      _total   = r?.total ?? null
      _error   = r?.error ?? null
    })

  const resolved = options?.length ? options : (_sync ?? _fetched)

  // How many rows the server HAS. A `<select>` shows a page of a big relation
  // and reads identically to one showing all of it, so the row somebody is
  // looking for is missing with nothing saying why (`FJS-391`). Stated by the
  // form, which already holds the count from its own prefetch; read off this
  // control's own fetch otherwise. Nothing offers to search, because a native
  // select cannot — that is what `combobox` is for.
  export let total = undefined
  const resolvedTotal = stated(total, _total)

  // Why the rows are not there. Stated by the form, which fetched them; read
  // off this control's own fetch otherwise. An empty list and a list nobody
  // could fetch look identical, and a person reads both as *there are none*
  // (`FJS-587`).
  export let optionsError = undefined
  const resolvedHint  = withNote(withNote(hint, optionsNote(stated(optionsError, _error))),
                                 truncationNote(resolved.length, resolvedTotal))

  // …and the `required` that comment names. It was read off the rule for the
  // option list alone, so a select stated no constraint the model insisted on.
  const resolvedRequired = stated(required, rule?.required)

  const isGrouped = resolved.length > 0 && typeof resolved[0] === 'object' && 'group' in resolved[0]

  function normalize(opts) {
    return opts.map(o => typeof o === 'string' ? { value: o, label: o, disabled: false } : o)
  }

  const flatOptions    = isGrouped ? [] : normalize(resolved)
  const groupedOptions = isGrouped ? resolved.map(g => ({ ...g, options: normalize(g.options) })) : []

  const hasError = !!resolveError(form, name, error, errors)

  let el
  export function focus() { el?.focus() }
  // Native event callbacks. A <select> fires `input` as well as `change`, and
  // a caller validating as the user picks wants the same hook it uses on an
  // <Input> — see Input.mesa.
  export let oninput  = undefined
  export let onchange = undefined
  export let onblur   = undefined
  export let onfocus  = undefined
</script>

{#snippet control()}
  <select
    bind:this={el}
    bind:value={value}
    class="field"
    id={selectId}
    name={name || undefined}
    disabled={resolvedDisabled}
    required={resolvedRequired}
    {@attach nativeValidationGuard}
    multiple={multiple}
    aria-invalid={hasError || null}
    on:input={oninput}
    on:change={onchange}
    on:blur={onblur}
    on:focus={onfocus}
    {...$attributes}
  >
    {#if placeholder && !multiple}
      <!--
        `value=""`, not `value={null}`. Mesa drops an attribute whose value is
        null, and an <option> with no value attribute reports its own TEXT as
        its value — so the placeholder submitted the string "Select…" and a
        "nothing picked yet" check against '' never matched.

        NOT `disabled`, though it reads like it should be. A disabled option
        cannot hold the selection, so a select whose options arrive late — a
        relation picker, which is every one of them — lost the placeholder the
        moment the list repopulated and silently landed on the first real row.
        An unpicked "customer" became customer #1, and the form then filed the
        order against them with nothing on screen having said so. That is worse
        than letting someone choose the blank back, which `required` and the
        schema check both catch anyway.
      -->
      <option value="" selected={value === null || value === '' || value === undefined}>{placeholder}</option>
    {/if}

    {#if isGrouped}
      {#each groupedOptions as grp (grp.group)}
        <optgroup label={grp.group}>
          {#each grp.options as opt (opt.value)}
            <option value={opt.value} disabled={opt.disabled}>{opt.label}</option>
          {/each}
        </optgroup>
      {/each}
    {:else}
      {#each flatOptions as opt (opt.value)}
        <option value={opt.value} disabled={opt.disabled}>{opt.label}</option>
      {/each}
    {/if}
  </select>
{/snippet}

{#if label || (name && autoLabel)}
  <!--
    label and required go down UNRESOLVED where the caller stated nothing:
    Field reads the same rule off the same <Form> and resolves them once. This
    used to pass `label || autoLabel`, which meant the title-cased column name
    always arrived as an explicit label and a schema `@label("Customer")` could
    never be seen — the control shadowed the very thing it was meant to show.
    `|| undefined` because '' is a real answer here: it suppresses the label.
  -->
  <Field
    id={selectId}
    name={name}
    label={label}
    required={resolvedRequired}
    badge={badge}
    help={help}
    hint={resolvedHint}
    error={error}
    errors={errors}
    {class}
  >
    {@render control()}
  </Field>
{:else}
  {@render control()}
{/if}
