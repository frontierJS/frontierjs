<script>
  // Select.mesa
  // Native <select> with option normalisation and Field composition.
  //
  // `.field` styles a <select> directly, so the chevron is the UA's — the
  // appearance:none reset and the hand-drawn arrow are gone. That also means
  // the picker renders natively on mobile rather than as a styled box with
  // the platform's own list on top of it.
  //
  // Options accept either:
  //   string[]                       → { value: s, label: s }
  //   { value, label, disabled? }[]  → used as-is
  //
  // Groups:
  //   { group: string, options: [...] }[]  → rendered as <optgroup>
  //
  // bind:this exposes: focus()

  import Field from './Field.mesa'
  import { nameToLabel, uid, resolveError, resolveRule, stated } from '../../utils.js'

  export let value       = null
  export let options     = []          // flat or grouped (see above)
  export let placeholder = 'Select…'   // set to '' to suppress
  export let disabled    = false
  export let required    = undefined
  export let multiple    = false

  // Field integration
  export let name     = ''
  export let label    = ''
  export let hint     = ''
  export let error    = ''
  export let errors   = undefined
  export let badge    = undefined
  export let help     = undefined

  export var id = ''
  const selectId  = id || uid('select')
  const autoLabel = nameToLabel(name)

  const form = $context.form
  const rule = resolveRule(form, name)

  // An enum column already carries its members — `fields.status.enum` exists
  // because `{"$ref":"#/$defs/OrderStatus"}` was resolved against the registry
  // — so inside a <Form> the option list is a schema fact like the label and
  // the `required` beside it. Stated options always win; this is the fallback,
  // not an override, and a select over anything that is not an enum is
  // unaffected.
  const resolved = options?.length ? options : (rule?.enum ?? [])

  // …and the `required` that comment names. It was read off the rule for the
  // option list alone, so a select stated no constraint the model insisted on.
  const resolvedRequired = stated(required, rule?.required)

  const isGrouped = resolved.length > 0 && typeof resolved[0] === 'object' && 'group' in resolved[0]

  function normalise(opts) {
    return opts.map(o => typeof o === 'string' ? { value: o, label: o, disabled: false } : o)
  }

  const flatOptions    = isGrouped ? [] : normalise(resolved)
  const groupedOptions = isGrouped ? resolved.map(g => ({ ...g, options: normalise(g.options) })) : []

  const hasError = !!resolveError(form, name, error, errors)

  let el
  export function focus() { el?.focus() }
  // Native event callbacks. A <select> fires `input` as well as `change`, and
  // a caller validating as the user picks wants the same hook it uses on an
  // <Input> — see Input.mesa.
  export let oninput  = undefined
  export let onchange = undefined
  export let onblur   = undefined
  export let onfocus  = undefined
</script>

{#snippet control()}
  <select
    bind:this={el}
    bind:value={value}
    class="field"
    id={selectId}
    name={name || undefined}
    disabled={disabled}
    required={resolvedRequired}
    multiple={multiple}
    aria-invalid={hasError || null}
    on:input={oninput}
    on:change={onchange}
    on:blur={onblur}
    on:focus={onfocus}
    {...$attributes}
  >
    {#if placeholder && !multiple}
      <!--
        `value=""`, not `value={null}`. Mesa drops an attribute whose value is
        null, and an <option> with no value attribute reports its own TEXT as
        its value — so the placeholder submitted the string "Select…" and a
        "nothing picked yet" check against '' never matched.

        NOT `disabled`, though it reads like it should be. A disabled option
        cannot hold the selection, so a select whose options arrive late — a
        relation picker, which is every one of them — lost the placeholder the
        moment the list repopulated and silently landed on the first real row.
        An unpicked "customer" became customer #1, and the form then filed the
        order against them with nothing on screen having said so. That is worse
        than letting someone choose the blank back, which `required` and the
        schema check both catch anyway.
      -->
      <option value="" selected={value === null || value === '' || value === undefined}>{placeholder}</option>
    {/if}

    {#if isGrouped}
      {#each groupedOptions as grp (grp.group)}
        <optgroup label={grp.group}>
          {#each grp.options as opt (opt.value)}
            <option value={opt.value} disabled={opt.disabled}>{opt.label}</option>
          {/each}
        </optgroup>
      {/each}
    {:else}
      {#each flatOptions as opt (opt.value)}
        <option value={opt.value} disabled={opt.disabled}>{opt.label}</option>
      {/each}
    {/if}
  </select>
{/snippet}

{#if label || (name && autoLabel)}
  <!--
    label and required go down UNRESOLVED where the caller stated nothing:
    Field reads the same rule off the same <Form> and resolves them once. This
    used to pass `label || autoLabel`, which meant the title-cased column name
    always arrived as an explicit label and a schema `@label("Customer")` could
    never be seen — the control shadowed the very thing it was meant to show.
    `|| undefined` because '' is a real answer here: it suppresses the label.
  -->
  <Field
    id={selectId}
    name={name}
    label={label || undefined}
    required={resolvedRequired}
    badge={badge}
    help={help}
    hint={hint}
    error={error}
    errors={errors}
    {class}
  >
    {@render control()}
  </Field>
{:else}
  {@render control()}
{/if}
