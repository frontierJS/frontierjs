<script>
  // MultiSelect.mesa
  // Token input with dropdown. Supports single/multiple selection, async search,
  // keyboard navigation, min/max constraints, and new-value creation.
  //
  // OPTIONS shape:
  //   string | number | { value, label, disabled? }
  //
  // USAGE — basic multiple:
  //   <MultiSelect bind:value={tags} options={['React', 'Vue', 'Svelte']} multiple />
  //
  // USAGE — with Field wrapper:
  //   <MultiSelect label="Skills" name="skills" bind:value {options} multiple {errors} />
  //
  // USAGE — async search:
  //   <MultiSelect bind:value asyncOptions={{ trigger: searchFn, delay: 200, min: 1 }} />

  import Field from '../forms/Field.mesa'
  import { uid, resolveError, resolveRule, stated, truncationNote, withNote, optionsNote, lockedBy } from '../../utils.js'
  import { rank, segments } from '@frontierjs/toolbelt/search'

  // ── Props ───────────────────────────────────────────────────────────────────

  export let value        = undefined    // scalar (single) or array (multiple)
  export let options      = []           // string[]|number[]|{value,label,disabled?}[]
  export let multiple     = false
  export let placeholder  = 'Select…'
  export let readonly     = false
  export let required     = undefined
  export let disabled     = undefined  // undefined = ask the form; false overrides it
  export let type         = 'string'     // 'string' | 'number' — coerces values
  export let min          = undefined    // min selections (for multiple)
  export let max          = undefined    // max selections (for multiple)
  export let allowNew     = false        // allow creating new values by typing
  export let clearable    = true         // show clear-all × when selections exist
  export let closeOnSelect = !multiple  // auto-close after single selection

  // Field integration
  export let name     = ''
  // `undefined` is "not stated" and `''` is "no label, deliberately". They have
  // to be different values: a default of '' makes the two indistinguishable, so
  // the documented suppression below cannot be expressed at all.
  export let label    = undefined
  export let hint     = ''
  export let error    = ''
  export let errors   = undefined

  // The enclosing <Form>, when there is one — see utils.js § Form context.
  const form     = $context.form

  // A <Form> above this control locks it two ways — the caller disabled the
  // form, or a save is in flight — and both mean the same thing to a field.
  // A stated prop still wins, including `disabled={false}` on a saving form.
  const resolvedDisabled = stated(disabled, lockedBy(form, name)) ?? false
  const rule     = resolveRule(form, name)
  const hasError = !!resolveError(form, name, error, errors)

  // `aria-required` rather than a `required` attribute: the value here is the
  // set of pills, and the input inside the box is a search field. A native
  // `required` on it would refuse a submit whenever the search box is empty,
  // which is its resting state with every selection already made.
  const resolvedRequired = stated(required, rule?.required)
  export let badge    = undefined
  export let help     = undefined

  // Async search: { trigger: (query) => Promise<options[]>, delay?: number, min?: number }
  export let asyncOptions = undefined

  export let onchange = undefined   // (value) => void

  // Granular events. `onchange` says the selection is now X; these say WHAT
  // moved, which is the thing a caller cannot recover from the value alone —
  // comparing before and after means holding a copy of before.
  export let onadd    = undefined   // (value, option) => void
  export let onremove = undefined   // (value) => void
  // Fired only for a value `allowNew` minted, and fired BEFORE onadd: a
  // listener that has to persist the new option needs it to exist before
  // anything reacts to it being selected.
  export let oncreate = undefined   // (option) => void

  // Past this many selections the tokens collapse to one summary chip, which
  // expands on click and re-collapses on blur. 0 is off, and off is the
  // default: collapsing is a rendering change for every caller that already
  // has one of these on a screen, and a control that silently hides what was
  // chosen is worse than a tall one unless somebody asked for it.
  export let collapseAfter = 0

  export var id = ''
  const inputId = id || uid('ms')

  // Focus stays in the search box while the arrow keys move the highlight, so
  // `aria-selected` moving down the list says nothing on its own — the input
  // has to NAME the row Enter would take, and a row can only be named if it
  // has an id. Indexed rather than keyed by value: an option's value is the
  // caller's and may be anything, including a string that is not a valid id.
  const listId = uid('ms-list')
  const rowId  = (i) => `${listId}-${i}`

  // ── Internal state ───────────────────────────────────────────────────────────

  let inputValue  = ''
  let open        = false
  let activeIndex = 0       // keyboard cursor in filtered list
  let inputEl
  let containerEl
  var _debounceTimer = undefined

  // Coerce value to correct type
  function coerce(v) {
    return type === 'number' ? Number(v) : String(v)
  }

  // Normalize options to { value, textContent, disabled }
  function normalize(opt) {
    if (typeof opt === 'string' || typeof opt === 'number') {
      return { value: coerce(opt), textContent: String(opt), disabled: false }
    }
    return {
      value:       coerce(opt.value),
      textContent: opt.label ?? opt.textContent ?? String(opt.value),
      disabled:    opt.disabled ?? false,
    }
  }

  // ── Derived state ─────────────────────────────────────────────────────────────

  function mapOf(list) {
    const m = {}
    for (const o of (Array.isArray(list) ? list : []).map(normalize)) m[o.value] = o
    return m
  }

  // Normalized options map — value → option object. Reactive state rather than
  // a derived const, because the async search and `allowNew` add to it.
  //
  // SEEDED HERE, not only by the watch below: a `$:` watch fires on CHANGE, so
  // a caller handing over a plain array changed nothing and the map stayed
  // empty — every dropdown said "No options" for the life of the component,
  // and typing filtered an empty list.
  let optionsMap = mapOf(options)

  // Schema-driven options, the same two sources as Select — an enum off the
  // rule, a relation fetched by the form. MERGED under what is already there
  // rather than assigned, because the async search and `allowNew` write to
  // this map too, and a stated option must keep its own shape.
  const _sync = rule?.options ?? rule?.enum ?? null
  let _total = null
  let _error = null
  if (_sync) optionsMap = { ...mapOf(_sync), ...optionsMap }
  else if (!options?.length && name && form?.optionsFor)
    form.optionsFor(name).then(r => {
      optionsMap = { ...mapOf(r?.options ?? []), ...optionsMap }
      _total = r?.total ?? null
      _error = r?.error ?? null
    })

  // ── a list bigger than the answer ──────────────────────────────────
  //
  // `resource.options()` caps at the server's limit, so a bound array over a
  // big table arrives as a page of it and typing filters the page (`FJS-391`).
  // This control already had a search seam — `asyncOptions` — and it was the
  // CALLER's job to supply one, which a generated form has nobody to ask. Where
  // the form can answer and the list came back cut, it is supplied here.
  export let total = undefined

  const _count  = stated(total, _total)
  const _shown  = Object.keys(optionsMap).length
  const _canAsk = !!(name && form?.optionsFor)

  let _searchAll = false
  const _latch = () => { if (Number.isFinite(_count) && _count > _shown) _searchAll = true }
  _latch()
  $: (_count, _shown), () => _latch()

  // A stated `asyncOptions` always wins — the caller is writing it.
  const _async = asyncOptions ?? ((_canAsk && _searchAll)
    ? { min: 0, trigger: (q) => form.optionsFor(name, { search: q || undefined }).then(r => r?.options ?? []) }
    : null)

  // Why the rows are not there. Stated by the form, which fetched them; read
  // off this control's own fetch otherwise. An empty list and a list nobody
  // could fetch look identical, and a person reads both as *there are none*
  // (`FJS-587`).
  export let optionsError = undefined
  const resolvedHint = withNote(withNote(hint, optionsNote(stated(optionsError, _error))),
                               truncationNote(_shown, _count, { searchable: !!_async }))

  // Later arrivals merge in; a value already known keeps its newest shape.
  $: options, () => { optionsMap = { ...optionsMap, ...mapOf(options) } }

  // Selected values as a Set for O(1) lookup
  const selectedValues = new Set(
    multiple
      ? (Array.isArray(value) ? value : []).map(coerce)
      : value != null ? [coerce(value)] : []
  )

  // Sync selected set when value prop changes from outside
  $: value, () => {
    selectedValues.clear()
    const vals = multiple ? (Array.isArray(value) ? value : []) : value != null ? [value] : []
    for (const v of vals) selectedValues.add(coerce(v))
  }

  // Selected option objects in order of selection
  const selectedItems = [...selectedValues]
    .map(v => optionsMap[v])
    .filter(Boolean)

  // Re-derive selected items when selectedValues changes
  $: selectedValues, () => {
    // Trigger re-render — selectedItems is recomputed reactively
  }

  // Ranked rather than filtered. What was here scored by `indexOf` with a bonus
  // for a prefix, so "ace" ranked `Lovelace` and `Ace Ltd` the same and the
  // order was whatever the options map happened to hold.
  //
  // The ranked answer is kept whole — rows to render, and ranges to mark them
  // with. The ranges come from `byKey.textContent` and not from `ranges`,
  // because a match may have scored on `value`: those indexes point into the
  // value string, and marking the LABEL with them highlights whichever
  // characters happen to sit at those offsets.
  const ranked = (() => {
    const all = Object.values(optionsMap)
    if (!inputValue?.trim()) return all.map(item => ({ item, marks: [] }))
    return rank(all, inputValue, { keys: ['textContent', 'value'] })
      .map(r => ({ item: r.item, marks: r.byKey?.textContent ?? [] }))
  })()

  // Held in a Map keyed by the option OBJECT rather than written onto it: an
  // option can appear in two lists, and ranges belong to a query rather than
  // to an option.
  const marksOf = new Map(ranked.map(r => [r.item, r.marks]))

  // Expanded is per interaction, not per value: the chip is a way to look at a
  // long selection, and it closes again when focus leaves so the control goes
  // back to its declared height.
  let expanded = false

  const collapsed = collapseAfter > 0 && selectedValues.size > collapseAfter && !expanded

  // Don't show already-selected in single mode
  const filtered = multiple
    ? ranked.map(r => r.item)
    : ranked.map(r => r.item).filter(o => !selectedValues.has(o.value))

  // Reset cursor when filter changes
  $: inputValue, () => { activeIndex = 0 }

  // ── Constraints ───────────────────────────────────────────────────────────────

  // Asked before OFFERING an action — whether the × shows, whether Backspace
  // does anything. `commitValue` is what actually refuses; these only keep the
  // UI from presenting a control that would decline.
  const canAdd    = () => !max || selectedValues.size < max
  const canRemove = () => !min || selectedValues.size > min

  // ── Selection actions ──────────────────────────────────────────────────────

  function add(opt, { created = false } = {}) {
    // Single mode REPLACES. Adding to the set instead left the first pick at
    // index 0, and `value` is that index — so choosing a second option changed
    // the set, changed nothing anyone could see, and wrote back the old value.
    const next = multiple ? new Set(selectedValues).add(opt.value) : new Set([opt.value])

    // Before the commit: a token renders from this map, so a value committed
    // without its option has nothing to draw.
    optionsMap[opt.value] = opt

    if (!commitValue(next, () => {
      if (created) oncreate?.(opt)
      onadd?.(opt.value, opt)
    })) return false

    if (closeOnSelect) { open = false; inputValue = '' }
    return true
  }

  function remove(val) {
    const value = coerce(val)
    const next  = new Set(selectedValues)
    next.delete(value)
    return commitValue(next, () => onremove?.(value))
  }

  function clearAll() {
    // Every value that leaves fires `onremove`, including these. A clear that
    // announced nothing per value would make "onremove means this value left"
    // false exactly when the most values left at once.
    const going = [...selectedValues]
    if (!commitValue(new Set(), () => { for (const v of going) onremove?.(v) })) return false

    inputValue = ''
    return true
  }

  /**
   * The one place the selection changes — every action proposes a set and this
   * decides. Per-action guards were how `clearAll` came to ignore `min`: three
   * mutators, two of them checked, and nothing making the third declare itself.
   *
   * `min`/`max` are bounds on the FINISHED selection, not on every intermediate
   * state, so they are asked about the DIRECTION of the change. A control
   * declared `min={2}` starts empty and has to reach two somehow — refusing
   * every state below the floor would refuse the first add and the field could
   * never be filled at all. So a change is refused only when it moves the
   * wrong way past the bound; one already outside it may always move back.
   *
   * @returns {boolean} whether the change was applied, so a caller can skip
   *   the follow-on work (closing, clearing the input) on a refusal.
   */
  function commitValue(next, announce) {
    if (readonly || resolvedDisabled) return false

    const now = selectedValues.size
    if (max && next.size > max && next.size > now) return false
    if (min && next.size < min && next.size < now) return false

    // Synced in place rather than reassigned: `selectedValues` is a const Set
    // and the watches above are registered against that object.
    selectedValues.clear()
    for (const v of next) selectedValues.add(v)

    const vals = [...next]
    value = multiple ? vals : (vals[0] ?? undefined)

    // What MOVED, then what the selection now IS. A listener that has to
    // persist a minted option needs it to exist before anything reacts to the
    // selection containing it — announcing the aggregate first hands `onchange`
    // a value naming a row the server has never heard of.
    announce?.()
    onchange?.(value)
    return true
  }

  // ── Dropdown visibility ──────────────────────────────────────────────────────

  function openDropdown() {
    if (readonly || resolvedDisabled || (!canAdd() && !multiple)) return
    open = true
    inputEl?.focus()
  }

  function closeDropdown() {
    open = false
    activeIndex = 0
  }

  // ── Keyboard navigation ──────────────────────────────────────────────────────

  function handleKeydown(e) {
    if (e.key === 'Escape') { closeDropdown(); return }

    if (e.key === 'ArrowDown') {
      e.preventDefault()
      open = true
      activeIndex = Math.min(activeIndex + 1, filtered.length - 1)
      return
    }

    if (e.key === 'ArrowUp') {
      e.preventDefault()
      activeIndex = Math.max(activeIndex - 1, 0)
      return
    }

    if (e.key === 'Enter') {
      e.preventDefault()
      if (!open) { open = true; return }
      const target = filtered[activeIndex]
      if (target) {
        selectedValues.has(target.value) ? remove(target.value) : add(target)
      } else if (allowNew && inputValue.trim()) {
        const newOpt = { value: coerce(inputValue.trim()), textContent: inputValue.trim(), disabled: false }
        add(newOpt, { created: true })
        inputValue = ''
      }
      return
    }

    if (e.key === 'Backspace' && !inputValue && canRemove() && selectedValues.size) {
      const last = [...selectedValues].at(-1)
      remove(last)
      return
    }

    open = true
  }

  function handleBlur(e) {
    // Delay close so option click fires first
    setTimeout(() => {
      if (!containerEl?.contains(document.activeElement)) {
        closeDropdown()
        expanded = false
      }
    }, 150)
  }

  // ── Async search ──────────────────────────────────────────────────────────────

  $: inputValue, () => {
    if (!_async) return
    clearTimeout(_debounceTimer)
    const q = inputValue?.trim() ?? ''
    if (q.length < (_async.min ?? 1)) return
    _debounceTimer = setTimeout(async () => {
      const results = await _async.trigger(q)
      const normalized = (results ?? []).map(normalize)
      for (const o of normalized) optionsMap[o.value] = o
    }, _async.delay ?? 200)
  }

  // ── Click outside ────────────────────────────────────────────────────────────

  var _outsideHandler = null
  $.onMount(() => {
    _outsideHandler = (e) => {
      if (containerEl && !containerEl.contains(e.target)) closeDropdown()
    }
    document.addEventListener('click', _outsideHandler, { capture: true })
  })
  $.onDestroy(() => {
    document.removeEventListener('click', _outsideHandler, { capture: true })
    clearTimeout(_debounceTimer)
  })

  // ── Dropdown animation ────────────────────────────────────────────────────────

  const dropdownAnim = $.entrance({
    in:  el => el.animate(
      [{ opacity: 0, transform: 'translateY(-4px)' }, { opacity: 1, transform: 'translateY(0)' }],
      { duration: 120, easing: 'ease-out', fill: 'forwards' }
    ),
    out: el => el.animate(
      [{ opacity: 1 }, { opacity: 0 }],
      { duration: 80, fill: 'forwards' }
    ).finished,
  })
</script>

{#snippet control()}
  <div bind:this={containerEl} class="fjs-multiselect">
    <!--
      The token area IS the .field — one control box, not a div dressed up as
      one, so it inherits the border, the focus treatment and :user-invalid.
      Selected values are `.pill removable`, which is the package's chip with
      its own close-button anatomy.
    -->
    <div
      class="field fjs-multiselect-box"
      data-open={open || null}
      aria-invalid={hasError || null}
      style:opacity={resolvedDisabled ? 0.6 : null}
      style:cursor={resolvedDisabled ? 'not-allowed' : 'text'}
      on:click={openDropdown}
    >
      <!--
        Collapsed: one chip standing for the whole selection. A button and not
        a styled span, because it is the only way back to the tokens and a
        keyboard has to reach it.
      -->
      {#if collapsed}
        <button
          type="button"
          class="pill fjs-multiselect-summary"
          aria-expanded="false"
          on:click|stopPropagation={() => { expanded = true }}
        >{selectedValues.size} selected</button>
      {/if}

      <!-- Selected tokens -->
      {#each collapsed ? [] : [...selectedValues] as val (val)}
        {@const opt = optionsMap[val]}
        {#if opt}
          <span class="pill {!readonly && !resolvedDisabled ? 'removable' : ''}">
            {opt.textContent}
            {#if !readonly && !disabled}
              <button
                type="button"
                class="pill-close"
                aria-label="Remove {opt.textContent}"
                on:click|stopPropagation={() => remove(val)}
              >
                <svg viewBox="0 0 20 20" fill="currentColor" aria-hidden="true">
                  <path d="M6.28 5.22a.75.75 0 0 0-1.06 1.06L8.94 10l-3.72 3.72a.75.75 0 1 0 1.06 1.06L10 11.06l3.72 3.72a.75.75 0 1 0 1.06-1.06L11.06 10l3.72-3.72a.75.75 0 0 0-1.06-1.06L10 8.94 6.28 5.22z"/>
                </svg>
              </button>
            {/if}
          </span>
        {/if}
      {/each}

      <!-- Search input — bare, because the .field box around it is the control -->
      {#if !readonly && !disabled}
        <input
          bind:this={inputEl}
          bind:value={inputValue}
          class="fjs-multiselect-input"
          id={inputId}
          type="text"
          autocomplete="off"
          spellcheck="false"
          placeholder={selectedValues.size === 0 ? placeholder : ''}
          aria-required={resolvedRequired ? 'true' : null}
          role="combobox"
          aria-expanded={open}
          aria-haspopup="listbox"
          aria-autocomplete="list"
          aria-controls={listId}
          aria-activedescendant={open && filtered[activeIndex] ? rowId(activeIndex) : null}
          on:keydown={handleKeydown}
          on:blur={handleBlur}
          on:focus={() => open = true}
          {...$attributes}
        />
      {/if}

      <!-- Trailing controls -->
      <span class="fjs-multiselect-actions">
        {#if clearable && selectedValues.size > 0 && !readonly && !disabled}
          <button
            type="button"
            class="btn ghost square"
            aria-label="Clear all"
            on:click|stopPropagation={clearAll}
          >
            <svg viewBox="0 0 20 20" fill="currentColor" aria-hidden="true">
              <path d="M6.28 5.22a.75.75 0 0 0-1.06 1.06L8.94 10l-3.72 3.72a.75.75 0 1 0 1.06 1.06L10 11.06l3.72 3.72a.75.75 0 1 0 1.06-1.06L11.06 10l3.72-3.72a.75.75 0 0 0-1.06-1.06L10 8.94 6.28 5.22z"/>
            </svg>
          </button>
        {/if}
        <svg
          class="icon text-muted"
          viewBox="0 0 20 20"
          fill="currentColor"
          aria-hidden="true"
          style:transform={open ? 'rotate(180deg)' : null}
          style:transition="transform 120ms"
        >
          <path fill-rule="evenodd" d="M5.22 8.22a.75.75 0 0 1 1.06 0L10 11.94l3.72-3.72a.75.75 0 1 1 1.06 1.06l-4.25 4.25a.75.75 0 0 1-1.06 0L5.22 9.28a.75.75 0 0 1 0-1.06z" clip-rule="evenodd"/>
        </svg>
      </span>
    </div>

    <!-- Dropdown -->
    {#if open}
      <div class="popover fjs-multiselect-panel" {@attach dropdownAnim}>
        <ul class="items menu" id={listId} role="listbox" aria-label="Options" aria-multiselectable={multiple}>
          {#if filtered.length === 0}
            <li class="item text-muted" aria-disabled="true">
              {allowNew && inputValue.trim()
                ? `Press Enter to add "${inputValue.trim()}"`
                : 'No options'}
            </li>
          {:else}
            {#each filtered as opt, i (opt.value)}
              {@const isSelected = selectedValues.has(opt.value)}
              {@const isActive   = i === activeIndex}
              <!--
                mousemove, not mouseenter: the panel opens under whatever the
                pointer was last left on, and arrow-keying a long list scrolls
                rows under a still pointer. Either way mouseenter moves the
                cursor to a row nobody chose and Enter takes it. Guarded
                because mousemove fires per pixel.
              -->
              <li
                class="item fjs-multiselect-option"
                id={rowId(i)}
                role="option"
                aria-selected={isSelected}
                aria-disabled={opt.disabled || null}
                data-active={isActive || null}
                on:mousemove={() => { if (activeIndex !== i) activeIndex = i }}
                on:click|preventDefault={() => isSelected ? remove(opt.value) : add(opt)}
              >
                <!--
                  One line on purpose. Broken across lines, the whitespace
                  between the pieces renders INSIDE the word — "Lovelace"
                  matched at "Love" comes out as "Love lace".
                -->
                <span style:flex="1">{#each segments(opt.textContent, marksOf.get(opt) ?? []) as part, i (i)}{#if part.match}<mark>{part.text}</mark>{:else}{part.text}{/if}{/each}</span>
                {#if isSelected}
                  <svg viewBox="0 0 20 20" fill="currentColor" aria-hidden="true">
                    <path fill-rule="evenodd" d="M16.704 4.153a.75.75 0 0 1 .143 1.052l-8 10.5a.75.75 0 0 1-1.127.075l-4.5-4.5a.75.75 0 0 1 1.06-1.06l3.894 3.893 7.48-9.817a.75.75 0 0 1 1.05-.143Z" clip-rule="evenodd"/>
                  </svg>
                {/if}
              </li>
            {/each}
          {/if}
        </ul>
      </div>
    {/if}
  </div>
{/snippet}

{#if label || name}
  <Field
    id={inputId}
    name={name}
    label={label}
    required={resolvedRequired}
    hint={resolvedHint}
    error={error}
    errors={errors}
    badge={badge}
    help={help}
    {class}
  >
    {@render control()}
  </Field>
{:else}
  <div {class}>
    {@render control()}
  </div>
{/if}


<style>
  .fjs-multiselect { position: relative; }

  /* .field is display:block; the token area needs to be a wrapping row. */
  .fjs-multiselect-box {
    display:        flex;
    flex-wrap:      wrap;
    align-items:    center;
    gap:            0.375rem;
    min-block-size: 2.25rem;
    padding:        0.3125rem 0.5rem;
  }
  /* Open mirrors the focus treatment, since focus is on the inner input. */
  .fjs-multiselect-box[data-open] {
    border-color: var(--bg-mix, var(--color-primary));
  }

  /* Bare input — the box around it is the control. */
  .fjs-multiselect-input {
    flex:            1;
    min-inline-size: 6rem;
    border:          0;
    padding:         0;
    background:      transparent;
    color:           inherit;
    font:            inherit;
  }
  .fjs-multiselect-input:focus { outline: none; }

  .fjs-multiselect-actions {
    display:             flex;
    align-items:         center;
    gap:                 0.25rem;
    margin-inline-start: auto;
    flex-shrink:         0;
  }

  .fjs-multiselect-panel {
    inset-inline:      0;
    inset-block-start: calc(100% + 0.25rem);
    max-inline-size:   none;
    max-block-size:    12rem;
    overflow-y:        auto;
    padding:           0.25rem;
    z-index:           50;
  }
  /* The summary chip. `.pill` is the package's chip and this only adds the
     affordance that it is pressable — a caller must be able to tell it apart
     from the tokens it replaced. */
  .fjs-multiselect-summary {
    cursor: pointer;
    font-weight: 600;
  }

  /* The matched run. Weight rather than a colour — the design system owns
     tone, and "this is why the row matched" is not one of them. */
  .fjs-multiselect-option mark {
    background: transparent;
    color: inherit;
    font-weight: 700;
  }

  .fjs-multiselect-option {
    display:     flex;
    align-items: center;
    gap:         0.5rem;
    cursor:      pointer;
  }
  .fjs-multiselect-option[data-active] {
    background: color-mix(in srgb, var(--color-primary) 10%, transparent);
    color:      var(--color-primary);
  }
  .fjs-multiselect-option[aria-selected="true"] { font-weight: 600; }
  .fjs-multiselect-option[aria-disabled="true"] {
    opacity:        0.4;
    pointer-events: none;
  }
</style>
