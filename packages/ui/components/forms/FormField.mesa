<script>
  // FormField.mesa
  // One generated field → the control that renders it.
  //
  // `<Form>` used to hold an `{#if}` ladder over the five control names Sierra's
  // table can answer, which made the kit's own controls the only ones there
  // could ever be: a plugin could name a control and nothing would render it.
  // The ladder is a TABLE here instead, and `@frontierjs/ui/controls` is a
  // registry consulted before it — so a contributed control takes exactly the
  // path a built-in takes, and a registered name replaces a built-in of the
  // same name rather than losing to it.
  //
  // What the schema already resolved is not repeated here. A label, a
  // `required`, a `maxlength`, a `type="email"` and the server's message all
  // come off `$context.form` inside the control itself; what this passes is the
  // three things the schema does not say — which control, its value, and how
  // the value comes back.

  import Checkbox      from './Checkbox.mesa'
  import Combobox      from './Combobox.mesa'
  import DateTimeInput from './DateTimeInput.mesa'
  import FileField     from './FileField.mesa'
  import MultiSelect   from './MultiSelect.mesa'
  import Input         from './Input.mesa'
  import JsonInput     from './JsonInput.mesa'
  import Select        from './Select.mesa'
  import Textarea      from './Textarea.mesa'
  import { formControl, defaultControlProps } from '../../controls.js'

  // One entry from `resource.formFields()` — `{ name, rule, control, … }`.
  export let field

  export let value   = undefined
  export let write   = undefined      // (v) => void
  export let options = undefined      // a foreign key's rows, once they arrive
  // How many rows the SERVER has, where it said. A control that shows a page
  // of a big relation and one that shows all of it are the same screen once
  // the count is dropped (`FJS-391`), so the three list controls take it.
  export let total   = undefined

  // The kit's own controls, in the registry's shape. `props` receives the same
  // object a contributed control's builder does.
  const BUILTIN = {
    select: {
      component: Select,
      // A `<select>` renders the enum members the schema declared…
      props: ({ field: f, value: v, onvalue, total: n }) => ({
        name: f.name, placeholder: '—', options: f.options ?? [], total: n,
        value: v, oninput: (e) => onvalue(e.target.value),
      }),
    },
    // A relation, and a `@values` binding whose strength is `required`. Both
    // mean *choose one existing row*, and both are SEARCHABLE — a `Combobox`
    // with `allowNew` off is a select you can type into (`FJS-459`).
    //
    // It used to be a native `<select>`, which cannot reach past the page the
    // server sent: `resource.options()` caps at 100, so a relation with four
    // hundred rows offered an alphabetical prefix and the row somebody wanted
    // was unreachable by any interaction the control had. Saying *showing 100
    // of 400* made that honest and no more usable. Every admin platform with a
    // reference field — Salesforce's lookup, ServiceNow's, Frappe's Link —
    // resolved it the same way, at every list size rather than past a
    // threshold, which is also what keeps this one control instead of two that
    // swap after the count arrives.
    //
    // The cost is real and is a native select's two advantages: the OS picker
    // on a phone, and a value that submits with the form on its own. The second
    // does not apply under `<Form>`, which writes through the resource.
    picker: {
      component: Combobox,
      props: ({ field: f, value: v, onvalue, options: rows, total: n }) => ({
        name: f.name, options: rows ?? [], allowNew: false, total: n,
        value: v, onchange: (next) => onvalue(next),
      }),
    },
    // A column bound to a value set whose strength is not `required`. The two
    // weak strengths render the same control: what separates `open` from
    // `suggested` is what the SERVER does with a value the set does not hold,
    // not what the caller may type. `allowNew` is off for `required`, which is
    // why that strength answers `picker` instead and never arrives here.
    combobox: {
      component: Combobox,
      props: ({ field: f, value: v, onvalue, options: rows, total: n }) => ({
        name: f.name, options: rows ?? [], allowNew: f.allowNew === true, total: n,
        value: v, onchange: (next) => onvalue(next),
      }),
    },
    // The array form of the same thing. An unbound array is still `json` — the
    // schema stops describing it — but a bound one has a list behind it, which
    // is the whole difference.
    multiselect: {
      component: MultiSelect,
      props: ({ field: f, value: v, onvalue, options: rows, total: n }) => ({
        name: f.name, options: rows ?? [], multiple: true, total: n,
        allowNew: f.allowNew === true,
        value: Array.isArray(v) ? v : (v == null ? [] : [v]),
        onchange: (next) => onvalue(next),
      }),
    },
    checkbox: {
      component: Checkbox,
      props: ({ field: f, value: v, onvalue }) => ({
        name: f.name, checked: v, onchange: (next) => onvalue(next),
      }),
    },
    textarea: {
      component: Textarea,
      props: ({ field: f, value: v, onvalue }) => ({
        name: f.name, value: v, oninput: (e) => onvalue(e.target.value),
      }),
    },
    input: {
      component: Input,
      props: ({ field: f, value: v, onvalue }) => ({
        name: f.name, type: f.type, step: f.step, value: v,
        oninput: (e) => onvalue(e.target.value),
      }),
    },
    json: {
      component: JsonInput,
      // `onvalue` for the same reason `datetime` uses it: what the element
      // holds is text and what the column holds is a document, so
      // `e.target.value` is the one value that must not reach the write.
      props: ({ field: f, value: v, onvalue }) => ({
        name: f.name, value: v, onvalue: (doc) => onvalue(doc),
      }),
    },
    // A `File` column. The value is one of three shapes — nothing, the URL the
    // server resolved a stored reference into, or the browser `File` the person
    // just chose — and only the third is ever handed back, so `onvalue` again
    // and never `e.target.value`.
    //
    // Nothing uploads here. A File anywhere in the payload turns the create or
    // patch into `multipart/form-data` at the client, so submitting the form IS
    // the upload (`FJS-409`) — which keeps the bytes on the one route that has
    // the gate, the row policies and `@accept` on it.
    file: {
      component: FileField,
      props: ({ field: f, value: v, onvalue }) => ({
        name: f.name, field: f, value: v, onvalue: (next) => onvalue(next),
      }),
    },
    datetime: {
      component: DateTimeInput,
      // `onvalue` rather than `oninput` on purpose: the element holds a wall
      // clock and the column holds an instant, so `e.target.value` here is the
      // one value that must never reach the write.
      props: ({ field: f, value: v, onvalue }) => ({
        name: f.name, value: v, onvalue: (iso) => onvalue(iso),
      }),
    },
  }

  // Registered first, then the kit's table, then the kit's default — a control
  // name the table does not know but a resolver answered is the plugin case,
  // and `input` is what an unnamed one falls back to for exactly the reason the
  // old ladder's `{:else}` did.
  const entry = field?.control ? (formControl(field.control) ?? BUILTIN[field.control] ?? null) : null

  // A name nobody bound renders nothing at all, and a form with a field missing
  // is the failure generating the list exists to end — so say which half is
  // absent. The resolver named a control; the kit was never told what it is.
  if (!entry && field?.control) {
    console.warn(
      `[FormField] ${field.name} asked for the control '${field.control}' and no component is bound to ` +
      `that name. registerFormControl('${field.control}', Component) from '@frontierjs/ui/controls', ` +
      'in the same place the resolver was registered.',
    )
  }

  const Control = entry?.component

  const props = entry
    ? (entry.props ?? defaultControlProps)({
        field, value, options, total, onvalue: (v) => write?.(v),
      })
    : {}
</script>

{#if Control}
  <Control {...props} />
{/if}
