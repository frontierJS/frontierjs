<script>
  // Switch.mesa
  // Toggle switch — a real <input type="checkbox" class="switch">.
  //
  // ── Why not a <button role="switch"> ─────────────────────────────────
  //
  // The previous version was a button with aria-checked and a translated
  // thumb <span>. A real checkbox participates in forms, is submitted with
  // the form, restores on back-navigation, and needs no ARIA at all — and
  // @frontierjs/css paints the track and thumb from `appearance: none`, so
  // the shape costs nothing either way.
  //
  // Note the tone goes on the `.field-check` label, not on the input:
  // --bg-mix is element-scoped, so the input cannot see a tone set on itself
  // by an ancestor. The label derives it into --check-accent and passes it
  // down. (A tone on either element works; the label is the reliable one.)
  //
  // Usage:
  //   <Switch bind:checked={darkMode} label="Dark mode" />
  //   <Switch bind:checked={enabled} tone="success" />

  import { tone as toTone, cx, uid, nameToLabel, resolveError, resolveRule, stated, nativeValidationGuard, lockedBy } from '../../utils.js'

  export let checked     = false
  // `undefined` is "not stated" and `''` is "no label, deliberately". They have
  // to be different values: a default of '' makes the two indistinguishable, so
  // the documented suppression below cannot be expressed at all.
  export let label       = undefined       // falls back to @label, then the column name
  export let description = ''
  export let name        = undefined
  export let value       = undefined
  export let disabled    = undefined  // undefined = ask the form; false overrides it
  export let required    = undefined
  export let error       = ''
  export let errors      = undefined
  export let tone        = ''
  export let labelSide   = 'right'  // 'left' | 'right'
  export let onchange    = undefined

  export var id = ''
  const switchId = id || uid('switch')
  const descId   = uid('switch-desc')

  // The enclosing <Form> and this field's rule, both undefined standing alone.
  // A switch is a checkbox wearing a different shape, so it resolves exactly
  // what Checkbox does — without this it was the same control unable to say its
  // own name or show its own rejection, and it also carried no `name`, so a
  // form's dirty tracking could not see the field at all.
  const form = $context.form

  // A <Form> above this control locks it two ways — the caller disabled the
  // form, or a save is in flight — and both mean the same thing to a field.
  // A stated prop still wins, including `disabled={false}` on a saving form.
  const resolvedDisabled = stated(disabled, lockedBy(form, name)) ?? false
  const rule = resolveRule(form, name)

  const resolvedLabel    = stated(label, rule?.title, name ? nameToLabel(name) : '') ?? ''
  const resolvedRequired = stated(required, rule?.required)
  const displayError     = resolveError(form, name, error, errors)

  const t = displayError ? 'danger' : toTone(tone)

  function handleChange(e) {
    checked = e.target.checked
    onchange?.(checked)
  }
</script>

<div class="stack" style:gap="0.25rem" {class}>
  <label
    class={cx('field-check', t)}
    for={switchId}
    style:flex-direction={labelSide === 'left' ? 'row-reverse' : null}
  >
    <input
      id={switchId}
      class="switch"
      type="checkbox"
      role="switch"
      name={name}
      value={value}
      checked={checked}
      disabled={resolvedDisabled}
      required={resolvedRequired}
      {@attach nativeValidationGuard}
      aria-describedby={description ? descId : null}
      aria-invalid={displayError ? 'true' : null}
      on:change={handleChange}
      {...$attributes}
    />
    {#if resolvedLabel}<span>{resolvedLabel}</span>{/if}
  </label>

  {#if description}
    <p class="field-hint" id={descId}>{description}</p>
  {/if}

  {#if displayError}
    <p class={cx('field-hint', 'danger')} role="alert">{displayError}</p>
  {/if}
</div>
