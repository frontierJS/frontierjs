<script>
  // Btn.mesa
  // Compact action button for toolbars, table rows, and icon-dense UIs.
  //
  // The only difference from Button is the defaults — ghost, and one step
  // smaller. Everything else is the same `.btn` with the same tones and
  // treatments, so a Btn and a Button side by side cannot drift.
  //
  // Usage:
  //   <Btn onclick={save}>Save</Btn>
  //   <Btn tone="danger" square aria-label="Delete" onclick={del}><IconTrash /></Btn>
  //   <Btn variant="outlined" size="xs">Export</Btn>

  import { tone as toTone, cx } from '../../utils.js'

  export let tone     = ''
  export let variant  = 'ghost'   // tone name OR 'outlined'|'ghost'|'link'|'raised'
  export let size     = 'sm'      // 'xs' | 'sm' | 'md'
  export let square   = false     // icon-only shape
  export let icon     = false     // legacy alias for `square`
  export let disabled = false
  export let type     = 'button'
  export let onclick  = undefined

  const TREATMENTS = { outlined: 'outlined', outline: 'outlined', ghost: 'ghost', link: 'link', raised: 'raised' }

  const treatment = TREATMENTS[variant] ?? ''
  const t = toTone(tone) || (treatment ? '' : toTone(variant))

  const sizeMap = { xs: '0.6875rem', sm: '0.75rem', md: '0.8125rem' }
  const fontSize = sizeMap[size] ?? sizeMap.sm

  const isSquare = square || icon
</script>

<button
  type={type}
  disabled={disabled}
  class={cx('btn', t, treatment, isSquare && 'square')}
  style:font-size={fontSize}
  {class}
  {...$attributes}
  on:click={onclick}
>
  <slot />
</button>
