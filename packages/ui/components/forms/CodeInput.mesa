<script>
  // CodeInput.mesa
  // A text box that edits source and shows it highlighted — a template, a
  // query, a snippet, a document in its own syntax.
  //
  // ── Two layers, one grid cell ────────────────────────────────────────
  //
  // A real <textarea> on top with its text transparent, and glow's output
  // underneath in a `<pre class="code">`. The textarea is the control — caret,
  // selection, undo, IME, spellcheck, form submission and every assistive
  // technology are the browser's, and nothing here reimplements an editor.
  // The layer beneath is paint and is `aria-hidden`.
  //
  // The overlay holds only while both layers lay text out identically, and
  // every way it breaks is a caret that drifts from the character it sits on:
  //
  //   - One rule sets the metrics for both — `.fjs-code-input-layer` — font,
  //     size, line-height, padding, border width, tab size, white-space. A
  //     second copy of any of them on one layer is where they drift apart.
  //   - glow must emit exactly the characters typed: `prefix: false` keeps a
  //     leading `+`, `-`, `>` or `\`, and `mark: false` keeps `•`. Either one
  //     on removes characters from the paint and not from the box.
  //   - A `<pre>` draws no line for a trailing newline, so the box would hold
  //     one line more than the paint and scroll by it; `paintable` gives that
  //     empty last line a space.
  //   - Every line is its own `<span>`, numbered or not — code.css numbers
  //     `code > span`, so an unnumbered box hides the counter rather than
  //     painting lines of a different shape.
  //   - Both layers share one grid cell, so the cell is as tall as the longer
  //     of the two and the textarea never scrolls vertically — and both carry
  //     `overflow: auto`, so a horizontal scrollbar appears on both at the same
  //     width and takes the same height from each. The textarea scrolls
  //     sideways and the paint is moved to match.
  //
  // Usage:
  //   <CodeInput name="body" language="md" value={row.body} oninput={e => row.body = e.target.value} />
  //   <CodeInput name="query" language="sql" numbered />
  //
  // bind:this exposes: focus()

  import Field    from './Field.mesa'
  import { glowLine, glowLanguage } from '@frontierjs/toolbelt/glow'
  import { humanize, uid, resolveError, resolveRule, stated, nativeValidationGuard, lockedBy } from '../../utils.js'

  export let value       = ''
  export let language    = ''       // glow language — 'js', 'sql', 'md', 'json', …; '' guesses
  export let numbered    = false    // line numbers in a gutter
  export let rows        = 6        // the height at rest; the box grows past it
  export let placeholder = ''
  export let disabled    = undefined  // undefined = ask the form; false overrides it
  export let required    = undefined
  export let readonly    = false

  // Field integration
  export let name   = ''
  export let label  = undefined
  export let hint   = ''
  export let error  = ''
  export let errors = undefined
  export let badge  = undefined
  export let help   = undefined

  export let oninput  = undefined
  export let onchange = undefined
  export let onblur   = undefined
  export let onfocus  = undefined

  export var id = ''
  const areaId    = id || uid('code')
  const autoLabel = humanize(name)

  const form = $context.form

  const resolvedDisabled = stated(disabled, lockedBy(form, name)) ?? false
  const rule             = resolveRule(form, name)
  const resolvedRequired = stated(required, rule?.required)
  const hasError         = !!resolveError(form, name, error, errors)

  let el
  let paint
  export function focus() { el?.focus() }

  $: source    = value ?? ''
  $: paintable = source.endsWith('\n') ? source + ' ' : source

  // ── The paint is repainted by the line ───────────────────────────────
  //
  // A keystroke changes a line or two, and re-glowing the whole buffer into
  // one {@html} made it cost the size of the document instead: 37.7 s a key on
  // a 4.2 MB JSON text, most of it the collector clearing the paint the key
  // before had thrown away (FJS-1621). So only the lines between the first and
  // last that differ are glowed, plus any after them whose block-comment state
  // the edit changed, which is the one thing glow carries from line to line.
  //
  // Replacing them is the other half. Adding or removing an element among a
  // block's lines re-lays every line in it: 200-460 ms of layout a key with
  // 22,000 lines in one <code>, against 11-30 ms in chunks. So the paint is a
  // run of <code> blocks of at most CHUNK lines, and an edit rebuilds only the
  // chunks it touches. Each chunk but the last ends in the newline before the
  // next one, which a block draws no line for.
  //
  // glow encodes every slice of the source it emits, so its lines are safe to
  // hand to innerHTML. A highlighter that did not is a stored XSS in any field
  // somebody else can write.
  //
  // `var`, because none of this is state the template follows: the first paint
  // is the server's, and every later one is written here.
  const LINE  = { prefix: false, mark: false, numbered: true }
  const CHUNK = 64

  function glowLines(lines, lang, from, to, open) {
    const opts = { ...LINE, language: lang || undefined }
    const html = [], opens = []
    for (let i = from; i < to; i++) {
      const out = glowLine(lines[i], opts, open)
      html.push(out.html)
      opens.push(open = out.open)
    }
    return { html, opens }
  }

  // `html[from..to)` as chunks; `last` is whether `to` ends the document.
  function chunk(html, from, to, last, lang) {
    const open = `<code language="${lang || '*'}">`
    const parts = [], sizes = []
    for (let i = from; i < to; i += CHUNK) {
      const end = Math.min(i + CHUNK, to)
      parts.push(open + html.slice(i, end).join('\n') + (end === to && last ? '' : '\n') + '</code>')
      sizes.push(end - i)
    }
    return { markup: parts.join(''), sizes }
  }

  function paintAll(lines, lang) {
    const out = glowLines(lines, lang, 0, lines.length, false)
    const c   = chunk(out.html, 0, lines.length, true, lang)
    return { lines, lang, html: out.html, opens: out.opens, sizes: c.sizes, markup: c.markup }
  }

  var shown      = paintAll(paintable.split(/\r?\n/), glowLanguage(paintable, language) || '')
  var firstPaint = shown.markup

  function repaint(text) {
    if (!paint) return
    const next = text.split(/\r?\n/)
    const lang = glowLanguage(next, language) || ''

    if (lang !== shown.lang) {
      shown = paintAll(next, lang)
      paint.innerHTML = shown.markup
      return
    }

    const prev = shown.lines
    const min  = Math.min(prev.length, next.length)
    let from = 0
    while (from < min && prev[from] === next[from]) from++
    if (from === prev.length && from === next.length) return
    let tail = 0
    while (tail < min - from && prev[prev.length - 1 - tail] === next[next.length - 1 - tail]) tail++

    let prevTo = prev.length - tail
    let nextTo = next.length - tail
    if (prevTo === from || nextTo === from) {
      if (from > 0) from--
      else { prevTo++; nextTo++ }
    }

    const out = glowLines(next, lang, from, nextTo, from > 0 ? shown.opens[from - 1] : false)
    // Opening or closing a comment recolors every line up to where the old and
    // new paints agree on it again.
    while (nextTo < next.length && out.opens[out.opens.length - 1] !== shown.opens[prevTo - 1]) {
      const more = glowLines(next, lang, nextTo, nextTo + 1, out.opens[out.opens.length - 1])
      out.html.push(more.html[0])
      out.opens.push(more.opens[0])
      prevTo++
      nextTo++
    }

    // The chunks holding old lines [from, prevTo), and the lines they span.
    const { sizes } = shown
    let first = 0, start = 0
    while (start + sizes[first] <= from) start += sizes[first++]
    let last = first, end = start + sizes[first]
    while (end < prevTo) end += sizes[++last]

    const html  = shown.html.slice(0, from).concat(out.html, shown.html.slice(prevTo))
    const shift = nextTo - prevTo
    const c     = chunk(html, start, end + shift, end === prev.length, lang)

    const range = document.createRange()
    range.setStartBefore(paint.children[first])
    range.setEndAfter(paint.children[last])
    range.deleteContents()
    const tpl = document.createElement('template')
    tpl.innerHTML = c.markup
    range.insertNode(tpl.content)

    shown = {
      lines: next,
      lang,
      html,
      opens: shown.opens.slice(0, from).concat(out.opens, shown.opens.slice(prevTo)),
      sizes: sizes.slice(0, first).concat(c.sizes, sizes.slice(last + 1)),
    }
  }

  $: repaint(paintable)

  function handleInput(e) {
    value = e.target.value
    oninput?.(e)
  }

  function syncScroll() {
    if (!paint || !el) return
    paint.scrollTop  = el.scrollTop
    paint.scrollLeft = el.scrollLeft
  }
</script>

{#snippet control()}
  <div class="fjs-code-input" class:numbered>
    <pre bind:this={paint} class="code fjs-code-input-layer fjs-code-input-paint" aria-hidden="true">{@html firstPaint}</pre>
    <textarea
      bind:this={el}
      class="fjs-code-input-layer fjs-code-input-text"
      id={areaId}
      name={name || undefined}
      rows={rows}
      placeholder={placeholder}
      disabled={resolvedDisabled}
      required={resolvedRequired}
      {@attach nativeValidationGuard}
      readonly={readonly}
      spellcheck="false"
      autocomplete="off"
      autocapitalize="off"
      autocorrect="off"
      aria-invalid={hasError || null}
      on:input={handleInput}
      on:scroll={syncScroll}
      on:change={onchange}
      on:blur={onblur}
      on:focus={onfocus}
      {...$attributes}
      value={source}
    >{source}</textarea>
    <!--
      The value is written as child text and as the property for the reason
      Textarea.mesa gives: the text is what a server render emits, the property
      is what a later change has to go through.
    -->
  </div>
{/snippet}

{#if label || (name && autoLabel)}
  <Field
    id={areaId}
    name={name}
    label={label}
    required={resolvedRequired}
    badge={badge}
    help={help}
    hint={hint}
    error={error}
    errors={errors}
    {class}
  >
    {@render control()}
  </Field>
{:else}
  {@render control()}
{/if}

<style>
  .fjs-code-input {
    display:               grid;
    /* minmax(0, …) or one long line widens the track past the page. */
    grid-template-columns: minmax(0, 1fr);
  }

  /* The metrics, for both layers at once. Nothing below may restate one. */
  .fjs-code-input-layer {
    grid-area:  1 / 1;
    box-sizing: border-box;
    margin:     0;
    padding:    var(--space-xl) var(--space-2xl);
    border:     var(--border-width) solid transparent;

    font-family:    var(--font-mono);
    font-size:      var(--text-sm);
    font-weight:    normal;
    font-style:     normal;
    line-height:    var(--leading-relaxed);
    letter-spacing: normal;
    word-spacing:   normal;
    tab-size:       2;
    white-space:    pre;
    overflow-wrap:  normal;
    text-align:     start;

    overflow:   auto;
  }

  /* The gutter glow's numbered <span>::before draws: 2.5em wide + 1em gap. */
  .numbered > .fjs-code-input-text {
    padding-inline-start: calc(var(--space-2xl) + 3.5em);
  }

  .fjs-code-input-paint {
    pointer-events: none;
    user-select:    none;
    border-color:   var(--rule);
  }

  /* Every line is a <span> so it can be replaced alone, and code.css numbers
     every `code > span` from 1 in each <code>. The paint is several <code>s,
     so the count is the <pre>'s and runs across them; unnumbered, there is
     none. */
  .fjs-code-input-paint { counter-reset: code-line 0; }
  .fjs-code-input .fjs-code-input-paint :global(code) { counter-reset: none; }
  .fjs-code-input:not(.numbered) > .fjs-code-input-paint :global(code > span) {
    counter-increment: none;
  }
  .fjs-code-input:not(.numbered) > .fjs-code-input-paint :global(code > span::before) {
    content: none;
  }

  /* code.css makes a highlighted <code> its own scroller; here the <pre> is,
     or its padding would clip the paint where the textarea's does not. */
  .fjs-code-input-paint :global(code) {
    overflow: visible;
  }

  .fjs-code-input-text {
    background:  transparent;
    color:       transparent;
    caret-color: var(--code-text, var(--ink));
    resize:      none;
    outline:     none;
  }

  .fjs-code-input-text::placeholder {
    color:   var(--ink-mute);
    opacity: 1;
  }

  /* The selected text is the paint showing through, so the highlight must be
     translucent and the textarea's own glyphs must stay invisible. */
  .fjs-code-input-text::selection {
    background: color-mix(in srgb, var(--ring, var(--color-primary)) 25%, transparent);
    color:      transparent;
  }

  /* The focus ring is drawn on the paint because the paint is the visible box;
     the chain is focus.css's. */
  .fjs-code-input:has(> .fjs-code-input-text:focus) > .fjs-code-input-paint {
    border-color:   var(--ring, var(--color-primary));
    outline:        var(--ring-width) var(--ring-style) var(--ring, var(--color-primary));
    outline-offset: var(--ring-offset);
  }

  .fjs-code-input:has(> .fjs-code-input-text[aria-invalid="true"]) > .fjs-code-input-paint {
    border-color: var(--color-danger);
  }

  .fjs-code-input:has(> .fjs-code-input-text:disabled) > .fjs-code-input-paint {
    background: color-mix(in srgb, var(--ink) 4%, var(--surface));
  }

  .fjs-code-input-text:disabled { cursor: not-allowed; }
</style>
