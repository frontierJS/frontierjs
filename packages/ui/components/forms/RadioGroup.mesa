<script>
  // RadioGroup.mesa
  // A group of radio options rendered as selectable cards.
  //
  // Each option is a <label class="card field-check"> around a real radio, so
  // the whole card is the hit target and arrow-key navigation between options
  // is the platform's — a radio group does not need a roving tabindex the way
  // a tablist does.
  //
  // The selected card is styled from `:has(:checked)` rather than a class,
  // for the same reason tabs key off aria-selected: the look and the state
  // cannot drift apart.
  //
  // items: { value, label, description?, disabled? }[]
  //
  // Usage:
  //   <RadioGroup
  //     bind:value={plan}
  //     label="Billing cycle"
  //     items={[
  //       { value: 'monthly', label: 'Monthly', description: '$12/mo' },
  //       { value: 'yearly',  label: 'Yearly',  description: '$99/yr' },
  //     ]}
  //   />

  import Field from './Field.mesa'
  import { uid, nameToLabel, resolveError, resolveRule, stated } from '../../utils.js'

  export let items    = []
  export let value    = null
  export let label    = ''
  export let hint     = ''
  export let error    = ''
  export let errors   = undefined
  export let name     = ''
  export let required = undefined
  export let disabled = false
  export let layout   = 'stacked'  // 'stacked' | 'inline'
  export let onchange = undefined

  // The enclosing <Form> and this field's rule, both undefined standing alone.
  // The group used to wrap itself in a Field only when a `label` prop was
  // given, so inside a <Form> — where the label is a schema fact nobody
  // restates — it rendered bare: no label, no server error, no `required`.
  const form = $context.form
  const rule = resolveRule(form, name)

  const resolvedLabel    = stated(label || undefined, rule?.title, name ? nameToLabel(name) : undefined)
  const resolvedRequired = stated(required, rule?.required)
  const displayError     = resolveError(form, name, error, errors)

  // `id` was declared and never used: it reached no element, so a caller could
  // not address the group at all, and Field rendered `<label for="">`.
  //
  // It goes on the [role=radiogroup] element, and NOT into Field's `for` — a
  // <label for> must point at a labelable control, which a group is not. The
  // group's accessible name is its aria-label.
  export var id = ''
  const groupId   = id
  const groupName = name || uid('radio')

  function handleChange(e) {
    value = e.target.value
    onchange?.(value)
  }
</script>

{#snippet group()}
  <!--
    role="radiogroup" needs an accessible name to be worth anything. When
    this is inside a Field, the Field's label is it; standalone, pass one.
  -->
  <div
    id={groupId || null}
    role="radiogroup"
    aria-label={resolvedLabel || null}
    aria-required={resolvedRequired ? 'true' : null}
    aria-invalid={displayError ? 'true' : null}
    class={layout === 'inline' ? 'cluster' : 'stack'}
    style:gap="0.5rem"
    {...$attributes}
  >
    {#each items as item (item.value)}
      {@const isSelected = value === item.value}
      {@const isDisabled = disabled || item.disabled}
      {@const descId = `${groupName}-${item.value}-desc`}

      <label class="card field-check fjs-radio-card">
        <input
          type="radio"
          name={groupName}
          value={item.value}
          checked={isSelected}
          disabled={isDisabled}
          aria-describedby={item.description ? descId : null}
          on:change={handleChange}
        />
        <span class="stack" style:gap="0.125rem">
          <span>{item.label}</span>
          {#if item.description}
            <span class="field-hint" id={descId}>{item.description}</span>
          {/if}
        </span>
      </label>
    {/each}
  </div>
{/snippet}

<!--
  A `name` is enough to wrap: it is what makes the Field resolvable, and a
  group inside a <Form> states nothing else. `label` goes through unresolved
  where the caller stated nothing so Field resolves it once off the same rule;
  `|| undefined` because '' is a real answer that suppresses the label.
-->
{#if label || name}
  <Field
    name={name}
    label={label || undefined}
    required={resolvedRequired}
    hint={hint}
    error={error}
    errors={errors}
    {class}
  >
    {@render group()}
  </Field>
{:else}
  {@render group()}
{/if}

<style>
  .fjs-radio-card {
    display:     flex;
    align-items: flex-start;
    gap:         0.75rem;
    padding:     0.75rem 1rem;
    cursor:      pointer;
    transition:  border-color 120ms, background 120ms;
  }
  /*
   * Selected state from the checked input, not a class — and from the tint
   * ramp rather than a hand-mixed colour. One input (`--bg-mix`) gives a fill
   * and a rule that are already measured for contrast against every shipped
   * theme; a local `color-mix()` is measured against none of them and nobody
   * re-measures one when a theme is added.
   */
  .fjs-radio-card:has(input:checked) {
    --bg-mix:     var(--color-primary);
    border-color: var(--tint-rule);
    background:   var(--tint-surface);
  }
  .fjs-radio-card:has(input:disabled) {
    opacity: 0.55;
    cursor:  not-allowed;
  }
</style>
