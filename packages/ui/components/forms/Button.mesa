<script>
  // Button.mesa
  // Polymorphic button. `.btn` plus a tone and/or a treatment.
  //
  // In @frontierjs/css a tone (primary, danger, …) and a treatment (outlined,
  // ghost, link, raised) are different kinds of class and compose freely, so
  // `tone="danger" treatment="outlined"` is a red outline button. With neither
  // given the button is primary; a treatment alone takes no tone.
  //
  // Sizes are a font-size: `.btn` is sized in em, so the padding scales.
  //
  // Icon-only:
  //   <Button square aria-label="Delete"><IconTrash /></Button>
  //
  // Leading/trailing icons via snippets:
  //   <Button>
  //     {#snippet leading()}<IconPlus />{/snippet}
  //     Add item
  //   </Button>

  import { tone as toTone, cx } from '../../utils.js'

  export let tone      = ''
  export let treatment = ''         // '' | 'outlined' | 'ghost' | 'link' | 'raised'
  export let size      = 'md'       // 'xs' | 'sm' | 'md' | 'lg'
  export let type      = 'button'
  export let disabled  = false
  export let loading   = false
  export let square    = false      // icon-only shape
  export let href      = undefined  // renders as <a> when set
  export let leading   = null       // snippet — icon before label
  export let trailing  = null       // snippet — icon after label
  export let onclick   = undefined

  const t = toTone(tone) || (treatment ? '' : 'primary')

  const sizeMap = { xs: 'var(--text-xs)', sm: 'var(--text-sm)', md: '', lg: 'var(--text-lg)' }
  const fontSize = sizeMap[size] ?? ''

  const isSquare = square

  // A submit button inside <Form> reports the form's state without being told.
  // Scoped to type="submit" on purpose: that is the button the submission
  // belongs to, and a "Cancel" beside it must stay live while the save runs.
  //
  // Absent form → undefined → unchanged behavior standing alone.
  const form      = $context.form
  const isLoading = loading || (type === 'submit' && !!form?.submitting)
  // A form the caller has disabled disables every button under it, including
  // the way out — that is the caller saying the whole form is off, which is a
  // different statement from "a save is running".
  const isOff     = disabled || !!form?.disabled || (type === 'submit' && !!form?.committed)

  function handleClick(e) {
    if (!isLoading) onclick?.(e)
  }
</script>

{#if href && !isOff}
  <!-- No role="button" on an <a>: it navigates, and telling a screen reader
       otherwise breaks the user's expectation of where it will go. -->
  <a
    href={href}
    class={cx('btn', t, treatment, isSquare && 'square')}
    style:font-size={fontSize || null}
    aria-busy={isLoading || null}
    {class}
    {...$attributes}
  >
    {#if leading}{@render leading?.()}{/if}
      <slot />
    {#if trailing}{@render trailing?.()}{/if}
  </a>
{:else}
  <!--
    `disabled` while loading, not just pointer-events — a pointer-events-only
    guard still allows keyboard activation. aria-busy both announces it and
    draws the spinner.
  -->
  <button
    type={type}
    disabled={isOff || isLoading}
    aria-busy={isLoading || null}
    class={cx('btn', t, treatment, isSquare && 'square')}
    style:font-size={fontSize || null}
    {class}
    {...$attributes}
    onclick={handleClick}
  >
    {#if leading}{@render leading?.()}{/if}
    <slot />
    {#if trailing}{@render trailing?.()}{/if}
  </button>
{/if}
