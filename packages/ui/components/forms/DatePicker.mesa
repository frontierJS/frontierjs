<script module>
  // ── Pure utilities ──────────────────────────────────────────────────────────

  /**
   * Generate a 6-week calendar grid for a given month.
   * Returns number[][] — 0 means empty cell (previous/next month overflow).
   * Ported from github.com/lukeed/calendarize
   */
  export function calendarize(target, offset = 0) {
    const out   = []
    const date  = new Date(target || new Date())
    const year  = date.getFullYear()
    const month = date.getMonth()
    const days  = new Date(year, month + 1, 0).getDate()

    let first = new Date(year, month, 1 - (offset | 0)).getDay()
    let i = 0

    while (i < days) {
      const week = Array(7)
      for (let j = 0; j < 7; ) {
        while (j < first) week[j++] = 0
        week[j++] = ++i > days ? 0 : i
        first = 0
      }
      out.push(week)
    }
    return out
  }

  /**
   * Returns the last millisecond of the given day.
   * Replaces: Date.Relative.date({ timestamp, day: (d) => d + 1 }).getTime() - 1
   */
  export function makeEndInclusive(timestamp) {
    const d = new Date(timestamp)
    d.setDate(d.getDate() + 1)
    d.setHours(0, 0, 0, 0)
    return d.getTime() - 1
  }

  /** Format a Date as YYYY-MM-DD (local time). */
  export function formatYMD(date) {
    const y = date.getFullYear()
    const m = String(date.getMonth() + 1).padStart(2, '0')
    const d = String(date.getDate()).padStart(2, '0')
    return `${y}-${m}-${d}`
  }
</script>

<script>
  // DatePicker.mesa
  //
  // ITEM SHAPE for presetRanges:
  //   { value: string, text: string, start?: number, end?: number }
  //   `start` and `end` are timestamps. If present, clicking the preset applies them directly.
  //   `value` is passed to `onPresetSelect(value)` if you want to compute ranges externally.
  //
  // USAGE — single date:
  //   <DatePicker bind:startDate={date} />
  //
  // USAGE — range:
  //   <DatePicker isRange bind:startDate bind:endDate onDateChange={handleChange} />
  //
  // USAGE — with presets:
  //   <DatePicker isRange showPresets presetRanges={MY_RANGES} />
  //
  // USAGE — inline (always visible):
  //   <DatePicker alwaysShow isOpen />
  //
  // USAGE — inside a <Form>, where the label and `required` are schema facts:
  //   <DatePicker name="dueOn" bind:startDate={dueOn} />
  //
  // `bind:` takes a writable top-level `let` in the caller — a field of a
  // record (`bind:startDate={record.dueOn}`) is a compile error, not a
  // binding.
  //
  // A `Date` column is not routed here by the generated form: Sierra's table
  // answers `input type="date"`, which round-trips a zoneless date with no JS
  // at all. This is the control an app CHOOSES — a range, presets, two panes —
  // and choosing it should not cost the schema wiring every other control has.

  import Field from './Field.mesa'
  import { resolveError, resolveRule, stated } from '../../utils.js'

  // ── Props ───────────────────────────────────────────────────────────────────

  export let startDate        = undefined
  export let endDate          = undefined
  export let startDateTime    = '08:00'
  export let endDateTime      = '08:00'
  export let isRange          = false
  export let isOpen           = false
  export let inclusiveEnd     = true
  export let isMultipane      = false
  export let align            = 'left'    // 'left' | 'right'
  export let theme            = ''
  export let disabledDates    = []        // string[] — 'YYYY-MM-DD' or 'YYYY-MM-DD:YYYY-MM-DD' ranges
  export let enabledDates     = []        // string[] — same format; if set, only these are clickable
  export let alwaysShow       = false
  export let showYearControls = true
  export let showPresets      = false
  export let showPresetsOnly  = false
  export let showTimePicker   = false
  export let enableFutureDates = false
  export let enablePastDates   = true
  export let presetRanges     = []        // { value, text, start?, end? }[]

  export let startOfWeek      = 0         // 0=Sun, 1=Mon, …
  export let dowLabels        = ['Su', 'Mo', 'Tu', 'We', 'Th', 'Fr', 'Sa']
  export let monthLabels      = ['January','February','March','April','May','June',
                                  'July','August','September','October','November','December']

  // Field integration — the picker draws buttons, so without these it was the
  // one control in this folder that a <Form> could not label, could not mark
  // required, and could not show a server rejection on.
  export let name     = ''
  // `undefined` is "not stated" and `''` is "no label, deliberately". They have
  // to be different values: a default of '' makes the two indistinguishable, so
  // the documented suppression below cannot be expressed at all.
  export let label    = undefined
  export let hint     = ''
  export let error    = ''
  export let errors   = undefined
  export let required = undefined

  // Callback props
  export let onDateChange       = undefined  // ({ startDate, endDate?, rangeDates? }) => void
  export let onDayClick         = undefined  // (event) => void
  export let onNavigationChange = undefined  // ({ direction, type, currentPeriod, isPastPeriod }) => void

  // Default "today" can be overridden (e.g. for testing, timezones)
  export let today = (() => { const d = new Date(); d.setHours(0,0,0,0); return d })()

  // ── Pure date helpers (replace Date.Relative) ───────────────────────────────

  /** Normalize any date/timestamp to midnight (local time). */
  function toMidnight(d = new Date()) {
    const r = new Date(typeof d === 'number' ? d : d)
    r.setHours(0, 0, 0, 0)
    return r.getTime()
  }

  function normalizeTimestamp(ts) {
    if (!ts) return undefined
    return toMidnight(ts)
  }

  function getTimestamp(d) {
    return new Date(d).getTime()
  }

  /**
   * Create a timestamp for year/month/day at midnight.
   */
  function createTimestamp(year, month, day) {
    return toMidnight(new Date(year, month, day))
  }

  /**
   * Apply a HH:mm time string to a timestamp.
   * Replaces: Date.Relative.date({timestamp, time: '...'}).getTime()
   */
  function updateTime(time, timestamp) {
    if (!timestamp) return undefined
    const d = new Date(timestamp)
    if (showTimePicker && time) {
      const [h, m] = time.split(':').map(Number)
      d.setHours(h, m, 0, 0)
    } else {
      d.setHours(0, 0, 0, 0)
    }
    return d.getTime()
  }

  /**
   * What this picker currently holds, in the shape every caller receives.
   *
   * One builder because there are three ways to change the value — a day, a
   * preset, and the time inputs — and the third used to move `startDate`
   * without announcing anything. A caller reading `bind:startDate` saw 14:30
   * while `onDateChange` had said 08:00, so which of the two an app happened to
   * read decided whether it saved the right time.
   */
  function currentEvent(start = _startDate, end = _endDate) {
    return {
      startDate: start,
      startDateTime,
      ...(isRange && {
        endDate: end,
        endDateTime,
        rangeDates: getDatesInRange(start, end),
      }),
    }
  }

  /**
   * A time input moved the value: write it, then say so.
   *
   * The new timestamps are passed in rather than read back off `_startDate`.
   * A write to a reactive binding is not visible to a read in the same tick,
   * so announcing from the signal reported the value as it was BEFORE the edit
   * — which is how the binding and the callback came to disagree in the first
   * place, one of them still holding 08:00.
   */
  function announceTime(start, end) {
    if ((isRange && start && end) || (!isRange && start)) {
      onDateChange?.(currentEvent(start, end))
    }
  }

  function getHoursAndMinutes(timestamp) {
    if (!timestamp) return '00:00'
    const d   = new Date(timestamp)
    const hh  = String(d.getHours()).padStart(2, '0')
    const mm  = String(d.getMinutes()).padStart(2, '0')
    return `${hh}:${mm}`
  }

  /** Expand disabledDates / enabledDates string arrays into timestamp arrays. */
  /**
   * Parse a bare YYYY-MM-DD as a LOCAL date.
   *
   * `new Date('2026-01-22')` is UTC midnight by specification, and every other
   * date in this component is a local midnight from `createTimestamp` — so
   * west of Greenwich the two disagree by a day and `disabledDates` disabled
   * the day before the one it named. Anything carrying a time is left to the
   * platform parser, which is the case where an offset was actually stated.
   */
  function parseLocalDate(value) {
    const ymd = /^(\d{4})-(\d{2})-(\d{2})$/.exec(String(value).trim())
    return ymd ? new Date(+ymd[1], +ymd[2] - 1, +ymd[3]) : new Date(value)
  }

  function getDatesFromArray(collection) {
    return collection.reduce((acc, entry) => {
      if (typeof entry !== 'string') return acc
      if (entry.includes(':')) {
        const [a, b] = entry.split(':').map(parseLocalDate)
        const cur = new Date(a)
        while (cur <= b) {
          acc.push(normalizeTimestamp(cur.getTime()))
          cur.setDate(cur.getDate() + 1)
        }
      } else {
        acc.push(normalizeTimestamp(parseLocalDate(entry).getTime()))
      }
      return acc
    }, [])
  }

  function getDatesInRange(start, end) {
    if (!start || !end) return []
    const cur  = toMidnight(start)
    const stop = toMidnight(end)
    const out  = []
    const d    = new Date(cur)
    while (d.getTime() <= stop) {
      const s = formatYMD(d)
      if ((!enabled.length && !disabled.length) ||
          (enabled.length && enabled.includes(normalizeTimestamp(d.getTime()))) ||
          !disabled.includes(normalizeTimestamp(d.getTime()))) {
        out.push(s)
      }
      d.setDate(d.getDate() + 1)
    }
    return out
  }

  // ── Internal mutable state ──────────────────────────────────────────────────

  // Normalize incoming prop dates to timestamps
  // We keep _startDate/_endDate as internal normalized signals
  // so external props can be Date objects, strings, or timestamps
  let _startDate = startDate ? getTimestamp(startDate) : null
  let _endDate   = endDate   ? getTimestamp(endDate)   : null

  // Sync external props → internal state
  $: startDate, () => { _startDate = startDate ? getTimestamp(startDate) : null }
  $: endDate,   () => { _endDate   = endDate   ? getTimestamp(endDate)   : null }

  // ── Form context ────────────────────────────────────────────────────────────
  //
  // The enclosing <Form> and this field's rule, both undefined standing alone.
  const form = $context.form
  const rule = resolveRule(form, name)

  // The label is NOT resolved here — Field reads the same rule off the same
  // form and resolves it once. Two components resolving one fact from one
  // source is how they drift.
  const resolvedRequired = stated(required, rule?.required)
  const displayError     = resolveError(form, name, error, errors)

  // What the hidden input carries. A date with no zone, matching what
  // `<input type="date">` submits for the same column — the picker works in
  // local midnight timestamps and `formatYMD` is the local-time formatter, so
  // this is the day the reader clicked and not the day it is in UTC.
  const formValue = _startDate ? formatYMD(new Date(_startDate)) : ''

  // Calendar navigation
  let startDateYear  = today.getFullYear()
  let startDateMonth = today.getMonth()

  // Hover preview for range selection
  let tempEndDate = null

  // Revert buffers — save before range in-progress to restore on click outside
  var prevStartDate = null
  var prevEndDate   = null

  // Time picker initialization flag
  var initialize = false

  // Click-outside handler reference
  var _clickOutsideHandler = null

  // Wrapper element reference
  let wrapperEl

  // ── Derived state ───────────────────────────────────────────────────────────

  // Today parts — derive from `today` prop
  const todayStr   = formatYMD(today)
  const _todayParts = todayStr.split('-').map(Number)
  const todayYear  = _todayParts[0]
  const todayMonth = _todayParts[1] - 1   // 0-indexed
  const todayDay   = _todayParts[2]

  // Calendar grids — auto-recompute when month/year navigation changes
  const prev             = calendarize(new Date(startDateYear, startDateMonth - 1), startOfWeek)
  const startDateCalendar = calendarize(new Date(startDateYear, startDateMonth), startOfWeek)
  const next             = calendarize(new Date(startDateYear, startDateMonth + 1), startOfWeek)

  const endDateMonth    = startDateMonth === 11 ? 0 : startDateMonth + 1
  const endDateYear     = endDateMonth   === 0  ? startDateYear + 1 : startDateYear
  const endDateCalendar = calendarize(new Date(endDateYear, endDateMonth), startOfWeek)

  // Disabled / enabled lookup sets — recompute when prop arrays change
  const disabled = getDatesFromArray(disabledDates)
  const enabled  = getDatesFromArray(enabledDates)

  // ── Watchers ─────────────────────────────────────────────────────────────

  // When isRange turns off, clear end date
  $: isRange, () => { if (!isRange) _endDate = null }

  // Reset calendar view to selected date when picker opens
  $: isOpen, () => {
    if (isOpen && ((!isRange && _startDate) || (isRange && _startDate && _endDate))) {
      const d    = new Date(_startDate)
      startDateYear  = d.getFullYear()
      startDateMonth = d.getMonth()
    }
  }

  // Reset to defaultYear/defaultMonth when both dates are cleared
  $: (_startDate, _endDate), () => {
    if (!_startDate && !_endDate) {
      startDateYear  = today.getFullYear()
      startDateMonth = today.getMonth()
    }
  }

  // Initialize time picker fields once when enabled
  $: showTimePicker, () => {
    if (showTimePicker && !initialize) {
      startDateTime = getHoursAndMinutes(_startDate)
      endDateTime   = getHoursAndMinutes(_endDate)
      initialize    = true
    }
  }

  // ── Click-outside ───────────────────────────────────────────────────────────

  function onClickOutside() {
    if (alwaysShow) return
    if (prevStartDate && prevEndDate && _startDate && !_endDate) {
      _startDate    = prevStartDate
      _endDate      = prevEndDate
      startDate     = _startDate
      endDate       = _endDate
      prevStartDate = null
      prevEndDate   = null
    }
    isOpen = false
  }

  $.onMount(() => {
    _clickOutsideHandler = ({ target }) => {
      if (wrapperEl && !wrapperEl.contains(target)) onClickOutside()
    }
    document.addEventListener('click', _clickOutsideHandler, { passive: true, capture: true })
  })

  $.onDestroy(() => {
    if (_clickOutsideHandler) {
      document.removeEventListener('click', _clickOutsideHandler, { capture: true })
    }
  })

  // ── Navigation ──────────────────────────────────────────────────────────────

  function buildCurrentPeriod() {
    const calendar = isMultipane ? endDateCalendar : startDateCalendar
    const lastWeek = calendar[calendar.length - 1].filter(Boolean)
    const lastDay  = lastWeek[lastWeek.length - 1]
    let   m        = startDateMonth + 1

    const pad = n => String(n).padStart(2, '0')
    return {
      start: `${startDateYear}-${pad(m)}-01`,
      end:   isMultipane
        ? `${endDateYear}-${pad(endDateMonth + 1)}-${lastDay}`
        : `${startDateYear}-${pad(m)}-${lastDay}`,
    }
  }

  function emitNavigation(direction, type) {
    if (!onNavigationChange) return
    const initial = new Date(today.getFullYear(), today.getMonth())
    const current = isMultipane
      ? new Date(endDateYear, endDateMonth)
      : new Date(startDateYear, startDateMonth)
    onNavigationChange({
      direction,
      type,
      currentPeriod: buildCurrentPeriod(),
      isPastPeriod: current < initial,
    })
  }

  function toPrev() {
    if (--startDateMonth < 0) { startDateMonth = 11; startDateYear-- }
    emitNavigation('previous', 'month')
  }

  function toNext() {
    if (++startDateMonth > 11) { startDateMonth = 0; startDateYear++ }
    emitNavigation('next', 'month')
  }

  function toPrevYear() { startDateYear--;  emitNavigation('previous', 'year') }
  function toNextYear() { startDateYear++;  emitNavigation('next', 'year')     }

  // ── Day classification helpers ──────────────────────────────────────────────

  function isToday(day, month, year) {
    return today && todayMonth === month && todayDay === day && todayYear === year
  }

  function isDateInRange(start, end, selected) {
    const s = normalizeTimestamp(start)
    const e = normalizeTimestamp(end)
    const c = normalizeTimestamp(selected)
    return c >= s && c <= e
  }

  function inRange(day, month, year) {
    const ts = createTimestamp(year, month, day)
    if (normalizeTimestamp(_startDate) === ts) return true
    return isRange
      ? isDateInRange(_startDate, _endDate, ts)
      : normalizeTimestamp(_startDate) === ts
  }

  function isFirstInRange(day, month, year) {
    const cur      = createTimestamp(year, month, day)
    const startCmp = normalizeTimestamp(_startDate)
    const tempCmp  = normalizeTimestamp(tempEndDate)
    const curCmp   = normalizeTimestamp(cur)

    if ((!isRange && startCmp) || (isRange && !_endDate && tempEndDate)) {
      return startCmp === curCmp
    }
    return isRange ? startCmp === curCmp : tempCmp === curCmp
  }

  function isLastInRange(day, month, year) {
    const cur      = createTimestamp(year, month, day)
    const endCmp   = normalizeTimestamp(_endDate)
    const startCmp = normalizeTimestamp(_startDate)
    const curCmp   = normalizeTimestamp(cur)
    const tempCmp  = normalizeTimestamp(tempEndDate)

    if (isRange && _startDate && !_endDate && tempEndDate) {
      return tempCmp === startCmp
    }
    return isRange ? endCmp === curCmp : startCmp === curCmp
  }

  function isDisabledDay(day, month, year) {
    const ts = createTimestamp(year, month, day)
    if (!enabled.length && !disabled.length) return false
    if (enabled.length && !enabled.includes(ts)) return true
    if (disabled.length && disabled.includes(ts)) return true
    return false
  }

  function isFutureDate(day, month, year) {
    if (enableFutureDates) return false
    return normalizeTimestamp(new Date()) < createTimestamp(year, month, day)
  }

  function isPastDate(day, month, year) {
    if (enablePastDates) return false
    return normalizeTimestamp(new Date()) > createTimestamp(year, month, day)
  }

  function isFirstDayOfMonth(day) { return day === 1 }

  function isLastDayOfMonth(day, calendar) {
    return day === Math.max(...calendar.flat(10))
  }

  function inRangeHover(day, month, year) {
    if (!isRange || _endDate || !_startDate || !tempEndDate) return false
    const ts       = createTimestamp(year, month, day)
    const startCmp = normalizeTimestamp(_startDate)
    const tempCmp  = normalizeTimestamp(tempEndDate)
    const curCmp   = normalizeTimestamp(ts)
    const min = Math.min(startCmp, tempCmp)
    const max = Math.max(startCmp, tempCmp)
    return curCmp >= min && curCmp <= max
  }

  function checkActive(start1, start2, end1, end2) {
    if (!start1 || !end1) return false
    return normalizeTimestamp(start1) === normalizeTimestamp(start2) &&
           normalizeTimestamp(end1)   === normalizeTimestamp(end2)
  }

  // ── Day interaction ─────────────────────────────────────────────────────────

  function handleSingleDate(timestamp) {
    _startDate = updateTime(startDateTime, timestamp)
    startDate  = _startDate
    if (!alwaysShow) isOpen = false
  }

  function handleDateRange(timestamp) {
    if (_startDate === null || (_startDate !== null && _endDate !== null)) {
      _startDate = updateTime(startDateTime, timestamp)
      _endDate   = null
      startDate  = _startDate
      endDate    = null
    } else {
      const rawEnd = updateTime(endDateTime, timestamp)
      _endDate = (inclusiveEnd && !showTimePicker) ? makeEndInclusive(rawEnd) : rawEnd
      // Picking backwards is ordinary: the second click may be before the first.
      if (_startDate > _endDate) [_startDate, _endDate] = [_endDate, _startDate]
      startDate = _startDate
      endDate   = _endDate
      if (!alwaysShow) isOpen = false
    }
  }

  function onClick(e, day, month, year) {
    const btn     = e.target?.closest('.fjs-dp-day')
    const classes = btn?.className ?? ''
    if (classes.includes('future') || classes.includes('past') || classes.includes('disabled')) {
      e.preventDefault()
      return
    }

    const timestamp = createTimestamp(year, month, day)

    if (isRange) {
      prevStartDate = _startDate
      prevEndDate   = _endDate
      handleDateRange(timestamp)
    } else {
      handleSingleDate(timestamp)
    }

    const event = currentEvent()

    onDayClick?.(event)
    if ((isRange && _startDate && _endDate) || (!isRange && _startDate)) {
      onDateChange?.(event)
    }
  }

  function onMouseEnter(e, day, month, year) {
    if (_startDate && _endDate) { tempEndDate = null; return }
    const classes = e.target?.className ?? ''
    if (classes.includes('future') || classes.includes('past') || classes.includes('disabled')) return
    tempEndDate = createTimestamp(year, month, day)
  }

  function onMouseLeave() {
    if (_startDate && _endDate) { tempEndDate = null; return }
    tempEndDate = normalizeTimestamp(_startDate)
  }

  // ── Presets ─────────────────────────────────────────────────────────────────

  function onPresetClick(option) {
    if (!option.start || !option.end) return
    _startDate = normalizeTimestamp(new Date(option.start).getTime())
    _endDate   = inclusiveEnd ? makeEndInclusive(option.end) : normalizeTimestamp(option.end)
    startDate  = _startDate
    endDate    = _endDate

    if (isRange && _startDate && _endDate) {
      onDateChange?.({
        startDate: _startDate,
        startDateTime,
        endDate: _endDate,
        endDateTime,
        rangeDates: getDatesInRange(_startDate, _endDate),
      })
    }
    if (!alwaysShow) isOpen = false
  }

  // Normalize startOfWeek if passed as string
  if (typeof startOfWeek === 'string') startOfWeek = parseInt(startOfWeek, 10)
</script>

<!--
  The four nav arrows. They were base64 PNGs — black pixels, so they were
  invisible against a dark theme and could not follow a tone; `currentColor`
  is the whole reason these are inline.
-->
{#snippet chevronStart()}
  <svg viewBox="0 0 20 20" fill="currentColor" aria-hidden="true" width="16" height="16">
    <path d="M11.78 5.22a.75.75 0 0 1 0 1.06L8.06 10l3.72 3.72a.75.75 0 1 1-1.06 1.06l-4.25-4.25a.75.75 0 0 1 0-1.06l4.25-4.25a.75.75 0 0 1 1.06 0Z"/>
  </svg>
{/snippet}

{#snippet chevronEnd()}
  <svg viewBox="0 0 20 20" fill="currentColor" aria-hidden="true" width="16" height="16">
    <path d="M8.22 5.22a.75.75 0 0 1 1.06 0l4.25 4.25a.75.75 0 0 1 0 1.06l-4.25 4.25a.75.75 0 0 1-1.06-1.06L11.94 10 8.22 6.28a.75.75 0 0 1 0-1.06Z"/>
  </svg>
{/snippet}

{#snippet chevronUp()}
  <svg viewBox="0 0 20 20" fill="currentColor" aria-hidden="true" width="12" height="12">
    <path d="M14.78 12.78a.75.75 0 0 1-1.06 0L10 9.06l-3.72 3.72a.75.75 0 1 1-1.06-1.06l4.25-4.25a.75.75 0 0 1 1.06 0l4.25 4.25a.75.75 0 0 1 0 1.06Z"/>
  </svg>
{/snippet}

{#snippet chevronDown()}
  <svg viewBox="0 0 20 20" fill="currentColor" aria-hidden="true" width="12" height="12">
    <path d="M5.22 8.22a.75.75 0 0 1 1.06 0L10 11.94l3.72-3.72a.75.75 0 1 1 1.06 1.06l-4.25 4.25a.75.75 0 0 1-1.06 0L5.22 9.28a.75.75 0 0 1 0-1.06Z"/>
  </svg>
{/snippet}

<!--
  The picker itself, in a snippet so it can be wrapped in a <Field> or not.
  Its body keeps its own indentation rather than being pushed a level in — a
  200-line whitespace diff would bury the change that actually happened.

  The caller's attributes land on the wrapper: this component has no control of
  its own — the trigger is whatever the caller puts in the slot.
-->
{#snippet picker()}
<div
  bind:this={wrapperEl}
  class="fjs-dp"
  data-picker-theme={theme}
  aria-invalid={displayError ? 'true' : null}
  {...$attributes}
>
  <!-- Trigger slot — whatever the parent puts inside the component -->
  <slot />

  <div
    class="fjs-dp-panel"
    class:right={align === 'right'}
    class:range={isRange && isMultipane}
    class:presets={isRange && showPresets}
    class:show={isOpen}
  >
    <!-- ── Preset sidebar ── -->
    {#if isRange && showPresets}
      <div class="fjs-dp-presets" class:presets-only={showPresetsOnly}>
        {#each presetRanges as option (option.value)}
          <button
            type="button"
            class:active={checkActive(_startDate, option.start, _endDate, option.end)}
            on:click|preventDefault={() => onPresetClick(option)}
          >
            {option.text}
          </button>
        {/each}
      </div>
    {/if}

    <!-- ── Primary calendar ── -->
    <div class="fjs-dp-cal" class:presets-only={isRange && showPresetsOnly}>
      <header class:timepicker={showTimePicker}>
        <button
          type="button"
          aria-label="Previous month"
          on:click|preventDefault={toPrev}
        >
          {@render chevronStart()}
        </button>

        <span>
          <div>{monthLabels[startDateMonth]} {startDateYear}</div>
          {#if showYearControls}
            <div class="fjs-dp-years">
              <button type="button" aria-label="Next year"     on:click|preventDefault={toNextYear}>{@render chevronUp()}</button>
              <button type="button" aria-label="Previous year" on:click|preventDefault={toPrevYear}>{@render chevronDown()}</button>
            </div>
          {/if}
        </span>

        <button
          type="button"
          aria-label="Next month"
          class:hide={isRange && isMultipane}
          on:click|preventDefault={toNext}
        >
          {@render chevronEnd()}
        </button>
      </header>

      {#if showTimePicker}
        <div class="fjs-dp-time" class:show={isRange && !isMultipane}>
          <input
            type="time"
            bind:value={startDateTime}
            on:input={() => { const ts = updateTime(startDateTime, _startDate); _startDate = startDate = ts; announceTime(ts, _endDate) }}
          />
          {#if isRange}
            <input
              type="time"
              class="fjs-dp-endtime"
              bind:value={endDateTime}
              on:input={() => { const ts = updateTime(endDateTime, _endDate); _endDate = endDate = ts; announceTime(_startDate, ts) }}
            />
          {/if}
        </div>
      {/if}

      <!-- Day-of-week headers -->
      <div class="fjs-dp-grid">
        {#each dowLabels as _, labelIndex (labelIndex)}
          <span class="fjs-dp-dow">{dowLabels[(labelIndex + startOfWeek) % 7]}</span>
        {/each}

        <!--
          Iterate the weeks the month actually has. A fixed `{#each {length: 6}}`
          over a guard reads `calendar[week][day]` from inside the guarded
          block, and on navigation the inner reads recompute before the outer
          guard tears the row down — so moving from a 5-row month to a 4-row one
          threw `Cannot read properties of undefined`, in a handler, where it
          surfaces as a calendar that stops responding.
        -->
        {#each startDateCalendar as week, weekIndex (weekIndex)}
          {#if week}
            {#each week as cell, dayIndex (dayIndex)}
              {#if cell !== 0}
                {@const day = cell}
                <button
                  type="button"
                  class="fjs-dp-day"
                  class:today={isToday(day, startDateMonth, startDateYear)}
                  class:start={isFirstInRange(day, startDateMonth, startDateYear)}
                  class:end={isLastInRange(day, startDateMonth, startDateYear)}
                  class:range={inRange(day, startDateMonth, startDateYear)}
                  class:rangehover={inRangeHover(day, startDateMonth, startDateYear)}
                  class:past={isPastDate(day, startDateMonth, startDateYear)}
                  class:future={isFutureDate(day, startDateMonth, startDateYear)}
                  class:first={isFirstDayOfMonth(day)}
                  class:last={isLastDayOfMonth(day, startDateCalendar)}
                  class:disabled={isDisabledDay(day, startDateMonth, startDateYear)}
                  class:norange={isRange && tempEndDate === _startDate}
                  on:mouseenter={(e) => onMouseEnter(e, day, startDateMonth, startDateYear)}
                  on:mouseleave={onMouseLeave}
                  on:click|preventDefault={(e) => onClick(e, day, startDateMonth, startDateYear)}
                >
                  <span class="chip fjs-dp-square">{day}</span>
                </button>
              {:else}
                <div class="fjs-dp-day other">&nbsp;</div>
              {/if}
            {/each}
          {/if}
        {/each}
      </div>
    </div>

    <!-- ── Second pane (multipane range) ── -->
    {#if isRange && isMultipane}
      <div class="fjs-dp-cal" class:presets-only={showPresetsOnly}>
        <header class:timepicker={showTimePicker}>
          <button
            type="button"
            aria-label="Previous month"
            class:hide={true}
            on:click|preventDefault={toPrev}
          >
            {@render chevronStart()}
          </button>

          <span>
            <div>{monthLabels[endDateMonth]} {endDateYear}</div>
            {#if showYearControls}
              <div class="fjs-dp-years">
                <button type="button" aria-label="Next year"     on:click|preventDefault={toNextYear}>{@render chevronUp()}</button>
                <button type="button" aria-label="Previous year" on:click|preventDefault={toPrevYear}>{@render chevronDown()}</button>
              </div>
            {/if}
          </span>

          <button type="button" aria-label="Next month" on:click|preventDefault={toNext}>
            {@render chevronEnd()}
          </button>
        </header>

        {#if showTimePicker}
          <div class="fjs-dp-time">
            <input
              type="time"
              bind:value={endDateTime}
              on:input={() => { const ts = updateTime(endDateTime, _endDate); _endDate = endDate = ts; announceTime(_startDate, ts) }}
            />
          </div>
        {/if}

        <div class="fjs-dp-grid">
          {#each dowLabels as _, labelIndex (labelIndex)}
            <span class="fjs-dp-dow">{dowLabels[(labelIndex + startOfWeek) % 7]}</span>
          {/each}

          <!-- Same rule as the primary pane: iterate the real weeks. -->
          {#each endDateCalendar as week, weekIndex (weekIndex)}
            {#if week}
              {#each week as cell, dayIndex (dayIndex)}
                {#if cell !== 0}
                  {@const day = cell}
                  <button
                    type="button"
                    class="fjs-dp-day"
                    class:today={isToday(day, endDateMonth, endDateYear)}
                    class:range={inRange(day, endDateMonth, endDateYear)}
                    class:rangehover={inRangeHover(day, endDateMonth, endDateYear)}
                    class:start={isFirstInRange(day, endDateMonth, endDateYear)}
                    class:end={isLastInRange(day, endDateMonth, endDateYear)}
                    class:past={isPastDate(day, endDateMonth, endDateYear)}
                    class:future={isFutureDate(day, endDateMonth, endDateYear)}
                    class:first={isFirstDayOfMonth(day)}
                    class:last={isLastDayOfMonth(day, endDateCalendar)}
                    class:disabled={isDisabledDay(day, endDateMonth, endDateYear)}
                    class:norange={isRange && tempEndDate === _startDate}
                    on:mouseenter={(e) => onMouseEnter(e, day, endDateMonth, endDateYear)}
                    on:mouseleave={onMouseLeave}
                    on:click|preventDefault={(e) => onClick(e, day, endDateMonth, endDateYear)}
                  >
                    <span class="chip fjs-dp-square">{day}</span>
                  </button>
                {:else}
                  <div class="fjs-dp-day other">&nbsp;</div>
                {/if}
              {/each}
            {/if}
          {/each}
        </div>
      </div>
    {/if}
  </div>
</div>
{/snippet}

<!--
  A `name` is enough to wrap, the same rule every other control here follows:
  it is what makes the field resolvable, and a picker inside a <Form> states
  nothing else. `label` goes through unresolved so Field resolves it once off
  the same rule.

  The hidden input is what makes the field EXIST for the form — the picker
  draws buttons, and a button is not a value the form can read or a name its
  dirty tracking can see. Single-date mode only: a range is two values and one
  name, which no column holds.
-->
{#if label || name}
  <Field
    name={name}
    label={label}
    required={resolvedRequired}
    hint={hint}
    error={error}
    errors={errors}
    {class}
  >
    {@render picker()}
    {#if name && !isRange}
      <input type="hidden" name={name} value={formValue} />
    {/if}
  </Field>
{:else}
  {@render picker()}
{/if}

<style>
  /*
   * A calendar is geometry @frontierjs/css has no term for — a seven-column
   * grid of round day cells with a range band bleeding between them — which
   * is why this block exists at all. Everything that is NOT that geometry is
   * read from the package: the type ladder, the space ladder (so `.dense`
   * reaches the whole panel), the radii, the shadow ladder, the rule color,
   * the tones, and the focus ring's own tokens.
   *
   * Four knobs, each one a design token. Override them on any ancestor.
   */
  .fjs-dp {
    --dp-cell:   2.5rem;                  /* one day cell, square */
    --dp-accent: var(--color-primary);    /* the selected day's fill */
    --dp-band:   var(--rule);             /* the in-range band behind the cells */
    --dp-layer:  99;                      /* the panel sits above page content */

    position:    relative;
    font-family: var(--font-primary);
    font-size:   var(--text-md);
  }
  .fjs-dp * { box-sizing: border-box; }

  /*
   * The ring is drawn from the package's tokens rather than restated as a
   * recipe — focus.css opts elements in BY CLASS and cannot name a class this
   * kit invented, so the rule lives here and the look stays the theme's.
   * A day cell is flush against its neighbors, so the ring goes inset.
   */
  .fjs-dp button:focus-visible {
    outline:        var(--ring-width) var(--ring-style, solid)
                    var(--ring-color, var(--ring, var(--color-primary)));
    outline-offset: calc(var(--ring-offset) * -1);
    z-index:        1;
  }

  /* ── Panel ───────────────────────────────────────────────────────────── */

  .fjs-dp-panel {
    display:       none;
    position:      absolute;
    left:          0;
    z-index:       var(--dp-layer);
    width:         fit-content;
    grid-template-columns: 1fr;
    background:    var(--surface-raised);
    color:         var(--ink);
    border:        var(--border-width) solid var(--rule);
    border-radius: var(--card-radius);
    box-shadow:    var(--shadow-lg);
  }
  .fjs-dp-panel.right    { left: auto; right: 0; }
  .fjs-dp-panel.show     { display: grid; top: calc(100% + var(--space-2xs)); }
  .fjs-dp-panel.range    { grid-template-columns: repeat(2, 1fr); }
  .fjs-dp-panel.presets  { grid-template-columns: minmax(11rem, 12.5rem) 1fr 1fr; }
  .fjs-dp-panel.presets:not(.range) { grid-template-columns: minmax(11rem, 12.5rem) 1fr; }

  /* ── Presets ─────────────────────────────────────────────────────────── */

  .fjs-dp-presets {
    display:        none;
    flex-direction: column;
    padding:        var(--space-2xl);
    border-right:   var(--border-width) solid var(--rule);
  }
  .fjs-dp-panel.presets .fjs-dp-presets { display: flex; }
  .fjs-dp-panel.presets .fjs-dp-presets.presets-only { border-right: 0; min-width: 100%; }

  .fjs-dp-presets button {
    appearance:    none;
    background:    transparent;
    border:        0;
    border-radius: var(--pill-radius);
    color:         inherit;
    cursor:        pointer;
    font:          inherit;
    text-align:    left;
    margin:        var(--space-3xs) 0;
    padding:       var(--space-2xs) var(--space-lg);
  }
  .fjs-dp-presets button:hover  { background: var(--surface-sunken); }
  .fjs-dp-presets button.active {
    background:  var(--dp-accent);
    color:       var(--surface);
    cursor:      default;
    font-weight: 500;
  }

  /* ── Calendar ────────────────────────────────────────────────────────── */

  .fjs-dp-cal {
    position: relative;
    padding:  var(--space-lg) var(--space-2xl) var(--space-2xl);
    /*
     * Seven cells and the padding either side. Stated rather than measured so
     * the two panes of a range picker are the same width whatever month each
     * is showing.
     */
    width:    calc((var(--dp-cell) * 7) + (var(--space-2xl) * 2));
  }
  .fjs-dp-cal.presets-only          { display: none; }
  .fjs-dp-cal + .fjs-dp-cal         { border-left: var(--border-width) solid var(--rule); }

  /* ── Header ──────────────────────────────────────────────────────────── */

  .fjs-dp-cal header {
    display:         flex;
    align-items:     center;
    justify-content: space-between;
    gap:             var(--space-sm);
    margin-block-end: var(--space-2xl);
    font-size:       var(--text-lg);
    user-select:     none;
  }
  .fjs-dp-cal header.timepicker { margin-block-end: 0; }

  .fjs-dp-cal header > span {
    display:     flex;
    align-items: center;
    gap:         var(--space-sm);
    font-weight: 500;
  }

  .fjs-dp-cal header button {
    display:         inline-flex;
    align-items:     center;
    justify-content: center;
    appearance:      none;
    background:      transparent;
    border:          0;
    border-radius:   var(--pill-radius);
    color:           inherit;
    cursor:          pointer;
    padding:         var(--space-2xs);
  }
  .fjs-dp-cal header button:hover { background: var(--surface-sunken); }
  .fjs-dp-cal header button.hide  { opacity: 0; }

  .fjs-dp-years {
    display:        flex;
    flex-direction: column;
    align-items:    center;
  }
  .fjs-dp-years button { padding: 0; }

  /* ── Timepicker ──────────────────────────────────────────────────────── */

  .fjs-dp-time {
    display:         flex;
    align-items:     center;
    justify-content: space-around;
    margin-block-end: var(--space-2xl);
  }
  .fjs-dp-time input[type="time"] {
    display:       block;
    margin:        0 auto;
    font:          inherit;
    color:         inherit;
    background:    var(--surface);
    border:        var(--border-width) solid var(--rule);
    border-radius: var(--field-radius);
    padding:       var(--space-2xs) var(--space-sm);
  }
  .fjs-dp-time input[type="time"].fjs-dp-endtime      { display: none; }
  .fjs-dp-time.show input[type="time"].fjs-dp-endtime { display: block; }

  /* ── The grid ────────────────────────────────────────────────────────── */

  .fjs-dp-grid {
    display:               grid;
    grid-template-columns: repeat(7, var(--dp-cell));
    gap:                   0;
    width:                 fit-content;
  }

  .fjs-dp-dow {
    color:            var(--ink-soft);
    font-size:        var(--text-sm);
    font-weight:      500;
    text-align:       center;
    margin-block-end: var(--space-lg);
  }

  /* ── Day cells ───────────────────────────────────────────────────────── */

  /*
   * The button is the grid cell and carries the range band; the `.chip` inside
   * it is the disc. Splitting them is what lets the band run edge to edge
   * between two round cells — a single element cannot be both a circle and a
   * full-width strip.
   */
  .fjs-dp-day {
    appearance: none;
    background: none;
    border:     0;
    margin:     0;
    padding:    0;
    position:   relative;
    text-align: center;
  }

  .fjs-dp-square {
    /*
     * `.chip` on the same element derives --fill and --on-fill from --bg-mix
     * (chip.css), which is how a selected day stays legible against any tone a
     * theme defines. Unset, --bg-mix is invalid and the fallbacks below hold.
     */
    --tone-fill: var(--bg-mix, transparent);

    block-size:    var(--dp-cell);
    inline-size:   var(--dp-cell);
    background:    var(--fill, var(--tone-fill));
    color:         var(--ink);
    border:        var(--border-width) solid transparent;
    border-radius: var(--pill-radius);
    font-size:     var(--text-md);
    cursor:        pointer;
  }

  .fjs-dp-day:not(.other):not(.range):not(.future):not(.past):not(.disabled) .fjs-dp-square:hover {
    background: var(--surface-sunken);
  }
  .fjs-dp-day.disabled .fjs-dp-square,
  .fjs-dp-day.past     .fjs-dp-square,
  .fjs-dp-day.future   .fjs-dp-square {
    color:  var(--ink-mute);
    cursor: default;
  }
  .fjs-dp-day.today .fjs-dp-square {
    border-color: var(--ink-mute);
    font-weight:  700;
  }
  .fjs-dp-day.other {
    border:     0;
    box-shadow: none;
    color:      var(--rule-strong);
  }

  /* ── The range band ──────────────────────────────────────────────────── */

  /*
   * Every bleed below is half a cell, derived — the band has to meet the disc
   * exactly, and a literal drifts the moment --dp-cell is overridden or a
   * theme moves the type scale under it.
   */
  .fjs-dp-day.rangehover .fjs-dp-square,
  .fjs-dp-day.range      .fjs-dp-square {
    background:    var(--dp-band);
    border-color:  transparent;
    border-radius: 0;
    color:         var(--ink);
    cursor:        default;
  }
  .fjs-dp-day.rangehover.start,
  .fjs-dp-day.range.start { box-shadow: inset calc(var(--dp-cell) / -2) 0 0 var(--dp-band); }
  .fjs-dp-day.rangehover.end,
  .fjs-dp-day.range.end   { box-shadow: inset calc(var(--dp-cell) / 2) 0 0 var(--dp-band); }

  .fjs-dp-day.rangehover.start .fjs-dp-square,
  .fjs-dp-day.range.start      .fjs-dp-square,
  .fjs-dp-day.rangehover.end   .fjs-dp-square,
  .fjs-dp-day.range.end        .fjs-dp-square {
    /*
     * `background` is restated because the band rule above already set it and
     * is equally specific — setting only --bg-mix leaves the end of a range
     * painted in the band's color with the text color of a fill, which is
     * low-contrast and looks like a rendering fault rather than a CSS one.
     */
    --bg-mix:      var(--dp-accent);
    background:    var(--fill, var(--tone-fill));
    color:         var(--on-fill, var(--surface));
    border-radius: var(--pill-radius);
    font-weight:   500;
  }

  /* A band that stops at the row's edge is rounded off rather than cut. */
  .fjs-dp-day.rangehover.first .fjs-dp-square,
  .fjs-dp-day.range.first      .fjs-dp-square,
  .fjs-dp-day.rangehover:nth-last-child(7n):not(.start):not(.end) .fjs-dp-square,
  .fjs-dp-day.range:nth-last-child(7n):not(.start):not(.end)      .fjs-dp-square {
    border-start-start-radius: var(--pill-radius);
    border-end-start-radius:   var(--pill-radius);
  }
  .fjs-dp-day.rangehover.last .fjs-dp-square,
  .fjs-dp-day.range.last      .fjs-dp-square,
  .fjs-dp-day.rangehover:nth-child(7n):not(.start):not(.end) .fjs-dp-square,
  .fjs-dp-day.range:nth-child(7n):not(.start):not(.end)      .fjs-dp-square {
    border-start-end-radius: var(--pill-radius);
    border-end-end-radius:   var(--pill-radius);
  }
  .fjs-dp-day.rangehover.start.end,
  .fjs-dp-day.range.start.end { box-shadow: none; }

  /* The hover preview: the same band, drawn while the second end is chosen. */
  .fjs-dp-day:not(.rangehover) + .rangehover:not(.end),
  .fjs-dp-day:not(.rangehover) + .rangehover.start {
    box-shadow: inset calc(var(--dp-cell) / -2) 0 0 var(--dp-band) !important;
  }
  .fjs-dp-day:not(.rangehover) + .rangehover      .fjs-dp-square,
  .fjs-dp-day:not(.rangehover) + .rangehover.start .fjs-dp-square { border-radius: var(--pill-radius); }

  .fjs-dp-day.rangehover:hover { box-shadow: inset calc(var(--dp-cell) / 2) 0 0 var(--dp-band); }
  .fjs-dp-day.rangehover:hover .fjs-dp-square { border-radius: var(--pill-radius); font-weight: 500; }
  .fjs-dp-day.rangehover.first:hover,
  .fjs-dp-day.rangehover.start { box-shadow: inset calc(var(--dp-cell) / -2) 0 0 var(--dp-band); }
  .fjs-dp-day.rangehover:not(.start) + .start,
  .fjs-dp-day.rangehover.end   { box-shadow: inset calc(var(--dp-cell) / 2) 0 0 var(--dp-band); }
  .fjs-dp-day.rangehover:not(.start) + .start .fjs-dp-square { border-radius: var(--pill-radius); }
  .fjs-dp-day.rangehover.start.norange { box-shadow: none !important; }

  /* ── Narrow ──────────────────────────────────────────────────────────── */

  @media only screen and (max-width: 800px) {
    .fjs-dp-panel.show { display: flex; flex-direction: column; }
    .fjs-dp-panel.presets .fjs-dp-presets {
      border-right:  0;
      border-bottom: var(--border-width) solid var(--rule);
    }
    .fjs-dp-time { display: flex; align-items: center; }
    .fjs-dp-time input[type="time"].fjs-dp-endtime { display: block; }
    .fjs-dp-cal + .fjs-dp-cal { display: none; }
    .fjs-dp-cal header button.hide { opacity: 1; }
  }
  @media only screen and (max-width: 600px) {
    .fjs-dp-panel.presets .fjs-dp-presets:not(.presets-only) { display: none; }
  }
</style>
