<script>
  // Form.mesa
  // The form state machine, derived from the schema rather than declared.
  //
  // A form has four jobs beyond holding inputs: know whether it is in flight,
  // know what the server said about each field, know whether anything changed,
  // and not submit twice. Every app writes those four by hand, slightly
  // differently, and the field-error half is the one that gets skipped.
  //
  // Give it a resource and it does all four:
  //
  //   <Form {leads} ondone={r => goto(`/leads/${r.id}`)}>
  //     <Input name="name" />
  //     <Input name="email" />
  //     <Button type="submit">Save</Button>
  //   </Form>
  //
  // Nothing above says what a Lead is. `createResource('leads')` read that from
  // db/schema.lite, so:
  //
  //   • the payload is coerced, blank-stripped and validated before it is sent
  //     (the resource does this — see createResource's header)
  //   • a rejection becomes `errors[field]`, and each <Field> under this form
  //     picks up its own message from context without being handed one
  //   • <Button type="submit"> disables and spins while in flight
  //   • the message clears as the user fixes the field
  //
  // ── Why the error map is not built here ──────────────────────────────
  //
  // A failed write arrives in one of three shapes depending on how far it got
  // and which transport carried it. Unwrapping that is one translation and it
  // has one owner — sierra's `toFieldErrors`, reachable as
  // `resource.fieldErrors(err)`. This component calls it and does not know
  // what a ResourceValidationError is.
  //
  // Without a resource (an `onsubmit` doing something else entirely) there is
  // no unwrapper, and this DELIBERATELY degrades to a form-level message
  // rather than carrying a second copy of the logic. Pass `mapErrors` to
  // supply your own.
  //
  // ── novalidate is on by default ──────────────────────────────────────
  //
  // Kit controls put a real `required` on the input, so the browser refuses to
  // fire submit and shows its own bubble instead — with a message that is not
  // the schema's, in a place the layout did not plan for, and silently, which
  // reads as "the submit handler is broken". The schema owns the messages, so
  // the browser's validation UI is turned off and the constraint attributes
  // stay for assistive tech. `novalidate={false}` restores the native bubbles.

  // ── The generated field list ─────────────────────────────────────────
  //
  //   <Form {leads} />                        every writable column, in schema order
  //   <Form {leads} only={['name','email']} />
  //   <Form {leads} except={['internalRef']} />
  //
  // A field list typed into a page is the last thing a form still restates
  // about a model, and it drifts the way every duplicated list does: a column
  // added to `.lite` simply does not appear, and nothing says so.
  //
  // The mapping from a field to a control is NOT here. It lives in Sierra's
  // `field-rules.js` and this component asks the resource for it
  // (`resource.formFields()`), because this package peers only on mesa and css
  // — a form that had to import Sierra to know what a `Float` is would invert
  // the dependency — and because a hand-written form and a generated one have
  // to agree, which one table is the only way to guarantee.
  //
  // Which COMPONENT a control name renders as is `FormField.mesa`'s, over the
  // registry in `@frontierjs/ui/controls`. Both halves are registrable, so a
  // column type this kit has never heard of is two lines in an app rather than
  // a fork of either package.
  //
  // Children win. Passing any means the caller is writing the form, and the
  // generated list is not rendered unless `auto` says so explicitly; `auto`
  // with children renders the generated fields FIRST and the children after,
  // which is how you add one control the schema cannot describe.

  import Alert     from '../feedback/Alert.mesa'
  import FormField from './FormField.mesa'
  import { cx } from '../../utils.js'

  // The resource this form writes through. Optional only when `onsubmit` is
  // given — one of the two must be present.
  export let resource = undefined

  // The record being edited. Bindable. Defaults to a schema-seeded blank, so
  // `<Form {resource}>` with no record is a working create form.
  export let record = undefined

  // 'auto' picks create or patch from whether the record already has an id,
  // which is what upsert already does. Name one to force it.
  export let method = 'auto'          // 'auto' | 'create' | 'patch' | 'upsert'

  // Escape hatches — narrow on purpose. `onsubmit` replaces the request and
  // nothing else: the in-flight state, the error mapping and the dirty
  // tracking still apply. `mapErrors` replaces only the unwrapping.
  export let onsubmit  = undefined    // async (record) => result
  export let mapErrors = undefined    // (err) => { fields, message }

  export let ondone  = undefined      // (result, record) => void
  export let onerror = undefined      // (err) => void
  export let onready = undefined      // (api) => void — see § The imperative API

  // Generate the field list from the schema. Default: generate when the caller
  // passed no children. State it to force either way.
  export let auto   = undefined       // boolean
  export let only   = undefined       // string[] — narrows AND orders
  export let except = undefined       // string[] — removes

  // The buttons under the form. Two spellings because two protocols reach a
  // component and the rest of this kit uses the other one: every other
  // container here (Card, Table, EmptyState, SectionHeader) takes its trailing
  // content as a snippet prop, so a caller who wrote `{#snippet actions()}`
  // over a form got no buttons and no complaint. `slot="actions"` is what the
  // apps in this repo already write and it keeps working; a snippet wins where
  // both are given, because a prop is the more specific statement.
  export let actions = null           // snippet

  export let disabled    = false
  export let resetOnDone = false      // clear back to the pristine record on success
  export let novalidate  = true       // see the note above
  export let showError   = true       // render the form-level Alert
  export let errorTitle  = ''         // heading for that Alert

  // When a field is first allowed to complain. See § Live validation below.
  //   'blur'   — on leaving a field the user has typed in (default)
  //   'input'  — as soon as it is typed in
  //   'submit' — only when the form is submitted
  export let validateOn = 'blur'

  // ── State — exported so a caller can bind: any of it ────────────────
  export let errors    = {}           // { [field]: message } — replaced, never mutated
  export let formError = ''           // the failure no field can render
  export let submitting = false
  export let dirty      = false
  export let submitted  = false       // a submit has been attempted

  const idField = resource?.context?.idField ?? 'id'

  // A blank seeded from the schema when the caller did not supply a record.
  // Not a default value on the prop: `record` is bindable, and a default would
  // re-seed it every time the prop re-derived.
  //
  // The seed is held in a local as well, and `pristine` below is taken from
  // THAT rather than by reading `record` back. Writing a prop and reading it
  // again in the same setup pass does not see the write, so the baseline was
  // `{...undefined}` — an empty object — on every form the caller did not hand
  // a record. `reset()` then set every field to `undefined` instead of to the
  // seeded blank, which no control can render as "empty".
  const seed = record === undefined ? (resource?.make?.() ?? {}) : record
  if (record === undefined) record = seed

  // A parent that re-pushes its props sends `record: undefined` a second time —
  // which is *not stated*, not *cleared* (the same distinction Invariant 9 makes
  // about a patch). Without this the seed is dropped on that push and every
  // control reads a field off `undefined`, which is how a wrapper component that
  // declares `export let record` — every generated Resource file — took its own
  // form down.
  $: { if (record === undefined) record = seed }

  // The baseline reset() returns to. Snapshotted at mount (`var`, outside the
  // reactive graph) because a form that reset to the CURRENT record would be a
  // no-op. Shallow on purpose — a row is flat, and a deep clone would copy
  // File objects and Dates into things that no longer compare equal.
  var pristine = { ...seed }

  // What descendants read. Rebuilt whenever any part changes, which is what
  // makes a <Field> three levels down re-render on its own error.
  // `disabled` and `submitting` are reported SEPARATELY, because the two do
  // not mean the same thing to everything under here. A field locks on either
  // — typing into a form that is being saved edits a record already in flight.
  // A button does not: Cancel has to stay live while a slow save runs, or the
  // save traps the person in the form, and only the SUBMIT button follows
  // `submitting`. Reporting one merged flag is what made that undecidable.
  // `optionsFor` is how a control asks what a field's options are without
  // knowing where they come from. This package peers on mesa and css alone, so
  // it cannot reach the resource itself, and a relation's options need a
  // request that only the resource can make — the form is the one thing under
  // here holding both. Always a promise, including for an enum the rule
  // already answers, so a control has one code path rather than two.
  //
  // It answers `{ options, total, truncated }` rather than the rows, because a
  // list capped at the server's limit and a list that is genuinely complete
  // look identical once the count is dropped — which is the whole of `FJS-391`.
  // `opts` carries `search`, so a control can send what was typed to the
  // SERVER instead of filtering the page it already has.
  $context.form = {
    errors,
    submitting,
    disabled,
    fields: resource?.fields ?? {},
    submitted,
    optionsFor: (name, opts) =>
      resource?.options?.(name, opts) ??
      Promise.resolve({ options: [], total: 0, truncated: false }),
    reportInvalid,
  }

  // ── The generated fields ─────────────────────────────────────────────
  //
  // `generated` holds every entry the resource returned, including the ones it
  // could not give a control — an array column, a `Json` document, a name that
  // is not a field. Those are reported rather than dropped: a field silently
  // missing from a form is the exact failure generating the list is meant to
  // end, and it would be invisible in the one place a person would look.

  const _auto = auto ?? !$slots.default
  const generated = _auto ? (resource?.formFields?.({ only, except }) ?? []) : []
  const rendered  = generated.filter(f => f.control)

  // A `readOnly` field is not one of them: `@system`, `@computed`, `@generated`
  // and `@from` are the schema saying this value is not the caller's to write,
  // and a form leaving it out is the annotation working. What is worth saying
  // out loud is a column the kit has no control FOR — an array, a `Json`
  // document, a name the model does not have.
  for (const f of generated) {
    if (f.control || f.reason === 'readOnly') continue
    console.warn(
      `[Form] ${resource?.context?.model ?? 'resource'}.${f.name} is not rendered — ${f.reason}. ` +
      'Name it in `only` with a control of your own, or in `except` to say it is deliberate.',
    )
  }

  // A picker's rows come from the related service, so they arrive after the
  // form does. Keyed by field, replaced rather than mutated — that is what
  // makes the <Select> repopulate. $.onMount, so a prerendered form fetches
  // nothing at build time.
  let pickers = {}
  let totals  = {}

  // Controls hand back an event; the record is REPLACED rather than mutated,
  // because a member expression is not a bindable target and mutation would
  // not be seen. Same shape every hand-written form in this repo used.
  //
  // `dirty` is set here as well as by the bubbled `input`/`change` listener
  // below: a contributed control is not obliged to be a DOM input, and one that
  // hands back a value without emitting an event would otherwise leave a form
  // that has been edited saying it is pristine. Setting it twice is free.
  function writeField(name, value) {
    record = { ...record, [name]: value }
    dirty  = true
  }

  // ── Live validation ──────────────────────────────────────────────────
  //
  // One rule: **on input an error may only be removed, never revealed.**
  //
  // The obvious wiring — re-validate on every input — misbehaves, because
  // validation judges the whole record: the first keystroke in `reference`
  // lights up "status is required" and "customer is required" on fields the
  // user has not reached. So a field is *revealed* by leaving it (having typed
  // in it) or by submitting, and input only ever re-checks a field that is
  // already speaking. A bad value goes red when you leave it and goes quiet
  // again on the keystroke that fixes it.
  //
  // Revealing is sticky: once a field has spoken it may speak again on input,
  // which is not "adding on input" — it is already showing.
  //
  // Two error sources are kept apart. `_server` is what the last failed submit
  // said, and only the server can know it ("that address is taken"); `_live` is
  // the schema check, which runs here and re-runs freely. A live message wins
  // where both exist, because the client is judging what is on screen now, and
  // a server message survives until its own field is edited.
  let _touched  = []     // fields that have received input
  let _revealed = []     // fields allowed to show a message
  let _server   = {}     // per-field messages from the last failed submit

  // ── The fourth error source: a control that cannot convert what it shows ──
  //
  // The three above all judge the RECORD. This one judges the box, and nothing
  // else here can: a control whose element cannot hold every value the field
  // may take — `JsonInput`, where `{"a":` is a state every valid document
  // passes through while it is being typed — writes only what it could convert,
  // so the record keeps the last good value and every check on it passes while
  // the screen shows something else. Submitting then saves a value the person
  // can see is not the one in front of them.
  //
  // So a control reports it, through `$context.form.reportInvalid(name, msg)`,
  // and a `null` message retracts it. The control is on screen by construction
  // — it is the thing that raised this — which is what lets the refusal below
  // cover a hand-written form as well, where `FJS-316` deliberately stops the
  // record-level checks from refusing.
  let _control = {}

  /**
   * A control saying the value it is showing is not one it can hand over.
   * `message` null or '' retracts it.
   *
   * Guarded on no-change because a control calls this from its input handler
   * and the reassignment below rebuilds `$context.form`, which re-derives that
   * control — an unguarded write would be a render loop on every keystroke of
   * an already-invalid box.
   */
  function reportInvalid(name, message) {
    if (!name) return
    const next = message || ''
    if ((_control[name] ?? '') === next) return

    const map = { ..._control }
    if (next) map[name] = next
    else delete map[name]

    _control = map
    _recompute()
  }

  const _mode = () =>
    method === 'patch' || (method === 'auto' && record?.[idField] != null)
      ? 'patch' : 'create'

  // Validate the COERCED record, never the raw one: every DOM control hands
  // back a string, so checking `record` directly reports "total must be a
  // number" for a perfectly good "42".
  function _live() {
    if (!resource?.validate) return {}
    const payload = resource.coerce ? resource.coerce(record) : record
    const out = {}
    for (const e of resource.validate(payload, _mode())) {
      if (_revealed.includes(e.field) && !(e.field in out)) out[e.field] = e.message
    }
    return out
  }

  function _recompute() {
    // `_control` last: it is the only one of the three describing what is on
    // screen NOW. A server message is about the value that was sent and a live
    // message is about the last value the control could convert, so both are
    // talking about a record the box no longer agrees with.
    errors = { ..._server, ..._live(), ..._control }
  }

  function _map(err) {
    const fn = mapErrors ?? resource?.fieldErrors
    // No unwrapper: say the one true thing rather than guess at a shape.
    if (!fn) return { fields: {}, message: err?.message ?? 'Request failed' }
    return fn(err) ?? { fields: {}, message: '' }
  }

  function _send(data) {
    if (!resource) {
      throw new Error('<Form> needs either a `resource` or an `onsubmit` handler')
    }
    // The resource owns the write (`FJS-D114`). It answers `auto` off the
    // model's OWN id field, which is the question this component used to
    // answer for itself — and the one the client's `upsert` gets wrong, since
    // that is hardcoded to `id` and creates a duplicate when a model is keyed
    // by anything else (`FJS-316`).
    if (resource.save) return resource.save(data, { mode: method })

    // A resource object from before save() existed — a hand-made one, or an
    // older @frontierjs/sierra. Same decision, made here.
    const how = method === 'auto' ? _mode() : method

    if (how === 'create') return resource.service.create(data)
    if (how === 'patch')  return resource.service.patch(data?.[idField], data)
    return resource.service.upsert(data)
  }

  // ── The imperative API ───────────────────────────────────────────────
  //
  // Reachable two ways, and they are the same three functions:
  //
  //   <Form {resource} bind:this={form} />        form.submit()
  //   <Form {resource} onready={api => …} />      api.submit()
  //
  // `onready` predates `export function` working at all and stays because an
  // app that captured the api at mount has nothing to gain from changing.

  export async function submit(e) {
    // Also called programmatically, where there is no event.
    e?.preventDefault?.()
    if (submitting || disabled) return undefined

    submitted = true
    formError = ''
    errors    = {}
    _server   = {}
    // Submitting reveals every field — that is what makes it the thing that
    // speaks for the ones never visited.
    _revealed = Object.keys(resource?.fields ?? {})
    _recompute()

    // …and then refuses, but ONLY over a control this form is showing.
    //
    // Revealing alone changes what a later keystroke may display, so a form
    // submitted untouched used to send an invalid record and show nothing.
    // Asking is the missing half. What it must not do is refuse over a field
    // that is not on screen: `make()` seeds every writable column, and a
    // hand-written form legitimately renders three of them and completes the
    // rest inside its own `onsubmit` — `appId` on a form that asks for a
    // hostname. Refusing there is a form that can never be submitted, with no
    // message anywhere, which is worse than the round trip it saves.
    //
    // So the rule is the one that keeps the refusal legible: a generated
    // control is refused because its message is on screen next to it. A
    // hand-written form still validates where it always did — in the resource,
    // on the way to the service.
    // A control's own refusal is not subject to that rule: it came from a
    // control that is on screen, which is the only thing `rendered` was
    // standing in for. So a hand-written form refuses over it too.
    if (Object.keys(_control).length) return undefined
    if (rendered.some(f => errors[f.name])) return undefined

    submitting = true

    try {
      const result = onsubmit ? await onsubmit(record) : await _send(record)
      dirty = false
      if (resetOnDone) reset()
      ondone?.(result, record)
      return result
    } catch (err) {
      const mapped = _map(err)
      _server   = mapped.fields  ?? {}
      formError = mapped.message ?? ''
      _recompute()
      onerror?.(err)
      return undefined
    } finally {
      // finally, not the catch arm: an ondone that throws must still leave the
      // form usable rather than stuck spinning forever.
      submitting = false
    }
  }

  /** Back to the pristine record, with every error and flag cleared. */
  export function reset(next) {
    if (next !== undefined) pristine = { ...next }
    record    = { ...pristine }
    dirty     = false
    submitted = false
    clearErrors()
  }

  /**
   * Drop the messages without touching the record.
   *
   * `_control` is deliberately NOT among them. Every other message here is
   * about a value — clear it and the worst case is that the next submit says
   * the same thing again. A control error is about TEXT that is still in the
   * box: clearing it would leave the form submittable over something the
   * person can see is wrong, and nothing would put the message back until they
   * typed. It is retracted by the control that raised it, and by nothing else.
   */
  export function clearErrors() {
    errors    = {}
    formError = ''
    _server   = {}
    _revealed = []
    _touched  = []
    _recompute()
  }

  // `input` and `change` both bubble, so one pair of listeners on the <form>
  // sees every control under it — including ones this kit did not render.
  // That is the whole dirty-tracking mechanism: no deep watch of the record,
  // no per-field wiring.
  function handleChange(e) {
    dirty = true

    const key = e?.target?.name
    if (!key) return

    if (!_touched.includes(key)) _touched = [..._touched, key]

    // A server message is about the value that was sent, so editing that value
    // retires it. Without this it sits under a box the user has already fixed,
    // which reads as the form refusing to accept a correct value.
    if (_server[key] !== undefined) {
      const next = { ..._server }
      delete next[key]
      _server = next
    }

    if (validateOn === 'input' && !_revealed.includes(key)) {
      _revealed = [..._revealed, key]
    }

    // Re-check rather than blindly clear: a field that is already speaking must
    // be allowed to say something ELSE as the value changes, and one that is
    // not revealed still cannot start.
    _recompute()
  }

  // Reveal on leaving a field that has actually been typed in. Tabbing through
  // an untouched form must stay silent — submit is what speaks for those.
  //
  // `blur` in the CAPTURE phase, not `focusout`. Capture runs from the root
  // down to the target regardless of whether the event bubbles, so one listener
  // on the <form> sees a `blur` that by definition does not bubble. `focusout`
  // would work for real focus loss and miss a synthetic `blur` dispatched
  // straight at an element, which is how a test drives it.
  // Hand the imperative API out once the component is alive. $.onMount is a
  // no-op server-side, so a prerendered form simply never offers it — which is
  // correct: there is nothing to submit.
  $.onMount(() => {
    onready?.({ submit, reset, clearErrors })

    // Rows are fetched for a SCHEMA FACT — a foreign key, or a declared value
    // set — not for the control named `picker`. The relation is the fact and
    // the control is a choice made over it, so a contributed combobox over
    // `customerId` gets its rows without having to claim the built-in name to
    // do it, and a `@values` column gets them with no relation at all.
    //
    // `.options` off the envelope, not the envelope: every control below takes
    // a plain array, and passing the envelope through handed `<Select>` an
    // object to iterate. The COUNT is kept beside it rather than dropped —
    // `resource.options()` answers `{ options, total, truncated }`, and a list
    // capped at the server's limit reads identically to a complete one once
    // the number is gone, which is the whole of `FJS-391`.
    for (const f of rendered) {
      if (!f.rule?.references && !f.rule?.values) continue
      resource?.options?.(f.name)?.then?.(r => {
        pickers = { ...pickers, [f.name]: Array.isArray(r) ? r : (r?.options ?? []) }
        totals  = { ...totals,  [f.name]: Array.isArray(r) ? null : (r?.total ?? null) }
      })
    }
  })

  function handleLeave(e) {
    if (validateOn !== 'blur') return
    const key = e?.target?.name
    if (!key || !_touched.includes(key) || _revealed.includes(key)) return
    _revealed = [..._revealed, key]
    _recompute()
  }
</script>

<form
  class={cx('stack')}
  novalidate={novalidate || null}
  aria-busy={submitting || null}
  on:submit|preventDefault={submit}
  on:input={handleChange}
  on:change={handleChange}
  on:blur|capture={handleLeave}
  {class}
  {...$attributes}
>
  <!--
    The failure no field could render — a 500, a dropped socket, a conflict.
    role="alert" comes from Alert itself.
  -->
  {#if showError && formError}
    <Alert tone="danger" title={errorTitle}>{formError}</Alert>
  {/if}

  <!--
    Nothing below states a label, a `required`, a `type` or a message: every one
    of those is a schema fact and a control inside a <Form> resolves it from
    `$context.form`. What IS stated is the control, its value and how the value
    comes back — the three things the schema does not say.
  -->
  {#each rendered as f (f.name)}
    <FormField
      field={f}
      value={record?.[f.name]}
      options={pickers[f.name]}
      total={totals[f.name]}
      write={(v) => writeField(f.name, v)}
    />
  {/each}

  <slot />

  {#if actions}
    <div class="cluster">
      {@render actions?.()}
    </div>
  {:else if $slots.actions}
    <div class="cluster">
      <slot:actions />
    </div>
  {/if}
</form>
