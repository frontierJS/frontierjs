<script>
  // Textarea.mesa
  // Multi-line text input with optional auto-resize.
  // Field composition pattern: a label prop triggers self-wrapping in Field.
  //
  // bind:this exposes: focus()

  import Field from './Field.mesa'
  import { nameToLabel, uid, resolveError, resolveRule, stated, nativeValidationGuard, lockedBy } from '../../utils.js'

  export let value       = ''
  export let placeholder = ''
  export let rows        = 3
  export let maxlength   = undefined
  export let disabled    = undefined  // undefined = ask the form; false overrides it
  export let required    = undefined
  export let readonly    = false
  export let resize      = true      // allow manual resize via drag
  export let autogrow    = false     // auto-expand height to content

  // Field integration
  export let name     = ''
  // `undefined` is "not stated" and `''` is "no label, deliberately". They have
  // to be different values: a default of '' makes the two indistinguishable, so
  // the documented suppression below cannot be expressed at all.
  export let label    = undefined
  export let hint     = ''
  export let error    = ''
  export let errors   = undefined
  export let badge    = undefined
  export let help     = undefined

  export var id = ''
  const textareaId = id || uid('textarea')
  const autoLabel  = nameToLabel(name)

  const form     = $context.form

  // A <Form> above this control locks it two ways — the caller disabled the
  // form, or a save is in flight — and both mean the same thing to a field.
  // A stated prop still wins, including `disabled={false}` on a saving form.
  const resolvedDisabled = stated(disabled, lockedBy(form, name)) ?? false
  const rule     = resolveRule(form, name)
  const hasError = !!resolveError(form, name, error, errors)

  // The constraints the schema already states. `@length(3, 500)` reaches the
  // browser as maxLength, and without this the only way to honor it on a
  // textarea was to restate it — which is how a form and its .lite file drift.
  const resolvedRequired  = stated(required,  rule?.required)
  const resolvedMaxlength = stated(maxlength, rule?.maxLength)

  let el
  export function focus() { el?.focus() }

  function handleInput(e) {
    value = e.target.value
    if (autogrow) {
      e.target.style.height = 'auto'
      e.target.style.height = `${e.target.scrollHeight}px`
    }
    // The caller's hook runs AFTER the internal write and the autogrow, so a
    // handler that re-renders cannot cancel either.
    oninput?.(e)
  }
  // Native event callbacks. `oninput` was missing while <Input> and <Select>
  // both had it — and an undeclared prop is silently ignored, so a caller
  // writing `oninput={…}` on a Textarea got no handler, no warning, and an
  // empty field at submit. Found filing a certificate through <Form> in
  // packages/basecamp (FJS-116).
  export let oninput  = undefined
  export let onchange = undefined
  export let onblur   = undefined
  export let onfocus  = undefined
</script>

{#snippet control()}
  <textarea
    bind:this={el}
    class="field"
    id={textareaId}
    name={name || undefined}
    rows={rows}
    maxlength={resolvedMaxlength}
    placeholder={placeholder}
    disabled={resolvedDisabled}
    required={resolvedRequired}
    {@attach nativeValidationGuard}
    readonly={readonly}
    aria-invalid={hasError || null}
    style:resize={resize ? null : 'none'}
    on:input={handleInput}
    on:change={onchange}
    on:blur={onblur}
    on:focus={onfocus}
    {...$attributes}
  >{value}</textarea>

  {#if resolvedMaxlength}
    <!--
      aria-live so a screen reader user hears they are approaching the cap;
      a silent counter only helps people who can see it.
    -->
    <p class="field-hint" style:text-align="end" aria-live="polite">
      {value.length} / {resolvedMaxlength}
    </p>
  {/if}
{/snippet}

{#if label || (name && autoLabel)}
  <!--
    label and required go down UNRESOLVED where the caller stated nothing:
    Field reads the same rule off the same <Form> and resolves them once. This
    used to pass `label || autoLabel`, which meant the title-cased column name
    always arrived as an explicit label and a schema `@label("Customer")` could
    never be seen — the control shadowed the very thing it was meant to show.
    `|| undefined` because '' is a real answer here: it suppresses the label.
  -->
  <Field
    id={textareaId}
    name={name}
    label={label}
    required={resolvedRequired}
    badge={badge}
    help={help}
    hint={hint}
    error={error}
    errors={errors}
    {class}
  >
    {@render control()}
  </Field>
{:else}
  {@render control()}
{/if}
