<script>
  // Slider.mesa
  // Single or dual-handle range slider. Pointer events (mouse, touch, pen) via
  // drag.js; arrows, Page and Home/End per the APG slider pattern.
  //
  // SINGLE MODE (default):
  //   <Slider bind:value={price} min={0} max={1000} step={10} />
  //
  // RANGE MODE:
  //   <Slider range bind:start={low} bind:end={high} min={0} max={100} />
  //
  // WITH FIELD WRAPPER:
  //   <Slider label="Price range" name="price" range bind:start bind:end />
  //
  // FORMAT FUNCTION:
  //   <Slider bind:value format={(v) => `$${v.toLocaleString()}`} />

  import Field from './Field.mesa'
  import { drag } from '../../drag.js'
  import { tone as toTone, cx, ruleLabel, resolveRule, stated, lockedBy } from '../../utils.js'

  // ── Props ───────────────────────────────────────────────────────────────────

  export let value    = 0            // single mode — bindable
  export let start    = undefined    // range mode — bindable low handle
  export let end      = undefined    // range mode — bindable high handle
  export let min      = 0
  export let max      = 100
  export let step     = 1
  export let range    = false        // dual handle mode
  export let disabled = undefined  // undefined = ask the form; false overrides it
  export let format   = undefined    // (value: number) => string — pip label formatter
  export let showPips = true         // show value labels under handles
  export let tone     = ''           // one of the 7 css tones; '' is primary
  export let color    = ''           // legacy alias for `tone`

  // Field integration
  export let name     = ''
  // `undefined` is "not stated" and `''` is "no label, deliberately". They have
  // to be different values: a default of '' makes the two indistinguishable, so
  // the documented suppression below cannot be expressed at all.
  export let label    = undefined
  export let hint     = ''
  export let error    = ''
  export let errors   = undefined
  // The platform's two names, as `Input` has them: `oninput` per value a drag
  // or key produces, `onchange` once when the gesture ends. A page with an
  // undo history keys on `onchange`, or one drag is a hundred steps.
  export let oninput  = undefined    // ({ value } | { start, end }) => void
  export let onchange = undefined    // ({ value } | { start, end }) => void

  // The enclosing <Form> and this field's rule, both undefined standing alone.
  // A slider inside a <Form> showed no server error and no schema label — and
  // `label || name` below meant a caller who gave only a name saw the raw
  // column, with `@label("…")` unreachable through this component at all.
  //
  // `min`/`max` deliberately stay the caller's: they default to 0 and 100
  // rather than undefined, so there is no way to tell a stated 0 from the
  // default and a schema `minimum` cannot be resolved against them.
  const form = $context.form

  // A <Form> above this control locks it two ways — the caller disabled the
  // form, or a save is in flight — and both mean the same thing to a field.
  // A stated prop still wins, including `disabled={false}` on a saving form.
  const resolvedDisabled = stated(disabled, lockedBy(form, name)) ?? false
  const rule = resolveRule(form, name)

  const resolvedLabel = stated(label, ruleLabel(name, rule))

  // $attributes land on the wrapper div, where an aria-label names nothing. The
  // handle is what announces, so a caller's aria-label is read from there, and
  // a slider with no visible label can still be told apart from its neighbors.
  const handleName = resolvedLabel || $attributes['aria-label'] || ''

  // ── Helpers ─────────────────────────────────────────────────────────────────

  function getPrecision(n) {
    if (!isFinite(n) || Number.isInteger(n)) return 0
    return String(n).split('.')[1]?.length ?? 0
  }

  const precision = getPrecision(step)

  function snap(raw) {
    const clamped  = Math.max(min, Math.min(max, raw))
    const snapped  = Math.round((clamped - min) / step) * step + min
    return parseFloat(snapped.toFixed(precision))
  }

  function pct(v) {
    return ((v - min) / (max - min)) * 100
  }

  function fmt(v) {
    return format ? format(v) : String(v)
  }

  // ── State ────────────────────────────────────────────────────────────────────

  // Initialize range handles with sensible defaults
  if (range && start == null) start = min
  if (range && end   == null) end   = max
  if (!range && value == null) value = min

  let sliderEl    // bind:this — track element ref
  var dragging    = null   // null | 'single' | 'start' | 'end'

  // ── Derived percentages ───────────────────────────────────────────────────────

  const singlePct = pct(value)
  const startPct  = range ? pct(start) : 0
  const endPct    = range ? pct(end)   : 0

  // ── Track tone ────────────────────────────────────────────────────────────
  // One tone class on the root; every part of the control reads --bg-mix, so
  // the fill, the handle and the focus ring cannot disagree about the color.

  const t = toTone(color || tone)

  // ── Drag logic ─────────────────────────────────────────────────────────────

  function posToValue(clientX) {
    if (!sliderEl) return 0
    const { left, width } = sliderEl.getBoundingClientRect()
    const pctRaw = Math.max(0, Math.min(1, (clientX - left) / width))
    return snap(pctRaw * (max - min) + min)
  }

  // The handle a press at `v` moves. On a handle the press is that handle's;
  // on the track it is the nearest, and the two sides of a tie go to the side
  // the press is on, so handles stacked at one value can both be pulled out.
  function handleFor(v) {
    if (!range) return 'single'
    if (v <= start) return 'start'
    if (v >= end)   return 'end'
    return Math.abs(v - start) <= Math.abs(v - end) ? 'start' : 'end'
  }

  const valueOf = (which) => which === 'single' ? value : which === 'start' ? start : end

  function set(which, v) {
    if (which === 'single') {
      value = v
    } else if (which === 'start') {
      start = Math.min(v, end)
    } else {
      end = Math.max(v, start)
    }
  }

  // One gesture for press, drag and a pen: a press on the track jumps the
  // nearest handle to it and carries on as a drag; a press on a handle drags
  // that handle without first moving it to the pointer.
  //
  // A gesture commits once at release, and only if it moved something: a press
  // on a handle that never moves it is not a change. A cancelled gesture still
  // commits, since the value it moved is already the one on screen.
  var moved = false
  const track = drag(() => ({
    accept: (e) => !resolvedDisabled && e.button === 0,
    start: (e) => {
      const grabbed = e.target.closest?.('.fjs-slider-handle')
      const which = grabbed ? grabbed.dataset.which : handleFor(posToValue(e.clientX))
      moved = false
      if (!grabbed) { set(which, posToValue(e.clientX)); emit(); moved = true }
      $.focus(sliderEl.querySelector('[data-which=' + which + ']'))
      dragging = which
      return which
    },
    move: (e, which) => {
      const before = valueOf(which)
      set(which, posToValue(e.clientX))
      if (valueOf(which) === before) return
      emit()
      moved = true
    },
    end:  () => {
      dragging = null
      if (moved) { moved = false; commit() }
    },
  }))

  const KEY_DELTA = { ArrowLeft: -1, ArrowDown: -1, ArrowRight: 1, ArrowUp: 1, PageDown: -10, PageUp: 10 }

  function handleKeydown(which) {
    return (e) => {
      if (resolvedDisabled) return
      let next
      if (e.key === 'Home' || e.key === 'End') {
        const low = e.key === 'Home'
        next = which === 'start' ? (low ? min : end)
             : which === 'end'   ? (low ? start : max)
             : (low ? min : max)
      } else if (e.key in KEY_DELTA) {
        const delta = KEY_DELTA[e.key] * (e.shiftKey ? step * 10 : step)
        next = valueOf(which) + delta
      } else {
        return
      }
      e.preventDefault()
      set(which, snap(next))
      emit()
      commit()
    }
  }

  const payload = () => range ? { start, end } : { value }

  // The handles are divs, so a drag or an arrow key emits no event a form can
  // key on: the form is told by name.
  function emit() {
    oninput?.(payload())
    form?.changed?.(name)
  }

  function commit() {
    onchange?.(payload())
  }
</script>

{#snippet track()}
  <div class={cx('fjs-slider', t)} style:opacity={resolvedDisabled ? 0.5 : null} {...$attributes}>
    <!-- Track + handles -->
    <div
      bind:this={sliderEl}
      class="fjs-slider-track"
      style:cursor={resolvedDisabled ? 'not-allowed' : 'pointer'}
      style:touch-action="pan-y"
      {@attach track}
    >
      <!-- Fill bar -->
      {#if range}
        <div
          class="fjs-slider-fill"
          style:left="{startPct}%"
          style:width="{endPct - startPct}%"
        ></div>
      {:else}
        <div class="fjs-slider-fill" style:left="0" style:width="{singlePct}%"></div>
      {/if}

      <!-- Single handle -->
      {#if !range}
        <div
          class="fjs-slider-handle"
          style:left="{singlePct}%"
          style:cursor={resolvedDisabled ? 'not-allowed' : 'grab'}
          data-which="single"
          role="slider"
          tabindex={resolvedDisabled ? -1 : 0}
          aria-valuemin={min}
          aria-valuemax={max}
          aria-valuenow={value}
          aria-valuetext={fmt(value)}
          aria-label={handleName || 'Value'}
          aria-disabled={resolvedDisabled || null}
          on:keydown={handleKeydown('single')}
        ></div>

        {#if showPips}
          <div class="fjs-slider-pip" style:left="{singlePct}%">{fmt(value)}</div>
        {/if}

      {:else}
        <!-- Start handle -->
        <div
          class="fjs-slider-handle"
          style:left="{startPct}%"
          style:cursor={resolvedDisabled ? 'not-allowed' : 'grab'}
          data-which="start"
          role="slider"
          tabindex={resolvedDisabled ? -1 : 0}
          aria-valuemin={min}
          aria-valuemax={end}
          aria-valuenow={start}
          aria-valuetext={fmt(start)}
          aria-label={handleName ? handleName + ' minimum' : 'Minimum'}
          aria-disabled={resolvedDisabled || null}
          on:keydown={handleKeydown('start')}
        ></div>

        <!-- End handle -->
        <div
          class="fjs-slider-handle"
          style:left="{endPct}%"
          style:cursor={resolvedDisabled ? 'not-allowed' : 'grab'}
          data-which="end"
          role="slider"
          tabindex={resolvedDisabled ? -1 : 0}
          aria-valuemin={start}
          aria-valuemax={max}
          aria-valuenow={end}
          aria-valuetext={fmt(end)}
          aria-label={handleName ? handleName + ' maximum' : 'Maximum'}
          aria-disabled={resolvedDisabled || null}
          on:keydown={handleKeydown('end')}
        ></div>

        {#if showPips}
          <div class="fjs-slider-pip" style:left="{startPct}%">{fmt(start)}</div>
          <div class="fjs-slider-pip" style:left="{endPct}%">{fmt(end)}</div>
        {/if}
      {/if}
    </div>

    <!-- Min/max labels -->
    <div class="split fjs-slider-bounds" style:margin-top={showPips ? '0.75rem' : null}>
      <span class="text-xs text-muted">{fmt(min)}</span>
      <span class="text-xs text-muted">{fmt(max)}</span>
    </div>
  </div>
{/snippet}

{#if label || name}
  <!--
    `label` goes through unresolved where the caller stated nothing, so Field
    resolves it once off the same rule. It used to be `label || name`, which is
    always truthy when a name is given — and so shadowed the schema's own
    `@label` with the raw column name.
  -->
  <Field
    name={name}
    label={label}
    hint={hint}
    error={error}
    errors={errors}
    {class}
  >
    {@render track()}
  </Field>
{:else}
  <!--
    `{class}` is a standalone attribute, never interpolated into a class
    string. `class` is a JS reserved word, so `class="pt-2 {class}"` compiled
    to `${class}` inside a template literal — a syntax error that Mesa
    reported no error for and that threw the moment the module loaded.
  -->
  <div class="fjs-slider-bare" {class}>
    {@render track()}
  </div>
{/if}

<style>
  /* @frontierjs/css has no Slider term, so this control draws itself — but
     from the same tokens as everything else, so it themes with the page.
     --bg-mix is what a tone class sets; the fallback keeps it primary. */
  .fjs-slider {
    display:        flex;
    flex-direction: column;
    gap:            0.75rem;
    --slider-accent: var(--bg-mix, var(--color-primary));
  }
  .fjs-slider-bare { padding-block: 0.5rem 0.25rem; }

  .fjs-slider-track {
    position:      relative;
    block-size:    0.375rem;
    inline-size:   100%;
    border-radius: 999px;
    background:    var(--surface-sunken);
  }
  .fjs-slider-fill {
    position:      absolute;
    inset-block:   0;
    border-radius: 999px;
    background:    var(--slider-accent);
  }
  .fjs-slider-handle {
    position:      absolute;
    inset-block-start: 50%;
    inline-size:   1.25rem;
    block-size:    1.25rem;
    transform:     translate(-50%, -50%);
    border-radius: 50%;
    border:        2px solid var(--surface);
    background:    var(--slider-accent);
    box-shadow:    var(--shadow-md);
    z-index:       1;
    transition:    transform 120ms;
  }
  .fjs-slider-handle:hover  { transform: translate(-50%, -50%) scale(1.1); }
  .fjs-slider-handle:active { cursor: grabbing; }
  /* The ring itself comes from focus.css — this only rounds the shape it
     traces, since outline follows border-radius. */
  .fjs-slider-pip {
    position:       absolute;
    inset-block-start: 1.25rem;
    transform:      translateX(-50%);
    font-size:      0.75rem;
    color:          var(--ink-mute);
    white-space:    nowrap;
    pointer-events: none;
  }
  @media (prefers-reduced-motion: reduce) {
    .fjs-slider-handle { transition: none; }
  }
</style>
