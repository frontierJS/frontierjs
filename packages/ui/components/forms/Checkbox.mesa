<script>
  // Checkbox.mesa
  // A single checkbox with optional label and description.
  //
  // `.field-check` is a <label> wrapping a real checkbox, so clicking the
  // text toggles the box with no `for`/`id` pairing to keep in sync — and
  // `accent-color` from the tone means no custom-drawn box to maintain.
  //
  // For a toggle-switch aesthetic, use Switch.mesa.

  import { tone as toTone, cx, uid, nameToLabel, resolveError, resolveRule, stated } from '../../utils.js'

  export let checked     = false
  export let label       = ''       // falls back to @label, then the column name
  export let description = ''  // secondary line under the label
  export let name        = undefined
  export let value       = undefined
  export let disabled    = false
  export let required    = undefined
  export let tone        = ''
  export let error       = ''
  export let onchange    = undefined

  export var id = ''
  const checkId = id || uid('check')
  const descId  = uid('check-desc')

  // The enclosing <Form> and this field's rule, both undefined standing alone.
  // A boolean column is a checkbox, so a generated form emits this one — and
  // without the resolution below it was the only control in a generated form
  // that could not say its own name or show its own rejection.
  const form = $context.form
  const rule = resolveRule(form, name)

  const resolvedLabel    = stated(label || undefined, rule?.title, name ? nameToLabel(name) : '') ?? ''
  const resolvedRequired = stated(required, rule?.required)
  const displayError     = resolveError(form, name, error, undefined)

  const t = displayError ? 'danger' : toTone(tone)

  function handleChange(e) {
    checked = e.target.checked
    onchange?.(checked)
  }
</script>

<div class="stack" style:gap="0.25rem" {class}>
  <!--
    The <label> IS the wrapper, so the whole row is the hit target. The
    description sits outside it and is wired with aria-describedby instead —
    inside, it would be read as part of the control's own name.
  -->
  <label class={cx('field-check', t)} for={checkId}>
    <input
      id={checkId}
      type="checkbox"
      name={name}
      value={value}
      checked={checked}
      disabled={disabled}
      required={resolvedRequired}
      aria-describedby={description ? descId : null}
      aria-invalid={displayError ? 'true' : null}
      on:change={handleChange}
      {...$attributes}
    />
    {#if resolvedLabel}<span>{resolvedLabel}</span>{/if}
  </label>

  {#if description}
    <p class="field-hint" id={descId}>{description}</p>
  {/if}

  {#if displayError}
    <p class={cx('field-hint', 'danger')} role="alert">{displayError}</p>
  {/if}
</div>
