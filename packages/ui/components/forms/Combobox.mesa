<script>
  // Combobox.mesa
  // Searchable single-value select. The user can type to filter options,
  // and optionally confirm any typed value (allowNew).
  // Sits between Select (no search) and MultiSelect (multi-value).
  //
  // Usage — basic:
  //   <Combobox bind:value={country} options={countries} placeholder="Search country…" />
  //
  // Usage — with Field:
  //   <Combobox label="Timezone" name="tz" bind:value {options} {errors} />
  //
  // Usage — allow new values:
  //   <Combobox bind:value allowNew placeholder="Select or type a tag…" {options} />

  import Field from '../forms/Field.mesa'
  import { uid, resolveError, resolveRule, stated, nativeValidationGuard } from '../../utils.js'

  export let value       = undefined    // scalar — bindable
  export let options     = []           // string[] | { value, label, disabled? }[]
  export let placeholder = 'Search…'
  export let allowNew    = false        // confirm any typed string as value
  export let disabled    = undefined  // undefined = ask the form; false overrides it
  export let required    = undefined
  export let clearable   = true

  // Field integration
  export let name     = ''
  export let label    = ''
  export let hint     = ''
  export let error    = ''
  export let errors   = undefined

  // The enclosing <Form>, when there is one — see utils.js § Form context.
  const form     = $context.form

  // A <Form> above this control locks it two ways — the caller disabled the
  // form, or a save is in flight — and both mean the same thing to a field.
  // A stated prop still wins, including `disabled={false}` on a saving form.
  const resolvedDisabled = stated(disabled, form?.disabled || form?.submitting) ?? false
  const rule     = resolveRule(form, name)
  const hasError = !!resolveError(form, name, error, errors)

  // `required` is a schema fact; without it a column the model insists on
  // announced nothing on the control a caller reached for instead of a select.
  const resolvedRequired = stated(required, rule?.required)
  export let badge    = undefined
  export let help     = undefined
  export let onchange = undefined

  export var id = ''
  const inputId = id || uid('cb')

  // Focus stays in the text box while the arrow keys move the highlight, so
  // `aria-selected` moving down the list says nothing on its own — the input
  // has to NAME the row Enter would take, and a row can only be named if it
  // has an id. Indexed rather than keyed by value: an option's value is the
  // caller's and may be anything, including a string that is not a valid id.
  const listId = uid('cb-list')
  const rowId  = (i) => `${listId}-${i}`

  // Normalise options
  function normalise(o) {
    if (typeof o === 'string' || typeof o === 'number') return { value: o, label: String(o) }
    return { value: o.value, label: o.label ?? o.textContent ?? String(o.value), disabled: o.disabled ?? false }
  }

  const normOptions = options.map(normalise)

  // Find the display label for the current value
  function labelFor(v) {
    return normOptions.find(o => o.value === v)?.label ?? (v != null ? String(v) : '')
  }

  let query    = labelFor(value)
  let open     = false
  let activeIdx = 0
  let inputEl
  let containerEl
  var _clickHandler = null

  // Derived — filter options by query
  const filtered = query.trim()
    ? normOptions.filter(o => o.label.toLowerCase().includes(query.toLowerCase()))
    : normOptions

  // Reset active index when filter changes
  $: query, () => { activeIdx = 0 }

  // Sync query label when value changes externally
  $: value, () => { query = labelFor(value) }

  function select(opt) {
    value = opt.value
    query = opt.label
    open  = false
    onchange?.(value)
  }

  function clear() {
    value = undefined
    query = ''
    open  = false
    onchange?.(undefined)
    inputEl?.focus()
  }

  function handleInput() {
    open = true
    if (!query) { value = undefined; onchange?.(undefined) }
  }

  function handleKeydown(e) {
    if (e.key === 'Escape') { open = false; query = labelFor(value); return }
    if (e.key === 'ArrowDown') { e.preventDefault(); open = true; activeIdx = Math.min(activeIdx + 1, filtered.length - 1); return }
    if (e.key === 'ArrowUp')   { e.preventDefault(); activeIdx = Math.max(activeIdx - 1, 0); return }
    if (e.key === 'Enter') {
      e.preventDefault()
      if (filtered[activeIdx]) { select(filtered[activeIdx]); return }
      if (allowNew && query.trim()) {
        value = query.trim()
        open  = false
        onchange?.(value)
      }
    }
  }

  function handleBlur() {
    setTimeout(() => {
      if (!containerEl?.contains(document.activeElement)) {
        open  = false
        // Revert query to current value label if input was changed but not confirmed
        query = labelFor(value)
      }
    }, 150)
  }

  const dropdownAnim = $.entrance({
    in:  el => el.animate([{ opacity: 0, transform: 'translateY(-4px)' }, { opacity: 1, transform: 'translateY(0)' }], { duration: 120, easing: 'ease-out', fill: 'forwards' }),
    out: el => el.animate([{ opacity: 1 }, { opacity: 0 }], { duration: 80, fill: 'forwards' }).finished,
  })
</script>

{#snippet control()}
  <div bind:this={containerEl} class="fjs-combobox">
    <!--
      .field-row joins the input to its trailing controls; the clear button
      is a real .btn so it gets the shared focus ring rather than its own.
    -->
    <div class="field-row">
      <input
        bind:this={inputEl}
        bind:value={query}
        class="field"
        id={inputId}
        name={name || undefined}
        type="text"
        autocomplete="off"
        spellcheck="false"
        placeholder={placeholder}
        disabled={resolvedDisabled}
        required={resolvedRequired}
        {@attach nativeValidationGuard}
        aria-invalid={hasError || null}
        role="combobox"
        aria-expanded={open}
        aria-haspopup="listbox"
        aria-autocomplete="list"
        aria-controls={listId}
        aria-activedescendant={open && filtered[activeIdx] ? rowId(activeIdx) : null}
        on:input={handleInput}
        on:focus={() => open = true}
        on:blur={handleBlur}
        on:keydown={handleKeydown}
        {...$attributes}
      />

      {#if clearable && (value != null || query)}
        <button type="button" class="btn ghost square" aria-label="Clear" on:click={clear}>
          <svg viewBox="0 0 20 20" fill="currentColor" aria-hidden="true">
            <path d="M6.28 5.22a.75.75 0 0 0-1.06 1.06L8.94 10l-3.72 3.72a.75.75 0 1 0 1.06 1.06L10 11.06l3.72 3.72a.75.75 0 1 0 1.06-1.06L11.06 10l3.72-3.72a.75.75 0 0 0-1.06-1.06L10 8.94 6.28 5.22z"/>
          </svg>
        </button>
      {/if}

      <span class="field-addon" aria-hidden="true">
        <svg
          viewBox="0 0 20 20"
          fill="currentColor"
          style:transform={open ? 'rotate(180deg)' : null}
          style:transition="transform 120ms"
        >
          <path fill-rule="evenodd" d="M5.22 8.22a.75.75 0 0 1 1.06 0L10 11.94l3.72-3.72a.75.75 0 1 1 1.06 1.06l-4.25 4.25a.75.75 0 0 1-1.06 0L5.22 9.28a.75.75 0 0 1 0-1.06z" clip-rule="evenodd"/>
        </svg>
      </span>
    </div>

    {#if open}
      <!-- .popover is the surface; .items.menu is the interactive list. -->
      <div class="popover fjs-combobox-panel" {@attach dropdownAnim}>
        <ul class="items menu" id={listId} role="listbox" aria-label="Options">
          {#if filtered.length === 0}
            <li class="item text-muted" aria-disabled="true">
              {allowNew && query.trim() ? `Press Enter to use "${query.trim()}"` : 'No options'}
            </li>
          {:else}
            {#each filtered as opt, i (opt.value)}
              {@const isActive   = i === activeIdx}
              {@const isSelected = opt.value === value}
              <!--
                mousemove, not mouseenter: the panel opens under whatever the
                pointer was last left on, and arrow-keying a long list scrolls
                rows under a still pointer. Either way mouseenter moves the
                cursor to a row nobody chose and Enter takes it. Guarded
                because mousemove fires per pixel.
              -->
              <li
                class="item fjs-combobox-option"
                id={rowId(i)}
                role="option"
                aria-selected={isSelected}
                aria-disabled={opt.disabled || null}
                data-active={isActive || null}
                on:mousemove={() => { if (activeIdx !== i) activeIdx = i }}
                on:click={() => select(opt)}
              >
                <span style:flex="1">{opt.label}</span>
                {#if isSelected}
                  <svg viewBox="0 0 20 20" fill="currentColor" aria-hidden="true">
                    <path fill-rule="evenodd" d="M16.704 4.153a.75.75 0 0 1 .143 1.052l-8 10.5a.75.75 0 0 1-1.127.075l-4.5-4.5a.75.75 0 0 1 1.06-1.06l3.894 3.893 7.48-9.817a.75.75 0 0 1 1.05-.143Z" clip-rule="evenodd"/>
                  </svg>
                {/if}
              </li>
            {/each}
          {/if}
        </ul>
      </div>
    {/if}
  </div>
{/snippet}

{#if label || name}
  <Field
    id={inputId}
    name={name}
    label={label || undefined}
    required={resolvedRequired}
    hint={hint}
    error={error}
    errors={errors}
    badge={badge}
    help={help}
    {class}
  >
    {@render control()}
  </Field>
{:else}
  <div {class}>
    {@render control()}
  </div>
{/if}


<style>
  .fjs-combobox { position: relative; }
  /* .popover is absolute by default; this only anchors and sizes it. */
  .fjs-combobox-panel {
    inset-inline:      0;
    inset-block-start: calc(100% + 0.25rem);
    max-inline-size:   none;
    max-block-size:    12rem;
    overflow-y:        auto;
    padding:           0.25rem;
    z-index:           50;
  }
  .fjs-combobox-option {
    display:     flex;
    align-items: center;
    gap:         0.5rem;
    cursor:      pointer;
  }
  /* Keyboard-active row. A data attribute rather than a class because it is
     transient pointer/arrow state, not a variant of the option. */
  .fjs-combobox-option[data-active] {
    background: color-mix(in srgb, var(--color-primary) 10%, transparent);
    color:      var(--color-primary);
  }
  .fjs-combobox-option[aria-disabled="true"] {
    opacity:        0.4;
    pointer-events: none;
  }
</style>
