<script>
  // Input.mesa
  // Flexible text input. When a label prop is provided the component
  // self-wraps in <Field>, giving label + input + hint + error in one
  // declaration.
  //
  // `.field` goes on the <input> itself — it IS the control, not a wrapper.
  // Its invalid border comes from `:user-invalid` with no JS and no class,
  // which is why the old ring-colour map is gone; only a *server* error needs
  // a tone, and Field owns that.
  //
  // Naked (inside an explicit Field):
  //   <Field label="Email" name="email" {errors}>
  //     <Input type="email" bind:value={email} />
  //   </Field>
  //
  // Shorthand (Field implicit):
  //   <Input label="Email" name="email" type="email" bind:value={email} {errors} />
  //
  // Inside <Form>, name is enough — everything else comes from the schema:
  //   <Form {resource}>
  //     <Input name="email" bind:value={email} />
  //   </Form>
  //
  // `bind:` takes a writable top-level `let` in the caller, so it is the local
  // and not `record.email` — a member expression there is a compile error.
  //
  // `email` there gets its label, `required`, `maxlength`/`minlength` and
  // `type="email"` from db/schema.lite, and its server error from the form.
  // Any prop stated here wins over the schema — including `required={false}`,
  // which is why the resolution uses `stated()` and not `||`.
  //
  // bind:this exposes: focus(), select()

  import Field from './Field.mesa'
  import { uid, resolveError, resolveRule, stated } from '../../utils.js'

  // Core input props
  export let value       = ''
  export let type        = undefined   // falls back to the schema's format, then 'text'
  export let placeholder = ''
  export let disabled    = false
  export let required    = undefined
  export let readonly    = false
  export let pattern     = undefined
  export let min         = undefined
  export let max         = undefined
  export let step        = undefined
  // A length limit is as much a schema fact as a min or a max — @length(3, 20)
  // reaches the browser as maxLength, and without this prop the only way to
  // honour it was to stop using the component.
  export let maxlength   = undefined
  export let minlength   = undefined
  export let autocomplete = undefined
  export let icon        = undefined   // trailing icon snippet
  export let datalist    = undefined   // string[] — renders <datalist>

  // Field integration props (only used when label is set)
  export let name     = ''
  export let label    = ''             // '' = naked, no Field wrapper
  export let hint     = ''
  export let error    = ''
  export let errors   = undefined
  export let badge    = undefined
  export let help     = undefined
  export let removable = false
  export let onremovekey = undefined
  // Native event callbacks
  //
  // `oninput` fires on every keystroke, AFTER `value` has been written back.
  // Without it the event was swallowed: a caller could see the new value only
  // through bind:value, so anything that has to react to typing itself — live
  // validation that may clear an error but never reveal one, a search-as-you-
  // type box, a character counter — could not be written against this input.
  export let oninput   = undefined
  export let onchange  = undefined
  export let onblur    = undefined
  export let onfocus   = undefined
  export let onkeydown = undefined
  export let onkeypress = undefined

  // id — snapshot at mount, stable for label association
  export var id = ''

  const inputId   = id || uid('input')
  const listId    = datalist ? `${inputId}-list` : undefined

  // The enclosing <Form>, and this field's rule from db/schema.lite. Both are
  // undefined standing alone, and every resolution below falls through to what
  // the component did before.
  const form = $context.form
  const rule = resolveRule(form, name)

  // The control type the schema implies. Only the cases where the mapping is
  // exact: a `format` that names a real input type, and a numeric column.
  //
  // `date-time` is deliberately NOT mapped. Litestone stores ISO-8601 with a
  // zone; `<input type="datetime-local">` accepts and emits a value without
  // one, so the round trip silently shifts the time. That needs a real date
  // control (DatePicker), not a type attribute.
  const FORMAT_TYPES = { email: 'email', uri: 'url', url: 'url' }
  const schemaType =
    FORMAT_TYPES[rule?.format] ??
    (rule?.type === 'integer' || rule?.type === 'number' ? 'number' : undefined)

  const resolvedType = stated(type, schemaType, 'text')
  const displayError = resolveError(form, name, error, errors)
  const hasError     = !!displayError

  // Constraint attributes. These are what assistive tech announces, so they
  // are worth emitting even with novalidate on the form suppressing the
  // browser's own bubbles.
  const resolvedRequired  = stated(required,  rule?.required)
  const resolvedMaxlength = stated(maxlength, rule?.maxLength)
  const resolvedMinlength = stated(minlength, rule?.minLength)
  const resolvedMin       = stated(min,       rule?.minimum)
  const resolvedMax       = stated(max,       rule?.maximum)

  // Exported methods — exposed via bind:this on this component
  let inputEl
  export function focus()  { inputEl?.focus() }
  export function select() { inputEl?.select() }

  function handleInput(e) {
    // An empty number field is empty, not zero: Number('') is 0, which silently
    // turned "the user cleared the box" into a real value the schema accepts.
    value = resolvedType === 'number'
      ? (e.target.value === '' ? '' : Number(e.target.value))
      : e.target.value
    oninput?.(e)
  }
</script>

{#snippet field()}
  <input
    bind:this={inputEl}
    class="field"
    id={inputId}
    name={name || undefined}
    type={resolvedType}
    value={value}
    placeholder={placeholder}
    disabled={disabled}
    required={resolvedRequired}
    readonly={readonly}
    pattern={pattern}
    min={resolvedMin}
    max={resolvedMax}
    step={step}
    maxlength={resolvedMaxlength}
    minlength={resolvedMinlength}
    autocomplete={autocomplete}
    list={listId}
    aria-invalid={hasError || null}
    on:input={handleInput}
    on:change={onchange}
    on:blur={onblur}
    on:focus={onfocus}
    on:keydown={onkeydown}
    on:keypress={onkeypress}
    {...$attributes}
  />
{/snippet}

<!-- The control, with the trailing addon when one was given. -->
{#snippet control()}
  {#if icon}
    <!-- .field-row joins a control to an addon; the addon sizes its own icon. -->
    <div class="field-row">
      {@render field()}
      <span class="field-addon">{@render icon?.()}</span>
    </div>
  {:else}
    {@render field()}
  {/if}
{/snippet}

{#if label || name}
  <!--
    label/required/type go through UNRESOLVED where the caller stated nothing:
    Field reads the same rule off the same form and resolves them once. Two
    components resolving the same fact from the same source is how they drift.
    `|| undefined` because '' is a real answer here — it suppresses the label —
    and only `undefined` means "not stated".
  -->
  <Field
    id={inputId}
    name={name}
    label={label || undefined}
    required={resolvedRequired}
    badge={badge}
    help={help}
    hint={hint}
    error={error}
    errors={errors}
    type={resolvedType}
    removable={removable}
    onremovekey={onremovekey}
    {class}
  >
    {@render control()}
  </Field>
{:else}
  {@render control()}
{/if}

{#if datalist}
  <datalist id={listId}>
    {#each datalist as opt (opt)}
      <option value={opt} />
    {/each}
  </datalist>
{/if}
