<script>
  // Tabs.mesa
  // Context provider. Manages the active tab state and provides registration
  // for keyboard navigation (ArrowLeft/ArrowRight cycling).
  //
  // @frontierjs/css draws the strip and keys the selected state off
  // `[aria-selected]` rather than a class — so the visual state and the
  // announced state cannot drift. This component supplies the behaviour the
  // stylesheet deliberately does not: roving tabindex, arrow keys, and which
  // panel is shown.
  //
  // Architecture:
  //   Tabs          — context provider, manages activeId  (.tabs)
  //   TabList       — the tab button strip                (.tablist)
  //   Tab           — individual tab button               (.tab)
  //   TabPanel      — content panel                       (.view)
  //
  // Usage:
  //   <Tabs bind:activeId>
  //     <TabList>
  //       <Tab id="general">General</Tab>
  //       <Tab id="security">Security</Tab>
  //     </TabList>
  //     <TabPanel id="general"><GeneralSettings /></TabPanel>
  //     <TabPanel id="security"><SecuritySettings /></TabPanel>
  //   </Tabs>

  export let activeId  = ''     // bindable — set by parent or defaulted on mount
  export let onchange  = undefined  // called with new activeId whenever tab changes
  // Tab registration list for keyboard nav — not reactive, used imperatively only.
  // var: non-reactive sampler — reads/writes invisible to reactive graph.
  // Entries are { id, isDisabled }, where isDisabled is a GETTER the Tab owns:
  // `disabled` is its prop and can change after registration, so a boolean
  // copied in here would go stale and the strip would keep stepping onto a tab
  // that has since been turned off.
  var _registry = []

  const ids       = () => _registry.map(t => t.id)
  const selectable = (id) => {
    const entry = _registry.find(t => t.id === id)
    return !!entry && !entry.isDisabled?.()
  }

  // The neighbour of `id` in `delta`'s direction, skipping every tab that
  // cannot be selected. A disabled tab is not a focus stop that does nothing —
  // it is worse: selecting it announces a disabled tab as selected, shows its
  // panel, and then refuses focus, so the next key is dispatched from wherever
  // focus was left behind.
  const adjacentId = (id, delta) => {
    const all = ids()
    const n = all.length
    if (!n) return null
    // -1 means the current tab is not registered at all; step from just
    // outside the strip so the first candidate is a real end rather than a
    // silent no-op.
    let i = all.indexOf(id)
    if (i === -1) i = delta > 0 ? -1 : 0
    for (let step = 1; step <= n; step++) {
      const cand = all[(((i + delta * step) % n) + n) % n]
      if (selectable(cand)) return cand
    }
    return null
  }

  // The first (delta < 0) or last (delta > 0) selectable tab. Home and End
  // cannot be built out of adjacentId: it wraps, so "step back from here" is
  // the tab before this one and never the start of the strip.
  const edgeId = (delta) => {
    const all = delta < 0 ? ids() : ids().reverse()
    return all.find(selectable) ?? null
  }

  // Initialize activeId from the first SELECTABLE tab if not set by parent.
  // Deferred to $onMount so tabs have time to register.
  $onMount(() => {
    if (!activeId && _registry.length) {
      const first = edgeId(-1)
      if (first) {
        activeId = first
        onchange?.(activeId)
      }
    }
  })

  // Provide reactive activeId and imperative controls to all descendants.
  // const consumers (Tab, TabPanel) always track this value (Rule 25a).
  $context.activeId = activeId

  $context.setActive = (id) => {
    activeId = id
    onchange?.(id)
  }

  // Registration — called by Tab on mount, for keyboard arrow navigation
  $context.registerTab = (id, isDisabled) => {
    if (!_registry.some(t => t.id === id)) _registry.push({ id, isDisabled })
  }

  $context.unregisterTab = (id) => {
    _registry = _registry.filter(t => t.id !== id)
  }

  // The id of the next/prev selectable tab, wrapping around
  $context.adjacent = adjacentId
  // The first/last selectable tab — Home and End
  $context.edge = edgeId
</script>

<div class="tabs" {class} {...$attributes}>
  <slot />
</div>
