<script>
  // Shell.mesa
  // The app frame — frame.css's `.shell` — drawn from the `src/lib/nav.js`
  // table (`@frontierjs/ui/nav`). What every signed-in `_module.mesa` rewrote
  // is here once: the wait for the session restore, the signed-out frame, the
  // nav drawn into the sidebar AND a Drawer below md, the drawer closing on
  // navigation, `aria-current`, the section bar and its toggle.
  //
  // This kit cannot import Sierra, so the page and the session arrive as props
  // from the `_module.mesa` that already reads them, and whether an entry is
  // current is Sierra's `isActive`, handed in:
  //
  //   <Shell {groups} {sections}
  //          path={page.pathname} query={page.query} title={page.title}
  //          user={session.user} level={session.level} checked={session.checked}
  //          {isActive} onsignout={out}>
  //     {#snippet brand()}<a href="/"><img src="/logo.svg" alt="ELA — home" /></a>{/snippet}
  //     {#snippet icon(name)}<Icon {name} />{/snippet}
  //     {#snippet badge(entry)}{#if entry.href === '/leads/'}<Badge>{open}</Badge>{/if}{/snippet}
  //     {#snippet foot(where)}{#if where === 'sidebar'}<Bell />{/if}{/snippet}
  //     {#snippet topbar()}…the right-hand cluster…{/snippet}
  //     <slot />
  //   </Shell>
  //
  // A group's or entry's `show` is called with `{ user, level }` and nothing
  // else. The session is a watched object mutated in place, so passed whole it
  // would reach this component once and never again; two scalars re-push.
  //
  // Signed out, the frame is drawn when the table offers a guest anything — a
  // shop's nav is public — and a narrow page with no frame when it offers
  // nothing. A members-only table says so with `show: ({ user }) => !!user`;
  // without it the sign-in page draws the members' nav.
  //
  // `layout` is `sidebar`, `rail` (frame.css's `.sidebar.rail.peek`, the
  // icons alone until hovered or focused) or `topbar` (an unlabeled group's
  // entries drawn flat in the bar, a labeled group as one menu named by its
  // label, and the drawer in place of the bar's nav below md). It may change
  // while mounted: collapsing a sidebar to a rail for good is the app
  // flipping it.
  // `foot(where)` is told `'sidebar'`, `'rail'`, `'drawer'` or `'topbar'`.
  //
  // `collapsible` puts a fold control at the head of a `sidebar` and
  // `bind:collapsed` is the choice. Folded, the sidebar is a plain rail and
  // not a peeking one: the control sits inside it, so a peeking rail would
  // open again under the pointer that just closed it. Remembering the choice
  // is the app's, as the key is its own: `bind:collapsed` and a
  // localStorage line.
  //
  // `foldable` draws each labeled group of a sidebar, and of the drawer, as a
  // <details> its label opens and closes. The first labeled group starts
  // open and every other closed, and the group holding the current page
  // opens on arrival, over a choice to close it: a page whose link is folded
  // away has no "you are here". A rail does not fold, as its icons are the
  // group, and a topbar's bar does not, as its group is already one menu;
  // its drawer does.

  import { sectionFor, visible } from '../../nav.js'
  import { uid } from '../../utils.js'
  import Drawer       from '../overlay/Drawer.mesa'
  import DropdownItem from '../overlay/DropdownItem.mesa'
  import DropdownMenu from '../overlay/DropdownMenu.mesa'

  export let groups    = []
  export let sections  = []
  export let path      = '/'
  export let query     = {}
  export let title     = ''
  export let user      = null
  export let level     = 0
  // Default true: an app with no session restore has nothing to wait for.
  export let checked   = true
  export let isActive  = undefined
  export let onsignout = undefined
  export let layout    = 'sidebar'
  export let collapsible = false
  export let collapsed   = false
  export let foldable    = false

  export let brand     = null   // snippet ()
  export let icon      = null   // snippet (name)
  export let badge     = null   // snippet (entry) — a count, drawn after the label
  export let foot      = null   // snippet (where) — 'sidebar' | 'rail' | 'drawer' | 'topbar'
  export let topbar    = null   // snippet ()

  const LAYOUTS = ['sidebar', 'rail', 'topbar']
  if (!LAYOUTS.includes(layout))
    console.warn(`[Shell] layout="${layout}" is not one of ${LAYOUTS.join(', ')}; drawing a sidebar`)
  if (collapsible && layout !== 'sidebar')
    console.warn(`[Shell] collapsible folds a sidebar; layout="${layout}" draws no fold control`)
  $: shape = LAYOUTS.includes(layout) ? layout : 'sidebar'

  // With no isActive nothing is ever current, and a nav with no current page
  // looks like a working nav.
  if (typeof isActive !== 'function' && (groups.length || sections.length))
    console.warn('[Shell] no isActive prop — pass Sierra\'s, or no entry is ever current')

  $: shown   = visible(groups, { user, level })
  $: section = sectionFor(sections, path)
  $: framed  = Boolean(user) || shown.length > 0
  $: folded  = shape === 'sidebar' && collapsible && collapsed
  // Folded is a rail: the foot is told so, and Sign out leaves for the bar.
  $: railed  = shape === 'rail' || folded

  const ids = uid('shell')

  function current(entry) {
    if (entry.match) return Boolean(entry.match(path, query ?? {}))
    return Boolean(isActive?.(entry.href, entry.exact ? { exact: true } : undefined))
  }

  // Navigating with the drawer open leaves it over the page it went to. A
  // query-only move (`/contacts/` to `/contacts/?kind=customer`) is a
  // navigation too.
  let navOpen = false
  $: path, query, () => { navOpen = false }

  // A group's label → open, for each group the reader opened or closed.
  // Every other group is open when it is the first labeled one or holds the
  // current page.
  let chosen = {}
  $: lead = shown.find(group => group.label)

  function isOpen(group, lead, chosen) {
    return chosen[group.label] ?? (group === lead || group.entries.some(current))
  }
  function choose(group, open) {
    if (isOpen(group, lead, chosen) !== open) chosen = { ...chosen, [group.label]: open }
  }
  $: path, query, () => {
    const here = shown.find(group => group.label && group.entries.some(current))
    if (here && chosen[here.label] === false) chosen = { ...chosen, [here.label]: true }
  }

  let signingOut = false
  async function signOut() {
    if (signingOut) return
    signingOut = true
    try { await onsignout?.() } finally { signingOut = false }
  }
</script>

<!--
  One definition of the nav, rendered in the sidebar and again in the drawer
  below md. Only one of the two is ever in the accessibility tree: frame.css
  hides the sidebar at that width, and a closed <dialog> is not exposed.

  Every aria-current here is inside an {#each} row, whose attributes are one
  effect that tracks whatever its calls read, isActive's own signals
  included. Lifted out of an {#each}, an expression naming no reactive value
  is set once at mount and the highlight never moves; it then needs a
  leading (path, query) read, as Sierra's isActive says.

  The label is a .navlink-text, which a .sidebar.rail fades rather than
  removes, so it stays the link's name.
-->
{#snippet entryLink(entry)}
  <a class="navlink" href={entry.href}
     aria-current={current(entry) ? 'page' : null}
  >{#if entry.icon}{@render icon?.(entry.icon)}{/if}<span class="navlink-text">{entry.label}</span>{@render badge?.(entry)}</a>
{/snippet}

<!-- A closed rail is an icon wide, so beside one Sign out is in the topbar,
     and only there: its word would be clipped to two letters, and the
     drawer's copy would be a second button on screen beside the bar's. -->
{#snippet signOutButton()}
  {#if onsignout && user}
    <button class="btn ghost" type="button" disabled={signingOut} onclick={signOut}>Sign out</button>
  {/if}
{/snippet}

<!-- frame.css shows this below md only, and at every width on a touch
     screen beside a rail, which no hover ever opens; opening the drawer is
     ours. -->
{#snippet drawerToggle()}
  <button class="btn ghost square sidebar-toggle" type="button"
          aria-label="Open navigation" aria-expanded={navOpen}
          onclick={() => navOpen = true}>
    <svg class="icon" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 20 20" fill="currentColor" aria-hidden="true">
      <path d="M2 4.75A.75.75 0 0 1 2.75 4h14.5a.75.75 0 0 1 0 1.5H2.75A.75.75 0 0 1 2 4.75Zm0 5.25a.75.75 0 0 1 .75-.75h14.5a.75.75 0 0 1 0 1.5H2.75A.75.75 0 0 1 2 10Zm0 5.25a.75.75 0 0 1 .75-.75h14.5a.75.75 0 0 1 0 1.5H2.75a.75.75 0 0 1-.75-.75Z"/>
    </svg>
  </button>
{/snippet}

{#snippet drawer()}
  <Drawer side="left" bind:open={navOpen} title="Navigation">
    <nav class="stack" aria-label="Main">
      {@render navigation('drawer')}
    </nav>
  </Drawer>
{/snippet}

{#snippet navigation(where)}
  {#if collapsible && shape === 'sidebar' && where !== 'drawer'}
    <button class="btn ghost square shell-fold" type="button"
            aria-label={collapsed ? 'Expand the sidebar' : 'Collapse the sidebar'}
            aria-expanded={collapsed ? 'false' : 'true'}
            title={collapsed ? 'Expand the sidebar' : 'Collapse the sidebar'}
            onclick={() => collapsed = !collapsed}>
      <svg class="icon" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor"
           stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
        <path d="M5 3h14a2 2 0 0 1 2 2v14a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2z" />
        <path d="M9 3v18" />
        {#if collapsed}<path d="M14 9l3 3-3 3" />{:else}<path d="M16 15l-3-3 3-3" />{/if}
      </svg>
    </button>
  {/if}
  {@render brand?.()}
  {#each shown as group, gi}
    {#if foldable && group.label && where !== 'rail'}
      <!-- The open state is read with (path, query) first, for the same
           reason as a topbar trigger's aria-current below. -->
      <details open={(path, query, isOpen(group, lead, chosen))}
               ontoggle={event => choose(group, event.currentTarget.open)}>
        <summary class="navlist-label" id="{ids}-{where}-{gi}">{group.label}</summary>
        <ul class="navlist" aria-labelledby="{ids}-{where}-{gi}">
          {#each group.entries as entry}
            <li>{@render entryLink(entry)}</li>
          {/each}
        </ul>
      </details>
    {:else}
      <div>
        {#if group.label}
          <div class="navlist-label" id="{ids}-{where}-{gi}">{group.label}</div>
        {/if}
        <ul class="navlist" aria-labelledby={group.label ? `${ids}-${where}-${gi}` : null}>
          {#each group.entries as entry}
            <li>{@render entryLink(entry)}</li>
          {/each}
        </ul>
      </div>
    {/if}
  {/each}
  {@render foot?.(where)}
  {#if !railed && shape !== 'topbar' && onsignout && user}
    <div>{@render signOutButton()}</div>
  {/if}
{/snippet}

{#snippet sectionBar()}
  <!-- The page's heading: an app whose frame carried it writes none of its
       own, so a <strong> here leaves a screen reader's heading list empty.
       .h5 holds the size a bar title needs; .h6 would uppercase it. -->
  {#if title}<h1 class="h5">{title}</h1>{/if}
  {#if section?.tabs?.length || section?.action}
    <nav class="cluster" aria-label="Section">
      {#each section.tabs ?? [] as tab}
        <a class="navlink" href={tab.href}
           aria-current={current(tab) ? 'page' : null}>{tab.label}</a>
      {/each}
      {#if section.action}
        <a class="btn primary" href={section.action.href}>{section.action.label}</a>
      {/if}
    </nav>
  {/if}
{/snippet}

{#if !checked}
  <!-- The restore is in flight: drawing the signed-out frame now is a flash
       of the wrong page on every cold load. -->
{:else if framed && shape === 'topbar'}
  <!-- A labeled group is one menu, so a table of a dozen screens still fits
       one line; below md the bar's nav gives way to the drawer, which writes
       every group out. The section bar heads the Screen, because the bar is
       the nav's now.

       The trigger's aria-current is drawn inside DropdownMenu and not in the
       {#each} row's effect, so it reads (path, query) first or it is set once
       at mount. -->
  <div class="shell" {class} {...$attributes}>
    <a class="skip-link" href="#screen">Skip to content</a>

    <header class="topbar">
      <div class="cluster">
        {@render drawerToggle()}
        {@render brand?.()}
        <nav class="cluster topbar-nav" aria-label="Main">
          {#each shown as group}
            {#if group.label}
              <DropdownMenu>
                {#snippet trigger()}
                  <button class="navlink" type="button"
                          aria-current={(path, query, group.entries.some(current)) ? 'true' : null}
                  >{group.label} ▾</button>
                {/snippet}
                {#each group.entries as entry}
                  <DropdownItem href={entry.href} aria-current={current(entry) ? 'page' : null}>
                    {entry.label}
                    {#snippet trailing()}{@render badge?.(entry)}{/snippet}
                  </DropdownItem>
                {/each}
              </DropdownMenu>
            {:else}
              {#each group.entries as entry}{@render entryLink(entry)}{/each}
            {/if}
          {/each}
        </nav>
      </div>
      <div class="cluster">
        {@render topbar?.()}
        {@render foot?.('topbar')}
        {@render signOutButton()}
      </div>
    </header>

    <main class="screen" id="screen" tabindex="-1">
      {#if title || section?.tabs?.length || section?.action}
        <div class="cluster">{@render sectionBar()}</div>
      {/if}
      <slot />
    </main>
  </div>

  {@render drawer()}
{:else if framed}
  <div class="shell sidebar-first" {class} {...$attributes}>
    <a class="skip-link" href="#screen">Skip to content</a>

    <nav class="sidebar stack" class:rail={railed} class:peek={shape === 'rail'} aria-label="Main">
      {@render navigation(railed ? 'rail' : 'sidebar')}
    </nav>

    <header class="topbar">
      <div class="cluster">
        {@render drawerToggle()}
        {@render sectionBar()}
      </div>
      {#if topbar || (railed && onsignout && user)}
        <div class="cluster">
          {@render topbar?.()}
          {#if railed}{@render signOutButton()}{/if}
        </div>
      {/if}
    </header>

    <main class="screen" id="screen" tabindex="-1">
      <slot />
    </main>
  </div>

  {@render drawer()}
{:else}
  <main class="screen" id="screen" {class} {...$attributes}>
    <div class="container narrow">
      <slot />
    </div>
  </main>
{/if}

<style>
  /* Layout only: pushed to the sidebar's far edge, and to its middle once
     folded to a rail, where the icons are centered. */
  .shell-fold { display: flex; margin-inline-start: auto; }
  .sidebar.rail .shell-fold { margin-inline: auto; }
</style>
