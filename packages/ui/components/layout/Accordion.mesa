<script>
  // Accordion.mesa
  // Context provider for AccordionItem components.
  // Manages which panels are open using an immutable object (keyed by item id).
  //
  // Each item is a native <details class="disclosure"> — @frontierjs/css builds
  // the pattern on <details>/<summary> so the caret, the keyboard handling and
  // the open state are the platform's. This component only coordinates which
  // ones may be open at once, which is the one thing <details> cannot do
  // portably (the `name` attribute is newer than the package's browser floor).
  //
  // Usage:
  //   <Accordion>
  //     <AccordionItem id="faq-1" label="What is Mesa?">
  //       Mesa is a reactive UI language...
  //     </AccordionItem>
  //     <AccordionItem id="faq-2" label="How does reactivity work?">
  //       ...
  //     </AccordionItem>
  //   </Accordion>

  export let multiple    = false   // allow multiple items open simultaneously
  export let defaultOpen = []      // id[] of initially open items
  // openIds: { [id]: boolean } — replaced (not mutated) on every toggle
  // for reactive context updates. Per Rule 25a, const consumers in AccordionItem
  // that read $context.openIds will re-derive when this signal changes.
  let openIds = Object.fromEntries(defaultOpen.map(id => [id, true]))

  // Provide reactive open state and toggle function to all descendant AccordionItems
  $context.openIds = openIds

  $context.toggle = (id) => {
    if (multiple) {
      openIds = { ...openIds, [id]: !openIds[id] }
    } else {
      openIds = openIds[id] ? {} : { [id]: true }
    }
  }
</script>

<!-- .stack gives the gap between items; each item draws its own border. -->
<div class="stack" style:gap="0.5rem" {class}>
  <slot />
</div>
