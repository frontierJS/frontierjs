<script>
  // DropdownMenu.mesa
  // Positioned action menu triggered by a button. Portals to overlayHost() so it
  // escapes overflow:hidden containers. Keyboard navigable via ArrowUp/Down, Home, End and
  // type-to-jump.
  //
  // Compound component — compose with DropdownItem, DropdownSeparator, DropdownGroup,
  // DropdownSubmenu.
  //
  // Usage:
  //   <DropdownMenu>
  //     {#snippet trigger()}
  //       <Button treatment="ghost" square><IconDots /></Button>
  //     {/snippet}
  //     <DropdownGroup heading="Actions">
  //       <DropdownItem onclick={handleEdit}>
  //         {#snippet icon()}<IconEdit />{/snippet}
  //         Edit
  //       </DropdownItem>
  //     </DropdownGroup>
  //     <DropdownSeparator />
  //     <DropdownItem tone="danger" onclick={handleDelete}>Delete</DropdownItem>
  //   </DropdownMenu>
  //
  // keepOpen: choosing a row leaves the menu open — for a toggle, a checkbox
  // row. A row's own `keepOpen` wins over this default.
  //
  // Placement: '<side>-<align>' — side top | bottom | left | right, align
  // start | center | end. The side flips when the panel would overflow the
  // viewport there. A panel taller than the viewport scrolls, or its last
  // rows sit below the window's edge; a menu that fits neither below nor
  // above its trigger still runs past the edge (FJS-4063).

  import { placeAgainst, FOCUSABLE, overlayHost, menuWalk } from '../../utils.js'

  export let placement = 'bottom-start'
  export let offset    = 4               // gap between trigger and panel in px
  export let trigger   = null            // snippet — the button that opens the menu
  export let keepOpen  = false           // default for every row: choosing one leaves the menu open

  let open      = false
  let x         = 0
  let y         = 0
  let maxH      = null           // set only when neither side of the trigger holds the panel
  let placed    = false         // has THIS open been positioned yet
  let triggerEl
  let panelEl
  let menuEl

  // The rows, the row holding focus and the trigger's control are held by
  // reference. A terminal node has no querySelector, activeElement or
  // document to ask, so a walk that finds them by query moves nothing there
  // and a close puts focus nowhere.
  var rows    = []
  var cursor  = null
  var control = null

  // Provide close() so DropdownItem descendants can close the menu after selection.
  // Arrow function closes over this component's closeMenu — correct scope. ✓
  $context.close = () => closeMenu()
  $context.keepOpen = keepOpen
  // A row hands over `{ el, disabled, label }` as getters and gets back the
  // call that withdraws it. `rowFocus` is told when a row takes or gives up focus.
  $context.addRow = (row) => {
    rows.push(row)
    return () => { rows = rows.filter((r) => r !== row); if (cursor === row) cursor = null }
  }
  $context.rowFocus = (row, on) => { if (on) cursor = row; else if (cursor === row) cursor = null }
  // A DropdownSubmenu's panel is portaled beside this one, so a press inside
  // it is outside `panelEl`. Each submenu hands over a getter for its panel.
  var subPanels = []
  $context.addPanel = (get) => {
    subPanels.push(get)
    return () => { subPanels = subPanels.filter((g) => g !== get) }
  }

  const panelAnim = $.entrance({
    in:  el => el.animate?.(
      [{ opacity: 0, transform: 'scale(0.96) translateY(-4px)' },
       { opacity: 1, transform: 'scale(1) translateY(0)' }],
      { duration: 130, easing: 'cubic-bezier(0.16,1,0.3,1)', fill: 'forwards' }
    ),
    out: el => el.animate?.(
      [{ opacity: 1, transform: 'scale(1)' }, { opacity: 0, transform: 'scale(0.96)' }],
      { duration: 90, fill: 'forwards' }
    )?.finished,
  })

  function openMenu() {
    if (open) { closeMenu(); return }
    // `x`/`y` still hold the last open's placement, and the panel has to exist
    // before it can be measured — so it is rendered hidden and shown by the
    // frame that places it. Painted at the stale coordinates it lands wherever
    // the trigger used to be, which after any scroll can be ON the trigger:
    // the click meant to close the menu then falls inside the panel, where
    // click-away deliberately lets it through, and the menu stays open.
    placed = false
    maxH   = null
    open   = true
    requestAnimationFrame(async () => {
      await position()
      placed = true
      // After the flush, not before it: focus is refused on a `visibility:
      // hidden` element, and `placed` only reaches the DOM on mesa's microtask.
      //
      // The [role=menu] and not `panelEl`: the surface it is bound to carries
      // no tabindex, so focusing it moved nothing and the keyboard walk below
      // only worked because an absent focus and a focused panel both make
      // `indexOf(activeElement)` -1.
      queueMicrotask(() => $.focus(menuEl))
    })
  }

  // The control the trigger's snippet drew: the one that held focus when the
  // menu opened, else the first the DOM can find. A browser that does not focus
  // a button on press (Safari) never reports one.
  function controlOf() {
    return control ?? triggerEl?.querySelector?.('button,a,[tabindex="0"]')
  }

  function closeMenu(restoreFocus = true) {
    open = false
    if (restoreFocus) $.focus(controlOf())
  }

  async function position() {
    const [tr, pr, vp] = await Promise.all([$.measure(triggerEl), $.measure(panelEl), $.viewport()])
    if (!tr || !pr) return
    const at = placeAgainst(tr, pr, vp, { placement, offset })
    x = at.x
    y = at.y
    maxH = at.maxHeight ?? null
  }

  // Heard on every click, open or not: closing a closed menu would still
  // take focus back to its trigger.
  function onClickAway(e) {
    if (!open) return
    if (triggerEl?.contains(e.target) || panelEl?.contains(e.target)) return
    if (subPanels.some((get) => get()?.contains(e.target))) return
    // A row asking `data-confirm` is answered in a panel outside this one.
    // Pressing its confirm button must not unmount the row, or the re-fired
    // click lands on a detached element and the guarded handler never runs.
    if (panelEl?.querySelector?.('[data-confirm]') && e.target?.closest?.('[data-confirm-panel]')) return
    // Clicking another field to dismiss must leave focus on that field.
    closeMenu(!e.target?.closest?.(FOCUSABLE))
  }

  const walk = menuWalk()

  function handleKeydown(e) {
    if (!open) return
    if (e.key === 'Escape') { if (!e.defaultPrevented) { e.preventDefault(); closeMenu() } return }
    if (e.key === 'Tab')    { closeMenu(); return }
    const step = walk(rows, cursor, e)
    if (!step) return
    e.preventDefault()
    $.focus(step.next?.el())
  }

  // Keep the caller's control in sync with the menu's state.
  //
  // `triggerEl` is in the watch list, not just `open`. Watching `open` alone
  // fires only when the menu is first OPENED — and the element is null on the
  // run before that anyway — so a trigger announced nothing at all until
  // somebody had already used it. A screen reader met an ordinary button,
  // which is the one thing this component exists to prevent.
  $: (open, triggerEl), () => {
    const control = triggerEl?.querySelector?.('button, a, [role="button"], [tabindex]') ?? triggerEl
    if (!control?.setAttribute) return
    control.setAttribute('aria-haspopup', 'menu')
    control.setAttribute('aria-expanded', open ? 'true' : 'false')
  }
</script>

<mesa:window onkeydown={handleKeydown} onclick|capture={onClickAway} />

<!--
  The trigger announces the menu it controls. Without aria-haspopup and
  aria-expanded a screen reader hears an ordinary button and is never told a
  menu opened — the component's whole job is the behavior the stylesheet
  cannot supply, and this is part of it.

  The attributes are written onto the caller's own control rather than onto
  this wrapper: the wrapper is not focusable, so state announced there is state
  nobody hears. The snippet's markup belongs to the caller, so this is the one
  place the component reaches into the DOM instead of declaring it.
-->
<span
  bind:this={triggerEl}
  style:display="inline-block"
  {class}
  {...$attributes}
  onfocusin={(e) => control = e.target}
  onclick|stopPropagation={openMenu}
>
  {@render trigger?.()}
</span>

{#if open}
  <mesa:portal to={overlayHost()}>
    <!--
      .popover is the surface; .items.menu is the interactive list inside it,
      which is what gives DropdownItem's `.item` its hover and padding.
    -->
    <div
      bind:this={panelEl}
      class="popover"
      style:position="fixed"
      style:min-inline-size="10rem"
      style:max-inline-size="16rem"
      style:max-block-size={maxH == null ? 'calc(100dvh - 16px)' : `${maxH}px`}
      style:overflow-y="auto"
      style:padding="0.25rem"
      style:left="{x}px"
      style:top="{y}px"
      style:visibility="{placed ? 'visible' : 'hidden'}"
      {@attach panelAnim}
    >
      <div bind:this={menuEl} class="items menu" role="menu" tabindex="-1">
        <slot />
      </div>
    </div>
  </mesa:portal>
{/if}
