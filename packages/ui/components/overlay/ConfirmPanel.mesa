<script>
  // ConfirmPanel.mesa
  // The two-button confirmation itself, anchored to an element.
  //
  // Two things ask for one: `ConfirmationPopover`, which wraps a trigger of its
  // own, and `ConfirmProvider`, which has no trigger at all — it is handed the
  // element somebody clicked. So the panel is the component and the anchor is a
  // prop; the alternative was the same panel written twice, drifting on which
  // one traps focus and which one closes on Escape.
  //
  // Not a modal: `aria-modal="false"`, no focus trap. Right for a two-button
  // confirmation, and it means Escape and click-away are wired here.
  //
  // The parent decides WHEN it exists (`{#if open}`); this file decides where it
  // sits, what it says and which of the two answers came back.
  import { tone as toTone, cx, uid, placeAgainst, overlayHost } from '../../utils.js'

  export let anchor       = null       // the Element it points at
  export let title        = 'Are you sure?'
  export let message      = 'This action cannot be undone.'
  export let confirmLabel = 'Confirm'
  export let cancelLabel  = 'Cancel'
  export let tone         = 'danger'
  export let onconfirm    = undefined
  export let oncancel     = undefined

  let x      = 0
  let y      = 0
  let placed = false                   // has THIS open been positioned yet
  let panelEl
  let confirmEl

  const titleId = uid('confirm-title')

  const panelAnim = $.entrance({
    in:  el => el.animate?.(
      [{ opacity: 0, transform: 'scale(0.95) translateY(-4px)' },
       { opacity: 1, transform: 'scale(1) translateY(0)' }],
      { duration: 140, easing: 'cubic-bezier(0.16,1,0.3,1)', fill: 'forwards' }
    ),
    out: el => el.animate?.(
      [{ opacity: 1, transform: 'scale(1)' }, { opacity: 0, transform: 'scale(0.95)' }],
      { duration: 100, fill: 'forwards' }
    )?.finished,
  })

  async function position() {
    const [ar, pr, vp] = await Promise.all([$.measure(anchor), $.measure(panelEl), $.viewport()])
    if (!ar || !pr) return
    ;({ x, y } = placeAgainst(ar, pr, vp, { offset: 8 }))
  }

  function onClickAway(e) {
    if (anchor?.contains?.(e.target) || panelEl?.contains(e.target)) return
    oncancel?.()
  }

  $.onMount(async () => {
    // Placed off the measure, never a frame, and only then made visible: a
    // panel painted before it is positioned appears wherever the last one was
    // (`FJS-331`). Waiting for a frame callback is a bet that a frame arrives —
    // headless Chrome delivers almost no rendering lifecycle after load, so the
    // panel stayed `visibility: hidden` at 0,0 and a click aimed at its confirm
    // button landed on whatever was behind it.
    await position()
    placed = true

    // And again once the browser does have a frame, for the case where the
    // panel's own content changed its size between the two.
    requestAnimationFrame(position)

    // Focus into the panel, or a keyboard user is left on the trigger with a
    // dialog open they cannot reach. After the flush: focus is refused on a
    // `visibility: hidden` element, and `placed` only reaches the DOM on
    // mesa's microtask.
    queueMicrotask(() => $.focus(confirmEl))
  })

  // Escape is taken, so nothing after this listener — a terminal shell going
  // back a screen — answers it too.
  function onKeydown(e) {
    if (e.key !== 'Escape') return
    e.preventDefault()
    oncancel?.()
  }
</script>

<mesa:window onkeydown={onKeydown} onclick|capture={onClickAway} />

<mesa:portal to={overlayHost()}>
  <div
    bind:this={panelEl}
    class="popover stack"
    style:position="fixed"
    style:gap="0.5rem"
    style:inline-size="16rem"
    style:max-width="16rem"
    style:left="{x}px"
    style:top="{y}px"
    style:visibility="{placed ? 'visible' : 'hidden'}"
    {@attach panelAnim}
    role="dialog"
    aria-modal="false"
    data-confirm-panel
    aria-labelledby={titleId}
  >
    <strong id={titleId}>{title}</strong>
    {#if message}
      <p class="text-sm text-muted" style:margin="0">{message}</p>
    {/if}
    <div class="cluster" style:justify-content="flex-end">
      <button type="button" class="btn ghost" onclick={() => oncancel?.()}>
        {cancelLabel}
      </button>
      <button bind:this={confirmEl} type="button" class={cx('btn', toTone(tone) || 'danger')}
              onclick={() => onconfirm?.()}>
        {confirmLabel}
      </button>
    </div>
  </div>
</mesa:portal>
