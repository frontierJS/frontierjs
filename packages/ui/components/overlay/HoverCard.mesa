<script>
  // HoverCard.mesa
  // One card for MANY triggers. The region is the children; every element in it
  // matching `selector` is a trigger, found by two listeners on a wrapper
  // rather than one component per trigger. `Popover` wraps ONE trigger and
  // opens on click, `Tooltip` is text on one element, so a page of thousands of
  // trigger words would mount thousands of either.
  //
  // The card is the same surface as a Popover panel (`.popover`), portaled to
  // overlayHost() for the same reasons (FJS-D904) and placed by the same
  // placeAgainst. It opens after `delay` on hover and at once on focus, stays
  // open while the pointer is over the trigger OR the card (so a link inside
  // it is reachable), moves from trigger to trigger without closing, and
  // Escape dismisses it.
  //
  // `content` is handed the trigger element, which is how one snippet renders
  // a card for whichever trigger is current:
  //
  //   <HoverCard selector="[data-word]">
  //     {#snippet children()}
  //       <p>… <span data-word="serendipity" tabindex="0">serendipity</span> …</p>
  //     {/snippet}
  //     {#snippet content(el)}
  //       <Definition word={el.dataset.word} />
  //     {/snippet}
  //   </HoverCard>
  //
  // A trigger must be focusable (`tabindex="0"`, a button or a link) to reach
  // the card by keyboard; hover alone is no way to read it on a touch screen,
  // which has no hover, so a touch pointer never opens it.

  import { tone as toTone, cx, placeAgainst, overlayHost, uid } from '../../utils.js'

  export let selector   = '[data-hovercard]'  // what counts as a trigger
  export let placement  = 'bottom-start'      // '<side>-<align>', as Popover
  export let offset     = 8                   // gap between trigger and card, px
  export let delay      = 250                 // ms the pointer rests before it opens
  export let closeDelay = 100                 // ms of grace crossing from trigger to card
  export let tone       = ''
  export let label      = ''                  // accessible name for the card
  export let children   = null                // snippet — the region holding the triggers
  export let content    = null                // snippet — receives the current trigger

  let open    = false
  let current = null                          // the trigger the card is for
  let x       = 0
  let y       = 0
  let placed  = false
  let maxH    = null     // set only when neither side of the trigger holds the card
  let panelEl

  let pending = null                          // the trigger the open wait is for
  let overs   = 0
  let leaving = false                         // the close grace is running
  let leaves  = 0
  var described  = null                       // the trigger carrying aria-describedby

  const t      = toTone(tone)
  const cardId = uid('hovercard')

  const panelAnim = $.entrance({
    in:  el => el.animate(
      [{ opacity: 0, transform: 'scale(0.96) translateY(-4px)' },
       { opacity: 1, transform: 'scale(1) translateY(0)' }],
      { duration: 140, easing: 'cubic-bezier(0.16,1,0.3,1)', fill: 'forwards' }
    ),
    out: el => el.animate(
      [{ opacity: 1, transform: 'scale(1)' }, { opacity: 0, transform: 'scale(0.96)' }],
      { duration: 100, fill: 'forwards' }
    ).finished,
  })

  function triggerOf(e) {
    return e.target?.closest?.(selector) ?? null
  }

  function describe(el) {
    if (described === el) return
    described?.removeAttribute?.('aria-describedby')
    described = el
    el?.setAttribute?.('aria-describedby', cardId)
  }

  function show(el) {
    pending = null
    leaving = false
    if (open && current === el) return
    // A card already open follows the pointer from word to word; a closed one
    // renders hidden first, because it cannot be measured until it exists.
    placed  = open
    maxH    = null
    open    = true
    current = el
    describe(el)
    requestAnimationFrame(async () => { await position(el); placed = true })
  }

  async function position(el) {
    const [tr, pr, vp] = await Promise.all([$.measure(el), $.measure(panelEl), $.viewport()])
    // The pointer has since moved to another trigger, which has its own frame.
    if (!tr || !pr || current !== el) return
    const at = placeAgainst(tr, pr, vp, { placement, offset })
    ;({ x, y } = at)
    maxH = at.maxHeight ?? null
  }

  function hide() {
    pending = null
    leaving = false
    open = false
    current = null
    describe(null)
  }

  function onOver(e) {
    if (e.pointerType === 'touch') return
    const el = triggerOf(e)
    if (!el) return
    leaving = false
    pending = null
    // Open with no wait when the card is already up: the wait is for a pointer
    // passing over, not for one moving between words.
    if (open) show(el)
    else { pending = el; overs++ }
  }

  // Left the trigger for somewhere that is neither it nor the card.
  function onOut(e) {
    const el = triggerOf(e)
    if (!el || el.contains(e.relatedTarget)) return
    pending = null
    if (e.relatedTarget?.closest?.(selector) || panelEl?.contains(e.relatedTarget)) return
    leaving = true
    leaves++
  }

  function onFocusIn(e) {
    const el = triggerOf(e)
    if (el) show(el)
  }

  function onFocusOut(e) {
    if (!triggerOf(e) || panelEl?.contains(e.relatedTarget)) return
    if (e.relatedTarget?.closest?.(selector)) return
    hide()
  }

  function onCardLeave(e) {
    if (current?.contains(e.relatedTarget)) return
    leaving = true
    leaves++
  }

  // Counted, so every pass restarts its wait: keyed on the trigger alone, a
  // pointer crossing a trigger's children opened the card on the first
  // crossing's schedule, and a second leave closed it on the first's.
  $.after(delay, () => show(pending), { key: overs, when: pending })
  $.after(closeDelay, hide, { key: leaves, when: leaving })

  $.onDestroy(() => {
    described?.removeAttribute?.('aria-describedby')
  })
</script>

<mesa:window onkeydown={(e) => { if (e.key === 'Escape' && open && !e.defaultPrevented) hide() }} />

<span
  style:display="contents"
  {class}
  {...$attributes}
  onpointerover={onOver}
  onpointerout={onOut}
  onfocusin={onFocusIn}
  onfocusout={onFocusOut}
>
  {@render children?.()}
</span>

{#if open}
  <mesa:portal to={overlayHost()}>
    <div
      bind:this={panelEl}
      id={cardId}
      class={cx('popover', t)}
      role="group"
      aria-label={label || null}
      style:position="fixed"
      style:left="{x}px"
      style:top="{y}px"
      style:max-block-size={maxH == null ? null : `${maxH}px`}
      style:overflow-y={maxH == null ? null : 'auto'}
      style:visibility="{placed ? 'visible' : 'hidden'}"
      onpointerenter={() => { leaving = false }}
      onpointerleave={onCardLeave}
      {@attach panelAnim}
    >
      {@render content?.(current)}
    </div>
  </mesa:portal>
{/if}
