<script>
  // Tooltip.mesa
  // Informational label attached to a control.
  //
  // ── Why this is anchored rather than portaled ────────────────────────
  //
  // @frontierjs/css's Tooltip is `.tooltip-anchor` wrapping the trigger and the
  // `.tooltip` together, shown via :focus-within/:hover. That buys the three
  // things that make a tooltip accessible, and the previous portal version had
  // none of them:
  //
  //   1. aria-describedby on the trigger, pointing at the tooltip's id. Without
  //      it the tooltip is a hover style and a screen reader never sees it.
  //   2. Shows on focus, not only hover — so a keyboard user gets it by tabbing.
  //   3. Escape dismisses it. That part is behaviour, so it is handled here.
  //
  // The trade-off is real: an anchored tooltip is clipped by an ancestor with
  // overflow:hidden, which a portal escapes. Prefer this; reach for a Popover
  // when you genuinely need to break out of a scroll container.
  //
  // Never put essential information only in a tooltip — touch devices have no
  // hover at all.
  //
  // Usage:
  //   <Tooltip label="Saved to cloud">
  //     <Button>Save</Button>
  //   </Tooltip>
  //
  // ── Reaching the id from the trigger ─────────────────────────────────
  //
  // The trigger has to carry `aria-describedby`, and only the caller can put
  // it there. Two ways, and the second is the one to reach for when the
  // trigger is a plain element:
  //
  //   <Tooltip label="Delete" id="del-tip">
  //     <button class="btn square" aria-describedby="del-tip">…</button>
  //   </Tooltip>
  //
  //   <Tooltip label="Delete">
  //     {#snippet children(tipId)}
  //       <button class="btn square" aria-describedby={tipId}>…</button>
  //     {/snippet}
  //   </Tooltip>
  //
  // Mesa has no `let:` directive, and a `<slot>` carries no values to its
  // caller — an attribute written on one is silently ignored. The snippet
  // parameter is the only way a child hands something back, so the generated
  // id travels through `children` and `<slot />` is the fallback for content
  // that does not need it.

  import { uid } from '../../utils.js'

  export let label    = ''      // tooltip text
  export let id       = ''      // override the generated id
  export let children = null    // snippet — receives the tooltip's id

  const tipId = id || uid('tip')

  let dismissed = false

  function onKeydown(e) {
    if (e.key === 'Escape') dismissed = true
  }
  function onEnter() { dismissed = false }
</script>

<span
  class="tooltip-anchor"
  {class}
  {...$attributes}
  on:keydown={onKeydown}
  on:mouseenter={onEnter}
  on:focusin={onEnter}
>
  {#if children}
    {@render children(tipId)}
  {:else}
    <slot />
  {/if}

  {#if label}
    <span class="tooltip" role="tooltip" id={tipId} hidden={dismissed || null}>
      {label}
    </span>
  {/if}
</span>
