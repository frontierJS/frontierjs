<script>
  // CommandPalette.mesa
  // Full ⌘K command palette. Converted from React. Dark-themed, keyboard navigable,
  // grouped results, fuzzy search across label + sub + group.
  //
  // ITEM SHAPE:
  //   {
  //     id:      string           — unique key
  //     group:   string           — section heading
  //     label:   string           — primary text (searched)
  //     icon?:   string           — emoji or text glyph
  //     sub?:    string           — secondary text (searched)
  //     kbd?:    string           — shortcut hint shown on row ("⌘ D")
  //     badge?:  string           — accent badge ("New", "Beta")
  //     color?:  string           — CSS color for sub text
  //     action:  () => void       — called on select
  //   }
  //
  // USAGE:
  //   import { commandPalette } from '../stores/commandPaletteStore.js'
  //   $: commandPalette.open
  //
  //   <mesa:window on:keydown={(e) => {
  //     if ((e.metaKey || e.ctrlKey) && e.key === 'k') {
  //       e.preventDefault()
  //       commandPalette.toggle()
  //     }
  //   }} />
  //
  //   {#if commandPalette.open}
  //     <CommandPalette
  //       items={COMMANDS}
  //       groupOrder={['Navigate', 'Actions', 'Servers']}
  //       onclose={() => commandPalette.hide()}
  //     />
  //   {/if}

  import { uid } from '../../utils.js'
  import { rank, segments } from '@frontierjs/toolbelt/search'

  export let items        = []      // Item[]
  export let placeholder  = 'Search commands…'
  export let groupOrder   = []      // explicit group sort order
  export let emptyText    = undefined  // (query: string) => string
  export let onclose      = undefined

  // export var — snapshot at mount, layout never changes after open
  export var maxHeight     = '62vh'
  export var maxWidth      = 580
  export var closeOnSelect = true

  // ── State ────────────────────────────────────────────────────────────────
  let query = ''
  let idx   = 0
  let inputEl
  let listEl

  // Focus never leaves the search box, so `aria-selected` moving down the list
  // says nothing on its own — the input has to NAME the row Enter would run,
  // and a row can only be named if it has an id.
  const listId = uid('cp')
  const rowId  = (item) => `${listId}-${item.id}`

  // Focus search input immediately on mount
  $.onMount(() => inputEl?.focus())

  // ── Derived chain ────────────────────────────────────────────────────────
  // Each const auto-derives when its dependencies change (Rule 2).
  // query → filtered → groupMap → groupNames → flat — all reactive.

  // Ranked across all three fields. This was `includes()` with no ordering at
  // all, so every command that contained the query came back in registration
  // order — typing the exact name of a command could leave it below six others
  // that merely mention the word.
  const ranked = query.trim()
    ? rank(items, query, { keys: ['label', 'group', 'sub'] })
    : null

  const filtered = ranked ? ranked.map(r => r.item) : items

  // Per-FIELD ranges, so the label is marked with the label's match and the sub
  // line with its own. One flat range list would mark whichever field happened
  // to score best at offsets belonging to the other.
  const marksOf = new Map((ranked ?? []).map(r => [r.item, r.byKey ?? {}]))

  const groupMap = filtered.reduce((acc, c) => {
    if (!acc[c.group]) acc[c.group] = []
    acc[c.group].push(c)
    return acc
  }, {})

  const allGroups  = Object.keys(groupMap)
  const groupNames = groupOrder.length
    ? [...groupOrder.filter(g => groupMap[g]), ...allGroups.filter(g => !groupOrder.includes(g))]
    : allGroups

  // Flat list across all groups — used for keyboard navigation bounds + scrollIntoView
  const flat = groupNames.flatMap(g => groupMap[g] ?? [])

  // Precomputed id → flat index map — O(1) active lookup per row
  const flatIdx = Object.fromEntries(flat.map((item, i) => [item.id, i]))

  // ── Watchers ─────────────────────────────────────────────────────────────

  // Reset cursor to top when query changes
  $: query, () => { idx = 0 }

  // Scroll active row into view whenever idx moves
  $: idx, () => {
    listEl?.querySelector('[data-active="true"]')
           ?.scrollIntoView({ block: 'nearest' })
  }

  // ── Actions ───────────────────────────────────────────────────────────────

  function run(item) {
    item.action()
    if (closeOnSelect) close()
  }

  function close() {
    onclose?.()
  }

  function handleKeydown(e) {
    switch (e.key) {
      case 'ArrowDown':
        e.preventDefault()
        idx = Math.min(idx + 1, flat.length - 1)
        break
      case 'ArrowUp':
        e.preventDefault()
        idx = Math.max(idx - 1, 0)
        break
      case 'Enter':
        e.preventDefault()
        if (flat[idx]) run(flat[idx])
        break
      case 'Escape':
        close()
        break
    }
  }

  // ── Animation ─────────────────────────────────────────────────────────────

  const backdropAnim = $.entrance({
    in:  el => el.animate(
      [{ opacity: 0 }, { opacity: 1 }],
      { duration: 100, fill: 'forwards' }
    ),
    out: el => el.animate(
      [{ opacity: 1 }, { opacity: 0 }],
      { duration: 80, fill: 'forwards' }
    ).finished,
  })

  const panelAnim = $.entrance({
    in:  el => el.animate(
      [{ opacity: 0, transform: 'scale(0.97) translateY(-6px)' },
       { opacity: 1, transform: 'scale(1)    translateY(0)' }],
      { duration: 120, easing: 'ease-out', fill: 'forwards' }
    ),
    out: el => el.animate(
      [{ opacity: 1, transform: 'scale(1)'    },
       { opacity: 0, transform: 'scale(0.97)' }],
      { duration: 80, fill: 'forwards' }
    ).finished,
  })
</script>

<mesa:portal to={document.body}>

  <!-- Backdrop -->
  <!--
    One keydown handler, on the backdrop, and it is deliberately not also on
    the input: keydown bubbles, so binding both ran it TWICE per press —
    every arrow key skipped a row and Enter ran the chosen command twice.

    `|self` is what dismisses it: a click on the panel bubbles to here, so
    without it every command run would also be a dismissal.
  -->
  <div
    class="fjs-cp-backdrop"
    {@attach backdropAnim}
    on:click|self={close}
    on:keydown={handleKeydown}
  >
    <!-- Panel -->
    <div
      class="surface fjs-cp-panel"
      style:max-height={maxHeight}
      style:max-width="{maxWidth}px"
      {@attach panelAnim}
      role="dialog"
      aria-modal="true"
      aria-label="Command palette"
      {...$attributes}
    >

      <!-- ── Search input ── -->
      <div class="fjs-cp-inputrow">
        <span class="fjs-cp-searchicon" aria-hidden="true">⌕</span>
        <input
          bind:this={inputEl}
          bind:value={query}
          type="text"
          class="fjs-cp-input"
          placeholder={placeholder}
          autocomplete="off"
          spellcheck="false"
          aria-label="Search commands"
          role="combobox"
          aria-expanded="true"
          aria-haspopup="listbox"
          aria-autocomplete="list"
          aria-controls={listId}
          aria-activedescendant={flat[idx] ? rowId(flat[idx]) : null}
        />
        {#if query}
          <!--
            Focus has to go back where it came from. The button is inside the
            panel, so clicking it leaves focus on the button — the list is
            right, the box is empty, and the next thing typed goes nowhere.
          -->
          <button
            type="button"
            class="fjs-cp-clear"
            aria-label="Clear search"
            on:click={() => { query = ''; inputEl?.focus() }}
          >✕</button>
        {/if}
        <kbd>Esc</kbd>
      </div>

      <!-- ── Results list ── -->
      <div
        bind:this={listEl}
        id={listId}
        class="fjs-cp-list"
        role="listbox"
        aria-label="Commands"
      >
        {#if flat.length === 0}
          <!-- Empty state -->
          <div class="fjs-cp-empty">
            <span class="fjs-cp-emptyicon" aria-hidden="true">⌕</span>
            <span>
              {#if emptyText}
                {emptyText(query)}
              {:else if query}
                No results for "{query}"
              {:else}
                No commands available.
              {/if}
            </span>
          </div>

        {:else}
          {#each groupNames as group (group)}
            <!-- Group header -->
            <div class="fjs-cp-groupheader" aria-hidden="true">
              <span class="fjs-cp-grouplabel">{group}</span>
              <div class="fjs-cp-grouprule"></div>
            </div>

            <!-- Group rows -->
            {#each groupMap[group] as item (item.id)}
              {@const gi       = flatIdx[item.id]}
              {@const isActive = gi === idx}

              <!--
                The pointer takes the cursor on mousemove, not on mouseenter.
                A palette opens under a stationary pointer — ⌘K is a keyboard
                gesture and the mouse is wherever it was left — so `mouseenter`
                fired for whichever row happened to land under it, and Enter
                ran a command nobody chose. Scrolling the list with the arrow
                keys does the same thing, in the other direction.
              -->
              <button
                type="button"
                id={rowId(item)}
                class="fjs-cp-row {isActive ? 'fjs-cp-row--active' : ''}"
                data-active={isActive}
                role="option"
                aria-selected={isActive}
                on:mousemove={() => { if (idx !== gi) idx = gi }}
                on:click={() => run(item)}
              >
                <!-- Icon -->
                {#if item.icon !== undefined}
                  <span class="fjs-cp-rowicon {isActive ? 'fjs-cp-rowicon--active' : ''}">
                    {item.icon}
                  </span>
                {/if}

                <!-- Label + sub. item-text/-title/-sub ship in lists.css. -->
                <span class="item-text">
                  <!-- One line: a break here renders whitespace inside the word. -->
                  <span class="item-title fjs-cp-rowlabel {isActive ? 'fjs-cp-rowlabel--active' : ''}">{#each segments(item.label, marksOf.get(item)?.label ?? []) as part, i (i)}{#if part.match}<mark>{part.text}</mark>{:else}{part.text}{/if}{/each}</span>
                  {#if item.sub}
                    <span
                      class="item-sub"
                      style:color={item.color || undefined}
                    >{#each segments(item.sub, marksOf.get(item)?.sub ?? []) as part, i (i)}{#if part.match}<mark>{part.text}</mark>{:else}{part.text}{/if}{/each}</span>
                  {/if}
                </span>

                <!-- Badge -->
                {#if item.badge}
                  <span class="badge fjs-cp-badge">{item.badge}</span>
                {/if}

                <!-- Shortcut hint: ↵ when active, kbd string otherwise -->
                {#if isActive}
                  <kbd>↵</kbd>
                {:else if item.kbd}
                  <span class="fjs-cp-rowkbd">{item.kbd}</span>
                {/if}
              </button>
            {/each}
          {/each}
        {/if}
      </div>

      <!-- ── Footer ── -->
      <div class="fjs-cp-footer" aria-hidden="true">
        <div class="fjs-cp-footerhints">
          {#each [['↑↓', 'navigate'], ['↵', 'select'], ['Esc', 'close']] as [key, hint] (key)}
            <div class="fjs-cp-footerhint">
              <kbd>{key}</kbd>
              <span class="fjs-cp-footerhintlabel">{hint}</span>
            </div>
          {/each}
        </div>
        <span class="fjs-cp-count">
          {flat.length} result{flat.length !== 1 ? 's' : ''}
        </span>
      </div>

    </div>
  </div>

</mesa:portal>

<style>
  /*
   * A command palette is a scrim, a panel, and a keyboard-navigated list —
   * three shapes @frontierjs/css has no single term for, which is why this
   * block exists. What it is NOT is a second design system: the type ladder,
   * the space ladder (so `.dense` reaches the whole panel), the radii, the
   * shadows, the rule colour and the scrim are all the package's.
   *
   * The row's toned states go through the package's TINT ramp rather than
   * hand-mixed colours: setting `--bg-mix` gives `--tint-surface`,
   * `--tint-rule` and `--tint-ink` on that element, already contrast-checked
   * across every theme (tones.css). Three `color-mix()` calls per state, in a
   * component nobody would think to re-measure, was the alternative.
   *
   * Two knobs, both reading tokens.
   */
  .fjs-cp-panel {
    --cp-accent: var(--color-primary);   /* the active row */
    --cp-font:   var(--font-mono);       /* the palette reads as a console */
  }

  /* ── Backdrop ────────────────────────────────────────────────────────── */

  .fjs-cp-backdrop {
    position:        fixed;
    inset:           0;
    z-index:         9000;
    display:         flex;
    align-items:     flex-start;
    justify-content: center;
    padding-block-start: 11vh;
    background:      var(--scrim);
    backdrop-filter: blur(2px);
  }

  /* ── Panel ───────────────────────────────────────────────────────────── */

  /*
   * The panel IS a surface — `.surface` in the markup — so the background,
   * the ink, the hairline and the radius come from surface.css and the tone
   * recipe comes with them. What is left here is the palette's own geometry
   * and the two places it differs: a raised ground, said as the token the
   * package's own recipe reads rather than as a `background`, and a heavier
   * shadow than a card's.
   *
   * `.dialog` is NOT the class for this, though the register said so
   * (`FJS-056`): it is built on the native <dialog> — `max-width: 480px`, and
   * a `::backdrop` that only paints for a real dialog element. This panel is a
   * div with a backdrop of its own, deliberately (`FJS-322`).
   */
  .fjs-cp-panel {
    --surface-bg:   var(--surface-raised);

    display:        flex;
    flex-direction: column;
    width:          100%;
    margin:         0 var(--space-2xl);
    overflow:       hidden;
    box-shadow:     var(--shadow-lg);
    font-family:    var(--cp-font);
    font-size:      var(--text-sm);
  }

  /* ── Input row ───────────────────────────────────────────────────────── */

  .fjs-cp-inputrow {
    display:            flex;
    align-items:        center;
    gap:                var(--space-md);
    padding:            var(--space-lg) var(--space-2xl);
    border-block-end:   var(--border-width) solid var(--rule);
    flex-shrink:        0;
  }

  .fjs-cp-searchicon {
    flex-shrink: 0;
    font-size:   var(--text-lg);
    color:       var(--ink-soft);
    user-select: none;
  }

  .fjs-cp-input {
    flex:        1;
    background:  transparent;
    border:      none;
    outline:     none;
    font-family: inherit;
    font-size:   var(--text-md);
    line-height: var(--leading-normal);
    color:       var(--ink);
    caret-color: var(--cp-accent);
  }
  .fjs-cp-input::placeholder { color: var(--ink-soft); }

  .fjs-cp-clear {
    flex-shrink: 0;
    background:  none;
    border:      none;
    cursor:      pointer;
    color:       var(--ink-soft);
    font-size:   var(--text-md);
    line-height: 1;
    padding:     0 var(--space-3xs);
    transition:  color var(--motion-fast) var(--motion-ease);
  }
  .fjs-cp-clear:hover { color: var(--ink); }

  /* ── Results list ────────────────────────────────────────────────────── */

  .fjs-cp-list {
    flex:            1;
    overflow-y:      auto;
    padding-block:   var(--space-2xs);
    scrollbar-width: thin;
    scrollbar-color: var(--rule-strong) transparent;
  }

  .fjs-cp-empty {
    display:        flex;
    flex-direction: column;
    align-items:    center;
    gap:            var(--space-md);
    padding:        var(--space-2xl) var(--space-2xl);
    text-align:     center;
    color:          var(--ink-soft);
    font-size:      var(--text-sm);
  }
  .fjs-cp-emptyicon { font-size: var(--text-3xl); opacity: 0.4; }

  /* ── Group header ────────────────────────────────────────────────────── */

  .fjs-cp-groupheader {
    display:     flex;
    align-items: center;
    gap:         var(--space-sm);
    padding:     var(--space-md) var(--space-xl) var(--space-2xs);
  }

  /*
   * The same recipe .label and .badge take from the tokens — an overline is a
   * house decision, not a per-component one, so a theme that stops shouting
   * stops shouting here too.
   */
  /* The matched run. Weight rather than a colour — a row is already toned by
     being active, and a second colour here competes with it. */
  .fjs-cp-row mark {
    background: transparent;
    color: inherit;
    font-weight: 700;
  }

  .fjs-cp-grouplabel {
    font-size:      var(--text-2xs);
    font-weight:    var(--label-font-weight);
    text-transform: var(--label-text-transform);
    letter-spacing: var(--label-letter-spacing);
    color:          var(--ink-soft);
    white-space:    nowrap;
  }

  .fjs-cp-grouprule {
    flex:       1;
    block-size: var(--border-width);
    background: var(--rule);
  }

  /* ── Command row ─────────────────────────────────────────────────────── */

  .fjs-cp-row {
    display:       flex;
    align-items:   center;
    gap:           var(--space-md);
    inline-size:   calc(100% - (var(--space-lg) * 2));
    margin:        var(--space-3xs) var(--space-lg);
    padding:       var(--space-sm) var(--space-xl);
    background:    transparent;
    border:        var(--border-width) solid transparent;
    border-radius: var(--btn-radius);
    cursor:        pointer;
    text-align:    left;
    outline:       none;
    transition:    background var(--motion-fast) var(--motion-ease),
                   border-color var(--motion-fast) var(--motion-ease);
  }

  /*
   * The active row is the tint ramp, not three hand-mixed colours: --bg-mix
   * is the input and tones.css derives the fill, the rule and the ink from it
   * — already measured for contrast against every shipped theme.
   */
  .fjs-cp-row--active {
    --bg-mix:     var(--cp-accent);
    background:   var(--tint-surface);
    border-color: var(--tint-rule);
  }

  .fjs-cp-rowicon {
    flex-shrink: 0;
    inline-size: 1.25rem;
    text-align:  center;
    font-size:   var(--text-sm);
    color:       var(--ink-soft);
    transition:  color var(--motion-fast) var(--motion-ease);
  }
  .fjs-cp-rowicon--active { color: var(--tint-ink); }

  /*
   * The stacked text block is `.item-text` / `.item-title` / `.item-sub`
   * from @frontierjs/css lists.css. What stays here is the palette's own:
   * one line each, ellipsed, and the active row's colour shift.
   *
   * A palette row is fixed-height by design — the list is navigated with
   * arrow keys, and a row that grows to two lines moves every row under it
   * while the reader is aiming at one. So these clamp to `nowrap` rather
   * than reaching for `.clamp-*`, which is the opposite decision from a
   * search snippet and is made here because the reason is the keyboard.
   */
  .fjs-cp-row .item-title,
  .fjs-cp-row .item-sub {
    overflow:      hidden;
    text-overflow: ellipsis;
    white-space:   nowrap;
  }

  .fjs-cp-rowlabel {
    font-size:   var(--text-sm);
    color:       var(--ink-soft);
    font-weight: 400;
    transition:  color var(--motion-fast) var(--motion-ease);
  }
  .fjs-cp-rowlabel--active { color: var(--ink); font-weight: 500; }

  /*
   * `.badge` ships the shape, the tone and the auto-contrast; what a palette
   * badge needs on top is to be tinted rather than filled, and not to shove
   * the row's text around when it appears.
   */
  .fjs-cp-badge {
    --bg-mix:     var(--color-success);
    flex-shrink:  0;
    background:   var(--tint-surface);
    border:       var(--border-width) solid var(--tint-rule);
    color:        var(--tint-ink);
    font-size:    var(--text-2xs);
  }

  .fjs-cp-rowkbd {
    flex-shrink: 0;
    font-family: var(--cp-font);
    font-size:   var(--text-2xs);
    color:       var(--ink-soft);
  }

  /* ── Footer ──────────────────────────────────────────────────────────── */

  .fjs-cp-footer {
    display:            flex;
    align-items:        center;
    flex-shrink:        0;
    padding:            var(--space-sm) var(--space-xl);
    border-block-start: var(--border-width) solid var(--rule);
  }

  .fjs-cp-footerhints { display: flex; gap: var(--space-xl); }
  .fjs-cp-footerhint  { display: flex; align-items: center; gap: var(--space-2xs); }

  .fjs-cp-footerhintlabel,
  .fjs-cp-count {
    font-size: var(--text-2xs);
    color:     var(--ink-soft);
  }
  .fjs-cp-count { margin-inline-start: auto; }
</style>
