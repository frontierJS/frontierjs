<script>
  // DropdownItem.mesa
  // An action row inside DropdownMenu. Closes the menu after selection by
  // consuming the parent's close() from context.
  //
  // `.item` inside an `.items.menu` list is the package's interactive menu
  // row — hover, padding and radius all come from there, and `.item` is on
  // icon.css's holder list so a leading <svg> is sized automatically.
  //
  // Usage:
  //   <DropdownItem onclick={edit}>Edit</DropdownItem>
  //   <DropdownItem tone="danger" onclick={remove}>Delete</DropdownItem>
  //
  //   <!-- With icon and keyboard shortcut hint -->
  //   <DropdownItem kbd="⌘D" onclick={duplicate}>
  //     {#snippet icon()}<IconCopy />{/snippet}
  //     Duplicate
  //   </DropdownItem>
  //
  //   <DropdownItem href="/settings">Settings</DropdownItem>
  //   <DropdownItem disabled>Coming soon</DropdownItem>
  //
  //   <!-- A toggle: runs, and the menu stays open -->
  //   <DropdownItem keepOpen onclick={toggleGrid}>Grid view</DropdownItem>
  //
  //   <!-- A choice: `checked` makes it a menuitemcheckbox, and `radio` a
  //        menuitemradio. The caller owns the state; the row announces it. -->
  //   <DropdownItem checked={grid} onclick={toggleGrid}>Grid view</DropdownItem>
  //   <DropdownItem radio checked={sort === 'name'} onclick={() => sort = 'name'}>By name</DropdownItem>

  import { tone as toTone, cx } from '../../utils.js'

  export let tone     = ''           // one of the 7 css tones
  export let variant  = ''           // legacy — 'destructive' → danger
  export let disabled = false
  export let kbd      = ''           // keyboard shortcut label shown on the right
  export let href     = undefined    // renders as <a> when set
  export let icon     = null         // snippet — leading icon
  export let onclick  = undefined
  export let keepOpen = undefined    // stated: this row's say; unstated: the menu's
  export let checked  = undefined    // stated (true or false): a checkbox row, or a radio row with `radio`
  export let radio    = false        // with `checked`: menuitemradio rather than menuitemcheckbox

  // Consume close() and the menu's keepOpen default from nearest DropdownMenu
  // ancestor. const — always tracks provider (Rule 25a). Both read undefined
  // outside a DropdownMenu.
  const close         = $context.close
  const menuKeepsOpen = $context.keepOpen

  const t = toTone(variant === 'destructive' ? 'danger' : (variant || tone))

  function handleClick(e) {
    if (disabled) return
    onclick?.(e)
    if (keepOpen ?? menuKeepsOpen) return
    close?.()
  }
</script>

{#if href && !disabled}
  <a
    href={href}
    role="menuitem"
    tabindex="-1"
    class={cx('item', t)}
    {class}
    {...$attributes}
    on:click={handleClick}
  >
    {#if icon}
      {@render icon?.()}
    {/if}
    <span style:flex="1">
      <slot />
    </span>
    {#if kbd}
      <kbd class="kbd">{kbd}</kbd>
    {/if}
  </a>
{:else}
  <button
    type="button"
    role={checked === undefined ? 'menuitem' : (radio ? 'menuitemradio' : 'menuitemcheckbox')}
    aria-checked={checked === undefined ? null : (checked ? 'true' : 'false')}
    data-checked={checked === undefined ? null : (checked ? 'true' : 'false')}
    tabindex="-1"
    disabled={disabled}
    class={cx('item', t)}
    {class}
    {...$attributes}
    on:click={handleClick}
  >
    {#if checked !== undefined}
      <span aria-hidden="true" style:inline-size="1em" style:text-align="center">{checked ? (radio ? '•' : '✓') : ''}</span>
    {/if}
    {#if icon}
      {@render icon?.()}
    {/if}
    <span style:flex="1" style:text-align="start">
      <slot />
    </span>
    {#if kbd}
      <kbd class="kbd">{kbd}</kbd>
    {/if}
  </button>
{/if}

<!--
  No <style>. `@frontierjs/css` owns every rule this component needs:
  `.item` is the row's layout, `.items :is(button, a).item` is the control
  reset a <button> or an <a> needs on top of it, and the disabled pair is
  scoped through `.items` so it outranks the `.items.menu .item` hover.

  The copy that used to live here is why that rule exists — and it had
  already drifted: it hardcoded `gap: 0.625rem` where `.item` reads
  `var(--space-sm)`, so every menu row in the kit sat a rung wide and did
  not move inside a `.dense` region.
-->
