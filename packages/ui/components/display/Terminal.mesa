<script>
  // Terminal.mesa — a shell drawn by xterm.js, over a socket that
  // `@frontierjs/junction/terminal` serves (`FJS-D2125`).
  //
  // The app owns the address and the credential: `url` and `protocols` are
  // called at each connect, so a size, a folder or a token that changed since
  // the last one is the one sent. A change of `session` reconnects; a `url`
  // that answers nothing leaves the pane idle.
  //
  // xterm and its stylesheet are imported when the component mounts, never
  // with the page: an app that never shows a terminal pays for none of it, and
  // they are optional peers of this kit, so an app that does show one depends
  // on @xterm/xterm and @xterm/addon-fit itself.
  //
  // xterm takes every key it types and stops it there, so a page chord never
  // sees Ctrl+W or Ctrl+P typed into a shell. `passthrough` hands a key back
  // to the page, which is what lets it bubble to the page's keymap.
  //
  // A URL the shell prints is a link when @xterm/addon-web-links is installed
  // (an optional peer too; without it the pane works and draws no links).
  // As in VS Code, Ctrl+click (Cmd+click on macOS) follows it, so a plain click
  // still selects text, and it goes to `onlink`: a desktop shell hands it to the
  // system browser, which `window.open` inside a webview would not reach.
  //
  // Copying, as in VS Code: Ctrl+Shift+C (Cmd+C on macOS) copies the selection
  // when there is one, and is the shell's key when there is none. A program
  // that owns the mouse (tmux with `mouse on`, vim) takes a plain drag for
  // itself, and Shift+drag (Option+drag on macOS) still selects here. What such
  // a program copies it hands out as OSC 52, which goes to the clipboard too,
  // so a drag in tmux copies on release. Both go to `oncopy`; asking for the
  // clipboard back through OSC 52 is refused, so a program cannot read it.
  //
  // The colors and font are read off the pane's own computed style, so the
  // terminal follows the theme instead of naming one. A theme that carries a
  // terminal palette sets the `--terminal-*` tokens below (`--terminal-bg`,
  // `--terminal-fg`, `--terminal-font`, `--terminal-font-size`, `--terminal-cursor`,
  // `--terminal-selection` and the sixteen ANSI colors); one that sets none
  // gets the sunken surface, the ink and xterm's own ANSI colors.
  import Button from '../forms/Button.mesa'

  const ANSI = ['black', 'red', 'green', 'yellow', 'blue', 'magenta', 'cyan', 'white']

  /** xterm's theme from the pane's tokens; a token left unset is left out, so xterm's default stands. */
  function themeOf(style) {
    const token = (name) => style.getPropertyValue(`--terminal-${name}`).trim()
    const theme = { background: style.backgroundColor, foreground: style.color, cursor: token('cursor') || style.color }
    if (token('selection')) theme.selectionBackground = token('selection')
    for (const name of ANSI) {
      const bright = `bright${name[0].toUpperCase()}${name.slice(1)}`
      if (token(name)) theme[name] = token(name)
      if (token(`bright-${name}`)) theme[bright] = token(`bright-${name}`)
    }
    return theme
  }

  export let url = (_size) => ''          // ({ cols, rows, session }) => the ws:// URL, or '' for no shell
  export let protocols = undefined        // string[] or () => string[] — the subprotocol list
  export let session = ''                 // which shell this pane shows; a change reconnects
  export let passthrough = (_e) => false  // a key event the page answers instead of the shell
  export let onproblem = (_message) => {} // xterm failed to load
  export let fontSize = 0                 // px; 0 reads the pane's computed font size; a change applies live
  export let onlink = (uri) => { window.open(uri, '_blank', 'noopener') } // a link Ctrl/Cmd+clicked
  export let oncopy = (text) => navigator.clipboard.writeText(text) // the selection, or what a program sent by OSC 52

  const mac = /Mac|iPhone|iPad/.test(globalThis.navigator?.platform ?? '')
  const linkHint = `Follow link (${mac ? 'cmd' : 'ctrl'} + click)`
  const follows = (e) => (mac ? e.metaKey : e.ctrlKey)
  // Ctrl+Shift+C, or Cmd+C on macOS: the copy chord, read only while something is selected.
  const copyChord = (e) => e.key.toLowerCase() === 'c' && !e.altKey && (mac ? e.metaKey && !e.ctrlKey : e.ctrlKey && e.shiftKey && !e.metaKey)

  async function copy(text) {
    if (!text) return
    try {
      await oncopy(text)
    } catch (e) {
      onproblem(`the clipboard was not written: ${e?.message ?? e}`)
    }
  }

  /** OSC 52's payload, `<targets>;<base64>`, as text; a query (`?`) or a payload that does not decode is null. */
  function osc52(data) {
    const b64 = data.slice(data.indexOf(';') + 1)
    if (!b64 || b64 === '?') return null
    try {
      return new TextDecoder().decode(Uint8Array.from(atob(b64), (c) => c.charCodeAt(0)))
    } catch {
      return null
    }
  }

  let host = null
  let state = 'idle' // idle · connecting · open · closed
  let reason = ''

  let term = null
  let fit = null
  let ws = null
  let resizer = null
  let starting = null
  let gone = false

  const send = (frame) => {
    if (ws?.readyState === WebSocket.OPEN) ws.send(JSON.stringify(frame))
  }

  // A hidden pane measures zero, which fit() turns into a one-column terminal and a resize the shell then sees.
  function refit() {
    if (!fit || !host || host.clientWidth === 0 || host.clientHeight === 0) return
    try { fit.fit() } catch {}
  }

  function drop() {
    if (!ws) return
    ws.onclose = null
    ws.close()
    ws = null
  }

  /** Attach to the shell `url` names now, dropping the socket held before. */
  export function connect() {
    drop()
    if (!term) return
    const address = url({ cols: term.cols, rows: term.rows, session })
    if (!address) {
      state = 'idle'
      return
    }
    state = 'connecting'
    reason = ''
    term.reset()
    const list = typeof protocols === 'function' ? protocols() : protocols
    const mine = new WebSocket(address, list)
    ws = mine
    mine.onopen = () => {
      if (ws !== mine) return
      state = 'open'
      refit()
      send({ r: [term.cols, term.rows] })
    }
    mine.onmessage = (e) => { if (ws === mine) term.write(e.data) }
    mine.onclose = (e) => {
      if (ws !== mine) return
      state = 'closed'
      reason = e.reason || 'disconnected'
    }
  }

  /** Load xterm and attach; the promise is the same one on every call. */
  export function open() {
    starting ??= (async () => {
      let Terminal
      let FitAddon
      try {
        ;[{ Terminal }, { FitAddon }] = await Promise.all([import('@xterm/xterm'), import('@xterm/addon-fit'), import('@xterm/xterm/css/xterm.css')])
      } catch (e) {
        starting = null
        onproblem(`the terminal did not load: ${e.message}`)
        return
      }
      // Optional: a pane without it draws no links and is otherwise the same.
      const WebLinksAddon = await import('@xterm/addon-web-links').then((m) => m.WebLinksAddon, () => null)
      if (gone) return
      const style = getComputedStyle(host)
      term = new Terminal({
        fontFamily: style.fontFamily,
        fontSize: fontSize || parseFloat(style.fontSize) || 13,
        cursorBlink: true,
        scrollback: 5000,
        // VS Code's default: a dim color a program picks is lifted until it reads against the ground.
        minimumContrastRatio: 4.5,
        // Option+drag selects past a program that owns the mouse, as Shift+drag does elsewhere.
        macOptionClickForcesSelection: true,
        theme: themeOf(style),
      })
      fit = new FitAddon()
      term.loadAddon(fit)
      if (WebLinksAddon) {
        term.loadAddon(new WebLinksAddon((e, uri) => { if (follows(e)) onlink(uri) }, {
          hover: () => { host.title = linkHint },
          leave: () => { host.removeAttribute('title') },
        }))
      }
      term.attachCustomKeyEventHandler((e) => {
        if (term.hasSelection() && copyChord(e)) {
          if (e.type === 'keydown') copy(term.getSelection())
          e.preventDefault()
          return false
        }
        return !passthrough(e)
      })
      term.parser.registerOscHandler(52, (data) => {
        copy(osc52(data))
        return true
      })
      term.open(host)
      refit()
      term.onData((i) => send({ i }))
      term.onResize(({ cols, rows }) => send({ r: [cols, rows] }))
      resizer = new ResizeObserver(refit)
      resizer.observe(host)
      connect()
    })()
    return starting
  }

  export function focus() {
    refit()
    term?.focus()
  }

  export function holdsFocus() {
    return !!host?.contains(document.activeElement)
  }

  $: session, connect

  // A new fontSize after the pane opened restyles it in place, the shell kept; 0 goes back to the pane's computed size.
  // The refit hands the shell its new cols and rows; a hidden pane refits when it shows.
  $: fontSize, () => {
    if (!term || !host) return
    term.options.fontSize = fontSize || parseFloat(getComputedStyle(host).fontSize) || 13
    refit()
  }

  $.onMount(() => { open() })

  $.onDestroy(() => {
    gone = true
    resizer?.disconnect()
    drop()
    term?.dispose()
  })
</script>

<section class="terminal" aria-label="Terminal" data-state={state} {...$attributes}>
  <div class="terminal-screen" bind:this={host}></div>
  {#if state === 'connecting' || state === 'closed'}
    <p class="terminal-note" role="status">
      {#if state === 'connecting'}
        Connecting…
      {:else}
        <span>Terminal closed — {reason}</span>
        <Button size="xs" treatment="outlined" onclick={connect}>Reconnect</Button>
      {/if}
    </p>
  {/if}
</section>

<style>
  .terminal {
    position: relative;
    display: flex;
    flex-direction: column;
    flex: 1;
    block-size: 100%;
    min-block-size: var(--terminal-min-block, 0);
    background: var(--terminal-bg, var(--surface-sunken));
    color: var(--terminal-fg, var(--ink));
  }
  .terminal-screen {
    flex: 1;
    min-block-size: 0;
    padding: var(--space-3xs) var(--space-xs);
    background: var(--terminal-bg, var(--surface-sunken));
    color: var(--terminal-fg, var(--ink));
    font: var(--terminal-font-size, var(--text-sm)) / 1.2 var(--terminal-font, var(--font-mono));
    overflow: hidden;
  }
  /* A terminal's cells run left to right, whatever their script. Without an
     override WebKit asks HarfBuzz to guess a run's direction, and HarfBuzz has
     none for Runic, Old Italic or Old Hungarian: the distro's HarfBuzz asserts
     and the WebKitGTK page process dies (vim-airline's branch sign ᚠ in a status
     line froze Lathe). xterm's rows and its glyph-width measures are spans, and
     unicode-bidi is not inherited, so it goes on each one. */
  .terminal-screen :global(span) {
    direction: ltr;
    unicode-bidi: bidi-override;
  }
  .terminal-note {
    position: absolute;
    inset-block-end: var(--space-xs);
    inset-inline-end: var(--space-sm);
    display: flex;
    gap: var(--space-xs);
    align-items: center;
    margin: 0;
    padding: var(--space-3xs) var(--space-xs);
    background: var(--surface);
    border: var(--border-width) solid var(--rule);
    font-size: var(--text-sm);
  }
</style>
