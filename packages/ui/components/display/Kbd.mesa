<script>
  // Kbd.mesa
  // Keyboard shortcut badge. `.kbd` in @frontierjs/css styles both the bare
  // <kbd> element and the class, so the element alone is enough.
  //
  // Usage:
  //   <Kbd>⌘K</Kbd>
  //   <Kbd>Ctrl+S</Kbd>
  //   <Kbd keys={['⌘', 'Shift', 'P']} />   ← renders each key separately
  //
  // The `keys` prop splits into individual badges joined by a thin plus.
  // The children form renders the whole thing as one badge.

  import { cx, sizeClass } from '../../utils.js'

  export let keys = []     // string[] — each key gets its own badge
  export let size = ''     // '' | 'xs' | 'md'

  const SIZES = { xs: 'text-2xs', md: 'text-sm' }
</script>

{#if keys.length}
  <span class="cluster" style:gap="0.25rem" {class} {...$attributes}>
    {#each keys as key, i (i)}
      {#if i > 0}
        <span class="text-muted text-xs" aria-hidden="true">+</span>
      {/if}
      <kbd class={cx('kbd', SIZES[size])}>{key}</kbd>
    {/each}
  </span>
{:else}
  <kbd class={cx('kbd', sizeClass(SIZES, size, $class))} {class} {...$attributes}>
    <slot />
  </kbd>
{/if}
