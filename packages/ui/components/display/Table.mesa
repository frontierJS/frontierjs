<script>
  // Table.mesa
  // Semantic data table. Handles sorting state, loading skeleton, and empty
  // state. Columns are defined as objects; rows render via the `row` snippet.
  //
  // `.table` owns the structure and `striped` / `hover` / `compact` are its
  // scoped modifiers. Tones go on a <tr> — `<tr class="danger">` — because a
  // tone is free-standing and works on a row like it works on anything else.
  //
  // Sorted state is `aria-sort` on the <th>, not a class: it is what a screen
  // reader announces, so it is also the single source of truth for the arrow.
  //
  // COLUMNS shape:
  //   { name, label, sortable?, align?: 'left'|'center'|'right', width?, hideLabel? }
  //
  // `name` is the FIELD, which is what `resource.columns()` already calls it and
  // what `<FilterBar>` already reads off the same list — this component said
  // `key` and every caller carried a `.map` to translate, which is a shape
  // translation with no owner (`FJS-1081`).
  //
  // `hideLabel` is for the column that holds a row's actions. The header cell
  // still has to be announced — a <th> with no text leaves a screen reader
  // saying nothing for a column that has content in every row — but a visible
  // "Actions" over a column of buttons is noise. It is not the same as an
  // empty label, and it is not `aria-label`: the text belongs in the cell so
  // the header is read in the row context that a table's own navigation uses.
  //
  // USAGE — basic:
  //   <Table {columns} {rows} {loading}>
  //     {#snippet row(r)}
  //       <tr><td>{r.name}</td><td>{r.email}</td></tr>
  //     {/snippet}
  //   </Table>
  //
  // USAGE — with sort handling:
  //   <Table {columns} {rows} bind:orderBy>
  //     {#snippet row(r)}...{/snippet}
  //   </Table>
  //
  // SORT is one value and it is the `$orderBy` directive itself, not a pair.
  // Three pages derived `(key, direction)` from that directive by hand and the
  // three disagreed — one assumed a string and threw on the object form, two
  // answered a column named `0` on the bracket-indexed form — because the
  // directive deliberately admits `-name`, `{name:'asc'}` and `[{…}]` alike and
  // nothing owned reading it (`FJS-1077`). `orderByPair` does, in
  // `@frontierjs/toolbelt/directives` beside the table that admits the shapes,
  // and this component is the only thing in the kit that needs it: the marker
  // is `aria-sort`, which is already ours.

  import { orderByPair, orderByValue } from '@frontierjs/toolbelt/directives'
  import { cx } from '../../utils.js'

  export let columns    = []       // { name, label, sortable?, align?, width? }[]
  export let rows       = []       // any[] — passed to the row snippet
  export let loading    = false
  export let emptyText  = 'No results found'
  export let orderBy    = ''       // bindable — the `$orderBy` directive, any legal shape
  // Report the next ordering instead of taking it. `bind:orderBy` makes this
  // component the owner of the sort, and a component cannot own something that
  // lives in the address bar: a list sorted from the URL has to navigate, and
  // then the ordering arrives back as a prop. With `onsort` set the component
  // states the move and changes nothing, so there is no flash of an arrow the
  // caller is about to overrule.
  //
  // It reports an `orderBy` and not a pair, so a page writes
  // `apply({ …q, $orderBy: next })` and never spells a sort shape of its own —
  // which is the half of `FJS-1077` that was a divergence rather than a crash:
  // two pages wrote the same click as `{name:'desc'}` and as `-name`.
  export let onsort     = undefined // (orderBy) => void
  export let striped    = false    // alternate row shading
  export let hover      = true     // row hover highlight
  export let compact    = false    // reduce row padding

  // Snippets
  export let row     = null        // required — renders each data row
  export let empty   = null        // optional override for the empty state
  export let actions = null        // optional toolbar above the table

  // Skeleton row count while loading
  export var skeletonRows = 5

  // Read at call time rather than derived once: `orderBy` is a prop and the
  // marker has to answer for the ordering the caller is showing NOW, which is
  // the defect this component was already carrying one layer up — a header that
  // reports a sort without stating the current one never reverses.
  function sortedBy(col) {
    const { key, dir } = orderByPair(orderBy)
    return key === col.name ? dir : null
  }

  function handleSort(col) {
    if (!col.sortable) return
    const current = sortedBy(col)
    const next = orderByValue(col.name, current === 'asc' ? 'desc' : 'asc')
    if (onsort) return onsort(next)
    orderBy = next
  }

  function sortStateOf(col) {
    if (!col.sortable) return null
    const dir = sortedBy(col)
    if (!dir) return 'none'
    return dir === 'asc' ? 'ascending' : 'descending'
  }
</script>

<div {class} {...$attributes}>
  {#if actions}
    <div class="table-actions">
      {@render actions?.()}
    </div>
  {/if}

  <!-- .table-wrap is what makes a wide table scroll instead of the page. -->
  <div class="table-wrap">
    <table class={cx('table', striped && 'striped', hover && 'hover', compact && 'compact')}>
      <thead>
        <tr>
          {#each columns as col (col.name)}
            <th
              scope="col"
              aria-sort={sortStateOf(col)}
              style:width={col.width ?? null}
              style:text-align={col.align ?? null}
            >
              {#if col.hideLabel}
                <span class="visually-hidden">{col.label}</span>
              {:else if col.sortable}
                <!--
                  A real <button>, so the sort control is reachable by keyboard.
                  The old markup put on:click on the <th> itself, which meant a
                  keyboard user could not sort at all.
                -->
                <button type="button" class="btn link" on:click={() => handleSort(col)}>
                  {col.label}
                  {#if sortedBy(col) === 'asc'}
                    <svg viewBox="0 0 12 12" fill="currentColor" aria-hidden="true"><path d="M6 3l4 6H2z"/></svg>
                  {:else if sortedBy(col) === 'desc'}
                    <svg viewBox="0 0 12 12" fill="currentColor" aria-hidden="true"><path d="M6 9L2 3h8z"/></svg>
                  {:else}
                    <svg viewBox="0 0 12 12" fill="currentColor" aria-hidden="true" style:opacity="0.4"><path d="M6 2l3 4H3zm0 8L3 6h6z"/></svg>
                  {/if}
                </button>
              {:else}
                {col.label}
              {/if}
            </th>
          {/each}
        </tr>
      </thead>

      <tbody>
        {#if loading}
          <!-- Skeleton rows -->
          <!-- Array.from, not `{ length: n }` — an each takes a real array;
               an array-LIKE object reaches the runtime and throws
               `array.map is not a function`, which is what the loading state
               did every time it was used. -->
          {#each Array.from({ length: skeletonRows }) as _, i (i)}
            <tr aria-busy="true">
              {#each columns as col (col.name)}
                <td>
                  <div
                    class="skeleton text"
                    style:inline-size="{50 + ((i * 13 + col.name.length * 7) % 35)}%"
                  ></div>
                </td>
              {/each}
            </tr>
          {/each}

        {:else if !rows.length}
          <!-- Empty state -->
          {#if empty}
            {@render empty?.()}
          {:else}
            <tr>
              <td colspan={columns.length}>
                <div class="empty">
                  <p class="empty-text">{emptyText}</p>
                </div>
              </td>
            </tr>
          {/if}

        {:else}
          <!-- Data rows — the snippet supplies its own <tr>. -->
          {#each rows as r, i (i)}
            {@render row?.(r, i)}
          {/each}
        {/if}
      </tbody>
    </table>
  </div>
</div>
