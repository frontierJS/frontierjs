<script>
  // FilterBar.mesa
  // The controls over a list's query, and nothing about where that query lives.
  //
  // `FormField.mesa` and `Cell.mesa` one surface along, on the same terms: the
  // column already has ONE kind — `displayFor` named it — and sierra's
  // `filterOpFor(display)` says what a filter over that kind ASKS. This renders
  // the asking. A registration wins over the built-in table, exactly as it does
  // for a control and for a display.
  //
  // ── It does not touch the URL, deliberately ──────────────────────────────
  //
  // The filter state lives in the URL (Invariant 10) and this kit peers only on
  // mesa and css — it cannot import the router, and should not: a component
  // that navigates is one you cannot put two of on a page, or render in a
  // dialog, or test without a route table. So it takes the query it should
  // show and hands back the next one. The PAGE navigates.
  //
  // ── Two rules that are wrong quietly if you get them backwards ───────────
  //
  // **A cleared filter is an ABSENT key, never an empty one.** `?status=` is a
  // filter FOR the empty string, and `@frontierjs/toolbelt/query` will
  // faithfully deliver it — an empty table with a filter that looks unset. So
  // `undefined` is the only empty here, and clearing DELETES the key.
  //
  // **A filter change resets paging.** Page 3 of a different question is not
  // page 3, so `$offset` and `$after` go whenever the filters move. Without it
  // the first thing anybody does — filter while on page 2 — shows nothing.
  //
  // ── A control's callback is TRANSLATED, never forwarded ──────────────────
  //
  // `onvalue(v)` is this file's own vocabulary and no kit control has that
  // prop. The three used here disagree: `Input` fires `oninput` with the
  // EVENT, `MultiSelect` and `RadioGroup` fire `onchange` with the VALUE. So
  // each branch adapts, exactly as `FormField.mesa`'s table does one surface along.
  // Forwarding `onvalue` straight through is silent — the prop lands as an
  // attribute, every control renders, and none of them writes anything.
  //
  // ── Every control carries its own NAME ───────────────────────────────────
  //
  // A placeholder is not an accessible name: it is a hint, it is not announced
  // as a label by every reader, and it disappears the moment somebody types.
  // A bar of eight boxes named by placeholder alone is eight controls a screen
  // reader announces as *edit text* — which is what basecamp's a11y sweep
  // found the first time this component reached a screen it audits.
  //
  // `aria-label` rather than a visible `<label>`, because the label text is
  // already on screen in the placeholder and stacking a caption over every
  // control turns a toolbar into a form. It reaches the CONTROL: the kit puts
  // a caller's attributes on the input rather than on the field wrapper, for
  // exactly this reason.

  import { filterComponent, defaultFilterProps } from '../../controls.js'
  import Input       from '../forms/Input.mesa'
  import MultiSelect from '../forms/MultiSelect.mesa'
  import RadioGroup  from '../forms/RadioGroup.mesa'
  import Button      from '../forms/Button.mesa'
  import Select      from '../forms/Select.mesa'
  import DropdownMenu from '../overlay/DropdownMenu.mesa'
  import DropdownItem from '../overlay/DropdownItem.mesa'
  import DayRangeFilter from './DayRangeFilter.mesa'
  import RangeInput     from './RangeInput.mesa'
  import { readMoney, showMoney } from '../forms/MoneyInput.mesa'
  import { directiveParams, splitParams } from '@frontierjs/toolbelt/directives'
  import { emptyTest, emptyTestOf, readDayToken } from '@frontierjs/toolbelt/query'
  import { addToDate, plainDateIn, startOfDay } from '@frontierjs/toolbelt/datetime'

  // `resource.filters().filters` — the ranked columns, each with `op` and
  // `kind`, or `op: null` and a reason.
  export let filters = []
  // The current FILTERS, `page.query` shaped: `{ status: { in: ['paid'] } }`.
  export let value   = {}
  // The current DIRECTIVES, `page.directives` shaped — unprefixed (Invariant 10).
  //
  // Handed separately and merged here, the way `<Table>` takes the `orderBy`
  // directive rather than a sort pair. The router splits them apart on the way
  // in, so a page that fed this bar `page.query` alone handed it a query with no
  // sort and no page size in it — and got one back the same way, which dropped
  // the sort a header had just set on the first keystroke in a filter box. Every
  // page reassembled it by hand with `directiveParams` until this prop existed.
  export let directives = undefined
  // (nextQuery, nextDirectives) => void. The page writes both to the URL, and
  // `goto(path, query, { directives })` joins them — so a page never spells a
  // `$` name in either direction. The second argument is split back out here
  // with `splitParams`, which is `directiveParams`' own inverse.
  export let onchange = undefined
  // A column's rows, by column name, stated by the page. They win over what
  // the entry's own `optionsFor` fetches.
  export let options  = {}
  // `resource.filters().search` — `{ fields, labels }` where the model declares
  // `@@fts`, `{ fields: null, reason }` where it does not. A box is drawn only
  // for the first, because `$search` below `@@fts` is refused by the Data
  // boundary, and a box that answers 400 on every word is worse than none.
  export let search   = undefined
  // The zone a day bound over an instant is read in, `<Cell>`'s prop: an app
  // whose day belongs to an account passes the account's. Hand the same one
  // to `tethered({ timeZone })`, which resolves a relative day in it.
  export let timeZone = undefined

  // A const is derived when something it reads is reactive (`FJS-D212`), so
  // this re-evaluates when the caller hands over a new list.
  const offered = filters.filter(f => f.op)

  // The two halves back together, in the `$` spelling this bar reads and hands
  // back. A caller that passes no `directives` gets what it always got.
  const held = directives ? { ...value, ...directiveParams(directives) } : (value ?? {})

  // Where a filter lives in the query. A declared custom field is named
  // `fields.severity` but filtered through the column its slot generated, and
  // the Data boundary takes no where on the former (`FJS-1735`).
  const keyOf = (f) => f.queryKey ?? f.name

  /** What this column currently filters by, unwrapped from its operator. */
  function current(f) {
    const at = held?.[keyOf(f)]
    if (at === undefined || emptyTestOf(at)) return undefined
    if (f.kind === 'range') return { gte: at.gte, lte: at.lte }
    const op = Array.isArray(f.op) ? f.op[0] : f.op
    // Through a to-many the operator sits under `some` and the join's key.
    if (f.through) return at?.some?.[f.through.field]?.[op]
    return at?.[op] ?? at
  }

  const searchable = search?.fields?.length ? search : null
  const searching  = held?.$search ?? ''

  /** Hand the two halves back, never the `$` bag this component works in. */
  function emit(next) {
    const { query, directives } = splitParams(next)
    onchange?.(query, directives)
  }

  // ── A money range is typed in major units ────────────────────────────────
  //
  // The column holds minor units, so a box handing its text straight to the
  // query filtered "from 10" as from ten cents. `RangeInput` reads and shows
  // each bound through `MoneyInput`'s own two functions.
  //
  // A `@money(field: …)` column holds amounts in several currencies and is
  // offered no range (`FJS-D556`), so a money filter here has its currency.
  const moneyCode = (f) => f.currency
  const showMinor = (f) => (v) => showMoney(v, moneyCode(f), f.places ?? 0)
  const readMinor = (f) => (text) => readMoney(text, moneyCode(f), f.places ?? 0).value

  // ── A day range over an INSTANT ──────────────────────────────────────────
  //
  // A `DateTime` column holds an instant, and the box holds a DAY. Handed
  // across as it is, `lte: '2026-10-07'` is midnight at the START of that day
  // in UTC, so *to the 7th* excluded the whole of the 7th, and *from the 7th*
  // began at a UTC midnight that is the evening of the 6th west of Greenwich.
  // So a bound is the day in `timeZone` (the viewer's by default) turned into
  // its first and last instant, and read back the same way. A `Date` column is
  // a day on both sides and is not converted; an `@time` column is a wall
  // clock, not a day, and gets a time box.
  const isInstant = (f) => f.display === 'time' && f.time?.kind === 'instant'
  const isClock   = (f) => f.display === 'time' && !f.time?.kind && !!f.time
  const rangeType = (f) => f.display !== 'time' ? 'number' : isClock(f) ? 'time' : 'date'

  const zone = timeZone ?? Intl.DateTimeFormat().resolvedOptions().timeZone

  /** The box's day → the bound's instant: the day's first moment, or its last. */
  function dayToInstant(day, key) {
    if (!/^\d{4}-\d{2}-\d{2}$/.test(String(day ?? ''))) return undefined
    const ms = key === 'gte' ? startOfDay(day, zone) : startOfDay(addToDate(day, { days: 1 }), zone) - 1
    return new Date(ms).toISOString()
  }

  /** …and back, for showing it. A bare day (a URL typed by hand) shows as is. */
  function instantToDay(at) {
    if (at === undefined || at === null || at === '') return ''
    if (!String(at).includes('T')) return String(at)
    const ms = Date.parse(at)
    return Number.isNaN(ms) ? '' : plainDateIn(ms, zone)
  }

  const showBound  = (f, key) => isInstant(f) ? instantToDay(current(f)?.[key]) : (current(f)?.[key] ?? '')
  const writeBound = (f, key, text) =>
    write(f, { ...current(f), [key]: isInstant(f) ? dayToInstant(text, key) : text })

  /** A day range's bounds as `DayRangeFilter` holds them — days, an empty test, or nothing. */
  function days(f) {
    if (askedOf(f)) return emptyTest(askedOf(f))
    const gte = showBound(f, 'gte') || undefined
    const lte = showBound(f, 'lte') || undefined
    return gte || lte ? { gte, lte } : undefined
  }
  // A relative day stays a token until `tethered()` builds the request (`FJS-D1601`).
  const toBound   = (f, key, day) =>
    day === undefined || !isInstant(f) || readDayToken(day) !== undefined ? day : dayToInstant(day, key)
  const writeDays = (f, next) =>
    write(f, isEmptyTest(next) ? next : next && { gte: toBound(f, 'gte', next.gte), lte: toBound(f, 'lte', next.lte) })

  // ── Asking for the empty ─────────────────────────────────────────────────
  //
  // The test's spelling is `@frontierjs/toolbelt/query`'s. A bare `null` handed
  // to `write()` is *clear*; a hand-typed `?dueAt=null` in the query reads as
  // *Empty* all the same.
  const isEmptyTest = (v) => v !== null && !!emptyTestOf(v)
  const askedOf     = (f) => emptyTestOf(held?.[keyOf(f)])

  // A text, number or set control on an optional column carries an operator
  // menu asking *is empty* and *has value* (`FJS-D1595`). Through a to-many
  // the question is whether any row joins, which is not this test; a list
  // column holds an array, whose empty is `[]`.
  const ASKED    = { text: 'contains', range: 'between', set: 'is any of' }
  const askable  = (f) => !!f.rule?.nullable && !f.through && !entryFor(f)
    && (f.kind === 'text' || (f.kind === 'set' && f.op === 'in') || (f.kind === 'range' && rangeType(f) === 'number'))
  const opsFor   = (f) => [
    { value: 'value',  label: f.label + ' ' + ASKED[f.kind] },
    { value: 'empty',  label: f.label + ' is empty' },
    { value: 'filled', label: f.label + ' has value' },
  ]
  // On an optional string `''` is no value (`FJS-D1593`), whichever control
  // asks — a set over a `String?` too.
  const writeAsked = (f, op) =>
    write(f, op === 'value' ? undefined : emptyTest(op, { blank: f.kind === 'text' || f.rule?.type === 'string' }))

  /** Is anything filtered at all? Drives the clear-all affordance. */
  const isSet  = (f) => !!askedOf(f) || current(f) !== undefined
  const active = searching !== '' || offered.some(isSet)

  // ── The bar holds a few, the rest are added ──────────────────────────────
  //
  // The first ranked draw inline; the rest wait behind `+ Filter` and draw as
  // a removable chip once added. One the query already holds is a chip whether
  // or not it was added here, or a bookmark filters by something not on screen.
  const INLINE  = 3
  let added     = []
  const inline  = offered.slice(0, INLINE)
  const chips   = offered.slice(INLINE).filter(f => added.includes(f.name) || isSet(f))
  const addable = offered.slice(INLINE).filter(f => !added.includes(f.name) && !isSet(f))

  function remove(f) {
    added = added.filter(n => n !== f.name)
    if (isSet(f)) write(f, undefined)
  }

  /**
   * `$search` is a DIRECTIVE, not a column filter, so it is written by name and
   * never through `write()` — there is no operator to wrap it in and no column
   * it belongs to. What it shares is the paging rule: results for a different
   * question do not have a page 3 either.
   */
  function writeSearch(next) {
    const query = { ...held }
    if (next === undefined || next === null || next === '') delete query.$search
    else query.$search = next
    delete query.$offset
    delete query.$after
    emit(query)
  }

  /**
   * Write one column's filter and hand back the whole query.
   *
   * `undefined` deletes rather than blanking, which is the rule above; and the
   * paging directives go with any change, which is the other one.
   */
  function write(f, next) {
    const query = { ...held }

    // A range is empty when neither bound survives, and a bound cleared by
    // hand is `''`, so the test is on the bounds kept and not on the keys.
    const range = {}
    if (f.kind === 'range') {
      if (next?.gte !== undefined && next.gte !== '') range.gte = next.gte
      if (next?.lte !== undefined && next.lte !== '') range.lte = next.lte
    }

    const empty = isEmptyTest(next) ? false : next === undefined || next === null || next === ''
      || (Array.isArray(next) && !next.length)
      || (f.kind === 'range' && !Object.keys(range).length)

    if (empty) delete query[keyOf(f)]
    else if (isEmptyTest(next)) query[keyOf(f)] = next
    else if (f.kind === 'range') {
      query[keyOf(f)] = range
    } else {
      const asked = { [Array.isArray(f.op) ? f.op[0] : f.op]: next }
      query[keyOf(f)] =f.through ? { some: { [f.through.field]: asked } } : asked
    }

    delete query.$offset
    delete query.$after

    emit(query)
  }

  // Clear empties the filters and keeps every directive but three, read off the
  // toolbelt table rather than listed: a list naming the ones to KEEP dropped
  // `onlyDeleted`, and a Trash view cleared into the live rows (`FJS-2598`).
  // `search` goes because it is WHAT is being asked for; `offset` and `after`
  // because a different question has no page 3.
  function clearAll() {
    const { directives: { search, offset, after, ...kept } } = splitParams(held)
    added = []
    onchange?.({}, kept)
  }

  // ── A relation is searched, not listed ───────────────────────────────────
  //
  // A related table outgrows one answer, and a list of its first page leaves
  // the row a person wants absent. So an entry carrying `optionsFor` (sierra's
  // `filters()` adds it to a fetched column) seeds the list with that page,
  // held picks labeled, and typing asks the server. Every row an answer brings
  // is kept: a pick is handed back by matching what was offered, and a row
  // only a search found would travel as the string the control reports.
  let fetched = {}

  function learn(f, rows) {
    const known = new Map((fetched[f.name] ?? []).map(o => [String(o.value), o]))
    for (const o of rows ?? []) known.set(String(o.value), o)
    fetched = { ...fetched, [f.name]: [...known.values()] }
  }

  function seed() {
    for (const f of filters) {
      if (!f.op || !f.optionsFor || options?.[f.name]?.length) continue
      f.optionsFor({ record: { [f.name]: current(f) } }).then(r => learn(f, r?.options))
    }
  }
  seed()
  $: filters, () => seed()

  const askFor = (f) => f.optionsFor && {
    delay: 200,
    trigger: (q) => f.optionsFor({ search: q }).then(r => (learn(f, r?.options), r?.options ?? [])),
  }

  /** The page's rows, a fetched column's, or the enum's own members. */
  function choicesFor(f) {
    if (options?.[f.name]?.length) return options[f.name]
    return fetched[f.name] ?? f.rule?.options ?? f.rule?.enum ?? []
  }

  /**
   * A MultiSelect reports its picks as strings; the offered options hold the
   * values the column holds. Handed back as typed, an integer key travels as
   * `"1"`, which the Data boundary may refuse where it takes `1`.
   */
  function backToValues(f, picked) {
    const offered = choicesFor(f)
    return (picked ?? []).map(p => offered.find(o => String(o.value) === String(p))?.value ?? p)
  }

  const entryFor = (f) => (f.display ? filterComponent(f.display) : null)

  // A declared enum this short is a row of toggles; longer, a MultiSelect
  // (`FJS-D1583`). Gated on DECLARED members: a `@values` binding is also
  // `display: 'enum'`, but its rows arrive later and their count moves with the
  // data, so it would draw empty and then swap controls.
  const CHIP_LIMIT = 6
  const chipped = (f) => f.kind === 'set' && !f.rule?.values
    && Array.isArray(f.rule?.enum) && f.rule.enum.length <= CHIP_LIMIT

  /** The members as `{ value, label }` — `rule.options` once labels are normalized, bare strings before. */
  const chipsFor = (f) => choicesFor(f).map(o => (o && typeof o === 'object' ? o : { value: o, label: o }))

  /** A hand-typed URL may hold one member as a string rather than a list. */
  const picked = (f) => [].concat(current(f) ?? []).map(String)

  function toggle(f, v) {
    const on = picked(f).includes(String(v))
    write(f, backToValues(f, on ? picked(f).filter(p => p !== String(v)) : [...picked(f), v]))
  }

  // The query holds a boolean, or a string off a hand-typed URL, so each
  // segment's value is the string both compare equal to.
  const EITHER = [
    { value: 'any',   label: 'Any' },
    { value: 'true',  label: 'Yes' },
    { value: 'false', label: 'No' },
  ]

  const EMPTINESS = [
    { value: 'any',    label: 'Any' },
    { value: 'filled', label: 'Has value' },
    { value: 'empty',  label: 'Empty' },
  ]
</script>

{#snippet control(f)}
  {#if entryFor(f)}
    {@const Custom = entryFor(f).component}
    <Custom {...(entryFor(f).props ?? defaultFilterProps)({
      value: current(f), onvalue: (v) => write(f, v), column: f, options: choicesFor(f),
    })} />
  {:else if chipped(f)}
    <span class="filter-range" role="group" aria-label={f.label}>
      <span class="text-muted" aria-hidden="true">{f.label}</span>
      {#each chipsFor(f) as c}
        <Button
          treatment="outlined"
          size="sm"
          aria-pressed={String(picked(f).includes(String(c.value)))}
          onclick={() => toggle(f, c.value)}
        >{c.label}</Button>
      {/each}
    </span>
  {:else if f.kind === 'set'}
    <MultiSelect
      multiple
      value={current(f) ?? []}
      options={choicesFor(f)}
      asyncOptions={askFor(f) || undefined}
      placeholder={f.label}
      aria-label={f.label}
      onchange={(next) => write(f, backToValues(f, next))}
    />
  {:else if f.kind === 'exact'}
    <span class="filter-range">
      <span class="text-muted" aria-hidden="true">{f.label}</span>
      <!-- No `label` prop: one wraps the group in a Field, a caption over a toolbar. -->
      <RadioGroup
        layout="segmented"
        items={EITHER}
        value={current(f) === undefined || current(f) === null ? 'any' : String(current(f))}
        aria-label={f.label}
        onchange={(v) => write(f, v === 'any' ? undefined : v === 'true')}
      />
    </span>
  {:else if f.kind === 'empty'}
    <span class="filter-range">
      <span class="text-muted" aria-hidden="true">{f.label}</span>
      <RadioGroup
        layout="segmented"
        items={EMPTINESS}
        value={askedOf(f) ?? 'any'}
        aria-label={f.label}
        onchange={(v) => write(f, v === 'any' ? undefined : emptyTest(v))}
      />
    </span>
  {:else if f.kind === 'range' && f.display === 'money'}
    <RangeInput
      label={f.label}
      value={current(f)}
      show={showMinor(f)}
      read={readMinor(f)}
      data-currency={moneyCode(f)}
      onvalue={(next) => write(f, next)}
    />
  {:else if f.kind === 'range' && rangeType(f) === 'number'}
    <RangeInput label={f.label} value={current(f)} onvalue={(next) => write(f, next)} />
  {:else if f.kind === 'range' && rangeType(f) === 'date'}
    <DayRangeFilter label={f.label} nullable={!!f.rule?.nullable} value={days(f)} onvalue={(next) => writeDays(f, next)} />
  {:else if f.kind === 'range'}
    <span class="filter-range">
      <!-- A time box draws its own format where a placeholder would be, so
           the column's name has to be on screen beside it. Hidden from a
           reader, which has the aria-label on each box already. -->
      <span class="text-muted" aria-hidden="true">{f.label}</span>
      <Input
        type="time"
        value={showBound(f, 'gte')}
        placeholder={f.label + ' from'}
        aria-label={f.label + ' from'}
        oninput={(e) => writeBound(f, 'gte', e.target.value)}
      />
      <Input
        type="time"
        value={showBound(f, 'lte')}
        placeholder={f.label + ' to'}
        aria-label={f.label + ' to'}
        oninput={(e) => writeBound(f, 'lte', e.target.value)}
      />
    </span>
  {:else}
    <Input
      value={current(f) ?? ''}
      placeholder={f.label}
      aria-label={f.label}
      oninput={(e) => write(f, e.target.value)}
    />
  {/if}
{/snippet}

{#snippet asking(f)}
  {#if askable(f)}
    <span class="filter-range">
      <Select
        value={askedOf(f) ?? 'value'}
        options={opsFor(f)}
        placeholder=""
        aria-label={f.label + ': ' + ASKED[f.kind] + ', is empty or has value'}
        style="--field-inline-size: auto"
        oninput={(e) => writeAsked(f, e.target.value)}
      />
      {#if !askedOf(f)}{@render control(f)}{/if}
    </span>
  {:else}
    {@render control(f)}
  {/if}
{/snippet}

<div class="filter-bar cluster" {...$attributes}>
  {#if searchable}
    <Input
      type="search"
      value={searching}
      placeholder={'Search ' + searchable.labels.join(', ')}
      aria-label={'Search ' + searchable.labels.join(', ')}
      oninput={(e) => writeSearch(e.target.value)}
    />
  {/if}

  {#each inline as f}
    {@render asking(f)}
  {/each}

  {#each chips as f}
    <span class="filter-chip" role="group" aria-label={f.label}>
      {@render asking(f)}
      <Button treatment="ghost" size="sm" aria-label={'Remove ' + f.label} onclick={() => remove(f)}>×</Button>
    </span>
  {/each}

  {#if addable.length}
    <DropdownMenu>
      {#snippet trigger()}<Button treatment="ghost" size="sm">+ Filter</Button>{/snippet}
      {#each addable as f}
        <DropdownItem onclick={() => added = [...added, f.name]}>{f.label}</DropdownItem>
      {/each}
    </DropdownMenu>
  {/if}

  {#if active}
    <Button treatment="ghost" size="sm" onclick={clearAll}>Clear</Button>
  {/if}
</div>

<style>
  .filter-range { display: inline-flex; gap: var(--space-xs); align-items: center; }
  .filter-chip  {
    display: inline-flex; gap: var(--space-xs); align-items: center;
    padding-inline-start: var(--space-xs);
    border: var(--border-width) solid var(--rule);
    border-radius: var(--btn-radius);
  }
</style>
