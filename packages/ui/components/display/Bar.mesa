<script>
  // Bar.mesa
  // Horizontal percentage fill bar. CPU/mem/disk style — "how full is this",
  // as opposed to Progress.mesa's "how far through a task are we".
  //
  // Also a native <progress class="progress">, so the value and max are
  // announced by the platform. The difference from Progress is the threshold
  // tone: `tone="auto"` grades the fill success → warning → danger as the
  // resource fills up.
  //
  // Usage — full:
  //   <Bar label="CPU" value={74} unit="%" />
  //   <Bar label="Memory" value={8.2} max={16} unit="GB" />
  //
  // Usage — compact (inline, no label):
  //   <Bar value={42} size="sm" />

  import { tone as toTone, cx } from '../../utils.js'

  export let value   = 0        // current value
  export let max     = 100      // maximum value (value/max = fill %)
  export let label   = ''       // left label — omitted when size="sm"
  export let unit    = ''       // appended to the value display: "74%" / "8.2GB"
  export let tone    = 'auto'   // 'auto' | one of the 7 css tones
  export let color   = ''       // legacy alias for `tone`
  export let size    = 'md'     // 'sm' | 'md'
  export let showVal = true     // show the numeric value (md only)

  // Clamp 0–100
  const pct = Math.min(100, Math.max(0, (value / max) * 100))
  const displayVal = unit ? `${value}${unit}` : `${Math.round(pct)}%`

  // Threshold grading: success < 60, warning < 80, danger >= 80
  const requested = color || tone
  const t = requested === 'auto'
    ? (pct >= 80 ? 'danger' : pct >= 60 ? 'warning' : 'success')
    : toTone(requested)

  const isCompact = size === 'sm'
  const height = isCompact ? '0.375rem' : '0.5rem'
</script>

{#if isCompact}
  <progress
    class={cx('progress', t)}
    style:block-size={height}
    value={value}
    max={max}
    aria-label={label || displayVal}
    {class}
    {...$attributes}
  >{displayVal}</progress>

{:else}
  <div class="stack" style:gap="0.375rem" {class} {...$attributes}>
    {#if label || showVal}
      <div class="split">
        {#if label}
          <span class="text-xs">{label}</span>
        {/if}
        {#if showVal}
          <span class="text-xs text-muted">{displayVal}</span>
        {/if}
      </div>
    {/if}

    <progress
      class={cx('progress', t)}
      style:block-size={height}
      value={value}
      max={max}
      aria-label={label || displayVal}
    >{displayVal}</progress>
  </div>
{/if}
