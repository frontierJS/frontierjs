<script>
  // Sparkline.mesa
  // Compact SVG time-series chart. Polyline + optional area fill.
  // No axes, no labels — pure visual trend indicator.
  //
  // Color comes from the tone, via currentColor — so a Sparkline in a themed
  // subtree recolors with the theme, instead of holding a private hex palette
  // that all six themes would have to be reconciled against by hand.
  //
  // Usage:
  //   <Sparkline data={[12, 18, 14, 22, 19, 28, 31]} />
  //   <Sparkline data={values} tone="success" fill width={120} height={36} />
  //   <Sparkline data={values} tone="danger" />

  import { tone as toTone, cx, plotValue, plotRuns } from '../../utils.js'

  export let data   = []      // number[] — raw values
  export let width  = 80      // px
  export let height = 28      // px
  export let tone   = ''      // one of the 7 css tones; '' is primary
  export let fill   = true    // area fill under the line
  export let smooth = false   // cubic bezier curves instead of a polyline
  export let label  = ''      // accessible summary; without one it is decorative

  const t = toTone(tone)

  // Normalize data to SVG coordinates
  // SVG origin is top-left; we flip Y so higher values go up
  const pad = 2  // px padding so the stroke isn't clipped at edges

  // A missing value is a gap: out of min/max, and a break between two runs.
  // A point keeps its own slot on the x axis, so a gap reads as time passing.
  const values = data.map(plotValue)
  const runs = (() => {
    const plotted = values.filter(v => v != null)
    if (!plotted.length) return []
    const min = Math.min(...plotted)
    const max = Math.max(...plotted)
    const range = max - min || 1
    const innerW = width  - pad * 2
    const innerH = height - pad * 2
    const at = (i) => ({
      x: pad + (i / Math.max(values.length - 1, 1)) * innerW,
      y: pad + (1 - (values[i] - min) / range) * innerH,
    })
    return plotRuns(values).map(run => run.map(at))
  })()

  // A run of one point repeats it, so the round cap draws a dot.
  const pointsOf = (pts) => (pts.length === 1 ? [pts[0], pts[0]] : pts).map(p => `${p.x},${p.y}`).join(' ')

  const curveOf = (pts) => {
    let d = ''
    for (let i = 1; i < pts.length; i++) {
      const prev = pts[i - 1]
      const curr = pts[i]
      const cpX  = (prev.x + curr.x) / 2
      d += ` C ${cpX},${prev.y} ${cpX},${curr.y} ${curr.x},${curr.y}`
    }
    return d
  }

  // Each run's filled area: line down to baseline, back to its start
  const areaPath = runs.map(pts =>
    `M ${pts[0].x},${height - pad} L ${pts.map(p => `${p.x},${p.y}`).join(' L ')} L ${pts[pts.length - 1].x},${height - pad} Z`
  ).join(' ')

  const smoothPath = runs.map(pts =>
    `M ${pts[0].x},${pts[0].y}${pts.length === 1 ? ` L ${pts[0].x},${pts[0].y}` : curveOf(pts)}`
  ).join(' ')

  const smoothAreaPath = !smooth ? '' : runs.map(pts =>
    `M ${pts[0].x},${height - pad} L ${pts[0].x},${pts[0].y}${curveOf(pts)} L ${pts[pts.length - 1].x},${height - pad} Z`
  ).join(' ')

  const lastRun = runs[runs.length - 1]
  const last = lastRun?.[lastRun.length - 1]

  const fillId = `spark-fill-${Math.random().toString(36).slice(2, 7)}`
</script>

<svg
  width={width}
  height={height}
  viewBox="0 0 {width} {height}"
  xmlns="http://www.w3.org/2000/svg"
  class={cx('fjs-sparkline', t)}
  role={label ? 'img' : null}
  aria-label={label || null}
  aria-hidden={label ? null : 'true'}
  {class}
  {...$attributes}
>
  {#if fill && runs.length}
    <defs>
      <linearGradient id={fillId} x1="0" y1="0" x2="0" y2="1">
        <stop offset="0%"   stop-color="currentColor" stop-opacity="0.2" />
        <stop offset="100%" stop-color="currentColor" stop-opacity="0.02" />
      </linearGradient>
    </defs>
    <path
      d={smooth ? smoothAreaPath : areaPath}
      fill="url(#{fillId})"
    />
  {/if}

  {#if runs.length}
    {#if smooth}
      <path
        d={smoothPath}
        fill="none"
        stroke="currentColor"
        stroke-width="1.5"
        stroke-linecap="round"
        stroke-linejoin="round"
      />
    {:else}
      {#each runs as pts}
        <polyline
          points={pointsOf(pts)}
          fill="none"
          stroke="currentColor"
          stroke-width="1.5"
          stroke-linecap="round"
          stroke-linejoin="round"
        />
      {/each}
    {/if}

    <!-- Terminal dot at the last value -->
    <circle
      cx={last.x}
      cy={last.y}
      r="2"
      fill="currentColor"
    />
  {/if}
</svg>

<style>
  /* The tone class sets --bg-mix; currentColor is what the strokes and the
     gradient stops read, so one declaration drives the whole drawing. */
  .fjs-sparkline {
    color:       var(--bg-mix, var(--color-primary));
    display:     block;
    flex-shrink: 0;
  }
</style>
