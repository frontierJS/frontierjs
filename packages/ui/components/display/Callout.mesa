<script>
  // Callout.mesa
  // Inline aside for tips, notes, warnings. Not dismissible — persistent
  // contextual info. Use Alert for system feedback; use Callout for
  // editorial/instructional content.
  //
  // Same `.alert` shape as Alert, plus `outlined` — the Treatment that means
  // "border only, no fill" on any surface. That is what makes a Callout read
  // lighter than an Alert without inventing a second set of colours.
  //
  // Usage:
  //   <Callout>Enable 2FA in Settings → Security before continuing.</Callout>
  //
  //   <Callout tone="warning" title="Breaking change">
  //     This API will be removed in v3.0.
  //   </Callout>
  //
  //   <Callout tone="success">
  //     You can also use <Mono>⌘K</Mono> to open the command palette.
  //   </Callout>

  import { tone as toTone, cx } from '../../utils.js'

  export let tone  = ''      // one of the 7 css tones; '' is untoned
  export let type  = ''      // legacy alias — 'tip' → success, 'note' → muted
  export let title = ''
  export let filled = false  // drop `outlined` for the solid Alert weight

  // 'tip' and 'note' have no tone equivalent, so they are mapped here rather
  // than in utils.js — they are this component's vocabulary, not the system's.
  const LEGACY = { tip: 'success', note: 'muted' }
  const t = toTone(LEGACY[type] ?? type ?? '') || toTone(tone)

  const iconPathMap = {
    info:      'M11.25 11.25l.041-.02a.75.75 0 0 1 1.063.852l-.708 2.836a.75.75 0 0 0 1.063.853l.041-.021M21 12a9 9 0 1 1-18 0 9 9 0 0 1 18 0Zm-9-3.75h.008v.008H12V8.25Z',
    success:   'M12 18v-5.25m0 0a6.01 6.01 0 0 0 1.5-.189m-1.5.189a6.01 6.01 0 0 1-1.5-.189m3.75 7.478a12.06 12.06 0 0 1-4.5 0m3.75 2.355a14.998 14.998 0 0 1-3 0M15 6.75a3 3 0 1 1-6 0 3 3 0 0 1 6 0Z',
    warning:   'M12 9v3.75m-9.303 3.376c-.866 1.5.217 3.374 1.948 3.374h14.71c1.73 0 2.813-1.874 1.948-3.374L13.949 3.378c-.866-1.5-3.032-1.5-3.898 0L2.697 16.126ZM12 15.75h.007v.008H12v-.008Z',
    danger:    'M12 9v3.75m9-.75a9 9 0 1 1-18 0 9 9 0 0 1 18 0Zm-9 3.75h.008v.008H12v-.008Z',
    muted:     'M16.862 4.487l1.687-1.688a1.875 1.875 0 1 1 2.652 2.652L10.582 16.07a4.5 4.5 0 0 1-1.897 1.13L6 18l.8-2.685a4.5 4.5 0 0 1 1.13-1.897l8.932-8.931Zm0 0L19.5 7.125',
  }

  const path = iconPathMap[t] ?? iconPathMap.info
</script>

<!--
  <aside> rather than role="alert": a Callout is complementary content the
  reader can come back to, not something to interrupt them with. That is the
  whole difference from Alert, and it belongs in the element, not the styling.
-->
<aside class={cx('alert', t, !filled && 'outlined')} {class}>
  <div class="alert-icon">
    <svg
      xmlns="http://www.w3.org/2000/svg"
      fill="none"
      viewBox="0 0 24 24"
      stroke-width="1.5"
      stroke="currentColor"
      aria-hidden="true"
    >
      <path stroke-linecap="round" stroke-linejoin="round" d={path} />
    </svg>
  </div>

  <div class="alert-content">
    {#if title}
      <strong>{title}</strong>
    {/if}
    <slot />
  </div>
</aside>
