<script>
  // Avatar.mesa
  // User avatar. Tries the image src first, falls back to initials derived
  // from `name`, falls back to a generic person icon.
  //
  // `.avatar` is one class on one element — the <img> or the <span> IS the
  // avatar, there is no wrapper. Size is the `--avatar-size` token, and the
  // font scales from it, so one value resizes the whole thing.
  //
  // ── The accessibility rule, which is markup and not CSS ──────────────
  //
  // Both forms are decorative by default: nine times out of ten the avatar
  // sits beside the name it abbreviates, and announcing "D O" or the name
  // twice is noise. Pass `standalone` when the avatar IS the only
  // identification — the image then gets the name as its `alt` and the
  // initials get role="img" and the name. Getting this wrong is the common
  // avatar bug in both directions: a wall of unlabelled images, or a screen
  // reader repeating a name it just read.
  //
  // A stored colour (a client's own hex) is `--data-accent` in `style`, which
  // the fill reads before the tone and keeps readable text on.
  //   <Avatar name={c.name} style={`--data-accent: ${c.avatarColor}`} />
  //
  // Usage:
  //   <Avatar src={user.avatar} name={user.name} />
  //   <Avatar name="Alice Zhao" size="lg" />
  //   <Avatar name="Dana Ortiz" standalone />
  //   <Avatar src={url} status="online" />
  //   <Avatar name="Team" shape="square" />

  import { tone as toTone, cx, TONES } from '../../utils.js'

  export let src        = ''     // image URL — empty string = use initials
  export let name       = ''     // used for initials + alt text
  export let size       = 'md'   // 'xs'|'sm'|'md'|'lg'|'xl'
  export let shape      = 'circle'  // 'circle' | 'square'
  export let status     = ''     // ''|'online'|'offline'|'away'|'busy'
  export let tone       = ''     // pin the initials fill instead of deriving it
  export let standalone = false  // this avatar is the only identification

  let failedSrc = ''

  const sizeMap = {
    xs: '1.5rem', sm: '2rem', md: '2.25rem', lg: '2.75rem', xl: '3.5rem',
  }

  // Status maps onto the tone vocabulary rather than a second color list.
  const statusToneMap = {
    online:  'success',
    offline: 'muted',
    away:    'warning',
    busy:    'danger',
  }

  // A prop default covers undefined only, and auth's user.name is String?, so
  // null is what a signed-in user without a name hands over (FJS-2604).
  const n = name ?? ''

  // First letter of the first two words, a word being a run of letters or
  // digits: "Smith & Sons" is SS and "acme.com" is AC, where a whitespace
  // split drew "S&" and "A".
  const initials = (n.match(/[\p{L}\p{N}]+/gu) ?? [])
    .slice(0, 2)
    .map(w => Array.from(w)[0].toUpperCase())
    .join('')

  // Deterministic tone from the name, so the same person is always the same
  // color. Picking from the 7 tones rather than a private palette means the
  // fill and the text contrast are both derived by chip.css. The table is fixed,
  // so its size is a `var` — an imported read inside a `const` is otherwise
  // reported as one nothing watches (`FJS-1340`).
  var toneCount = TONES.length
  const autoTone = TONES[
    n.split('').reduce((acc, c) => acc + c.charCodeAt(0), 0) % toneCount
  ]

  const sz          = sizeMap[size] ?? sizeMap.md
  const px          = Math.round(parseFloat(sz) * 16)   // reserves the box before the image loads
  const statusTone  = statusToneMap[status] ?? ''
  const radius      = shape === 'square' ? 'var(--card-radius, 0.5rem)' : '999px'
  const initialTone = toTone(tone) || autoTone

  // The failure belongs to the URL that failed, so a new src gets its try.
  const showImage = src && src !== failedSrc

  function handleImgError() { failedSrc = src }
</script>

<span class="fjs-avatar-wrap" style:inline-size={sz} style:block-size={sz} {class} {...$attributes}>
  {#if showImage}
    <img
      class="avatar"
      src={src}
      alt={standalone ? n : ''}
      width={px}
      height={px}
      decoding="async"
      style:--avatar-size={sz}
      style:--avatar-radius={radius}
      style:object-fit="cover"
      onerror={handleImgError}
    />
  {:else if initials}
    <span
      class={cx('avatar', initialTone)}
      style:--avatar-size={sz}
      style:--avatar-radius={radius}
      role={standalone ? 'img' : null}
      aria-label={standalone ? name : null}
      aria-hidden={standalone ? null : 'true'}
    >
      {initials}
    </span>
  {:else}
    <!-- Generic person icon fallback -->
    <span
      class="avatar muted"
      style:--avatar-size={sz}
      style:--avatar-radius={radius}
      role={standalone ? 'img' : null}
      aria-label={standalone ? (name || 'User') : null}
      aria-hidden={standalone ? null : 'true'}
    >
      <svg viewBox="0 0 24 24" fill="currentColor" aria-hidden="true" style:--icon-size="0.6em">
        <path d="M7.5 6.5C7.5 8.981 9.519 11 12 11s4.5-2.019 4.5-4.5S14.481 2 12 2 7.5 4.019 7.5 6.5zM20 21h1v-1c0-3.859-3.141-7-7-7h-4c-3.86 0-7 3.141-7 7v1h17z"/>
      </svg>
    </span>
  {/if}

  {#if statusTone}
    <!--
      The dot is decorative; the status word goes in a visually-hidden span so
      it is actually announced. An aria-label on a <span> with no role is
      ignored by most screen readers, which is what the old markup did.
    -->
    <span
      class={cx('fjs-avatar-status', statusTone)}
      style:inline-size={`calc(${sz} * 0.28)`}
      style:block-size={`calc(${sz} * 0.28)`}
      aria-hidden="true"
    ></span>
    <span class="visually-hidden">{status}</span>
  {/if}
</span>

<style>
  /* A positioning context for the status dot — .avatar itself must stay a
     plain box so chip.css owns its layout. */
  .fjs-avatar-wrap {
    position:    relative;
    display:     inline-flex;
    flex-shrink: 0;
  }
  .fjs-avatar-status {
    position:      absolute;
    inset-block-end:  0;
    inset-inline-end: 0;
    border-radius: 999px;
    background:    var(--bg-mix, var(--color-muted));
    box-shadow:    0 0 0 2px var(--surface);
  }
</style>
