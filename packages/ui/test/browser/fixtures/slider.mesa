<script>
  // slider.mesa — a bare slider named only by aria-label, a labelled one, and a range.
  import Slider from '../../../components/forms/Slider.mesa'

  let vol = 20
  let lo  = 20
  let hi  = 80

  // Calls on the first slider, read by the spec: oninput per value, onchange
  // once per gesture (FJS-2471).
  window.tally = { input: 0, change: 0 }
  window.got = {}
  const onin = (v) => { window.tally.input++; window.got.input = v }
  const onch = (v) => { window.tally.change++; window.got.change = v }
  const onrange = (v) => { window.got.range = v }
</script>

<div style="width: 400px; margin: 40px">
  <Slider id="vol" bind:value={vol} oninput={onin} onchange={onch} min={0} max={100} step={10} aria-label="Volume" />
</div>
<div style="width: 400px; margin: 40px">
  <Slider range label="Price" bind:start={lo} bind:end={hi} onchange={onrange} min={0} max={100} step={10} />
</div>

<div style="width: 400px; margin: 40px">
  <Slider id="hue" value={50} aria-label="Hue" style="--data-accent: hsl(200 80% 50%)" />
</div>
<div style="width: 400px; margin: 40px">
  <Slider id="plain" value={50} aria-label="Plain" tone="danger" />
</div>

<div style="width: 300px; margin: 40px; overflow: auto">
  <Slider id="ends" value={200} min={100} max={200} format={(v) => v + '%'} aria-label="Zoom" />
</div>
<div style="width: 300px; margin: 40px; overflow: auto">
  <Slider id="ends-lo" value={100} min={100} max={200} format={(v) => v + '%'} aria-label="Zoom low" />
  <Slider id="ends-range" range start={100} end={200} min={100} max={200} format={(v) => v + '%'} aria-label="Zoom range" />
</div>

<output id="vol-out">{vol}</output>
<output id="range-out">{lo},{hi}</output>
