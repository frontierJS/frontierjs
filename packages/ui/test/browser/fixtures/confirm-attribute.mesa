<script>
  // confirm-attribute.mesa — `data-confirm` on three shapes of element, with
  // one <ConfirmProvider /> mounted the way an app mounts it.
  //
  // The three are not decoration: a delegated handler, a form submit and an
  // anchor are the only ways an action starts from a click, and the provider
  // re-fires with `el.click()` on the claim that one re-fire covers all of
  // them.
  import ConfirmProvider from '../../../components/overlay/ConfirmProvider.mesa'
  import Input           from '../../../components/forms/Input.mesa'
  import Button          from '../../../components/forms/Button.mesa'

  // A second provider hears every click the first one does (FJS-2611).
  export let second = false

  let password = ''

  let ran      = []          // what actually happened
  let submits  = 0

  const did = (what) => { ran = [...ran, what] }
</script>

<ConfirmProvider />
{#if second}<ConfirmProvider />{/if}

<button id="guarded" class="btn danger" data-confirm="Delete this order?"
        onclick={() => did('delete')}>Delete</button>

<button id="plain" class="btn" onclick={() => did('plain')}>No confirmation</button>

<button id="worded" class="btn" data-confirm
        data-confirm-title="Leave the workspace?"
        data-confirm-label="Leave"
        onclick={() => did('leave')}>Leave</button>

<button id="busy-delete" class="btn danger" data-confirm="Delete while busy?"
        onclick={() => did('busy-delete')}>Delete</button>

<form id="form" onsubmit|preventDefault={() => { submits++; did('submit') }}>
  <button id="submit" type="submit" data-confirm="Send it?">Send</button>
</form>

<form id="beside" class="stack" novalidate onsubmit={e => e.preventDefault()}>
  <Input id="beside-password" name="currentPassword" type="password" label="Your password"
         hint="Needed for either of these" autocomplete="current-password"
         value={password} oninput={e => password = e.target.value} />
  <div class="cluster">
    <Button treatment="outlined" id="beside-regenerate" disabled={!password}
            data-confirm="Every recovery code you saved stops working."
            onclick={() => did('regenerate')}>New recovery codes</Button>
    <Button treatment="outlined" tone="danger" id="beside-off" disabled={!password}
            data-confirm="Signing in asks for your password only."
            data-confirm-title="Turn off two-step sign-in?" data-confirm-label="Turn off"
            onclick={() => did('off')}>Turn it off</Button>
  </div>
</form>

<output id="ran">{ran.join('|')}</output>
<output id="submits">{submits}</output>
