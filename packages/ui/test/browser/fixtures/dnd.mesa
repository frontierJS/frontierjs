<script>
  // dnd.mesa — two lists of one type and a third of another.
  //
  // `todo` and `done` share the type `task`, so an item crosses between them;
  // `other` is a different type, so dropping on it must change nothing. Each
  // item carries a <button>, because a press on a control inside an item is a
  // click on that control and must not start a drag. The last callback of each
  // kind is published to `#log` so a spec can read the trigger, not only the
  // lists.
  import { dndzone } from '@frontierjs/ui/dnd'

  let todo  = [{ id: 1, t: 'one' }, { id: 2, t: 'two' }, { id: 3, t: 'three' }, { id: 4, t: 'four' }]
  let done  = [{ id: 5, t: 'five' }]
  let other = [{ id: 9, t: 'nine' }]
  let chips = [1, 2, 3, 4, 5, 6, 7, 8, 9].map((id) => ({ id, t: String(id) }))
  let cols  = [1, 2, 3, 4, 5, 6, 7, 8, 9].map((id) => ({ id, t: String(id) }))
  let grid  = [1, 2, 3, 4, 5, 6, 7, 8, 9].map((id) => ({ id, t: String(id) }))
  let clipA = [{ id: 21, t: 'a1' }, { id: 22, t: 'a2' }]
  let clipB = [{ id: 31, t: 'b1' }, { id: 32, t: 'b2' }]
  let log   = []
  let clicks = 0
  let sources = []

  const record = (list, which) => ({ items, info }) => {
    log = [...log, `${list}:${which}:${info.trigger}`]
    sources = [...sources, info.source]
    if (list === 'todo') todo = items
    else if (list === 'done') done = items
    else other = items
  }
</script>

<div class="board">
  <ul id="todo" {@attach dndzone(() => ({ items: todo, type: 'task', onconsider: record('todo', 'c'), onfinalize: record('todo', 'f') }))}>
    {#each todo as it (it.id)}
      <li data-id={it.id}>{it.t} <button class="poke" onclick={() => clicks++}>·</button></li>
    {/each}
  </ul>
  <ul id="done" {@attach dndzone(() => ({ items: done, type: 'task', onconsider: record('done', 'c'), onfinalize: record('done', 'f') }))}>
    {#each done as it (it.id)}
      <li data-id={it.id}>{it.t}</li>
    {/each}
  </ul>
  <ul id="other" {@attach dndzone(() => ({ items: other, type: 'note', onconsider: record('other', 'c'), onfinalize: record('other', 'f') }))}>
    {#each other as it (it.id)}
      <li data-id={it.id}>{it.t}</li>
    {/each}
  </ul>
</div>

<div id="clip">
  <ul id="clipa" {@attach dndzone(() => ({ items: clipA, type: 'lane', onconsider: ({ items }) => clipA = items, onfinalize: ({ items }) => clipA = items }))}>
    {#each clipA as it (it.id)}
      <li data-id={it.id}>{it.t}</li>
    {/each}
  </ul>
  <ul id="clipb" {@attach dndzone(() => ({ items: clipB, type: 'lane', onconsider: ({ items }) => clipB = items, onfinalize: ({ items }) => clipB = items }))}>
    {#each clipB as it (it.id)}
      <li data-id={it.id}>{it.t}</li>
    {/each}
  </ul>
</div>

<ul id="wrap" {@attach dndzone(() => ({ items: chips, type: 'chip', onconsider: ({ items }) => chips = items, onfinalize: ({ items }) => chips = items }))}>
  {#each chips as c (c.id)}
    <li data-id={c.id}>{c.t}</li>
  {/each}
</ul>

<ul id="cwrap" {@attach dndzone(() => ({ items: cols, type: 'col', onconsider: ({ items }) => cols = items, onfinalize: ({ items }) => cols = items }))}>
  {#each cols as c (c.id)}
    <li data-id={c.id}>{c.t}</li>
  {/each}
</ul>

<ul id="grid" {@attach dndzone(() => ({ items: grid, type: 'cell', onconsider: ({ items }) => grid = items, onfinalize: ({ items }) => grid = items }))}>
  {#each grid as c (c.id)}
    <li data-id={c.id}>{c.t}</li>
  {/each}
</ul>

<output id="clstate">{clipA.map(i => i.id).join(',')}|{clipB.map(i => i.id).join(',')}</output>
<output id="state">{todo.map(i => i.id).join(',')}|{done.map(i => i.id).join(',')}|{other.map(i => i.id).join(',')}</output>
<output id="wstate">{chips.map(i => i.id).join(',')}</output>
<output id="cstate">{cols.map(i => i.id).join(',')}</output>
<output id="gstate">{grid.map(i => i.id).join(',')}</output>
<output id="log">{log.join(' ')}</output>
<output id="clicks">{clicks}</output>
<output id="sources">{sources.join(' ')}</output>

<style>
  .board { display: flex; gap: 2rem; align-items: flex-start; }
  ul { list-style: none; margin: 0; padding: 0.5rem; width: 10rem; min-height: 3rem; }
  #wrap { display: flex; flex-wrap: wrap; gap: 0.25rem; width: 11rem; margin-top: 2rem; }
  #wrap li { box-sizing: border-box; width: 3rem; margin: 0; }
  #cwrap { display: flex; flex-direction: column; flex-wrap: wrap; gap: 0.25rem; height: 7.5rem; width: 11rem; margin-top: 2rem; }
  #cwrap li { box-sizing: border-box; width: 3rem; margin: 0; }
  #grid { display: grid; grid-template-columns: repeat(3, 3rem); gap: 0.25rem; width: 11rem; margin-top: 2rem; }
  #grid li { box-sizing: border-box; margin: 0; }
  #clip { display: flex; gap: 4rem; width: 12rem; overflow-x: auto; margin-top: 2rem; }
  #clip ul { flex: none; }
  li { height: 2rem; line-height: 2rem; margin: 0 0 0.25rem; padding: 0 0.5rem; border: 1px solid var(--rule); }
</style>
