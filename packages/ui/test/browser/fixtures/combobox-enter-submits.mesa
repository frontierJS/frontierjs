<script>
  // combobox-enter-submits.mesa — a combobox inside a form that counts its
  // submits.
  //
  // Enter is the combobox's key while its list is open and the form's once
  // it is closed (`FJS-2789`). A plain <form> rather than the kit's <Form>,
  // so the count is the browser's implicit submission and nothing else.
  import Combobox from '../../../components/forms/Combobox.mesa'

  const OPTIONS = [{ value: 'a', label: 'Alpha' }, { value: 'b', label: 'Bravo' }]
  let value   = null
  let submits = 0
</script>

<form id="f" on:submit|preventDefault={() => submits += 1}>
  <Combobox name="pick" options={OPTIONS} bind:value />
  <button type="submit">save</button>
</form>
<output id="value">{String(value)}</output>
<output id="submits">{submits}</output>
