<script>
  // password-reveal.mesa — the show/hide toggle on a password field.
  //
  // Four cases, because the toggle has to appear for exactly one shape and the
  // three ways of not having it are each a different decision: a password
  // field (auto), a password field that turned it off, a text field, and a
  // password field that also carries a caller icon — the row holds both.
  import Input from '../../../components/forms/Input.mesa'

  let pw    = 'hunter2'
  let quiet = ''
  let plain = ''
  let both  = ''
</script>

{#snippet lock()}<span id="caller-icon">*</span>{/snippet}

<div id="auto">
  <Input name="pw" label="Password" type="password" autocomplete="current-password" bind:value={pw} />
</div>

<div id="off">
  <Input name="quiet" label="No toggle" type="password" reveal={false} bind:value={quiet} />
</div>

<div id="text">
  <Input name="plain" label="Plain" bind:value={plain} />
</div>

<div id="withicon">
  <Input name="both" label="Both" type="password" icon={lock} bind:value={both} />
</div>

<output id="value">{pw}</output>
