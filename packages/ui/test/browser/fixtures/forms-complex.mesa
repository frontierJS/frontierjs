<script>
  // forms-complex.mesa — the small defects of the date, number, picker and
  // file controls (FJS-2609), one control each, so a spec reads one at a time.
  import NumberInput from '../../../components/forms/NumberInput.mesa'
  import Thresholds  from '../../../components/forms/Thresholds.mesa'
  import FileUpload  from '../../../components/forms/FileUpload.mesa'
  import Combobox    from '../../../components/forms/Combobox.mesa'
  import MultiSelect from '../../../components/forms/MultiSelect.mesa'
  import JsonInput   from '../../../components/forms/JsonInput.mesa'
  import Form        from '../../../components/forms/Form.mesa'

  // A page may hand a number over as a string (a query param, a JSON column).
  let qty = '5'

  let cuts = [0.5, 0.6, 0.7]
  window.emitted = []

  let files = []

  const OPTIONS = [
    { value: 'a', label: 'Alpha' },
    { value: 'b', label: 'Beta', disabled: true },
    { value: 'c', label: 'Gamma' },
  ]
  const DISABLED_FIRST = [
    { value: 'x', label: 'Xray', disabled: true },
    { value: 'y', label: 'Yankee' },
  ]
  let pick  = null
  let first = null
  let tags  = ['a']

  // Escape is recorded as the page sees it: whether anything took it. A dialog
  // closes on an Escape nobody preventDefault-ed.
  window.escapes = []
  document.addEventListener('keydown', (e) => {
    if (e.key === 'Escape') window.escapes.push(e.defaultPrevented)
  })

  window.docs = []
</script>

<div id="num"><NumberInput id="qty" bind:value={qty} min={1} max={99} /></div>
<output id="qty-value">{qty === null ? 'null' : String(qty)}</output>

<div id="thr">
  <Thresholds values={cuts} min={0} max={1} step={0.1} onchange={(v) => window.emitted.push(v)} />
</div>

<div id="file"><FileUpload accept="image/*" bind:files={files} /></div>
<output id="file-names">{files.map(f => f.name).join('|')}</output>

<div id="combo"><Combobox id="combo-input" options={OPTIONS} bind:value={pick} /></div>
<output id="pick">{pick ?? ''}</output>
<div id="combo2"><Combobox id="combo2-input" options={DISABLED_FIRST} bind:value={first} /></div>
<output id="first">{first ?? ''}</output>

<div id="multi"><MultiSelect id="multi-input" name="multi" options={['a', 'b', 'c']} value={['a']} multiple /></div>

<div id="locked">
  <Form disabled>
    <MultiSelect name="tags" options={['a', 'b', 'c']} bind:value={tags} multiple clearable />
  </Form>
</div>

<div id="json"><JsonInput name="doc" onvalue={(v) => window.docs.push(v)} /></div>
