<script>
  // drawer.mesa — a Drawer as an app writes one: a trigger, a bound `open`,
  // and something focusable inside it.
  //
  // `side` and `dismissible` are props so one fixture covers all four edges
  // and the undismissable case; `side` is snapshot at mount in the component,
  // which is why the spec remounts rather than reassigning.
  import Drawer from '../../../components/overlay/Drawer.mesa'
  import Button from '../../../components/forms/Button.mesa'

  export let side        = 'right'
  export let dismissible = true
  export let resizable   = false
  export let width       = null

  // A prop so a spec can mount the overlay already open, the way a caller
  // writes {#if shown}<Modal open> -- that path never passes through a change.
  export let open = false

  let closes = 0
</script>

<Button id="open-drawer" onclick={() => open = true}>Open</Button>

<Drawer bind:open={open} bind:width={width} side={side} dismissible={dismissible} {resizable} title="Settings" onclose={() => closes++}>
  {#snippet action()}<button type="button" id="pop-out">Pop out</button>{/snippet}
  <p>Drawer content</p>
  <button type="button" id="inside">Inside</button>
</Drawer>

<output id="closes">{closes}</output>
<output id="state">{open ? 'open' : 'shut'}</output>
<output id="width">{width ?? 'none'}</output>
