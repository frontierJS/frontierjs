<script>
  // fileupload.mesa — the dropzone, with the selection reported back so a
  // spec can tell "the list rendered" from "the component accepted the file".
  // The named import is the point of the second half of this fixture: a
  // component's own verbs are importable by its callers (`FJS-D116`), and the
  // only way to know that survives the compiler and the bundler is to import
  // one here and render what it answers.
  import FileUpload, { isImage } from '../../../components/forms/FileUpload.mesa'
  import { formatBytes } from '@frontierjs/toolbelt/units'

  export let multiple  = true
  export let maxSizeMB = 0

  let files   = []
  let changes = 0
</script>

<FileUpload
  label="Attachments"
  hint="PDF or PNG"
  multiple={multiple}
  maxSizeMB={maxSizeMB}
  bind:files={files}
  onchange={() => changes++}
/>

<output id="changes">{changes}</output>
<output id="names">{files.map(f => f.name).join(',')}</output>
<output id="sizes">{[900, 2048, 5 * 1024 * 1024].map(formatBytes).join('|')}</output>
<output id="kinds">{[{ type: 'image/png' }, { type: 'application/pdf' }].map(isImage).join('|')}</output>
