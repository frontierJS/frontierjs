<script>
  // palette-modes.mesa — the palette as a switchboard.
  //
  // `palette.mesa` wires it the way an app root does, through the store, and
  // asks whether ⌘K opens it. This one mounts it already open and turns each
  // prop that selects a BRANCH into a fixture prop, so one spec can be a
  // reordered palette, an empty one, a palette that stays open after a
  // command, or a list long enough that it has to scroll.
  //
  // A function cannot travel as a JSON prop, so `emptyText` and `search` are
  // chosen here by a plain prop and built in the fixture.
  import CommandPalette from '../../../components/overlay/CommandPalette.mesa'

  export let set           = 'default'   // which item list — default · none · long
  export let groupOrder    = []
  export let closeOnSelect = true
  export let useEmptyText  = false
  export let placeholder   = 'Search commands…'
  export let maxWidth      = 580
  export let maxHeight     = '62vh'
  export let searchGroups  = true
  export let source        = 'none'      // the `search` the palette is handed — none · server · failing
  export let groupLimit    = undefined   // a number, or { group: number }
  export let searchMinLength = 0
  export let rowAs         = 'plain'     // plain · custom — whether the palette is handed an `item` snippet

  let open   = true
  let ran    = ''
  let runs   = 0
  let closes = 0
  let asked  = null   // null until the palette first reports

  const hit = (id) => () => { ran = id; runs++ }

  // The groups are declared out of any order worth preserving, so `groupOrder`
  // has something to reorder and its absence has something to keep.
  const MIXED = [
    { id: 'theme',  group: 'Settings', label: 'Switch theme',    icon: '◐',  kbd: '⌘ T',                       action: hit('theme')  },
    { id: 'new',    group: 'Orders',   label: 'New order',       icon: '＋', sub: 'Start a draft',             action: hit('new')    },
    { id: 'refund', group: 'Orders',   label: 'Refund an order', icon: '↩',  badge: 'Beta',                    action: hit('refund') },
    { id: 'staff',  group: 'People',   label: 'Staff',                       sub: 'Everyone who works here',   action: hit('staff')  },
    { id: 'custs',  group: 'People',   label: 'Customers',                   sub: 'Everyone who has ordered',  action: hit('custs')  },
  ]

  // One group, longer than any panel: the bottom of this list can only be
  // reached by the cursor taking the scroll container with it.
  const LONG = Array.from({ length: 30 }, (_, i) => ({
    id: `cmd-${i}`, group: 'Everything', label: `Command ${i}`, action: hit(`cmd-${i}`),
  }))

  // Two groups of different depth, to cap one and not the other.
  const MANY = [
    ...Array.from({ length: 6 }, (_, i) => ({ id: `p${i}`, group: 'People', label: `Person ${i}`, avatar: `P${i}`, action: hit(`p${i}`) })),
    ...Array.from({ length: 4 }, (_, i) => ({ id: `d${i}`, group: 'Docs',   label: `Doc ${i}`,    avatar: `D${i}`, action: hit(`d${i}`) })),
  ]

  const items     = ({ default: MIXED, none: [], long: LONG, many: MANY })[set] ?? MIXED
  const emptyText = useEmptyText ? (q) => `nothing here for “${q}”` : undefined

  // A stand-in for a full-text search: it matches words the rows it returns do
  // NOT show, and answers in its own order — the two things the palette must
  // not undo. `throttling` is a word in an issue's description, as in linear's
  // measured case; `zeta` answers rows already ordered Zeta-before-Alpha;
  // `slow` answers late enough for the words to move past it.
  let searches = 0
  let aborts   = 0
  const SERVER = {
    throttling: [{ id: 'eng-3', group: 'Issues', label: 'Rate-limit the search endpoint', sub: 'ENG-3', action: hit('eng-3') }],
    slow:       [{ id: 'late', group: 'Issues', label: 'A stale answer', action: hit('late') }],
    zeta:       [
      { id: 'z', group: 'Issues', label: 'Zeta rollout', action: hit('z') },
      { id: 'a', group: 'Issues', label: 'Alpha rollout', action: hit('a') },
    ],
  }
  const search = ({
    server: (q, signal) => {
      searches++
      signal.addEventListener('abort', () => { aborts++ })
      return new Promise(r => setTimeout(() => r(SERVER[q.trim()] ?? []), q.trim() === 'slow' ? 600 : 30))
    },
    failing: () => Promise.reject(new Error('search is down')),
  })[source]
</script>

{#if open && rowAs === 'custom'}
  <CommandPalette
    items={items}
    groupLimit={groupLimit}
    searchMinLength={searchMinLength}
    search={search}
    data-fixture="modes"
    onclose={() => { open = false; closes++ }}
  >
    {#snippet item(row, { active })}
      <img class="custom-avatar" alt="" data-avatar={row.avatar} data-active={active} />
      <span class="custom-label">{row.label}</span>
    {/snippet}
  </CommandPalette>
{:else if open}
  <CommandPalette
    items={items}
    groupLimit={groupLimit}
    searchMinLength={searchMinLength}
    groupOrder={groupOrder}
    closeOnSelect={closeOnSelect}
    emptyText={emptyText}
    placeholder={placeholder}
    maxWidth={maxWidth}
    maxHeight={maxHeight}
    searchGroups={searchGroups}
    search={search}
    data-fixture="modes"
    onclose={() => { open = false; closes++ }}
    onquery={(q) => { asked = q }}
  />
{/if}

<output id="ran">{ran}</output>
<output id="runs">{runs}</output>
<output id="closes">{closes}</output>
<output id="searches">{searches}</output>
<output id="aborts">{aborts}</output>
<output id="asked">{asked ?? 'unreported'}</output>
