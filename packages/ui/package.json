{
  "name": "@frontierjs/ui",
  "version": "0.1.2",
  "type": "module",
  "description": "Mesa component kit over @frontierjs/css \u2014 forms, display, layout, overlay, feedback",
  "exports": {
    "./utils.js": "./utils.js",
    "./utils": "./utils.js",
    "./controls.js": "./controls.js",
    "./controls": "./controls.js",
    "./stores/*.js": "./stores/*.js",
    "./stores/*": "./stores/*.js",
    "./components/*.mesa": "./components/*.mesa",
    "./components/*": "./components/*.mesa"
  },
  "scripts": {
    "test": "node test/compile-all.mjs && node test/render.mjs && node test/attributes.mjs && node test/form.mjs && node test/browser/run.mjs",
    "test:browser": "node test/browser/run.mjs",
    "serve": "node test/browser/server.mjs",
    "typecheck": "node ../../scripts/typecheck.mjs"
  },
  "peerDependencies": {
    "@frontierjs/css": "^0.16.0",
    "@frontierjs/mesa": "^0.1.0"
  },
  "devDependencies": {
    "acorn": "^8.0.0"
  },
  "keywords": [
    "mesa",
    "ui",
    "components",
    "forms",
    "overlay"
  ],
  "license": "MIT",
  "files": [
    "components",
    "stores",
    "controls.js",
    "utils.js",
    "tokens.css",
    "README.md",
    "LICENSE"
  ],
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/frontierJS/frontierjs.git",
    "directory": "packages/ui"
  },
  "dependencies": {
    "@frontierjs/toolbelt": "workspace:*"
  }
}
