{
  "name": "@frontierjs/ui",
  "version": "0.1.13",
  "type": "module",
  "description": "Mesa component kit over @frontierjs/css — forms, display, layout, overlay, feedback",
  "exports": {
    "./utils": {
      "types": "./utils.d.ts",
      "default": "./utils.js"
    },
    "./dnd": {
      "types": "./dnd.d.ts",
      "default": "./dnd.js"
    },
    "./drag": {
      "types": "./drag.d.ts",
      "default": "./drag.js"
    },
    "./resize": {
      "types": "./resize.d.ts",
      "default": "./resize.js"
    },
    "./nav": {
      "types": "./nav.d.ts",
      "default": "./nav.js"
    },
    "./selection": {
      "types": "./selection.d.ts",
      "default": "./selection.js"
    },
    "./paste": {
      "types": "./paste.d.ts",
      "default": "./paste.js"
    },
    "./rowlist": {
      "types": "./rowlist.d.ts",
      "default": "./rowlist.js"
    },
    "./controls": {
      "types": "./controls.d.ts",
      "default": "./controls.js"
    },
    "./stores/*": "./stores/*.js",
    "./components/*.mesa": "./components/*.mesa"
  },
  "scripts": {
    "test": "node ../../scripts/tmp-run.mjs 'node ../../scripts/emit-types.mjs --check && node test/compile-all.mjs && node test/render.mjs && node test/filter-bar-key.mjs && node test/display-fixes.mjs && node test/attributes.mjs && node test/no-legacy-aliases.mjs && node test/form.mjs && node test/datetime-zone.mjs && bun test/form-reseal.mjs &&node test/agents-md.mjs && node test/docs-form-wiring.mjs && node test/dnd-configure.mjs && node test/selection.mjs && node test/nav.mjs && node test/place-against.mjs && node test/browser/run.mjs'",
    "types": "node ../../scripts/emit-types.mjs",
    "test:browser": "node test/browser/run.mjs",
    "serve": "node test/browser/server.mjs",
    "typecheck": "node ../../scripts/typecheck.mjs"
  },
  "peerDependencies": {
    "@frontierjs/css": "workspace:^",
    "@frontierjs/mesa": "workspace:^",
    "@xterm/addon-fit": "0.11.0",
    "@xterm/addon-web-links": "0.12.0",
    "@xterm/xterm": "6.0.0"
  },
  "peerDependenciesMeta": {
    "@xterm/addon-fit": {
      "optional": true
    },
    "@xterm/addon-web-links": {
      "optional": true
    },
    "@xterm/xterm": {
      "optional": true
    }
  },
  "devDependencies": {
    "acorn": "^8.0.0"
  },
  "keywords": [
    "mesa",
    "ui",
    "components",
    "forms",
    "overlay"
  ],
  "license": "MIT",
  "files": [
    "AGENTS.md",
    "components",
    "stores",
    "controls.js",
    "controls.d.ts",
    "dnd.js",
    "dnd.d.ts",
    "drag.js",
    "drag.d.ts",
    "nav.js",
    "nav.d.ts",
    "resize.js",
    "resize.d.ts",
    "paste.js",
    "paste.d.ts",
    "rowlist.js",
    "rowlist.d.ts",
    "selection.js",
    "selection.d.ts",
    "utils.js",
    "utils.d.ts",
    "README.md",
    "LICENSE"
  ],
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/frontierJS/frontierjs.git",
    "directory": "packages/ui"
  },
  "dependencies": {
    "@frontierjs/toolbelt": "workspace:*"
  }
}
