{
  "name": "@frontierjs/mcp",
  "version": "0.0.4",
  "engines": {
    "bun": ">=1.4.0"
  },
  "description": "An MCP surface for a FrontierJS app, derived from db/schema.lite — the gate is the permission model",
  "type": "module",
  "license": "MIT",
  "main": "./index.ts",
  "exports": {
    ".": "./index.ts",
    "./projection": "./src/projection.ts",
    "./plugin": "./src/plugin.ts",
    "./client": "./src/client/index.ts",
    "./client/build": "./src/client/build.ts"
  },
  "keywords": [
    "frontierjs",
    "mcp",
    "junction",
    "agent"
  ],
  "peerDependencies": {
    "@frontierjs/junction": "^0.1.0"
  },
  "dependencies": {
    "@frontierjs/toolbelt": "workspace:*",
    "@modelcontextprotocol/client": "^2.3.1",
    "@modelcontextprotocol/ext-apps": "^2.0.3",
    "@modelcontextprotocol/server": "^2.3.1"
  },
  "devDependencies": {
    "bun-types": "^1.3.14",
    "@frontierjs/junction": "workspace:*",
    "@frontierjs/litestone": "workspace:*"
  },
  "scripts": {
    "test": "node ../../scripts/tmp-run.mjs 'bun test test/'",
    "typecheck": "node ../../scripts/typecheck.mjs"
  },
  "files": [
    "*.ts",
    "src",
    "README.md",
    "LICENSE"
  ],
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/frontierJS/frontierjs.git",
    "directory": "packages/mcp"
  }
}
