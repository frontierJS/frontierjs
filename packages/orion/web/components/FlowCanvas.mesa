<script>
  // A flow as a graph: its nodes where the author put them, its edges between
  // them. Local to orion by `FJS-D510` — one consumer, so no kit API is guessed.
  //
  // ─── Two documents, two owners ────────────────────────────────────────────
  //
  // STRUCTURE (which nodes, which edges) is the definition and is written
  // through the page's callbacks, so the textarea, the inspector and this stay
  // one model. POSITION is `FlowLayout` and is never in the definition: moving
  // a node is not a new version, and a version saved from another editor must
  // not lose where the nodes sit. A node the layout has never seen is placed by
  // its depth from a root, so a flow authored as JSON still draws readably.
  //
  // ─── Gestures ─────────────────────────────────────────────────────────────
  //
  // Drag a node to move it, drag the background to pan, the wheel to zoom, and
  // drag from a node's port onto another node to connect them. Every gesture is
  // pointer-captured on the SVG, so a pointer released outside it still ends it.

  export let nodes    = []            // [{ id, type }]
  export let edges    = []            // [{ id, from, to }]
  export let types    = null          // the registry's descriptors, for labels
  export let positions = {}           // { [nodeId]: { x, y } } — FlowLayout's
  export let selected = ''
  export let disabled = false
  export let select   = undefined     // (id) => void
  export let move     = undefined     // (positions) => void, on release
  export let connect  = undefined     // (from, to) => void
  export let unlink   = undefined     // (edgeId) => void

  const W = 168, H = 44

  let view = { x: 0, y: 0, k: 1 }
  let drag = null                     // { kind: 'node'|'pan'|'link', ... }
  let local = {}                      // positions moved this visit
  let svg

  // Depth from a root, for a node the layout does not place.
  function depths() {
    const d = {}, ins = {}
    for (const n of nodes) ins[n.id] = 0
    for (const e of edges) if (e.to in ins) ins[e.to]++
    let frontier = nodes.filter(n => !ins[n.id]).map(n => n.id)
    let level = 0
    while (frontier.length && level < nodes.length) {
      const next = []
      for (const id of frontier) if (d[id] == null) {
        d[id] = level
        for (const e of edges) if (e.from === id) next.push(e.to)
      }
      frontier = next; level++
    }
    return d
  }

  $: placed = (() => {
    const d = depths(), rows = {}, out = {}
    for (const n of nodes) {
      const p = local[n.id] ?? positions?.[n.id]
      if (p && Number.isFinite(p.x) && Number.isFinite(p.y)) out[n.id] = p
    }
    // Below everything already placed, or a node added to a laid-out flow
    // lands on one the author put at the computed spot and hides it.
    const top = Math.max(40, ...Object.values(out).map(p => p.y + H + 40))
    for (const n of nodes) {
      if (out[n.id]) continue
      const col = d[n.id] ?? 0
      rows[col] = (rows[col] ?? 0) + 1
      out[n.id] = { x: 40 + col * (W + 72), y: top + (rows[col] - 1) * (H + 40) }
    }
    return out
  })()

  const labelOf = (n) => types?.find(t => t.type === n.type)?.label ?? n.type

  function edgePath(e) {
    const a = placed[e.from], b = placed[e.to]
    if (!a || !b) return ''
    const x1 = a.x + W, y1 = a.y + H / 2, x2 = b.x, y2 = b.y + H / 2
    const c = Math.max(40, Math.abs(x2 - x1) / 2)
    return `M${x1},${y1} C${x1 + c},${y1} ${x2 - c},${y2} ${x2},${y2}`
  }

  // Screen → graph coordinates, through the pan and zoom.
  function toGraph(ev) {
    const r = svg.getBoundingClientRect()
    return { x: (ev.clientX - r.left - view.x) / view.k, y: (ev.clientY - r.top - view.y) / view.k }
  }

  function begin(ev, kind, id) {
    ev.stopPropagation()
    // A pointer the browser no longer tracks refuses capture; the gesture still runs.
    try { svg.setPointerCapture(ev.pointerId) } catch {}
    const at = toGraph(ev)
    if (kind === 'node') {
      // The port sits inside the node, and a drag from it is a link, not a move.
      if (ev.target?.closest?.('[data-port]')) return
      select?.(id)
      if (disabled) return
      const p = placed[id]
      drag = { kind, id, dx: at.x - p.x, dy: at.y - p.y, moved: false }
    } else if (kind === 'link') {
      drag = { kind, from: id, x: at.x, y: at.y }
    } else {
      if (drag) return
      drag = { kind: 'pan', sx: ev.clientX - view.x, sy: ev.clientY - view.y }
    }
  }

  function track(ev) {
    if (!drag) return
    if (drag.kind === 'pan') { view = { ...view, x: ev.clientX - drag.sx, y: ev.clientY - drag.sy }; return }
    const at = toGraph(ev)
    if (drag.kind === 'node') {
      local = { ...local, [drag.id]: { x: Math.round(at.x - drag.dx), y: Math.round(at.y - drag.dy) } }
      drag = { ...drag, moved: true }
    } else drag = { ...drag, x: at.x, y: at.y }
  }

  function end(ev) {
    if (!drag) return
    const d = drag
    drag = null
    if (d.kind === 'node' && d.moved) move?.({ ...(positions ?? {}), ...placed })
    if (d.kind === 'link') {
      const at = toGraph(ev)
      const hit = nodes.find(n => { const p = placed[n.id]; return at.x >= p.x && at.x <= p.x + W && at.y >= p.y && at.y <= p.y + H })
      if (hit && hit.id !== d.from && !edges.some(e => e.from === d.from && e.to === hit.id)) connect?.(d.from, hit.id)
    }
  }

  function zoom(ev) {
    ev.preventDefault()
    const r = svg.getBoundingClientRect()
    const k = Math.min(2.5, Math.max(0.3, view.k * (ev.deltaY < 0 ? 1.1 : 1 / 1.1)))
    const mx = ev.clientX - r.left, my = ev.clientY - r.top
    view = { k, x: mx - (mx - view.x) * k / view.k, y: my - (my - view.y) * k / view.k }
  }

  $: linking = drag?.kind === 'link' ? drag : null
</script>

<div class="flow-canvas" id="flow-canvas">
  <svg
    bind:this={svg}
    role="application"
    aria-label="Flow graph"
    onpointerdown={(ev) => begin(ev, 'pan')}
    onpointermove={track}
    onpointerup={end}
    onpointercancel={end}
    onwheel={zoom}
  >
    <g transform={`translate(${view.x},${view.y}) scale(${view.k})`}>
      {#each edges as e (e.id)}
        <path
          class="flow-edge"
          d={edgePath(e)}
          data-edge={e.id}
          data-from={e.from}
          data-to={e.to}
          ondblclick={(ev) => { ev.stopPropagation(); if (!disabled) unlink?.(e.id) }}
        />
      {/each}
      {#if linking}
        <path class="flow-edge flow-edge-pending" d={`M${placed[linking.from].x + W},${placed[linking.from].y + H / 2} L${linking.x},${linking.y}`} />
      {/if}
      {#each nodes as n (n.id)}
        <g
          class="flow-node"
          data-canvas-node={n.id}
          data-selected={n.id === selected ? 'yes' : 'no'}
          data-x={placed[n.id]?.x}
          data-y={placed[n.id]?.y}
          transform={`translate(${placed[n.id]?.x ?? 0},${placed[n.id]?.y ?? 0})`}
          onpointerdown={(ev) => begin(ev, 'node', n.id)}
        >
          <rect width={W} height={H} rx="6" />
          <text x="10" y="18" class="flow-node-id">{n.id}</text>
          <text x="10" y="34" class="flow-node-type">{labelOf(n)}</text>
          {#if !disabled}
            <circle class="flow-port" data-port={n.id} cx={W} cy={H / 2} r="6" onpointerdown={(ev) => begin(ev, 'link', n.id)} />
          {/if}
        </g>
      {/each}
    </g>
  </svg>
</div>

<style>
  .flow-canvas { border: 1px solid currentColor; border-radius: 6px; overflow: hidden; opacity: 0.95 }
  svg { display: block; width: 100%; height: 22rem; touch-action: none; cursor: grab }
  .flow-edge { fill: none; stroke: currentColor; stroke-width: 1.5; opacity: 0.6 }
  .flow-edge-pending { stroke-dasharray: 4 4 }
  .flow-node { cursor: move }
  .flow-node rect { fill: Canvas; stroke: currentColor; stroke-width: 1 }
  .flow-node[data-selected='yes'] rect { stroke-width: 3 }
  .flow-node text { fill: currentColor; font-size: 12px; pointer-events: none }
  .flow-node-type { opacity: 0.7 }
  .flow-port { fill: currentColor; cursor: crosshair }
</style>
