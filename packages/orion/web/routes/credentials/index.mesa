---
title: Credentials
---
<script>
  // Everywhere this app's flows may call, and how each call signs itself.
  //
  // A flow's `http.request` names one of these rather than a URL (`FJS-D273`),
  // so this list is also the whole of what the flows can reach. The model is
  // ADMINISTRATOR(5) throughout, and the secret is written and never read back:
  // the form below takes one, and no screen can show it again.
  import FlowCredential, { flowCredentials } from '../../resources/FlowCredential.mesa'
  import { session, useStore } from '@frontierjs/sierra/junction'
  import { page } from '@frontierjs/sierra/router'

  import Alert         from '@frontierjs/ui/components/feedback/Alert.mesa'
  import Badge         from '@frontierjs/ui/components/display/Badge.mesa'
  import Button        from '@frontierjs/ui/components/forms/Button.mesa'
  import Drawer        from '@frontierjs/ui/components/overlay/Drawer.mesa'
  import Mono          from '@frontierjs/ui/components/display/Mono.mesa'
  import SectionHeader from '@frontierjs/ui/components/display/SectionHeader.mesa'
  import Table         from '@frontierjs/ui/components/display/Table.mesa'

  const columns = [
    { name: 'name',     label: 'Name' },
    { name: 'address',  label: 'Address' },
    { name: 'auth',     label: 'Signs with' },
    { name: 'actions',  label: '' },
  ]

  const { get: rows, unsubscribe } = useStore(flowCredentials.store)
  $.onDestroy(unsubscribe)
  $: (session.level)

  let error   = null
  let editing = null

  $: canRead  = flowCredentials.can('read', session.level)
  $: canWrite = flowCredentials.can('create', session.level)

  function load() {
    if (!canRead) return
    flowCredentials.load(page.query, { orderBy: 'name', ...page.directives }).catch(e => { error = e.message })
  }
  load()
  $: page.query, page.directives, session.level, () => load()

  function open()  { editing = flowCredentials.make(); error = null }
  function close() { editing = null }

  async function remove(c) {
    error = null
    try { await flowCredentials.service.remove(c.id) } catch (e) { error = e.message }
  }
</script>

<SectionHeader title="Credentials" level={1}>
  {#snippet action()}
    <Button id="cred-new" disabled={!canWrite} onclick={open}>New credential</Button>
  {/snippet}
</SectionHeader>

{#if error}<Alert tone="danger" id="cred-error">{error}</Alert>{/if}

{#if !canRead}
  <Alert tone="muted" id="cred-refused">Credentials are managed by an administrator.</Alert>
{:else}
  <Table {columns} rows={rows()} striped hover>
    {#snippet row(c)}
      <tr data-credential={c.name}>
        <td><Mono size="xs">{c.name}</Mono><div class="text-muted text-sm">{c.provider}</div></td>
        <td class="text-sm">{c.address}</td>
        <td><Badge tone="muted">{c.auth}</Badge></td>
        <td><Button variant="ghost" disabled={!canWrite} onclick={() => remove(c)}>Remove</Button></td>
      </tr>
    {/snippet}
  </Table>
{/if}

<Drawer open={editing !== null} title="New credential" side="right" onclose={close}>
  {#if editing}
    <FlowCredential
      bind:record={editing}
      method="create"
      submitId="cred-save"
      oncancel={close}
      ondone={() => close()}
    />
  {/if}
</Drawer>
