{
  "name": "@frontierjs/orion",
  "version": "0.0.2",
  "description": "Automations for a FrontierJS app — flows of triggers, conditions and actions, run by an engine installed into the app",
  "type": "module",
  "license": "MIT",
  "author": "FrontierJS",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/frontierJS/frontierjs.git",
    "directory": "packages/orion"
  },
  "exports": {
    ".": "./src/plugin.ts",
    "./routes": "./web/routes.js",
    "./orion.lite": "./db/orion.lite"
  },
  "files": [
    "src",
    "web",
    "db",
    "README.md"
  ],
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "test": "node ../../scripts/tmp-run.mjs 'bun test test'",
    "typecheck": "node ../../scripts/typecheck.mjs",
    "bench": "bun bench/checkpoint.ts"
  },
  "engines": {
    "bun": ">=1.4.0"
  },
  "devDependencies": {
    "bun-types": "^1.3.14",
    "@frontierjs/junction": "workspace:*",
    "@frontierjs/litestone": "workspace:*",
    "@frontierjs/conduit": "workspace:*",
    "@frontierjs/sierra": "workspace:*",
    "@frontierjs/ui": "workspace:*",
    "@frontierjs/mesa": "workspace:*"
  },
  "dependencies": {
    "@frontierjs/toolbelt": "workspace:*"
  },
  "peerDependencies": {
    "@frontierjs/junction": "workspace:^",
    "@frontierjs/litestone": "workspace:^",
    "@frontierjs/conduit": "workspace:^",
    "@frontierjs/sierra": "workspace:^",
    "@frontierjs/ui": "workspace:^"
  }
}
