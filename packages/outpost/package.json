{
  "name": "@frontierjs/outpost",
  "version": "0.1.17",
  "description": "The process a fleet server runs — Basecamp's hands on a machine",
  "type": "module",
  "bin": {
    "outpost": "./src/index.js"
  },
  "exports": {
    ".": {
      "types": "./src/index.d.ts",
      "default": "./src/index.js"
    },
    "./server": {
      "types": "./src/server.d.ts",
      "default": "./src/server.js"
    },
    "./docker": {
      "types": "./src/docker.d.ts",
      "default": "./src/docker.js"
    },
    "./swap": {
      "types": "./src/swap.d.ts",
      "default": "./src/swap.js"
    },
    "./dockerfile": {
      "types": "./src/dockerfile.d.ts",
      "default": "./src/dockerfile.js"
    },
    "./doors": {
      "types": "./src/doors.d.ts",
      "default": "./src/doors.js"
    },
    "./static": {
      "types": "./src/static.d.ts",
      "default": "./src/static.js"
    },
    "./serve": {
      "types": "./src/serve.d.ts",
      "default": "./src/serve.js"
    },
    "./vitals": {
      "types": "./src/vitals.d.ts",
      "default": "./src/vitals.js"
    },
    "./cert": {
      "types": "./src/cert.d.ts",
      "default": "./src/cert.js"
    },
    "./layout": {
      "types": "./src/layout.d.ts",
      "default": "./src/layout.js"
    },
    "./release-cache": {
      "types": "./src/release-cache.d.ts",
      "default": "./src/release-cache.js"
    },
    "./release": {
      "types": "./src/release.d.ts",
      "default": "./src/release.js"
    }
  },
  "scripts": {
    "start": "bun src/index.js",
    "test": "node ../../scripts/tmp-run.mjs 'node ../../scripts/emit-types.mjs --check && bun test'",
    "types": "node ../../scripts/emit-types.mjs",
    "verify:docker": "bun test/verify-docker.mjs",
    "typecheck": "node ../../scripts/typecheck.mjs"
  },
  "engines": {
    "bun": ">=1.4.0"
  },
  "dependencies": {
    "@frontierjs/litestone": "workspace:*",
    "@frontierjs/toolbelt": "workspace:*"
  },
  "files": [
    "src",
    "README.md",
    "LICENSE"
  ],
  "keywords": [
    "frontierjs",
    "outpost",
    "fleet",
    "docker"
  ],
  "license": "MIT",
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/frontierJS/frontierjs.git",
    "directory": "packages/outpost"
  }
}
