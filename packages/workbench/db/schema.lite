/// Workbench — Litestone schema
///
/// THE SEED. The developer's own machine: one person, one laptop, the Claude
/// Code history indexed from `~/.claude` and the changes Workbench made to it.
/// Nothing here is a fleet noun, and no model of Basecamp is read.
///
/// ACCESS — every model declares @@gate, read as R.C.U.D. There is no workspace
/// and no level ladder (`FJS-D1786`): a Member is somebody who signed in at the
/// door (`api/src/login.ts`), graded CREATOR(3) by the stock grader.
///
///   0 STRANGER   no principal: sees nothing
///   3 CREATOR    the signed-in Member
///   8 SYSTEM     asSystem(): the login, the session it mints, the indexer
///   9 LOCKED     nothing

import "@frontierjs/litestone/references/Grant.lite"

database main {
  path     env("DATABASE_URL", "./db/workbench.db")
  announce inProcess    // one API process on one laptop; the channels plugin warns on an unstated database
}

// The team chat's mirror, apart from workbench.db (`FJS-D2209`): rebuildable
// from the chat server, so a reset of one never takes the other.
database chat {
  path     env("CHAT_DATABASE_URL", "./db/chat.db")
  announce inProcess
}

/// Whoever signed in at the door. One row on a laptop; a table so the principal
/// is read the way every other app's is, and so a second person is a row.
model Member {
  id        Int       @id
  nick      String    @unique @trim @lower @length(2, 16) @regex("^[a-z0-9_-]+$", "letters, digits, - and _")
  createdAt DateTime  @default(now())

  // The member's link to the team's chat server (`IDEAS/workbench-messages.md`
  // Phase 1). A post is spent on its author's own token, so the token is
  // @secret: no read returns it, its owner's included. All three are the
  // system's to write -- `chat.connect` asks the server whose token it is
  // before keeping it, and a member who could write profileExternalId could
  // read every private channel of the profile named. A plain column and no
  // relation: Profile is in the chat database, and a relation cannot cross one.
  chatToken         String?   @secret
  profileExternalId String?   @unique @system
  // When this member's last complete backfill BEGAN; the next reads what
  // changed since, a minute early. Null reads the newest page of every channel.
  chatSyncedAt      DateTime? @system

  sessions       Session[]
  notifications  Notification[]

  @@auth

  /// Created by the login; a member reads their own row and edits nothing.
  @@gate(3.8.8.8)
  @@allow(read, id == auth().id)
}

/// What the login mints (`api/src/login.ts`), and what `verifySession` reads a
/// token back to. A Grant: the token leaves in the login's answer and only its
/// digest is stored. Nothing below the system reads or writes one.
model Session {
  id        Int      @id
  memberId  Int
  member    Member   @relation(fields: [memberId], references: [id])
  createdAt DateTime @default(now())

  @@trait(Grant)

  /// Required where the trait leaves it open: a session that never expires buys
  /// nothing and is a standing hole for a token that leaked.
  expiresAt DateTime @override

  @@gate(8)
  @@index([memberId])
}

// ── Claude Code's usage on THIS machine, indexed (`FJS-D1714`) ───────────────
//
// History, not state: `domain/claude/claude-index.ts` reads the transcripts under
// `<config dir>/projects/` and these two tables are what it learned. They are
// rebuildable from the files still on disk and are the ONLY record of those
// Claude Code has since deleted (`cleanupPeriodDays`), which is why a message row
// carries its own `sessionId` and `cwd` and names no transcript: a relation with
// a cascade would take the history with the file.
//
// @@gate(5.8): the Workbench's ADMINISTRATOR reads, and only the job writes
// (`asSystem()`). There is no tenancy block: the machine's `~/.claude` belongs
// to nobody but its owner. No @@trail(audit): one row per assistant message would bury the
// human trail, and the rows are derived.

// One row per transcript FILE — where the indexer stopped reading it. A
// subagent's transcript is its own file under a `subagents/` folder and carries
// its PARENT's `sessionId`, so a session's subagent count is a count here.
// `agent` is a subagent's type, from the `.meta.json` beside its file.
model ClaudeTranscript {
  id          String    @id @default(uuid())
  path        String    @unique
  sessionId   String
  cwd         String?
  isSubagent  Boolean   @default(false)
  agent       String?
  isHeadless  Boolean   @default(false)
  title       String?
  firstPrompt String?
  // Bytes read to, always at a newline. Equal to `size` → nothing to read;
  // larger `size` → read [offset, size); smaller → the file was rewritten, from 0.
  offset      Int       @default(0)
  // The skills loaded in the turn still open at `offset`, which the next read's
  // messages carry until a prompt closes it.
  turnSkills  String    @default("")
  size        Int       @default(0)
  startedAt   DateTime?
  lastAt      DateTime?
  // The file is no longer on disk; this row and its messages are the record.
  isGone      Boolean   @default(false)
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @default(now()) @updatedAt

  @@gate(5.8)
  @@index([sessionId])
  @@index([cwd])
}

// One row per assistant MESSAGE, unique on the id Claude Code writes — a streamed
// reply's several lines, a resumed session's repeats and a re-read file all
// collapse onto it. `cacheWrite` is the whole write and `cacheWrite1h` the part
// of it written to the one-hour cache, which is priced differently.
// `tools` is the sorted, comma-joined names of the tools the message called;
// `skills` the same of the skills loaded in its turn, and `agent` its subagent's
// type, copied from the transcript row so a spend read groups on it.
model ClaudeMessage {
  id           String   @id @default(uuid())
  messageId    String   @unique
  sessionId    String
  cwd          String?
  model        String
  at           DateTime
  input        Int
  cacheWrite   Int
  cacheWrite1h Int      @default(0)
  cacheRead    Int
  output       Int
  tools        String   @default("")
  skills       String   @default("")
  isSubagent   Boolean  @default(false)
  agent        String?

  @@gate(5.8)
  @@index([at])
  @@index([cwd])
  @@index([sessionId])
}

// One change Basecamp made to Claude Code's configuration, and what taking it
// back needs (`domain/claude/claude-write.ts`, the one writer). The call trail
// records `claude.<method>` naming this row; this row names the file and the
// top-level keys changed, never a value (Invariant 7).
//
// `before` is a file's whole text before the write, or a removed MCP server's
// config — `settings.json` `env` and an MCP server's env and headers carry
// tokens, so it is `@encrypted`. `digest` is the sha256 of the file as written:
// a running `claude` edits these files too, and an undo that replayed `before`
// over its edit would lose it, so undo is refused once the file has moved.
//
// @@gate(5.8): the Workbench's ADMINISTRATOR reads; the claude service writes
// through `asSystem()`. No tenancy, as the usage index.
model ClaudeWrite {
  id        String    @id @default(uuid())
  // `file.save`, `file.trash`, `settings`, `permissions`, `plugin.enable`, `mcp.disable`...
  action    String
  // A file path, `name@marketplace`, a marketplace name or an MCP server name.
  target    String
  // The project a project- or local-scope change belongs to.
  project   String?
  scope     String?
  keys      String    @default("")
  before    String?   @encrypted
  digest    String?
  undoneAt  DateTime?
  createdAt DateTime  @default(now())

  @@gate(5.8)
  @@index([createdAt])
}

// ── Notification — the in-app half of `@frontierjs/notifications` ───────────
//
// Copied from the package's db/notification.lite (`fli check`'s
// `package-model-drift` grades it), with `userId` an Int and a relation to
// Member: the fragment's String is for auth's uuid ids, and the package
// writes whatever `recipient.id` is, so a Member's Int goes in as it is.
// PushSubscription is NOT copied: the push transport is ntfy, which has no
// device rows (`api/src/push.ts`), and the plugin registers its subscribe
// door only where that model exists. NotificationPreference is not copied
// either -- one member, no screen, and `AutopilotReport.via` is the whole
// choice.
//
// `subjectType` is unconstrained: the one notification has no subject, so
// there is no set of models to name.
model Notification {
  id          Int       @id
  userId      Int
  member      Member    @relation(fields: [userId], references: [id], onDelete: Cascade)
  type        String
  data        Json
  subjectType String?
  subjectId   String?
  deliveryKey String?
  readAt      DateTime?
  createdAt   DateTime  @default(now())

  @@db(main)
  @@gate(0.8.4.8)
  @@unique([userId, type, deliveryKey], nullsDistinct: true)
  @@allow(read,   userId == auth().id)
  @@allow(update, userId == auth().id)
}

// ── ProviderAccount — a cloud token the Servers screen lists through ─────────
//
// The ONLY thing the Servers screen stores (`FJS-D2006`, `FJS-D2008`): the
// machines are fetched live from the provider through its conduit on each
// visit, so there is no machine table to disagree with the account it came
// from. Workbench keeps its own tokens because it runs before any Basecamp
// exists; it never reads Basecamp's.
//
// `token` is `@encrypted @guarded`: sealed at rest, and redacted for every
// reader but `asSystem()`, which `domain/servers/servers.ts` uses to bind the
// conduit target. A member's read of the row never carries it. Not `@secret`:
// that adds `@trail`, and Workbench declares no trail database.
//
// @@gate(5.8): the Workbench's ADMINISTRATOR reads; the servers service writes
// through `asSystem()` after the token's `verify` answered, as ClaudeWrite does.
model ProviderAccount {
  id        Int             @id
  label     String          @trim @length(1, 60)
  provider  ComputeProvider
  token     String          @encrypted @guarded
  createdAt DateTime        @default(now())

  @@gate(5.8)
}

// The vendors that sell machines — Basecamp's name for the same set
// (`FJS-D1607`), without its `custom`: a custom machine has no list endpoint,
// and an ssh host is how the screen shows one.
enum ComputeProvider { hetzner digitalocean }

// ── The team chat, mirrored (`IDEAS/workbench-messages.md` Phase 1) ──────────
//
// The chat server holds the truth and these rows are this laptop's copy,
// moved from the chat prototype. @@mirror(key: externalId) makes every column
// @system, so a member's write to the server's data is refused by name rather
// than overwritten by the next sync (`FJS-D843`); the writes a member may make
// reach the server through the connector's claim (`api/src/providers/chat/`)
// and land back as the system (`FJS-D1125`).
//
// Graded at the door's member, not the prototype's USER: the door grades every
// member ADMINISTRATOR (`api/src/auth.ts`), so the prototype's
// `|| auth().isAdmin` escapes are gone -- here they would hand every member
// every other member's private channels. Privacy is the policies alone: a
// member reads a non-open channel only when their `profileExternalId` is in it.
//
// A relation column holds the server's id under <relation>ExternalId and
// references the other model's externalId, so a row lands without waiting
// for a local id.

enum TeamType    { open invite }
enum ChannelType { open private direct group }

model Team {
  id              Int       @id
  externalId      String
  name            String
  displayName     String
  description     String
  type            TeamType
  allowOpenInvite Boolean
  createdAt       DateTime?
  updatedAt       DateTime?
  deletedAt       DateTime?
  channels        Channel[]

  @@db(chat)
  @@mirror(key: externalId)
  @@gate(3.8.8.8)
  @@allow(read, true)
}

// The chat server's person. Not `Member`: that is who signed in at the door,
// and a member links to at most one Profile through Member.profileExternalId.
model Profile {
  id         Int       @id
  externalId String
  username   String
  firstName  String    @personal(contact)
  lastName   String    @personal(contact)
  nickname   String
  // The server shows an address to its owner, so this copy does.
  email      String?   @personal(contact) @allow(read, externalId == auth().profileExternalId)
  roles      String
  locale     String?
  isBot      Boolean
  createdAt  DateTime?
  updatedAt  DateTime?
  deletedAt  DateTime?
  memberships ChannelMember[]
  posts      Post[]
  threads    Thread[]
  reactions  Reaction[]
  files      FileInfo[]

  @@db(chat)
  @@mirror(key: externalId)
  @@gate(3.8.8.8)
  @@allow(read, true)
}

// A direct or group channel belongs to no team, so teamExternalId is null
// there. Read: an open channel by any member, any other by its own members.
model Channel {
  id                Int         @id
  externalId        String
  teamExternalId    String?
  team              Team?       @relation(fields: [teamExternalId], references: [externalId])
  creatorExternalId String?
  type              ChannelType
  name              String
  displayName       String
  header            String
  purpose           String
  lastPostAt        DateTime?
  totalMessageCount Int
  // Root posts only: a room's unread badge counts these, so a reply counts
  // once, in Threads. A server without them answers 0 while the room has posts.
  totalMessageCountRoot Int       @default(0)
  lastRootPostAt        DateTime?
  createdAt         DateTime?
  updatedAt         DateTime?
  deletedAt         DateTime?
  members           ChannelMember[]
  posts             Post[]

  @@db(chat)
  @@mirror(key: externalId)
  @@gate(3.3.3.3)
  @@index([teamExternalId])
  @@allow(read, type == 'open' || members.some(profileExternalId == auth().profileExternalId))
  @@allow(create, true)
  @@allow(update, members.some(profileExternalId == auth().profileExternalId && isAdmin))
  @@allow(delete, members.some(profileExternalId == auth().profileExternalId && isAdmin))
}

// The key is channel:profile, composed by the connector. Adding someone else
// is an invitation and needs only that the inviter may read the channel;
// leaving is the member's own.
model ChannelMember {
  id                Int       @id
  externalId        String
  channelExternalId String
  channel           Channel   @relation(fields: [channelExternalId], references: [externalId])
  profileExternalId String
  profile           Profile   @relation(fields: [profileExternalId], references: [externalId])
  roles             String
  isAdmin           Boolean
  lastViewedAt      DateTime?
  messageCount      Int
  mentionCount      Int
  messageCountRoot  Int       @default(0)
  mentionCountRoot  Int       @default(0)
  // Muted where the server is: the room is unread only when it mentions them.
  muted             Boolean   @default(false)
  updatedAt         DateTime?

  @@db(chat)
  @@mirror(key: externalId)
  @@gate(3.3.8.3)
  @@index([channelExternalId, profileExternalId])
  @@index([profileExternalId])
  @@allow(read, check(channel))
  @@allow(create, check(channel, 'read'))
  @@allow(delete, profileExternalId == auth().profileExternalId)
}

// A reply names its root; a root names none. The author is never in what the
// caller sends -- the server takes it from the token the post spent -- so a
// create cannot claim another author, and an edit is the author's own.
model Post {
  id                Int       @id
  externalId        String
  channelExternalId String
  channel           Channel   @relation(fields: [channelExternalId], references: [externalId])
  profileExternalId String
  author            Profile   @relation(fields: [profileExternalId], references: [externalId])
  rootExternalId    String?
  root              Post?     @relation("replies", fields: [rootExternalId], references: [externalId])
  replies           Post[]    @relation("replies")
  message           String
  type              String
  isPinned          Boolean
  props             Json
  hashtags          String
  replyCount        Int
  lastReplyAt       DateTime?
  createdAt         DateTime?
  updatedAt         DateTime?
  editedAt          DateTime?
  deletedAt         DateTime?
  threads           Thread[]
  reactions         Reaction[]
  files             FileInfo[]

  @@db(chat)
  @@mirror(key: externalId)
  @@index([channelExternalId, createdAt])
  @@index([rootExternalId, createdAt])
  @@index([profileExternalId])
  @@gate(3.3.3.3)
  @@allow(read, check(channel))
  @@allow(create, check(channel, 'read'))
  @@allow(update, profileExternalId == auth().profileExternalId)
  @@allow(delete, profileExternalId == auth().profileExternalId)
}

// One profile's view of a root post -- its unread counts are that person's --
// so the key is profile:root and nobody else reads it.
model Thread {
  id                Int       @id
  externalId        String
  rootExternalId    String
  root              Post      @relation(fields: [rootExternalId], references: [externalId])
  profileExternalId String
  profile           Profile   @relation(fields: [profileExternalId], references: [externalId])
  replyCount        Int
  lastReplyAt       DateTime?
  lastViewedAt      DateTime?
  unreadReplies     Int
  unreadMentions    Int
  // An unfollowed thread stays a row, with its counts, and leaves Threads.
  isFollowing       Boolean   @default(true)

  @@db(chat)
  @@mirror(key: externalId)
  @@index([profileExternalId, lastReplyAt])
  @@index([rootExternalId])
  @@gate(3.8.8.8)
  @@allow(read, profileExternalId == auth().profileExternalId)
}

// The key is post:profile:emoji. A reaction names its profile, so a create
// naming someone else's is refused here before the server is asked.
model Reaction {
  id                Int       @id
  externalId        String
  postExternalId    String
  post              Post      @relation(fields: [postExternalId], references: [externalId])
  profileExternalId String
  profile           Profile   @relation(fields: [profileExternalId], references: [externalId])
  emojiName         String
  createdAt         DateTime?

  @@db(chat)
  @@mirror(key: externalId)
  @@index([postExternalId])
  @@index([profileExternalId])
  @@gate(3.3.8.3)
  @@allow(read, check(post))
  @@allow(create, profileExternalId == auth().profileExternalId && check(post, 'read'))
  @@allow(delete, profileExternalId == auth().profileExternalId)
}

// A file is uploaded before the post that carries it, so postExternalId is
// null until then -- and check(post) admits a missing post, which would show
// an unsent file to everyone (`FJS-3130`). Until it is posted it is its uploader's.
model FileInfo {
  id                Int       @id
  externalId        String
  postExternalId    String?
  post              Post?     @relation(fields: [postExternalId], references: [externalId])
  profileExternalId String
  profile           Profile   @relation(fields: [profileExternalId], references: [externalId])
  name              String
  extension         String
  size              Int
  mimeType          String
  width             Int?
  height            Int?
  hasPreviewImage   Boolean
  createdAt         DateTime?
  updatedAt         DateTime?
  deletedAt         DateTime?

  @@db(chat)
  @@mirror(key: externalId)
  @@index([postExternalId])
  @@index([profileExternalId])
  @@gate(3.8.8.8)
  @@allow(read, profileExternalId == auth().profileExternalId || (postExternalId != null && check(post)))
}
