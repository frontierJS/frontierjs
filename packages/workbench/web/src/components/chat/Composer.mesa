<script>
  // components/chat/Composer.mesa -- the box a post is typed into. Enter sends,
  // Shift+Enter breaks a line; with a `rootExternalId` it replies in that thread.
  //
  // A file (the button, a paste, a drop) is uploaded as it is attached, as the reader, and
  // answers its id; the post then names the ids in `fileExternalIds` and claims them. A
  // send waits for every upload. `@` opens the picker over the channel's people, then
  // everyone (lib/chat.js). A create is forwarded to the server as the reader and lands
  // back by its key, and the post list draws it from that push, so a send clears the box
  // and draws nothing itself. A clock beside Send writes the box as a scheduled post instead
  // (local to this laptop, sent by the API's job), and clears the box the same way.
  //
  // `@` also offers the groups (`@handle`); a send writes each one out as its people's
  // usernames. `/` as the box's first character offers the slash commands
  // (lib/chat-commands.js): a known one runs instead of posting, anything else posts.
  //
  // The box is a draft that follows the person (`drafts`, `chat.saveDraft`): restored when
  // it opens, saved 800 ms after the last key, deleted when it is sent or emptied. `synced`
  // is the text the server is known to hold; a draft pushed from another client replaces the
  // box only while the box still equals it, so a box being typed in is never overwritten, and
  // a push that arrives while a save is pending or in flight is the echo of an older one.
  import Icon from '../Icon.mesa'
  import MentionList from './MentionList.mesa'
  import CommandList from './CommandList.mesa'
  import WhenDialog from './WhenDialog.mesa'
  import DropdownMenu from '@frontierjs/ui/components/overlay/DropdownMenu.mesa'
  import DropdownItem from '@frontierjs/ui/components/overlay/DropdownItem.mesa'
  import { posts } from '../../resources/Post.mesa'
  import { applyMention, deleteDraft, draftFor, expandGroups, getLists, laterChoices, mentionAt, pickerKey, saveDraft, scheduleSend, watchMembers } from '../../lib/chat.js'
  import { commandAt, runCommand } from '../../lib/chat-commands.js'
  import { MAX_FILE_BYTES, MAX_FILES, fileSize, filesOf, uploadFile } from '../../lib/files.js'

  export let channelId = null
  export let rootExternalId = null   // a reply: the thread's root
  export let placeholder = 'Message'
  export let onsent = undefined      // () => void

  const lists = getLists()
  $: people = lists.people.rows

  const DRAFT_MS = 800
  let text = draftFor(lists.drafts.rows, channelId, rootExternalId)?.message ?? ''
  let synced = text
  let bound = { channelExternalId: channelId, rootExternalId }
  let flying = false
  let sending = false
  let error = null
  let box = null
  let picker = null     // { at, prefix, items, index } while an @ is being typed
  let files = []        // { key, name, size, id?, failed? }: attached, uploading until it has an id
  let dragging = false
  let fileInput = null
  let commands = null   // { prefix, items, index } while a /name is being typed
  let answer = null     // { text, tone }: what the last command said, for the sender only
  let whenOpen = false
  const TONES = { danger: 'danger', warning: 'warning', success: 'success' }

  let members = null
  function watch(id) { members?.destroy(); members = watchMembers(id) }
  watch(channelId)
  $: channelId, () => watch(channelId)
  $.onDestroy(() => members?.destroy())
  $: memberIds = members.rows.map(m => m.profileExternalId)
  $: inChannel = (lists.channels.rows.find(c => c.externalId === channelId)?.type ?? 'open') !== 'direct'

  $: uploading = files.some(f => !f.id && !f.failed)
  $: ready = files.filter(f => f.id)

  // ── The draft ──
  $: row = draftFor(lists.drafts.rows, channelId, rootExternalId)
  $: draftMessage = row?.message ?? ''
  $: draftMessage, () => {
    if (flying || text !== synced || draftMessage === text) return
    text = draftMessage
    synced = draftMessage
  }

  // Saved DRAFT_MS after the last keystroke; a box that matches the saved draft has nothing pending.
  $.after(DRAFT_MS, () => flush(), { key: text, when: text !== synced })

  async function flush(at = bound, message = text) {
    if (message === synced && at === bound) return
    const empty = !message.trim()
    if (at === bound) { synced = message; flying = true }
    try {
      if (empty) await deleteDraft(at)
      else await saveDraft({ ...at, message })
    } catch (e) { if (at === bound) error = e.message } finally { if (at === bound) flying = false }
  }

  // The same component serving another room: what was typed here is kept for the room it was typed in.
  $: channelId, rootExternalId, () => {
    if (channelId === bound.channelExternalId && rootExternalId === bound.rootExternalId) return
    if (text !== synced) flush(bound, text)
    bound = { channelExternalId: channelId, rootExternalId }
    files = []
    text = draftFor(lists.drafts.rows, channelId, rootExternalId)?.message ?? ''
    synced = text
  }
  $.onDestroy(() => { if (text !== synced) flush(bound, text) })

  // ── @ ──
  function watchMention() {
    picker = mentionAt(text, box?.selectionStart ?? text.length, people, memberIds, inChannel, lists.groups.rows)
    commands = rootExternalId ? null : commandAt(text)
    answer = null
  }
  function pick(item) {
    if (!picker) return
    const put = applyMention(text, picker, item)
    text = put.text
    picker = null
    box?.focus()
    requestAnimationFrame(() => box?.setSelectionRange(put.caret, put.caret))
  }

  // ── Files ──
  let keys = 0
  async function take(list) {
    error = null
    const incoming = [...(list ?? [])]
    if (!incoming.length || !channelId) return
    if (files.length + incoming.length > MAX_FILES) { error = `A post carries at most ${MAX_FILES} files.`; return }
    const big = incoming.find(f => f.size > MAX_FILE_BYTES)
    if (big) { error = `${big.name || 'That file'} is ${fileSize(big.size)}; the limit is ${MAX_FILE_BYTES / 1_048_576} MB per file.`; return }
    const added = incoming.map(f => ({ key: ++keys, name: f.name || 'file', size: f.size }))
    files = [...files, ...added]
    box?.focus()
    await Promise.all(incoming.map(async (f, i) => {
      const key = added[i].key
      try {
        const up = await uploadFile(channelId, f)
        files = files.map(x => x.key === key ? { ...x, id: up.id, name: up.name } : x)
      } catch (e) {
        error = e.message
        files = files.filter(x => x.key !== key)
      }
    }))
  }
  function onPaste(e) {
    const got = filesOf(e.clipboardData)
    if (got.length) { e.preventDefault(); take(got) }
  }
  function onDrop(e) { e.preventDefault(); dragging = false; take(filesOf(e.dataTransfer)) }
  const dropFile = (key) => { files = files.filter(f => f.key !== key) }

  // The box after a send, a schedule or a command: empty, its draft dropped at once.
  function clearBox() {
    text = ''
    files = []
    picker = null
    commands = null
    // The sent text is no draft: dropped at once, whatever the save in flight did.
    synced = ''
    deleteDraft(bound).catch(() => {})
  }

  const ctxOf = () => ({
    channelId, channel: lists.channels.rows.find(c => c.externalId === channelId) ?? null,
    memberships: lists.mine.rows, membership: lists.mine.rows.find(m => m.channelExternalId === channelId) ?? null,
  })

  async function send() {
    let message = text.trim()
    if ((!message && !ready.length) || !channelId || sending || uploading) return
    const typed = text
    sending = true
    error = null
    answer = null
    try {
      if (!rootExternalId && !ready.length) {
        const ran = await runCommand(message, ctxOf())
        if (ran?.answer !== undefined) {
          answer = ran.answer
          if (!ran.answer?.keep) clearBox()
          return
        }
        if (ran?.literal != null) message = ran.literal
      }
      // pendingPostId lets the server collapse a retried send into one post, should the first answer be lost.
      await posts.service.create({
        channelExternalId: channelId, ...(rootExternalId ? { rootExternalId } : {}), message: expandGroups(message, lists.groups.rows, people), pendingPostId: crypto.randomUUID(),
        ...(ready.length ? { fileExternalIds: ready.map(f => f.id) } : {}),
      })
      // Words typed while the post was on its way are the next message, not this one.
      const since = text === typed ? '' : text.startsWith(typed) ? text.slice(typed.length).trimStart() : text
      clearBox()
      text = since
      onsent?.()
    } catch (e) {
      error = e.message
    } finally {
      sending = false
      box?.focus()
    }
  }

  // The box becomes a scheduled post at `at`; the API refuses a past time and an empty box.
  async function later(at) {
    const message = text.trim()
    if ((!message && !ready.length) || !channelId || sending || uploading) throw new Error('Write something first.')
    error = null
    await scheduleSend({ channelExternalId: channelId, rootExternalId, message: expandGroups(message, lists.groups.rows, people), fileExternalIds: ready.map(f => f.id), at })
    clearBox()
    answer = { tone: 'success', text: `Scheduled for ${at.toLocaleString([], { dateStyle: 'medium', timeStyle: 'short' })}. It is under Scheduled in the sidebar.` }
  }
  const laterIn = (c) => later(c.at).catch((e) => { error = e.message })
  // A /command picked from the list is put in the box with a space, for its words.
  function pickCommand(c) {
    text = `/${c.name} `
    commands = null
    box?.focus()
  }

  function onKey(e) {
    if (picker) {
      // Esc here is the picker's, not the thread pane's.
      const next = pickerKey(picker, e)
      if (next !== undefined) { e.preventDefault(); e.stopPropagation(); if (next === 'pick') pick(picker.items[picker.index]); else picker = next; return }
    }
    if (commands) {
      const next = pickerKey(commands, e)
      // Enter on a command typed out in full runs it; Tab or Enter on a part of one completes it.
      const whole = e.key === 'Enter' && commands.items[commands.index].name === commands.prefix
      if (next !== undefined && !whole) { e.preventDefault(); e.stopPropagation(); if (next === 'pick') pickCommand(commands.items[commands.index]); else commands = next; return }
    }
    if (e.key === 'ArrowUp' && !text && !files.length && !e.shiftKey && !e.altKey && !e.ctrlKey && !e.metaKey && !e.isComposing) editLast(e)
    if (e.key === 'Enter' && !e.shiftKey && !e.isComposing) { e.preventDefault(); send() }
  }
  // Up on an empty box edits the reader's newest post beside it, as Mattermost does: the thread's
  // in a reply box, the room's list otherwise (the thread pane open beside it is not the room's).
  function editLast(e) {
    const own = rootExternalId
      ? box?.closest('[data-thread-pane]')?.querySelectorAll('[data-post-mine]')
      : box?.closest('[data-channel-page]')?.querySelectorAll('[data-post-list] [data-post-mine]')
    const last = own?.[own.length - 1]
    if (!last) return
    e.preventDefault()
    last.dispatchEvent(new CustomEvent('editpost', { detail: { back: box } }))
  }
</script>

<div class="composer" class:dragging data-composer={rootExternalId ? 'reply' : 'post'} ondragover|preventDefault={() => dragging = true} ondragleave={() => dragging = false} ondrop={onDrop}>
  {#if error}<p class="text-sm text-danger composer-error" role="alert" data-composer-error>{error}</p>{/if}
  {#if answer}<p class={`text-sm composer-error text-${TONES[answer.tone] ?? 'muted'}`} role="status" data-composer-answer>{answer.text}</p>{/if}
  {#if files.length}
    <ul class="cluster gap-xs composer-files" aria-label="Attached files" data-composer-files>
      {#each files as f (f.key)}
        <li class="pill removable" data-composer-file={f.name}>
          <Icon name="attach" /> {f.name} <span class="text-muted">{f.id ? fileSize(f.size) : 'uploading…'}</span>
          <button type="button" class="pill-close" aria-label={`Remove ${f.name}`} onclick={() => dropFile(f.key)}>×</button>
        </li>
      {/each}
    </ul>
  {/if}
  <div class="composer-box">
    <MentionList {picker} onpick={pick} />
    <CommandList picker={commands} onpick={pickCommand} />
    <textarea class="field composer-text" bind:this={box} bind:value={text} rows="1" {placeholder}
              aria-label={placeholder} oninput={watchMention} onkeydown={onKey} onpaste={onPaste} onclick={watchMention}></textarea>
    <div class="composer-actions">
      <input type="file" multiple bind:this={fileInput} class="visually-hidden" tabindex="-1" aria-hidden="true" data-composer-input onchange={(e) => { take(e.target.files); e.target.value = '' }} />
      <button type="button" class="btn ghost square" aria-label="Attach a file" title="Attach a file" onclick={() => fileInput?.click()}><Icon name="attach" /></button>
      <DropdownMenu placement="top-end">
        {#snippet trigger()}<button type="button" class="btn ghost square" aria-label="Send later" title="Send later" disabled={sending || uploading || (!text.trim() && !ready.length)} data-later><Icon name="clock" /></button>{/snippet}
        {#each laterChoices(new Date()) as c (c.key)}
          <DropdownItem onclick={() => laterIn(c)}><span data-later-choice={c.key}>{c.label}</span></DropdownItem>
        {/each}
        <DropdownItem onclick={() => whenOpen = true}><span data-later-choice="custom">Pick a time…</span></DropdownItem>
      </DropdownMenu>
      <button type="button" class="btn primary square composer-send" aria-label="Send" title="Send (Enter)" disabled={sending || uploading || (!text.trim() && !ready.length)} onclick={send}><Icon name="send" /></button>
    </div>
  </div>
  <p class="text-xs text-muted composer-hint">Enter sends · Shift+Enter for a new line · @ names someone{#if !rootExternalId} · / for commands{/if}</p>
</div>
<WhenDialog bind:open={whenOpen} title="Send later" action="Schedule" onpick={later} />

<style>
  .composer { padding-inline: var(--chat-gutter, var(--space-md)); padding-block: 0 var(--space-md); }
  /* One rounded field with its buttons inside it, ringed while it has focus. */
  .composer-box { position: relative; display: flex; align-items: flex-end; gap: var(--space-xs); padding: var(--space-2xs) var(--space-2xs) var(--space-2xs) var(--space-sm); border: var(--border-width) solid var(--rule); border-radius: var(--radius-lg, var(--space-sm)); background: var(--surface); }
  .composer-box:focus-within { border-color: var(--rule-strong); box-shadow: var(--shadow-sm); }
  .composer.dragging .composer-box { border-style: dashed; border-color: var(--color-primary); }
  .composer-text { flex: 1; resize: none; min-block-size: 0; max-block-size: 40vh; field-sizing: content; border: 0; background: none; box-shadow: none; padding-inline: 0; }
  .composer-text:focus, .composer-text:focus-visible { outline: none; box-shadow: none; }
  .composer-actions { display: flex; align-items: center; gap: var(--space-3xs); }
  .composer-actions :global(.btn) { border-radius: var(--pill-radius); }
  .composer-send:disabled { opacity: 0.35; }
  .composer-files { list-style: none; margin: 0 0 var(--space-xs); padding: 0; }
  .composer-hint, .composer-error { margin: var(--space-2xs) 0 0; }
</style>
