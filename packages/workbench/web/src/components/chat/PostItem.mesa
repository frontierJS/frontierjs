<script>
  // components/chat/PostItem.mesa -- one post. Avatar, name and time on a first
  // post; a post within five minutes of the same author's last is a continuation
  // line. The body is Markdown with headings one size down and single newlines
  // kept, a known @username drawn bold and a known :name: as its emoji. A root's
  // replies show as a link that opens its thread beside the room; in the pane
  // itself (`inThread`) there is no count and no Reply.
  //
  // The hover bar is react, reply and More. More holds what the server decides:
  // Edit and Delete (the author's; a refusal comes back as its own words, never
  // a time window decided here), Pin, Mark unread (also Alt-click) and Follow.
  import Avatar from '@frontierjs/ui/components/display/Avatar.mesa'
  import Markdown from '@frontierjs/ui/components/display/Markdown.mesa'
  import DropdownMenu from '@frontierjs/ui/components/overlay/DropdownMenu.mesa'
  import DropdownItem from '@frontierjs/ui/components/overlay/DropdownItem.mesa'
  import DropdownSeparator from '@frontierjs/ui/components/overlay/DropdownSeparator.mesa'
  import DropdownSubmenu from '@frontierjs/ui/components/overlay/DropdownSubmenu.mesa'
  import Icon from '../Icon.mesa'
  import { emojify } from '../../lib/emoji.js'
  import { goto } from '@frontierjs/sierra/router'
  import { posts } from '../../resources/Post.mesa'
  import { ago } from '../../lib/datetime.js'
  import { getLists, linkMentions, markUnread, me, mentionsMe, personName, nudgeIfNoReply, remindAt, REMINDERS, todosConfigured, rootOf, setFollowing, setPinned, setSaved, statusOf, threadHref } from '../../lib/chat.js'
  import PostEditor from './PostEditor.mesa'
  import Presence from './Presence.mesa'
  import Reactions from './Reactions.mesa'
  import PostFiles from './PostFiles.mesa'
  import PostLinks from './PostLinks.mesa'
  import EditedMark from './EditedMark.mesa'
  import ReactionPicker from './ReactionPicker.mesa'
  import WhenDialog from './WhenDialog.mesa'
  import TodoDialog from './TodoDialog.mesa'

  export let post = null
  export let people = []
  export let continuation = false
  export let inThread = false      // drawn in the thread pane: no count, no Reply
  export let selected = false      // its thread is the one open beside the room
  export let marked = false        // the post a pin or a link jumped to
  export let reactionRows = undefined   // its room's Reaction rows for it; a list across rooms passes none
  export let fileRows = undefined       // and its FileInfo rows
  export let onnudge = undefined   // () => void, after a reminder is set, for a screen that lists them

  const lists = getLists()
  $: author = personName(post.profileExternalId, people)
  $: body   = emojify(linkMentions(post.message, people))
  $: time   = post.createdAt ? new Date(post.createdAt).toLocaleTimeString([], { hour: '2-digit', minute: '2-digit' }) : ''
  $: named  = mentionsMe(post, people)
  $: mine   = !!me() && post.profileExternalId === me()
  // A membership is what lets the server mark a channel unread or pin in it.
  $: inRoom = lists.mine.rows.some(m => m.channelExternalId === post.channelExternalId)
  $: isRoot = !post.rootExternalId
  $: saved  = lists.saved.rows.some(r => r.postExternalId === post.externalId)
  // A person whose presence was never asked for has none to draw: null is not offline.
  $: presence = people.find(p => p.externalId === post.profileExternalId)?.status ? statusOf(people.find(p => p.externalId === post.profileExternalId)) : null
  $: following = !!lists.threads.rows.find(t => t.rootExternalId === rootOf(post))?.isFollowing

  let editing = false
  // The composer's Up on an empty box sends `editpost` to the reader's newest post; the focus goes back to that box after.
  let back = null
  const upToEdit = (node) => {
    const open = (e) => { if (!mine) return; editing = true; back = e.detail?.back ?? null }
    node.addEventListener('editpost', open)
    return () => node.removeEventListener('editpost', open)
  }
  function doneEditing() { editing = false; back?.focus(); back = null }
  let error = null
  let reactions = null
  async function act(fn) { error = null; try { await fn() } catch (e) { error = e.message } }

  // The server rings the reminder; this line only says it was taken, and goes after a few seconds.
  let reminded = null
  $.after(8000, () => reminded = null, { key: reminded, when: reminded != null })
  const remind = (r) => act(async () => {
    const at = r.when()
    await remindAt(post, at)
    reminded = `Reminder set for ${at.toLocaleString([], { weekday: 'short', hour: 'numeric', minute: '2-digit' })}.`
  })

  // Mounted only while open: a post is drawn many times and the dialog is one per screen's worth of use.
  let nudging = false
  const nudge = async (at) => {
    await nudgeIfNoReply(post, at)
    reminded = `You will be reminded ${at.toLocaleString([], { weekday: 'short', hour: 'numeric', minute: '2-digit' })} if nobody replies.`
    onnudge?.()
  }

  // The entry is offered only where Basecamp is configured; the dialog is mounted only while open.
  let todoOn = false
  let todoing = false
  todosConfigured().then(v => todoOn = v)

  const pin    = () => act(() => setPinned(post, !post.isPinned))
  const unread = () => act(() => markUnread(post))
  const save   = () => act(() => setSaved(post, !saved))
  const follow = () => act(() => setFollowing(rootOf(post), !following))
  const drop   = () => act(() => posts.service.remove(post.id))
  // Alt-click marks unread, as Slack does; a click on a link or a button inside stays theirs.
  function onClick(e) {
    if (!e.altKey || !inRoom || editing || e.target.closest?.('a, button, input, textarea')) return
    e.preventDefault()
    unread()
  }
</script>

<article class="post" class:continuation class:selected class:marked class:pinned={post.isPinned} class:named data-post-named={named ? 'true' : null} id={`post-${post.externalId}`} data-post={post.externalId} data-post-mine={mine ? 'true' : null} onclick={onClick} {@attach upToEdit}>
  {#if post.isPinned}
    <p class="post-flag text-xs cluster gap-2xs" data-post-pinned><Icon name="pushpin" /> Pinned</p>
  {/if}
  {#if saved}
    <p class="post-flag text-xs cluster gap-2xs" data-post-saved><Icon name="bookmark" /> Saved</p>
  {/if}
  <div class="post-lead">
    {#if continuation}
      <time class="post-time text-muted" datetime={post.createdAt}>{time}</time>
    {:else}
      <span class="post-avatar"><Avatar name={author} size="sm" />{#if presence}<Presence status={presence} badge />{/if}</span>
    {/if}
  </div>
  <div class="post-body stack gap-xs">
    {#if !continuation}
      <div class="cluster gap-xs post-head">
        <strong data-post-author>{author}</strong>
        <time class="text-muted text-sm" datetime={post.createdAt} title={post.createdAt ? new Date(post.createdAt).toLocaleString() : ''}>{time}</time>
        {#if post.editedAt}<EditedMark {post} {mine} />{/if}
      </div>
    {/if}
    {#if editing}
      <PostEditor {post} ondone={doneEditing} />
    {:else if body}
      <div class="post-text" data-post-text><Markdown text={body} headingBase={4} breaks />{#if continuation && post.editedAt} <EditedMark {post} {mine} />{/if}</div>
    {/if}
    {#if error}<p class="text-sm text-danger post-note" role="alert" data-post-error>{error}</p>{/if}
    {#if reminded}<p class="text-sm text-muted post-note" role="status" data-post-reminded>{reminded}</p>{/if}
    <PostFiles {post} rows={fileRows} />
    <PostLinks {post} />
    <Reactions bind:this={reactions} {post} {people} rows={reactionRows} onerror={(e) => error = e.message} />
    {#if !inThread && isRoot && post.replyCount > 0}
      <a class="text-sm post-replies" href={threadHref(post)} data-post-replies>
        <Icon name="thread" /> <strong>{post.replyCount} {post.replyCount === 1 ? 'reply' : 'replies'}</strong>
        <span class="text-muted">· {ago(post.lastReplyAt)}</span>
      </a>
    {/if}
  </div>
  {#if !editing}
    <div class="post-bar card" role="toolbar" aria-label="Post actions">
      <ReactionPicker onpick={(name) => reactions?.toggle(name)}>
        {#snippet trigger()}<button type="button" class="btn ghost square xs" aria-label="Add a reaction" title="React" data-post-react><Icon name="smile" /></button>{/snippet}
      </ReactionPicker>
      {#if !inThread && isRoot}
        <button type="button" class="btn ghost square xs" aria-label="Reply in thread" title="Reply in thread" data-post-reply onclick={() => goto(threadHref(post))}><Icon name="thread" /></button>
      {/if}
      <DropdownMenu placement="bottom-end">
        {#snippet trigger()}<button type="button" class="btn ghost square xs" aria-label="More actions" title="More" data-post-more><Icon name="more" /></button>{/snippet}
        {#if mine}<DropdownItem onclick={() => editing = true}>Edit</DropdownItem>{/if}
        <DropdownItem onclick={save}>{saved ? 'Unsave' : 'Save'}</DropdownItem>
        {#if inRoom}<DropdownItem onclick={pin}>{post.isPinned ? 'Unpin from the channel' : 'Pin to the channel'}</DropdownItem>{/if}
        {#if isRoot || inRoom}<DropdownSeparator />{/if}
        {#if inRoom}<DropdownItem onclick={follow}>{following ? 'Unfollow thread' : 'Follow thread'}</DropdownItem>{/if}
        {#if inRoom}<DropdownItem onclick={unread}>Mark unread</DropdownItem>{/if}
        {#if inRoom}
          <DropdownSubmenu heading="Remind me…">
            {#each REMINDERS as r (r.key)}
              <DropdownItem onclick={() => remind(r)}><span data-remind={r.key}>{r.label}</span></DropdownItem>
            {/each}
          </DropdownSubmenu>
        {/if}
        {#if mine}<DropdownItem onclick={() => nudging = true}><span data-nudge>Remind me if nobody replies</span></DropdownItem>{/if}
        {#if todoOn}<DropdownItem onclick={() => todoing = true}><span data-todo>Make a Basecamp to-do</span></DropdownItem>{/if}
        {#if mine}
          <DropdownSeparator />
          <DropdownItem tone="danger" data-confirm="Delete this post? There is no undo." data-confirm-label="Delete" onclick={drop}>Delete</DropdownItem>
        {/if}
      </DropdownMenu>
    </div>
  {/if}
  {#if todoing}<TodoDialog bind:open={todoing} {post} />{/if}
  {#if nudging}<WhenDialog bind:open={nudging} title="Remind me if nobody replies" action="Remind me" onpick={nudge} />{/if}
</article>

<style>
  .post { position: relative; display: grid; grid-template-columns: calc(var(--space-2xl) * 2) minmax(0, 1fr); column-gap: var(--space-lg); padding-block: var(--space-2xs); padding-inline: var(--space-lg); border-radius: var(--card-radius); transition: background-color var(--duration-fast, 0.12s); }
  .post:not(.continuation) { margin-block-start: var(--space-lg); padding-block-start: var(--space-sm); }
  .post:hover, .post.selected, .post.marked { background: var(--surface-sunken); }
  /* A post that names the reader: a warm ground and a bar, the way the sidebar's pill is danger. */
  .post.named { background: var(--tint-bg, var(--surface-sunken)); box-shadow: inset calc(var(--border-width) * 3) 0 0 var(--color-warning, var(--color-primary)); }
  .post.marked { box-shadow: inset calc(var(--border-width) * 3) 0 0 var(--color-primary); }
  .post-flag { grid-column: 2; margin: 0; color: var(--tint-ink); }
  .post-lead { display: flex; justify-content: center; align-items: flex-start; }
  .post-avatar { position: relative; display: inline-flex; }
  .post-time { font-size: var(--text-2xs); visibility: hidden; padding-block-start: var(--space-3xs); font-variant-numeric: tabular-nums; }
  .post:hover .post-time { visibility: visible; }
  .post-head { align-items: baseline; column-gap: var(--space-sm); }
  .post-head strong { font-weight: var(--label-font-weight); font-size: var(--text-sm); color: var(--ink-soft); }
  .post-head time { font-size: var(--text-xs); }
  .post-body { min-inline-size: 0; }
  /* The room's gutters already set the reading width; prose's own 64ch stopped a code block well short of the post. */
  .post-text { line-height: var(--leading-body); --measure: none; }
  .post-text :global(p) { margin: 0; }
  .post-text :global(p:last-of-type) { display: inline; }
  .post-note { margin: 0; }
  .post-replies { display: inline-flex; align-items: center; gap: var(--space-2xs); inline-size: fit-content; text-decoration: none; }
  .post-replies:hover strong { text-decoration: underline; }
  /* The actions float over the post's corner as one quiet capsule. */
  .post-bar { position: absolute; inset-inline-end: var(--space-sm); inset-block-start: calc(-1 * var(--space-lg)); display: flex; align-items: center; gap: var(--space-3xs); padding: var(--space-3xs); border-radius: var(--pill-radius); box-shadow: var(--shadow-md); opacity: 0; pointer-events: none; transition: opacity var(--duration-fast, 0.12s); }
  /* DropdownMenu wraps its trigger in an inline-block span; make it a flex box so it sits on the same centre line as the bare buttons. */
  .post-bar > :global(*) { margin: 0; }
  .post-bar > :global(span) { display: flex !important; }
  .post-bar :global(.btn) { border-radius: var(--pill-radius); }
  .post:hover .post-bar, .post:focus-within .post-bar { opacity: 1; pointer-events: auto; }
</style>
