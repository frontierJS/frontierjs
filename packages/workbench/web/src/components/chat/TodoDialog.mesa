<script>
  // components/chat/TodoDialog.mesa -- a post as a Basecamp to-do: a project, a
  // list, a title that starts as the post's first line, and the notes. What is
  // sent is what is shown: the project, the list, the title and the permalink the
  // server computes -- the post's text, its author and its channel never go,
  // because a to-do in a client-visible project cannot be taken back. Mounted
  // only while open, so it loads when it appears.
  import { lastTodoPlace, makeTodo, rememberTodoPlace, todoLists, todoNotes, todoProjects, todoTitleOf } from '../../lib/chat.js'
  import Modal  from '@frontierjs/ui/components/overlay/Modal.mesa'
  import Button from '@frontierjs/ui/components/forms/Button.mesa'

  export let open = false
  export let post = null

  let projects = []
  let lists    = []
  let project  = ''
  let list     = ''
  let title    = todoTitleOf(post)
  let notes    = ''
  let error    = null
  let loading  = true
  let saving   = false
  let created  = null

  // A 503 is Basecamp never connected; a refused call that names auth_failed is a grant Basecamp ended.
  const unconnected = (e) => (e.code ?? e.status) === 503 || /not connected|auth_failed/.test(e.message)
  const said = (e) => unconnected(e) ? 'Basecamp is not connected. Connect Basecamp on the Laptop screen (Services).' : e.message
  const fail = (e) => { error = said(e); loading = false }
  const last = lastTodoPlace()
  const pick = (rows, id) => String((rows.find(r => r.id === id) ?? rows[0])?.id ?? '')

  async function loadLists(listId) {
    lists = []; list = ''
    if (!project) return
    try {
      lists = await todoLists(Number(project))
      list = pick(lists, listId)
      error = lists.length ? null : 'That project has no to-do list.'
    } catch (e) { error = said(e) }
  }

  Promise.all([todoProjects(), todoNotes(post)]).then(([found, link]) => {
    projects = found; notes = link; loading = false
    project = pick(found, last?.projectId)
    return loadLists(Number(project) === last?.projectId ? last.listId : undefined)
  }).catch(fail)

  async function save() {
    if (!project || !list) { error = 'Pick a project and a list.'; return }
    if (!title.trim()) { error = 'A to-do needs a title.'; return }
    saving = true; error = null
    try {
      created = await makeTodo(post, { projectId: Number(project), listId: Number(list), title: title.trim() })
      rememberTodoPlace(Number(project), Number(list))
    }
    catch (e) { error = said(e) } finally { saving = false }
  }
</script>

<Modal bind:open title="Make a Basecamp to-do" size="sm">
  {#if created}
    <div class="stack gap-md" data-todo-done>
      <p class="todo-line">Made it: <a href={created.appUrl} target="_blank" rel="noopener" data-todo-link>{created.appUrl}</a></p>
      <div class="cluster gap-sm"><Button onclick={() => open = false}>Close</Button></div>
    </div>
  {:else}
    <form class="stack gap-md" novalidate onsubmit|preventDefault={save} data-todo-dialog>
      <label class="stack gap-2xs">
        <span class="text-sm">Project</span>
        <select class="field" aria-label="Project" bind:value={project} onchange={() => loadLists()} disabled={loading} data-todo-project>
          {#each projects as p (p.id)}<option value={String(p.id)}>{p.name}</option>{/each}
        </select>
      </label>
      <label class="stack gap-2xs">
        <span class="text-sm">To-do list</span>
        <select class="field" aria-label="To-do list" bind:value={list} disabled={loading || !lists.length} data-todo-list>
          {#each lists as l (l.id)}<option value={String(l.id)}>{l.name}</option>{/each}
        </select>
      </label>
      <label class="stack gap-2xs">
        <span class="text-sm">Title</span>
        <input class="field" aria-label="Title" maxlength="255" bind:value={title} data-todo-title />
      </label>
      <label class="stack gap-2xs">
        <span class="text-sm">Notes</span>
        <input class="field" aria-label="Notes" readonly value={notes} data-todo-notes />
      </label>
      <p class="text-sm text-muted todo-line">Only these go to Basecamp: the post's text, its author and its channel do not.</p>
      {#if error}<p class="text-sm text-danger todo-line" role="alert" data-todo-error>{error}</p>{/if}
      <div class="cluster gap-sm">
        <Button type="submit" loading={saving} disabled={loading || !notes} data-todo-save>Make to-do</Button>
        <Button treatment="ghost" onclick={() => open = false}>Cancel</Button>
      </div>
    </form>
  {/if}
</Modal>

<style>
  .todo-line { margin: 0; overflow-wrap: anywhere; }
</style>
