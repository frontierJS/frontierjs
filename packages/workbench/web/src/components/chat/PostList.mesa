<script>
  // components/chat/PostList.mesa -- a channel's root posts, oldest at the
  // bottom. A `posts.tethered({ state: 'local' })` over the channel: a post the
  // sync lands (somebody else's, over /ws) or the composer's own reaches the
  // window as a push, so nothing here appends by hand.
  //
  // serpgrid's PostList does not use `tethered()` because its window grows
  // upward ("Load earlier") and a grown window stops taking pushed rows. This
  // slice holds the newest NEWEST and never grows it, which is the case the
  // tether does take; "Load earlier" is the slice that owns that trade.
  import { posts } from '../../resources/Post.mesa'
  import { byPost, outbox, roomExtras, unsent } from '../../lib/chat.js'
  import Alert from '@frontierjs/ui/components/feedback/Alert.mesa'
  import PostItem from './PostItem.mesa'

  export let channelId = null
  export let people = []
  export let threadId = null   // the thread open beside the room, marked in the list
  export let markId = null     // a post a pin jumped to: scrolled to and marked

  const NEWEST = 50
  const KEPT   = 5    // rooms whose tether stays open, so going back to one draws at once

  let el     = null
  let pinned = true   // the view follows the newest post until the reader scrolls up
  let anchor = null   // { node, top } -- the first post in view, while scrolled up

  // ─── Rooms ──────────────────────────────────────────────────────────────

  // Least recently opened first. A kept room's tethers go on taking pushes, so its
  // rows are current when the room is opened again.
  const kept = new Map()
  function openRoom(id) {
    const extras = roomExtras(id)
    const list = posts.tethered({
      state: 'local',
      // Roots only, asked of the server: a window of 50 spent on replies would show fewer roots.
      where: { channelExternalId: id, rootExternalId: null },
      directives: { orderBy: '-createdAt', limit: NEWEST },
    })
    return { posts: list, reactions: extras.reactions, files: extras.files, destroy() { list.destroy(); extras.destroy() } }
  }
  function tetherFor(id) {
    const t = kept.get(id) ?? openRoom(id)
    kept.delete(id)
    kept.set(id, t)
    for (const [old, o] of kept) {
      if (kept.size <= KEPT) break
      o.destroy()
      kept.delete(old)
    }
    return t
  }
  $.onDestroy(() => { for (const t of kept.values()) t.destroy() })

  // The room asked for, and the room drawn: the last room stays on screen until the
  // next has its first page of posts and its reactions and files, rather than the
  // list blanking and each post growing as its reactions and files land.
  let list    = tetherFor(channelId)
  let shown   = list
  let shownId = channelId
  $: channelId, () => { list = tetherFor(channelId) }
  $: {
    if (list !== shown && (!list.posts.loading || list.posts.rows.length)
        && (!list.reactions.loading || list.reactions.rows.length) && (!list.files.loading || list.files.rows.length)) {
      shown = list
      shownId = channelId
      pinned = true
      anchor = null
      if (el) el.scrollTop = 0
    }
  }
  $: ready = (!shown.posts.loading || shown.posts.rows.length > 0)
    && (!shown.reactions.loading || shown.reactions.rows.length > 0) && (!shown.files.loading || shown.files.rows.length > 0)

  // The tether holds the newest first, as loaded and as a push places one.
  $: rows = shown.posts.rows.filter(p => !p.deletedAt && !p.rootExternalId).slice().reverse()
  $: error = shown.posts.error ?? shown.reactions.error ?? shown.files.error
  $: reactionsBy = byPost(shown.reactions.rows)
  $: filesBy = byPost(shown.files.rows)
  const NONE = []
  $: outbox.posts   // standalone: a read inside an expression is not a subscription to an import's field
  $: sending = unsent(outbox.posts, shown.posts.rows, shownId)

  // ─── Scroll ─────────────────────────────────────────────────────────────

  // .posts is column-reverse, so scrollTop is 0 at the newest post and negative
  // above it, and a post's files, reactions and images growing it keep the
  // bottom where it is with no script. Scrolled up, the reverse holds: growth
  // BELOW the view moves what is being read, and WebKit has no scroll anchoring
  // to undo it, so `anchor` is the first post in view and a resize puts it back.
  // Chrome's own anchoring is off (overflow-anchor) so one mechanism holds in every engine.
  //
  // The anchor is the post's distance from the body's bottom, which a scroll does
  // not change, so only growth below it moves it. A frame delivers its scroll
  // events BEFORE its ResizeObserver, so a scroll landing in the frame a post grew
  // would record the grown place as the one to hold: `onScroll` leaves the anchor
  // alone while a resize is still unreported.
  let body = null
  let reported = 0   // the body's height the ResizeObserver last saw
  const fromBottom = (node) => body.getBoundingClientRect().bottom - node.getBoundingClientRect().top
  function remember() {
    anchor = null
    if (!el || !body || pinned) return
    const top = el.getBoundingClientRect().top
    for (const node of body.querySelectorAll('article[id^="post-"]')) {
      if (node.getBoundingClientRect().bottom > top) { anchor = { node, fromBottom: fromBottom(node) }; return }
    }
  }
  function onScroll() {
    if (!el) return
    pinned = el.scrollTop > -40
    if (body && body.offsetHeight !== reported) return
    remember()
  }
  const hold = (node) => {
    body = node
    reported = node.offsetHeight
    const ro = new ResizeObserver(() => {
      const grown = !pinned && anchor?.node.isConnected ? fromBottom(anchor.node) - anchor.fromBottom : 0
      if (grown) el.scrollTop -= grown
      reported = node.offsetHeight
      remember()
    })
    ro.observe(node)
    return () => { ro.disconnect(); if (body === node) body = null }
  }
  // A jump to a post the window holds; an older one is not loaded, and the caller is told.
  $: markId, () => {
    if (!markId) return
    const node = document.getElementById(`post-${markId}`)
    if (node) { pinned = false; node.scrollIntoView({ block: 'center' }); remember() }
  }

  const dayOf = (t) => new Date(t).toDateString()
  const dayLabel = (t) => {
    const d = new Date(t), now = new Date()
    if (d.toDateString() === now.toDateString()) return 'Today'
    const y = new Date(now); y.setDate(now.getDate() - 1)
    if (d.toDateString() === y.toDateString()) return 'Yesterday'
    return d.toLocaleDateString('en-US', { weekday: 'long', month: 'long', day: 'numeric' })
  }
  const continues = (prev, p) => !!prev && prev.profileExternalId === p.profileExternalId
    && dayOf(prev.createdAt) === dayOf(p.createdAt)
    && new Date(p.createdAt) - new Date(prev.createdAt) < 5 * 60_000
</script>

<div class="posts" bind:this={el} onscroll|passive={onScroll} role="log" aria-live="polite" aria-label="Messages" data-post-list>
  {#key shownId}
  <div class="posts-body" class:ready {@attach hold}>
  {#if error}<Alert tone="danger">{error.message}</Alert>{/if}
  {#each rows as p, i (p.externalId)}
    {#if i === 0 || dayOf(rows[i - 1].createdAt) !== dayOf(p.createdAt)}
      <div class="posts-day" role="separator">{dayLabel(p.createdAt)}</div>
    {/if}
    <PostItem post={p} {people} reactionRows={reactionsBy.get(p.externalId) ?? NONE} fileRows={filesBy.get(p.externalId) ?? NONE}
              continuation={continues(rows[i - 1], p)} selected={p.externalId === threadId} marked={p.externalId === markId} />
  {:else}
    {#if !sending.length}<p class="text-muted center posts-empty">{ready ? 'Nothing yet. Say something.' : '…'}</p>{/if}
  {/each}
  {#each sending as p, i (p.externalId)}
    <PostItem post={p} {people} reactionRows={NONE} fileRows={NONE} pending continuation={continues(i ? sending[i - 1] : rows.at(-1), p)} />
  {/each}
  </div>
  {/key}
</div>

<style>
  .posts { flex: 1; min-block-size: 0; overflow-y: auto; display: flex; flex-direction: column-reverse; overflow-anchor: none; padding-block: var(--space-lg) var(--space-xl); padding-inline: calc(var(--chat-gutter, var(--space-md)) - var(--space-md)); }
  .posts-body { display: flex; flex-direction: column; opacity: 0; }
  .posts-body.ready { opacity: 1; animation: posts-in 140ms ease-out; }
  @keyframes posts-in { from { opacity: 0; } }
  @media (prefers-reduced-motion: reduce) { .posts-body.ready { animation: none; } }
  .posts-empty { padding-block: var(--space-4xl) var(--space-sm); margin: 0; }
  .posts-day { align-self: center; margin-block: var(--space-xl) var(--space-sm); color: var(--ink-mute); font-size: var(--text-xs); font-weight: var(--label-font-weight); }
</style>
