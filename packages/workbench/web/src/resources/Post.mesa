<script module>
  // src/resources/Post.mesa -- the mirror's Post rows (`IDEAS/workbench-messages.md`).
  // Mirrored: the rows are the chat server's, landed by the sync, and the schema's
  // policies decide what a member lists; a write is forwarded as its caller.
  import { createResource } from '@frontierjs/sierra/resource'

  export const posts = createResource('posts', { model: 'Post' })
</script>
