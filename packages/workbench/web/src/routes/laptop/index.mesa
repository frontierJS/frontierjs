---
title: Laptop
---
<script>
  // What fli keeps on this laptop. Disk draws the four roots of fli's home and
  // Workbench's own folder the way macOS Storage draws a drive — one bar of what
  // takes the space, then each folder as a group of rows with Clear on a cache
  // entry and Remove on an idle lane. Keys lists every secret file with its mode
  // and mends a wrong one (chmod 600), under a card of who this laptop is on the
  // Frontier network. Running lists the dev servers `fli dev` has started in any
  // project and the tree holds a drive or a loop is taking, read only. Services
  // lists each account fli signs in to, how, whether it is, and the commands that
  // use it; only a press on Check runs a login probe (nothing shells out on load).
  //
  // The page sends a catalog name or a lane number and never a path; the API
  // resolves what to delete (api services/laptop). Confirmation is in the row.
  import { laptop } from '../../resources/Laptop.mesa'
  import { bytes }  from '../../lib/bytes.js'
  import { ago, at } from '../../lib/datetime.js'

  import Dot                 from '@frontierjs/ui/components/display/Dot.mesa'
  import Pill                from '@frontierjs/ui/components/display/Pill.mesa'
  import EmptyState          from '@frontierjs/ui/components/display/EmptyState.mesa'
  import Button              from '@frontierjs/ui/components/forms/Button.mesa'
  import ConfirmationPopover from '@frontierjs/ui/components/overlay/ConfirmationPopover.mesa'
  import Tabs                from '@frontierjs/ui/components/layout/Tabs.mesa'
  import TabList             from '@frontierjs/ui/components/layout/TabList.mesa'
  import Tab                 from '@frontierjs/ui/components/layout/Tab.mesa'
  import TabPanel            from '@frontierjs/ui/components/layout/TabPanel.mesa'
  import { toasts }          from '@frontierjs/ui/stores/toastStore'

  // The five classes in the order the bar and the groups draw them; the tone colors each segment.
  const CLASSES = {
    config:    { name: 'Config',    tone: 'primary',   what: 'what fli is told' },
    data:      { name: 'Data',      tone: 'info',      what: 'what fli keeps' },
    cache:     { name: 'Cache',     tone: 'warning',   what: 'what fli can fetch again' },
    state:     { name: 'State',     tone: 'secondary', what: 'what fli is doing' },
    workbench: { name: 'Workbench', tone: 'muted',     what: 'this app\'s own folder' },
  }
  const classOf = (root) => CLASSES[root] ?? { name: root, tone: 'muted', what: '' }

  let tab     = 'disk'
  let cls     = ''    // the folder tab open on Disk: a class's root
  let report  = null
  let loading = true
  let error   = null
  let pressed = {}    // row key → true while its request is in flight

  const sum = (rows) => rows.reduce((t, r) => t + r.bytes, 0)

  $: total       = report ? sum(report.classes) : 0
  $: reclaimable = report ? report.classes.reduce((t, c) => t + c.reclaimable, 0) : 0
  // A segment under 0.5% is drawn at a hairline so every class stays visible in the legend's bar.
  $: segments    = report ? report.classes.filter(c => c.bytes > 0).map(c => ({ ...c, pct: Math.max(0.5, total ? c.bytes * 100 / total : 0) })) : []

  async function load() {
    loading = true
    try {
      report = await laptop.service.invoke('disk')
      error  = null
      if (!report.classes.some(c => c.root === cls)) cls = report.classes[0]?.root ?? ''
    } catch (err) {
      error = err.message
    } finally {
      loading = false
    }
  }

  async function act(key, verb, body, label) {
    pressed = { ...pressed, [key]: true }
    try {
      const out = await laptop.service.invoke(verb, null, body)
      toasts.success(`${label}: freed ${bytes(out.freed)}`)
      await load()
    } catch (err) {
      toasts.error(err.message)
    } finally {
      pressed = { ...pressed, [key]: false }
    }
  }

  const clear      = (e) => act(`e:${e.root}:${e.name}`, 'clear', { root: e.root, name: e.name }, `Cleared ${e.name}`)
  const removeLane = (l) => act(`l:${l.n}`, 'removeLane', { lane: l.n }, `Removed lane ${l.n}`)

  const laneState = (l) => l.held ? `held by pid ${l.held}, a loop is running`
    : l.dirty ? 'holds work since its last sync — Remove will refuse'
    : 'idle and clean'

  // Keys loads when its tab first opens; the walk is cheap but a tab nobody opens costs nothing.
  let keysReport  = null
  let keysError   = null
  let keysLoading = false

  async function loadKeys() {
    keysLoading = true
    try {
      keysReport = await laptop.service.invoke('keys')
      keysError  = null
    } catch (err) {
      keysError = err.message
    } finally {
      keysLoading = false
    }
  }

  // The page names a row by its label; the API resolves the path.
  async function fixMode(k) {
    pressed = { ...pressed, [`k:${k.label}`]: true }
    try {
      const out = await laptop.service.invoke('fixMode', null, { label: k.label })
      toasts.success(`${out.label} is now ${out.mode}`)
      await loadKeys()
    } catch (err) {
      toasts.error(err.message)
    } finally {
      pressed = { ...pressed, [`k:${k.label}`]: false }
    }
  }

  $: ident   = keysReport?.identity
  $: present = keysReport ? keysReport.keys.filter(k => k.present).length : 0
  $: exposed = keysReport ? keysReport.keys.filter(k => k.exposed).length : 0
  $: { if (tab === 'keys' && !keysReport && !keysLoading) loadKeys() }

  // Running loads when its tab first opens, and again on Refresh: it is a look at
  // processes, so it is never cached by the page.
  let runReport  = null
  let runError   = null
  let runLoading = false

  async function loadRunning() {
    runLoading = true
    try {
      runReport = await laptop.service.invoke('running')
      runError  = null
    } catch (err) {
      runError = err.message
    } finally {
      runLoading = false
    }
  }

  $: { if (tab === 'running' && !runReport && !runLoading) loadRunning() }
  $: up   = runReport ? runReport.sessions.filter(s => s.running) : []
  $: idle = runReport ? runReport.sessions.length - up.length : 0

  // Services loads when its tab first opens. A probe runs only on its Check press and the
  // answer is kept per service id; the object is replaced, not mutated, so the row redraws.
  let svcReport  = null
  let svcError   = null
  let svcLoading = false
  let checks     = {}   // service id → { pending } | { ok, who, ms } | { error }

  async function loadServices() {
    svcLoading = true
    try {
      svcReport = await laptop.service.invoke('services')
      svcError  = null
    } catch (err) {
      svcError = err.message
    } finally {
      svcLoading = false
    }
  }

  async function check(s) {
    checks = { ...checks, [s.id]: { pending: true } }
    try {
      const out = await laptop.service.invoke('probeService', null, { id: s.id })
      checks = { ...checks, [s.id]: out }
    } catch (err) {
      checks = { ...checks, [s.id]: { error: err.message } }
    }
  }

  $: { if (tab === 'services' && !svcReport && !svcLoading) loadServices() }

  const signInTone = (s) => s.signIn.kind === 'cli' ? (s.signIn.installed ? 'info' : '') : (s.present ? 'success' : '')
  const signInWord = (s) => s.signIn.kind === 'cli' ? (s.signIn.installed ? 'installed' : 'not installed') : (s.present ? 'ready' : 'not set up')

  // `commands/github/_module.md#Setup` read as text: the file and its section.
  const setupText = (p) => p.replace('#', ' § ')

  const branchOf = (s) => s.branch ? `${s.worktree ? s.worktree.split('/').pop() : 'worktree'} · branch ${s.branch}` : 'main checkout'

  const when = (iso) => iso ? iso.slice(0, 16).replace('T', ' ') : ''

  load()
</script>

<header class="page-head">
  <h1 class="h3">Laptop</h1>
  <p class="text-muted">What fli keeps on this machine — its files, its secrets, what is running, and the accounts it signs in to.</p>
</header>

<Tabs activeId={tab} onchange={(id) => tab = id}>
  <TabList>
    <Tab id="disk">Disk</Tab>
    <Tab id="keys">Keys</Tab>
    <Tab id="running">Running</Tab>
    <Tab id="services">Services</Tab>
  </TabList>

  <!-- ─── Disk ─────────────────────────────────────────────────────── -->
  <TabPanel id="disk">
    <div class="panel">
      {#if error}
        <article class="alert danger"><div class="alert-content">{error}</div></article>
      {/if}

      {#if loading && !report}
        <p class="text-sm text-muted">Measuring…</p>
      {:else if report}
        <section class="card summary" id="laptop-summary">
          <div class="summary-figures">
            <div>
              <div class="figure-label">Reclaimable</div>
              <div class="figure-value">{bytes(reclaimable)}</div>
            </div>
            <div>
              <div class="figure-label">In use</div>
              <div class="figure-value soft">{bytes(total)}</div>
            </div>
          </div>
          <div class="usage" role="img" aria-label={`${bytes(total)} across ${segments.length} folders`}>
            {#each segments as c (c.root)}
              <span class={`seg ${classOf(c.root).tone}`} style:flex-basis={`${c.pct}%`} title={`${classOf(c.root).name} · ${bytes(c.bytes)}`}></span>
            {/each}
          </div>
          <ul class="legend">
            {#each report.classes as c (c.root)}
              <li class="legend-item">
                <span class={`swatch ${classOf(c.root).tone}`}></span>
                <span>{classOf(c.root).name}</span>
                <span class="text-muted num">{bytes(c.bytes)}</span>
              </li>
            {/each}
          </ul>
        </section>

        <div class="panes" id="laptop-disk">
          <Tabs activeId={cls} onchange={(id) => cls = id}>
            <TabList>
              {#each report.classes as c (c.root)}
                <Tab id={c.root}>
                  <span class="tab-label">
                    <span class={`swatch ${classOf(c.root).tone}`}></span>
                    {classOf(c.root).name}
                    <span class="tab-size num">{bytes(c.bytes)}</span>
                  </span>
                </Tab>
              {/each}
            </TabList>

            {#each report.classes as c (c.root)}
              <TabPanel id={c.root}>
                <section class="pane" data-class={c.root}>
                  <header class="pane-head">
                    <div class="pane-title">
                      <span class={`swatch ${classOf(c.root).tone}`}></span>
                      <h2 class="h6">{classOf(c.root).name}</h2>
                      <span class="text-sm text-muted">{classOf(c.root).what}</span>
                    </div>
                    <code class="path text-xs">{c.path}{c.exists ? '' : ' — not there yet'}</code>
                  </header>

                  {#if c.entries.length}
                    <ul class="rows-list">
                      {#each c.entries as e (e.name)}
                        <li class="lp-row" data-entry={e.name}>
                          <div class="row-main">
                            <div class="row-name">{e.name}</div>
                            {#if e.known && e.what}<div class="row-sub">{e.what}</div>
                            {:else if e.root !== 'workbench'}<div class="row-sub">unknown</div>{/if}
                          </div>
                          <div class="row-size num">{bytes(e.bytes)}</div>
                          <div class="row-act">
                            {#if e.reclaim === 'clear' && e.present}
                              <ConfirmationPopover inline title={`Remove ${bytes(e.bytes)}?`} confirmLabel="Yes" cancelLabel="No" onconfirm={() => clear(e)}>
                                {#snippet trigger()}
                                  <Button size="sm" treatment="outlined" tone="danger" loading={!!pressed[`e:${e.root}:${e.name}`]}>Clear</Button>
                                {/snippet}
                              </ConfirmationPopover>
                            {/if}
                          </div>
                        </li>
                        {#if e.reclaim === 'remove-lane'}
                          {#each report.lanes as l (l.n)}
                            <li class="lp-row lp-lane" data-lane={l.n}>
                              <div class="row-main">
                                <div class="row-name">
                                  <Dot tone={l.held ? 'info' : l.dirty ? 'warning' : ''} hollow={!l.held && !l.dirty} pulse={!!l.held} label={laneState(l)} />
                                  lane {l.n}
                                </div>
                                <div class="row-sub">{laneState(l)}</div>
                              </div>
                              <div class="row-size num">{bytes(l.bytes)}</div>
                              <div class="row-act">
                                <ConfirmationPopover inline title={`Remove ${bytes(l.bytes)}?`} confirmLabel="Yes" cancelLabel="No" onconfirm={() => removeLane(l)}>
                                  {#snippet trigger()}
                                    <Button size="sm" treatment="outlined" tone="danger" disabled={!!l.held} loading={!!pressed[`l:${l.n}`]}>Remove</Button>
                                  {/snippet}
                                </ConfirmationPopover>
                              </div>
                            </li>
                          {/each}
                        {/if}
                      {/each}
                    </ul>
                  {:else}
                    <p class="row-sub pane-empty">Nothing in it yet.</p>
                  {/if}

                  <footer class="pane-foot">
                    <span class="text-sm text-muted">{c.reclaimable ? `${bytes(c.reclaimable)} reclaimable` : 'nothing to reclaim'}</span>
                    <span class="num">{bytes(c.bytes)}</span>
                  </footer>
                </section>
              </TabPanel>
            {/each}
          </Tabs>
        </div>

        <div class="panel-foot">
          <span class="text-sm text-muted" id="laptop-walk">Scanned in {(report.walkMs / 1000).toFixed(1)} s</span>
          <Button size="sm" treatment="outlined" id="disk-rescan" loading={loading} onclick={load}>Rescan</Button>
        </div>
      {/if}
    </div>
  </TabPanel>

  <!-- ─── Keys ─────────────────────────────────────────────────────── -->
  <TabPanel id="keys">
    <div class="panel">
      {#if keysError}
        <article class="alert danger"><div class="alert-content">{keysError}</div></article>
      {/if}

      {#if keysLoading && !keysReport}
        <p class="text-sm text-muted">Checking…</p>
      {:else if keysReport}
        <section class="card identity" id="laptop-identity">
          <header class="pane-title">
            <h2 class="h6">On the Frontier network</h2>
          </header>
          {#if ident.nick || ident.member}
            <dl class="facts">
              <dt>Speaks as</dt>
              <dd><strong>{ident.nick ?? ident.member.name}</strong>{#if ident.member}<span class="text-muted"> · member no. {ident.member.id}</span>{/if}</dd>
              {#if ident.box}
                <dt>Box</dt>
                <dd><code class="text-xs path">{ident.box}</code></dd>
              {/if}
              <dt>Peers</dt>
              <dd>
                {#if ident.peers.length}
                  <span class="cluster">
                    {#each ident.peers as p (p.nick)}<Pill>{p.nick}</Pill>{/each}
                  </span>
                {:else}<span class="text-muted">nobody yet</span>{/if}
              </dd>
              <dt>Waiting</dt>
              <dd>
                {#if ident.waiting.from.length}
                  {ident.waiting.from.map(w => `${w.count} from ${w.from}`).join(', ')}
                {:else}<span class="text-muted">nothing</span>{/if}
              </dd>
            </dl>
          {:else}
            <p class="text-sm text-muted">This laptop is not a member yet.</p>
          {/if}
        </section>

        <section class="pane">
          <header class="pane-head">
            <div class="pane-title">
              <h2 class="h6">Secret files</h2>
              <span class="text-sm text-muted">{present} of {keysReport.keys.length} present</span>
            </div>
            {#if exposed}
              <Pill tone="danger" dot>{exposed} readable by others</Pill>
            {:else if present}
              <Pill tone="success" dot>all private</Pill>
            {/if}
          </header>

          <ul class="rows-list" id="laptop-keys">
            {#each keysReport.keys as k (k.label)}
              <li class={`lp-row key ${k.present ? '' : 'absent'}`} data-key={k.label}>
                <div class="row-lead">
                  {#if k.present}
                    <Dot tone={k.exposed ? 'danger' : 'success'} label={k.exposed ? 'exposed' : 'private'} />
                  {:else}
                    <Dot hollow label="not yet made" />
                  {/if}
                </div>
                <div class="row-main">
                  <div class="row-name"><code>{k.label}{#if k.kind === 'dir'}/{/if}</code></div>
                  <div class="row-sub">
                    {#if !k.present}not yet made
                    {:else if k.exposed}readable by other accounts on this machine
                    {:else}{k.kind === 'dir' ? 'folder' : 'file'}, private to {k.owner}{/if}
                  </div>
                </div>
                <div class="row-col num"><code>{k.mode ?? ''}</code></div>
                <div class="row-col text-sm text-muted" title={k.mtime ? at(k.mtime) : ''}>{k.mtime ? ago(k.mtime) : ''}</div>
                <div class="row-act">
                  {#if k.exposed}
                    <Button size="sm" treatment="outlined" tone="danger" loading={!!pressed[`k:${k.label}`]} onclick={() => fixMode(k)}>Fix</Button>
                  {/if}
                </div>
              </li>
            {/each}
          </ul>
        </section>

        <p class="text-sm text-muted">Values never leave this machine's API. Fix sets a file to 600 and a folder to 700.</p>
      {/if}
    </div>
  </TabPanel>

  <!-- ─── Running ──────────────────────────────────────────────────── -->
  <TabPanel id="running">
    <div class="panel">
      {#if runError}
        <article class="alert danger"><div class="alert-content">{runError}</div></article>
      {/if}

      {#if runLoading && !runReport}
        <p class="text-sm text-muted">Looking…</p>
      {:else if runReport}
        <section class="pane">
          <header class="pane-head">
            <div class="pane-title">
              <h2 class="h6">Dev servers</h2>
              <span class="text-sm text-muted">
                {up.length ? `${up.length} running` : 'none running'}{idle ? ` · ${idle} remembered, not running` : ''}
              </span>
            </div>
            <Button size="sm" treatment="outlined" id="running-refresh" loading={runLoading} onclick={loadRunning}>Refresh</Button>
          </header>

          {#if up.length}
            <ul class="rows-list" id="laptop-sessions">
              {#each up as s (s.root + (s.pid ?? ''))}
                <li class="lp-row server" data-session={s.name}>
                  <div class="row-lead"><Dot tone="success" pulse label="running" /></div>
                  <div class="row-main">
                    <div class="row-name">{s.name} <span class="text-sm text-muted">{branchOf(s)}</span></div>
                    <div class="row-sub"><code class="path text-xs">{s.root}</code></div>
                    <div class="lp-chips">
                      {#each s.ports as p (p.port)}
                        <span class={`lp-chip ${p.answering ? 'lp-on' : ''}`} data-port={p.port}>
                          <Dot tone={p.answering ? 'success' : ''} hollow={!p.answering} size="xs" label={p.answering ? 'answering' : 'not answering'} />
                          <code>{p.port}</code>
                          <span class="text-muted">{p.category}</span>
                        </span>
                      {/each}
                    </div>
                  </div>
                  <div class="row-col text-sm text-muted" title={s.startedAt ? at(s.startedAt) : ''}>
                    {s.startedAt ? `up ${ago(s.startedAt)}` : ''}{s.pid ? ` · pid ${s.pid}` : ''}
                  </div>
                </li>
              {/each}
            </ul>
          {:else}
            <div class="quiet" id="running-none">
              <EmptyState title="Nothing running">No project has a dev server up. <code>fli dev</code> in a checkout starts one.</EmptyState>
            </div>
          {/if}
        </section>

        <section class="pane">
          <header class="pane-head">
            <div class="pane-title">
              <h2 class="h6">Tree holds</h2>
              <span class="text-sm text-muted">{runReport.holds.length ? `${runReport.holds.length} held` : 'a drive or a loop takes one while it works'}</span>
            </div>
          </header>

          {#if runReport.holds.length}
            <ul class="rows-list" id="laptop-holds">
              {#each runReport.holds as h (h.file)}
                <li class="lp-row" data-hold={h.file}>
                  <div class="row-lead"><Dot tone={h.alive ? 'success' : 'danger'} label={h.alive ? 'alive' : 'holder gone'} /></div>
                  <div class="row-main">
                    <div class="row-name">
                      {#if h.tree}{h.tree.split('/').pop()}{:else}unknown tree{/if}
                      <span class="text-sm text-muted">{h.resource}</span>
                    </div>
                    <div class="row-sub">
                      {#if h.tree}<code class="path text-xs">{h.tree}</code>{:else}<code class="text-xs">{h.key}</code>{/if}
                    </div>
                  </div>
                  <div class="row-col text-sm">{h.pid ? `pid ${h.pid}` : ''}{h.what ? ` · ${h.what}` : ''}{#if !h.alive} <span class="text-danger">· gone</span>{/if}</div>
                  <div class="row-col text-sm text-muted" title={h.since ? at(h.since) : ''}>{h.since ? ago(h.since) : ''}</div>
                </li>
              {/each}
            </ul>
          {:else}
            <p class="row-sub pane-empty" id="holds-none">No holds.</p>
          {/if}
        </section>
      {/if}
    </div>
  </TabPanel>

  <!-- ─── Services ─────────────────────────────────────────────────── -->
  <TabPanel id="services">
    <div class="panel">
      {#if svcError}
        <article class="alert danger"><div class="alert-content">{svcError}</div></article>
      {/if}

      {#if svcLoading && !svcReport}
        <p class="text-sm text-muted">Reading…</p>
      {:else if svcReport}
        <p class="text-sm text-muted">Presence is read from this laptop; a value is never sent to this page. Check runs the login's own command, only when pressed.</p>

        <div class="cards" id="laptop-services">
          {#each svcReport as s (s.id)}
            <article class="card lp-service" id={`service-${s.id}`} data-service={s.id}>
              <header class="pane-head">
                <h2 class="h6">{s.name}</h2>
                <Pill tone={signInTone(s)} dot>{signInWord(s)}</Pill>
              </header>

              <dl class="facts lp-compact">
                <dt>Signs in</dt>
                <dd>
                  {#if s.signIn.kind === 'env'}
                    <span class="lp-chips">
                      {#each s.signIn.keys as k (k.key)}
                        <span class={`lp-chip ${k.present ? 'lp-on' : ''}`} data-key={k.key}>
                          <Dot tone={k.present ? 'success' : ''} hollow={!k.present} size="xs" label={k.present ? 'set' : 'not set'} />
                          <code>{k.key}</code>
                        </span>
                      {/each}
                    </span>
                  {:else if s.signIn.kind === 'file'}
                    <span class={`lp-chip ${s.present ? 'lp-on' : ''}`}>
                      <Dot tone={s.present ? 'success' : ''} hollow={!s.present} size="xs" label={s.present ? 'present' : 'absent'} />
                      <code>{s.signIn.entry}</code>
                    </span>
                  {:else}
                    <span class="stack gap-xs">
                      <span>through <code>{s.signIn.bin}</code></span>
                      <span class="text-sm text-muted">log in with <code>{s.signIn.login}</code></span>
                      <span class="cluster">
                        <Button size="sm" treatment="outlined" data-check={s.id} disabled={!s.signIn.installed}
                                loading={!!checks[s.id]?.pending} onclick={() => check(s)}>Check</Button>
                        {#if checks[s.id] && !checks[s.id].pending}
                          <span class="text-sm" data-result={s.id}>
                            {#if checks[s.id].error}<span class="text-danger">{checks[s.id].error}</span>
                            {:else if checks[s.id].ok}<span class="text-success">signed in{checks[s.id].who ? ` as ${checks[s.id].who}` : ''}</span>
                            {:else}not signed in{/if}
                            <span class="text-muted"> · {checks[s.id].ms} ms</span>
                          </span>
                        {/if}
                      </span>
                    </span>
                  {/if}
                </dd>

                {#if s.vendor}
                  <dt>Token</dt>
                  <dd>
                    <a href={s.vendor.url} target="_blank" rel="noopener noreferrer">Make one</a>
                    {#if s.vendor.note}<span class="text-sm text-muted"> — {s.vendor.note}</span>{/if}
                  </dd>
                {/if}
                {#if s.setup}
                  <dt>Setup</dt>
                  <dd><code class="text-xs path">{setupText(s.setup)}</code></dd>
                {/if}
              </dl>

              <div class="used">
                <div class="kicker">Used by</div>
                {#if s.commands.length}
                  <ul class="commands" data-commands={s.id}>
                    {#each s.commands as c (c.name)}
                      <li><code>fli {c.name}</code><span class="text-sm text-muted">{c.description ?? ''}</span></li>
                    {/each}
                  </ul>
                {:else}
                  <span class="text-sm text-muted">no command yet</span>
                {/if}
              </div>
            </article>
          {/each}
        </div>
      {/if}
    </div>
  </TabPanel>
</Tabs>

<style>
  /* ─── Page ───────────────────────────────────────────────────────── */
  .page-head { display: flex; flex-direction: column; gap: var(--space-2xs); margin-block-end: var(--space-2xl); }
  .page-head p { margin: 0; max-inline-size: 60ch; }

  .panel      { display: flex; flex-direction: column; gap: var(--space-2xl); padding-block-start: var(--space-xl); }
  .panel-foot { display: flex; align-items: center; justify-content: space-between; gap: var(--space-md); }

  .num  { font-variant-numeric: tabular-nums; }
  .path { color: var(--ink-mute); background: none; padding: 0; overflow-wrap: anywhere; }

  /* ─── Disk summary ───────────────────────────────────────────────── */
  .summary         { display: flex; flex-direction: column; gap: var(--space-xl); }
  .summary-figures { display: flex; flex-wrap: wrap; gap: var(--space-4xl); }
  .figure-label    { font-size: var(--text-sm); color: var(--ink-mute); font-weight: var(--label-font-weight);
                     text-transform: var(--label-text-transform); letter-spacing: var(--label-letter-spacing); }
  .figure-value    { font-size: var(--text-3xl); font-weight: 700; line-height: 1.15; font-variant-numeric: tabular-nums; }
  .figure-value.soft { color: var(--ink-soft); font-weight: 500; }

  .usage { display: flex; block-size: 0.75rem; border-radius: 999px; overflow: hidden; background: var(--surface-sunken); gap: 2px; }
  .seg { flex: 0 0 auto; min-inline-size: 3px; }

  .legend      { display: flex; flex-wrap: wrap; gap: var(--space-xs) var(--space-2xl); list-style: none; margin: 0; padding: 0; }
  .legend-item { display: inline-flex; align-items: center; gap: var(--space-xs); font-size: var(--text-sm); }

  .swatch { display: inline-block; inline-size: 0.6rem; block-size: 0.6rem; border-radius: 3px; flex-shrink: 0; }

  /* Segment and swatch fills: one tone per class, no literal colors. */
  .seg.primary,   .swatch.primary   { background: var(--color-primary); }
  .seg.info,      .swatch.info      { background: var(--color-info); }
  .seg.warning,   .swatch.warning   { background: var(--color-warning); }
  .seg.secondary, .swatch.secondary { background: var(--color-secondary); }
  .seg.muted,     .swatch.muted     { background: var(--color-muted); }

  /* ─── Groups and rows ─────────────────────────────────────────────── */
  .tab-label { display: inline-flex; align-items: center; gap: var(--space-xs); }
  .tab-size  { color: var(--ink-mute); font-size: var(--text-xs); }
  .panes     { display: flex; flex-direction: column; gap: var(--space-xl); }
  .cards  { display: grid; grid-template-columns: repeat(auto-fill, minmax(min(100%, 22rem), 1fr)); gap: var(--space-xl); }

  .pane {
    border:        var(--border-width) solid var(--rule);
    border-radius: var(--card-radius);
    background:    var(--surface);
    overflow:      hidden;
  }
  .pane-head {
    display: flex; align-items: center; justify-content: space-between; flex-wrap: wrap;
    gap: var(--space-xs) var(--space-lg);
    padding: var(--space-md) var(--space-xl);
    border-block-end: var(--border-width) solid var(--rule);
    background: var(--surface-sunken);
  }
  .pane-title { display: flex; align-items: center; gap: var(--space-sm); min-inline-size: 0; }
  .pane-title h2 { margin: 0; }
  .pane-foot {
    display: flex; align-items: center; justify-content: space-between; gap: var(--space-md);
    padding: var(--space-sm) var(--space-xl);
    border-block-start: var(--border-width) solid var(--rule);
    font-size: var(--text-sm); color: var(--ink-soft);
  }

  .rows-list { list-style: none; margin: 0; padding: 0; }
  .lp-row {
    display: grid;
    grid-template-columns: minmax(0, 1fr) auto auto;
    align-items: center;
    gap: var(--space-lg);
    padding: var(--space-md) var(--space-xl);
    transition: background var(--motion-fast) var(--motion-ease);
  }
  .lp-row + .lp-row   { border-block-start: var(--border-width) solid var(--rule); }
  .lp-row:hover    { background: color-mix(in srgb, var(--ink) 3%, var(--surface)); }
  .row-main     { display: flex; flex-direction: column; gap: 0.125rem; min-inline-size: 0; }
  .row-name     { display: flex; align-items: center; gap: var(--space-sm); font-weight: 500; overflow-wrap: anywhere; }
  .row-sub      { font-size: var(--text-sm); color: var(--ink-mute); overflow-wrap: anywhere; }
  .row-size     { color: var(--ink-soft); text-align: end; min-inline-size: 5.5rem; }
  .row-col      { white-space: nowrap; }
  .row-act      { min-inline-size: 5rem; display: flex; justify-content: flex-end; }
  .row-lead     { display: flex; align-items: center; justify-content: center; inline-size: 1rem; }

  /* A lane sits under the entry that owns it: indented, with the entry's rule above it. */
  .lp-row.lp-lane            { padding-inline-start: calc(var(--space-xl) + var(--space-2xl)); background: color-mix(in srgb, var(--surface-sunken) 50%, var(--surface)); }
  .lp-row.lp-lane:hover      { background: color-mix(in srgb, var(--ink) 4%, var(--surface-sunken)); }

  .lp-row.key code { background: none; padding: 0; }
  .lp-row.key    { grid-template-columns: auto minmax(0, 1fr) 3.5rem 7rem auto; }
  .lp-row.absent { opacity: 0.6; }
  .lp-row.server { grid-template-columns: auto minmax(0, 1fr) auto; align-items: start; }
  .lp-row.server .row-lead { padding-block-start: 0.35rem; }
  .lp-row.server .row-col  { padding-block-start: 0.1rem; }
  #laptop-holds .lp-row    { grid-template-columns: auto minmax(0, 1fr) auto auto; }

  .pane-empty { padding: var(--space-lg) var(--space-xl); margin: 0; }
  .quiet       { padding: var(--space-3xl) var(--space-xl); }

  /* ─── Chips ──────────────────────────────────────────────────────── */
  .lp-chips { display: flex; flex-wrap: wrap; gap: var(--space-xs); margin-block-start: var(--space-xs); }
  .lp-chip {
    display: inline-flex; align-items: center; gap: var(--space-xs);
    padding: 0.15rem var(--space-sm);
    border: var(--border-width) solid var(--rule);
    border-radius: 999px;
    font-size: var(--text-xs);
    color: var(--ink-mute);
    background: var(--surface);
  }
  .lp-chip code    { background: none; padding: 0; color: inherit; }
  .lp-chip.lp-on      { color: var(--ink); border-color: color-mix(in srgb, var(--color-success) 40%, var(--rule)); }

  /* ─── Identity and services ───────────────────────────────────────── */
  .identity { display: flex; flex-direction: column; gap: var(--space-lg); }
  .identity h2, .lp-service h2 { margin: 0; }
  .lp-service  { display: flex; flex-direction: column; gap: var(--space-lg); }
  .lp-service > .pane-head { margin: calc(var(--space-3xl) * -1) calc(var(--space-3xl) * -1) 0; }

  .facts.lp-compact { font-size: var(--text-sm); gap: var(--space-sm) var(--space-xl); }
  .facts dt      { color: var(--ink-mute); }
  .facts dd      { margin: 0; min-inline-size: 0; }

  .commands      { list-style: none; margin: 0; padding: 0; display: grid; grid-template-columns: max-content minmax(0, 1fr); gap: var(--space-xs) var(--space-md); align-items: baseline; }
  .commands li   { display: contents; }
  .used          { display: flex; flex-direction: column; gap: var(--space-sm); padding-block-start: var(--space-md); border-block-start: var(--border-width) solid var(--rule); }
  .commands code { justify-self: start; font-size: var(--text-xs); }

  /* ─── Narrow ──────────────────────────────────────────────────────── */
  @media (max-width: 40rem) {
    .lp-row.key     { grid-template-columns: auto minmax(0, 1fr) auto; }
    .lp-row.key .row-col { display: none; }
    #laptop-holds .lp-row { grid-template-columns: auto minmax(0, 1fr) auto; }
    #laptop-holds .lp-row .row-col:last-child { display: none; }
    .row-size    { min-inline-size: 0; }
    /* A max-content column is as wide as the longest fli command, which
       widened the whole page past the screen. Name over description. */
    .commands      { grid-template-columns: minmax(0, 1fr); }
    .commands code { overflow-wrap: anywhere; }
  }
</style>
