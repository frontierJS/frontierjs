---
title: Settings
---
<script>
  // The member's own settings. Appearance, then this machine's global
  // environment and the user's own fli commands (api services/laptop, which goes
  // through fli's `global-env.js` and `registry.js`). The Member row is
  // read-only to its owner (`@@allow(read, ...)` and nothing else), so the nick
  // is shown, not edited, and a theme is a fact about this browser, not the
  // member -- Sierra stores it under the app's prefix in localStorage.
  //
  // The picker reads `theme.preference`, not `theme.value`: under "Match
  // system" the value is whichever of the OS pair is live, and a checked card
  // would claim a pick nobody made.

  import { theme, setTheme, themes } from '@frontierjs/sierra/theme'
  import { goto }    from '@frontierjs/sierra/router'
  import { session, signOut } from '../../lib/session.js'
  import { laptop }  from '../../resources/Laptop.mesa'
  import { toasts }  from '@frontierjs/ui/stores/toastStore'
  import { textSize, setTextSize, resetTextSize, TEXT_SIZE } from '../../lib/text-size.js'
  var { min, max, step, fallback } = TEXT_SIZE

  import Card        from '@frontierjs/ui/components/layout/Card.mesa'
  import Switch      from '@frontierjs/ui/components/forms/Switch.mesa'
  import Slider      from '@frontierjs/ui/components/forms/Slider.mesa'
  import Button      from '@frontierjs/ui/components/forms/Button.mesa'
  import Input       from '@frontierjs/ui/components/forms/Input.mesa'
  import Select      from '@frontierjs/ui/components/forms/Select.mesa'
  import ThemePicker from '@frontierjs/ui/components/display/ThemePicker.mesa'

  $: (theme.value, theme.preference)
  $: (session.user)
  $: (textSize())

  // Global environment: values arrive masked and are never asked for again.
  let envKeys   = []
  let envPath   = ''
  let envError  = null
  let newKey    = ''
  let newValue  = ''
  let setting   = false
  let unsetting = {}

  async function loadEnv() {
    try {
      const out = await laptop.service.invoke('globalEnv')
      envKeys  = out.keys
      envPath  = out.path
      envError = null
    } catch (err) {
      envError = err.message
    }
  }

  async function setEnv() {
    setting = true
    try {
      await laptop.service.invoke('setGlobalEnv', null, { key: newKey.trim(), value: newValue })
      toasts.success(`${newKey.trim()} is set`)
      newKey   = ''
      newValue = ''
      await loadEnv()
    } catch (err) {
      toasts.error(err.message)
    } finally {
      setting = false
    }
  }

  async function unsetEnv(key) {
    unsetting = { ...unsetting, [key]: true }
    try {
      await laptop.service.invoke('unsetGlobalEnv', null, { key })
      toasts.success(`${key} is unset`)
      await loadEnv()
    } catch (err) {
      toasts.error(err.message)
    } finally {
      unsetting = { ...unsetting, [key]: false }
    }
  }

  // Profiles (`FJS-D2089`): one client's account keys each, written through
  // the same `global-env.js` helpers as the pane above. A profile's keys arrive
  // masked, with its file mode and the projects whose `.env` names it.
  let profiles      = []
  let profilesDir   = ''
  let profilesError = null
  let newProfile    = ''
  let makingProfile = false
  let pickedProfile = ''
  let pKey          = ''
  let pValue        = ''
  let settingP      = false
  let unsettingP    = {}

  async function loadProfiles() {
    try {
      const out = await laptop.service.invoke('profiles')
      profiles      = out.profiles
      profilesDir   = out.dir
      profilesError = null
    } catch (err) {
      profilesError = err.message
    }
  }

  async function makeProfile() {
    makingProfile = true
    try {
      await laptop.service.invoke('createProfile', null, { name: newProfile.trim() })
      const made = newProfile.trim()
      toasts.success(`Profile ${made} made`)
      newProfile = ''
      // The select draws blank on a value none of its options carries yet.
      await loadProfiles()
      pickedProfile = made
    } catch (err) {
      toasts.error(err.message)
    } finally {
      makingProfile = false
    }
  }

  async function setProfileKey() {
    settingP = true
    try {
      await laptop.service.invoke('setProfileKey', null, { name: pickedProfile, key: pKey.trim(), value: pValue })
      toasts.success(`${pKey.trim()} is set in ${pickedProfile}`)
      pKey   = ''
      pValue = ''
      await loadProfiles()
    } catch (err) {
      toasts.error(err.message)
    } finally {
      settingP = false
    }
  }

  async function unsetProfileKey(name, key) {
    const id = `${name}/${key}`
    unsettingP = { ...unsettingP, [id]: true }
    try {
      await laptop.service.invoke('unsetProfileKey', null, { name, key })
      toasts.success(`${key} is unset in ${name}`)
      await loadProfiles()
    } catch (err) {
      toasts.error(err.message)
    } finally {
      unsettingP = { ...unsettingP, [id]: false }
    }
  }

  const profileOptions = () => [{ value: '', label: 'Choose a profile…' }, ...profiles.map(p => ({ value: p.name, label: p.name }))]

  // The ntfy topic Claude Code's Stop hook pings when a long turn ends.
  let pingInfo  = null
  let pingTopic = ''
  let pingError = null
  let pinging   = false

  async function loadPing() {
    try {
      pingInfo  = await laptop.service.invoke('ping')
      pingTopic = pingInfo.topic ?? ''
      pingError = null
    } catch (err) {
      pingError = err.message
    }
  }

  async function savePing() {
    pinging = true
    try {
      pingInfo  = await laptop.service.invoke('setPing', null, { topic: pingTopic.trim() })
      pingTopic = pingInfo.topic ?? ''
      toasts.success(pingInfo.topic ? `Pinging ${pingInfo.topic}` : 'Ping is off')
    } catch (err) {
      toasts.error(err.message)
    } finally {
      pinging = false
    }
  }

  // The user's own fli commands, read only.
  let cmds     = null
  let cmdError = null

  async function loadCommands() {
    try {
      cmds     = await laptop.service.invoke('commands')
      cmdError = null
    } catch (err) {
      cmdError = err.message
    }
  }

  loadEnv()
  loadProfiles()
  loadPing()
  loadCommands()

  async function leave() {
    await signOut()
    goto('/login/')
  }

  const following = () => theme.preference === 'system'

  // Leaving "Match system" keeps the theme on screen rather than jumping to the
  // configured default.
  function follow(checked) {
    setTheme(checked ? 'system' : theme.value)
  }
</script>

<header class="stack-sm">
  <h1 class="h3">Settings</h1>
  {#if session.user}
    <p class="cluster text-muted">
      <span>Signed in as <strong>{session.user.nick}</strong>.</span>
      <Button treatment="outlined" size="sm" id="sign-out" onclick={leave}>Sign out</Button>
    </p>
  {/if}
</header>

<Card id="settings-appearance">
  <h2 class="h5">Appearance</h2>
  <Switch id="settings-theme-system" label="Match system"
          description="Follow the operating system's light or dark setting"
          checked={following()} onchange={follow} />
  <ThemePicker id="settings-theme" label="Theme"
               themes={themes()} value={theme.preference}
               onchange={setTheme} />
  <Slider id="settings-text-size" label="Font size"
          {min} {max} {step}
          value={textSize()} format={(v) => `${v}px`} onchange={setTextSize} />
  <div>
    <Button size="xs" treatment="outlined" onclick={resetTextSize}>Reset to {fallback}px</Button>
  </div>
  <p class="text-sm text-muted">Stored in this browser, not on your account. The terminal picks it up when it opens.</p>
</Card>

<Card id="settings-env">
  <h2 class="h5">Global environment</h2>
  <p class="text-sm text-muted">
    Keys <code>fli</code> loads under every project's own <code>.env</code>{#if envPath}, kept in <code>{envPath}</code>{/if}. Values are masked here and never sent to this page.
  </p>
  {#if envError}
    <article class="alert danger"><div class="alert-content">{envError}</div></article>
  {/if}
  {#if envKeys.length}
    <table id="settings-env-table">
      <thead><tr><th>Key</th><th>Value</th><th>Used by</th><th></th></tr></thead>
      <tbody>
        {#each envKeys as k (k.key)}
          <tr data-env={k.key}>
            <td><code>{k.key}</code></td>
            <td><code>{k.masked}</code></td>
            <td class="text-sm" data-used-by={k.key}>{k.usedBy.length ? k.usedBy.join(', ') : '—'}</td>
            <td><Button size="sm" treatment="outlined" tone="danger" loading={!!unsetting[k.key]} onclick={() => unsetEnv(k.key)}>Unset</Button></td>
          </tr>
        {/each}
      </tbody>
    </table>
  {:else if !envError}
    <p class="text-sm text-muted">No keys set.</p>
  {/if}
  <form id="settings-env-form" class="cluster" novalidate onsubmit={(e) => { e.preventDefault(); setEnv() }}>
    <Input id="settings-env-key" name="key" label="Key" placeholder="API_TOKEN" required bind:value={newKey} />
    <Input id="settings-env-value" name="value" label="Value" type="password" autocomplete="off" required bind:value={newValue} />
    <Button type="submit" tone="primary" loading={setting}>Set</Button>
  </form>
</Card>

<Card id="settings-profiles">
  <h2 class="h5">Profiles</h2>
  <p class="text-sm text-muted">
    One client's account keys each{#if profilesDir}, kept in <code>{profilesDir}</code>{/if}. A project's <code>.env</code> says <code>FLI_PROFILE=name</code> to spend one, and a Basecamp remembers the profile it was bought under. Values are masked here and never sent to this page.
  </p>
  {#if profilesError}
    <article class="alert danger"><div class="alert-content">{profilesError}</div></article>
  {/if}
  {#each profiles as p (p.name)}
    <section class="stack-sm" data-profile={p.name}>
      <h3 class="h6"><code>{p.name}</code> <span class="text-sm text-muted">mode {p.mode}</span></h3>
      {#if p.open}
        <p class="text-sm text-danger" data-profile-open={p.name}>Other users can read this file: <code>chmod 600 {p.path}</code></p>
      {/if}
      <p class="text-sm text-muted" data-profile-projects={p.name}>
        {p.projects.length ? `Named by ${p.projects.join(', ')}` : 'No project under ~/code names it.'}
      </p>
      {#if p.keys.length}
        <table>
          <thead><tr><th>Key</th><th>Value</th><th>Used by</th><th></th></tr></thead>
          <tbody>
            {#each p.keys as k (k.key)}
              <tr data-profile-key={`${p.name}/${k.key}`}>
                <td><code>{k.key}</code></td>
                <td><code>{k.masked}</code></td>
                <td class="text-sm">{k.usedBy.length ? k.usedBy.join(', ') : '—'}</td>
                <td><Button size="sm" treatment="outlined" tone="danger" loading={!!unsettingP[`${p.name}/${k.key}`]} onclick={() => unsetProfileKey(p.name, k.key)}>Unset</Button></td>
              </tr>
            {/each}
          </tbody>
        </table>
      {:else}
        <p class="text-sm text-muted">No keys set.</p>
      {/if}
    </section>
  {:else}
    {#if !profilesError}
      <p class="text-sm text-muted">No profiles yet.</p>
    {/if}
  {/each}
  <form id="settings-profile-form" class="cluster" novalidate onsubmit={(e) => { e.preventDefault(); makeProfile() }}>
    <Input id="settings-profile-name" name="name" label="New profile" placeholder="acme" required bind:value={newProfile} />
    <Button type="submit" tone="primary" loading={makingProfile}>Make</Button>
  </form>
  <form id="settings-profile-key-form" class="cluster" novalidate onsubmit={(e) => { e.preventDefault(); setProfileKey() }}>
    <Select id="settings-profile-pick" label="Profile" placeholder="" options={(profiles, profileOptions())} bind:value={pickedProfile} />
    <Input id="settings-profile-key" name="key" label="Key" placeholder="CLOUDFLARE_API_TOKEN" required bind:value={pKey} />
    <Input id="settings-profile-value" name="value" label="Value" type="password" autocomplete="off" required bind:value={pValue} />
    <Button type="submit" tone="primary" loading={settingP} disabled={(pickedProfile, !pickedProfile)}>Set</Button>
  </form>
</Card>

<Card id="settings-ping">
  <h2 class="h5">Phone ping</h2>
  <p class="text-sm text-muted">
    The <a href="https://ntfy.sh" target="_blank" rel="noreferrer">ntfy</a> topic Claude Code posts to when a long Fable turn ends. Subscribe to the same name in the ntfy app. Anyone who knows a topic name can read it, so keep it hard to guess.{#if pingInfo}
    Kept in <code>{pingInfo.path}</code>.{/if}
  </p>
  {#if pingError}
    <article class="alert danger"><div class="alert-content">{pingError}</div></article>
  {/if}
  <form id="settings-ping-form" class="cluster" novalidate onsubmit={(e) => { e.preventDefault(); savePing() }}>
    <Input id="settings-ping-topic" name="topic" label="Topic" placeholder="leave empty to turn off" autocomplete="off" bind:value={pingTopic} />
    <Button type="submit" tone="primary" loading={pinging}>Save</Button>
  </form>
  {#if pingInfo}
    <p class="text-sm text-muted" data-ping-state>{pingInfo.url ? `Pinging ${pingInfo.url}` : 'Off: no topic is set.'}</p>
  {/if}
</Card>

<Card id="settings-commands">
  <h2 class="h5">Your commands</h2>
  {#if cmdError}
    <article class="alert danger"><div class="alert-content">{cmdError}</div></article>
  {:else if cmds && cmds.length}
    <table id="settings-commands-table">
      <thead><tr><th>Command</th><th>What it does</th><th>File</th></tr></thead>
      <tbody>
        {#each cmds as c (c.filePath)}
          <tr data-command={c.name}>
            <td><code>{c.name}</code></td>
            <td class="text-sm">{c.description}</td>
            <td class="text-sm"><code>{c.filePath}</code></td>
          </tr>
        {/each}
      </tbody>
    </table>
  {:else if cmds}
    <p class="text-sm text-muted">No commands of your own yet. A <code>.md</code> file dropped in the commands folder under <code>~/.config/fli</code> becomes one.</p>
  {/if}
</Card>
