---
title: Local repositories
---
<script>
  // The git checkouts under a folder on this machine (api domain/local/local-git.ts).
  // A refused call says so rather than drawing an empty list that reads like a
  // folder with no repositories in it.
  import { comparatorFor } from '@frontierjs/toolbelt/query'
  import { ago }  from '../../lib/datetime.js'
  import { git }  from '../../resources/Git.mesa'
  import { workbench } from '../../resources/Workbench.mesa'

  import Badge      from '@frontierjs/ui/components/display/Badge.mesa'
  import Button     from '@frontierjs/ui/components/forms/Button.mesa'
  import Checkbox   from '@frontierjs/ui/components/forms/Checkbox.mesa'
  import Callout    from '@frontierjs/ui/components/display/Callout.mesa'
  import CopyButton from '@frontierjs/ui/components/display/CopyButton.mesa'
  import EmptyState from '@frontierjs/ui/components/display/EmptyState.mesa'
  import Input      from '@frontierjs/ui/components/forms/Input.mesa'
  import Pill       from '@frontierjs/ui/components/display/Pill.mesa'
  import Table      from '@frontierjs/ui/components/display/Table.mesa'

  // The last folder scanned, per viewer — a convenience, so storage that
  // throws or comes back empty only costs retyping it.
  const KEY = 'workbench.localRepos.root'
  const remembered = () => { try { return localStorage.getItem(KEY) } catch { return null } }
  const remember   = (v) => { try { localStorage.setItem(KEY, v) } catch {} }
  const ONLY_KEY = 'workbench.localRepos.frontierOnly'
  const onlyRemembered = () => { try { return localStorage.getItem(ONLY_KEY) === '1' } catch { return false } }
  const rememberOnly   = (on) => { try { localStorage.setItem(ONLY_KEY, on ? '1' : '0') } catch {} }

  const SORT_KEY = 'workbench.localRepos.orderBy'
  const sortRemembered = () => { try { return localStorage.getItem(SORT_KEY) } catch { return null } }
  const rememberSort   = (v) => { try { localStorage.setItem(SORT_KEY, v ?? '') } catch {} }

  let root     = remembered() ?? '~/code'
  let answer   = null
  let error    = null
  let offered  = true
  let scanning = false
  let search   = ''
  let frontierOnly = onlyRemembered()
  // Newest commit first: the checkout last worked on is the one looked for.
  let orderBy  = sortRemembered() || '-lastCommitAt'
  function sortBy(next) { orderBy = next ?? ''; rememberSort(orderBy) }

  // Grid is the pinned checkouts alone, as tiles; list is the whole scan.
  const VIEW_KEY = 'workbench.localRepos.view'
  const viewRemembered = () => { try { return localStorage.getItem(VIEW_KEY) } catch { return null } }
  const rememberView   = (v) => { try { localStorage.setItem(VIEW_KEY, v) } catch {} }
  let view = viewRemembered() === 'grid' ? 'grid' : 'list'
  function showView(next) { view = next; rememberView(next) }

  async function scan(e) {
    e?.preventDefault()
    error = null; scanning = true
    try {
      answer = await git.service.invoke('localRepos', null, { root })
      remember(root)
    } catch (err) {
      // 404 is *not on this machine*; anything else is about the folder.
      if (err.code === 404) offered = false
      error = err.message
      answer = null
    } finally {
      scanning = false
    }
  }

  if (remembered()) scan()

  // Pinned to the workbench, by path. A failure leaves every row unpinned
  // rather than hiding the listing it sits beside.
  let pinned = {}
  let pins   = []
  // Until the first answer, an empty grid would read as nothing pinned.
  let pinsLoaded = false
  async function loadPins() {
    try {
      const answer = await workbench.service.invoke('pins', null)
      pins   = answer.pins
      pinned = Object.fromEntries(answer.pins.map(p => [p.path, p.id]))
      runsOf = Object.fromEntries(answer.pins.map(p => [p.id, p.status?.runs ?? []]))
      loadRunnables(answer.pins)
    } catch {}
    pinsLoaded = true
  }

  // ─── dev and desktop, from a tile ──────────────────────────────────────
  // The Chats screen's Run tab, one row each: the checkout's root app, or
  // its only one. A checkout holding several apps starts from that tab.

  let rowsOf  = {}
  let runsOf  = {}
  let runWait = {}
  async function rowsFor(id) {
    try { return (await workbench.service.invoke('runnables', id)).rows } catch { return rowsOf[id] ?? [] }
  }
  async function loadRunnables(list) {
    const answers = await Promise.all(list.filter(p => !p.missing).map(async p => [p.id, await rowsFor(p.id)]))
    rowsOf = Object.fromEntries(answers)
  }
  // A server started or stopped in a terminal moves nothing here, so coming
  // back to the tab reads again.
  function reread() {
    if (document.visibilityState !== 'visible' || view !== 'grid') return
    loadRunnables(pins); refreshRuns()
  }
  document.addEventListener('visibilitychange', reread)
  $.onDestroy(() => document.removeEventListener('visibilitychange', reread))
  function launcher(id, kind) {
    const rows = (rowsOf[id] ?? []).filter(r => r.kind === kind)
    return rows.find(r => r.dir === '.') ?? (rows.length === 1 ? rows[0] : null)
  }
  /** Started from the workbench and still up: only this one can be stopped here. */
  const runOf = (id, row) => (runsOf[id] ?? []).find(r => r.id === row.id && r.running)
  // web before site; the API is never the page a person opens.
  const pageIn = (ports = []) => ports.find(s => s.label === 'web') ?? ports.find(s => s.label === 'site')
    ?? ports.find(s => s.label !== 'API')
  const pageOf = (id, row) => pageIn(launcher(id, row.kind)?.served)
  const isUp   = (id, row) => row.kind === 'app' ? !!pageOf(id, row) : !!runOf(id, row)

  async function refreshRuns() {
    try {
      const answer = await workbench.service.invoke('status', null)
      runsOf = Object.fromEntries(answer.status.map(s => [s.id, s.runs ?? []]))
    } catch {}
  }

  // The tab opens on the click, since one opened after a wait is a popup the
  // browser blocks; it is pointed at the page once the server answers.
  async function launch(p, row) {
    const up = row.kind === 'app' && pageOf(p.id, row)
    if (up) { window.open(`http://localhost:${up.port}/`, '_blank', 'noopener'); return }
    // Null where the browser blocked it; the button then reads Open dev, and
    // that click is a fresh gesture.
    const tab = row.kind === 'app' ? window.open('about:blank', '_blank') : null
    const key = `${p.id} ${row.id}`
    runWait = { ...runWait, [key]: true }
    error = null
    try {
      if (!runOf(p.id, row)) await workbench.service.invoke('run', p.id, { row: row.id })
      runsOf = { ...runsOf, [p.id]: [...(runsOf[p.id] ?? []).filter(r => r.id !== row.id), { id: row.id, running: true, ports: [] }] }
      if (row.kind === 'app') {
        const page = await servedPage(p.id, row)
        if (page && tab) tab.location.href = `http://localhost:${page.port}/`
        if (!page) { tab?.close(); error = await whyNot(p, row) }
      } else if (!await stillUp(p.id, row)) error = await whyNot(p, row)
    } catch (err) {
      tab?.close()
      error = err.message
    } finally {
      runWait = { ...runWait, [key]: false }
    }
  }

  // A desktop run opens its own window; one refused at startup (no shell
  // built, a port held) ends inside a few seconds.
  async function stillUp(id, row) {
    for (let i = 0; i < 5; i++) {
      await new Promise(done => setTimeout(done, 1000))
      await refreshRuns()
      if (!runOf(id, row)) return false
    }
    return true
  }

  // The port is in fli's lock before vite listens, so it is probed too.
  async function servedPage(id, row) {
    for (let i = 0; i < 60; i++) {
      const [rows] = await Promise.all([rowsFor(id), refreshRuns()])
      rowsOf = { ...rowsOf, [id]: rows }
      const page = pageOf(id, row)
      if (page) {
        try { await fetch(`http://localhost:${page.port}/`, { mode: 'no-cors' }); return page } catch {}
      }
      if (!runOf(id, row)) return null
      await $.sleep(1000)
    }
    return null
  }

  // fli's own refusal names the port and who holds it, which is the fix.
  async function whyNot(p, row) {
    try {
      const out = await workbench.service.invoke('output', p.id, { row: row.id })
      const told = out.lines.slice(1).filter(l => l.trim() && !l.startsWith('— exited')).slice(0, 6).join('\n')
      if (!out.running && told) return `${row.start} in ${p.name} stopped:\n${told}`
    } catch {}
    return `${row.start} in ${p.name} is up but no page answered within a minute — its log is on the Chats screen's Run tab`
  }

  async function halt(p, row) {
    try { await workbench.service.invoke('halt', p.id, { row: row.id }) } catch (err) { error = err.message }
    // fli's lock reads alive until the killed process has exited.
    for (let i = 0; i < 10; i++) {
      const [rows] = await Promise.all([rowsFor(p.id), refreshRuns()])
      rowsOf = { ...rowsOf, [p.id]: rows }
      if (!isUp(p.id, row)) return
      await new Promise(done => setTimeout(done, 500))
    }
  }
  async function togglePin(r) {
    try {
      if (pinned[r.path]) await workbench.service.invoke('unpin', pinned[r.path])
      else await workbench.service.invoke('pin', null, { path: r.path })
      await loadPins()
    } catch (err) { error = err.message }
  }
  loadPins()

  $: repos = (answer?.repos ?? []).filter(r => (!frontierOnly || r.frontier) && (!search
    || r.relative.toLowerCase().includes(search.toLowerCase())
    || (r.remote ?? '').toLowerCase().includes(search.toLowerCase())))
    .sort(comparatorFor(orderBy || null) ?? (() => 0))
  $: frontierCount = (answer?.repos ?? []).filter(r => r.frontier).length
  $: dirty = (answer?.repos ?? []).filter(r => r.changes).length
  $: noRemote = (answer?.repos ?? []).filter(r => !r.remote).length
  // A pin outside the scanned folder still gets a tile, with only its path.
  $: scanned = Object.fromEntries((answer?.repos ?? []).map(r => [r.path, r]))
  $: tiles = pins.map(p => ({ pin: p, repo: scanned[p.path] ?? null }))
  const tilde = (path) => path.replace(/^\/(home|Users)\/[^/]+/, '~')

  // `name` is the record field, so the header's ordering sorts the rows as is.
  const COLUMNS = [
    { name: 'name',         label: 'Repository',   sortable: true },
    { name: 'branch',       label: 'Branch' },
    { name: 'changes',      label: 'Working tree', sortable: true },
    { name: 'remote',       label: 'Remote' },
    { name: 'lastCommitAt', label: 'Last commit',  sortable: true },
  ]
</script>

<div class="section-header">
  <h1>Local repositories</h1>
  <span class="cluster">
    <span class="cluster local-repos-view" role="group" aria-label="View">
      <Button treatment="ghost" size="sm" aria-pressed={view === 'list' ? 'true' : 'false'}
              onclick={() => showView('list')}>List</Button>
      <Button treatment="ghost" size="sm" aria-pressed={view === 'grid' ? 'true' : 'false'}
              onclick={() => showView('grid')}>Grid</Button>
    </span>
    <Button treatment="ghost" href="/workbench/">Workbench</Button>
  </span>
</div>

{#if !offered}
  <Callout tone="muted" title="Not available">
    <p class="text-body">
      This screen reads this machine\'s checkouts and files and cannot reach them right now.
    </p>
    <p class="text-sm text-muted">{error}</p>
  </Callout>
{:else}
  <form class="cluster" id="local-repos-form" onsubmit={scan}>
    <Input label="Folder" name="root" id="root" placeholder="~/code"
           value={root} oninput={(e) => root = e.target.value}
           hint="An absolute path, or one starting ~/. Looks four folders down; node_modules and hidden folders are skipped." />
    <Button type="submit" disabled={scanning}>{scanning ? 'Scanning…' : 'Scan'}</Button>
  </form>

  {#if error}
    <article class="alert danger" id="screen-error">
      <div class="alert-content local-repos-error">{error}</div>
    </article>
  {/if}

  {#if view === 'grid'}
    {#if !pinsLoaded}
      <p class="text-muted">Loading pinned checkouts…</p>
    {:else if !pins.length}
      <EmptyState title="Nothing pinned">
        Star a repository in the list view to pin it to the workbench.
      </EmptyState>
    {:else}
      <div class="local-repos-tiles" id="local-repos-tiles">
        {#each tiles as t (t.pin.id)}
          <article class="card local-repos-tile" title={t.pin.path}>
            <span class="local-repos-tile-head">
              <a class="local-repos-tile-open" href={`/workbench/#workbench-${encodeURIComponent(t.pin.id)}`}><strong>{t.pin.name}</strong></a>
              <Button class="local-repos-tile-unpin" treatment="ghost" size="xs" square
                      aria-label={`Unpin ${t.pin.name} from the workbench`}
                      onclick={() => togglePin(t.pin)}>★</Button>
            </span>
            <code class="text-sm text-muted">{t.repo?.relative ?? tilde(t.pin.path)}</code>
            {#if t.repo}
              <span class="cluster text-sm">
                {#if t.repo.branch}<code>{t.repo.branch}</code>{:else}<Pill tone="warning">detached</Pill>{/if}
                {#if t.repo.changes}<Pill tone="warning">{t.repo.changes} changed</Pill>{:else}<Pill tone="success">clean</Pill>{/if}
                {#if t.repo.ahead}<Pill tone="info">↑{t.repo.ahead}</Pill>{/if}
                {#if t.repo.behind}<Pill tone="info">↓{t.repo.behind}</Pill>{/if}
              </span>
              <span class="text-sm text-muted">{t.repo.lastCommitAt ? ago(t.repo.lastCommitAt) : 'no commits'}</span>
            {/if}
            {#if launcher(t.pin.id, 'app') || launcher(t.pin.id, 'desktop')}
              <span class="local-repos-tile-run" role="group" aria-label={`Run ${t.pin.name}`}>
                {#each [launcher(t.pin.id, 'app'), launcher(t.pin.id, 'desktop')].filter(Boolean) as row (row.id)}
                  <Button size="xs" treatment="outlined" tone={isUp(t.pin.id, row) ? 'success' : undefined}
                          disabled={runWait[`${t.pin.id} ${row.id}`] || (row.kind === 'desktop' && isUp(t.pin.id, row))}
                          title={isUp(t.pin.id, row) && row.kind === 'app' ? `localhost:${pageOf(t.pin.id, row).port}` : row.start}
                          onclick={() => launch(t.pin, row)}>
                    {runWait[`${t.pin.id} ${row.id}`] ? 'Starting…'
                      : row.kind === 'app' ? (isUp(t.pin.id, row) ? 'Open dev ↗' : '▶ Dev')
                      : (isUp(t.pin.id, row) ? 'Desktop open' : '▶ Desktop')}
                  </Button>
                  {#if runOf(t.pin.id, row)}
                    <Button size="xs" treatment="outlined" tone="danger" square
                            aria-label={`Stop ${row.start} in ${t.pin.name}`}
                            onclick={() => halt(t.pin, row)}>■</Button>
                  {/if}
                {/each}
              </span>
            {/if}
          </article>
        {/each}
      </div>
    {/if}
  {:else if answer}
    {#if !answer.repos.length}
      <EmptyState title="No repositories">
        Nothing under <code>{answer.root}</code> holds a <code>.git</code> within four folders.
      </EmptyState>
    {:else}
      <div class="cluster" id="local-repos-totals">
        <Badge tone="muted">{answer.repos.length} repositories</Badge>
        {#if dirty}<Badge tone="warning">{dirty} with uncommitted work</Badge>{/if}
        {#if noRemote}<Badge tone="muted">{noRemote} with no remote</Badge>{/if}
        <Badge tone="info">{frontierCount} FrontierJS</Badge>
        {#if answer.truncated}<Badge tone="danger">stopped at {answer.repos.length} — narrow the folder</Badge>{/if}
      </div>

      <div class="cluster">
        <label class="visually-hidden" for="local-repos-search">Filter repositories</label>
        <Input id="local-repos-search" placeholder="Filter by path or remote…" value={search}
               oninput={(e) => search = e.target.value} />
        <Checkbox id="local-repos-frontier-only" label="FrontierJS apps only"
                  description="A frontier.config.js at the repository root"
                  checked={frontierOnly} onchange={(on) => { frontierOnly = on; rememberOnly(on) }} />
      </div>

      <div id="local-repos-list">
        <Table columns={COLUMNS} rows={repos} striped emptyText="Nothing matches the filter"
               orderBy={orderBy} onsort={sortBy}>
          {#snippet row(r)}
            <tr>
              <td>
                <Button treatment="ghost" size="xs" square
                        aria-label={pinned[r.path] ? `Unpin ${r.name} from the workbench` : `Pin ${r.name} to the workbench`}
                        aria-pressed={pinned[r.path] ? 'true' : 'false'}
                        onclick={() => togglePin(r)}>{pinned[r.path] ? '★' : '☆'}</Button>
                <strong>{r.name}</strong>
                {#if r.frontier}<Pill tone="info">FrontierJS</Pill>{/if}
                <div class="text-sm text-muted"><code>{r.relative}</code></div>
              </td>
              <td class="text-sm">
                {#if r.branch}<code>{r.branch}</code>{:else}<Pill tone="warning">detached</Pill>{/if}
                {#if r.head}<span class="text-muted"> · <code>{r.head}</code></span>{/if}
              </td>
              <td class="text-sm">
                {#if r.changes}<Pill tone="warning">{r.changes} changed</Pill>{:else}<Pill tone="success">clean</Pill>{/if}
                {#if r.ahead}<Pill tone="info">↑{r.ahead}</Pill>{/if}
                {#if r.behind}<Pill tone="info">↓{r.behind}</Pill>{/if}
                {#if r.branch && !r.upstream}<span class="text-muted"> no upstream</span>{/if}
              </td>
              <td class="text-sm">
                {#if r.remote}
                  <code>{r.remote}</code> <CopyButton text={r.remote} />
                {:else}
                  <span class="text-muted">—</span>
                {/if}
              </td>
              <td class="text-sm text-muted">
                {#if r.lastCommitAt}{ago(r.lastCommitAt)} · {r.lastCommit}{:else}no commits{/if}
              </td>
            </tr>
          {/snippet}
        </Table>
      </div>
    {/if}
  {/if}
{/if}

<style>
  .local-repos-view { gap: 0; }
  .local-repos-error { white-space: pre-line; }
  .local-repos-tiles {
    --local-repos-tile-min: 14rem;
    display:               grid;
    grid-template-columns: repeat(auto-fill, minmax(var(--local-repos-tile-min), 1fr));
    gap:                   var(--space-md);
  }
  .local-repos-tile {
    display:        flex;
    flex-direction: column;
    gap:            var(--space-2xs);
    padding:        var(--space-md);
    min-width:      0;
  }
  .local-repos-tile code { overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }
  /* The name's link covers the tile so the whole card opens the chat; the
     unpin button sits above it, since a button inside a link is invalid. */
  .local-repos-tile { position: relative; }
  .local-repos-tile-head { display: flex; align-items: center; justify-content: space-between; gap: var(--space-xs); }
  .local-repos-tile-open { color: inherit; text-decoration: none; min-width: 0; }
  .local-repos-tile-open::after { content: ''; position: absolute; inset: 0; border-radius: inherit; }
  .local-repos-tile:hover { border-color: var(--color-primary); }
  .local-repos-tile-run {
    display: flex; flex-wrap: wrap; justify-content: flex-end; gap: var(--space-2xs);
    margin-block-start: auto; position: relative; z-index: 1;
  }
  .local-repos-tile :global(.local-repos-tile-unpin) { position: relative; z-index: 1; margin-block: calc(-1 * var(--space-2xs)); }
</style>
