---
title: New Basecamp
---
<script>
  // A form over `fli basecamp:create --yes`, run in the API as a child whose
  // log this page tails (api services/basecamps, `provision` and `creation`).
  // Buying and installing a box takes minutes and outlives this page, so a run
  // already going is picked up on load and the page polls until it exits.
  //
  // The command is confirmed by a person each run. The confirm below is that
  // yes, and `approved: true` goes with it; the owner's first real purchase
  // from here is the proof, and Plan only (--dry) is the rehearsal.
  import { basecamps } from '../../../resources/Basecamp.mesa'

  import Button              from '@frontierjs/ui/components/forms/Button.mesa'
  import Checkbox            from '@frontierjs/ui/components/forms/Checkbox.mesa'
  import Input               from '@frontierjs/ui/components/forms/Input.mesa'
  import Select              from '@frontierjs/ui/components/forms/Select.mesa'
  import Steps               from '@frontierjs/ui/components/display/Steps.mesa'
  import Spinner             from '@frontierjs/ui/components/feedback/Spinner.mesa'
  import ConfirmationPopover from '@frontierjs/ui/components/overlay/ConfirmationPopover.mesa'
  import { toasts }          from '@frontierjs/ui/stores/toastStore'

  const POLL = 2000

  // The kinds `CLOUDS` names in packages/cli/core/cloud.js.
  const CLOUDS = [
    { value: '',             label: 'Whichever token is stored' },
    { value: 'hetzner',      label: 'Hetzner' },
    { value: 'digitalocean', label: 'DigitalOcean' },
  ]

  let domain     = ''
  let name       = ''
  let cloud      = ''
  let size       = '4gb'
  let region     = ''
  let admin      = ''
  let reservedIp = true
  let backups    = true
  let outpost    = true
  let dry        = false

  let starting  = false
  let run       = null   // the API's held create run: its stages and the end of its log
  let again     = false  // the form opened again under a finished run, for the next one
  let now       = Date.now()

  const firstLabel = () => domain.trim().split('.')[0]
  const boxName    = () => name.trim() || firstLabel()
  const running    = () => !!run && !run.exit && !run.error
  const ready      = () => !!domain.trim() && !!boxName() && !starting && !running()
  const formShown  = () => !run || (again && !running())
  const isDry      = () => !!run && run.argv.includes('--dry')
  const failed     = () => !!run && (!!run.error || (!!run.exit && run.exit.code !== 0))
  const argOf      = (flag) => { const i = run.argv.indexOf(flag); return i < 0 ? '' : run.argv[i + 1] }

  const clock = (ms) => {
    const s = Math.max(0, Math.floor(ms / 1000))
    return `${Math.floor(s / 60)}:${String(s % 60).padStart(2, '0')}`
  }
  const elapsed = () => clock((run.exit ? Date.parse(run.endedAt ?? '') || now : now) - Date.parse(run.startedAt))

  async function poll() {
    try {
      run = await basecamps.service.invoke('creation', null)
      now = Date.now()
    } catch (err) {
      toasts.error(err.message)
    }
  }

  $.every(POLL, poll, { when: running() })

  async function start() {
    starting = true
    try {
      await basecamps.service.invoke('provision', null, {
        domain, name: boxName(), cloud, size, region, admin, reservedIp, backups, outpost, dry, approved: true,
      })
      again = false
      run = await basecamps.service.invoke('creation', null)
      now = Date.now()
    } catch (err) {
      toasts.error(err.message)
    } finally {
      starting = false
    }
  }

  // The stages the run has reached, read off its log by the API, then one row
  // for those still ahead: the cli names a stage only as it opens, so the ones
  // after it are a count. Before the first, the cli is checking the token and
  // the hostname's zone, and that is a step of its own here.
  const steps = () => {
    const seen = run.steps ?? []
    const of   = seen[0]?.of ?? 0
    const rows = [{ id: 'check', label: 'check', description: 'the cloud token and the hostname\'s DNS zone' }]
      .concat(seen.map(s => ({ id: `s${s.n}`, label: s.name, description: s.what })))
    if (of > seen.length) rows.push({ id: 'rest', label: `${of - seen.length} more`, description: 'named as each one starts' })
    if (run.exit?.code === 0) rows.push({ id: 'done', label: 'done', description: `Basecamp is on ${run.name}` })
    return rows
  }
  const current = () => {
    if (run.exit?.code === 0) return 'done'
    const seen = run.steps ?? []
    return seen.length ? `s${seen[seen.length - 1].n}` : 'check'
  }

  const verdict = () => {
    if (!run || running()) return null
    if (run.error) return { tone: 'text-danger', text: `Could not start: ${run.error}` }
    if (run.exit.code === 0) return { tone: 'text-success', text: isDry() ? 'The plan ran. Nothing was bought.' : `Done in ${elapsed()}.` }
    return { tone: 'text-danger', text: `Exited with ${run.exit.code ?? run.exit.signal}. The log below says why.` }
  }

  poll()
</script>

<div class="section-header">
  <h1>New Basecamp</h1>
  <span class="cluster">
    <a href="/basecamps/">Back to Basecamps</a>
  </span>
</div>

{#if (run, again, formShown())}
  <form class="stack" id="basecamps-new" onsubmit={(e) => e.preventDefault()}>
    <div class="grid" style="--grid-min: 14rem; gap: var(--space-md)">
      <Input id="new-domain" label="Domain" placeholder="ops.example.com" bind:value={domain} />
      <Input id="new-name" label="Name" placeholder={(domain, firstLabel()) || 'ops'} bind:value={name} />
    </div>
    <div class="grid" style="--grid-min: 9rem; gap: var(--space-md)">
      <Select id="new-cloud" label="Cloud" placeholder="" options={CLOUDS} bind:value={cloud} />
      <Input id="new-size" label="Size" placeholder="4gb" bind:value={size} />
      <Input id="new-region" label="Region" placeholder="US default" bind:value={region} />
    </div>
    <Input id="new-admin" label="Admin email" type="email" placeholder="blank buys the box and installs nothing" bind:value={admin} />
    <div class="cluster" style="gap: var(--space-xl)">
      <Checkbox id="new-reserved-ip" label="Reserved IP" checked={reservedIp} onchange={(v) => { reservedIp = v }}
        title="An address held apart from the box, so a replacement keeps it. Billed by the cloud." />
      <Checkbox id="new-backups" label="Cloud backups" checked={backups} onchange={(v) => { backups = v }}
        title="The cloud's daily backups of the whole box, billed as a share of its price." />
      <Checkbox id="new-outpost" label="Join Outpost" checked={outpost} onchange={(v) => { outpost = v }}
        title="Enroll the box in Basecamp's own fleet, so apps can run beside it." />
      <Checkbox id="new-dry" label="Plan only" checked={dry} onchange={(v) => { dry = v }}
        title="Print what a run would do and buy nothing (--dry)." />
    </div>

    <div class="cluster" style="justify-content: space-between">
      <p id="new-billing" class="text-sm text-muted">
        Billed from the moment it is bought. Undo: <code>fli server:destroy {(domain, name, boxName()) || 'NAME'}</code>
      </p>
      <ConfirmationPopover title={dry ? `Plan ${(domain, name, boxName())}?` : `Buy and install ${(domain, name, boxName())}?`}
        message={dry ? 'Nothing is bought.' : 'The cloud bills this box from now. Undo it with fli server:destroy from a terminal.'}
        confirmLabel={dry ? 'Plan' : 'Buy the box'} tone={dry ? 'primary' : 'danger'} onconfirm={start}>
        {#snippet trigger()}
          <Button id="new-start" disabled={(domain, name, starting, run, !ready())} loading={starting}>{dry ? 'Plan a Basecamp' : 'Create the Basecamp'}</Button>
        {/snippet}
      </ConfirmationPopover>
    </div>
  </form>
{/if}

{#if run}
  <section class="stack" id="new-run">
    <div class="cluster" style="justify-content: space-between">
      <div>
        <h2 class="h5">{run.name}</h2>
        <div class="text-sm text-muted">{(run, argOf('--domain'))}{(run, isDry()) ? ' · plan only' : ''} · {(run, now, elapsed())}</div>
      </div>
      {#if (run, again, !running() && !again)}
        <Button id="new-again" treatment="outlined" onclick={() => { again = true }}>Create another</Button>
      {/if}
    </div>

    {#if (run, isDry())}
      <div class="text-sm text-muted">A plan buys nothing and has no stages; it prints what a run would do.</div>
    {:else}
      <Steps id="new-steps" orientation="vertical" label="Create stages" steps={(run, steps())} currentStep={(run, current())}>
        {#snippet marker(step, status)}
          {#if status === 'active' && (run, running())}
            <Spinner size="xs" label={step.label} />
          {:else if status === 'active' && (run, failed())}
            <span aria-label="failed">✕</span>
          {:else if status === 'complete' || step.id === 'done'}
            <span aria-hidden="true">✓</span>
          {:else}
            <span aria-hidden="true">·</span>
          {/if}
        {/snippet}
      </Steps>
    {/if}

    {#if (run, verdict())}
      <div class={`text-sm ${verdict().tone}`} data-verdict>{verdict().text}</div>
    {/if}

    <details id="new-details" open={(run, failed() || isDry())}>
      <summary class="text-sm text-muted">Full log</summary>
      <div class="text-sm text-muted">{run.argv.join(' ')}{(run, running()) ? ` · pid ${run.pid}` : ''}</div>
      <pre id="new-log" class="text-sm">{run.lines.join('\n') || ((run.exit, run.error, running()) ? 'Started, no output yet…' : '')}</pre>
    </details>
  </section>
{/if}
