---
title: Basecamps
---
<script>
  // Every Basecamp in this laptop's basecamps.json, whether it answers, and
  // the newest backup it holds — with Back up now (Basecamp's own backup,
  // over its API) and Restart (its API container, over ssh) on each.
  //
  // A verb runs in the API and its outcome is held there (api
  // services/basecamps), so this page polls `outcome` while one is working
  // and reads the list again once it settles; leaving the page does not stop
  // a backup or a restart.
  //
  // Set up B2 backups and Undo B2 backups each ask first, in a dialog that
  // lists what the API's plan says it would make or keep (names only; the B2
  // key stays in the API). The run sends `approved: true` on the Run press.
  //
  // Under each entry sit the backups already pulled to this laptop, with Delete
  // on each. The page sends the entry's name and the copy's folder name and
  // never a path; the API resolves what to remove. Download adds the newest
  // archive Basecamp holds to them; Save .tar.gz asks the API for Basecamp's
  // one-use link to it and navigates there, so the admin key stays in the API.
  //
  // Key copy reads each box's ENCRYPTION_KEY over ssh in the API and answers
  // fingerprints only; it is read on load and on Refresh, not on each poll.
  //
  // basecamps.json is keyed by key, not by box, so a second admin key for a
  // Basecamp another entry already reaches is a second entry at the same url.
  // One row per url: the entry whose ssh Host exists acts for it, and the
  // others are named under it; their pulled copies are the same box's.
  import { basecamps } from '../../resources/Basecamp.mesa'
  import { ago, at }   from '../../lib/datetime.js'
  import { bytes }     from '../../lib/bytes.js'

  import Button              from '@frontierjs/ui/components/forms/Button.mesa'
  import Dot                 from '@frontierjs/ui/components/display/Dot.mesa'
  import EmptyState          from '@frontierjs/ui/components/display/EmptyState.mesa'
  import Table               from '@frontierjs/ui/components/display/Table.mesa'
  import Checkbox            from '@frontierjs/ui/components/forms/Checkbox.mesa'
  import ConfirmationPopover from '@frontierjs/ui/components/overlay/ConfirmationPopover.mesa'
  import Modal               from '@frontierjs/ui/components/overlay/Modal.mesa'
  import { toasts }          from '@frontierjs/ui/stores/toastStore'

  const POLL = 2000

  let rows      = []
  let loading   = true
  let error     = null
  let pressed   = {}     // name → the verb whose request is in flight

  const working = () => rows.filter(r => r.outcome?.state === 'working')

  let keys = {}        // name → KeyCopy, { error }, or 'reading'

  const keyed = (r) => r.hostKnown && r.hasKey && r.answers.ok

  function grouped(list) {
    const byUrl = new Map()
    for (const r of list) byUrl.set(r.url, [...(byUrl.get(r.url) ?? []), r])
    return [...byUrl.values()].map(same => {
      const lead = same.find(r => r.hostKnown) ?? same.find(r => r.host) ?? same[0]
      return { ...lead, also: same.filter(r => r !== lead), local: same.flatMap(r => r.local.map(c => ({ ...c, entry: r.name }))) }
    })
  }

  async function readKey(r) {
    keys = { ...keys, [r.name]: 'reading' }
    try {
      keys = { ...keys, [r.name]: await basecamps.service.invoke('keyCopy', r.name) }
    } catch (err) {
      keys = { ...keys, [r.name]: { error: err.message } }
    }
  }

  async function refresh() {
    await load()
    for (const r of grouped(rows).filter(keyed)) readKey(r)
  }

  async function saveKey(r) {
    pressed = { ...pressed, [r.name]: 'saveKey' }
    try {
      const out = await basecamps.service.invoke('saveKey', r.name)
      const kept = `Key ${out.kept} ${out.already ? 'was already filed' : 'filed'} on this laptop`
      if (out.attested) toasts.success(`${kept} and attested to ${r.name}`)
      else toasts.warning(`${kept}, not attested: ${out.why}`)
      readKey(r)
    } catch (err) {
      toasts.error(err.message)
    } finally {
      pressed = { ...pressed, [r.name]: null }
    }
  }

  async function saveArchive(r) {
    pressed = { ...pressed, [r.name]: 'archiveLink' }
    try {
      const link = await basecamps.service.invoke('archiveLink', r.name)
      if (link.sha256) toasts.info(`${link.name} — sha256 ${link.sha256}`)
      location.assign(link.url)
    } catch (err) {
      toasts.error(err.message)
    } finally {
      pressed = { ...pressed, [r.name]: null }
    }
  }

  const KEY_SAID = {
    matches: 'matches the box',
    missing: 'none on this laptop',
    differs: 'this laptop holds another key',
    none:    'the box keeps none',
  }

  function keyLine(k) {
    if (k === 'reading') return 'reading over ssh…'
    if (k.error)         return k.error
    const parts = [`${KEY_SAID[k.state]}${k.box ? ` (${k.box})` : ''}`]
    if (k.attested) parts.push(k.attested === k.box ? 'attested to Basecamp' : `Basecamp's attestation names ${k.attested}`)
    else if (k.box) parts.push('not attested to Basecamp')
    return parts.join(' · ')
  }

  const keyTone = (k) => k === 'reading' ? 'text-muted' : k.error || k.state === 'differs' ? 'text-danger' : k.state === 'matches' && k.attested === k.box ? 'text-success' : 'text-warning'

  async function load() {
    try {
      rows  = await basecamps.service.invoke('list')
      error = null
    } catch (err) {
      error = err.message
    } finally {
      loading = false
    }
  }

  const withOutcome = (name, outcome) => rows.map(r => r.name === name ? { ...r, outcome } : r)

  async function poll() {
    let settled = false
    for (const r of working()) {
      try {
        const outcome = await basecamps.service.invoke('outcome', r.name)
        if (outcome?.state !== 'working') settled = true
        rows = withOutcome(r.name, outcome)
      } catch {}
    }
    if (settled) load()
  }

  $.every(POLL, poll, { when: working().length > 0 })

  async function run(r, verb, data = {}) {
    pressed = { ...pressed, [r.name]: verb }
    try {
      rows = withOutcome(r.name, await basecamps.service.invoke(verb, r.name, data))
    } catch (err) {
      toasts.error(err.message)
    } finally {
      pressed = { ...pressed, [r.name]: null }
    }
  }

  const copyKey = (c) => `${c.entry}/${c.file}`
  const copiesBytes = (r) => r.local.reduce((n, c) => n + c.bytes, 0)

  async function deleteCopy(c) {
    const key = copyKey(c)
    pressed = { ...pressed, [key]: 'delete' }
    try {
      const out = await basecamps.service.invoke('deleteLocal', null, { name: c.entry, file: c.file })
      toasts.success(`Deleted ${c.file}: freed ${bytes(out.freed)}`)
      // The list pings every Basecamp; the copy is gone, so the row is patched instead of read again.
      rows = rows.map(x => x.name === c.entry ? { ...x, local: x.local.filter(y => y.file !== c.file) } : x)
    } catch (err) {
      toasts.error(err.message)
    } finally {
      pressed = { ...pressed, [key]: null }
    }
  }

  // The B2 dialog: which entry, which verb, and the plan the API read for it.
  let dialog = null    // { r, kind: 'setup' | 'undo', plan, error, picked: { [slug]: true } }
  let dialogOpen = false

  async function ask(r, kind) {
    const mine = { r, kind, plan: null, error: null, picked: {} }
    dialog = mine
    dialogOpen = true
    try {
      const plan = await basecamps.service.invoke('backupsPlan', r.name)
      if (dialog === mine) dialog = { ...mine, plan }
    } catch (err) {
      if (dialog === mine) dialog = { ...mine, error: err.message }
    }
  }

  const pick = (slug, on) => { dialog = { ...dialog, picked: { ...dialog.picked, [slug]: on } } }

  function confirmB2() {
    const { r, kind, picked } = dialog
    dialogOpen = false
    if (kind === 'undo') return run(r, 'undoB2', { approved: true })
    return run(r, 'setUpB2', { approved: true, apps: Object.keys(picked).filter(k => picked[k]) })
  }

  const filed = (plan) => plan.destinations.filter(d => d.filed)
  const canRun = (d) => !!d.plan && !d.plan.blocked.length && (d.kind === 'setup' || filed(d.plan).length > 0)

  const VERB  = { backup: 'Backing up', restart: 'Restarting', b2: 'Setting up B2 backups', 'b2-undo': 'Undoing B2 backups', download: 'Downloading the newest archive' }
  const LABEL = { backup: 'Back up', restart: 'Restart', b2: 'Set up B2 backups', 'b2-undo': 'Undo B2 backups', download: 'Download' }

  // A path starts with a slash; an object key under the destination's prefix does not.
  const whereIs = (b) => !b.location || String(b.location).startsWith('/') ? 'on the box only' : 'in B2'

  function probeSaid(probe) {
    if (!probe || typeof probe !== 'object') return 'the probe answered'
    const parts = []
    if ('users' in probe)      parts.push(`${probe.users} users`)
    if ('workspaces' in probe) parts.push(`${probe.workspaces} workspaces`)
    if (probe.needs_setup)     parts.push('waiting for /setup')
    return parts.length ? `the probe answered ${parts.join(', ')}` : `the probe answered ${JSON.stringify(probe)}`
  }

  function outcomeLine(o) {
    if (o.state === 'working') return `${VERB[o.verb]} — started ${ago(o.startedAt)}`
    if (o.state === 'error')   return `${LABEL[o.verb]} failed after ${o.seconds ?? 0} s: ${o.error}`
    if (o.verb === 'b2')       return `Set up B2 backups in ${o.seconds} s`
    if (o.verb === 'b2-undo')  return `Undid B2 backups in ${o.seconds} s — ${o.note}`
    if (o.verb === 'download') return o.note ? `Nothing to download — ${o.note}` : `Downloaded the archive of ${at(o.row?.finishedAt ?? o.row?.createdAt)} in ${o.seconds} s — under Local copies, checked against its manifest`
    if (o.verb === 'backup')   return `Backed up in ${o.seconds} s — Basecamp recorded ${o.row?.id} (${o.row?.status}) at ${at(o.row?.finishedAt ?? o.row?.createdAt)}${o.note ? `. ${o.note}` : ''}`
    return `Restarted in ${o.seconds} s — ${probeSaid(o.probe)}`
  }

  // Every row carries the same buttons in the same places; one that does not apply is disabled with its reason as the title.
  const busy     = (r) => r.outcome?.state === 'working' || !!pressed[r.name]
  const archived = (r) => r.hasKey && r.newestBackup?.status === 'success'
  const setUp    = (r) => r.hostKnown || r.name === 'dev'
  const sshLine  = (r) => !r.host ? 'no ssh Host' : r.hostKnown ? `ssh ${r.host}` : `ssh ${r.host} — no such Host in ~/.ssh/config`
  const noSsh    = (r) => r.host ? `needs Host ${r.host} in ~/.ssh/config` : 'needs an ssh Host'

  const toneOf = (o) => o.state === 'error' ? 'text-danger' : o.state === 'done' ? 'text-success' : ''

  const COLUMNS = [
    { name: 'name',    label: 'Basecamp' },
    { name: 'backup',  label: 'Newest backup' },
    { name: 'actions', label: '' },
  ]

  refresh()
</script>

<div class="section-header">
  <h1>Basecamps</h1>
  <span class="cluster">
    <Button treatment="outlined" id="basecamps-refresh" onclick={refresh}>Refresh</Button>
    <Button id="basecamps-new" href="/basecamps/new/">New Basecamp</Button>
  </span>
</div>

{#if error}
  <article class="alert danger">
    <div class="alert-content">{error}</div>
  </article>
{/if}

{#if loading && !rows.length}
  <p class="text-sm text-muted">Loading…</p>
{:else if !rows.length}
  <EmptyState title="No Basecamps">
    basecamps.json lists none. fli basecamp:create makes one and adds it.
  </EmptyState>
{:else}
  <Table id="basecamps-rows" columns={COLUMNS} rows={grouped(rows)}>
    {#snippet row(r)}
      <tr data-basecamp={r.name}>
        <td>
          <span class="cluster">
            <Dot tone={r.answers.ok ? 'success' : 'danger'} label={r.answers.ok ? 'answers' : 'does not answer'} />
            <strong>{r.name}</strong>
            {#if r.runs}<span class="text-sm text-muted">runs</span>{/if}
          </span>
          <div class="text-sm text-muted"><a href={r.url} target="_blank" rel="noopener noreferrer">{r.url}</a></div>
          <div class={`text-sm ${r.host && !r.hostKnown ? 'text-warning' : 'text-muted'}`}>{sshLine(r)}</div>
          {#if r.also.length}
            <div class="text-sm text-muted" data-also={r.name}>also filed as {r.also.map(a => a.runs ? `${a.name} (runs)` : a.name).join(', ')} — another key for this Basecamp</div>
          {/if}
          <div class="text-sm text-muted">{r.answers.ok ? `answers in ${r.answers.ms} ms` : `does not answer: ${r.answers.why}`}</div>
          {#if r.outcome}
            <div class={`text-sm ${toneOf(r.outcome)}`} data-outcome={r.outcome.state}>{outcomeLine(r.outcome)}</div>
            {#if r.outcome.lines?.length}
              <ul class="text-sm text-muted" data-lines={r.name}>
                {#each r.outcome.lines as line, i (i)}<li>{line}</li>{/each}
              </ul>
            {/if}
          {/if}
          <div class="text-sm" data-local={r.name}>
            {#if r.local.length}
              <details>
                <summary>Local copies — {r.local.length}, {bytes(copiesBytes(r))}</summary>
                <ul class="stack-sm">
                  {#each r.local as c (copyKey(c))}
                    <li class="cluster" data-copy={c.file}>
                      {#if r.also.length}<span class="text-muted">{c.entry}</span>{/if}
                      <span title={c.file}>{at(c.takenAt ?? c.mtime)}</span>
                      <span class="text-muted">{c.kind === 'raw' ? 'raw copy' : c.kind === 'unreadable' ? 'incomplete' : 'archive'}</span>
                      <span>{bytes(c.bytes)}</span>
                      <ConfirmationPopover inline title={`Delete ${bytes(c.bytes)}?`} confirmLabel="Yes" cancelLabel="No" onconfirm={() => deleteCopy(c)}>
                        {#snippet trigger()}
                          <Button size="sm" treatment="outlined" tone="danger" loading={pressed[copyKey(c)] === 'delete'}>Delete</Button>
                        {/snippet}
                      </ConfirmationPopover>
                    </li>
                  {/each}
                </ul>
              </details>
            {:else}
              <span class="text-muted">Local copies — none on this laptop</span>
            {/if}
          </div>
          {#if keys[r.name]}
            <div class="text-sm cluster" data-key={r.name}>
              <span class={keyTone(keys[r.name])}>Key copy — {keyLine(keys[r.name])}</span>
              {#if keys[r.name] !== 'reading' && !keys[r.name].error && keys[r.name].box && (keys[r.name].state !== 'matches' || keys[r.name].attested !== keys[r.name].box)}
                <Button size="sm" treatment="outlined"
                  disabled={!!pressed[r.name]}
                  loading={pressed[r.name] === 'saveKey'}
                  title="Copy the box's ENCRYPTION_KEY to this laptop over ssh, then attest it to Basecamp"
                  onclick={() => saveKey(r)}>Save key</Button>
              {/if}
            </div>
          {/if}
        </td>
        <td class="text-sm">
          {#if r.newestBackup}
            <span title={at(r.newestBackup.createdAt)}>{ago(r.newestBackup.createdAt)}</span>
            <div class="text-muted">{r.newestBackup.status}</div>
            {#if r.newestBackup.status === 'success'}
              <div class="text-muted" data-where={r.name}>{whereIs(r.newestBackup)}</div>
            {/if}
          {:else if r.backupError}
            <span class="text-danger">{r.backupError}</span>
          {:else if !r.hasKey}
            <span class="text-muted">no API key</span>
          {:else}
            <span class="text-muted">{r.answers.ok ? 'none yet' : '—'}</span>
          {/if}
        </td>
        <td>
          <div class="actions">
            <Button size="sm" treatment="outlined"
              disabled={!r.hasKey || busy(r)}
              loading={pressed[r.name] === 'backup'}
              title={r.hasKey ? 'Take Basecamp\'s own backup now' : 'needs an API key: fli basecamp:key'}
              onclick={() => run(r, 'backup')}>Back up now</Button>
            <Button size="sm" treatment="outlined"
              disabled={!archived(r) || busy(r)}
              loading={pressed[r.name] === 'download'}
              title={archived(r) ? 'Fetch the newest archive into Local copies, unpacked and checked; takes no backup' : 'no backup that succeeded to fetch'}
              onclick={() => run(r, 'download')}>Download</Button>
            <Button size="sm" treatment="outlined"
              disabled={!archived(r) || !!pressed[r.name]}
              loading={pressed[r.name] === 'archiveLink'}
              title={archived(r) ? 'Save the newest archive\'s .tar.gz through this browser' : 'no backup that succeeded to save'}
              onclick={() => saveArchive(r)}>Save .tar.gz</Button>

            <Button size="sm" treatment="outlined"
              disabled={!setUp(r) || busy(r)}
              loading={pressed[r.name] === 'setUpB2'}
              title={setUp(r) ? 'Make this Basecamp\'s B2 buckets and keys and point its backups at them' : noSsh(r)}
              onclick={() => ask(r, 'setup')}>Set up B2</Button>
            <Button size="sm" treatment="outlined"
              disabled={!setUp(r) || busy(r)}
              loading={pressed[r.name] === 'undoB2'}
              title={setUp(r) ? 'Take the B2 destinations off and delete their keys; the buckets stay' : noSsh(r)}
              onclick={() => ask(r, 'undo')}>Undo B2</Button>
            {#if r.hostKnown}
              <ConfirmationPopover inline title={`Restart ${r.name}?`} confirmLabel="Restart" onconfirm={() => run(r, 'restart')}>
                {#snippet trigger()}
                  <Button size="sm" treatment="outlined" tone="danger"
                    disabled={busy(r)}
                    loading={pressed[r.name] === 'restart'}
                    title="Restart its API container over ssh">Restart</Button>
                {/snippet}
              </ConfirmationPopover>
            {:else}
              <Button size="sm" treatment="outlined" tone="danger" disabled title={noSsh(r)}>Restart</Button>
            {/if}
          </div>
          {#if !r.hasKey}<div class="text-sm text-muted">no API key — fli basecamp:key files one</div>{/if}
        </td>
      </tr>
    {/snippet}
  </Table>
{/if}

<Modal bind:open={dialogOpen} title={dialog ? `${dialog.kind === 'undo' ? 'Undo B2 backups' : 'Set up B2 backups'} on ${dialog.r.name}` : ''} size="lg">
  {#if dialog}
    {#if dialog.error}
      <article class="alert danger"><div class="alert-content">{dialog.error}</div></article>
    {:else if !dialog.plan}
      <p class="text-sm text-muted">Reading {dialog.r.name} and the B2 account…</p>
    {:else if dialog.kind === 'setup'}
      <div class="stack-sm text-sm" data-b2-plan="setup">
        <p>Buckets</p>
        <ul>
          {#each dialog.plan.buckets as b (b.name)}
            <li>
              {b.held ? 'keep' : 'make'} {b.name}
              {#if b.kind === 'archive'}
                — locked {b.held ? (b.lockDays ?? 0) : b.makeLockDays} days, cannot be shortened
              {:else}
                — not locked
              {/if}
            </li>
          {/each}
        </ul>
        <p>Keys and destinations</p>
        <ul>
          {#each dialog.plan.destinations as d (`${d.name}/${d.workspace}`)}
            <li>
              {d.action} {d.name} in {d.workspace}
              {#if d.action === 'make'}— key {d.keyName}, limited to {d.bucket}/{d.prefix}/{/if}
            </li>
          {/each}
        </ul>
        <p>Hub</p>
        <ul>
          {#each dialog.plan.hub as h (h.label)}<li>{h.action} {h.label}</li>{/each}
        </ul>
        <p>Apps without a destination</p>
        {#if dialog.plan.unset.length}
          {#each dialog.plan.unset as a (a.slug)}
            <Checkbox id={`b2-app-${a.slug}`} label={a.slug} checked={!!dialog.picked[a.slug]} onchange={(v) => pick(a.slug, v)} />
          {/each}
        {:else}
          <p class="text-muted">none</p>
        {/if}
        {#if dialog.plan.blocked.length}
          <p class="text-danger">No owner or admin to act as in {dialog.plan.blocked.join(', ')}.</p>
        {/if}
      </div>
    {:else}
      <div class="stack-sm text-sm" data-b2-plan="undo">
        <p>Takes these destinations off the hub and the Apps, removes them and deletes their keys at B2. One that archives are recorded in stays, with its key. The buckets and what is in them stay.</p>
        {#if filed(dialog.plan).length}
          <ul>
            {#each filed(dialog.plan) as d (`${d.name}/${d.workspace}`)}<li>{d.name} in {d.workspace}, key {d.keyName}</li>{/each}
          </ul>
        {:else}
          <p class="text-muted">Nothing to undo: no destination this setup files is on {dialog.r.name}.</p>
        {/if}
      </div>
    {/if}
  {/if}
  {#snippet footer()}
    <Button id="b2-run" tone={dialog?.kind === 'undo' ? 'danger' : 'primary'} disabled={!dialog || !canRun(dialog)} onclick={confirmB2}>{dialog?.kind === 'undo' ? 'Undo' : 'Run'}</Button>
    <Button id="b2-cancel" treatment="ghost" onclick={() => { dialogOpen = false }}>Cancel</Button>
  {/snippet}
</Modal>

<style>
  .actions {
    display: grid;
    grid-template-columns: repeat(3, max-content);
    gap: var(--space-sm);
    align-items: center;
  }
</style>
