---
title: Notifications
---
<script>
  // Everything this person has been told in-app, newest first. The bell in
  // the topbar is the last few unread; this is the whole list, with read ones.
  import NotificationList from '@frontierjs/notifications/resource/NotificationList.mesa'
  import { notifications } from '../../resources/Notification.mesa'
</script>

<div class="section-header">
  <h1>Notifications</h1>
</div>

<NotificationList {notifications}>
  {#snippet empty(only)}
    {only === 'unread'
      ? 'Nothing unread. The morning Autopilot report lands here when it is sent.'
      : 'The morning Autopilot report lands here when it is sent.'}
  {/snippet}
</NotificationList>
