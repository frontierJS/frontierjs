---
title: Charter
---
<script>
  // The Basecamp Charter's runs go to -- the `runs: true` entry in
  // basecamps.json -- and the one control here that touches its box:
  // Reinstall, `fli basecamp:reinstall` under the entry's admin key, never
  // the run key beside it (FJS-D2031). A new box is the New Basecamp page's.
  //
  // The reinstall runs in the API as a child whose log this page tails
  // (api services/basecamps, `reinstall` and `reinstallation`); it outlives
  // the page, so a run already going is picked up on load. It is confirmed by
  // a person each run, and `approved: true` goes only with that yes.
  import { basecamps } from '../../resources/Basecamp.mesa'

  import Button              from '@frontierjs/ui/components/forms/Button.mesa'
  import Checkbox            from '@frontierjs/ui/components/forms/Checkbox.mesa'
  import Select              from '@frontierjs/ui/components/forms/Select.mesa'
  import Dot                 from '@frontierjs/ui/components/display/Dot.mesa'
  import EmptyState          from '@frontierjs/ui/components/display/EmptyState.mesa'
  import ConfirmationPopover from '@frontierjs/ui/components/overlay/ConfirmationPopover.mesa'
  import { toasts }          from '@frontierjs/ui/stores/toastStore'

  const POLL = 2000

  const MODES = [
    { value: 'restore', label: 'Restore — put the backup just taken back' },
    { value: 'fresh',   label: 'Fresh — an empty Basecamp; the run key is dropped' },
  ]

  let entry     = null
  let others    = []
  let loading   = true
  let error     = null
  let mode      = 'restore'
  let plan      = true
  let starting  = false
  let run       = null   // the API's held reinstall run, with the end of its log
  let destroyed = false
  let timer     = null

  $.onDestroy(() => { destroyed = true; clearTimeout(timer) })

  const running = () => !!run && !run.exit && !run.error

  async function load() {
    try {
      const rows = await basecamps.service.invoke('list')
      entry  = rows.find(r => r.runs) ?? null
      others = rows.filter(r => !r.runs).map(r => r.name)
      error  = null
    } catch (err) {
      error = err.message
    } finally {
      loading = false
    }
  }

  function schedule() {
    clearTimeout(timer)
    if (!destroyed && running()) timer = setTimeout(poll, POLL)
  }

  async function poll() {
    try {
      run = await basecamps.service.invoke('reinstallation', null)
    } catch (err) {
      toasts.error(err.message)
    }
    schedule()
  }

  async function start() {
    starting = true
    try {
      await basecamps.service.invoke('reinstall', null, { name: entry.name, mode, plan, approved: true })
      run = await basecamps.service.invoke('reinstallation', null)
      schedule()
    } catch (err) {
      toasts.error(err.message)
    } finally {
      starting = false
    }
  }

  const verdict = () => {
    if (!run || running()) return null
    if (run.error) return { tone: 'text-danger', text: `Could not start: ${run.error}` }
    if (run.exit.code === 0) return { tone: 'text-success', text: run.argv.includes('--plan') ? 'The plan ran. Nothing changed.' : 'Reinstalled.' }
    return { tone: 'text-danger', text: `Exited with ${run.exit.code ?? run.exit.signal}. Read the log above.` }
  }

  const why = () => !entry.host ? 'needs an ssh Host' : !entry.hasKey ? 'needs an admin API key: fli basecamp:key' : ''

  load()
  poll()
</script>

<div class="section-header">
  <h1>Charter</h1>
  <span class="cluster">
    <Button treatment="outlined" id="charter-refresh" onclick={load}>Refresh</Button>
    <Button id="charter-new-box" treatment="outlined" href="/basecamps/new/">New box</Button>
  </span>
</div>

{#if error}
  <article class="alert danger">
    <div class="alert-content">{error}</div>
  </article>
{/if}

{#if loading && !entry}
  <p class="text-sm text-muted">Loading…</p>
{:else if !entry}
  <EmptyState title="No Basecamp runs Charter">
    No entry in basecamps.json is marked runs: true{others.length ? ` — known: ${others.join(', ')}` : ''}.
  </EmptyState>
{:else}
  <section class="stack-sm" id="charter-basecamp" data-basecamp={entry.name}>
    <h2 class="h5 cluster">
      <Dot tone={entry.answers.ok ? 'success' : 'danger'} label={entry.answers.ok ? 'answers' : 'does not answer'} />
      {entry.name}
    </h2>
    <div class="text-sm text-muted">{entry.url}</div>
    <div class="text-sm text-muted">{entry.host ? `ssh ${entry.host}` : 'no ssh Host'}</div>
    <div class="text-sm text-muted">{entry.answers.ok ? `answers in ${entry.answers.ms} ms` : `does not answer: ${entry.answers.why}`}</div>
    <div class="text-sm" data-keys>
      <span class={entry.hasKey ? '' : 'text-danger'}>{entry.hasKey ? 'admin key filed' : 'no admin key'}</span> ·
      <span class={entry.hasScopedKey ? '' : 'text-danger'}>{entry.hasScopedKey ? 'run key filed' : 'no run key — Charter cannot run'}</span>
    </div>
  </section>

  <form class="stack" id="charter-reinstall" onsubmit={(e) => e.preventDefault()}>
    <Select id="reinstall-mode" label="Reinstall" placeholder="" options={MODES} bind:value={mode} />
    <Checkbox id="reinstall-plan" label="Plan only (--plan)" checked={plan} onchange={(v) => { plan = v }}
      description="Read the box and print the run; nothing is backed up or changed." />
    <div class="cluster">
      <ConfirmationPopover title={plan ? `Plan a reinstall of ${(entry, entry.name)}?` : `Reinstall ${(entry, entry.name)}?`}
        message={plan ? 'Nothing changes.' : mode === 'fresh'
          ? 'Basecamp is backed up, retired and installed empty. Every App it held is forgotten and the run key stops working.'
          : 'Basecamp is backed up, retired and installed again from that backup.'}
        confirmLabel={plan ? 'Plan' : 'Reinstall'} tone={plan ? 'primary' : 'danger'} onconfirm={start}>
        {#snippet trigger()}
          <Button id="reinstall-start" tone={plan ? 'primary' : 'danger'}
            disabled={(entry, starting, run, !!why() || starting || running())} loading={starting}
            title={why()}>{plan ? 'Plan the reinstall' : 'Reinstall'}</Button>
        {/snippet}
      </ConfirmationPopover>
      {#if why()}<span class="text-sm text-muted">{why()}</span>{/if}
    </div>
  </form>
{/if}

{#if run}
  <section class="stack-sm" id="reinstall-run">
    <h2 class="h5">{run.name}</h2>
    <div class="text-sm text-muted">{run.argv.join(' ')}</div>
    <pre id="reinstall-log" class="text-sm">{run.lines.join('\n') || ((run.exit, run.error, running()) ? 'Started, no output yet…' : '')}</pre>
    {#if (run.exit, run.error, running())}
      <div class="text-sm text-muted">Running, pid {run.pid}. This page keeps reading the log.</div>
    {/if}
    {#if (run.exit, run.error, verdict())}
      <div class={`text-sm ${verdict().tone}`} data-verdict>{verdict().text}</div>
    {/if}
  </section>
{/if}
