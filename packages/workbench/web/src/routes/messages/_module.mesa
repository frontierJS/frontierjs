<script>
  // routes/messages/_module.mesa -- the Messages frame: the channels on the left,
  // the routed channel on the right, each column scrolling inside itself. Under
  // 960px it is one column: the sidebar with no channel open, the channel with one.
  //
  // The lists (channels, the reader's memberships, the people) are made here once,
  // before any child reads them, and let go of with the screen. A member who has
  // not linked their chat account has no profile to grade a read against, so they
  // get the way to link it and nothing else.
  import { page } from '@frontierjs/sierra/router'
  import { session } from '../../lib/session.js'
  import { openLists } from '../../lib/chat.js'
  import ChatSidebar from '../../components/chat/ChatSidebar.mesa'
  import EmptyState from '@frontierjs/ui/components/display/EmptyState.mesa'
  import Button from '@frontierjs/ui/components/forms/Button.mesa'

  $: (page.route, page.pathname, page.params.id, session.user)

  // Called as a plain statement, not read from a derived const: a derived const
  // is lazy, and nothing in this template reads it, so the lists would never be made.
  const lists = openLists()
  $.onDestroy(() => lists?.destroy())

  // The sidebar's width is the reader's, dragged from its edge and kept per browser.
  // Clamped on read too: a width saved on a wide monitor would swallow a laptop's channel column.
  const WIDTH_KEY = 'workbench.messages.sidebarWidth'
  const DEFAULT_WIDTH = 260
  const MIN_WIDTH = 180
  const MAX_WIDTH = 520
  const clampWidth = (w) => Math.round(Math.min(MAX_WIDTH, Math.max(MIN_WIDTH, w)))
  function savedWidth() {
    try { const w = Number(localStorage.getItem(WIDTH_KEY)); return w ? clampWidth(w) : DEFAULT_WIDTH } catch { return DEFAULT_WIDTH }
  }
  function keepWidth() { try { localStorage.setItem(WIDTH_KEY, String(sideWidth)) } catch {} }

  let sideWidth = savedWidth()
  let resizing = false
  let frame = null

  // The drag follows the window from the press: the pointer leaves a 6px strip at once,
  // and handlers on the strip with setPointerCapture never saw a move in the drive.
  function grab(e) {
    if (e.button !== 0) return
    e.preventDefault()
    resizing = true
    window.addEventListener('pointermove', drag)
    window.addEventListener('pointerup', drop)
    window.addEventListener('pointercancel', drop)
  }
  function drag(e) {
    if (!resizing || !frame) return
    sideWidth = clampWidth(e.clientX - frame.getBoundingClientRect().left)
  }
  function drop() {
    window.removeEventListener('pointermove', drag)
    window.removeEventListener('pointerup', drop)
    window.removeEventListener('pointercancel', drop)
    if (!resizing) return
    resizing = false
    keepWidth()
  }
  $.onDestroy(drop)
  function nudge(e) {
    const step = e.shiftKey ? 40 : 10
    if (e.key === 'ArrowLeft') sideWidth = clampWidth(sideWidth - step)
    else if (e.key === 'ArrowRight') sideWidth = clampWidth(sideWidth + step)
    else if (e.key === 'Home') sideWidth = MIN_WIDTH
    else if (e.key === 'End') sideWidth = MAX_WIDTH
    else return
    e.preventDefault()
    keepWidth()
  }
  function resetWidth() { sideWidth = DEFAULT_WIDTH; keepWidth() }
</script>

{#if lists}
  <div class="chat" bind:this={frame} class:resizing={resizing} style:--chat-side={sideWidth + 'px'} class:has-room={!!page.params.id || page.pathname.startsWith('/messages/threads') || page.pathname.startsWith('/messages/browse') || page.pathname.startsWith('/messages/drafts') || page.pathname.startsWith('/messages/saved') || page.pathname.startsWith('/messages/search') || page.pathname.startsWith('/messages/activity') || page.pathname.startsWith('/messages/scheduled') || page.pathname.startsWith('/messages/groups')} data-messages>
    <ChatSidebar currentId={page.params.id ?? null} onThreads={page.pathname.startsWith('/messages/threads')} onBrowse={page.pathname.startsWith('/messages/browse')} onDrafts={page.pathname.startsWith('/messages/drafts')} onSaved={page.pathname.startsWith('/messages/saved')} onActivity={page.pathname.startsWith('/messages/activity')} onScheduled={page.pathname.startsWith('/messages/scheduled')} onGroups={page.pathname.startsWith('/messages/groups')} />
    <div class="chat-resize" role="separator" aria-orientation="vertical" aria-label="Resize the channel list"
         aria-valuenow={sideWidth} aria-valuemin={MIN_WIDTH} aria-valuemax={MAX_WIDTH} tabindex="0" title="Drag to resize, double-click to reset"
         onpointerdown={grab} onkeydown={nudge} ondblclick={resetWidth} data-chat-resize></div>
    <div class="chat-main">
      <slot />
    </div>
  </div>
{:else}
  <div class="chat-unlinked" data-messages-unlinked>
    <EmptyState title="Messages is not linked">
      Paste your Mattermost personal access token under Services on the Laptop screen to read and write the team's channels from here.
      {#snippet action()}<Button href="/laptop/#services">Open Laptop</Button>{/snippet}
    </EmptyState>
  </div>
{/if}

<style>
  /* The frame fills the screen: it pads and scrolls for every other page, but a chat column scrolls itself. */
  :global(.screen:has(.chat)) { padding: 0; overflow: hidden; }
  :global(.screen-body:has(.chat)) { max-inline-size: none; padding: 0; block-size: 100%; }
  .chat { position: relative; display: grid; grid-template-columns: var(--chat-side, 260px) minmax(0, 1fr); block-size: 100%; min-block-size: 0; }
  .chat.resizing { cursor: col-resize; user-select: none; }
  /* Out of the grid flow so it adds no column: a strip straddling the sidebar's right edge. */
  .chat-resize { position: absolute; inset-block: 0; inset-inline-start: calc(var(--chat-side, 260px) - 3px); inline-size: 6px; cursor: col-resize; z-index: 2; touch-action: none; }
  .chat-resize:hover, .chat-resize:focus-visible, .chat.resizing .chat-resize { background: var(--ring-color); opacity: 0.6; outline: none; }
  .chat-main { display: flex; flex-direction: column; min-block-size: 0; min-inline-size: 0; background: var(--surface); }
  .chat-unlinked { padding: var(--space-2xl); }
  @media (max-width: 960px) {
    .chat { grid-template-columns: 1fr; }
    .chat.has-room > :global(.chat-sidebar) { display: none; }
    .chat-resize { display: none; }
    .chat:not(.has-room) > .chat-main { display: none; }
  }
</style>
