---
title: Browse channels
---
<script>
  // /messages/browse/ -- the team's open channels the reader is not in. The sidebar lists
  // only the channels they are in, so this is where the rest are found. The server is asked
  // live (`chat.browse`) and lands each channel as a row, so Join opens it at once: Join is
  // the reader's own `channelMembers.create`, and the sidebar takes the channel from the
  // membership that lands.
  import { goto } from '@frontierjs/sierra/router'
  import { browseChannels, joinChannel, whenListed } from '../../../lib/chat.js'
  import EmptyState from '@frontierjs/ui/components/display/EmptyState.mesa'
  import Alert      from '@frontierjs/ui/components/feedback/Alert.mesa'

  let list    = []
  let loading = true
  let error   = null
  let joining = null

  $.onMount(async () => {
    try { list = await browseChannels() } catch (e) { error = e.message } finally { loading = false }
  })

  async function join(c) {
    if (joining) return
    joining = c.externalId; error = null
    try {
      await joinChannel(c.externalId)
      await whenListed(c.externalId)
      list = list.filter(x => x.externalId !== c.externalId)
      goto(`/messages/${c.externalId}/`)
    } catch (e) { error = e.message } finally { joining = null }
  }
</script>

<header class="browse-head">
  <h1 class="h4">Browse channels</h1>
</header>

<div class="browse" data-browse>
  {#if error}<Alert tone="danger">{error}</Alert>{/if}
  {#if loading}
    <p class="text-muted center">…</p>
  {:else}
    <ul class="rows divided hover">
      {#each list as c (c.externalId)}
        <li class="list-row browse-row" data-browse-channel={c.externalId}>
          <a class="stack gap-2xs browse-link" href={`/messages/${c.externalId}/`}>
            <span class="cluster gap-xs"><span aria-hidden="true">#</span><strong>{c.displayName || c.name}</strong></span>
            {#if c.purpose}<span class="text-sm text-muted">{c.purpose}</span>{/if}
          </a>
          <button type="button" class="btn sm" data-browse-join disabled={!!joining} onclick={() => join(c)}>Join</button>
        </li>
      {:else}
        <EmptyState title="You are in every open channel" />
      {/each}
    </ul>
  {/if}
</div>

<style>
  .browse-head { padding-inline: var(--space-lg); padding-block: var(--space-lg); border-block-end: var(--border-width) solid var(--rule); }
  .browse-head h1 { margin: 0; }
  .browse { flex: 1; min-block-size: 0; overflow-y: auto; padding: var(--space-md) var(--space-lg); }
  .browse-row { display: flex; align-items: center; justify-content: space-between; gap: var(--space-md); }
  .browse-link { color: inherit; text-decoration: none; min-inline-size: 0; }
</style>
