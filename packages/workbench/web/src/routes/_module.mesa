---
siteName: Workbench
---
<script>
  import { page, goto } from '@frontierjs/sierra/router'
  import { theme, setTheme, themes } from '@frontierjs/sierra/theme'
  import { THEMES } from '@frontierjs/css/themes.js'
  import Button from '@frontierjs/ui/components/forms/Button.mesa'
  import Toaster from '@frontierjs/ui/components/feedback/Toaster.mesa'
  import ConfirmProvider from '@frontierjs/ui/components/overlay/ConfirmProvider.mesa'
  import CommandPalette from '@frontierjs/ui/components/overlay/CommandPalette.mesa'
  import Drawer from '@frontierjs/ui/components/overlay/Drawer.mesa'
  import { commandPalette } from '@frontierjs/ui/stores/commandPaletteStore'
  import { paletteItems } from '@frontierjs/ui/nav'
  import Bell from '../components/Bell.mesa'
  import { session, signOut } from '../lib/session.js'
  import { groups } from '../lib/nav.js'
  import { pageCommands } from '../lib/commands.js'

  $: (page.pathname, page.title)
  $: (session.user)
  $: commandPalette.open

  const entries = () => groups.filter(g => g.show({ user: session.user })).flatMap(g => g.entries)
  const current = (e) => e.exact ? page.pathname === e.href : page.pathname.startsWith(e.href)

  // Below md the bar's nav gives way to a drawer (frame.css shows the toggle
  // there). Navigating with it open would leave it over the page it went to.
  let navOpen = false
  $: page.pathname, () => { navOpen = false }

  async function leave() {
    await signOut()
    goto('/login/')
  }

  // ─── ⌘K ──────────────────────────────────────────────────────────────────
  // The nav and the topbar's own behaviors reached a second way, plus what
  // the screen on show offers (lib/commands.js). Navigate comes from
  // lib/nav.js through the same `show`, so it cannot offer a screen the nav
  // hides.
  const themeName = (t) => THEMES[t]?.label ?? t.replace(/^theme-/, '')

  function commands() {
    return [
      ...pageCommands(),
      ...paletteItems(groups, { user: session.user }, goto),
      { id: 'nav:/git-activity/local/', group: 'Navigate', label: 'Local repos', action: () => goto('/git-activity/local/') },
      { id: 'nav:/settings/',           group: 'Navigate', label: 'Settings',    action: () => goto('/settings/') },
      ...themes().map(t => ({
        id: `theme:${t}`, group: 'Theme', label: themeName(t), sub: THEMES[t]?.blurb,
        keywords: 'theme appearance color', badge: theme.preference === t ? 'Current' : undefined,
        action: () => setTheme(t),
      })),
      { id: 'theme:system', group: 'Theme', label: 'Match system', keywords: 'theme appearance os light dark',
        badge: theme.preference === 'system' ? 'Current' : undefined, action: () => setTheme('system') },
      { id: 'sign-out', group: 'Session', label: 'Sign out', action: leave },
    ]
  }

  // A shell in the Terminal pane reads Ctrl+K as kill-line.
  function paletteKey(e) {
    if (!(e.metaKey || e.ctrlKey) || e.key !== 'k' || !session.user) return
    if (e.target?.closest?.('.xterm')) return
    e.preventDefault()
    commandPalette.toggle()
  }
</script>

<div class="shell">
  <header class="topbar">
    <span class="cluster wb-head">
      {#if session.user}
        <button class="btn ghost square sidebar-toggle" type="button"
                aria-label="Open navigation" aria-expanded={navOpen}
                onclick={() => navOpen = true}>
          <svg class="icon" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 20 20" fill="currentColor" aria-hidden="true">
            <path d="M2 4.75A.75.75 0 0 1 2.75 4h14.5a.75.75 0 0 1 0 1.5H2.75A.75.75 0 0 1 2 4.75Zm0 5.25a.75.75 0 0 1 .75-.75h14.5a.75.75 0 0 1 0 1.5H2.75A.75.75 0 0 1 2 10Zm0 5.25a.75.75 0 0 1 .75-.75h14.5a.75.75 0 0 1 0 1.5H2.75a.75.75 0 0 1-.75-.75Z"/>
          </svg>
        </button>
      {/if}
      <strong>Workbench</strong>
      {#if session.user}
        <nav class="cluster wb-nav topbar-nav" aria-label="Workbench">
          {#each entries() as e}
            <a href={e.href} title={e.sub} aria-current={current(e) ? 'page' : undefined}>{e.label}</a>
          {/each}
        </nav>
      {/if}
    </span>
    {#if session.user}
      <span class="cluster wb-tools">
        <Button treatment="ghost" size="sm" id="palette-open" onclick={() => commandPalette.show()}>
          <span class="spare">Search</span> <kbd class="kbd hide-sm">⌘K</kbd>
        </Button>
        <Bell />
        <a href="/settings/" class="text-sm text-muted" title="Settings"
           aria-current={page.pathname.startsWith('/settings/') ? 'page' : undefined}>{session.user.nick}</a>
      </span>
    {/if}
  </header>

  <main class="screen" id="main" tabindex="-1">
    <div class="container stack screen-body">
      <slot />
    </div>
  </main>
</div>

{#if session.user}
  <Drawer side="left" bind:open={navOpen} title="Workbench">
    <nav class="stack" aria-label="Workbench">
      <ul class="navlist">
        {#each entries() as e}
          <li><a class="navlink" href={e.href} title={e.sub} aria-current={current(e) ? 'page' : undefined}>{e.label}</a></li>
        {/each}
        <li><a class="navlink" href="/settings/" aria-current={page.pathname.startsWith('/settings/') ? 'page' : undefined}>Settings</a></li>
      </ul>
    </nav>
  </Drawer>
{/if}

<mesa:window onkeydown={paletteKey} />

{#if commandPalette.open}
  <CommandPalette
    items={commands()}
    groupOrder={['Checkouts', 'Workbench', 'Navigate', 'Theme', 'Session']}
    placeholder="Search checkouts, screens, themes…"
    onclose={() => commandPalette.hide()}
  />
{/if}

<Toaster position="bottom-right" />
<ConfirmProvider />

<style>
  /* The workbench and Autopilot's town are working surfaces, not reading
     columns: let them take the whole width the screen gives them. */
  .screen-body:has(:global(.workbench)) { max-inline-size: none; }
  .screen-body:has(:global(.autopilot-screen)) { max-inline-size: none; }
  /* Below 2xl (1536px): brand left and search/bell/owner right on the first line,
     the nav on a line of its own below. The brand's span dissolves so its
     children order against the tools as flex items of the topbar. */
  @media (max-width: 95.99rem) {
    .wb-head { display: contents; }
    .wb-tools { order: 1; margin-inline-start: auto; }
    .wb-nav { order: 2; flex-basis: 100%; }
  }
  /* Below md the toggle is shown and the nav is `.topbar-nav` (frame.css), so
     the drawer carries it. The head is a cluster again so the toggle and the
     brand stay together instead of spreading as two items of a space-between
     bar. */
  @media (max-width: 767px) {
    .wb-head { display: flex; gap: var(--space-sm); }
  }
  /* The workbench page's Focus sets this, and clears it when the page goes. */
  :global(html[data-workbench-focus] .topbar) { display: none; }
</style>
