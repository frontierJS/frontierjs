{
  "name": "@frontierjs/notifications",
  "version": "0.1.10",
  "engines": {
    "bun": ">=1.4.0"
  },
  "_built": "2026-04-18",
  "description": "Channel-agnostic notification system for FrontierJS apps",
  "type": "module",
  "license": "MIT",
  "main": "./index.ts",
  "exports": {
    ".": "./index.ts",
    "./client": "./client.ts",
    "./schema.lite": "./db/notification.lite",
    "./resource/*.mesa": "./resource/*.mesa"
  },
  "keywords": [
    "frontierjs",
    "notifications",
    "junction"
  ],
  "peerDependencies": {
    "@frontierjs/junction": "^0.1.0",
    "@frontierjs/mesa": "^0.1.0",
    "@frontierjs/ui": "^0.1.0"
  },
  "peerDependenciesMeta": {
    "@frontierjs/mesa": {
      "optional": true
    },
    "@frontierjs/ui": {
      "optional": true
    }
  },
  "devDependencies": {
    "bun-types": "^1.3.14",
    "@frontierjs/junction": "workspace:*",
    "@frontierjs/litestone": "workspace:*"
  },
  "scripts": {
    "test": "node ../../scripts/tmp-run.mjs 'bun test test/'",
    "typecheck": "node ../../scripts/typecheck.mjs"
  },
  "files": [
    "*.ts",
    "db",
    "drivers",
    "resource",
    "README.md",
    "LICENSE"
  ],
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/frontierJS/frontierjs.git",
    "directory": "packages/notifications"
  }
}
