<script module>
  // web/src/resources/Notification.mesa — the in-app half of a notification,
  // as a UI resource.
  //
  // A `.mesa` file: a Resource is a UI-realm noun, so it is written in the
  // UI-realm language even when all it does is bind a name to a service
  // (Invariant 18). `<script module>` runs once at import and its named exports
  // are importable anywhere. There is no markup here because this model has no
  // form — a notification is read, never filled in.
  //
  // Nothing here says "only mine". The model does — `@@allow('read', userId ==
  // auth().id)` — and the server enforces it, which is why signing out and back
  // in as somebody else needs no code on this side at all.
  //
  // Real-time needs no code here either. `createResource` binds a live store to
  // the service's channel, so the `notification:created` event the inApp driver
  // publishes lands in `notifications.store` on its own. It arrives only if the
  // channels() plugin is configured on the server; without it the rows still
  // persist and `load()` still reads them.
  import { createResource } from '@frontierjs/sierra/junction'

  export const notifications = createResource('notifications', {
    model: 'Notification',
  })

  /** Unread is first-class: the bell counts these, the list styles them. */
  export const isUnread = (n) => !n.readAt

  /**
   * Mark one read. `readAt` is a real column and the model's
   * `@@allow('update', userId == auth().id)` is what stops it being anybody
   * else's — the service narrows `patch` to this one field.
   */
  export const markRead = (id) =>
    notifications.service.patch(id, { readAt: new Date().toISOString() })
</script>
