<!-- web/src/resources/Notification.mesa -->
<!--
  Notification resource — generated by `fli add notifications`

  Dependencies:
    - channels() plugin must be configured on the server for real-time delivery
    - If channels() is absent, the store will not receive WS push events.
      Notifications still persist to DB and are available via service.find().
-->

<script>
  import { resource, derived, get } from '@frontierjs/sierra'

  const _res = resource.createResource({
    model:   'Notification',
    service: 'notifications',
  })

  export const { store, service } = _res

  // ─── Derived: unread count ────────────────────────────────────────────────
  // Reactive — updates automatically when store changes.
  // Use in bell icon: <span>{$unreadCount}</span>
  export const unreadCount = derived(store, (notifications) =>
    notifications.filter(n => !n.readAt).length
  )

  // ─── Real-time delivery ───────────────────────────────────────────────────
  // Listens for WS events published by the inApp driver after DB insert.
  // New notification arrives → store updates → unreadCount increments.
  // Requires channels() plugin on the server.
  resource.onEvent('notification:created', (payload) => {
    store.upsert(payload)
  })

  // ─── Mark single notification as read ────────────────────────────────────
  export async function markRead(id) {
    return service.patch(id, { readAt: new Date().toISOString() })
  }

  // ─── Mark all unread notifications as read ───────────────────────────────
  // Note: this fires one PATCH per unread notification.
  // For large unread counts, prefer a server-side bulk endpoint if available.
  export async function markAllRead() {
    const unread = get(store).filter(n => !n.readAt)
    await Promise.all(unread.map(n => markRead(n.id)))
  }
</script>
