// ─── @frontierjs/notifications — the models an app owns ──────────────────────
//
// Two models, and the app's rather than this package's — the same split
// @frontierjs/auth makes between user.lite and auth.lite. It is APPENDED to the
// app's own db/schema.lite rather than imported, because everything an app does
// next happens here: a relation back to its own User, a tenant key under row
// tenancy, @@trail(audit), a column its own bell menu wants, and the constraint
// on subjectType that only the app can know.
//
// What this package does with them is narrower than what the app does: it
// writes Notification rows and reads PushSubscription rows, both through
// asSystem(). So the file ships to be COPIED, and
// `fli check`'s `package-model-drift` grades the copy against it — a column
// this package starts writing that an app's copy does not have is named there
// rather than discovered at the first send.
//
// This file is REAL .lite and parses standalone against a host declaring
// `database main`.
//
// ─── What is deliberately NOT here ──────────────────────────────────────────
//
// No `title` and no `body`. A notification is an EVENT plus a payload, and the
// words are rendered from `type` + `data` at the moment of display — which is
// what lets one stored row be an email in English, a line in a dropdown, and a
// push in Spanish. Storing the sentence freezes all three at write time and
// makes a copy change a migration.
//
// No `channel` and no `sentAt`. Delivery is a TRANSPORT concern and a transport
// is not this row: one notification fans out to in-app, email and whatever else
// is registered, so a delivery column here would be one of N answers. In this
// framework a *channel* is junction's broadcast set (FJS-D06).
//
// No `dismissedAt` beside `readAt`. Read and dismissed is a product decision
// rather than a shape one; add it when a screen distinguishes them.

model Notification {
  id          Int       @id
  // String, not Int: @frontierjs/auth issues uuid ids. An app whose own User.id
  // is an Int changes this to match — that is a deliberate deviation, and the
  // drift rule is baselined to say so.
  userId      String
  // The notification's stable name — its file name, or the `type:` it states.
  // Not a foreign key and not an enum: adding a notification type is a file,
  // never a migration.
  type        String
  // Whatever the inApp formatter built. Shape varies by type, which is why the
  // browser reads `type` to choose a renderer.
  data        Json
  // A loose reference to what the notification is ABOUT, with no foreign key by
  // design: it points at more than one table, so a notification survives the
  // deletion of the row it refers to without a cascade.
  //
  // Nothing constrains subjectType here because this package cannot know what
  // an app's contexts are. `fli check`'s `polymorphic-subject` asks the app to
  // decide: constrain the column where the set is known
  // (@@check("subjectType IN ('Order', 'Invoice')") or a declared value set),
  // or baseline that rule where the set grows with every model. An enum is the
  // strongest of those — it emits a table CHECK, so a migration, a seed and
  // asSystem() are all held to it, and it reaches the browser as a set a picker
  // renders rather than a text box.
  //
  // subjectId is String, not Int: it points at more than one table, and a model
  // a phone writes offline has a ULID id (litestone refuses an autoincrement
  // there). An integer id fits as digits, a uuid or ULID fits as itself, and
  // "has this gone out" stays a query on (type, subjectId) -- the same trade
  // User.accountId makes in auth.
  //
  // Spelt subjectType/subjectId like AuditEvent's pair (FJS-D1361).
  subjectType String?
  subjectId   String?
  // What the definition's `key` answered, so a retried send finds the row its
  // first attempt wrote rather than writing a second (FJS-D872). Null for a
  // notification that declares no key, and SQLite counts nulls as distinct, so
  // the unique below never holds an unkeyed send back.
  deliveryKey String?
  // null = unread. The one column a recipient writes, which is what the U in
  // the gate below is for.
  readAt      DateTime?
  createdAt   DateTime  @default(now())

  @@db(main)
  // R.C.U.D. Read is open and the row policy scopes it to your own rows;
  // create is SYSTEM, because the only writer is this package through
  // asSystem(); update is USER, which is a recipient marking one as read;
  // delete is SYSTEM.
  //
  // Create is 8 and NOT 9. `9` is LOCKED — a wall asSystem() does not pass
  // either — so a 9 in the create slot would stop this package from ever
  // writing a row.
  @@gate(0.8.4.8)
  @@unique([userId, type, deliveryKey], nullsDistinct: true)
  @@allow(read,   userId == auth().id)
  @@allow(update, userId == auth().id)
}

// ─── PushSubscription — one browser's handle for Web Push ───────────────────
//
// A writable handle to somebody's device: whoever holds the endpoint and both
// keys can put a notification on that screen. So the keys are @encrypted, which
// means an app installing this fragment passes `encryptionKey` to createClient
// whether or not it sends push (FJS-D1442), and the gate is the owner's alone.
// The webPush() driver reads them through asSystem() to encrypt a payload.
//
// The column names are the ones `subscription.toJSON()` and the driver's
// PushSubscription interface use, so a row is handed to the driver as it is.

model PushSubscription {
  id         Int       @id
  // String to match Notification.userId; the same deliberate-deviation note
  // applies to an app whose User.id is an Int.
  userId     String
  // The push service's URL for this one browser profile. Not secret on its
  // own -- a send to it must be signed by the app's VAPID key -- and unique
  // because the subscribe route upserts by it.
  endpoint   String    @unique
  // The device's P-256 public key (65 bytes) and auth secret (16 bytes), both
  // base64url as the browser hands them over.
  p256dh     String    @encrypted
  auth       String    @encrypted
  userAgent  String?
  // Stamped on each re-subscribe, so a device nobody has opened in months can
  // be told from one in use.
  lastSeenAt DateTime?
  createdAt  DateTime  @default(now())
  // A 404 or 410 from the push service retires the row here. A retired row
  // keeps its endpoint (FJS-D65), so a browser that hands the same endpoint
  // back is restored by the subscribe route rather than refused as a duplicate.
  deletedAt  DateTime?

  @@db(main)
  @@softDelete
  // R.C.U.D all USER, and the policy below makes every one own-rows-only. No
  // admin read: a list of other people's devices is nobody's screen.
  @@gate(4.4.4.4)
  @@allow(all, userId == auth().id)
}
