<script module>
  // src/resources/App.mesa — the Resource layer.
  //
  // A Resource is a UI-realm noun, so it is a .mesa file (repo invariant 18).
  // No markup: everything is module scope, which is what <script module> means.
  //
  // Read this next to db/schema.lite. Nothing here restates anything there —
  // no field list, no types, no enum values, no required list, no relations.
  // A resource names a service, and that is the whole declaration: coercing
  // the strings a DOM control produces, rewriting blanks to NULL and validating
  // against the schema are all on by default (they were three flags every
  // resource in this app set, which is why they stopped being flags).
  import { createResource } from '@frontierjs/sierra/junction'

  // Service `apps` → model `App`. The schema renames it from the obvious
  // `Service` because the API realm owns that noun (db/README.md).
  export const apps = createResource('apps')
</script>
