<script module>
  // src/resources/Edge.mesa — the Resource layer for a workspace's DNS zones.
  //
  // No model, like Portal and Infra: a zone and a record are the vendor's
  // to state and this app keeps no copy of either. `model: null` declares that
  // rather than letting a missing schema read as a misspelt one.
  import { createResource } from '@frontierjs/sierra/junction'

  export const edge = createResource('edge', { model: null })
</script>
