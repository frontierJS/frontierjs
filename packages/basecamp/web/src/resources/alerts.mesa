<script module>
  // src/resources/alerts.mesa — the Resource layer.
  //
  // A Resource is a UI-realm noun, so it is a .mesa file (repo invariant 18).
  // No markup: everything is module scope, which is what <script module> means.
  //
  // `model:` is stated because this is the irregular case the registry warns
  // about: the service is `alerts` and the model is `AlertRule`, which regular
  // English pluralisation does not bridge. Without it modelNameFor() looks for
  // `Alert`, misses, warns, and degrades to a bare make() — validation, labels
  // and field rules all silently stop being schema-derived.
  import { createResource } from '@frontierjs/sierra/junction'
  import { stampWorkspace } from '../session.js'

  export const alerts = createResource('alerts', {
    model: 'AlertRule',
    hooks: { before: { create: [stampWorkspace] } },
  })
</script>
