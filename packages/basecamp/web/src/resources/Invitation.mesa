<script module>
  // src/resources/Invitation.mesa — the Resource layer.
  //
  // A Resource is a UI-realm noun, so it is a .mesa file (repo invariant 18),
  // named for the model and exporting the accessor (invariant 19). No markup:
  // everything is module scope, which is what <script module> means.
  //
  // `expiresAt` is stamped here and the value is not authority — the service
  // overwrites it with now + 7 days, and a client that lied about it gains
  // nothing. It is here because browser-side validation runs first and the
  // column is required on the create schema, so without it the invite form is
  // refused before a request is made, naming a field the form does not show and
  // must not show: how long a link lives is the service's answer.
  //
  // `workspaceId` needed the same treatment and no longer does — the tenancy
  // declaration defaults it from the principal, so it is out of create-mode
  // `required` and the server is its only writer (`FJS-387`).
  //
  // The hook runs on `service.create` as well as on `save()` — sierra's `_call`
  // runs before-hooks, then coercion, then validation — which is why the invite
  // form can call the service directly and still be seeded. It calls the service
  // directly because the reply carries the token and the accept link, which are
  // not columns and are on no later read.
  import { createResource } from '@frontierjs/sierra/junction'

  export const invitations = createResource('invitations', {
    hooks: { before: { create: [stampExpiry] } },
  })

  function stampExpiry(ctx) {
    if (ctx.data && !ctx.data.expiresAt) ctx.data.expiresAt = new Date().toISOString()
  }
</script>
