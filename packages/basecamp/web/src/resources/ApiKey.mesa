<script module>
  // src/resources/ApiKey.mesa — the Resource layer.
  //
  // A Resource is a UI-realm noun, so it is a .mesa file (repo invariant 18),
  // named for the model and exporting the accessor (invariant 19). No markup:
  // everything is module scope, which is what <script module> means.
  //
  // `model:` is stated because the service is `api-keys` — hyphenated, so it
  // is the URL segment the mock uses — and modelNameFor() singularises English
  // plurals, not kebab-case. Without it the lookup misses, warns, and degrades
  // to a bare make(): labels, required fields and validation all silently stop
  // being schema-derived.
  import { createResource } from '@frontierjs/sierra/junction'
  import { stampWorkspace } from '../session.js'

  // `validate: false` is not a shortcut. ApiKey's create schema is
  // `required: ["workspaceId", "userId", "name", "tokenHint"]`, and three of
  // those four are written by the server: the workspace comes from a header,
  // the owner is whoever is calling, and `tokenHint` is derived from a token
  // that does not exist until auth mints it. So schema-derived validation in
  // the browser refuses every create before the request is made, naming fields
  // the caller was never meant to send — which renders as "the button does
  // nothing".
  //
  // Nothing in the schema can currently say *the system writes this column*,
  // which is `FJS-D22`. Until it can, the server is the only place this model
  // can be validated, and it still is: `autoValidate` runs there against the
  // same schema, after the before-hook has filled in all three.
  export const apiKeys = createResource('api-keys', {
    model: 'ApiKey',
    validate: false,
    hooks: { before: { create: [stampWorkspace] } },
  })
</script>
