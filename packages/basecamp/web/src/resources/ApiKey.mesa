<script module>
  // src/resources/ApiKey.mesa — the Resource layer.
  //
  // A Resource is a UI-realm noun, so it is a .mesa file (repo invariant 18),
  // named for the model and exporting the accessor (invariant 19). No markup:
  // everything is module scope, which is what <script module> means.
  import { createResource } from '@frontierjs/sierra/resource'

  // Validated here like every resource. Every create-mode column the server
  // fills is said so in the schema — `tokenHint` and `credentialId` are
  // `@system`, `workspaceId` is the tenancy stamp, and `userId` is
  // `@default(auth().id)`: the owner control leaves it OUT for "you" (never a
  // null, which is a value and beats the default) and names a bot otherwise.
  export const apiKeys = createResource('apiKeys', {
    model: 'ApiKey',
  })
</script>
