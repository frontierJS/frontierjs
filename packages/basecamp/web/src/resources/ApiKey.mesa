<script module>
  // src/resources/ApiKey.mesa — the Resource layer.
  //
  // A Resource is a UI-realm noun, so it is a .mesa file (repo invariant 18),
  // named for the model and exporting the accessor (invariant 19). No markup:
  // everything is module scope, which is what <script module> means.
  //
  // `model:` is stated because the service is `api-keys` — hyphenated, so it
  // is the URL segment the mock uses — and modelNameFor() singularizes English
  // plurals, not kebab-case. Without it the lookup misses, warns, and degrades
  // to a bare make(): labels, required fields and validation all silently stop
  // being schema-derived.
  import { createResource } from '@frontierjs/sierra/junction'

  // `validate: false` is not a shortcut, and the reason left is ONE column.
  //
  // Create-mode required was `["userId", "name", "tokenHint"]`. Two of those
  // have since been answered in the schema: `workspaceId` stopped being a
  // fourth when the tenancy declaration started defaulting it from the
  // principal (`FJS-387`), and `tokenHint` is now `@system` (`FJS-D22`,
  // `FJS-095`) — derived from a token that does not exist until auth mints it,
  // so it is out of `required`, `readOnly` on this side, and not offered by a
  // generated form. `credentialId` went with it for the same reason.
  //
  // What is left is `userId`. It is genuinely caller-supplied — a key may be
  // issued to a bot rather than to the person asking, which is what
  // `assertBotOwner` in the service is about — so it cannot be `@system`, and
  // it is `required`. The owner control on the create form offers the
  // workspace's bots and leaves the column EMPTY for "you", which the before
  // hook fills with the caller: an empty required column, so browser
  // validation on would refuse the commonest create. The server is where this
  // model is validated — `autoValidate` against the same schema, after the
  // hook has filled the column in.
  export const apiKeys = createResource('api-keys', {
    model: 'ApiKey',
    validate: false,
  })
</script>
