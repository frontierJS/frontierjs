<script module>
  // src/resources/Notification.mesa — the in-app half of a notification.
  //
  // No markup: a notification is read, never filled in. No filter for "mine"
  // either — `@@allow(read, userId == auth().id)` on the model is what scopes
  // it, so a sign-in as somebody else is a different list with no code here.
  //
  // The bell and /notifications/ are `@frontierjs/notifications`' own
  // NotificationBell and NotificationList, handed this resource. The inApp
  // driver pushes `notifications created` to `notifications:user:<id>`, which
  // the API joins on connect, and the client routes that frame into their
  // tether — so neither screen polls.
  import { createResource } from '@frontierjs/sierra/resource'

  export const notifications = createResource('notifications', { model: 'Notification' })

  /** The kinds that report something wrong — the ones whose email subject is
   *  `marked()` with a severity. A success, a recovery, a join or a digest
   *  is news, not trouble, and a red count for it teaches the reader to
   *  ignore red. */
  const TROUBLE = new Set([
    'DeployFailed', 'AlertFiring', 'ServerUnreachable', 'MonitorDown', 'MonitorCertExpiring',
    'PostureFailed', 'HubPostureFailed', 'DependencyVulnerable', 'JobFailed', 'AppBackupFailed',
  ])
  export const isTrouble = (n) => TROUBLE.has(n.type)

  /** The bell's count: red only while something unread is a failure. */
  export const countTone = (unread) => unread.some(isTrouble) ? 'danger' : ''
</script>
