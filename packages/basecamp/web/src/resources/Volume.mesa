<script module>
  // src/resources/Volume.mesa — the Resource layer.
  //
  // A Resource is a UI-realm noun, so it is a .mesa file (repo invariant 18).
  // No markup: everything is module scope, which is what <script module> means.
  //
  // No `model:` — `volumes` is the regular plural of `Volume`, which is what
  // modelNameFor() resolves.
  //
  // No create hook, because there is no create: a volume is OBSERVED. The
  // service answers 405 and there would be nothing to send — the
  // model carries no workspaceId, its scope is the join through its server.
  import { createResource } from '@frontierjs/sierra/junction'

  export const volumes = createResource('volumes')
</script>
