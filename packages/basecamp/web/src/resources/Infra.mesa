<script module>
  // src/resources/Infra.mesa — the Resource layer for the two derived reads.
  //
  // A Resource is a UI-realm noun, so it is a .mesa file (repo invariant 18),
  // named for its noun singular even though the service is `infra` either way
  // (invariant 19).
  //
  // Like Portal and Hub, this has NO model: the graph and the onboarding
  // checks are assembled out of several tables, not rows of one. `model: null`
  // declares that — the warning it turns off is the one that means a model
  // name did not resolve, and this service never had one.
  import { createResource } from '@frontierjs/sierra/junction'

  export const infra = createResource('infra', { model: null })
</script>
