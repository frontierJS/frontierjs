<script module>
  // src/resources/Recipe.mesa — the Resource layer.
  //
  // A Resource is a UI-realm noun, so it is a .mesa file (repo invariant 18),
  // named for the model and exporting the accessor (invariant 19). No markup:
  // everything is module scope, which is what <script module> means.
  //
  // No `model:` — `recipes` is the regular plural of `Recipe`, which is what
  // modelNameFor() resolves.
  //
  // `stampWorkspace` is not optional bookkeeping. The service stamps
  // `workspaceId` in its own before/create — but browser-side validation runs
  // FIRST, and `workspaceId` is required on the create schema, so without this
  // hook every save is refused in the form with *workspace is required*, a
  // field no form on this screen shows. Measured, not assumed: the first
  // version of this file left it out and the browser drive caught it.
  //
  // `createdBy` needs no equivalent — it is nullable, so validation has no
  // opinion and the server's stamp is the only writer.
  import { createResource } from '@frontierjs/sierra/junction'
  import { stampWorkspace } from '../session.js'

  export const recipes = createResource('recipes', {
    hooks: { before: { create: [stampWorkspace] } },
  })
</script>
