<script module>
  // src/resources/HubConfig.mesa — the Resource layer.
  //
  // A SINGLETON, so this resource is used for its schema — labels, field rules,
  // the controls a form generates — rather than for a list. The service answers
  // `current` and `save` and no CRUD verb at all, which is what a settings row
  // with a constant primary key actually is.
  import { createResource } from '@frontierjs/sierra/resource'

  export const hubConfig = createResource('hubConfig', { model: 'HubConfig' })
</script>
