<script module>
  // src/resources/Workspace.mesa — the Resource layer.
  //
  // A Resource is a UI-realm noun, so it is a .mesa file (repo invariant 18).
  // No markup: everything is module scope, which is what <script module> means.
  //
  // Read this next to db/schema.lite. Nothing here restates anything there —
  // no field list, no types, no enum values, no required list, no relations.
  // A resource names a service, and that is the whole declaration: coercing
  // the strings a DOM control produces, rewriting blanks to NULL and validating
  // against the schema are all on by default (they were three flags every
  // resource in this app set, which is why they stopped being flags).
  import { createResource } from '@frontierjs/sierra/resource'

  // `validate: false` for ApiKey's reason: three of create's required columns
  // are the SESSION's — `accountId` and `ownerId` are the caller's, assigned by
  // `stampOwnership` before the server's `autoValidate` runs, and `slug` is
  // derived there from the name. The browser can know none of them, so
  // validating here refuses every create naming boxes nobody can fill. The
  // server validates the same schema after the hook.
  export const workspaces = createResource('workspaces', { validate: false })
</script>
