<script module>
  // src/resources/Backup.mesa — the Resource layer.
  //
  // `backups` is the regular plural of `Backup`, so no `model:`.
  //
  // Hub tier, like Hub.mesa: `Backup` is `@@tenant(none)` because an archive is
  // of the whole installation, and the service is behind `requireSystemAdmin`.
  import { createResource } from '@frontierjs/sierra/junction'

  export const backups = createResource('backups')
</script>
