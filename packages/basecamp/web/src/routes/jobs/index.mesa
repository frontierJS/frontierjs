---
title: Jobs
---
<script>
  import { session } from '../../session.js'
  import Job, { jobs } from '../../resources/Job.mesa'
  import { at } from '../../datetime.js'
  import { toasts } from '@frontierjs/ui/stores/toastStore.js'
  import Button from '@frontierjs/ui/components/forms/Button.mesa'
  import Drawer from '@frontierjs/ui/components/overlay/Drawer.mesa'
  import Table  from '@frontierjs/ui/components/display/Table.mesa'
  import { page } from '@frontierjs/sierra/router'

  $: session.workspaceId

  let rows    = []
  let error   = null
  let loading = true
  let busy    = null
  let creating = page.query?.new !== undefined
  // ⌘K's New … entries land here with ?new, on this route or from another.
  $: page.query, () => { if (page.query?.new !== undefined) creating = true }

  async function load() {
    error = null; loading = true
    try {
      rows = (await jobs.service.find({}, { limit: 100 })).data
    } catch (e) {
      error = e.message
    } finally {
      loading = false
    }
  }

  load()
  $: session.workspaceId, () => load()

  // Same rule as servers: the event is named after the method, and reads are
  // excluded or the handler answers its own refetch.
  const READS = new Set(['get', 'find'])
  const off = jobs.service.on('*', (method, row) => {
    if (READS.has(method) || !row?.id) return
    const i = rows.findIndex(r => r.id === row.id)
    if (i >= 0) rows = [...rows.slice(0, i), { ...rows[i], ...row }, ...rows.slice(i + 1)]
    else load()
  })
  $.onDestroy(off)

  async function trigger(job) {
    error = null; busy = job.id
    try {
      // Returns the job row plus `queued: true` — the run itself happens on
      // Caravan's thread, so what comes back is the job, not the run.
      const updated = await jobs.service.invoke('trigger', job.id)
      const i = rows.findIndex(r => r.id === job.id)
      if (i >= 0) rows = [...rows.slice(0, i), { ...rows[i], ...updated }, ...rows.slice(i + 1)]
    } catch (e) {
      error = e.message
    } finally {
      busy = null
    }
  }

  // A one-shot job is dispatched the moment it is created, so the new row
  // arrives through the push above; the drawer only has to close.
  function created(job) {
    creating = false
    toasts.success(`${job?.name ?? 'Job'} created`)
    load()
  }

  // `start: [pending, failed] -> running` — the same machine the detail
  // screen reads, so a running or cancelled job offers no Run now here either.
  const startable = job => jobs.transitions(job, session.level).some(m => m.name === 'start')

  const TONE = { running: 'info', failed: 'danger', cancelled: 'muted' }
  const RUN_TONE = { success: 'success', failed: 'danger', timeout: 'warning', running: 'info' }
  const JOB_COLUMNS = [
    { name: 'name',     label: 'Name' },
    { name: 'kind',     label: 'Kind' },
    { name: 'schedule', label: 'Schedule' },
    { name: 'status',   label: 'Status' },
    { name: 'lastrun',  label: 'Last run' },
    { name: 'actions',  label: 'Actions', hideLabel: true },
  ]
</script>

<div class="section-header">
  <div>
    <h1>Jobs</h1>
    <span class="text-sm text-muted">scheduled and one-shot work</span>
  </div>
  <Button variant="primary" id="job-new" onclick={() => creating = true}>New job</Button>
</div>

<Drawer open={creating} title="New job" onclose={() => creating = false}>
  {#if creating}
    <!-- `status` moves by transition, never by a box — a job is born pending. -->
    <Job method="create" except={['status']} submitLabel="Create job" submitId="job-create-save"
         oncancel={() => creating = false} ondone={created} />
  {/if}
</Drawer>

{#if error}
  <article class="alert danger">
    <div class="alert-content">{error}</div>
  </article>
{/if}

{#if loading}
  <p class="text-sm text-muted">Loading…</p>
{:else if !rows.length}
  <article class="alert info">
    <div class="alert-content">
      No jobs in this workspace yet — New job makes one.
    </div>
  </article>
{:else}
  <Table id="job-rows" columns={JOB_COLUMNS} rows={rows} striped>
    {#snippet row(job)}
      <tr>
        <td><a href={`/jobs/${job.id}/`}>{job.name}</a></td>
        <td>{job.kind}</td>
        <td><code>{job.cronExpression ?? '—'}</code></td>
        <td><span class="pill {TONE[job.status] ?? ''}">{job.status}</span></td>
        <td class="text-sm text-muted">
          {at(job.lastRunAt, 'never')}
          {#if job.lastRunStatus}
            <span class="badge {RUN_TONE[job.lastRunStatus] ?? 'muted'}">{job.lastRunStatus}</span>
          {/if}
        </td>
        <td>
          <div class="cluster">
            <Button variant="ghost" disabled={busy === job.id || !startable(job)} onclick={() => trigger(job)}>
              {busy === job.id ? 'Queuing…' : 'Run now'}
            </Button>
            <Button variant="ghost" href={`/jobs/${job.id}/`}>Open</Button>
          </div>
        </td>
      </tr>
    {/snippet}
  </Table>
{/if}
