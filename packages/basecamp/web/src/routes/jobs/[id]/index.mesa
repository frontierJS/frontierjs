---
title: Job
---
<script>
  import { page, goto } from '@frontierjs/sierra/router'
  import { session }    from '../../../session.js'
  import Job, { jobs }  from '../../../resources/Job.mesa'
  import { at }         from '../../../datetime.js'
  import { toasts }     from '@frontierjs/ui/stores/toastStore.js'
  import Button   from '@frontierjs/ui/components/forms/Button.mesa'
  import Drawer   from '@frontierjs/ui/components/overlay/Drawer.mesa'
  import NoRecord from '../../../components/NoRecord.mesa'
  import { offerUndo } from '../../../resources/Trash.mesa'

  $: page.params
  $: session.level

  let job       = null
  let error     = null
  let loadError = null
  let loading   = true
  let busy      = null
  let editing   = false

  // The job, watched rather than read (`FJS-518`). `get()` answers it WITH its
  // five most recent runs, so the history needs no second request — and that is
  // what makes this a COMPOSED view: a push carries the row alone, so the node
  // says the row moved and the composed answer is read again (`FJS-533`).
  let row     = null
  let unwatch = null

  function watchJob(id) {
    if (row && String(row.id) === String(id)) return row.refresh()
    unwatch?.(); row?.release()
    row = jobs.record(id, { composed: true })
    unwatch = row.subscribe(v => { job = v })
    return row.ready
  }

  async function load() {
    error = null; loadError = null
    try {
      await watchJob(page.params.id)
    } catch (e) {
      error = e.message; loadError = e
    } finally {
      loading = false
    }
  }

  load()
  $: page.params.id, () => load()

  $.onDestroy(() => { unwatch?.(); row?.release() })

  async function act(method) {
    error = null; busy = method
    try {
      await jobs.service.invoke(method, job.id)
      // Re-read rather than merge: `trigger` queues work that runs on Caravan's
      // thread, so the interesting change (a new JobRun) lands after the reply.
      await load()
    } catch (e) {
      error = e.message
    } finally {
      busy = null
    }
  }

  // The composed view re-reads on the push the save causes; the drawer only
  // has to close.
  function saved() {
    editing = false
    toasts.success('Job saved')
  }

  async function removeJob() {
    error = null; busy = 'remove'
    // Read before the write: the row is watched, and the delete's own push
    // empties `job` before the next line runs.
    const { id, name } = job
    try {
      await jobs.service.remove(id)
      offerUndo(name, jobs, id)
      goto('/jobs/')
    } catch (e) {
      error = e.message
      busy  = null
    }
  }

  /** What a run printed. `finishRun` writes `{ stdout }` on success and the
   *  error on failure, so an empty object is a run that said nothing. */
  const stdoutOf = run => (typeof run.output?.stdout === 'string' && run.output.stdout) || null

  const TONE     = { running: 'info', failed: 'danger', cancelled: 'muted' }
  const RUN_TONE = { success: 'success', failed: 'danger', timeout: 'warning', running: 'info' }
  const secs     = (ms) => ms == null ? '—' : `${(ms / 1000).toFixed(1)}s`

  $: runs = job?.recent_runs ?? []

  // What this job may do next, read off `@@transitions(status, …)` on the
  // model. A UI affordance only — litestone enforces every move at the Data
  // boundary whatever this renders.
  $: moves       = job ? jobs.transitions(job, session.level) : []
  $: cancellable = moves.some(m => m.name === 'cancel')
  // `start: [pending, failed] -> running` says which jobs can be fired, so the
  // button follows the machine instead of asking "is it not already running".
  $: startable   = moves.some(m => m.name === 'start')
</script>

{#if loading}
  <p class="text-sm text-muted">Loading…</p>
{:else if job}
  <div class="section-header">
    <h1>{job.name}</h1>
    <div class="cluster">
      <span class="pill {TONE[job.status] ?? ''}" id="job-status">{job.status}</span>
      <Button variant="ghost" href="/jobs/">All jobs</Button>
    </div>
  </div>

  <Drawer open={editing} title={`Edit ${job.name}`} onclose={() => editing = false}>
    {#if editing}
      <Job record={job} oncancel={() => editing = false} ondone={saved} submitId="job-edit-save" />
    {/if}
  </Drawer>

  {#if error}
    <article class="alert danger">
      <div class="alert-content">{error}</div>
    </article>
  {/if}

  <div class="cluster" id="job-actions">
    <Button variant="outlined" disabled={busy === 'trigger' || !startable} onclick={() => act('trigger')}>
      {busy === 'trigger' ? 'Queuing…' : 'Run now'}
    </Button>
    {#if cancellable}
      <Button variant="ghost" tone="danger" disabled={busy === 'cancel'}
              data-confirm="It stops, and does not run again until somebody starts it."
              data-confirm-title="Cancel this job?" data-confirm-label="Cancel job"
              onclick={() => act('cancel')}>Cancel</Button>
    {/if}
    <Button variant="outlined" id="job-edit" onclick={() => editing = true}>Edit</Button>
    <Button variant="ghost" tone="danger" id="job-delete" disabled={busy === 'remove'}
            data-confirm="It is cancelled, taken off the schedule, and removed."
            data-confirm-title="Delete this job?" data-confirm-label="Delete"
            onclick={removeJob}>Delete</Button>
  </div>

  <dl class="facts">
    <dt>Kind</dt>     <dd>{job.kind}</dd>
    <dt>Command</dt>  <dd><code>{job.command ?? '—'}</code></dd>
    <dt>Schedule</dt> <dd><code>{job.cronExpression ?? 'on demand'}</code></dd>
    <dt>Next run</dt> <dd>{at(job.nextRunAt)}</dd>
    <dt>Timeout</dt>  <dd>{job.timeoutSeconds}s</dd>
    <dt>Retries</dt>  <dd>{job.retryCount} of {job.retryLimit}</dd>
  </dl>

  <h2 class="h4">Recent runs</h2>
  {#if !runs.length}
    <p class="text-sm text-muted">This job has never run.</p>
  {:else}
    <ol class="feed" id="job-runs">
      {#each runs as run}
        <li>
          <article class="feed-item">
            <span class="feed-dot {RUN_TONE[run.status] ?? ''}" aria-hidden="true"></span>
            <div class="feed-content">
              <div class="text-muted text-sm">{at(run.startedAt)} · {secs(run.durationMs)}</div>
              <div class="cluster">
                <span class="pill {RUN_TONE[run.status] ?? ''}">{run.status}</span>
                <span class="text-sm text-muted">exit {run.exitCode ?? '—'} · {run.trigger}</span>
              </div>
              {#if run.error}
                <pre class="text-sm">{run.error}</pre>
              {/if}
              {#if stdoutOf(run)}
                <details>
                  <summary class="text-sm">Output</summary>
                  <pre class="text-sm scroll-x">{stdoutOf(run)}</pre>
                </details>
              {/if}
            </div>
          </article>
        </li>
      {/each}
    </ol>
  {/if}
{:else}
  <NoRecord error={loadError} noun="Job" onretry={load}
            backHref="/jobs/" backLabel="Back to jobs" />
{/if}
