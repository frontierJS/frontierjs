---
title: Home
---
<script>
  // Signed-in home. The guard in App.mesa means this route is never reached
  // without a session, so there is no loading state for the session itself.
  // Everything below the header is scoped to the workspace named in it, and
  // switching that header control re-scopes the page.
  import { session } from '../session.js'
  import { projects } from '../resources/Project.mesa'
  import { servers } from '../resources/Server.mesa'
  import { deployments } from '../resources/Deployment.mesa'
  import { jobs } from '../resources/Job.mesa'
  import { dashboards } from '../resources/Dashboard.mesa'
  import { useStore } from '@frontierjs/sierra/junction'
  import ActionQueue from '../components/ActionQueue.mesa'
  import LaunchSteps from '../components/LaunchSteps.mesa'
  import { computeNotices } from '../notices.js'
  import { infra } from '../resources/Infra.mesa'
  import Table from '@frontierjs/ui/components/display/Table.mesa'
  import StatCard from '@frontierjs/ui/components/display/StatCard.mesa'
  import Button from '@frontierjs/ui/components/forms/Button.mesa'

  const { get: rows, unsubscribe } = useStore(projects.store)
  $.onDestroy(unsubscribe)

  // The queue subscribes; it does NOT load. The shell already loaded these
  // three for the notice bar and a resource store is a module singleton, so
  // asking again here would be a second request for rows this page already
  // has — and the WebSocket keeps them current either way.
  const { get: srv, unsubscribe: unsubSrv } = useStore(servers.store)
  const { get: dep, unsubscribe: unsubDep } = useStore(deployments.store)
  const { get: jbs, unsubscribe: unsubJbs } = useStore(jobs.store)
  $.onDestroy(() => { unsubSrv(); unsubDep(); unsubJbs() })

  $: notices = computeNotices({ servers: srv(), deployments: dep(), jobs: jbs() })

  $: (session.user, session.workspaceId, session.workspaces)

  // Derived HERE, not called from the template. Mesa tracks the reads a
  // component makes; a helper imported from session.js reads the raw object
  // inside its own module, where no proxy is watching (RULE 44/45) — so
  // `currentWorkspace()?.name` in the markup rendered once and then never
  // changed, and switching workspace re-scoped the data while the heading
  // still named the old one.
  $: current = session.workspaces.find(w => w.id === session.workspaceId) ?? null

  let error   = null
  let loading = true
  let pinned  = []

  async function load() {
    error   = null
    loading = true
    try {
      // No workspace id is passed. The Junction client carries it as a header
      // on every request, set once by session.js — a page that had to remember
      // to filter by workspace would eventually forget, and that is a tenancy
      // leak rather than a missing filter.
      await projects.load()
      // What Pin is for: a board the workspace reaches for from here.
      pinned = (await dashboards.service.find({}, { limit: 20 })).data.filter(d => d.isPinned)
    } catch (e) {
      error = e.message
    } finally {
      loading = false
    }
  }

  load()

  // ─── The fleet in four numbers ─────────────────────────────────────────
  // Counted by the server (`infra.summary`), not tallied from the stores
  // above: those hold a page of each list, and a tally over a page is wrong
  // from the first row past it without saying so. The stores are still what
  // says the fleet MOVED — a push lands in one and the counts are asked for
  // again, a beat later so a burst of pushes is one read.
  let summary = null
  let summaryTimer = null
  async function loadSummary() {
    try {
      summary = await infra.service.invoke('summary', null)
    } catch (e) {
      summary = null
      error = e.message
    }
  }
  $: session.workspaceId, srv(), dep(), () => {
    clearTimeout(summaryTimer)
    summaryTimer = setTimeout(loadSummary, 500)
  }
  $.onDestroy(() => clearTimeout(summaryTimer))

  const n = (m, k) => m?.[k] ?? 0

  // Explicit-dependency effect (Mesa §4.2): the handler runs untracked, so the
  // reads inside load() add no subscriptions of their own.
  $: session.workspaceId, () => load()
  const PROJECT_COLUMNS = [
    { name: 'name',   label: 'Name' },
    { name: 'slug',   label: 'Slug' },
    { name: 'status', label: 'Status' },
  ]
</script>

<div class="section-header">
  <h1>{current?.name ?? 'Basecamp'}</h1>
  <Button variant="primary" href="/projects/create/">New project</Button>
</div>

{#if error}
  <article class="alert danger">
    <div class="alert-content">{error}</div>
  </article>
{/if}

<!-- The mock's Basecamp home opens with the queue, and so does this one:
     the first question an operator has is "what is broken", not "what exists". -->
<ActionQueue notices={notices} />

<section class="tiles" id="fleet-summary" aria-label="Fleet summary">
  <StatCard label="Machines" loading={!summary} href="/servers/"
            value={summary?.servers.total}
            sub={`${n(summary?.servers.byStatus, 'online')} online · ${n(summary?.servers.byStatus, 'unreachable')} unreachable`}
            tone={n(summary?.servers.byStatus, 'unreachable') ? 'danger' : ''} />
  <StatCard label="Apps" loading={!summary} href="/apps/"
            value={summary?.apps.total}
            sub={`${n(summary?.apps.byStatus, 'running')} running · ${n(summary?.apps.byStatus, 'error')} in error`}
            tone={n(summary?.apps.byStatus, 'error') ? 'danger' : ''} />
  <StatCard label="Releases today" loading={!summary} href="/deployments/"
            value={summary?.releases.total}
            sub={`${n(summary?.releases.byStatus, 'success')} shipped · ${n(summary?.releases.byStatus, 'failed')} failed`}
            tone={n(summary?.releases.byStatus, 'failed') ? 'warning' : ''} />
  <StatCard label="Alerts firing" loading={!summary} href="/alerts/"
            value={summary?.alerts.firing}
            sub={`${summary?.alerts.unacknowledged ?? 0} unacknowledged · ${summary?.alerts.snoozed ?? 0} rules snoozed`}
            tone={summary?.alerts.unacknowledged ? 'danger' : ''} />
</section>

<LaunchSteps />

{#if pinned.length}
  <nav class="cluster" id="pinned-dashboards" aria-label="Pinned dashboards">
    <span class="text-sm text-muted">Pinned</span>
    {#each pinned as d}
      <a class="badge info" href={`/dashboards/${d.id}/`}>{d.icon ?? ''} {d.name}</a>
    {/each}
  </nav>
{/if}

<div class="section-header">
  <h2 class="h4">Projects</h2>
  <span class="badge {rows().length ? 'success' : 'muted'}" id="project-count">
    {loading ? '…' : `${rows().length} projects`}
  </span>
</div>

{#if !loading && rows().length}
  <Table id="project-rows" columns={PROJECT_COLUMNS} rows={rows()} striped>
    {#snippet row(project)}
      <tr>
        <td><a href={`/projects/${project.id}/`}>{project.name}</a></td>
        <td><code>{project.slug}</code></td>
        <td><span class="pill">{project.status}</span></td>
      </tr>
    {/snippet}
  </Table>
{:else if !loading}
  <article class="alert info">
    <div class="alert-content">
      No projects in this workspace yet. <a href="/projects/create/">Create the first one</a>.
    </div>
  </article>
{/if}
