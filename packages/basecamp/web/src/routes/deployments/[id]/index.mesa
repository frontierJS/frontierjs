---
title: Deployment
---
<script>
  import { page, goto }   from '@frontierjs/sierra/router'
  import { status }       from '@frontierjs/sierra/resource'
  import { session }      from '../../../lib/session.js'
  import { deployments, DEPLOY_TONE } from '../../../resources/Deployment.mesa'
  import { ago, clock, at, day } from '../../../lib/datetime.js'
  import { toasts }       from '@frontierjs/ui/stores/toastStore'
  import Button   from '@frontierjs/ui/components/forms/Button.mesa'
  import NoRecord from '../../../components/NoRecord.mesa'

  $: page.params
  $: status.connected
  $: session.level

  let deployment = null
  let error      = null
  let loadError  = null
  let loading    = true
  let busy       = false

  // The deployment, watched rather than read (`FJS-518`). `get()` answers it
  // WITH its steps and a push carries the row alone, so this is a COMPOSED
  // view: the node says the row moved and the composed answer is read again
  // (`FJS-533`). This is the screen the channel exists for — a release advances
  // over ~10 seconds and a person watching it should not have to reload to find
  // out it finished. One request per step transition, on one open screen, is
  // the cheapest correct answer.
  let row     = null
  let unwatch = null

  function watchDeployment(id) {
    if (row && String(row.id) === String(id)) return row.refresh()
    unwatch?.(); row?.release()
    row = deployments.record(id, { composed: true })
    unwatch = row.subscribe(v => { deployment = v })
    return row.ready
  }

  async function load() {
    error = null; loadError = null
    try {
      await watchDeployment(page.params.id)
    } catch (e) {
      error = e.message; loadError = e
    } finally {
      loading = false
    }
  }

  load()
  $: page.params.id, () => load()

  $.onDestroy(() => { unwatch?.(); row?.release() })

  async function cancel() {
    error = null
    try {
      // `remove` on this service is a CANCEL, not a delete: deployment history
      // is the record of what shipped, so it is never erased here.
      deployment = { ...deployment, ...(await deployments.service.remove(deployment.id)) }
      load()
    } catch (e) { error = e.message }
  }

  async function rollback() {
    error = null
    try {
      // The answer is the REPLACEMENT — a new release of the old bytes, not a
      // rerun of the old row — and it is the one with a status worth watching,
      // so this page follows it. The release just retired keeps its own page.
      const replacement = await deployments.service.invoke('rollback', deployment.id, {})
      goto(`/deployments/${replacement.id}/`)
    } catch (e) { error = e.message }
  }

  // A new release of the app AS IT IS NOW, not a rerun of this row's snapshot:
  // that is `rollback`, and only from a release that went live. The service
  // refuses an app with nothing to ship or no machine to ship to, and that
  // sentence is shown here.
  async function deployAgain() {
    error = null; busy = true
    try {
      const release = await deployments.service.create({ appId: deployment.appId })
      toasts.success('Deploying')
      goto(`/deployments/${release.id}/`)
    } catch (e) {
      error = e.message
    } finally {
      busy = false
    }
  }

  const STEP_TONE = { success: 'success', failed: 'danger', running: 'info', skipped: 'muted' }

  // A sub-second step read `0.0s`, which says it took no time rather than little.
  function span(ms) {
    if (ms == null) return null
    if (ms < 1000)  return `${ms}ms`
    if (ms < 60_000) return `${(ms / 1000).toFixed(1)}s`
    return `${Math.floor(ms / 60_000)}m ${Math.round((ms % 60_000) / 1000)}s`
  }
  const between = (from, to) => from && to ? Date.parse(to) - Date.parse(from) : null
  const stepTook = (step) => span(step.durationMs ?? between(step.startedAt, step.finishedAt))
  const words = (s) => s ? s[0].toUpperCase() + s.slice(1).replace(/_/g, ' ') : null

  $: steps = deployment?.steps ?? []
  $: done  = steps.filter(s => s.status === 'success').length

  $: took     = deployment ? span(deployment.durationMs ?? between(deployment.startedAt, deployment.finishedAt)) : null
  // Only worth a line when the release actually waited for a worker.
  $: queuedMs = deployment ? between(deployment.queuedAt, deployment.startedAt) : null
  // Finished on the day it started is a clock time; the date is already above it.
  $: finished = deployment?.finishedAt
    ? (day(deployment.finishedAt) === day(deployment.startedAt) ? clock(deployment.finishedAt) : at(deployment.finishedAt))
    : null
  $: hasSource = !!(deployment && (deployment.commitSha || deployment.branch || deployment.author))

  // What this release may do next, read off `@@transitions(status, …)` on the
  // model rather than off a copy of the terminal-state list. The old copy was
  // the third one in the tree — schema, service, screen — and the screen's is
  // the one nothing would have caught going stale.
  //
  // A UI affordance only: litestone enforces every move at the Data boundary
  // regardless of which buttons this renders. `session.level` is passed so a
  // gated move the caller cannot make comes back `allowed: false` and renders
  // disabled rather than vanishing.
  $: moves    = deployment ? deployments.transitions(deployment, session.level) : []
  $: cancelIt = moves.find(m => m.name === 'cancel')
  // `rollback` is `@gate(5)` where this model updates at USER(4), so a
  // developer sees it DISABLED rather than absent — *not senior enough* is
  // advice somebody can act on, where a missing button is not.
  $: rollbackIt = moves.find(m => m.name === 'rollback')
  // In-flight IS cancellable, on this machine — the same fact, not a second one.
  $: running  = !!cancelIt
  $: canRetry = deployment && (deployment.status === 'failed' || deployment.status === 'cancelled')

  // The environment this release went TO, which is not the app's current one
  // once either has moved.
  $: env = deployment?.environment ?? deployment?.app?.environment ?? null
</script>

{#if loading}
  <p class="text-sm text-muted">Loading…</p>
{:else if deployment}
  <nav class="breadcrumb" aria-label="Breadcrumb" id="deploy-breadcrumb">
    <ol>
      {#if env}<li><a class="link" href={`/environments/${env.id}/`}>{env.name}</a></li>{/if}
      {#if deployment.app}<li><a class="link" href={`/apps/${deployment.appId}/`}>{deployment.app.name}</a></li>{/if}
      <li><a aria-current="page">Release <code>{deployment.id.slice(0, 8)}</code></a></li>
    </ol>
  </nav>

  <header class="section-header deploy-head">
    <div class="stack gap-2xs">
      <div class="cluster">
        <h1>{deployment.app?.name ?? 'Deployment'}</h1>
        <span class="pill {DEPLOY_TONE[deployment.status] ?? ''}" id="deploy-status">{deployment.status}</span>
      </div>
      <p class="text-muted">
        {words(deployment.trigger) ?? 'Manual'} deploy{#if env} to {env.name}{/if}
        · <span title={at(deployment.startedAt ?? deployment.queuedAt)}>{ago(deployment.startedAt ?? deployment.queuedAt)}</span>
      </p>
    </div>
    <div class="cluster">
      {#if cancelIt}
        <Button treatment="outlined" tone="danger" disabled={!cancelIt.allowed}
                data-confirm="The release stops at the step it is on."
                data-confirm-title="Cancel this deployment?" data-confirm-label="Cancel deployment"
                onclick={cancel}>Cancel</Button>
      {/if}
      {#if canRetry}
        <Button treatment="outlined" id="deploy-again" disabled={busy}
                title="Ships the app as it is now" onclick={deployAgain}>Deploy again</Button>
      {/if}
      {#if rollbackIt}
        <Button treatment="outlined" tone="warning" id="deploy-rollback"
                disabled={!rollbackIt.allowed}
                data-confirm="A new release of the previous build replaces what is live now."
                data-confirm-title="Roll back?" data-confirm-label="Roll back" data-confirm-tone="warning"
                onclick={rollback}>Roll back</Button>
      {/if}
    </div>
  </header>

  {#if error}
    <article class="alert danger">
      <div class="alert-content">{error}</div>
    </article>
  {/if}

  {#if running && !status.connected}
    <!-- With no socket this page does not poll, so it sits on a stale status
         until reloaded; saying so beats showing it as current. -->
    <article class="alert warning">
      <div class="alert-content">
        This release is still running and the live connection is down — reload to see where it got to.
      </div>
    </article>
  {/if}

  <div class="deploy-body">
    <!--
      .feed, not .steps: .steps is a wizard indicator and draws its connector
      through the labels; a release is an event stream (css patterns/feed.css).
    -->
    <section class="card deploy-steps" aria-labelledby="deploy-steps-title">
      <div class="surface-header">
        <h2 class="h5" id="deploy-steps-title">Steps</h2>
        <span class="text-sm text-muted" id="step-progress">{done} / {steps.length} complete</span>
      </div>
      {#if !steps.length}
        <p class="text-sm text-muted">No steps recorded yet.</p>
      {:else}
        <ol class="feed" id="deploy-steps">
          {#each steps as step}
            <li>
              <article class="feed-item">
                <span class="feed-dot {STEP_TONE[step.status] ?? ''}" aria-hidden="true"></span>
                <div class="feed-content stack gap-xs">
                  <div class="split deploy-step-head">
                    <strong>{step.name}</strong>
                    <span class="cluster gap-sm">
                      {#if step.startedAt}
                        <span class="text-sm text-muted">{clock(step.startedAt)}{#if stepTook(step)} · {stepTook(step)}{/if}</span>
                      {/if}
                      <span class="pill {STEP_TONE[step.status] ?? ''}">{step.status}</span>
                    </span>
                  </div>
                  {#if step.output}
                    <pre class="code deploy-output">{step.output}</pre>
                  {/if}
                </div>
              </article>
            </li>
          {/each}
        </ol>
      {/if}
    </section>

    <aside class="card deploy-details">
      <h2 class="h5">Release</h2>
      <dl class="facts" style="--fact-label-max: 45%">
        <dt>Started</dt>   <dd>{at(deployment.startedAt, 'not yet')}</dd>
        {#if queuedMs > 1000}
          <dt>Queued</dt>  <dd>{span(queuedMs)} before it started</dd>
        {/if}
        <dt>Finished</dt>  <dd>{finished ?? (running ? 'still running' : '—')}</dd>
        <dt>Duration</dt>  <dd>{took ?? '—'}</dd>
        <!-- The release that was live when this one was made. -->
        <dt>Replaced</dt>
        <dd id="deploy-previous">
          {#if deployment.previousDeploymentId}
            <a class="link" href={`/deployments/${deployment.previousDeploymentId}/`}><code>{deployment.previousDeploymentId.slice(0, 8)}</code></a>
          {:else}
            <span class="text-muted">nothing was live</span>
          {/if}
        </dd>
      </dl>

      <h2 class="h5">Build</h2>
      <dl class="facts" style="--fact-label-max: 45%">
        {#if deployment.toImage}
          <dt>Image</dt> <dd><code class="deploy-hash" title={deployment.toImage}>{deployment.toImage}</code></dd>
        {/if}
        <!-- The tag is a name; the digest is the identity. An executor that
             cannot say which bytes ran leaves it empty rather than repeating the tag. -->
        <dt>Digest</dt>
        <dd id="deploy-digest">
          {#if deployment.builtImage}
            <code class="deploy-hash" title={deployment.builtImage}>{deployment.builtImage}</code>
          {:else}
            <span class="text-muted">not reported</span>
          {/if}
        </dd>
      </dl>

      <h2 class="h5">Source</h2>
      {#if hasSource}
        <dl class="facts" style="--fact-label-max: 45%">
          {#if deployment.commitSha}
            <dt>Commit</dt>
            <dd><code title={deployment.commitSha}>{deployment.commitSha.slice(0, 7)}</code> {deployment.commitMessage ?? ''}</dd>
          {/if}
          {#if deployment.branch}<dt>Branch</dt> <dd><code>{deployment.branch}</code></dd>{/if}
          {#if deployment.author}<dt>Author</dt> <dd>{deployment.author}</dd>{/if}
        </dl>
      {:else}
        <p class="text-sm text-muted">No commit recorded for this release.</p>
      {/if}
    </aside>
  </div>
{:else}
  <NoRecord error={loadError} noun="Deployment" onretry={load}
            backHref="/deployments/" backLabel="Back to deployments" />
{/if}

<style>
  .deploy-head { flex-wrap: wrap; align-items: flex-start; }
  .deploy-body {
    display: grid;
    --deploy-aside-min: 18rem;
    --deploy-aside-max: 24rem;
    grid-template-columns: minmax(0, 1fr) minmax(var(--deploy-aside-min), var(--deploy-aside-max));
    gap: var(--space-2xl);
    align-items: start;
  }
  @media (max-width: 64rem) { .deploy-body { grid-template-columns: minmax(0, 1fr); } }

  .deploy-step-head { flex-wrap: wrap; align-items: baseline; }
  .deploy-output { white-space: pre-wrap; overflow-wrap: anywhere; }

  .deploy-hash {
    display: inline-block;
    max-inline-size: 100%;
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
    vertical-align: bottom;
  }
</style>
