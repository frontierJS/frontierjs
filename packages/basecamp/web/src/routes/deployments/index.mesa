---
title: Deployments
---
<script>
  // Every release in this workspace — and the one table in this console whose
  // columns nobody chose.
  //
  // `resource.columns()` ranks the READ schema: the column that names the row,
  // then the business key, then a bound enum, then money and time, then
  // declaration order. Nothing here names a field, a header or a type, and
  // `omitted` below reports every column it left out with the reason — so a
  // column added to `db/schema.lite` that does not appear is answerable
  // without reading this file.
  //
  // Taking the ranking UNAIDED is the point. `example`'s invoice ledger names
  // its six columns with `only:`, which is the escape hatch and wins over the
  // ranking; between the two, both halves have a caller.
  //
  // ── What this table can say that the other one cannot ──────────────────
  //
  // This app is `@@tenant` row-scoped, so every model carries `workspaceId`.
  // The Data boundary scopes the read by it, which means every row that comes
  // back holds the SAME value — a column of one repeated answer. It is omitted
  // by `columns()` for that reason, and `example` cannot ask the question at
  // all: it runs `tenancy { strategy database }` and has no such column on any
  // model.
  import { session } from '../../session.js'
  import { deployments } from '../../resources/Deployment.mesa'
  import Button    from '@frontierjs/ui/components/forms/Button.mesa'
  import Cell      from '@frontierjs/ui/components/display/Cell.mesa'
  import FilterBar from '@frontierjs/ui/components/display/FilterBar.mesa'
  import Table     from '@frontierjs/ui/components/display/Table.mesa'

  $: session.workspaceId

  const { columns: cols, omitted } = deployments.columns()

  // A header offers a sort only where the SCHEMA takes one: `x-sortable` is
  // emitted as an exception, so absent means yes and a string says why not.
  // Offering one the Data boundary refuses is a click that throws.
  //
  // Spread, not mapped: `<Table>` reads the same `name` the column already
  // carries, so the only entry here is this page's own (FJS-1078).
  const columns = [
    ...cols,
    { name: '_open', label: 'Actions', hideLabel: true },
  ]

  // Which columns a bar may offer and with which question. `Deployment`
  // declares no `@@fts`, so `search` comes back refused with the reason and no
  // box is drawn — a box the Data boundary answers 400 to is worse than none.
  const { filters, search } = deployments.filters()

  // The service includes app → environment and the deployment's own
  // environment, so a row names what it deployed and where without a second
  // request per row. `RelationCell` is what reads them back
  // (`web/src/displays.js`).
  //
  // That is why this list is COMPOSED. The job pushes `deployments patched` on
  // every step of a release, and a push carries the row without its includes —
  // held in the store, the first step of a running release would blank both
  // relation cells. Composed rows are this list's own, and a push re-reads the
  // window instead, one query per burst. Merging the push over the held row
  // costs nothing and goes stale in silence the moment a push moves a key an
  // include was read through.
  //
  // Held in memory rather than in the URL: a deployments list is read while a
  // release is running, and nothing here is worth a history entry per filter.
  const list = deployments.list({ state: 'local', composed: true, directives: { limit: 50 } })

  $: session.workspaceId, () => list.reload()
</script>

<div class="section-header">
  <h1>Deployments</h1>
  <span class="text-sm text-muted">newest first</span>
</div>

{#if list.error}
  <article class="alert danger">
    <div class="alert-content">{list.error.message}</div>
  </article>
{/if}

<FilterBar id="deployment-filters" {filters} {search} value={list.query}
            directives={list.directives} onchange={list.apply} />

{#if list.loading && !list.rows.length}
  <p class="text-sm text-muted">Loading…</p>
{:else if !list.rows.length}
  <article class="alert info">
    <div class="alert-content">
      No deployments match. Open an environment and deploy an app, or seed the example fleet with <code>bun run db:seed</code>.
    </div>
  </article>
{:else}
  <Table id="deployment-rows" {columns} rows={list.rows} striped>
    {#snippet row(deployment)}
      <tr>
        {#each cols as c}
          <td data-col={c.name}><Cell value={deployment[c.name]} column={c} record={deployment} /></td>
        {/each}
        <td><Button variant="ghost" href={`/deployments/${deployment.id}/`}>Open</Button></td>
      </tr>
    {/snippet}
  </Table>
  {#if list.hasMore}
    <Button variant="ghost" id="deployment-more" onclick={list.more}>Load more</Button>
  {/if}
{/if}

{#if omitted.length}
  <p class="text-sm text-muted" id="deployment-omitted">
    Not shown: {omitted.map(o => o.name).join(', ')} — each with a reason.
    <code>workspaceId</code> is among them because the read is already scoped by
    it, so it holds the same value in every row above.
  </p>
{/if}
