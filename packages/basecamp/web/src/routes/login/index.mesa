---
title: Sign in
---
<script>
  import { goto } from '@frontierjs/sierra/router'
  import { signIn } from '../../session.js'

  // A plain `let` is already component state — it must NOT go in a `$:` path
  // watch, which is for fields of plain objects (Mesa RULE 43). Listing one
  // there compiles, then throws `$runtime.get(...) is not a function` on mount.
  let email    = ''
  let password = ''
  let error    = null
  let busy     = false

  async function submit(e) {
    e.preventDefault()
    error = null
    busy  = true
    try {
      await signIn(email, password)
      goto('/')
    } catch (err) {
      // 401 from /auth/login is a wrong password, not a broken app. Anything
      // else carries its own message — including "API not reachable".
      error = err.status === 401 ? 'Wrong email or password.' : err.message
    } finally {
      busy = false
    }
  }
</script>

<div class="section-header">
  <h1>Sign in</h1>
  <span class="text-sm text-muted">Basecamp</span>
</div>

<!-- .container.narrow caps at --container-narrow: a form stretched to a
     1280px screen is a wall, not a form. The width is a vocabulary term,
     not a number chosen here. -->
<div class="container narrow">
  <form class="card stack" on:submit={submit}>
  {#if error}
    <article class="alert danger">
      <div class="alert-content">{error}</div>
    </article>
  {/if}

  <div class="field-group">
    <label for="email">Email</label>
    <input class="field" id="email" type="email" autocomplete="username"
           bind:value={email} required />
  </div>

  <div class="field-group">
    <label for="password">Password</label>
    <input class="field" id="password" type="password" autocomplete="current-password"
           bind:value={password} required />
  </div>

  <div class="cluster">
    <button class="btn primary" type="submit" disabled={busy}>
      {busy ? 'Signing in…' : 'Sign in'}
    </button>
  </div>
  </form>
</div>
