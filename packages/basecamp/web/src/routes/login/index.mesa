---
title: Sign in
---
<script>
  import { goto, page } from '@frontierjs/sierra/router'
  import Form   from '@frontierjs/ui/components/forms/Form.mesa'
  import Input  from '@frontierjs/ui/components/forms/Input.mesa'
  import Button from '@frontierjs/ui/components/forms/Button.mesa'
  import { session, signIn, submitCode, signOut } from '../../session.js'
  import Alert from '@frontierjs/ui/components/feedback/Alert.mesa'

  // Why the guard sent somebody here, when it was not because they are signed
  // out. `restore()` leaves anything that is NOT a 401 on `session.error` —
  // a 401 means the token expired and clears silently — so this is the API
  // being unreachable, or answering something nobody expected. Without it the
  // person is shown a plain sign-in form while the real problem is that the
  // server is down, and typing a correct password does nothing.
  //
  // `session.js` already recorded that this screen is where the reason should
  // surface. It said so and nothing here read it.
  $: (session.error, session.awaitingCode)

  // A plain `let` is already component state — it must NOT go in a `$:` path
  // watch, which is for fields of plain objects (Mesa RULE 43). Listing one
  // there compiles, then throws `$runtime.get(...) is not a function` on mount.
  let email    = ''
  let password = ''
  let code     = ''

  // <Form> owns the in-flight flag, the form-level message and the submit
  // guard, so none of the three is declared here. There is no resource behind
  // this one — signing in is not a write to a model — which is the shape Form
  // supports through `onsubmit` + `mapErrors`.
  // Where to land. `?next=` exists for one caller and it is not a convenience:
  // an invitation to an address that already has an account cannot be accepted
  // signed out, so the invite screen sends the person here and needs them back
  // on the same link afterwards. Confined to a same-origin PATH — an open
  // redirect on a login screen is how a phishing link borrows a real domain.
  function landing() {
    const next = page.query?.next
    return typeof next === 'string' && next.startsWith('/') && !next.startsWith('//') ? next : '/'
  }

  // A password accepted for an account with a second factor signs nobody in:
  // `session.awaitingCode` is set and the code box below replaces the form.
  async function submit() {
    await signIn(email, password)
    if (session.awaitingCode) { password = ''; return }
    goto(landing())
  }

  async function verify() {
    await submitCode(code.trim())
    code = ''
    goto(landing())
  }

  // `retryable: false` closes the box inside sierra, so a spent attempt falls
  // back to the password form on its own; this is the person choosing to.
  async function startOver() {
    code = ''
    await signOut()
  }

  function mapCodeErrors(err) {
    const status = err.code ?? err.status
    return { fields: {}, message: status === 401 ? 'That code was not accepted.' : err.message }
  }

  const lapses = (iso) => new Date(iso).toLocaleTimeString([], { hour: '2-digit', minute: '2-digit' })

  // 401 from /auth/login is a wrong password, not a broken app. The client
  // carries the status on `code`; anything else keeps the server's own
  // message — including "API not reachable".
  function mapErrors(err) {
    const status = err.code ?? err.status
    return { fields: {}, message: status === 401 ? 'Wrong email or password.' : err.message }
  }
</script>

<div class="section-header">
  <h1>Sign in</h1>
  <span class="text-sm text-muted">Basecamp</span>
</div>

<!-- .container.narrow caps at --container-narrow: a form stretched to a
     1280px screen is a wall, not a form. The width is a vocabulary term,
     not a number chosen here. -->
<div class="container narrow">
  {#if session.error}
    <Alert tone="warning" id="session-error" title="Could not reach the server">
      {session.error}
    </Alert>
  {/if}

  {#if session.awaitingCode}
  <!-- `one-time-code` is what lets a phone offer the code from the message it
       just received. -->
  <Form class="card stack" id="code-form" onsubmit={verify} mapErrors={mapCodeErrors} errorTitle="Sign in failed">
    <p class="text-sm text-muted">
      Enter the code from your authenticator app. A recovery code works here too.
      This attempt lapses at {lapses(session.awaitingCode)}.
    </p>
    <Input id="code" name="code" label="Code" autocomplete="one-time-code" inputmode="numeric"
           required bind:value={code} />

    <div class="cluster">
      <Button type="submit" variant="primary">Verify</Button>
      <Button type="button" variant="ghost" id="code-cancel" onclick={startOver}>Start over</Button>
    </div>
  </Form>
  {:else}
  <Form class="card stack" onsubmit={submit} {mapErrors} errorTitle="Sign in failed">
    <!-- `id` is stated, not derived: the kit falls back to a generated uid, and
         a control whose id changes per render is one a label, an
         aria-describedby and any test can only reach by accident. -->
    <Input id="email" name="email" label="Email" type="email" autocomplete="username"
           required bind:value={email} />

    <!-- type="password" is all the reveal toggle needs; the kit draws it. -->
    <Input id="password" name="password" label="Password" type="password" autocomplete="current-password"
           required bind:value={password} />

    <div class="cluster">
      <Button type="submit" variant="primary">Sign in</Button>
      <a href="/reset-password/" class="text-sm" id="forgot-password">Forgot password?</a>
    </div>
  </Form>
  {/if}
</div>
