---
title: Secrets
---
<script>
  // The mock's SSHKeysView, widened to what the model actually is: a Secret is
  // any credential BASECAMP presents to a machine — an SSH key, a provider
  // token, registry auth, a TLS cert. A Credential, by contrast, is how a
  // PERSON proves identity to Basecamp and belongs to @frontierjs/auth.
  //
  // **The value is never on this page, and not because this file hides it.**
  // `Secret.data` is `@encrypted`, so Litestone omits the key from every read
  // at the Data boundary — a listed row has no `data` property at all. There is
  // no redaction code here on purpose: a second owner of that rule is a rule
  // that eventually disagrees with itself.
  import { session } from '../../lib/session.js'
  import { secrets } from '../../resources/Secret.mesa'
  import { day } from '../../lib/datetime.js'

  import Badge      from '@frontierjs/ui/components/display/Badge.mesa'
  import Button     from '@frontierjs/ui/components/forms/Button.mesa'
  import Callout    from '@frontierjs/ui/components/display/Callout.mesa'
  import Card       from '@frontierjs/ui/components/layout/Card.mesa'
  import Drawer     from '@frontierjs/ui/components/overlay/Drawer.mesa'
  import EmptyState from '@frontierjs/ui/components/display/EmptyState.mesa'
  import Form       from '@frontierjs/ui/components/forms/Form.mesa'
  import Input      from '@frontierjs/ui/components/forms/Input.mesa'
  import Pill       from '@frontierjs/ui/components/display/Pill.mesa'
  import RadioGroup from '@frontierjs/ui/components/forms/RadioGroup.mesa'
  import Select     from '@frontierjs/ui/components/forms/Select.mesa'
  import Textarea   from '@frontierjs/ui/components/forms/Textarea.mesa'
  import { toasts } from '@frontierjs/ui/stores/toastStore'
  import Table from '@frontierjs/ui/components/display/Table.mesa'
  import { page } from '@frontierjs/sierra/router'
  import { offerUndo } from '../../resources/Trash.mesa'

  $: session.workspaceId

  let rows     = []
  let error    = null
  let loading  = true
  let busy     = null
  let creating = page.query?.new !== undefined
  // ⌘K's New … entries land here with ?new, on this route or from another.
  $: page.query, () => { if (page.query?.new !== undefined) creating = true }
  let filter   = ''
  let draft    = blankDraft()
  let entry    = blankEntry()
  // Once the person edits the name, the vendor or kind stops suggesting one.
  let nameTouched = false

  // Read off the schema, not typed out. `custom` is excluded: it is the value
  // meaning *no cloud*, which is exactly what a provider key may not be.
  $: vendors = (secrets.fields?.providerKind?.enum ?? []).filter(k => k !== 'custom')

  // The kit's controls take a value and hand back an event; they are NOT bound
  // to `draft[name]`, because `bind:` on a COMPONENT needs a writable top-level
  // let and a member expression is not one. Replacing the object rather than
  // mutating it is what makes the change reactive.
  //
  // `name` on each control is what lets <Form> route a server message back to
  // it — the form reads `e.target.name` off its one input listener.
  function write(name, value) {
    draft = { ...draft, [name]: value }
  }

  // ─── What a person authors here ──────────────────────────────────────
  // One table: the kinds offered, the fields each one's value is typed into,
  // and how those fields become the `data` string the server stores. A
  // notification, backup or tls_cert secret is written by Channels, Backups
  // and Domains, so it lists below and is never offered here.
  //
  // `data` is sent as text, and for a provider key the bare token: the server
  // wraps it as {"token":…}. A `{}` default is refused for every kind by
  // `complete`, because a secret that stores nothing is a name.
  // A function declaration: `entry` is made above this table, at declaration.
  function newPair() { return { id: Math.random().toString(36).slice(2), key: '', value: '' } }
  const has = (s) => !!String(s ?? '').trim()
  const all = (...names) => (st) => names.every(n => has(st.values[n]))
  const usedPairs = (st) => st.pairs.filter(p => has(p.key) || has(p.value))

  const SPECS = {
    provider_key: {
      label: 'Provider key', description: 'A token for a cloud, edge or forge account.',
      suggest: null,
      fields: [{ name: 'token', label: 'API token', control: 'password' }],
      complete: all('token'),
      encode: (st) => st.values.token.trim(),
    },
    ssh_key: {
      label: 'SSH key', description: 'A private key Basecamp presents to a machine.',
      suggest: 'ssh-key',
      fields: [{ name: 'privateKey', label: 'Private key', control: 'textarea' }],
      complete: all('privateKey'),
      encode: (st) => st.values.privateKey,
    },
    registry_auth: {
      label: 'Registry auth', description: 'A login for a container registry.',
      suggest: 'registry',
      fields: [
        { name: 'host',     label: 'Registry host',        control: 'text' },
        { name: 'username', label: 'Username',             control: 'text' },
        { name: 'password', label: 'Password or token',    control: 'password' },
      ],
      complete: all('host', 'username', 'password'),
      encode: (st) => JSON.stringify({
        host: st.values.host.trim(), username: st.values.username.trim(), password: st.values.password,
      }),
    },
    generic: {
      label: 'Generic', description: 'Any other values, as named keys.',
      suggest: 'secret',
      fields: [{ control: 'pairs' }],
      complete: (st) => st.rawMode
        ? has(st.raw)
        : usedPairs(st).length > 0 && usedPairs(st).every(p => has(p.key) && has(p.value)),
      encode: (st) => st.rawMode
        ? st.raw
        : JSON.stringify(Object.fromEntries(usedPairs(st).map(p => [p.key.trim(), p.value]))),
    },
  }
  const MANAGED_BY = { notification: 'Channels', backup: 'Backups', tls_cert: 'Domains' }
  const authored   = Object.entries(SPECS).map(([value, k]) => ({ value, label: k.label, description: k.description }))

  function blankEntry() {
    return { values: {}, pairs: [newPair()], rawMode: false, raw: '' }
  }
  function blankDraft() {
    return { ...secrets.make(), kind: 'provider_key', providerKind: undefined, name: '', data: '' }
  }
  const isEmpty = (st) => Object.values(st.values).every(v => !has(v))
    && st.pairs.every(p => !has(p.key) && !has(p.value)) && !has(st.raw)

  // The secrets screen's own value fields, shared by the add form and the
  // rotate drawer. Each replaces `entry` rather than mutating it.
  const setField = (st, update, name, v) => update({ values: { ...st.values, [name]: v } })
  const setPair  = (st, update, id, k, v) => update({ pairs: st.pairs.map(p => p.id === id ? { ...p, [k]: v } : p) })
  const addPair  = (st, update) => update({ pairs: [...st.pairs, newPair()] })
  const dropPair = (st, update, id) => {
    const left = st.pairs.filter(p => p.id !== id)
    update({ pairs: left.length ? left : [newPair()] })
  }
  function updateEntry(patch) {
    entry = { ...entry, ...patch }
    const spec = SPECS[draft.kind]
    draft = { ...draft, data: spec.complete(entry) ? spec.encode(entry) : '' }
  }

  // ─── Name ────────────────────────────────────────────────────────────
  // `Secret.name` is a lowercase label (the schema states the rule), so what
  // is typed is shaped into one as it lands rather than refused at submit.
  const shapeName = (s) => String(s ?? '').toLowerCase().replace(/[\s_]+/g, '-')

  function unique(base) {
    if (!base) return ''
    const taken = new Set(rows.map(r => r.name))
    let name = base, n = 2
    while (taken.has(name)) name = `${base}-${n++}`
    return name
  }
  function retitle() {
    if (nameTouched) return
    const base = draft.kind === 'provider_key' ? draft.providerKind : SPECS[draft.kind]?.suggest
    draft = { ...draft, name: unique(base) }
  }
  function pickKind(kind) {
    draft = { ...draft, kind, providerKind: kind === 'provider_key' ? draft.providerKind : undefined, data: '' }
    entry = blankEntry()
    retitle()
  }
  function pickVendor(providerKind) {
    draft = { ...draft, providerKind }
    retitle()
  }
  function typeName(e) {
    nameTouched = true
    const name = shapeName(e.target.value)
    e.target.value = name
    write('name', name)
  }

  // Every secret, not a page — the server refuses a page above its max.
  const list = secrets.tethered({ state: 'local', all: true })
  $: {
    rows    = list.rows
    loading = list.loading
    if (list.error) error = list.error.message
  }
  const load = () => list.reload()
  $: session.workspaceId, () => load()

  const READS = new Set(['get', 'find'])
  const off = secrets.service.on('*', (method, row) => {
    if (READS.has(method) || !row?.id) return
    load()
  })
  $.onDestroy(off)

  async function create() {
    error = null
    try {
      const spec = SPECS[draft.kind]
      if (!spec.complete(entry)) throw new Error('Fill in every value field — a secret with no value is just a name')
      const created = await secrets.service.create({
        name: draft.name, kind: draft.kind, data: spec.encode(entry),
        ...(draft.kind === 'provider_key' ? { providerKind: draft.providerKind } : {}),
      })
      toasts.success(`${created.name} stored`)
      creating = false
      draft = blankDraft()
      entry = blankEntry()
      nameTouched = false
      await load()
      // A new provider key is tested straight away, as a rotated one is.
      if (created.kind === 'provider_key') await verify(created)
    } catch (e) {
      error = e.message
      throw e
    }
  }

  // A provider key is TESTED — the connector asks the cloud — and a refusal
  // comes back as `verifiedAt: null` with a 200, so the answer is read and
  // said. Every other kind is a person vouching for it, and `tested` is how
  // the two are told apart.
  async function verify(secret) {
    error = null; busy = secret.id
    try {
      const updated = await secrets.service.invoke('verify', secret.id)
      const i = rows.findIndex(r => r.id === secret.id)
      if (i >= 0) rows = [...rows.slice(0, i), { ...rows[i], ...updated }, ...rows.slice(i + 1)]
      if (!updated.tested)        toasts.success(`${secret.name} marked verified`)
      else if (updated.verifiedAt) toasts.success(`${secret.providerKind} accepted ${secret.name}`)
      else                         toasts.error(`${secret.providerKind} refused ${secret.name} — the token is revoked or wrong`)
    } catch (e) {
      error = e.message
    } finally {
      busy = null
    }
  }

  // ─── Rotate ──────────────────────────────────────────────────────────
  // A new value on the SAME row. Everything that holds this secret holds its
  // id (`secret:<id>`), so a rotation reaches every one of them with nothing
  // re-pointed — where delete-and-add breaks each reference. The value is
  // write-only, so the box starts empty and a blank one keeps what is stored.
  let rotating    = null     // { id, name, kind, providerKind, version, entry }
  let rotateError = null
  let rotatingNow = false

  function startRotate(secret) {
    rotateError = null
    const { id, name, kind, providerKind, version } = secret
    rotating = { id, name, kind, providerKind, version, entry: blankEntry() }
  }
  const updateRotate = (patch) => rotating = { ...rotating, entry: { ...rotating.entry, ...patch } }

  async function saveRotate() {
    rotateError = null; rotatingNow = true
    try {
      const { id, name, kind, entry: st, version } = rotating
      const spec    = SPECS[kind]
      const entered = !isEmpty(st)
      if (entered && !spec.complete(st)) throw new Error('Fill in every value field, or leave them all empty to keep the current value')
      const value = entered ? spec.encode(st) : ''
      const updated = await secrets.service.patch(id, {
        name, ...(value ? { data: value } : {}), version,
      })
      toasts.success(value ? `${updated.name} rotated. It is unverified until it is tested again.` : `${updated.name} saved`)
      const kept = rotating
      rotating = null
      await load()
      // A rotated provider key is tested straight away: the next provision
      // would otherwise be the first thing to find out it is wrong.
      if (value && kept.kind === 'provider_key') await verify({ ...kept, name: updated.name })
    } catch (e) {
      rotateError = e.message
    } finally {
      rotatingNow = false
    }
  }

  async function remove(secret) {
    error = null; busy = secret.id
    try {
      await secrets.service.remove(secret.id)
      offerUndo(secret.name, secrets, secret.id, load)
      await load()
    } catch (e) {
      error = e.message
    } finally {
      busy = null
    }
  }

  $: kinds   = ['', ...new Set(rows.map(r => r.kind))]
  $: visible = filter ? rows.filter(r => r.kind === filter) : rows

  const KIND_LABEL = {
    ssh_key: 'SSH key', provider_key: 'Provider key', registry_auth: 'Registry auth',
    tls_cert: 'TLS certificate', notification: 'Notification', backup: 'Backup destination', generic: 'Generic',
  }
  const SECRET_COLUMNS = [
    { name: 'name',     label: 'Name' },
    { name: 'kind',     label: 'Kind' },
    { name: 'verified', label: 'Verified' },
    { name: 'added',    label: 'Added' },
    { name: 'actions',  label: 'Actions', hideLabel: true },
  ]
</script>

<div class="section-header">
  <h1>Secrets</h1>
  <Button tone="primary" id="new-secret" onclick={() => creating = !creating}>
    {creating ? 'Cancel' : 'Add a secret'}
  </Button>
</div>

{#snippet valueFields(kind, st, update, rotate)}
  {#each SPECS[kind].fields as f}
    {#if f.control === 'pairs'}
      {#if st.rawMode}
        <Textarea id="value-raw" label="Raw text" rows="6" required={!rotate} value={st.raw}
                  style="font-family: var(--font-mono)"
                  hint="Sent exactly as typed — usually a JSON object."
                  oninput={(e) => update({ raw: e.target.value })} />
      {:else}
        <div class="stack">
          <span class="text-sm">Values{rotate ? '' : ' *'}</span>
          {#each st.pairs as p (p.id)}
            <div class="cluster">
              <Input id={`value-key-${p.id}`} label="" placeholder="Key" aria-label="Key" value={p.key}
                     oninput={(e) => setPair(st, update, p.id, 'key', e.target.value)} />
              <Input id={`value-val-${p.id}`} label="" type="password" placeholder="Value" aria-label="Value" value={p.value}
                     oninput={(e) => setPair(st, update, p.id, 'value', e.target.value)} />
              <Button treatment="ghost" aria-label="Remove row" onclick={() => dropPair(st, update, p.id)}>Remove</Button>
            </div>
          {/each}
          <div class="cluster">
            <Button treatment="ghost" onclick={() => addPair(st, update)}>Add a row</Button>
          </div>
        </div>
      {/if}
      <div class="cluster">
        <Button treatment="ghost" onclick={() => update({ rawMode: !st.rawMode })}>
          {st.rawMode ? 'Edit as rows' : 'Edit as raw text'}
        </Button>
      </div>
    {:else if f.control === 'textarea'}
      <Textarea id={`value-${f.name}`} label={f.label} rows="6" required={!rotate} value={st.values[f.name] ?? ''}
                style="font-family: var(--font-mono)"
                oninput={(e) => setField(st, update, f.name, e.target.value)} />
    {:else}
      <Input id={`value-${f.name}`} label={f.label} required={!rotate} type={f.control} autocomplete="off"
             value={st.values[f.name] ?? ''}
             oninput={(e) => setField(st, update, f.name, e.target.value)} />
    {/if}
  {/each}
{/snippet}

<Callout tone="info" title="Write-only by design">
  A secret's value is never shown again — rotate it to replace it.
  <details>
    <summary>Why</summary>
    A secret's value is encrypted at rest and never comes back from the API — not masked,
    not truncated: the key is absent from the response. Rotating one replaces the value
    in place, and a rotated secret is unverified again until something proves otherwise.
  </details>
</Callout>

{#if error}
  <!-- id'd because the shell's notice bar is also `.alert.danger`: a check
       looking for "the screen reported a refusal" would otherwise match a
       fleet notice and pass, or fail, for reasons this screen never caused. -->
  <article class="alert danger" id="screen-error">
    <div class="alert-content">{error}</div>
  </article>
{/if}

{#if creating}
  <Card>
    <Form resource={secrets} bind:record={draft} onsubmit={create}>
      <RadioGroup name="kind" label="Kind" items={authored} value={draft.kind}
                  onchange={(v) => pickKind(v)} />

      <!-- Only for a provider key, and REQUIRED there — `@@check` on `Secret`
           refuses one that names no cloud. Without this field the kind is
           offerable and unsavable: the boundary answers correctly and the
           person has nothing to change.

           The options come off the resource rather than being typed out, so a
           `ProviderKind` the schema gains appears here without an edit; `custom`
           is filtered because a provider key at no provider is what the check
           exists to refuse. -->
      {#if draft.kind === 'provider_key'}
        <Select name="providerKind" id="providerKind" label="Vendor" required
                placeholder="Which cloud does this key open?"
                options={vendors} value={draft.providerKind ?? ''}
                oninput={(e) => pickVendor(e.target.value)}
                hint="Basecamp reads this account's regions and sizes when you provision a machine." />
      {/if}

      {@render valueFields(draft.kind, entry, updateEntry, false)}

      <Input name="name" id="name" label="Name" value={draft.name}
             hint="Lowercase letters, digits and dashes — a label you pick from, never an env var."
             oninput={typeName} />
      <Button type="submit" tone="primary">Store secret</Button>
    </Form>
  </Card>
{/if}

{#if loading}
  <p class="text-sm text-muted">Loading…</p>
{:else if !rows.length}
  <EmptyState title="No secrets">
    Nothing in this workspace holds a credential yet.
  </EmptyState>
{:else}
  {#if kinds.length > 2}
    <div class="cluster">
      <label class="visually-hidden" for="secret-kind">Filter by kind</label>
      <Select id="secret-kind" value={filter} placeholder="All kinds"
              options={kinds.filter(Boolean).map(k => ({ value: k, label: KIND_LABEL[k] ?? k }))}
              onchange={(e) => filter = e.target.value} />
    </div>
  {/if}

  <Table id="secret-rows" columns={SECRET_COLUMNS} rows={visible} striped>
    {#snippet row(s)}
      <tr>
        <td>{s.name}</td>
        <td><Pill>{KIND_LABEL[s.kind] ?? s.kind}</Pill></td>
        <td>
          {#if s.verifiedAt}
            <Badge tone="success">verified</Badge>
          {:else}
            <Badge tone="muted">unverified</Badge>
          {/if}
        </td>
        <td class="text-sm text-muted">{day(s.createdAt)}</td>
        <td>
          <div class="cluster">
            {#if s.kind === 'provider_key'}
              <Button treatment="ghost" disabled={busy === s.id} onclick={() => verify(s)}>
                {s.verifiedAt ? 'Re-test' : 'Test'}
              </Button>
            {:else if !s.verifiedAt}
              <Button treatment="ghost" disabled={busy === s.id} onclick={() => verify(s)}>Mark verified</Button>
            {/if}
            {#if SPECS[s.kind]}
              <Button treatment="ghost" disabled={busy === s.id}
                      aria-label={`Rotate ${s.name}`} onclick={() => startRotate(s)}>Rotate</Button>
            {:else}
              <span class="text-sm text-muted">Managed by {MANAGED_BY[s.kind] ?? 'its own screen'}</span>
            {/if}
            <Button treatment="ghost" disabled={busy === s.id}
                    aria-label={`Delete ${s.name}`}
                    data-confirm={`Anything that reads ${s.name} stops working until it is given another.`}
                    data-confirm-title="Delete this secret?" data-confirm-label="Delete"
                    onclick={() => remove(s)}>Delete</Button>
          </div>
        </td>
      </tr>
    {/snippet}
  </Table>
{/if}

<Drawer open={!!rotating} title={rotating ? `Rotate ${rotating.name}` : ''} onclose={() => rotating = null}>
  {#if rotating}
    <form class="stack" id="secret-rotate" novalidate onsubmit={e => { e.preventDefault(); saveRotate() }}>
      {#if rotateError}
        <article class="alert danger" id="rotate-error"><div class="alert-content">{rotateError}</div></article>
      {/if}
      <p class="text-sm text-muted">
        Everything that uses this secret picks up the new value on its next use. The old value
        is not shown and cannot be recovered. Leave empty to keep the current value.
      </p>
      <Input id="rotate-name" name="name" label="Name" value={rotating.name}
             oninput={(e) => rotating = { ...rotating, name: shapeName(e.target.value) }} />
      {@render valueFields(rotating.kind, rotating.entry, updateRotate, true)}
      <div class="cluster">
        <Button type="submit" tone="primary" id="rotate-save" disabled={rotatingNow}>
          {rotatingNow ? 'Saving…' : isEmpty(rotating.entry) ? 'Save' : 'Rotate'}
        </Button>
        <Button treatment="ghost" onclick={() => rotating = null}>Cancel</Button>
      </div>
    </form>
  {/if}
</Drawer>
