---
title: Secrets
---
<script>
  // The mock's SSHKeysView, widened to what the model actually is: a Secret is
  // any credential BASECAMP presents to a machine — an SSH key, a provider
  // token, registry auth, a TLS cert. A Credential, by contrast, is how a
  // PERSON proves identity to Basecamp and belongs to @frontierjs/auth.
  //
  // **The value is never on this page, and not because this file hides it.**
  // `Secret.data` is `@encrypted`, so Litestone omits the key from every read
  // at the Data boundary — a listed row has no `data` property at all. There is
  // no redaction code here on purpose: a second owner of that rule is a rule
  // that eventually disagrees with itself.
  import { session } from '../../session.js'
  import { secrets } from '../../resources/Secret.mesa'
  import { day } from '../../datetime.js'

  import Badge      from '@frontierjs/ui/components/display/Badge.mesa'
  import Button     from '@frontierjs/ui/components/forms/Button.mesa'
  import Callout    from '@frontierjs/ui/components/display/Callout.mesa'
  import Card       from '@frontierjs/ui/components/layout/Card.mesa'
  import Drawer     from '@frontierjs/ui/components/overlay/Drawer.mesa'
  import EmptyState from '@frontierjs/ui/components/display/EmptyState.mesa'
  import Form       from '@frontierjs/ui/components/forms/Form.mesa'
  import Input      from '@frontierjs/ui/components/forms/Input.mesa'
  import Pill       from '@frontierjs/ui/components/display/Pill.mesa'
  import Select     from '@frontierjs/ui/components/forms/Select.mesa'
  import Textarea   from '@frontierjs/ui/components/forms/Textarea.mesa'
  import { toasts } from '@frontierjs/ui/stores/toastStore.js'
  import Table from '@frontierjs/ui/components/display/Table.mesa'
  import { page } from '@frontierjs/sierra/router'
  import { offerUndo } from '../../resources/Trash.mesa'

  $: session.workspaceId

  let rows     = []
  let error    = null
  let loading  = true
  let busy     = null
  let creating = page.query?.new !== undefined
  // ⌘K's New … entries land here with ?new, on this route or from another.
  $: page.query, () => { if (page.query?.new !== undefined) creating = true }
  let filter   = ''
  let draft    = secrets.make()

  // Read off the schema, not typed out. `custom` is excluded: it is the value
  // meaning *no cloud*, which is exactly what a provider key may not be.
  $: clouds = (secrets.fields?.providerKind?.enum ?? []).filter(k => k !== 'custom')

  // The kit's controls take a value and hand back an event; they are NOT bound
  // to `draft[name]`, because `bind:` on a COMPONENT needs a writable top-level
  // let and a member expression is not one. Replacing the object rather than
  // mutating it is what makes the change reactive.
  //
  // `name` on each control is what lets <Form> route a server message back to
  // it — the form reads `e.target.name` off its one input listener.
  function write(name, value) {
    draft = { ...draft, [name]: value }
  }

  async function load() {
    error = null; loading = true
    try {
      rows = (await secrets.service.find({}, { limit: 200 })).data
    } catch (e) {
      error = e.message
    } finally {
      loading = false
    }
  }

  load()
  $: session.workspaceId, () => load()

  const READS = new Set(['get', 'find'])
  const off = secrets.service.on('*', (method, row) => {
    if (READS.has(method) || !row?.id) return
    load()
  })
  $.onDestroy(off)

  async function create(data) {
    error = null
    try {
      const created = await secrets.service.create(data)
      toasts.success(`${created.name} stored`)
      creating = false
      draft = secrets.make()
      await load()
    } catch (e) {
      error = e.message
      throw e
    }
  }

  // A provider key is TESTED — the connector asks the cloud — and a refusal
  // comes back as `isVerified: false` with a 200, so the answer is read and
  // said. Every other kind is a person vouching for it, and `tested` is how
  // the two are told apart.
  async function verify(secret) {
    error = null; busy = secret.id
    try {
      const updated = await secrets.service.invoke('verify', secret.id)
      const i = rows.findIndex(r => r.id === secret.id)
      if (i >= 0) rows = [...rows.slice(0, i), { ...rows[i], ...updated }, ...rows.slice(i + 1)]
      if (!updated.tested)        toasts.success(`${secret.name} marked verified`)
      else if (updated.isVerified) toasts.success(`${secret.providerKind} accepted ${secret.name}`)
      else                         toasts.error(`${secret.providerKind} refused ${secret.name} — the token is revoked or wrong`)
    } catch (e) {
      error = e.message
    } finally {
      busy = null
    }
  }

  // ─── Rotate ──────────────────────────────────────────────────────────
  // A new value on the SAME row. Everything that holds this secret holds its
  // id (`secret:<id>`), so a rotation reaches every one of them with nothing
  // re-pointed — where delete-and-add breaks each reference. The value is
  // write-only, so the box starts empty and a blank one keeps what is stored.
  let rotating    = null     // { id, name, kind, providerKind, version, value }
  let rotateError = null
  let rotatingNow = false

  function startRotate(secret) {
    rotateError = null
    const { id, name, kind, providerKind, version } = secret
    rotating = { id, name, kind, providerKind, version, value: '' }
  }

  async function saveRotate() {
    rotateError = null; rotatingNow = true
    try {
      const { id, name, value, version } = rotating
      const updated = await secrets.service.patch(id, {
        name, ...(value ? { data: value } : {}), version,
      })
      toasts.success(value ? `${updated.name} rotated. It is unverified until it is tested again.` : `${updated.name} saved`)
      const kept = rotating
      rotating = null
      await load()
      // A rotated provider key is tested straight away: the next provision
      // would otherwise be the first thing to find out it is wrong.
      if (value && kept.kind === 'provider_key') await verify({ ...kept, name: updated.name })
    } catch (e) {
      rotateError = e.message
    } finally {
      rotatingNow = false
    }
  }

  async function remove(secret) {
    error = null; busy = secret.id
    try {
      await secrets.service.remove(secret.id)
      offerUndo(secret.name, secrets, secret.id, load)
      await load()
    } catch (e) {
      error = e.message
    } finally {
      busy = null
    }
  }

  $: kinds   = ['', ...new Set(rows.map(r => r.kind))]
  $: visible = filter ? rows.filter(r => r.kind === filter) : rows

  const KIND_LABEL = {
    ssh_key: 'SSH key', provider_key: 'Provider key', registry_auth: 'Registry auth',
    tls_cert: 'TLS certificate', notification: 'Notification', generic: 'Generic',
  }
  // Read off the schema, so a kind `SecretKind` gains is offered without an edit.
  $: secretKinds = (secrets.fields?.kind?.enum ?? Object.keys(KIND_LABEL))
       .map(k => ({ value: k, label: KIND_LABEL[k] ?? k }))
  const SECRET_COLUMNS = [
    { name: 'name',     label: 'Name' },
    { name: 'kind',     label: 'Kind' },
    { name: 'verified', label: 'Verified' },
    { name: 'added',    label: 'Added' },
    { name: 'actions',  label: 'Actions', hideLabel: true },
  ]
</script>

<div class="section-header">
  <h1>Secrets</h1>
  <Button variant="primary" id="new-secret" onclick={() => creating = !creating}>
    {creating ? 'Cancel' : 'Add a secret'}
  </Button>
</div>

<Callout tone="info" title="Write-only by design">
  A secret's value is encrypted at rest and never comes back from the API — not masked,
  not truncated: the key is absent from the response. Rotating one replaces the value
  in place, and a rotated secret is unverified again until something proves otherwise.
</Callout>

{#if error}
  <!-- id'd because the shell's notice bar is also `.alert.danger`: a check
       looking for "the screen reported a refusal" would otherwise match a
       fleet notice and pass, or fail, for reasons this screen never caused. -->
  <article class="alert danger" id="screen-error">
    <div class="alert-content">{error}</div>
  </article>
{/if}

{#if creating}
  <Card>
    <Form resource={secrets} bind:record={draft} onsubmit={create}>
      <Input name="name" id="name" value={draft.name}
             oninput={(e) => write('name', e.target.value)} />
      <Select name="kind" id="kind" options={secretKinds}
              value={draft.kind} oninput={(e) => write('kind', e.target.value)} />

      <!-- Only for a provider key, and REQUIRED there — `@@check` on `Secret`
           refuses one that names no cloud. Without this field the kind is
           offerable and unsavable: the boundary answers correctly and the
           person has nothing to change.

           The options come off the resource rather than being typed out, so a
           `ProviderKind` the schema gains appears here without an edit; `custom`
           is filtered because a provider key at no provider is what the check
           exists to refuse. -->
      {#if draft.kind === 'provider_key'}
        <Select name="providerKind" id="providerKind" label="Cloud" required
                placeholder="Which cloud does this key open?"
                options={clouds} value={draft.providerKind ?? ''}
                oninput={(e) => write('providerKind', e.target.value)}
                hint="Basecamp reads this account's regions and sizes when you provision a machine." />
      {/if}
      <Textarea name="data" id="data" label="Value" rows="4" value={draft.data}
                oninput={(e) => write('data', e.target.value)} />
      <Button type="submit" variant="primary">Store secret</Button>
    </Form>
  </Card>
{/if}

{#if loading}
  <p class="text-sm text-muted">Loading…</p>
{:else if !rows.length}
  <EmptyState title="No secrets">
    Nothing in this workspace holds a credential yet.
  </EmptyState>
{:else}
  {#if kinds.length > 2}
    <div class="cluster">
      <label class="visually-hidden" for="secret-kind">Filter by kind</label>
      <Select id="secret-kind" value={filter} placeholder="All kinds"
              options={kinds.filter(Boolean).map(k => ({ value: k, label: KIND_LABEL[k] ?? k }))}
              onchange={(e) => filter = e.target.value} />
    </div>
  {/if}

  <Table id="secret-rows" columns={SECRET_COLUMNS} rows={visible} striped>
    {#snippet row(s)}
      <tr>
        <td>{s.name}</td>
        <td><Pill>{KIND_LABEL[s.kind] ?? s.kind}</Pill></td>
        <td>
          {#if s.isVerified}
            <Badge tone="success">verified</Badge>
          {:else}
            <Badge tone="muted">unverified</Badge>
          {/if}
        </td>
        <td class="text-sm text-muted">{day(s.createdAt)}</td>
        <td>
          <div class="cluster">
            {#if s.kind === 'provider_key'}
              <Button variant="ghost" disabled={busy === s.id} onclick={() => verify(s)}>
                {s.isVerified ? 'Re-test' : 'Test'}
              </Button>
            {:else if !s.isVerified}
              <Button variant="ghost" disabled={busy === s.id} onclick={() => verify(s)}>Mark verified</Button>
            {/if}
            <Button variant="ghost" disabled={busy === s.id}
                    aria-label={`Rotate ${s.name}`} onclick={() => startRotate(s)}>Rotate</Button>
            <Button variant="ghost" disabled={busy === s.id}
                    aria-label={`Delete ${s.name}`}
                    data-confirm={`Anything that reads ${s.name} stops working until it is given another.`}
                    data-confirm-title="Delete this secret?" data-confirm-label="Delete"
                    onclick={() => remove(s)}>Delete</Button>
          </div>
        </td>
      </tr>
    {/snippet}
  </Table>
{/if}

<Drawer open={!!rotating} title={rotating ? `Rotate ${rotating.name}` : ''} onclose={() => rotating = null}>
  {#if rotating}
    <form class="stack" id="secret-rotate" novalidate onsubmit={e => { e.preventDefault(); saveRotate() }}>
      {#if rotateError}
        <article class="alert danger" id="rotate-error"><div class="alert-content">{rotateError}</div></article>
      {/if}
      <p class="text-sm text-muted">
        Everything that uses this secret picks up the new value on its next use. The old value
        is not shown and cannot be recovered.
      </p>
      <Input id="rotate-name" name="name" label="Name" value={rotating.name}
             oninput={(e) => rotating = { ...rotating, name: e.target.value }} />
      <Textarea id="rotate-value" name="data" label="New value" rows="4" value={rotating.value}
                hint="Leave empty to keep the current value"
                oninput={(e) => rotating = { ...rotating, value: e.target.value }} />
      <div class="cluster">
        <Button type="submit" variant="primary" id="rotate-save" disabled={rotatingNow}>
          {rotatingNow ? 'Saving…' : rotating.value ? 'Rotate' : 'Save'}
        </Button>
        <Button variant="ghost" onclick={() => rotating = null}>Cancel</Button>
      </div>
    </form>
  {/if}
</Drawer>
