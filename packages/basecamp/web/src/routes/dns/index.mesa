---
title: DNS & edge
---
<script>
  // Where the mock's CloudflareView goes, named for the job rather than the
  // vendor the mock drew — a screen called Cloudflare could only ever hold one.
  //
  // Two halves of one fact. A `Domain` row IS the hostname this app intends to
  // serve, its certificate and whether it is proxied; the zone's records are
  // what the edge actually answers. The second half comes from a workspace's
  // edge ACCOUNT through the `edge` service, and the value of the screen is the
  // two disagreeing — a hostname with no record resolves nowhere.
  import { session } from '../../lib/session.js'
  import Domain, { domains } from '../../resources/Domain.mesa'
  import DomainRoute, { domainRoutes } from '../../resources/DomainRoute.mesa'
  import { apps } from '../../resources/App.mesa'
  import { portal } from '../../resources/Portal.mesa'
  import { edge } from '../../resources/Edge.mesa'
  import { workspaces } from '../../resources/Workspace.mesa'

  import Badge      from '@frontierjs/ui/components/display/Badge.mesa'
  import Button     from '@frontierjs/ui/components/forms/Button.mesa'
  import Callout    from '@frontierjs/ui/components/display/Callout.mesa'
  import Card       from '@frontierjs/ui/components/layout/Card.mesa'
  import Drawer     from '@frontierjs/ui/components/overlay/Drawer.mesa'
  import { toasts } from '@frontierjs/ui/stores/toastStore'
  import EmptyState from '@frontierjs/ui/components/display/EmptyState.mesa'
  import Pill       from '@frontierjs/ui/components/display/Pill.mesa'
  import Skeleton   from '@frontierjs/ui/components/feedback/Skeleton.mesa'
  import Table      from '@frontierjs/ui/components/display/Table.mesa'

  $: session.workspaceId

  let rows     = []
  let appById  = new Map()
  let adapter  = null
  let accounts = []
  let ingress  = null         // { accountId, zoneId } — where every App's ingress record goes
  let error    = null
  let loading  = true

  // The zone being read, and what its read answered. Held apart from `load()`
  // so a refused zone shows its own error without taking the hostnames down.
  let picked    = null        // { accountId, zoneId }
  let zone      = null
  let zoneError = null
  let zoneBusy  = false

  // Both lists, every row of each rather than a page, because a hostname with
  // no app name beside it is an id in a column nobody can act on. `domains`
  // answers the app's id and not its name — the include is on the app's own
  // detail read.
  const list    = domains.tethered({ state: 'local', all: true })
  // Composed: the apps service includes each app's environment and domains.
  const appList = apps.tethered({ state: 'local', composed: true, directives: { limit: 100 } })
  const routeList = domainRoutes.tethered({ state: 'local', all: true })
  $: { rows = list.rows }
  $: { appById = new Map(appList.rows.map(a => [a.id, a])) }
  $: {
    const failed = list.error ?? appList.error ?? routeList.error
    if (failed) error = failed.message
  }

  async function load() {
    error = null; loading = true
    try {
      // `get` pings. A failure here must not take the hostname table with it —
      // the app's own rows are readable whether or not a vendor is.
      const entry = await portal.service.get('edge').catch(() => null)
      adapter = entry
      // Asked only once the portal says an account exists — an empty answer
      // from a workspace with none would read as a zone with nothing in it.
      const answer = adapter?.configured
        ? await edge.service.invoke('zones', null).catch(e => { zoneError = e.message; return { accounts: [], ingress: null } })
        : { accounts: [], ingress: null }
      accounts = answer.accounts
      ingress  = answer.ingress
      const first = accounts.find(a => a.zones?.length)
      if (!picked && first) readZone(first.id, first.zones[0].id)
    } catch (e) {
      error = e.message
    } finally {
      loading = false
    }
  }

  async function readZone(accountId, zoneId) {
    picked = { accountId, zoneId }; zoneBusy = true; zoneError = null
    try {
      zone = await edge.service.invoke('records', null, { accountId, zoneId })
    } catch (e) {
      zone = null; zoneError = e.message
    } finally {
      zoneBusy = false
    }
  }

  // The pair is written together, the schema's `@@check`; the Workspace's
  // `@version` is read fresh so a rename elsewhere is not overwritten.
  let ingressBusy  = false
  let ingressError = null
  async function useForIngress(accountId, zoneId) {
    ingressBusy = true; ingressError = null
    try {
      const ws = await workspaces.service.get(session.workspaceId)
      await workspaces.service.patch(ws.id, { ingressAccountId: accountId, ingressZoneId: zoneId, version: ws.version })
      ingress = { accountId, zoneId }
      toasts.success('Ingress zone set')
      readZone(accountId, zoneId)
    } catch (e) {
      ingressError = e.message
    } finally {
      ingressBusy = false
    }
  }

  // A hostname a push would write (`why` null) is pushed from here, since
  // nothing else pushes it until its Domain or its App's machines change.
  let pushingId = null
  async function push(d) {
    pushingId = d.id; zoneError = null
    try {
      await edge.service.invoke('sync', d.id)
      toasts.success(`${d.hostname} pushed`)
      readZone(picked.accountId, picked.zoneId)
    } catch (e) {
      zoneError = e.message
    } finally {
      pushingId = null
    }
  }

  load()
  $: session.workspaceId, () => { picked = null; zone = null; list.reload(); appList.reload(); routeList.reload(); load() }

  // The service decorates every row with cert_status — one definition, in
  // api/src/services/domains/domains.service.ts, so this screen and the notice
  // rules cannot disagree about what "expiring" means.
  const CERT_TONE = { active: 'success', expiring_soon: 'warning', expired: 'danger', none: 'muted' }
  const TONE      = { healthy: 'success', unconfigured: 'muted', unreachable: 'danger', degraded: 'warning' }
  const ZONE_TONE = { active: 'success', pending: 'warning' }

  const RECORD_COLUMNS = [
    { name: 'type',    label: 'Type' },
    { name: 'name',    label: 'Name' },
    { name: 'content', label: 'Content' },
    { name: 'edge',    label: 'Edge' },
    { name: 'served',  label: 'Hostname here' },
  ]
  const hostnameOf = (id) => rows.find(d => d.id === id)?.hostname
  $: missingTitle = zone?.missing.length === 1
    ? 'A hostname this workspace serves has no record'
    : `${zone?.missing.length} hostnames this workspace serves have no record`

  // An ingress record naming the wrong machines. `down` is an app on no online
  // machine at all, whose record is kept where it last ran (FJS-D567) — the
  // one a push cannot fix, so it is the red one.
  $: isIngress = !!picked && ingress?.accountId === picked.accountId && ingress?.zoneId === picked.zoneId

  $: down       = zone?.stale.filter(s => s.down) ?? []
  $: staleTitle = down.length
    ? `${down.length === 1 ? 'An app runs' : `${down.length} apps run`} on no online machine`
    : 'An ingress record names machines its app no longer runs on'

  $: proxied  = rows.filter(r => r.proxied).length
  $: expiring = rows.filter(r => r.cert_status === 'expiring_soon').length
  $: expired  = rows.filter(r => r.cert_status === 'expired').length

  // The edit form's `only=` is how a hostname is served. `appId` and the hostname move by delete-and-create and the
  // certificate columns by `uploadCert`, so neither is offered; the primary flag
  // is the app screen's Make primary, which demotes the sibling.
  let editing = null

  function saved() {
    editing = null
    toasts.success('Domain saved')
    list.reload()
    load()
  }

  // A prefix of a hostname that ANOTHER app answers (FJS-D1040) — `/api` to the
  // API app while the hostname's own app serves the rest. The hostname is fixed
  // once a route exists, so moving one is a remove and an add, and the service
  // refuses a prefix whose app is the hostname's own.
  let routing      = null     // {} to add, a route to edit
  let routeError   = null
  let removingId   = null
  $: routeRows = routeList.rows
  $: routable  = rows.filter(d => !d.redirectTo)

  function routeSaved() {
    routing = null
    toasts.success('Path route saved')
    routeList.reload()
    load()
  }

  async function removeRoute(r) {
    routeError = null; removingId = r.id
    try {
      await domainRoutes.service.remove(r.id)
      routeList.reload()
      load()
    } catch (e) {
      routeError = e.message
    } finally {
      removingId = null
    }
  }

  const ROUTE_COLUMNS = [
    { name: 'hostname', label: 'Hostname' },
    { name: 'prefix',   label: 'Path prefix' },
    { name: 'app',      label: 'Answered by' },
    { name: 'actions',  label: 'Actions', hideLabel: true },
  ]

  // A certificate is uploaded on the app screen, which holds the one form for
  // it; this links straight to that form for the hostname in question.
  const certHref = (d) => `/apps/${d.appId}/?tab=domains&cert=${d.id}`
  const NEEDS_CERT = new Set(['expiring_soon', 'expired', 'none'])

  const COLUMNS = [
    { name: 'hostname', label: 'Hostname' },
    { name: 'app',      label: 'App' },
    { name: 'cert',     label: 'Certificate' },
    { name: 'ssl',      label: 'SSL mode' },
    { name: 'edge',     label: 'Edge' },
    { name: 'actions',  label: 'Actions', hideLabel: true },
  ]
</script>

{#if error}
  <article class="alert danger" id="screen-error">
    <div class="alert-content">{error}</div>
  </article>
{/if}

{#if loading}
  <div aria-busy="true" class="stack">
    <Skeleton variant="text" width="12rem" />
    <Skeleton height="16rem" />
  </div>
{:else}
  <div class="tiles" style="--tile-min: 12rem" id="dns-tiles">
    <article class="tile">
      <div class="tile-label">Hostnames</div>
      <div class="tile-value">{rows.length}</div>
    </article>
    <article class="tile">
      <div class="tile-label">Proxied</div>
      <div class="tile-value">{proxied}</div>
      <div class="tile-delta muted">of {rows.length}</div>
    </article>
    <article class="tile">
      <div class="tile-label">Expiring soon</div>
      <div class="tile-value">{expiring}</div>
      <div class="tile-delta {expiring ? 'warning' : 'muted'}">within 30 days</div>
    </article>
    <article class="tile">
      <div class="tile-label">Expired</div>
      <div class="tile-value">{expired}</div>
      <div class="tile-delta {expired ? 'danger' : 'muted'}">serving a warning</div>
    </article>
  </div>

  <Card>
    <h2 class="h4">Hostnames this workspace serves</h2>
    {#if rows.length === 0}
      <EmptyState
        compact
        title="No hostnames yet"
      >
        A domain is added on an app, where the certificate and the primary flag live with it.
        {#snippet action()}
          <Button treatment="outlined" href="/projects/">Open a project</Button>
        {/snippet}
      </EmptyState>
    {:else}
      <Table id="dns-rows" columns={COLUMNS} rows={rows} striped>
        {#snippet row(d)}
          <tr>
            <td>
              <code>{d.hostname}</code>
              {#if d.isPrimary}<Badge tone="success">primary</Badge>{/if}
              {#if d.redirectTo}<Badge tone="muted">&rarr; {d.redirectTo}</Badge>{/if}
            </td>
            <td>
              {#if appById.get(d.appId)}
                <a href={`/apps/${d.appId}/`}>{appById.get(d.appId).name}</a>
              {:else}
                <span class="text-muted">—</span>
              {/if}
            </td>
            <td>
              <Pill tone={CERT_TONE[d.cert_status] ?? 'muted'}>{d.cert_status}</Pill>
              {#if d.cert_days_remaining !== null && d.cert_days_remaining !== undefined}
                <span class="text-sm text-muted">{d.cert_days_remaining}d</span>
              {/if}
            </td>
            <td><code>{d.sslMode}</code></td>
            <td>{d.proxied ? 'proxied' : 'direct'} · :{d.port}</td>
            <td>
              <span class="cluster">
                {#if NEEDS_CERT.has(d.cert_status)}
                  <Button treatment="outlined" href={certHref(d)} aria-label={`Upload a certificate for ${d.hostname}`}>
                    {d.cert_status === 'none' ? 'Add certificate' : 'Replace certificate'}
                  </Button>
                {/if}
                <Button treatment="ghost" aria-label={`Edit ${d.hostname}`} onclick={() => editing = d}>Edit</Button>
              </span>
            </td>
          </tr>
        {/snippet}
      </Table>
    {/if}
  </Card>

  <Card>
    <div class="section-header">
      <h2 class="h4">Path routes</h2>
      <Button treatment="outlined" id="route-add" disabled={routable.length === 0} onclick={() => routing = {}}>Add route</Button>
    </div>
    <p class="text-sm text-muted">
      A prefix of a hostname that another app answers — <code>/api</code> to the API app while the
      hostname's own app serves the rest, so the two share an origin. Both apps must run on the
      machine the zone points at.
    </p>
    {#if routeError}
      <article class="alert danger" id="route-error">
        <div class="alert-content">{routeError}</div>
      </article>
    {/if}
    {#if routeRows.length === 0}
      <p class="text-sm text-muted" id="route-empty">No hostname sends a prefix to a second app.</p>
    {:else}
      <Table id="route-rows" columns={ROUTE_COLUMNS} rows={routeRows} striped>
        {#snippet row(r)}
          <tr>
            <td><code>{hostnameOf(r.domainId) ?? r.domainId}</code></td>
            <td><code>{r.pathPrefix}</code></td>
            <td>
              {#if appById.get(r.appId)}
                <a href={`/apps/${r.appId}/`}>{appById.get(r.appId).name}</a>
              {:else}
                <span class="text-muted">—</span>
              {/if}
            </td>
            <td>
              <span class="cluster">
                <Button treatment="ghost" aria-label={`Edit ${r.pathPrefix}`} onclick={() => routing = r}>Edit</Button>
                <Button treatment="ghost" disabled={removingId === r.id}
                        aria-label={`Delete ${r.pathPrefix}`}
                        data-confirm={`${r.pathPrefix} on ${hostnameOf(r.domainId) ?? 'that hostname'} goes back to the hostname's own app.`}
                        data-confirm-title="Delete this route?" data-confirm-label="Delete"
                        onclick={() => removeRoute(r)}>Delete</Button>
              </span>
            </td>
          </tr>
        {/snippet}
      </Table>
    {/if}
  </Card>

  <Card>
    <div class="section-header">
      <h2 class="h4">From the edge provider</h2>
      <Pill tone={TONE[adapter?.status] ?? 'muted'} id="edge-status">{adapter?.status ?? 'unknown'}</Pill>
    </div>

    {#if adapter?.configured}
      {#each accounts as account}
        <section class="stack" id={`edge-account-${account.id}`}>
          <h3 class="h5">{account.name} <span class="text-sm text-muted">· {account.label}</span></h3>
          {#if account.error}
            <Callout tone="danger" title="The provider refused this account">
              <p class="text-body">{account.error}</p>
              <p class="text-body">Rotate or re-verify its token on <a href="/secrets/">Secrets</a>.</p>
            </Callout>
          {:else if account.zones.length === 0}
            <p class="text-sm text-muted">This token opens no zone.</p>
          {:else}
            <!-- Status only when not active: twenty identical "active" pills
                 hid the one zone that was pending. -->
            <ul class="zone-list" id="edge-zones">
              {#each account.zones as z}
                <li>
                  <Button
                    treatment={picked?.zoneId === z.id ? 'outlined' : 'ghost'}
                    aria-pressed={picked?.zoneId === z.id ? 'true' : 'false'}
                    onclick={() => readZone(account.id, z.id)}
                  ><span class="zone-name">{z.name}</span>{#if z.status !== 'active'} <Pill tone={ZONE_TONE[z.status] ?? 'muted'}>{z.status}</Pill>{/if}{#if ingress?.accountId === account.id && ingress?.zoneId === z.id} <Badge tone="success">ingress</Badge>{/if}</Button>
                </li>
              {/each}
            </ul>
          {/if}
        </section>
      {/each}

      {#if zoneError}
        <article class="alert danger" id="zone-error">
          <div class="alert-content">{zoneError}</div>
        </article>
      {:else if zoneBusy}
        <div aria-busy="true" class="stack">
          <Skeleton variant="text" width="70%" />
          <Skeleton variant="text" width="55%" />
        </div>
      {:else if zone}
        {#if zone.missing.length}
          <Callout tone="warning" title={missingTitle}>
            <ul id="zone-missing">
              {#each zone.missing as d}
                <li>
                  <code>{d.hostname}</code> — resolves nowhere in <code>{zone.zone.name}</code>:
                  {#if d.why === 'no-ingress'}
                    this workspace has no ingress zone; choose the zone its apps' records go in with <em>Use for ingress</em> below
                  {:else if d.why === 'no-machine'}
                    {appById.get(d.appId)?.name ?? 'its app'} runs on no online server — deploy it
                  {:else}
                    not pushed yet
                    <Button treatment="ghost" disabled={pushingId === d.id} aria-label={`Push ${d.hostname}`}
                            onclick={() => push(d)}>{pushingId === d.id ? 'Pushing…' : 'Push'}</Button>
                  {/if}
                </li>
              {/each}
            </ul>
          </Callout>
        {/if}

        {#if zone.stale.length}
          <Callout tone={down.length ? 'danger' : 'warning'} title={staleTitle}>
            <ul id="zone-stale">
              {#each zone.stale as s}
                <li>
                  <code>{s.name}</code> —
                  {#if s.down}
                    no online machine; still pointing at {s.have.join(', ')} until one returns
                  {:else}
                    points at {s.have.join(', ') || 'nothing'}, runs at {s.want.join(', ')}
                  {/if}
                </li>
              {/each}
            </ul>
          </Callout>
        {/if}

        <div class="section-header">
          <h3 class="h5">Records in <code>{zone.zone.name}</code></h3>
          {#if isIngress}
            <Badge tone="success" id="ingress-badge">ingress zone</Badge>
          {:else}
            <Button treatment="outlined" id="ingress-use" disabled={ingressBusy}
                    data-confirm={`Every app's ingress record is written to ${zone.zone.name}${ingress ? ', and the zone set now stops receiving them' : ''}.`}
                    data-confirm-title="Use this zone for ingress?" data-confirm-label="Use for ingress"
                    onclick={() => useForIngress(picked.accountId, picked.zoneId)}>Use for ingress</Button>
          {/if}
        </div>
        {#if ingressError}
          <article class="alert danger" id="ingress-error">
            <div class="alert-content">{ingressError}</div>
          </article>
        {/if}
        {#if zone.records.length === 0}
          <p class="text-sm text-muted">This zone holds no records.</p>
        {:else}
          <Table id="zone-records" columns={RECORD_COLUMNS} rows={zone.records} striped>
            {#snippet row(r)}
              <tr>
                <td><code>{r.type}</code></td>
                <td><code>{r.name}</code></td>
                <td><code>{r.content}</code></td>
                <td>{r.proxied ? 'proxied' : 'direct'} · {r.ttl === 1 ? 'auto' : `${r.ttl}s`}</td>
                <td>
                  {#if r.domainId}
                    <Badge tone="success">{hostnameOf(r.domainId) ?? 'a Domain'}</Badge>
                  {:else}
                    <span class="text-muted">—</span>
                  {/if}
                </td>
              </tr>
            {/snippet}
          </Table>
        {/if}
      {/if}
    {:else}
      <Callout tone="muted" title="No edge account">
        <p class="text-body">
          The zone's own DNS records are the provider's to state, not this app's. Connect one by adding
          its API token as a provider key on <a href="/secrets/">Secrets</a> — an account-owned Cloudflare
          token with Zone › Zone › Read, Zone › DNS › Edit and Zone › Config Rules › Edit — and its zones appear here beside the hostnames above.
        </p>
        <p class="text-body"><a href="/admin/adapters/">All adapters</a>.</p>
      </Callout>
      <div aria-busy="true" class="stack" aria-label="Zone DNS records, not connected">
        <Skeleton variant="text" width="70%" />
        <Skeleton variant="text" width="55%" />
        <Skeleton variant="text" width="62%" />
      </div>
    {/if}
  </Card>
{/if}

<Drawer open={!!routing} title={routing?.id ? `Edit ${routing.pathPrefix}` : 'Add a path route'} onclose={() => routing = null}>
  {#if routing}
    <DomainRoute record={routing.id ? routing : undefined} oncancel={() => routing = null} ondone={routeSaved} submitId="route-save" />
  {/if}
</Drawer>

<Drawer open={!!editing}title={editing ? `Edit ${editing.hostname}` : ''} onclose={() => editing = null}>
  {#if editing}
    <Domain record={editing} only={['redirectTo', 'port', 'proxied', 'sslMode']} oncancel={() => editing = null} ondone={saved} submitId="domain-edit-save" />
  {/if}
</Drawer>

<style>
  .zone-list {
    display:               grid;
    grid-template-columns: repeat(auto-fill, minmax(14rem, 1fr));
    gap:                   var(--space-2xs) var(--space-sm);
    margin:                0;
    padding:               0;
    list-style:            none;
  }
  .zone-list :global(.btn) {
    inline-size:     100%;
    justify-content: flex-start;
    text-align:      start;
  }
  .zone-name { overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }
</style>
