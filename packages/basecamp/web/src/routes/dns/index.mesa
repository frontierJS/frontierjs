---
title: DNS & edge
---
<script>
  // Where the mock's CloudflareView goes, named for the job rather than the
  // vendor the mock drew — a screen called Cloudflare could only ever hold one.
  //
  // Two halves of one fact. A `Domain` row IS the hostname this app intends to
  // serve, its certificate and whether it is proxied; the zone's records are
  // what the edge actually answers. The second half comes from a workspace's
  // edge ACCOUNT through the `edge` service, and the value of the screen is the
  // two disagreeing — a hostname with no record resolves nowhere.
  //
  // Analytics is still a skeleton with the reason beside it: no service reads
  // it, and a zeroed figure reads as an outage rather than an absence.
  import { session } from '../../session.js'
  import Domain, { domains } from '../../resources/Domain.mesa'
  import { apps } from '../../resources/App.mesa'
  import { portal } from '../../resources/Portal.mesa'
  import { edge } from '../../resources/Edge.mesa'

  import Badge      from '@frontierjs/ui/components/display/Badge.mesa'
  import Button     from '@frontierjs/ui/components/forms/Button.mesa'
  import Callout    from '@frontierjs/ui/components/display/Callout.mesa'
  import Card       from '@frontierjs/ui/components/layout/Card.mesa'
  import Drawer     from '@frontierjs/ui/components/overlay/Drawer.mesa'
  import { toasts } from '@frontierjs/ui/stores/toastStore.js'
  import EmptyState from '@frontierjs/ui/components/display/EmptyState.mesa'
  import Pill       from '@frontierjs/ui/components/display/Pill.mesa'
  import Skeleton   from '@frontierjs/ui/components/feedback/Skeleton.mesa'
  import Table      from '@frontierjs/ui/components/display/Table.mesa'

  $: session.workspaceId

  let rows     = []
  let appById  = new Map()
  let adapter  = null
  let accounts = []
  let error    = null
  let loading  = true

  // The zone being read, and what its read answered. Held apart from `load()`
  // so a refused zone shows its own error without taking the hostnames down.
  let picked    = null        // { accountId, zoneId }
  let zone      = null
  let zoneError = null
  let zoneBusy  = false

  async function load() {
    error = null; loading = true
    try {
      // Both lists, because a hostname with no app name beside it is an id in
      // a column nobody can act on. `domains.find` answers the app's id and
      // not its name — the include is on the app's own detail read.
      const [dom, app, entry] = await Promise.all([
        domains.service.find({}, { limit: 200 }),
        apps.service.find({}, { limit: 200 }),
        // `get` pings. A failure here must not take the hostname table with
        // it — the app's own rows are readable whether or not a vendor is.
        portal.service.get('edge').catch(() => null),
      ])
      rows    = dom.data
      appById = new Map(app.data.map(a => [a.id, a]))
      adapter = entry
      // Asked only once the portal says an account exists — an empty answer
      // from a workspace with none would read as a zone with nothing in it.
      accounts = adapter?.configured
        ? (await edge.service.invoke('zones', null).catch(e => { zoneError = e.message; return { accounts: [] } })).accounts
        : []
      const first = accounts.find(a => a.zones?.length)
      if (!picked && first) readZone(first.id, first.zones[0].id)
    } catch (e) {
      error = e.message
    } finally {
      loading = false
    }
  }

  async function readZone(accountId, zoneId) {
    picked = { accountId, zoneId }; zoneBusy = true; zoneError = null
    try {
      zone = await edge.service.invoke('records', null, { accountId, zoneId })
    } catch (e) {
      zone = null; zoneError = e.message
    } finally {
      zoneBusy = false
    }
  }

  load()
  $: session.workspaceId, () => { picked = null; zone = null; load() }

  // The service decorates every row with cert_status — one definition, in
  // api/src/services/domains/domains.service.ts, so this screen and the notice
  // rules cannot disagree about what "expiring" means.
  const CERT_TONE = { active: 'success', expiring_soon: 'warning', expired: 'danger', none: 'muted' }
  const TONE      = { healthy: 'success', unconfigured: 'muted', unreachable: 'danger', degraded: 'warning' }
  const ZONE_TONE = { active: 'success', pending: 'warning' }

  const RECORD_COLUMNS = [
    { name: 'type',    label: 'Type' },
    { name: 'name',    label: 'Name' },
    { name: 'content', label: 'Content' },
    { name: 'edge',    label: 'Edge' },
    { name: 'served',  label: 'Hostname here' },
  ]
  const hostnameOf = (id) => rows.find(d => d.id === id)?.hostname
  $: missingTitle = zone?.missing.length === 1
    ? 'A hostname this workspace serves has no record'
    : `${zone?.missing.length} hostnames this workspace serves have no record`

  $: proxied  = rows.filter(r => r.proxied).length
  $: expiring = rows.filter(r => r.cert_status === 'expiring_soon').length
  $: expired  = rows.filter(r => r.cert_status === 'expired').length

  // How a hostname is served. `appId` moves by delete-and-create and the
  // certificate columns by `uploadCert`, so neither is offered; the primary flag
  // is the app screen's Make primary, which demotes the sibling.
  const SERVED = ['hostname', 'redirectTo', 'port', 'proxied', 'sslMode']
  let editing = null

  function saved() {
    editing = null
    toasts.success('Domain saved')
    load()
  }

  // A certificate is uploaded on the app screen, which holds the one form for
  // it; this links straight to that form for the hostname in question.
  const certHref = (d) => `/apps/${d.appId}/?tab=domains&cert=${d.id}`
  const NEEDS_CERT = new Set(['expiring_soon', 'expired', 'none'])

  const COLUMNS = [
    { name: 'hostname', label: 'Hostname' },
    { name: 'app',      label: 'App' },
    { name: 'cert',     label: 'Certificate' },
    { name: 'ssl',      label: 'SSL mode' },
    { name: 'edge',     label: 'Edge' },
    { name: 'actions',  label: 'Actions', hideLabel: true },
  ]
</script>

{#if error}
  <article class="alert danger" id="screen-error">
    <div class="alert-content">{error}</div>
  </article>
{/if}

{#if loading}
  <div aria-busy="true" class="stack">
    <Skeleton variant="text" width="12rem" />
    <Skeleton height="16rem" />
  </div>
{:else}
  <div class="tiles" style="--tile-min: 12rem" id="dns-tiles">
    <article class="tile">
      <div class="tile-label">Hostnames</div>
      <div class="tile-value">{rows.length}</div>
    </article>
    <article class="tile">
      <div class="tile-label">Proxied</div>
      <div class="tile-value">{proxied}</div>
      <div class="tile-delta muted">of {rows.length}</div>
    </article>
    <article class="tile">
      <div class="tile-label">Expiring soon</div>
      <div class="tile-value">{expiring}</div>
      <div class="tile-delta {expiring ? 'warning' : 'muted'}">within 30 days</div>
    </article>
    <article class="tile">
      <div class="tile-label">Expired</div>
      <div class="tile-value">{expired}</div>
      <div class="tile-delta {expired ? 'danger' : 'muted'}">serving a warning</div>
    </article>
  </div>

  <Card>
    <h2 class="h4">Hostnames this workspace serves</h2>
    {#if rows.length === 0}
      <EmptyState
        compact
        title="No hostnames yet"
      >
        A domain is added on an app, where the certificate and the primary flag live with it.
        {#snippet action()}
          <Button variant="outlined" href="/projects/">Open a project</Button>
        {/snippet}
      </EmptyState>
    {:else}
      <Table id="dns-rows" columns={COLUMNS} rows={rows} striped>
        {#snippet row(d)}
          <tr>
            <td>
              <code>{d.hostname}</code>
              {#if d.isPrimary}<Badge tone="success">primary</Badge>{/if}
              {#if d.redirectTo}<Badge tone="muted">&rarr; {d.redirectTo}</Badge>{/if}
            </td>
            <td>
              {#if appById.get(d.appId)}
                <a href={`/apps/${d.appId}/`}>{appById.get(d.appId).name}</a>
              {:else}
                <span class="text-muted">—</span>
              {/if}
            </td>
            <td>
              <Pill tone={CERT_TONE[d.cert_status] ?? 'muted'}>{d.cert_status}</Pill>
              {#if d.cert_days_remaining !== null && d.cert_days_remaining !== undefined}
                <span class="text-sm text-muted">{d.cert_days_remaining}d</span>
              {/if}
            </td>
            <td><code>{d.sslMode}</code></td>
            <td>{d.proxied ? 'proxied' : 'direct'} · :{d.port}</td>
            <td>
              <span class="cluster">
                {#if NEEDS_CERT.has(d.cert_status)}
                  <Button variant="outlined" href={certHref(d)} aria-label={`Upload a certificate for ${d.hostname}`}>
                    {d.cert_status === 'none' ? 'Add certificate' : 'Replace certificate'}
                  </Button>
                {/if}
                <Button variant="ghost" aria-label={`Edit ${d.hostname}`} onclick={() => editing = d}>Edit</Button>
              </span>
            </td>
          </tr>
        {/snippet}
      </Table>
    {/if}
  </Card>

  <Card>
    <div class="section-header">
      <h2 class="h4">From the edge provider</h2>
      <Pill tone={TONE[adapter?.status] ?? 'muted'} id="edge-status">{adapter?.status ?? 'unknown'}</Pill>
    </div>

    {#if adapter?.configured}
      {#each accounts as account}
        <section class="stack" id={`edge-account-${account.id}`}>
          <h3 class="h5">{account.name} <span class="text-sm text-muted">· {account.label}</span></h3>
          {#if account.error}
            <Callout tone="danger" title="The provider refused this account">
              <p class="text-body">{account.error}</p>
              <p class="text-body">Rotate or re-verify its token on <a href="/secrets/">Secrets</a>.</p>
            </Callout>
          {:else if account.zones.length === 0}
            <p class="text-sm text-muted">This token opens no zone.</p>
          {:else}
            <div class="cluster" id="edge-zones">
              {#each account.zones as z}
                <Button
                  variant={picked?.zoneId === z.id ? 'outlined' : 'ghost'}
                  aria-pressed={picked?.zoneId === z.id ? 'true' : 'false'}
                  onclick={() => readZone(account.id, z.id)}
                >{z.name} <Pill tone={ZONE_TONE[z.status] ?? 'muted'}>{z.status}</Pill></Button>
              {/each}
            </div>
          {/if}
        </section>
      {/each}

      {#if zoneError}
        <article class="alert danger" id="zone-error">
          <div class="alert-content">{zoneError}</div>
        </article>
      {:else if zoneBusy}
        <div aria-busy="true" class="stack">
          <Skeleton variant="text" width="70%" />
          <Skeleton variant="text" width="55%" />
        </div>
      {:else if zone}
        {#if zone.missing.length}
          <Callout tone="warning" title={missingTitle}>
            <ul id="zone-missing">
              {#each zone.missing as d}
                <li><code>{d.hostname}</code> — resolves nowhere in <code>{zone.zone.name}</code></li>
              {/each}
            </ul>
          </Callout>
        {/if}

        <h3 class="h5">Records in <code>{zone.zone.name}</code></h3>
        {#if zone.records.length === 0}
          <p class="text-sm text-muted">This zone holds no records.</p>
        {:else}
          <Table id="zone-records" columns={RECORD_COLUMNS} rows={zone.records} striped>
            {#snippet row(r)}
              <tr>
                <td><code>{r.type}</code></td>
                <td><code>{r.name}</code></td>
                <td><code>{r.content}</code></td>
                <td>{r.proxied ? 'proxied' : 'direct'} · {r.ttl === 1 ? 'auto' : `${r.ttl}s`}</td>
                <td>
                  {#if r.domainId}
                    <Badge tone="success">{hostnameOf(r.domainId) ?? 'a Domain'}</Badge>
                  {:else}
                    <span class="text-muted">—</span>
                  {/if}
                </td>
              </tr>
            {/snippet}
          </Table>
        {/if}
      {/if}
    {:else}
      <Callout tone="muted" title="No edge account">
        <p class="text-body">
          The zone's own DNS records are the provider's to state, not this app's. Connect one by adding
          its API token as a provider key on <a href="/secrets/">Secrets</a> — an account-owned Cloudflare
          token with Zone:Read — and its zones appear here beside the hostnames above.
        </p>
        <p class="text-body"><a href="/admin/adapters/">All adapters</a>.</p>
      </Callout>
      <div aria-busy="true" class="stack" aria-label="Zone DNS records, not connected">
        <Skeleton variant="text" width="70%" />
        <Skeleton variant="text" width="55%" />
        <Skeleton variant="text" width="62%" />
      </div>
    {/if}

    <h3 class="h5">Analytics</h3>
    <div class="tiles" style="--tile-min: 12rem" aria-busy="true" aria-label="Edge analytics, not connected">
      <Skeleton variant="stat" />
      <Skeleton variant="stat" />
      <Skeleton variant="stat" />
      <Skeleton variant="stat" />
    </div>
  </Card>
{/if}

<Drawer open={!!editing} title={editing ? `Edit ${editing.hostname}` : ''} onclose={() => editing = null}>
  {#if editing}
    <Domain record={editing} only={SERVED} oncancel={() => editing = null} ondone={saved} submitId="domain-edit-save" />
  {/if}
</Drawer>
