---
title: Server
---
<script>
  import { page, goto } from '@frontierjs/sierra/router'
  import { humanize } from '@frontierjs/toolbelt/inflect'
  import Server, { servers } from '../../../resources/Server.mesa'
  import { apps } from '../../../resources/App.mesa'
  import { at, ago } from '../../../lib/datetime.js'
  import { toasts } from '@frontierjs/ui/stores/toastStore'
  import Button     from '@frontierjs/ui/components/forms/Button.mesa'
  import Input      from '@frontierjs/ui/components/forms/Input.mesa'
  import Select     from '@frontierjs/ui/components/forms/Select.mesa'
  import CopyButton from '@frontierjs/ui/components/display/CopyButton.mesa'
  import Drawer     from '@frontierjs/ui/components/overlay/Drawer.mesa'
  import NoRecord   from '../../../components/NoRecord.mesa'
  import ServerHealthBody from '../../../components/tiles/ServerHealthBody.mesa'
  import MemoryBreakdown  from '../../../components/MemoryBreakdown.mesa'
  import { offerUndo } from '../../../resources/Trash.mesa'
  import { serverPostures }  from '../../../resources/ServerPosture.mesa'

  $: page.params

  let server    = null
  let events    = []
  let error     = null
  let loadError = null
  let loading   = true
  let busy      = null
  let editing   = false

  // The edit form's `only=` is what a person may correct about a machine: how it is named and grouped,
  // and how it is reached. The rest of the row is the machine's own report or
  // the provider's, and a box for it would be overwritten by the next
  // heartbeat or Sync. `sshKeyId` names the keys `ssh.unknown-key` expects on the box.
  // `ipAddress` is offered only where no vendor reports it: Sync overwrites it
  // on a provider machine, and on Basecamp's own box or an imported one nothing
  // else ever writes it, so without the box a Domain there is never pushed (FJS-3516).
  $: editable = ['name', 'role', 'region', 'sshUser', 'sshPort', 'sshKeyId', 'labels',
                 ...(server?.providerServerId ? [] : ['ipAddress'])]

  function saved() {
    editing = false
    toasts.success('Server saved')
  }

  // The server row is WATCHED. `service.get(id)` answers a plain object nothing
  // can reach, so a drain from another tab or an outpost checking in moved the
  // store and never this variable (`FJS-533`).
  let rowView = null, unwatch = null

  function watchRow() {
    rowView?.release()
    unwatch?.()
    rowView = servers.record(page.params.id)
    unwatch = rowView.subscribe(v => { server = v; prefillBackups(v) })
    return rowView.ready
  }

  $.onDestroy(() => { unwatch?.(); rowView?.release() })

  async function load() {
    error = null; loadError = null
    try {
      await watchRow()
      await loadEvents()
    } catch (e) {
      error = e.message; loadError = e
    } finally {
      loading = false
    }
  }

  // The trail is its own read and does NOT ride the row's node: it is a custom
  // method — POST /servers/:id with X-Service-Method: events, the sub-path form
  // is a 404 — and no announcement carries it.
  async function loadEvents() {
    events = await servers.service.invoke('events', page.params.id)
  }

  // Which apps run here — the question an operator asks before draining or
  // destroying a machine. A placement is an AppServer row, so the filter is
  // `serverId`, which the apps service reserves and joins through. Not fatal:
  // the machine is the screen.
  // Composed, because the apps service includes each app's environment and a
  // pushed row does not carry it.
  const placedList = apps.tethered({
    state: 'local', composed: true, where: { serverId: page.params.id }, directives: { limit: 100 },
  })
  $: placed = placedList.error ? null : placedList.rows

  // The machine's own report of its security controls. Not fatal, like the
  // placements: the machine is the screen.
  let posture = null
  async function loadPosture() {
    try {
      posture = await serverPostures.service.invoke('latest', page.params.id)
    } catch {
      posture = null
    }
  }

  async function checkPosture() {
    error = null; busy = 'posture'
    try {
      posture = await serverPostures.service.invoke('check', server.id)
      await loadEvents()
      toasts.success(posture.failing ? `${posture.failing} control(s) failing` : 'Posture checked')
    } catch (e) {
      error = e.message
    } finally {
      busy = null
    }
  }

  const offPosture = serverPostures.service.on('*', (method, signal) => {
    if (method === 'report' && signal?.serverId === page.params.id) { loadPosture(); loadEvents() }
  })
  $.onDestroy(offPosture)

  // ─── Routes ──────────────────────────────────────────────────────────
  // What this machine's Caddy routes, read from the machine when asked rather
  // than kept here. Read-only: a route changes through its App's Domains, and
  // a second way to write one is a second answer that drifts.
  let ingress      = null
  let ingressError = null

  async function readRoutes() {
    ingressError = null; busy = 'routes'
    try {
      ingress = await servers.service.invoke('ingress', server.id)
    } catch (e) {
      ingressError = e.message
    } finally {
      busy = null
    }
  }

  const OWNER = { outpost: 'Basecamp', fli: 'fli deploy', hand: 'by hand' }
  const describeTarget = (t) =>
      t.kind === 'proxy'    ? `→ ${t.dial}${t.host ? ` (Host ${t.host})` : ''}`
    : t.kind === 'redirect' ? `${t.status ?? 308} → ${t.location}`
    : t.kind === 'files'    ? `files ${t.root ?? ''}`.trim()
    : `answers ${t.status}`

  const POSTURE_TONE = { true: 'success', false: 'danger', unknown: 'muted' }

  load()
  loadPosture()
  $: page.params.id, () => { load(); loadPosture() }

  // The row moves itself now; this is here for the TRAIL, which nothing pushes.
  // The event is named after the method — `servers heartbeat`, `servers drain`
  // — so this listens to all of them and filters out the READS. That filter is
  // still load-bearing: the service publishes after `get` too, and re-reading on
  // it would make this page answer its own read, forever.
  const READS = new Set(['get', 'find', 'events'])

  const off = servers.service.on('*', (method, row) => {
    if (READS.has(method) || row?.id !== page.params.id) return
    loadEvents().catch(e => { error = e.message })
  })
  $.onDestroy(off)

  // Every action is the same shape: a custom method that transitions status
  // and writes a ServerEvent. The service decides whether the transition is
  // legal for the current status — `drain` on an already-draining server is a
  // 400, and the message says so.
  async function act(method) {
    error = null; busy = method
    try {
      // The answer is used for the SENTENCE and not assigned over `server`:
      // the row is a subscription now, and the move's own announcement is what
      // carries it onto the screen. Assigning here would race that push and
      // win with an older object on the way back.
      const moved = await servers.service.invoke(method, server.id)
      await loadEvents()
      // A transition is confirmed where the operator is looking, not only by
      // the status pill changing further down the page. `error` stays as the
      // inline record of a refusal — a toast is transient, and a refusal is
      // something you may need to read twice.
      toasts.success(`${moved.name} → ${moved.status}`)
    } catch (e) {
      error = e.message
    } finally {
      busy = null
    }
  }

  async function remove() {
    error = null; busy = 'remove'
    try {
      const { id, name } = server
      await servers.service.remove(id)
      offerUndo(name, servers, id)
      goto('/servers/')
    } catch (e) {
      // 'Cannot remove an online server — drain it first' arrives here, and is
      // exactly the sort of refusal the UI should show rather than pre-empt.
      error = e.message
    } finally {
      busy = null
    }
  }

  // Destroy asks the provider to delete the machine, and the service refuses
  // unless the caller types the machine's name back — the thing typed is the
  // thing destroyed, so a stale screen cannot confirm the wrong row.
  let destroyName = ''

  async function destroy() {
    error = null; busy = 'destroy'
    try {
      const moved = await servers.service.invoke('destroy', server.id, { confirm: destroyName })
      destroyName = ''
      await loadEvents()
      toasts.success(`${moved.name} → ${moved.status}`)
    } catch (e) {
      error = e.message
    } finally {
      busy = null
    }
  }

  const TONE = {
    online: 'success', draining: 'warning',
    unreachable: 'danger', stopped: 'muted', destroyed: 'muted',
  }

  // ── While a job is working on this machine ─────────────────────────
  //
  // Provisioning, installing and destroying are all done by a JOB, in another
  // process, over minutes. The ROW moves itself — it is watched, so a status
  // change arrives over the socket with nothing here asking. The TRAIL does
  // not: `events` is a custom method, no announcement carries it, and the job's
  // writes reach no channel at all.
  //
  // So this polls, and only while something is in flight. It is a poll rather
  // than a subscription because there is nothing to subscribe to: giving
  // `ServerEvent` a channel would mean broadcasting an audit trail to every
  // member of the workspace, which is a wider change than a progress strip
  // should make.
  //
  // The interval is cleared on leaving the state and on destroy, both — the
  // first is what stops it, the second is what stops it when somebody navigates
  // away mid-provision, which is the case a status-only guard misses.
  // `pending` is the ambiguous one and it is not decidable from the status
  // alone. A machine this app is BUYING sits at `pending` until the job picks
  // it up; a machine somebody IMPORTED sits there forever, because no job will
  // ever touch it and nothing but an outpost checking in will move it. Telling
  // an operator their imported box is *queued* is a sentence that never comes
  // true. `registerMethod` is the discriminator and it is already on the row.
  const IN_FLIGHT   = new Set(['provisioning', 'installing', 'destroying'])
  const IF_BUYING   = new Set(['pending'])
  const POLL_MS   = 4000

  let polling = null

  function stopPolling() { if (polling) { clearInterval(polling); polling = null } }
  $.onDestroy(stopPolling)

  // Named in the expression, not read inside a helper: Mesa decides what an
  // expression depends on from its own text, so `server.status` has to appear
  // here or this re-derives for the wrong reason (the note above `moves` says
  // the same thing about the same trap).
  $: inFlight = !!server && (
       IN_FLIGHT.has(server.status)
       || (IF_BUYING.has(server.status) && server.registerMethod === 'provisioned'))

  $: (inFlight, () => {
    stopPolling()
    if (!inFlight) return
    polling = setInterval(() => { loadEvents().catch(() => {}) }, POLL_MS)
  })

  // The row moving IS the signal that a job wrote something, and it costs
  // nothing: re-read the trail on every status change, in flight or not. This
  // is what makes the last event — the one that says *online* — arrive with the
  // pill rather than up to four seconds after it.
  //
  // Derived first, and no optional chaining in the dependency expression:
  // `$: (server?.status, …)` compiles to a watch signal the component does not
  // declare, and the module then fails to LOAD — which reaches a person as a
  // redirect that silently does nothing, because `goto` awaits the dynamic
  // import and its callers do not await `goto` (`FJS-1023`).
  $: statusNow = server ? server.status : null
  $: (statusNow, () => { if (server) loadEvents().catch(() => {}) })

  // What the machine is waiting for, in the words somebody provisioning it
  // would use. Not the status itself: `installing` is this app's word for *the
  // box is up and enrolling*, which is not what it says to a reader.
  // The install command for a machine that has no credential yet. Held in a
  // local rather than on the row, because it carries a token the server will
  // not answer twice.
  let enrollCommand  = null
  let enrollWindowMs = 15 * 60 * 1000
  let enrollError    = null
  let reenrolling    = false

  async function issueEnrollment() {
    enrollError = null; busy = 'enroll'
    try {
      const issued = await servers.service.invoke('issueEnrollment', page.params.id)
      enrollCommand  = issued.command
      enrollWindowMs = issued.windowMs ?? enrollWindowMs
      await loadEvents()
    } catch (e) {
      enrollError = e.message
    } finally {
      busy = null
    }
  }

  const WAITING = {
    pending:      'Queued. The provisioning job has not picked it up yet.',
    provisioning: 'Asking the provider for a machine, then waiting for it to boot and get an address.',
    installing:   'The machine is up. It is installing its outpost and enrolling itself — nothing here connects to it.',
    destroying:   'Asked the provider to delete it. The row lands on destroyed when the provider confirms.',
  }

  // plan / health / dockerState / labels are Json columns. They arrive as
  // objects — Litestone parses them — so this renders entries rather than
  // JSON.parse'ing a string, which is what the old raw-SQL services had to do.
  const entries = (obj) => Object.entries(obj ?? {})

  // The Outpost's per-unit memory table (`FJS-D1824`) is drawn as a table under
  // the bars, so the raw dump below leaves it out rather than print an object.
  $: breakdown = server?.health?.memory_breakdown ?? null
  $: reported  = entries(server?.health).filter(([key]) => key !== 'memory_breakdown')
  $: appNames  = Object.fromEntries((placed ?? []).map(a => [a.id, a.name]))

  // Which actions the current status permits — ASKED, not restated. The three
  // from-lists that used to be written out here were a copy of the service's,
  // which were a copy of nothing: the machine now lives in `@@transitions` on
  // `model Server` and reaches the browser as `x-transitions` on the JSON
  // Schema, the same path `fields` and `gate` already take.
  //
  // An affordance and not a boundary — the Data boundary refuses regardless.
  // No level is passed, so a gated move reads `allowed: true` here and the
  // server answers 403 with the role it wants: this app grades a caller on
  // their WorkspaceMember role, which sierra's `session.level` does not know,
  // and inventing a second ladder in the browser is the copy this change is
  // removing. `transitionsAt` treats an unknown level as permissive, which is
  // the documented contract for every x-* affordance.
  // `server` is named in the expression rather than closed over inside a
  // helper. Mesa decides what an expression depends on from the expression's
  // own text, so a `moves()` that mentions no reactive value happens to work
  // and re-derives for the wrong reason; the hub layout's nav carries the same
  // note for the same reason.
  $: moves = new Set(server ? servers.transitions(server).map(t => t.name) : [])

  // A machine a cloud made is one Basecamp can ask that cloud about. `custom`
  // is somebody's own box: Sync has no vendor to read and Destroy no vendor to
  // tell, so both would record an event and do nothing.
  $: cloudMade = !!server && !!server.providerKind && server.providerKind !== 'custom'

  // ─── Machine backups ─────────────────────────────────────────────────
  // The vendor's image of the whole disk, as the last Sync read it. Its `hour`
  // is UTC at both vendors and is printed as UTC: moved into the viewer's zone,
  // the window would read differently to two operators of the same box.
  const WEEKDAYS = { SUN: 'Sundays', MON: 'Mondays', TUE: 'Tuesdays', WED: 'Wednesdays',
                     THU: 'Thursdays', FRI: 'Fridays', SAT: 'Saturdays' }

  $: backups = server?.backupReading ?? null

  function schedule(b) {
    const hour = b.hour == null ? '' : ` at ${String(b.hour).padStart(2, '0')}:00 UTC`
    return b.plan === 'weekly' && b.weekday
      ? `weekly, ${WEEKDAYS[b.weekday] ?? b.weekday}${hour}`
      : `${b.plan ?? 'on an unnamed plan'}${hour}`
  }

  // What the switch asks for. Off leaves the machine not managed (`FJS-D1885`).
  // The hours are DigitalOcean's four-hourly windows; Hetzner picks its own,
  // so it is asked none. The service refuses anything the vendor cannot hold.
  const BACKUP_CHOICES = [
    { value: 'unmanaged', label: 'Not managed — Basecamp changes nothing' },
    { value: 'off',       label: 'Off — the vendor deletes the backups it has taken' },
    { value: 'daily',     label: 'On, daily' },
    { value: 'weekly',    label: 'On, weekly' },
  ]
  const DO_HOURS = [0, 4, 8, 12, 16, 20].map(h => ({ value: String(h), label: `${String(h).padStart(2, '0')}:00 UTC` }))

  let backupChoice = null, backupHour = '20', backupDay = 'SUN', backupFor = null

  // Prefilled from what Basecamp holds, once per machine, so a heartbeat's
  // push does not reset a choice half made.
  function prefillBackups(row) {
    if (!row || backupFor === row.id) return
    backupFor    = row.id
    backupChoice = row.backupPolicy?.plan ?? 'unmanaged'
    backupHour   = row.backupPolicy?.hour == null ? '20' : String(row.backupPolicy.hour)
    backupDay    = row.backupPolicy?.weekday ?? 'SUN'
  }
  $: picksHour = server?.providerKind === 'digitalocean'
  $: weekdayOptions = Object.entries(WEEKDAYS).map(([value, label]) => ({ value, label }))
  $: backupOptions = picksHour ? BACKUP_CHOICES : BACKUP_CHOICES.filter(c => c.value !== 'weekly')

  async function saveBackups() {
    error = null; busy = 'backups'
    const on = backupChoice === 'daily' || backupChoice === 'weekly'
    try {
      await servers.service.invoke('setBackups', server.id, on
        ? { choice: 'on', plan: backupChoice,
            ...(picksHour && { hour: Number(backupHour) }),
            ...(backupChoice === 'weekly' && { weekday: backupDay }) }
        : { choice: backupChoice })
      await loadEvents()
      toasts.success('Machine backups saved')
    } catch (e) {
      error = e.message
    } finally {
      busy = null
    }
  }

  function backupCost(c) {
    return c?.monthlyMinor != null
      ? `+${c.monthlyMinor.toMoney(c.currency)}/mo, estimated`
      : `cost not estimated${c?.unestimated ? `: ${c.unestimated}` : ''}`
  }

  // Remove deletes the ROW. On a machine a cloud still bills for, that is the
  // orphan `reconcile` exists to find, so the confirmation says so.
  $: removeWarning = cloudMade && server.status !== 'destroyed'
    ? `This removes ${server.name} from Basecamp only. The machine keeps running — and billing — at ${server.providerKind}. Destroy it instead to delete it there.`
    : `Remove ${server?.name} from Basecamp?`
</script>

{#if loading}
  <p class="text-sm text-muted">Loading…</p>
{:else if server}
  <div class="section-header">
    <h1>{server.name}</h1>
    <div class="cluster">
      <span class="pill {TONE[server.status] ?? ''}" id="server-status">{server.status}</span>
      <Button treatment="outlined" id="server-edit" onclick={() => editing = true}>Edit</Button>
      <Button treatment="ghost" href="/servers/">All servers</Button>
    </div>
  </div>

  <Drawer open={editing} title={`Edit ${server.name}`} onclose={() => editing = false}>
    {#if editing}
      <Server record={server} only={editable} oncancel={() => editing = false} ondone={saved} submitId="server-edit-save" />
    {/if}
  </Drawer>

  {#if error}
    <article class="alert danger">
      <div class="alert-content">{error}</div>
    </article>
  {/if}

  {#if inFlight}
    <!-- `aria-busy` and not a spinner alone: this is the one screen in the app
         where the interesting state is *nothing has happened yet*, and a reader
         using a screen reader gets that from the attribute. -->
    <article class="alert info" id="server-inflight" aria-busy="true">
      <div class="alert-content">
        <strong>{server.status}</strong> — {WAITING[server.status]}
        <span class="text-sm text-muted"> This page follows along; there is nothing to refresh.</span>
      </div>
    </article>
  {/if}

  {#if !server.ipAddress && !server.providerServerId}
    <!-- No vendor will ever report this box's address, and a Domain on an App
         it serves is skipped by the edge sync without a word (FJS-3515). -->
    <article class="alert warning" id="needs-address">
      <div class="alert-content">
        <strong>No address.</strong> A Domain on an App served here is never pushed to DNS.
        <Button treatment="ghost" onclick={() => editing = true}>Add one</Button>
      </div>
    </article>
  {/if}

  {#if server.outpostPublicKey === null || reenrolling}
    <!-- A machine with no credential of its own. Provisioned machines get one
         from cloud-init, which nobody types; an imported machine has no install
         to be handed anything at, so this is that moment.

         Shown for every such machine rather than only for unreachable ones: a
         box that is checking in on nothing at all is exactly the case somebody
         needs to fix and has no other sign of.

         An enrolled machine reaches the same command through Re-enroll: it is
         the only path that moves a running Outpost to a new version
         (FJS-D1820). -->
    <article class="alert info" id={server.outpostPublicKey === null ? 'needs-enrollment' : 'reenroll'}>
      <div class="alert-content">
        {#if server.outpostPublicKey === null}
          <strong>This machine has no credential of its own.</strong>
          Run one command on it and it gets one, after which it signs its own check-ins.
        {:else}
          <strong>Re-enroll this machine.</strong>
          The command reinstalls its Outpost at the version this Basecamp runs and restarts it,
          and the key it enrolls with replaces the one it holds now. Nothing changes until it runs.
        {/if}
        {#if enrollError}
          <p class="text-sm" id="enroll-error">{enrollError}</p>
        {/if}
        {#if enrollCommand}
          <!-- Shown ONCE. The token is returned by the service and stored
               nowhere it can be read back — the same rule an invitation link
               follows, and for the same reason. Issuing again is how somebody
               who lost it gets another, and it revokes this one. -->
          <p class="text-sm text-muted">
            Run this on the machine within {Math.round(enrollWindowMs / 60000)} minutes.
            It is shown once; issue another if you lose it.
          </p>
          <pre class="code" id="enroll-command"><code>{enrollCommand}</code></pre>
          <div class="cluster">
            <CopyButton text={enrollCommand} label="Copy command" treatment="outlined" />
          </div>
        {:else}
          <div class="cluster">
            <Button tone="primary" disabled={busy === 'enroll'} onclick={issueEnrollment}>
              {busy === 'enroll' ? 'Issuing…' : 'Get the install command'}
            </Button>
            {#if reenrolling}
              <Button treatment="ghost" onclick={() => reenrolling = false}>Cancel</Button>
            {/if}
          </div>
        {/if}
      </div>
    </article>
  {/if}

  <div class="cluster" id="server-actions">
    {#if moves.has('drain')}
      <Button treatment="outlined" disabled={busy === 'drain'} onclick={() => act('drain')}>
        {busy === 'drain' ? 'Draining…' : 'Drain'}
      </Button>
    {/if}
    {#if moves.has('undrain')}
      <Button treatment="outlined" disabled={busy === 'undrain'} onclick={() => act('undrain')}>
        {busy === 'undrain' ? 'Cancelling…' : 'Cancel drain'}
      </Button>
    {/if}
    {#if moves.has('reboot')}
      <Button treatment="outlined" disabled={busy === 'reboot'} onclick={() => act('reboot')}>Reboot</Button>
    {/if}
    {#if server.outpostPublicKey !== null && !reenrolling}
      <Button treatment="outlined" id="server-reenroll" onclick={() => reenrolling = true}>Re-enroll this machine</Button>
    {/if}
    {#if cloudMade}
      <Button treatment="ghost" disabled={busy === 'sync'} onclick={() => act('sync')}>
        {busy === 'sync' ? 'Syncing…' : 'Sync from provider'}
      </Button>
    {/if}
    <Button treatment="ghost" tone="danger" disabled={busy === 'remove'} onclick={remove}
            data-confirm={removeWarning} data-confirm-title="Remove this server?" data-confirm-label="Remove">Remove</Button>
  </div>

  <dl class="facts">
    <dt>Role</dt>          <dd>{server.role}</dd>
    <dt>Provider</dt>      <dd>{server.providerKind}</dd>
    <dt>Region</dt>        <dd>{server.region}</dd>
    <dt>Address</dt>       <dd><code>{server.ipAddress ?? '—'}</code></dd>
    <dt>SSH</dt>           <dd><code>{server.sshUser}@{server.ipAddress ?? '—'}:{server.sshPort}</code></dd>
    <dt>Outpost</dt>         <dd>{server.outpostVersion ?? 'not installed'}</dd>
    <dt>Last heartbeat</dt><dd id="server-heartbeat">{at(server.lastHeartbeatAt)}</dd>
  </dl>

  <div class="tiles" style="--tile-min: 18rem">
    <article class="card stack" id="server-apps">
      <h2 class="h4">Apps on this machine</h2>
      {#if placed === null}
        <p class="text-sm text-muted">The apps placed here could not be read.</p>
      {:else if !placed.length}
        <p class="text-sm text-muted">Nothing is placed here. An app's own screen places it on a machine.</p>
      {:else}
        <ul class="stack">
          {#each placed as a}
            <li><a href={`/apps/${a.id}/`}>{a.name}</a>
              <span class="text-sm text-muted">{a.environment?.name ?? ''} · {a.kind}</span></li>
          {/each}
        </ul>
      {/if}
    </article>

    <article class="card stack">
      <h2 class="h4">Plan</h2>
      {#if entries(server.plan).length}
        <dl class="facts">
          {#each entries(server.plan) as [key, value]}
            <dt>{key}</dt><dd>{value}</dd>
          {/each}
        </dl>
      {:else}
        <p class="text-sm text-muted">No plan recorded.</p>
      {/if}
    </article>

    {#if cloudMade}
      <article class="card stack" id="server-backups">
        <h2 class="h4">Machine backups</h2>
        {#if !backups}
          <p class="text-sm text-muted">Not read yet. Sync from provider reads them.</p>
        {:else if !backups.enabled}
          <p id="backups-state"><strong>Off</strong></p>
        {:else}
          <p id="backups-state"><strong>On</strong>, {schedule(backups)}</p>
          <dl class="facts">
            <dt>Last taken</dt><dd>{ago(backups.taken[0]?.at, 'none yet')}</dd>
            <dt>Kept</dt>
            <dd>{backups.taken.length}{#if backups.retentionDays} · for {backups.retentionDays} days{/if}</dd>
            <dt>Cost</dt>      <dd id="backups-cost">{backupCost(backups.cost)}</dd>
          </dl>
        {/if}
        {#if backups}
          <p class="text-sm text-muted">
            Read {ago(backups.readAt)} from {server.providerKind}.
            {#if backups.pending}<span id="backups-pending">A change is still applying there, so this may be the old state.</span>{/if}
            {#if !server.backupPolicy}Not managed: Basecamp shows what the vendor says and changes nothing.{/if}
          </p>
        {/if}
        <div class="cluster" id="backups-switch">
          <Select label="Basecamp keeps this machine" name="backupChoice" id="backups-choice" placeholder=""
                  options={backupOptions} value={backupChoice}
                  onchange={(e) => backupChoice = e.target.value} />
          {#if picksHour && (backupChoice === 'daily' || backupChoice === 'weekly')}
            <Select label="Window opens" name="backupHour" id="backups-hour" placeholder=""
                    options={DO_HOURS} value={backupHour}
                    onchange={(e) => backupHour = e.target.value} />
          {/if}
          {#if backupChoice === 'weekly'}
            <Select label="On" name="backupDay" id="backups-day" placeholder=""
                    options={weekdayOptions} value={backupDay}
                    onchange={(e) => backupDay = e.target.value} />
          {/if}
          <Button treatment="outlined" id="backups-save" disabled={busy === 'backups'} onclick={saveBackups}>
            {busy === 'backups' ? 'Saving…' : 'Save'}
          </Button>
        </div>
      </article>
    {/if}

    <!-- The dashboard's card, for the readings it knows and a day of each;
         the rest of what the outpost sent is listed under it, in its own words. -->
    <article class="card stack" id="server-health">
      <h2 class="h4">Health</h2>
      <ServerHealthBody tile={{ serverId: server.id }} />
      {#if breakdown?.rows?.length}
        <h3 class="h5">Memory</h3>
        <MemoryBreakdown id="server-memory" rows={breakdown.rows} total={breakdown.total_bytes} names={appNames} />
      {/if}
      {#if reported.length}
        <details>
          <summary class="text-sm">Everything it reported</summary>
          <dl class="facts">
            {#each reported as [key, value]}
              <dt>{key}</dt><dd>{value}</dd>
            {/each}
          </dl>
        </details>
      {/if}
    </article>

    <article class="card stack">
      <h2 class="h4">Labels</h2>
      {#if entries(server.labels).length}
        <div class="cluster">
          {#each entries(server.labels) as [key, value]}
            <span class="badge muted">{key}={value}</span>
          {/each}
        </div>
      {:else}
        <p class="text-sm text-muted">No labels.</p>
      {/if}
    </article>
  </div>

  <!-- A failing control is a finding, never a refusal: deploys continue. -->
  <article class="card stack" id="server-posture">
    <div class="cluster">
      <h2 class="h4">Posture</h2>
      <Button treatment="outlined" id="posture-check" disabled={busy === 'posture'} onclick={checkPosture}>
        {busy === 'posture' ? 'Checking…' : 'Check now'}
      </Button>
    </div>
    {#if !posture?.reported}
      <p class="text-sm text-muted">No posture report yet. The Outpost sends one at start and every six hours.</p>
    {:else}
      <p class="text-sm text-muted">
        {#if posture.stale}<span class="badge warning">stale</span>{/if}
        Read {at(posture.at)} · {posture.failing} failing · {posture.unknown} unknown
      </p>
      <table class="table">
        <tbody>
          {#each [...posture.controls].sort((a, b) => (a.ok === false ? 0 : a.ok === 'unknown' ? 1 : 2) - (b.ok === false ? 0 : b.ok === 'unknown' ? 1 : 2)) as c}
            <tr data-control={c.id}>
              <td><span class="badge {POSTURE_TONE[String(c.ok)]}">{c.ok === true ? 'pass' : c.ok === false ? 'fail' : 'unknown'}</span></td>
              <td><code>{c.id}</code></td>
              <td class="text-sm">{c.message}{#if c.fix}<br><strong>Fix:</strong> {c.fix}{/if}</td>
            </tr>
          {/each}
        </tbody>
      </table>
    {/if}
  </article>

  <article class="card stack" id="server-routes">
    <div class="cluster">
      <h2 class="h4">Routes</h2>
      <Button treatment="outlined" id="routes-read" disabled={busy === 'routes'} onclick={readRoutes}>
        {busy === 'routes' ? 'Reading…' : ingress ? 'Read again' : 'Read from the machine'}
      </Button>
    </div>
    {#if ingressError}
      <p class="text-sm" id="routes-error">{ingressError}</p>
    {:else if !ingress}
      <p class="text-sm text-muted">What this machine's Caddy sends where. Read live; nothing here is stored.</p>
    {:else if !ingress.outpost}
      <p class="text-sm text-muted">No Outpost has checked in from this machine, so there is nothing to ask.</p>
    {:else if !ingress.caddy}
      <p class="text-sm text-muted">The Outpost answered but Caddy did not: {ingress.said}</p>
    {:else}
      {#each ingress.servers as other}
        <article class="alert warning" data-other-server={other.name}>
          <div class="alert-content">
            A second Caddy server, <code>{other.name}</code>, listens on {other.listen.join(', ') || 'no address'}
            with {other.routes} route(s). Only <code>ingress</code> is Basecamp's and fli's; a second one on :443 is
            usually a Caddyfile left running.
          </div>
        </article>
      {/each}
      {#if !ingress.routes.length}
        <p class="text-sm text-muted">Caddy routes nothing here yet. A Domain on an app placed here adds a route.</p>
      {:else}
        <table class="table" id="routes-table">
          <thead><tr><th>Hostnames</th><th>Sends to</th><th>Written by</th></tr></thead>
          <tbody>
            {#each ingress.routes as r}
              <tr data-route={r.id ?? ''}>
                <td>
                  {#each r.hosts as h}
                    <div><code>{h}</code>{#if r.stray?.includes(h)} <span class="badge warning" title="No Domain row names this hostname">no Domain</span>{/if}</div>
                  {/each}
                </td>
                <td class="text-sm">
                  {#each r.to as t}<div>{describeTarget(t)}</div>{/each}
                </td>
                <td class="text-sm">
                  {#if r.app}<a href={`/apps/${r.app.id}/`}>{r.app.name}</a>
                  {:else if r.owner === 'outpost'}<span class="badge warning">app gone</span>
                  {:else}{OWNER[r.owner]}{/if}
                  <div class="text-muted"><code>{r.id ?? 'no @id'}</code></div>
                </td>
              </tr>
            {/each}
          </tbody>
        </table>
      {/if}
    {/if}
  </article>

  {#if cloudMade && moves.has('destroy')}
    <article class="card outlined danger stack" id="server-destroy">
      <h2 class="h4">Destroy this machine</h2>
      <p class="text-sm">
        Asks {server.providerKind} to delete <strong>{server.name}</strong> and everything on its disk.
        This cannot be undone. Type the machine's name to confirm.
      </p>
      <form class="stack" onsubmit={e => { e.preventDefault(); destroy() }}>
        <Input id="destroy-confirm" name="destroy-confirm" label="Machine name" autocomplete="off"
               placeholder={server.name} bind:value={destroyName} />
        <div class="cluster">
          <Button type="submit" tone="danger"
                  disabled={destroyName !== server.name || busy === 'destroy'}>
            {busy === 'destroy' ? 'Destroying…' : 'Destroy'}
          </Button>
        </div>
      </form>
    </article>
  {/if}

  <h2 class="h4">Events</h2>
  {#if !events.length}
    <p class="text-sm text-muted">No events recorded.</p>
  {:else}
    <ol class="feed" id="server-events">
      {#each events as event}
        <li>
          <article class="feed-item">
            <span class="feed-dot" aria-hidden="true"></span>
            <div class="feed-content">
              <div class="text-muted text-sm">{at(event.createdAt)}</div>
              <div class="cluster">
                <strong>{event.message}</strong>
                <!-- `humanize`, not the identifier. `provisionRequested` is a
                     value the schema owns and a person reads, and the two are
                     different axes of one name — `@frontierjs/toolbelt/inflect`
                     is the one owner of the reader axis. -->
                <span class="badge muted">{humanize(event.kind)}</span>
              </div>
            </div>
          </article>
        </li>
      {/each}
    </ol>
  {/if}
{:else}
  <NoRecord error={loadError} noun="Server" onretry={load}
            backHref="/servers/" backLabel="Back to servers" />
{/if}
