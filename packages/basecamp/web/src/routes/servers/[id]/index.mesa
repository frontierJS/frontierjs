---
title: Server
---
<script>
  import { page, goto } from '@frontierjs/sierra/router'
  import { humanize } from '@frontierjs/toolbelt/inflect'
  import { servers } from '../../../resources/Server.mesa'
  import { toasts } from '@frontierjs/ui/stores/toastStore.js'
  import Button   from '@frontierjs/ui/components/forms/Button.mesa'
  import NoRecord from '../../../components/NoRecord.mesa'

  $: page.params

  let server    = null
  let events    = []
  let error     = null
  let loadError = null
  let loading   = true
  let busy      = null

  // The server row is WATCHED. `service.get(id)` answers a plain object nothing
  // can reach, so a drain from another tab or an outpost checking in moved the
  // store and never this variable (`FJS-533`).
  let rowView = null, unwatch = null

  function watchRow() {
    rowView?.release()
    unwatch?.()
    rowView = servers.record(page.params.id)
    unwatch = rowView.subscribe(v => { server = v })
    return rowView.ready
  }

  $.onDestroy(() => { unwatch?.(); rowView?.release() })

  async function load() {
    error = null; loadError = null
    try {
      await watchRow()
      await loadEvents()
    } catch (e) {
      error = e.message; loadError = e
    } finally {
      loading = false
    }
  }

  // The trail is its own read and does NOT ride the row's node: it is a custom
  // method — POST /servers/:id with X-Service-Method: events, the sub-path form
  // is a 404 — and no announcement carries it.
  async function loadEvents() {
    events = rowsOf(await servers.service.invoke('events', page.params.id))
  }

  load()
  $: page.params.id, () => load()

  // The row moves itself now; this is here for the TRAIL, which nothing pushes.
  // The event is named after the method — `servers heartbeat`, `servers drain`
  // — so this listens to all of them and filters out the READS. That filter is
  // still load-bearing: the service publishes after `get` too, and re-reading on
  // it would make this page answer its own read, forever.
  const READS = new Set(['get', 'find', 'events'])

  const off = servers.service.on('*', (method, row) => {
    if (READS.has(method) || row?.id !== page.params.id) return
    loadEvents().catch(e => { error = e.message })
  })
  $.onDestroy(off)

  // Every action is the same shape: a custom method that transitions status
  // and writes a ServerEvent. The service decides whether the transition is
  // legal for the current status — `drain` on an already-draining server is a
  // 400, and the message says so.
  async function act(method) {
    error = null; busy = method
    try {
      // The answer is used for the SENTENCE and not assigned over `server`:
      // the row is a subscription now, and the move's own announcement is what
      // carries it onto the screen. Assigning here would race that push and
      // win with an older object on the way back.
      const moved = await servers.service.invoke(method, server.id)
      await loadEvents()
      // A transition is confirmed where the operator is looking, not only by
      // the status pill changing further down the page. `error` stays as the
      // inline record of a refusal — a toast is transient, and a refusal is
      // something you may need to read twice.
      toasts.success(`${moved.name} → ${moved.status}`)
    } catch (e) {
      error = e.message
    } finally {
      busy = null
    }
  }

  async function remove() {
    error = null; busy = 'remove'
    try {
      await servers.service.remove(server.id)
      goto('/servers/')
    } catch (e) {
      // 'Cannot remove an online server — drain it first' arrives here, and is
      // exactly the sort of refusal the UI should show rather than pre-empt.
      error = e.message
    } finally {
      busy = null
    }
  }

  const TONE = {
    online: 'success', draining: 'warning',
    unreachable: 'danger', stopped: 'muted', destroyed: 'muted',
  }

  const when = (iso) => iso ? new Date(iso).toLocaleString() : '—'

  /**
   * `action()` hands back exactly what the server sent, and a custom method
   * that answers rows sends `{ total, limit, offset, data }` — only `find` is
   * built into a list envelope.
   *
   * Assigning that object straight to `events` is not an error: `.length` is
   * undefined, so the page renders "No events recorded" over a full trail and
   * looks like a service that returned nothing.
   */
  const rowsOf = (result) => Array.isArray(result) ? result : result?.data ?? []

  // ── While a job is working on this machine ─────────────────────────
  //
  // Provisioning, installing and destroying are all done by a JOB, in another
  // process, over minutes. The ROW moves itself — it is watched, so a status
  // change arrives over the socket with nothing here asking. The TRAIL does
  // not: `events` is a custom method, no announcement carries it, and the job's
  // writes reach no channel at all.
  //
  // So this polls, and only while something is in flight. It is a poll rather
  // than a subscription because there is nothing to subscribe to: giving
  // `ServerEvent` a channel would mean broadcasting an audit trail to every
  // member of the workspace, which is a wider change than a progress strip
  // should make.
  //
  // The interval is cleared on leaving the state and on destroy, both — the
  // first is what stops it, the second is what stops it when somebody navigates
  // away mid-provision, which is the case a status-only guard misses.
  // `pending` is the ambiguous one and it is not decidable from the status
  // alone. A machine this app is BUYING sits at `pending` until the job picks
  // it up; a machine somebody IMPORTED sits there forever, because no job will
  // ever touch it and nothing but an outpost checking in will move it. Telling
  // an operator their imported box is *queued* is a sentence that never comes
  // true. `registerMethod` is the discriminator and it is already on the row.
  const IN_FLIGHT   = new Set(['provisioning', 'installing', 'destroying'])
  const IF_BUYING   = new Set(['pending'])
  const POLL_MS   = 4000

  let polling = null

  function stopPolling() { if (polling) { clearInterval(polling); polling = null } }
  $.onDestroy(stopPolling)

  // Named in the expression, not read inside a helper: Mesa decides what an
  // expression depends on from its own text, so `server.status` has to appear
  // here or this re-derives for the wrong reason (the note above `moves` says
  // the same thing about the same trap).
  $: inFlight = !!server && (
       IN_FLIGHT.has(server.status)
       || (IF_BUYING.has(server.status) && server.registerMethod === 'provisioned'))

  $: (inFlight, () => {
    stopPolling()
    if (!inFlight) return
    polling = setInterval(() => { loadEvents().catch(() => {}) }, POLL_MS)
  })

  // The row moving IS the signal that a job wrote something, and it costs
  // nothing: re-read the trail on every status change, in flight or not. This
  // is what makes the last event — the one that says *online* — arrive with the
  // pill rather than up to four seconds after it.
  //
  // Derived first, and no optional chaining in the dependency expression:
  // `$: (server?.status, …)` compiles to a watch signal the component does not
  // declare, and the module then fails to LOAD — which reaches a person as a
  // redirect that silently does nothing, because `goto` awaits the dynamic
  // import and its callers do not await `goto` (`FJS-1023`).
  $: statusNow = server ? server.status : null
  $: (statusNow, () => { if (server) loadEvents().catch(() => {}) })

  // What the machine is waiting for, in the words somebody provisioning it
  // would use. Not the status itself: `installing` is this app's word for *the
  // box is up and enrolling*, which is not what it says to a reader.
  // The install command for a machine that has no credential yet. Held in a
  // local rather than on the row, because it carries a token the server will
  // not answer twice.
  let enrollCommand  = null
  let enrollWindowMs = 15 * 60 * 1000
  let enrollError    = null

  async function issueEnrollment() {
    enrollError = null; busy = 'enroll'
    try {
      const issued = await servers.service.invoke('issueEnrollment', page.params.id)
      enrollCommand  = issued.command
      enrollWindowMs = issued.windowMs ?? enrollWindowMs
      await loadEvents()
    } catch (e) {
      enrollError = e.message
    } finally {
      busy = null
    }
  }

  const WAITING = {
    pending:      'Queued. The provisioning job has not picked it up yet.',
    provisioning: 'Asking the provider for a machine, then waiting for it to boot and get an address.',
    installing:   'The machine is up. It is installing its outpost and enrolling itself — nothing here connects to it.',
    destroying:   'Asked the provider to delete it. The row lands on destroyed when the provider confirms.',
  }

  // plan / health / dockerState / labels are Json columns. They arrive as
  // objects — Litestone parses them — so this renders entries rather than
  // JSON.parse'ing a string, which is what the old raw-SQL services had to do.
  const entries = (obj) => Object.entries(obj ?? {})

  // Which actions the current status permits — ASKED, not restated. The three
  // from-lists that used to be written out here were a copy of the service's,
  // which were a copy of nothing: the machine now lives in `@@transitions` on
  // `model Server` and reaches the browser as `x-transitions` on the JSON
  // Schema, the same path `fields` and `gate` already take.
  //
  // An affordance and not a boundary — the Data boundary refuses regardless.
  // No level is passed, so a gated move reads `allowed: true` here and the
  // server answers 403 with the role it wants: this app grades a caller on
  // their WorkspaceMember role, which sierra's `session.level` does not know,
  // and inventing a second ladder in the browser is the copy this change is
  // removing. `transitionsAt` treats an unknown level as permissive, which is
  // the documented contract for every x-* affordance.
  // `server` is named in the expression rather than closed over inside a
  // helper. Mesa decides what an expression depends on from the expression's
  // own text, so a `moves()` that mentions no reactive value happens to work
  // and re-derives for the wrong reason; the hub layout's nav carries the same
  // note for the same reason.
  $: moves = new Set(server ? servers.transitions(server).map(t => t.name) : [])
</script>

{#if loading}
  <p class="text-sm text-muted">Loading…</p>
{:else if server}
  <div class="section-header">
    <h1>{server.name}</h1>
    <div class="cluster">
      <span class="pill {TONE[server.status] ?? ''}" id="server-status">{server.status}</span>
      <Button variant="ghost" href="/servers/">All servers</Button>
    </div>
  </div>

  {#if error}
    <article class="alert danger">
      <div class="alert-content">{error}</div>
    </article>
  {/if}

  {#if inFlight}
    <!-- `aria-busy` and not a spinner alone: this is the one screen in the app
         where the interesting state is *nothing has happened yet*, and a reader
         using a screen reader gets that from the attribute. -->
    <article class="alert info" id="server-inflight" aria-busy="true">
      <div class="alert-content">
        <strong>{server.status}</strong> — {WAITING[server.status]}
        <span class="text-sm text-muted"> This page follows along; there is nothing to refresh.</span>
      </div>
    </article>
  {/if}

  {#if server.outpostSecretId === null}
    <!-- A machine with no credential of its own. Provisioned machines get one
         from cloud-init, which nobody types; an imported machine has no install
         to be handed anything at, so this is that moment.

         Shown for every such machine rather than only for unreachable ones: a
         box that is checking in on nothing at all is exactly the case somebody
         needs to fix and has no other sign of. -->
    <article class="alert info" id="needs-enrollment">
      <div class="alert-content">
        <strong>This machine has no credential of its own.</strong>
        Run one command on it and it gets one, after which it signs its own check-ins.
        {#if enrollError}
          <p class="text-sm" id="enroll-error">{enrollError}</p>
        {/if}
        {#if enrollCommand}
          <!-- Shown ONCE. The token is returned by the service and stored
               nowhere it can be read back — the same rule an invitation link
               follows, and for the same reason. Issuing again is how somebody
               who lost it gets another, and it revokes this one. -->
          <p class="text-sm text-muted">
            Run this on the machine within {Math.round(enrollWindowMs / 60000)} minutes.
            It is shown once; issue another if you lose it.
          </p>
          <pre class="code-block" id="enroll-command"><code>{enrollCommand}</code></pre>
        {:else}
          <div class="cluster">
            <Button variant="primary" disabled={busy === 'enroll'} onclick={issueEnrollment}>
              {busy === 'enroll' ? 'Issuing…' : 'Get the install command'}
            </Button>
          </div>
        {/if}
      </div>
    </article>
  {/if}

  <div class="cluster" id="server-actions">
    {#if moves.has('drain')}
      <Button variant="outlined" disabled={busy === 'drain'} onclick={() => act('drain')}>
        {busy === 'drain' ? 'Draining…' : 'Drain'}
      </Button>
    {/if}
    {#if moves.has('undrain')}
      <Button variant="outlined" disabled={busy === 'undrain'} onclick={() => act('undrain')}>
        {busy === 'undrain' ? 'Cancelling…' : 'Cancel drain'}
      </Button>
    {/if}
    {#if moves.has('reboot')}
      <Button variant="outlined" disabled={busy === 'reboot'} onclick={() => act('reboot')}>Reboot</Button>
    {/if}
    <Button variant="ghost" disabled={busy === 'sync'} onclick={() => act('sync')}>
      {busy === 'sync' ? 'Syncing…' : 'Sync from provider'}
    </Button>
    <Button variant="ghost" tone="danger" disabled={busy === 'remove'} onclick={remove}>Remove</Button>
  </div>

  <dl class="facts">
    <dt>Role</dt>          <dd>{server.role}</dd>
    <dt>Provider</dt>      <dd>{server.providerKind}</dd>
    <dt>Region</dt>        <dd>{server.region}</dd>
    <dt>Address</dt>       <dd><code>{server.ipAddress ?? '—'}</code></dd>
    <dt>SSH</dt>           <dd><code>{server.sshUser}@{server.ipAddress ?? '—'}:{server.sshPort}</code></dd>
    <dt>Outpost</dt>         <dd>{server.outpostVersion ?? 'not installed'}</dd>
    <dt>Last heartbeat</dt><dd id="server-heartbeat">{when(server.lastHeartbeatAt)}</dd>
  </dl>

  <div class="tiles" style="--tile-min: 18rem">
    <article class="card stack">
      <h2 class="h4">Plan</h2>
      {#if entries(server.plan).length}
        <dl class="facts">
          {#each entries(server.plan) as [key, value]}
            <dt>{key}</dt><dd>{value}</dd>
          {/each}
        </dl>
      {:else}
        <p class="text-sm text-muted">No plan recorded.</p>
      {/if}
    </article>

    <article class="card stack">
      <h2 class="h4">Health</h2>
      {#if entries(server.health).length}
        <dl class="facts">
          {#each entries(server.health) as [key, value]}
            <dt>{key}</dt><dd>{value}</dd>
          {/each}
        </dl>
      {:else}
        <p class="text-sm text-muted">Nothing reported — the outpost fills this in on heartbeat.</p>
      {/if}
    </article>

    <article class="card stack">
      <h2 class="h4">Labels</h2>
      {#if entries(server.labels).length}
        <div class="cluster">
          {#each entries(server.labels) as [key, value]}
            <span class="badge muted">{key}={value}</span>
          {/each}
        </div>
      {:else}
        <p class="text-sm text-muted">No labels.</p>
      {/if}
    </article>
  </div>

  <h2 class="h4">Events</h2>
  {#if !events.length}
    <p class="text-sm text-muted">No events recorded.</p>
  {:else}
    <ol class="feed" id="server-events">
      {#each events as event}
        <li>
          <article class="feed-item">
            <span class="feed-dot" aria-hidden="true"></span>
            <div class="feed-content">
              <div class="text-muted text-sm">{when(event.createdAt)}</div>
              <div class="cluster">
                <strong>{event.message}</strong>
                <!-- `humanize`, not the identifier. `provision_requested` is a
                     value the schema owns and a person reads, and the two are
                     different axes of one name — `@frontierjs/toolbelt/inflect`
                     is the one owner of the reader axis. -->
                <span class="badge muted">{humanize(event.kind)}</span>
              </div>
            </div>
          </article>
        </li>
      {/each}
    </ol>
  {/if}
{:else}
  <NoRecord error={loadError} noun="Server" onretry={load}
            backHref="/servers/" backLabel="Back to servers" />
{/if}
