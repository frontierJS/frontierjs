---
title: Add server
---
<script>
  import { goto } from '@frontierjs/sierra/router'
  import { servers } from '../../resources/Server.mesa'
  import { ResourceValidationError } from '@frontierjs/sierra/junction'
  import Button from '@frontierjs/ui/components/forms/Button.mesa'
  import Select from '@frontierjs/ui/components/forms/Select.mesa'
  import Input  from '@frontierjs/ui/components/forms/Input.mesa'

  // Two ways a machine gets here and the screen is one form, not two.
  //
  //   IMPORT   somebody else's box. A name, an address, a role — what this
  //            screen has always done.
  //   ACCOUNT  a machine at a cloud this workspace holds a token for. The
  //            catalog below is read off the VENDOR, so the region and size
  //            offered are the ones that account can actually be given.
  //
  // Choosing an account and a size PROVISIONS — the app asks the cloud for a
  // machine that does not exist yet. Leaving the account empty imports one that
  // already does. The two are one form because they differ in three fields, and
  // the submit button says which one is about to happen.

  let draft   = servers.make({ name: '', ipAddress: '', region: '', role: 'general' })
  let errors  = []
  let failed  = null
  let saving  = false

  let accounts   = []        // this workspace's provider accounts
  let accountId  = ''        // '' is the import path — no cloud
  let catalog    = null      // regions + sizes + images, off the vendor
  let loadingCat = false
  let catError   = null
  let size       = ''
  let image      = ''

  $: (draft.name, draft.ipAddress, draft.region, draft.role)

  $: roles = servers.fields?.role?.enum ?? ['general']

  const problem = (field) => errors.find(e => e.field === field)?.message

  // The account list and the clouds this app can speak to arrive together —
  // one call, because a first step needing both would otherwise flicker
  // through a state where there are providers and no accounts.
  async function loadAccounts() {
    try {
      const answer = await servers.service.invoke('providers', null)
      accounts = answer.accounts ?? []
    } catch (err) {
      // Not fatal. The import path needs no account at all, so a workspace
      // whose provider read failed can still add a machine by address.
      failed = err.message
    }
  }
  loadAccounts()

  // Read every time an account is chosen rather than cached. A price list is
  // the vendor's to state and the only copy that cannot go stale is the one
  // that is not kept.
  async function chooseAccount(id) {
    accountId = id
    catalog   = null
    catError  = null
    if (!id) { draft.region = ''; size = ''; return }

    loadingCat = true
    try {
      catalog = await servers.service.invoke('catalog', null, { accountId: id })
      // Nothing is preselected. A region and a size are money and a place, and
      // a default here is a choice made on somebody's behalf that they then
      // have to notice.
      draft.region = ''
      size         = ''
      // The image IS defaulted where the vendor offers an obvious one, and the
      // region and size are not. An OS is a detail most people do not have an
      // opinion about; a region and a size are a place and a price.
      image = catalog.images.find(i => /ubuntu/i.test(i.label))?.slug
           ?? catalog.images[0]?.slug ?? ''
    } catch (err) {
      catError = err.message
    } finally {
      loadingCat = false
    }
  }

  $: account = accounts.find(a => a.id === accountId) ?? null

  // A size's price is minor units plus a currency — the divisor belongs to the
  // currency, so the formatting asks Intl rather than dividing by 100.
  const money = (minor, currency) =>
    new Intl.NumberFormat(undefined, { style: 'currency', currency }).format(minor / 100)

  $: regionOptions = (catalog?.regions ?? [])
    .filter(r => r.available)
    .map(r => ({ value: r.slug, label: `${r.label} (${r.slug})` }))

  // Only the sizes this REGION has. A picker offering a size the region cannot
  // give is a create that fails at the vendor with a message nobody here wrote.
  $: chosen = (catalog?.sizes ?? []).find(s => s.slug === size) ?? null

  $: sizeOptions = (catalog?.sizes ?? [])
    .filter(s => !draft.region || s.regions.includes(draft.region))
    .map(s => ({
      value: s.slug,
      label: `${s.label} — ${s.vcpu} vCPU, ${Math.round(s.memoryMb / 1024)} GB, `
           + `${s.diskGb} GB · ${money(s.priceMinor, s.currency)}/mo`,
    }))

  async function save(e) {
    e.preventDefault()
    errors = []; failed = null; saving = true
    try {
      // The field is `ipAddress`, camelCase, because the wire contract is the
      // SCHEMA's field names. `ip_address` would not error: autoValidate strips
      // unknown keys, the create succeeds, and the column comes back null.
      //
      // `providerId` is the ACCOUNT — a Secret id — and it is what makes the
      // machine's Conduit target address one account rather than a vendor
      // (`FJS-1020`). Sent only where one was chosen: the schema refuses a
      // providerKind of `custom` carrying an account.
      // Two different calls, and the difference is not cosmetic. `create`
      // records a machine somebody else made; `provision` asks a cloud to make
      // one and spends money doing it.
      const created = account
        ? await servers.service.invoke('provision', null, {
            name: draft.name, role: draft.role,
            accountId: account.id, region: draft.region, size, image,
          })
        : await servers.service.create(draft)

      goto(`/servers/${created.id}/`)
    } catch (err) {
      errors = err instanceof ResourceValidationError ? err.errors : []
      failed = err.message
    } finally {
      saving = false
    }
  }
</script>

<div class="section-header">
  <h1>Add server</h1>
  <Button variant="ghost" href="/servers/">Back to list</Button>
</div>

<div class="container narrow">
  <!-- `novalidate`, and the kit asks for it by name. A control carries a real
       `required` because that is what assistive tech announces — but inside a
       form the browser validates, the browser REFUSES to fire submit and shows
       its own bubble instead of the message the schema wrote. This form is
       hand-rolled rather than <Form>, which is novalidate by default, so it
       states it. The refusal still happens: the Data boundary is what enforces
       it, and `problem()` renders what it said. -->
  <form class="card stack" novalidate on:submit={save}>
    {#if failed}
      <!-- id'd because the shell's fleet-notice bar is also `.alert.danger`: a
           check looking for "the form reported a refusal" would otherwise match
           an unreachable machine somewhere else in the workspace. -->
      <article class="alert danger" id="form-error">
        <div class="alert-content">{failed}</div>
      </article>
    {/if}

    <Select label="Provider account" name="account" id="account"
            placeholder="No cloud — import a machine by address"
            options={accounts.map(a => ({
              value: a.id,
              label: `${a.name} (${a.providerKind})${a.isVerified ? '' : ' — unverified'}`,
            }))}
            value={accountId}
            onchange={(e) => chooseAccount(e.target.value)}
            hint="An account is a provider key in Secrets. Choosing one reads that cloud's regions and sizes." />

    {#if account && !account.isVerified}
      <article class="alert warning" id="account-unverified">
        <div class="alert-content">
          This token has not been checked against {account.providerKind}. Verify it in Secrets —
          the catalog below will not load until it works.
        </div>
      </article>
    {/if}

    <!-- `bind:` is not used on a component here: a component binding takes a
         writable top-level `let` in the caller, and `draft.name` is a member
         expression. The callback is the way a field of a record is written. -->
    <Input label="Name" name="name" id="name" required
           value={draft.name} oninput={(e) => draft.name = e.target.value}
           hint="The slug is derived from this by the service, and must be unique in the workspace."
           error={problem('name')} />

    <Select label="Role" name="role" id="role" placeholder=""
            options={roles} value={draft.role}
            onchange={(e) => draft.role = e.target.value} />

    {#if accountId}
      {#if catError}
        <article class="alert danger" id="catalog-error">
          <div class="alert-content">Could not read the catalog: {catError}</div>
        </article>
      {:else if loadingCat}
        <p class="text-sm text-muted" id="catalog-loading">Reading regions and sizes from {account?.providerKind}…</p>
      {:else if catalog}
        <Select label="Region" name="region" id="region" placeholder="Choose a region"
                options={regionOptions} value={draft.region}
                onchange={(e) => { draft.region = e.target.value; size = '' }}
                hint="Read from {account?.providerKind} just now — unavailable regions are not offered." />

        <Select label="Size" name="size" id="size"
                placeholder={draft.region ? 'Choose a size' : 'Choose a region first'}
                disabled={!draft.region}
                options={sizeOptions} value={size}
                onchange={(e) => size = e.target.value}
                hint="Only the sizes this region has." />

        <Select label="OS image" name="image" id="image" placeholder="Choose an image"
                options={(catalog.images ?? []).map(i => ({ value: i.slug, label: i.label }))}
                value={image}
                onchange={(e) => image = e.target.value} />

        {#if chosen}
          <article class="alert warning" id="provision-cost">
            <div class="alert-content">
              This creates a machine at {account?.providerKind} and starts billing:
              <strong>{chosen.label}</strong> in {draft.region} —
              <strong>{money(chosen.priceMinor, chosen.currency)}/month</strong>.
              It boots, installs its own outpost and reports back; nothing here connects to it.
            </div>
          </article>
        {/if}
      {/if}
    {/if}

    <Input label="IP address" name="ipAddress" id="ipAddress" placeholder="10.0.1.10"
           value={draft.ipAddress} oninput={(e) => draft.ipAddress = e.target.value}
           error={problem('ipAddress')} />

    {#if !accountId}
      <!-- `id="region"` on BOTH branches, never a second name. They are one
           field with two input types and the `{#if}` keeps them from ever
           coexisting, so a caller — a person, a label's `for`, or a drive —
           addresses the region the same way whichever path is open. Renaming
           this one to `region-free` is what broke `verify`. -->
      <Input label="Region" name="region" id="region" placeholder="nbg1"
             value={draft.region} oninput={(e) => draft.region = e.target.value}
             hint="A label of your own — an imported machine has no catalog to pick from." />
    {/if}

    <div class="cluster">
      <!-- The button says which of the two is about to happen, and it is
           disabled until a provision has everything it costs money to get
           wrong. A submit that fell back to `create` because a field was
           missing would record a machine nobody made. -->
      <Button variant="primary" type="submit"
              disabled={saving || (accountId && !(draft.region && size && image))}>
        {saving
          ? (accountId ? 'Provisioning…' : 'Adding…')
          : (accountId ? 'Provision server' : 'Add server')}
      </Button>
      <Button variant="ghost" href="/servers/">Cancel</Button>
    </div>
  </form>
</div>
