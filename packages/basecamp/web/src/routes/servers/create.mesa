---
title: Add server
---
<script>
  import { goto } from '@frontierjs/sierra/router'
  import { servers } from '../../resources/Server.mesa'
  import { ResourceValidationError } from '@frontierjs/sierra/junction'
  import Button from '@frontierjs/ui/components/forms/Button.mesa'
  import Select from '@frontierjs/ui/components/forms/Select.mesa'
  import Input  from '@frontierjs/ui/components/forms/Input.mesa'

  // Importing an existing machine, not provisioning a new one — Basecamp's
  // provider adapters are stubs until their env vars are set, so a wizard that
  // promised to create a Hetzner box would be promising something the API
  // cannot do yet.
  let draft  = servers.make({ name: '', ipAddress: '', region: '', role: 'general' })
  let errors = []
  let failed = null
  let saving = false

  $: (draft.name, draft.ipAddress, draft.region, draft.role)

  $: roles = servers.fields?.role?.enum ?? ['general']

  const problem = (field) => errors.find(e => e.field === field)?.message

  async function save(e) {
    e.preventDefault()
    errors = []; failed = null; saving = true
    try {
      // The field is `ipAddress`, camelCase, because the wire contract is the
      // SCHEMA's field names. `ip_address` would not error: autoValidate strips
      // unknown keys, the create succeeds, and the column comes back null.
      const created = await servers.service.create(draft)
      goto(`/servers/${created.id}/`)
    } catch (err) {
      errors = err instanceof ResourceValidationError ? err.errors : []
      failed = err.message
    } finally {
      saving = false
    }
  }
</script>

<div class="section-header">
  <h1>Add server</h1>
  <Button variant="ghost" href="/servers/">Back to list</Button>
</div>

<div class="container narrow">
  <form class="card stack" on:submit={save}>
    {#if failed}
      <article class="alert danger">
        <div class="alert-content">{failed}</div>
      </article>
    {/if}

    <!-- `bind:` is not used on a component here: a component binding takes a
         writable top-level `let` in the caller, and `draft.name` is a member
         expression. The callback is the way a field of a record is written. -->
    <Input label="Name" name="name" id="name" required
           value={draft.name} oninput={(e) => draft.name = e.target.value}
           hint="The slug is derived from this by the service, and must be unique in the workspace."
           error={problem('name')} />

    <!-- `bind:` is not used on a component here: a component binding takes a
         writable top-level `let` in the caller, and `draft.role` is a member
         expression. The callback is the way a field of a record is written. -->
    <Select label="Role" name="role" id="role" placeholder=""
            options={roles} value={draft.role}
            onchange={(e) => draft.role = e.target.value} />

    <Input label="IP address" name="ipAddress" id="ipAddress" placeholder="10.0.1.10"
           value={draft.ipAddress} oninput={(e) => draft.ipAddress = e.target.value}
           error={problem('ipAddress')} />

    <Input label="Region" name="region" id="region" placeholder="nbg1"
           value={draft.region} oninput={(e) => draft.region = e.target.value} />

    <div class="cluster">
      <Button variant="primary" type="submit" disabled={saving}>
        {saving ? 'Adding…' : 'Add server'}
      </Button>
      <Button variant="ghost" href="/servers/">Cancel</Button>
    </div>
  </form>
</div>
