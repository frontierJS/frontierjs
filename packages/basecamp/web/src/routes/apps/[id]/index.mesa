---
title: App
---
<script>
  // The mock's AppDetailView — 820 lines and the largest single gap in the
  // inventory, because until now an App had no screen of its own at all: you
  // could create one from an Environment and then never look at it again.
  //
  // The mock has seven tabs (http, configs, deploy, build, logs, log-analysis,
  // advanced). Five of them are backed by something real and are here. The
  // other three are named at the bottom of this file as gaps rather than
  // rendered as empty boxes — a tab that always says "no data" reads as a
  // broken screen, not as an honest one.
  //
  // One request feeds the whole page: `apps.get` returns the app with its
  // environment, its domains, where its replicas landed, its last ten releases
  // and its jobs. The alternative was five round trips for one question.
  import { page, goto } from '@frontierjs/sierra/router'
  import { getClient } from '@frontierjs/sierra/resource'
  import App, { apps, importDockerfile, dockerfileTemplate, mintDeployKey } from '../../../resources/App.mesa'
  import { domains } from '../../../resources/Domain.mesa'
  import { servers } from '../../../resources/Server.mesa'
  import { deployments, DEPLOY_TONE } from '../../../resources/Deployment.mesa'
  import { session } from '../../../lib/session.js'
  import { at, ago } from '../../../lib/datetime.js'
  import { shortSha } from '../../../lib/displays.js'

  import NavIcon from '../../../components/NavIcon.mesa'
  import NoRecord from '../../../components/NoRecord.mesa'
  import LaptopRelease from '../../../components/LaptopRelease.mesa'
  import LogView from '../../../components/LogView.mesa'
  import VariablesEditor from '../../../components/VariablesEditor.mesa'

  import Badge      from '@frontierjs/ui/components/display/Badge.mesa'
  import Button     from '@frontierjs/ui/components/forms/Button.mesa'
  import CopyButton from '@frontierjs/ui/components/display/CopyButton.mesa'
  import Callout    from '@frontierjs/ui/components/display/Callout.mesa'
  import Card       from '@frontierjs/ui/components/layout/Card.mesa'
  import Drawer     from '@frontierjs/ui/components/overlay/Drawer.mesa'
  import DropdownMenu      from '@frontierjs/ui/components/overlay/DropdownMenu.mesa'
  import DropdownItem      from '@frontierjs/ui/components/overlay/DropdownItem.mesa'
  import DropdownSeparator from '@frontierjs/ui/components/overlay/DropdownSeparator.mesa'
  import EmptyState from '@frontierjs/ui/components/display/EmptyState.mesa'
  import Form       from '@frontierjs/ui/components/forms/Form.mesa'
  import Input      from '@frontierjs/ui/components/forms/Input.mesa'
  import Json       from '@frontierjs/ui/components/display/Json.mesa'
  import Pill       from '@frontierjs/ui/components/display/Pill.mesa'
  import Select     from '@frontierjs/ui/components/forms/Select.mesa'
  import Textarea   from '@frontierjs/ui/components/forms/Textarea.mesa'
  import { toasts } from '@frontierjs/ui/stores/toastStore'
  import Table from '@frontierjs/ui/components/display/Table.mesa'
  import { offerUndo } from '../../../resources/Trash.mesa'

  $: page.params

  let app       = null
  let error     = null
  let loadError = null
  let loading   = true
  let busy      = null
  // `?tab=` and `?cert=` are how another screen sends somebody to one domain's
  // certificate form — DNS links its expiring rows here, so there is one
  // upload form rather than a copy per screen. Checked against TABS below.
  let tab       = typeof page.query?.tab === 'string' ? page.query.tab : 'overview'
  let editing   = false
  let adding    = false
  let certFor   = typeof page.query?.cert === 'string' ? page.query.cert : null   // domain id whose upload form is open
  let draft     = domains.make()
  let certDraft = { certPem: '', keyPem: '', expiresAt: '' }
  let fleet     = []                 // the workspace's machines, for the placement select
  // Every machine, not a page — the server refuses a page above its max. Held
  // in a `let` rather than read in the markup because a select with no options
  // and a select still loading look identical, and the difference decides
  // whether 'Place' is a dead button.
  const fleetList = servers.tethered({ state: 'local', all: true })
  $: { fleet = fleetList.rows }
  let placeOn   = ''
  // Declared up here with the rest of the screen's state and not beside the
  // functions that use them: `watchApp` subscribes on the first load and the
  // callback seeds the draft, which runs before anything further down the
  // module body has been evaluated.
  let files       = []
  let sourceDirty = false
  let imageDraft  = ''
  // A git app's own Dockerfile copy (FJS-D1555). Declared with the state above
  // for the same reason: the watch callback seeds it before the module body ends.
  let dockerfileDraft = ''
  let dockerfileDirty = false
  let dockerfileSays  = ''

  // `late` is the API's: past the lag `backup.replica-lag` fails at.
  const bucketTone = (r) => r.error || (r.late && r.lagMs !== null) ? 'danger' : r.late ? 'warning' : 'success'
  const bucketSays = (r) => r.error ? `Litestream: ${r.error}`
    : r.lagMs === null ? 'Bucket: not synced yet'
    : `Bucket ${r.lagMs < 60_000 ? `${Math.round(r.lagMs / 1000)}s` : ago(r.lastSyncAt)} behind`

  function write(name, value) { draft = { ...draft, [name]: value } }
  function writeCert(name, value) { certDraft = { ...certDraft, [name]: value } }

  // The app itself, watched rather than read (`FJS-518`). `apps.get()` is
  // `detail(id)` — the row plus its domains — so this is a COMPOSED view: the
  // node says the row moved and the composed answer is read again. Watching the
  // node's own value would empty `app.domains` at the first push, because a
  // push carries the row alone (`FJS-533`).
  // Named `appRow` and not `row`: the domains table below declares a
  // `{#snippet row(d)}`, and a snippet is a binding in the same component.
  let appRow  = null
  let unwatch = null

  function watchApp(id) {
    if (appRow && String(appRow.id) === String(id)) return appRow.refresh()
    unwatch?.(); appRow?.release()
    appRow = apps.record(id, { composed: true })
    unwatch = appRow.subscribe(v => { app = v; seedFiles(v); seedDockerfile(v) })
    return appRow.ready
  }

  async function load() {
    error = null; loadError = null
    try {
      await watchApp(page.params.id)
      // A record view settles on a failed read rather than rejecting, so a
      // read nothing answered would otherwise draw as a record that is gone.
      // A 4xx is an answer and stays NoRecord's plain absence.
      const failed = appRow.error?.()
      if (failed && (failed.status === 0 || failed.status >= 500))
        throw Object.assign(new Error(`The app could not be read (${failed.code})`), { code: failed.status })
    } catch (e) {
      // Two readers, and they are not the same question. `error` is the banner
      // over a page that still has its record; `loadError` is why this page has
      // none, and only the thrown value can tell refused from gone from failed.
      error = e.message; loadError = e
    } finally {
      loading = false
    }
  }

  load()
  $: page.params.id, () => load()

  // A domain write names the DOMAIN, not the app, so no node of App moves and
  // the composed view above has nothing to fire on. Reads are filtered out or
  // the handler answers its own refetch, forever.
  const READS = new Set(['get', 'find'])
  var offDomains = domains.service.on('*', (method, changed) => {
    if (READS.has(method) || changed?.appId !== page.params.id) return
    load()
  })
  $.onDestroy(() => { offDomains(); unwatch?.(); appRow?.release() })

  async function addDomain() {
    error = null; busy = 'domain'
    try {
      await domains.service.create({ ...draft, appId: app.id })
      toasts.success(`${draft.hostname} added`)
      draft = domains.make()
      adding = false
      await load()
    } catch (e) {
      error = e.message
    } finally {
      busy = null
    }
  }

  async function makePrimary(domain) {
    error = null; busy = domain.id
    try {
      await domains.service.invoke('makePrimary', domain.id)
      await load()
    } catch (e) {
      error = e.message
    } finally {
      busy = null
    }
  }

  async function removeDomain(domain) {
    error = null; busy = domain.id
    try {
      await domains.service.remove(domain.id)
      offerUndo(domain.hostname, domains, domain.id, load)
      await load()
    } catch (e) {
      // 'That is the primary hostname — make another one primary first' lands
      // here. The button is not disabled: the refusal is the service's to make.
      error = e.message
    } finally {
      busy = null
    }
  }

  // ─── Logs ───────────────────────────────────────────────────────────────
  // Read on DEMAND and never on a timer: a console that polled every app's
  // container would be a fleet-wide `docker logs` on a loop. Follow is the
  // other shape — one socket the operator opened, for one app, closed when
  // they leave the tab (api/src/plugins/machine-stream.ts).
  let logs      = null
  let logsBusy  = false
  let logsTail  = 200
  let logsSince = ''
  let logsRaw   = false

  async function loadLogs() {
    error = null; logsBusy = true
    try {
      logs = await apps.service.invoke('logs', app.id,
        { tail: logsTail, ...(logsSince ? { since: logsSince } : {}) })
    } catch (e) {
      // The machine's own sentence. A generic failure here is how somebody ends
      // up ssh'ing to the box this screen exists to replace.
      error = e.message
      logs  = null
    } finally {
      logsBusy = false
    }
  }

  // A followed log keeps its newest lines; an afternoon of a chatty container
  // would otherwise be re-parsed whole on every flush.
  const FOLLOW_KEEP = 5000
  let follow      = null    // the socket, while following
  let followState = ''      // '' · connecting · open · ended
  let followHeld  = { stdout: [], stderr: [] }
  let flushTimer  = null

  const keep = (text, more) => {
    const lines = (text ? text.split('\n') : []).concat(more)
    return lines.slice(-FOLLOW_KEEP).join('\n')
  }

  // Lines arrive one frame each; drawing per frame re-renders per line.
  function flush() {
    flushTimer = null
    const { stdout, stderr } = followHeld
    followHeld = { stdout: [], stderr: [] }
    if (!stdout.length && !stderr.length) return
    logs = { ...logs, stdout: stdout.length ? keep(logs.stdout, stdout) : logs.stdout,
                      stderr: stderr.length ? keep(logs.stderr, stderr) : logs.stderr }
  }

  function startFollow() {
    stopFollow()
    error = null
    logs  = { running: true, stdout: '', stderr: '' }
    followState = 'connecting'
    const client = getClient()
    const q = new URLSearchParams({ workspace: session.workspaceId ?? '', tail: String(logsTail) })
    if (logsSince) q.set('since', logsSince)
    const url = `${(client.origin || location.origin).replace(/^http/, 'ws')}/ws/stream/logs/${encodeURIComponent(app.id)}?${q}`
    const ws = new WebSocket(url, client.token ? ['fjs', `fjs.bearer.${client.token}`] : ['fjs'])
    follow = ws
    ws.onopen    = () => { followState = 'open' }
    ws.onmessage = (e) => {
      let frame
      try { frame = JSON.parse(e.data) } catch { return }
      if (frame.event === 'error') error = frame.data?.error ?? 'The stream failed'
      if (frame.event !== 'message' || !frame.data) return
      ;(frame.data.stream === 'stderr' ? followHeld.stderr : followHeld.stdout).push(frame.data.text ?? '')
      flushTimer ??= setTimeout(flush, 150)
    }
    ws.onclose = (e) => {
      if (follow !== ws) return
      flush()
      follow = null
      followState = 'ended'
      // 4xxx is the API refusing, with its own sentence.
      if (e.code >= 4000 && e.reason) error = e.reason
    }
  }

  function stopFollow() {
    if (!follow) return
    const ws = follow
    follow = null
    ws.onclose = null
    ws.close()
    clearTimeout(flushTimer)
    flush()
    followState = 'ended'
  }

  $: { if (tab !== 'logs') stopFollow() }
  $.onDestroy(() => stopFollow())

  // Placement — POST /apps/:id with X-Service-Method. The row it writes is
  // `@@gate(2.8)`, so the service does it through asSystem() after checking
  // the caller against the workspace; nothing here needs to know that.
  async function place() {
    if (!placeOn) return
    error = null; busy = 'placement'
    try {
      app = await apps.service.invoke('place', app.id, { serverId: placeOn })
      placeOn = ''
    } catch (e) {
      error = e.message
    } finally {
      busy = null
    }
  }

  async function restoreFound(p) {
    error = null; busy = `found:${p.serverId}`
    try {
      await apps.service.invoke('restoreReplica', app.id, { serverId: p.serverId })
      app = await apps.service.get(app.id)
    } catch (e) {
      error = e.message
    } finally {
      busy = null
    }
  }

  async function dismissFound() {
    error = null; busy = 'found'
    try {
      app = await apps.service.invoke('dismissFound', app.id)
    } catch (e) {
      error = e.message
    } finally {
      busy = null
    }
  }

  async function unplace(p) {
    error = null; busy = p.id
    try {
      app = await apps.service.invoke('unplace', app.id,
        { serverId: p.serverId, replicaIndex: p.replicaIndex })
    } catch (e) {
      error = e.message
    } finally {
      busy = null
    }
  }

  async function uploadCert(domain) {
    error = null; busy = domain.id
    try {
      await domains.service.invoke('uploadCert', domain.id, certDraft)
      toasts.success(`Certificate stored for ${domain.hostname}`)
      certDraft = { certPem: '', keyPem: '', expiresAt: '' }
      certFor = null
      await load()
    } catch (e) {
      error = e.message
    } finally {
      busy = null
    }
  }

  // ─── The pasted source ──────────────────────────────────────────────────
  //
  // An app whose source is `inline` IS these files: no repository, no image, no
  // build. The editor is the deploy surface, which is the whole point of the
  // kind — an HTML page that pulls its libraries off a CDN is a running app the
  // moment somebody presses the button.
  //
  // Nothing here validates. The size caps, the path shapes and the missing
  // entry point are all the service's answer, said in a sentence this screen
  // shows — a second copy of those rules in the browser is a second place to
  // change them and the one that is wrong is never the one that refuses.
  const STARTER = `<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>New app</title>
  </head>
  <body>
    <h1>Hello</h1>
    <p>Edit this file, press Save and deploy, and it is live.</p>
  </body>
</html>
`

  const isInline = () => app?.source?.kind === 'inline'
  // A static app with nothing in it yet is offered the editor too: the kind is
  // what somebody is about to choose, and a screen that hides the box until the
  // source already exists has no way of ever creating one.
  const canPaste = () => isInline() || (app?.type === 'static' && !app?.source?.kind)

  /** Seed the draft from the row — but NEVER over something being typed. The
   *  record is live, so a push from anybody's write re-enters `load()`, and a
   *  re-seed there would empty the editor under the person using it. */
  function seedFiles(row) {
    if (sourceDirty) return
    files = (row?.source?.files ?? []).map(f => ({ path: f.path, content: f.content ?? '' }))
  }

  /** Same rule as seedFiles: a push never empties the box under the person typing. */
  function seedDockerfile(row) {
    if (dockerfileDirty) return
    dockerfileDraft = row?.source?.dockerfile ?? ''
  }

  function typeDockerfile(text) { dockerfileDraft = text; dockerfileDirty = true }

  async function saveDockerfile() {
    error = null; busy = 'dockerfile'
    try {
      // Blank is "no copy, build the repository's own". The server drops an
      // empty string to an absent key, and this omits it, so both say one thing.
      const { dockerfile: _copy, dockerfileBytes: _size, ...rest } = app.source
      const text = dockerfileDraft.trim()
      await apps.service.patch(app.id, { source: { ...rest, ...(text ? { dockerfile: dockerfileDraft } : {}) } })
      dockerfileDirty = false
      await appRow.refresh()
      toasts.success(text ? 'Dockerfile saved' : 'Dockerfile copy removed')
    } catch (e) {
      error = e.message
    } finally {
      busy = null
    }
  }

  async function importFromRepo() {
    error = null; dockerfileSays = ''; busy = 'dockerfile-import'
    try {
      const r = await importDockerfile(app.id)
      // The forge answers the branch now and the clone the last build, so the
      // line says which one filled the editor.
      const branch = app.source?.branch
      const where = r.from === 'forge' ? `the repository${branch ? ` at ${branch}` : ''}` : 'the machine\'s clone'
      if (r.path) { typeDockerfile(r.content); dockerfileSays = `Filled from ${r.path} in ${where}. Save to keep it.` }
      else dockerfileSays = r.note || 'Neither the repository nor the machine\'s clone holds a Dockerfile.'
    } catch (e) {
      error = e.message
    } finally {
      busy = null
    }
  }

  async function useTemplate() {
    error = null; dockerfileSays = ''; busy = 'dockerfile-template'
    try {
      typeDockerfile((await dockerfileTemplate()).content)
      dockerfileSays = 'Filled with the FrontierJS template. Save to keep it.'
    } catch (e) {
      error = e.message
    } finally {
      busy = null
    }
  }

  let keySays = ''
  async function mintKey() {
    error = null; keySays = ''; busy = 'deploy-key'
    try {
      const r = await mintDeployKey(app.id)
      if (r.note) keySays = r.note
      await appRow.refresh()
    } catch (e) {
      error = e.message
    } finally {
      busy = null
    }
  }

  // A key is made on the machine the app runs on, so with no online machine
  // there is nothing to ask. The reason is said beside the button.
  $: onlinePlaced = (app?.placement ?? []).some(p =>
    (p.server?.status ?? fleet.find(s => s.id === p.serverId)?.status) === 'online')

  function editFile(i, key, value) {
    files = files.map((f, n) => (n === i ? { ...f, [key]: value } : f))
    sourceDirty = true
  }
  function addFile(path = '', content = '') {
    files = [...files, { path, content }]
    sourceDirty = true
  }
  function dropFile(i) {
    files = files.filter((_, n) => n !== i)
    sourceDirty = true
  }

  /**
   * Save, and optionally ship.
   *
   * Two calls rather than one, and the order is what makes the failure legible:
   * the source is written first, so a deploy refused for want of a machine
   * leaves the edit saved and the button ready — where one combined call would
   * have to choose between losing the typing and shipping something nobody
   * asked to ship.
   */
  /** Ship what the app already names. The service refuses an app with nothing
   *  to ship, or no machine to ship to, in a sentence this screen shows. */
  async function deploy() {
    error = null; busy = 'deploy'
    try {
      const release = await deployments.service.create({ appId: app.id })
      toasts.success('Deploying')
      goto(`/deployments/${release.id}/`)
    } catch (e) {
      error = e.message
    } finally {
      busy = null
    }
  }

  /** This form points a container app at a prebuilt image; a git source is set through the API. */
  async function saveImage({ ship } = {}) {
    error = null; busy = ship ? 'deploy' : 'save'
    try {
      app = await apps.service.patch(app.id, { source: { kind: 'image', image: (imageDraft || app.source?.image || '').trim() } })
      if (ship) return deploy()
      toasts.success('Image saved')
    } catch (e) {
      error = e.message
    } finally {
      if (!ship) busy = null
    }
  }

  async function saveSource({ deploy } = {}) {
    error = null; busy = deploy ? 'deploy' : 'save'
    try {
      app = await apps.service.patch(app.id, { source: { kind: 'inline', files } })
      sourceDirty = false
      if (!deploy) { toasts.success('Source saved'); return }

      const release = await deployments.service.create({ appId: app.id })
      toasts.success('Deploying')
      goto(`/deployments/${release.id}/`)
    } catch (e) {
      // The service's own sentence: which file, which limit, or which machine
      // is missing. A generic failure here is a person reading their own HTML
      // trying to work out what a console did not like about it.
      error = e.message
    } finally {
      busy = null
    }
  }

  // ─── The app itself ─────────────────────────────────────────────────────

  // The default form writes through `apps.save()`, which answers the bare row;
  // the page shows the composed one, so it reads again rather than merging.
  async function saved() {
    editing = false
    toasts.success('App saved')
    await load()
  }

  async function removeApp() {
    error = null; busy = 'remove'
    // Read before the write: the row is watched, and the delete's own push
    // empties `app` before the next line runs.
    const { id, name, environmentId } = app
    try {
      await apps.service.remove(id)
      offerUndo(name, apps, id)
      goto(`/environments/${environmentId}/`)
    } catch (e) {
      error = e.message
      busy  = null
    }
  }

  // ─── Deploy on push (FJS-D884) ──────────────────────────────────────────

  // The credentials are in the answer to `enablePush` and nowhere else, so they
  // live here and only until the page is left: a reload shows the card with
  // push on and no secret, and Rotate is how a person gets a new pair.
  let pushKeys = null

  async function enablePush() {
    error = null; busy = 'push'
    try {
      pushKeys = await apps.service.invoke('enablePush', app.id, {})
    } catch (e) {
      error = e.message
    } finally {
      busy = null
    }
  }

  async function disablePush() {
    error = null; busy = 'push'
    try {
      await apps.service.invoke('disablePush', app.id, {})
      pushKeys = null
      toasts.success('Deploy on push is off')
    } catch (e) {
      error = e.message
    } finally {
      busy = null
    }
  }

  /** Put back what `d` replaced — a new release of the old bytes. The service
   *  names why when it cannot: a first release, or a predecessor that is gone. */
  async function rollback(d) {
    error = null; busy = d.id
    try {
      const replacement = await deployments.service.invoke('rollback', d.id, {})
      toasts.success('Rolling back')
      goto(`/deployments/${replacement.id}/`)
    } catch (e) {
      error = e.message
      busy  = null
    }
  }

  // The newest release is the only row a person acts on: a success is what is
  // live and can be withdrawn, a failure is what a retry would replace. Older
  // rows are history, and rolling one of them back puts back something two
  // releases stale.
  $: session.level
  $: latest      = app?.recent_deployments?.[0] ?? null
  $: rollbackIt  = latest ? deployments.transitions(latest, session.level).find(m => m.name === 'rollback') : null
  $: canRetry    = latest && (latest.status === 'failed' || latest.status === 'cancelled')
  $: primaryHost = app?.domains?.find(d => d.isPrimary)?.hostname ?? null
  // Deploy ships the Source tab, so over a sent build the app goes back to
  // what that tab names. The live row's trigger says which door it came
  // through; nothing else on the row tells a laptop build from a push.
  $: live        = app?.recent_deployments?.find(d => d.status === 'success') ?? null
  // After a hub restore the bucket held this app's replica (`IDEAS/backups.md`
  // 4.5). Hidden while a placement reads it replicating inside the lag window:
  // that app is alive, and Outpost refuses a volume its container holds.
  $: foundShown  = !!app?.replicaFoundAt && !(app.placement ?? []).some(p => p.replication && !p.replication.late)
  $: overBuild   = live?.trigger === 'laptop'
    ? (app?.source?.kind === 'git'
        ? 'A laptop build is live — fli basecamp:deploy sent it. Deploy, and the next push, replaces it with a build of the branch on the Source tab.'
        : 'A laptop build is live — fli basecamp:deploy sent it. Deploy replaces it with the files on the Source tab.')
    : live?.trigger === 'freeze'
      ? 'The live site is a frozen preview. Deploy replaces it with the files on the Source tab.'
      : null

  function whoShipped(d) {
    return d.author ? ` by ${d.author}` : ''
  }

  const STATUS_TONE = {
    running: 'success', deploying: 'info', starting: 'info',
    error: 'danger', stopped: 'muted', unknown: 'muted', stopping: 'warning',
  }
  const CERT_TONE = {
    active: 'success', expiring_soon: 'warning', expired: 'danger', none: 'muted',
  }

  // Only the tabs with something behind them. See the note at the foot.
  const TABS = ['overview', 'domains', 'source', 'config', 'releases', 'logs']
  if (!TABS.includes(tab)) tab = 'overview'
  const APP_RELEASES_COLUMNS = [
    { name: 'queued',  label: 'Queued' },
    { name: 'status',  label: 'Status' },
    { name: 'commit',  label: 'Commit' },
    { name: 'branch',  label: 'Branch' },
    { name: 'trigger', label: 'Trigger' },
    { name: 'actions', label: '' },
  ]
</script>

<!-- The banner is for an ACTION that failed on a page that still has its
     record. A failed LOAD is answered by <NoRecord> below, which says what
     happened and what to do about it — rendering both put two `#screen-error`
     elements on one document and said the same thing twice. The other six
     detail screens keep theirs inside the row branch, which is the same rule
     spelled by nesting. -->
{#if error && app}
  <article class="alert danger" id="screen-error">
    <div class="alert-content">{error}</div>
  </article>
{/if}

{#if loading}
  <p class="text-sm text-muted">Loading…</p>
{:else if app}
  <nav aria-label="Breadcrumb" class="cluster" id="app-breadcrumb">
    {#if app.environment?.project}
      <a class="navlink" href={`/projects/${app.environment.projectId}/`}>{app.environment.project.name}</a>
      <span class="text-muted">/</span>
    {/if}
    <a class="navlink" href={`/environments/${app.environmentId}/`}>{app.environment?.name ?? 'Environment'}</a>
  </nav>

  <div class="section-header">
    <div class="stack" style:gap="0.25rem">
      <h1>{app.name}</h1>
      <span class="cluster text-sm text-muted">
        <code id="app-source-line">{app.sourceLabel}</code>
        <Pill tone={STATUS_TONE[app.status] ?? 'muted'} id="app-status">{app.status}</Pill>
        <Badge tone="muted">{app.type}</Badge>
      </span>
    </div>
    <span class="cluster">
      {#if primaryHost}
        <Button treatment="outlined" href={`https://${primaryHost}`} target="_blank" rel="noopener" id="app-visit">Visit</Button>
      {/if}
      <Button tone="primary" id="app-deploy" disabled={!!busy} onclick={deploy}
              data-confirm={overBuild} data-confirm-title="Replace the live build?" data-confirm-label="Deploy">
        {busy === 'deploy' ? 'Deploying…' : 'Deploy'}
      </Button>
      <DropdownMenu placement="bottom-end">
        {#snippet trigger()}
          <Button treatment="ghost" aria-label="More actions" id="app-more">⋯</Button>
        {/snippet}
        <DropdownItem id="app-edit" onclick={() => editing = true}>Edit</DropdownItem>
        <DropdownSeparator />
        <!-- Cascade: `@@softDelete(cascade)` stamps its releases, jobs and
             domains with it, and an inline app is retired from its machine. -->
        <DropdownItem tone="danger" id="app-delete" disabled={!!busy}
                      data-confirm={`${app.name} stops serving, and its releases, jobs and domains go with it.`}
                      data-confirm-title="Delete this app?" data-confirm-label="Delete"
                      onclick={removeApp}>Delete app</DropdownItem>
      </DropdownMenu>
    </span>
  </div>

  <!-- The fields are the model's default form; `source` has its own editor on
       the Source tab, which knows the three kinds and the paste box's limits. -->
  <Drawer open={editing} title={`Edit ${app.name}`} onclose={() => editing = false}>
    {#if editing}
      <App record={app} except={['source', ...(app.domains?.length ? ['port'] : [])]} oncancel={() => editing = false}
           ondone={saved} submitId="app-edit-save" />
    {/if}
  </Drawer>

  <!-- Tabs as buttons with aria-selected, not links: they are one screen's
       panels rather than four routes, and a screen reader is told which is
       current by the attribute the stylesheet already keys off. -->
  <div class="cluster" role="tablist" aria-label="App sections" id="app-tabs">
    {#each TABS as t}
      <Button treatment={tab === t ? 'outlined' : 'ghost'} role="tab"
              aria-selected={tab === t ? 'true' : 'false'}
              onclick={() => tab = t}>{t}</Button>
    {/each}
  </div>

  {#if tab === 'overview'}
    <div class="split" style:align-items="start" style:flex-wrap="wrap" style:gap="1.5rem" id="app-overview">
    <div class="stack" style:flex="1 1 32rem" style:min-width="0">
      {#if foundShown}
        <Card id="app-found">
          <h2 class="h4">Replica found</h2>
          <p class="text-sm">
            Basecamp was restored, and the bucket holds this app's replica, last synced
            {app.replicaSyncedAt ? at(app.replicaSyncedAt) : 'at an unknown time'}.
          </p>
          {#if app.placement?.length}
            <ul class="stack" id="app-found-targets">
              {#each app.placement as p}
                <li class="cluster">
                  {#if p.server?.status === 'online'}
                    <Button tone="primary" disabled={!!busy} onclick={() => restoreFound(p)}
                            data-confirm={`The databases in this app's volume on ${p.server?.name ?? 'that server'} are replaced by the replica. Stop the app there first.`}
                            data-confirm-title="Restore the replica?" data-confirm-label="Restore">
                      Restore onto {p.server?.name ?? p.serverId}
                    </Button>
                  {:else}
                    <!-- A machine that stopped checking in cannot be sent a restore. -->
                    <span class="text-sm">{p.server?.name ?? p.serverId} is {p.server?.status ?? 'gone'}:</span>
                    <a href={`/servers/${p.serverId}/`}>re-enroll it first</a>
                  {/if}
                </li>
              {/each}
            </ul>
          {:else}
            <p class="text-sm text-muted">It is placed nowhere. Place it on a machine below, then restore onto it.</p>
          {/if}
          <div class="cluster">
            <Button treatment="ghost" id="app-found-dismiss" disabled={!!busy} onclick={dismissFound}>Dismiss</Button>
          </div>
        </Card>
      {/if}
      <Card>
        <div class="section-header">
          <h2 class="h4">Deployments</h2>
          <Button treatment="ghost" onclick={() => tab = 'releases'}>All releases</Button>
        </div>
        {#if !latest}
          <p class="text-sm text-muted" id="app-latest-empty">Never released. Deploy ships what the Source tab names.</p>
        {:else}
          <div class="split" style:flex-wrap="wrap" id="app-latest">
            <span class="cluster">
              <a href={`/deployments/${latest.id}/`}><Pill tone={DEPLOY_TONE[latest.status] ?? 'info'}>{latest.status}</Pill></a>
              <code>{shortSha(latest.commitSha) ?? latest.toImage ?? '—'}</code>
              {#if latest.commitMessage}<span class="text-sm">{latest.commitMessage}</span>{/if}
            </span>
            <span class="cluster text-sm text-muted">
              {#if latest.branch}from <code>{latest.branch}</code>{/if}
              {ago(latest.queuedAt)}{whoShipped(latest)}
              {#if rollbackIt}
                <!-- Drawn disabled below the move's level rather than hidden:
                     a developer can see a rollback exists and who may make it. -->
                <Button treatment="ghost" tone="warning" id="app-rollback" disabled={!rollbackIt.allowed || busy === latest.id}
                        data-confirm="A new release puts back the bytes and config this one replaced."
                        data-confirm-title="Roll back this release?" data-confirm-label="Roll back"
                        onclick={() => rollback(latest)}>Roll back</Button>
              {/if}
              {#if canRetry}
                <Button treatment="ghost" id="app-retry" disabled={!!busy} onclick={deploy}>Retry</Button>
              {/if}
            </span>
          </div>
        {/if}
      </Card>

      {#if overBuild}
        <Callout tone="info" id="app-live-build">{overBuild}</Callout>
      {/if}
      {#if !latest}<LaptopRelease app={app} />{/if}

      {#if app.source?.kind === 'git'}
        <Card id="app-deploy-key">
          <h2 class="h4">Deploy key</h2>
          {#if app.deployPublicKey}
            <pre class="text-sm" style:white-space="pre-wrap" style:overflow-wrap="anywhere"><code id="app-deploy-key-public">{app.deployPublicKey}</code></pre>
            <div class="cluster">
              <CopyButton text={app.deployPublicKey} label="Copy" treatment="outlined" id="app-deploy-key-copy" />
            </div>
          {:else}
            <p class="text-sm text-muted" id="app-deploy-key-none">No key yet.</p>
            <div class="cluster">
              <Button tone="primary" id="app-deploy-key-mint" disabled={!onlinePlaced || busy === 'deploy-key'}
                      onclick={mintKey}>Mint key</Button>
              {#if !onlinePlaced}
                <span class="text-sm text-muted">Place this app on an online server first — the key is made on the machine.</span>
              {/if}
            </div>
          {/if}
          {#if keySays}<p class="text-sm text-muted" id="app-deploy-key-says" role="status">{keySays}</p>{/if}
          <p class="text-sm text-muted">Add it as a read-only deploy key on the repository (GitHub: Settings → Deploy keys).</p>
        </Card>

        <Card id="app-dockerfile">
          <h2 class="h4">Dockerfile</h2>
          <Textarea label="Dockerfile" rows={14} id="app-dockerfile-body" value={dockerfileDraft}
                    oninput={(e) => typeDockerfile(e.target.value)} />
          <p class="text-sm text-muted" id="app-dockerfile-builds">
            The machine builds with
            {#if dockerfileDraft.trim()}this copy.{:else}the repository's <code>deploy/Dockerfile</code> or <code>Dockerfile</code>.{/if}
          </p>
          {#if dockerfileSays}<p class="text-sm text-muted" id="app-dockerfile-says" role="status">{dockerfileSays}</p>{/if}
          <div class="cluster">
            <Button tone="primary" id="app-dockerfile-save" disabled={!dockerfileDirty || busy === 'dockerfile'}
                    onclick={saveDockerfile}>Save</Button>
            <Button treatment="outlined" id="app-dockerfile-import" disabled={!!busy}
                    onclick={importFromRepo}>Import from repository</Button>
            <Button treatment="outlined" id="app-dockerfile-template" disabled={!!busy}
                    onclick={useTemplate}>Use the FrontierJS template</Button>
            {#if dockerfileDirty}<Badge tone="warning">unsaved</Badge>{/if}
          </div>
          <p class="text-sm text-muted">The template clones frontierjs from GitHub at build — for an app whose deps are <code>link:</code>.</p>
        </Card>
      {/if}

      <Card>
        <h2 class="h4">Placement</h2>
        <p class="text-sm text-muted">Which machines run this app. A release with no placement is refused — there is nothing to send it to.</p>
        {#if app.placement?.length}
          <ul class="stack" id="app-placement">
            {#each app.placement as p}
              <li class="cluster">
                <a href={`/servers/${p.serverId}/`}>{p.server?.name ?? p.serverId}</a>
                <Badge tone="muted">replica {p.replicaIndex}</Badge>
                <Pill>{p.status}</Pill>
                {#if p.replication}
                  <!-- Litestream's word for how far the bucket is, read at the
                       machine's last heartbeat. -->
                  <Badge tone={bucketTone(p.replication)} data-replication>{bucketSays(p.replication)}</Badge>
                {/if}
                {#if p.drill}
                  <Badge tone={p.drill.status === 'success' ? 'success' : 'danger'} title={p.drill.error ?? ''} data-drill>
                    {p.drill.status === 'success' ? 'Drill passed' : 'Drill failed'} {ago(p.drill.finishedAt)}
                  </Badge>
                {/if}
                <Button treatment="ghost" tone="danger" disabled={busy === p.id}
                        data-confirm={`This replica stops running on ${p.server?.name ?? 'that server'}.`}
                        data-confirm-title="Unplace this replica?" data-confirm-label="Unplace"
                        onclick={() => unplace(p)}>Unplace</Button>
              </li>
            {/each}
          </ul>
        {:else}
          <p class="text-sm text-muted" id="app-placement-empty">Not placed on any server yet.</p>
        {/if}
        <div class="cluster" id="app-place">
          <label class="visually-hidden" for="place-on">Place on</label>
          <Select id="place-on" value={placeOn} placeholder="Place on…"
                  options={fleet.map(s => ({ value: s.id, label: `${s.name} · ${s.status}` }))}
                  oninput={(e) => placeOn = e.target.value}
                  onchange={(e) => placeOn = e.target.value} />
          <Button tone="primary" disabled={!placeOn || busy === 'placement'}
                  onclick={place}>Place</Button>
        </div>
      </Card>

      <Card>
        <h2 class="h4">Scheduled work</h2>
        {#if app.jobs?.length}
          <ul class="stack">
            {#each app.jobs as j}
              <li class="cluster">
                <a href={`/jobs/${j.id}/`}>{j.name}</a>
                <Pill>{j.status}</Pill>
              </li>
            {/each}
          </ul>
        {:else}
          <p class="text-sm text-muted">No jobs belong to this app.</p>
        {/if}
      </Card>
    </div>

    <aside class="stack" style:flex="0 1 17rem" id="app-details">
      <h2 class="h4">Details</h2>
      <dl class="facts">
        <dt>Type</dt><dd>{app.type}</dd>
        <dt>Port</dt><dd><code>{app.port ?? 'not set'}</code></dd>
        <dt>Hostname</dt><dd><code>{primaryHost ?? 'none'}</code></dd>
        <dt>Label</dt><dd><code>{app.slug}</code></dd>
        {#if app.environment?.project}
          <dt>Project</dt>
          <dd><a href={`/projects/${app.environment.projectId}/`}>{app.environment.project.name}</a></dd>
        {/if}
        <dt>Environment</dt>
        <dd><a href={`/environments/${app.environmentId}/`}>{app.environment?.name ?? '—'}</a></dd>
        <dt>Created</dt><dd>{at(app.createdAt)}</dd>
      </dl>
      <Button treatment="outlined" onclick={() => editing = true}>Edit details</Button>
    </aside>
    </div>
  {/if}

  {#if tab === 'domains'}
    <div class="section-header">
      <h2 class="h4">Domains &amp; SSL</h2>
      <Button tone="primary" id="add-domain" onclick={() => adding = !adding}>
        {adding ? 'Cancel' : 'Add hostname'}
      </Button>
    </div>

    <Callout tone="info" title="The private key is written once">
      A certificate uploaded here is stored as a <a href="/secrets/">Secret</a> whose value is
      encrypted at rest and never returned by the API. What stays on the domain is the metadata
      an operator reads — and its status is derived from the expiry, not stored beside it.
    </Callout>

    {#if adding}
      <Card>
        <Form resource={domains} bind:record={draft} onsubmit={addDomain}>
          <Input name="hostname" id="hostname" value={draft.hostname}
                 oninput={(e) => write('hostname', e.target.value)} />
          <Input name="redirectTo" id="redirectTo" label="Redirect to (optional)"
                 value={draft.redirectTo} oninput={(e) => write('redirectTo', e.target.value)} />
          <Button type="submit" tone="primary" disabled={busy === 'domain'}>Add hostname</Button>
        </Form>
      </Card>
    {/if}

    {#if !app.domains?.length}
      <EmptyState title="No hostnames">
        This app answers on no domain yet. The first one added becomes the primary.
      </EmptyState>
    {:else}
      <div class="stack" id="domain-list">
        {#each app.domains as d}
          <Card>
            <div class="section-header">
              <h3 class="h4"><code>{d.hostname}</code>
                <a href={`https://${d.hostname}`} target="_blank" rel="noopener"
                   aria-label={`Open ${d.hostname} in a new tab`}><NavIcon name="external" /></a></h3>
              <span class="cluster">
                {#if d.isPrimary}<Badge tone="success">primary</Badge>{/if}
                <Pill tone={CERT_TONE[d.cert_status] ?? 'muted'}>{d.cert_status ?? 'none'}</Pill>
              </span>
            </div>

            <dl class="facts">
              <dt>Port</dt><dd><code>{d.port}</code></dd>
              {#if d.redirectTo}
                <dt>Redirects to</dt><dd><code>{d.redirectTo}</code></dd>
              {/if}
              <dt>Certificate expires</dt>
              <dd>
                {at(d.certExpiresAt)}
                {#if d.cert_days_remaining !== null && d.cert_days_remaining !== undefined}
                  <span class="text-sm text-muted">({d.cert_days_remaining} days)</span>
                {/if}
              </dd>
            </dl>

            {#if certFor === d.id}
              <Card>
                <!-- Fixed ids, not per-domain ones: only one upload form is
                     open at a time (`certFor === d.id`), so they stay unique in
                     the document and a caller can address them by name. -->
                <Textarea id="certPem" name="certPem" label="Certificate (PEM)" rows="3"
                          value={certDraft.certPem} oninput={(e) => writeCert('certPem', e.target.value)} />
                <Textarea id="keyPem" name="keyPem" label="Private key (PEM)" rows="3"
                          value={certDraft.keyPem} oninput={(e) => writeCert('keyPem', e.target.value)} />
                <Input id="expiresAt" name="expiresAt" label="Expires at"
                       value={certDraft.expiresAt} oninput={(e) => writeCert('expiresAt', e.target.value)} />
                <div class="cluster">
                  <Button tone="primary" disabled={busy === d.id} onclick={() => uploadCert(d)}>Store certificate</Button>
                  <Button treatment="ghost" onclick={() => certFor = null}>Cancel</Button>
                </div>
              </Card>
            {:else}
              <div class="cluster">
                <Button treatment="outlined" onclick={() => certFor = d.id}>
                  {d.cert_status === 'none' ? 'Upload certificate' : 'Replace certificate'}
                </Button>
                {#if !d.isPrimary}
                  <Button treatment="ghost" disabled={busy === d.id} onclick={() => makePrimary(d)}>Make primary</Button>
                {/if}
                <Button treatment="ghost" disabled={busy === d.id}
                        aria-label={`Delete ${d.hostname}`}
                        data-confirm={`${d.hostname} stops routing to this app.`}
                        data-confirm-title="Delete this domain?" data-confirm-label="Delete"
                        onclick={() => removeDomain(d)}>Delete</Button>
              </div>
            {/if}
          </Card>
        {/each}
      </div>
    {/if}
  {/if}

  {#if tab === 'source'}
    {#if canPaste()}
      <Card>
        <div class="section-header">
          <h2 class="h4">Files</h2>
          <span class="cluster">
            {#if sourceDirty}<Badge tone="warning" id="app-source-dirty">unsaved</Badge>{/if}
            <Button treatment="ghost" onclick={() => addFile()} id="app-source-add">Add file</Button>
          </span>
        </div>
        <p class="text-sm text-muted">
          These files are the app. There is no build step — a page that loads its libraries from a
          CDN runs as it is written. <code>index.html</code> is what the address serves.
        </p>
        {#if overBuild}
          <article class="alert warning" id="app-source-over-build">
            <div class="alert-content">{overBuild}</div>
          </article>
        {/if}

        {#if !files.length}
          <!-- The action is a SNIPPET: a button written as a child lands in
               the text, not the actions row. -->
          <EmptyState title="Nothing pasted yet" id="app-source-empty">
            Start from a blank page, or add a file and paste into it.
            {#snippet action()}
              <Button onclick={() => addFile('index.html', STARTER)} id="app-source-starter">
                Start from a blank page
              </Button>
            {/snippet}
          </EmptyState>
        {/if}

        {#each files as f, i}
          <div class="stack" id={`app-source-file-${i}`}>
            <div class="cluster">
              <Input label="Path" value={f.path} id={`app-source-path-${i}`}
                     oninput={e => editFile(i, 'path', e.target.value)} />
              <Button treatment="ghost" tone="danger" onclick={() => dropFile(i)}
                      id={`app-source-drop-${i}`}>Remove</Button>
            </div>
            <Textarea label="Contents" rows={18} value={f.content} id={`app-source-body-${i}`}
                      oninput={e => editFile(i, 'content', e.target.value)} />
          </div>
        {/each}

        <div class="cluster">
          <Button onclick={() => saveSource({ deploy: true })} disabled={busy || !files.length}
                  id="app-source-deploy"
                  data-confirm={overBuild} data-confirm-title="Replace the live build?" data-confirm-label="Deploy">
            {busy === 'deploy' ? 'Deploying…' : 'Save and deploy'}
          </Button>
          <Button treatment="outlined" onclick={() => saveSource()} disabled={busy || !files.length}
                  id="app-source-save">
            {busy === 'save' ? 'Saving…' : 'Save'}
          </Button>
        </div>
      </Card>

      {#if !app.domains?.length}
        <!-- Where it answers before anybody has pointed a name at it. The exact
             address is written into the release's Activate step by the machine
             that served it, because this console cannot see how that box is
             reached from outside. -->
        <Callout tone="info" title="It answers on its own address">
          With no domain pointed at it, the machine serves this app under the label
          <code>{app.slug}</code>. The release page names the full address — it is what the
          machine reported when it went live.
        </Callout>
      {/if}
    {:else if app.type === 'container' || app.type === 'function'}
      <Card>
        <h2 class="h4">Image</h2>
        <p class="text-sm text-muted">
          The image the machine pulls and runs. Nothing builds one from a repository yet, so
          name one that exists — <code>nginx:alpine</code> is a working first try.
        </p>
        <Input label="Image" id="app-image" value={imageDraft || app.source?.image || ''}
               placeholder="nginx:alpine" oninput={e => imageDraft = e.target.value} />
        <div class="cluster">
          <Button onclick={() => saveImage({ ship: true })} id="app-image-deploy"
                  disabled={busy || !(imageDraft || app.source?.image)}>
            {busy === 'deploy' ? 'Deploying…' : 'Save and deploy'}
          </Button>
          <Button treatment="outlined" onclick={() => saveImage()} id="app-image-save"
                  disabled={busy || !imageDraft}>Save</Button>
        </div>
      </Card>
    {:else}
      <EmptyState title="This app is built, not pasted" id="app-source-not-inline">
        Its source is {app.source?.kind ?? 'a repository or an image'}, so what ships is decided by a build rather than by an editor. The Config tab shows what it was pointed at.
      </EmptyState>
    {/if}
  {/if}

  {#if tab === 'config'}
    <Card>
      <h2 class="h4">Source</h2>
      <p class="text-sm text-muted">What gets built and run. Written by whatever triggers the release.</p>
      <Json id="app-source" value={app.source} empty="No source recorded yet." copy />
    </Card>

    {#if app.source?.kind === 'git'}
      <Card id="app-push">
        <h2 class="h4">Deploy on push</h2>
        <p class="text-sm text-muted">
          A push to {app.source.branch ?? 'the default branch'} releases this app, as you. Add
          the address below to the repository's webhooks on your git host.
        </p>
        {#if pushKeys}
          <Callout tone="warning" id="app-push-keys">
            Copy these now. They are shown once, and enabling again replaces them.
          </Callout>
          <dl class="facts">
            <dt>Webhook URL</dt><dd><code id="app-push-url">{pushKeys.url}</code></dd>
            <dt>Secret</dt><dd><code id="app-push-secret">{pushKeys.secret}</code></dd>
            <dt>Or, for a sender that signs nothing</dt><dd><code id="app-push-token-url">{pushKeys.tokenUrl}</code></dd>
          </dl>
          <p class="text-sm text-muted">
            GitHub, Forgejo and Gitea: content type <code>application/json</code>, the secret above, the push event.
          </p>
        {/if}
        <div class="cluster">
          {#if app.deployOnPush}
            <Badge tone="success" id="app-push-on">on</Badge>
            <Button treatment="outlined" onclick={enablePush} disabled={busy} id="app-push-rotate">Rotate keys</Button>
            <Button treatment="outlined" tone="danger" onclick={disablePush} disabled={busy} id="app-push-off">Turn off</Button>
          {:else}
            <Button onclick={enablePush} disabled={busy} id="app-push-enable">Enable deploy on push</Button>
          {/if}
        </div>
      </Card>
    {/if}

    <Card>
      <h2 class="h4">Runtime</h2>
      <p class="text-sm text-muted">How the machine starts the container. A release keeps the settings it shipped with.
        {#if app.domains?.length}The port is the machine's pick; a hostname is the address.{:else}The port is picked when the app is placed, and with no hostname it is the address.{/if}</p>
      <dl class="facts" id="app-runtime">
        <dt>Port</dt><dd><code>{app.port ?? 'none published'}</code>{#if app.port && app.containerPort && app.containerPort !== app.port} → <code>{app.containerPort}</code> in the container{:else if app.port && !app.containerPort && app.source?.kind === 'git'} → the port the first build reads off the Dockerfile{/if}</dd>
        <dt>Volume</dt><dd><code>{app.volumePath ?? 'none — stateless'}</code></dd>
        <dt>Health check</dt><dd><code>{app.healthCheck ?? 'running is healthy'}</code></dd>
        <dt>CPU</dt><dd>{app.cpuLimit ?? 'no limit'}</dd>
        <dt>Memory</dt><dd>{app.memLimitMb != null ? `${app.memLimitMb} MiB` : 'no limit'}</dd>
      </dl>
      <Button treatment="outlined" onclick={() => editing = true}>Edit</Button>
    </Card>

    <Card>
      <h2 class="h4">Variables</h2>
      <p class="text-sm text-muted">
        This app's own. It also starts with <a href={`/environments/${app.environmentId}/`}>its environment's</a>,
        and one set here wins over the environment's of the same key.
      </p>
      <VariablesEditor appId={app.id} environmentId={app.environmentId} idPrefix="app-var" />
    </Card>
  {/if}

  {#if tab === 'releases'}
    {#if overBuild}
      <Callout tone="info">{overBuild}</Callout>
    {/if}
    <LaptopRelease app={app} />
    {#if !app.recent_deployments?.length}
      <EmptyState title="Never released">This app has no deployment history.</EmptyState>
    {:else}
      <Table id="app-releases" columns={APP_RELEASES_COLUMNS} rows={app.recent_deployments} striped>
        {#snippet row(d)}
          <tr>
            <td class="text-sm text-muted">{at(d.queuedAt)}</td>
            <td><a href={`/deployments/${d.id}/`}><Pill tone={DEPLOY_TONE[d.status] ?? 'info'}>{d.status}</Pill></a></td>
            <td><code>{shortSha(d.commitSha) ?? '—'}</code>
              {#if d.commitMessage}<span class="text-sm"> {d.commitMessage}</span>{/if}</td>
            <td class="text-sm text-muted">{d.branch ?? '—'}</td>
            <td class="text-sm text-muted">{d.trigger}{whoShipped(d)}</td>
            <td>
              {#if d === latest && rollbackIt}
                <Button treatment="ghost" tone="warning" disabled={!rollbackIt.allowed || busy === d.id}
                        data-confirm="A new release puts back the bytes and config this one replaced."
                        data-confirm-title="Roll back this release?" data-confirm-label="Roll back"
                        onclick={() => rollback(d)}>Roll back</Button>
              {:else if d === latest && canRetry}
                <Button treatment="ghost" disabled={!!busy} onclick={deploy}>Retry</Button>
              {/if}
            </td>
          </tr>
        {/snippet}
      </Table>
    {/if}
  {/if}

  {#if tab === 'logs'}
    <Card>
      <h2 class="h4">Container log</h2>
      <p class="text-sm text-muted">
        Read from the machine when you ask, through the same executor a release goes through.
        Nothing is stored here — this is the container's own log, bounded by the lines you ask for.
        Follow keeps the log open and adds lines as the container writes them, until you stop or leave this tab.
      </p>
      {#if followState === 'connecting' || followState === 'open'}
        <p class="text-sm" aria-live="polite" id="app-logs-following">
          <Pill tone={followState === 'open' ? 'success' : ''}>{followState === 'open' ? 'live' : 'connecting'}</Pill>
        </p>
      {/if}
      <div class="cluster" id="app-logs-controls">
        <Input type="number" label="Lines" bind:value={logsTail} id="app-logs-tail" />
        <Input label="Since" placeholder="10m, 1h, or a timestamp" bind:value={logsSince} id="app-logs-since" />
        <Button onclick={loadLogs} disabled={logsBusy || !!follow} id="app-logs-load">
          {logsBusy ? 'Reading…' : 'Read log'}
        </Button>
        <Button treatment="outlined" tone={follow ? 'danger' : ''} onclick={() => follow ? stopFollow() : startFollow()} id="app-logs-follow">
          {follow ? 'Stop following' : 'Follow'}
        </Button>
        <Button treatment="ghost" onclick={() => logsRaw = !logsRaw} id="app-logs-raw">
          {logsRaw ? 'Toned' : 'Raw'}
        </Button>
      </div>
    </Card>

    {#if logs && logs.reason}
      <!-- Placed nowhere, or the container is gone. Both are states an operator
           can act on, so they are said rather than rendered as an empty box. -->
      <EmptyState title="No log to read" id="app-logs-none">{logs.reason}</EmptyState>
    {/if}

    {#if logs && logs.stdout}
      <Card>
        <h3 class="h5">stdout</h3>
        <LogView text={logs.stdout} raw={logsRaw} follow={!!follow} id="app-logs-stdout" />
      </Card>
    {/if}

    {#if logs && logs.stderr}
      <!-- Kept apart from stdout, because that is how the container wrote them:
           joining them here would invent an interleaving that never happened. -->
      <Card>
        <h3 class="h5">stderr</h3>
        <LogView text={logs.stderr} raw={logsRaw} follow={!!follow} id="app-logs-stderr" />
      </Card>
    {/if}

    {#if logs && logs.running && !logs.stdout && !logs.stderr && !follow}
      <EmptyState title="Nothing in the window" id="app-logs-empty">
        The container is running and wrote nothing in the range you asked for.
      </EmptyState>
    {/if}
  {/if}
{:else}
  <NoRecord error={loadError} noun="App" onretry={load}
            backHref="/projects/" backLabel="Back to projects" />
{/if}

<!--
  The mock's other three tabs, and why they are not here:

    log-analysis — nothing STORES a log line, so there is nothing to analyze.
      The `logs` tab reads the container's own log on demand through the
      Outpost; retention, search across apps and anything resembling a query
      are an observability adapter (docs/SCREENS.md § D), not a screen.
    build — build output and history need a build record; `Deployment` carries
      `builtImage` and no log, so "Build history" would be the releases table
      under a second name.
    advanced — the health check is a column and on the Config tab; restart
      policy and the nginx template are not, and inventing them here would make
      this screen their only definition.
-->
