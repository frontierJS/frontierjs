---
title: Flags
---
<script>
  // The mock's WorkspaceFlagsView, over real environments.
  //
  // The mock's per-environment state was a map keyed by TIER NAME —
  // `production`, `staging`, `development`. That vocabulary already exists here
  // as `model Environment`, one row per environment per project, so the string
  // would have meant every project sharing one "production" belonging to none
  // of them. An override points at the real row, which is why the toggle is a
  // picker over this workspace's actual environments and not three fixed
  // columns.
  //
  // **The resolution rule is not in this file.** What a flag is set to in an
  // environment — the override if there is one, the flag's own default if not —
  // is `resolveIn()` in the service, and it reaches here already applied, with
  // `source` saying which it was. A screen that recomputed it would be a second
  // owner of the only thing the service is for.
  import { session } from '../../session.js'
  import { messageFor } from '../../errors.js'
  import { flags }   from '../../resources/FeatureFlag.mesa'
  import { environments } from '../../resources/Environment.mesa'
  import { projects }     from '../../resources/Project.mesa'
  import VariantsEditor   from '../../components/VariantsEditor.mesa'

  import Alert from '@frontierjs/ui/components/feedback/Alert.mesa'
  import Badge      from '@frontierjs/ui/components/display/Badge.mesa'
  import Button     from '@frontierjs/ui/components/forms/Button.mesa'
  import Callout    from '@frontierjs/ui/components/display/Callout.mesa'
  import Card       from '@frontierjs/ui/components/layout/Card.mesa'
  import Drawer     from '@frontierjs/ui/components/overlay/Drawer.mesa'
  import EmptyState from '@frontierjs/ui/components/display/EmptyState.mesa'
  import Form       from '@frontierjs/ui/components/forms/Form.mesa'
  import Input      from '@frontierjs/ui/components/forms/Input.mesa'
  import Pill       from '@frontierjs/ui/components/display/Pill.mesa'
  import Select     from '@frontierjs/ui/components/forms/Select.mesa'
  import Textarea   from '@frontierjs/ui/components/forms/Textarea.mesa'
  import { toasts } from '@frontierjs/ui/stores/toastStore.js'
  import Table from '@frontierjs/ui/components/display/Table.mesa'
  import { page } from '@frontierjs/sierra/router'
  import { offerUndo } from '../../resources/Trash.mesa'

  $: session.workspaceId

  let rows     = []
  let envs     = []
  let projectNames = {}  // projectId → name, so an environment says whose it is
  let detail   = {}      // flagId → the flag with its resolved overrides
  // One record view per expanded flag. Several can be open at once and none of
  // them closes, so this is a map rather than a single view; every one of them
  // is released when the screen goes.
  const views  = new Map()
  let picked   = {}      // flagId → the environment id the picker is showing
  let error    = null
  let loading  = true
  let busy     = null
  let creating = page.query?.new !== undefined
  // ⌘K's New … entries land here with ?new, on this route or from another.
  $: page.query, () => { if (page.query?.new !== undefined) creating = true }
  let draft    = flags.make()

  // The kit's controls take a value and hand back an event; they are NOT bound
  // to `draft[name]`, because `bind:` on a COMPONENT needs a writable top-level
  // let and a member expression is not one. Replacing the object rather than
  // mutating it is what makes the change reactive.
  function write(name, value) {
    draft = { ...draft, [name]: value }
  }

  async function load() {
    error = null; loading = true
    try {
      rows = (await flags.service.find({}, { limit: 200 })).data
      // Every environment in the workspace, for the override picker. The
      // service scopes an override to the workspace regardless — this is the
      // affordance, not the boundary.
      envs = (await environments.service.find({}, { limit: 200 })).data
      projectNames = Object.fromEntries(
        (await projects.service.find({}, { limit: 200 })).data.map(p => [p.id, p.name]))
    } catch (e) {
      error = e.message
    } finally {
      loading = false
    }
  }

  load()
  $: session.workspaceId, () => load()

  const READS = new Set(['get', 'find', 'resolve'])
  const off = flags.service.on('*', (method, row) => {
    if (READS.has(method) || !row?.id) return
    load()
  })

  /** One expanded flag, watched rather than read (`FJS-518`).
   *
   *  `flags.get()` is `flagWithOverrides(...)` — the row plus every override
   *  resolved against it — so this is a COMPOSED view: a push carries the row
   *  alone and watching the node itself would empty the override table at the
   *  first announcement (`FJS-533`).
   */
  function watchFlag(id) {
    const held = views.get(id)
    if (held) return held.view.refresh()
    const view = flags.record(id, { composed: true })
    const stop = view.subscribe(v => { detail = { ...detail, [id]: v } })
    views.set(id, { view, stop })
    return view.ready
  }

  $.onDestroy(() => {
    off()
    for (const { view, stop } of views.values()) { stop(); view.release() }
    views.clear()
  })

  // Loaded on demand: a flag overridden nowhere is the common case, and the
  // list already carries the count that says so.
  async function open(flag) {
    busy = flag.id
    try {
      await watchFlag(flag.id)
    } catch (e) {
      error = e.message
    } finally {
      busy = null
    }
  }

  async function create(data) {
    error = null
    try {
      const created = await flags.service.create(data)
      toasts.success(`${created.key} created`)
      creating = false
      draft = flags.make()
      await load()
    } catch (e) {
      error = e.message
      throw e
    }
  }

  async function toggleDefault(flag) {
    error = null; busy = flag.id
    try {
      const updated = await flags.service.patch(flag.id, { isEnabled: !flag.isEnabled })
      const i = rows.findIndex(r => r.id === flag.id)
      if (i >= 0) rows = [...rows.slice(0, i), { ...rows[i], ...updated }, ...rows.slice(i + 1)]
      if (views.has(flag.id)) await watchFlag(flag.id)
    } catch (e) {
      error = messageFor(flags, e)
    } finally {
      busy = null
    }
  }

  // `setOverride` writes the whole override, so a change to one of its three
  // values carries the other two as they stand — otherwise a rollout edit would
  // reset the variant it pinned.
  async function override(flag, environmentId, isEnabled, rest = {}) {
    error = null; busy = flag.id
    try {
      await flags.service.invoke('setOverride', flag.id, { environmentId, isEnabled, ...rest })
      await watchFlag(flag.id)
      picked = { ...picked, [flag.id]: '' }
      await load()
    } catch (e) {
      error = e.message
    } finally {
      busy = null
    }
  }

  async function clear(flag, environmentId) {
    error = null; busy = flag.id
    try {
      await flags.service.invoke('clearOverride', flag.id, { environmentId })
      await watchFlag(flag.id)
      await load()
    } catch (e) {
      error = e.message
    } finally {
      busy = null
    }
  }

  async function remove(flag) {
    error = null; busy = flag.id
    try {
      await flags.service.remove(flag.id)
      offerUndo(flag.key, flags, flag.id, load)
      await load()
    } catch (e) {
      error = e.message
    } finally {
      busy = null
    }
  }

  const change = (flag, o, patch) => override(flag, o.environmentId, o.isEnabled,
    { rollout: o.rollout, variantKey: o.variantKey ?? null, ...patch })

  // ─── Editing a flag ──────────────────────────────────────────────────
  // A hand-written drawer rather than the default form: `variants` is a Json
  // column the default form would offer as a JSON textarea, and `key` is
  // refused on a patch because it is the name in somebody's source code.
  // The draft carries the version it was read at (`@version`), so a save
  // over somebody else's edit is refused rather than erasing it.
  let editing   = null   // the draft
  let editError = null
  let saving    = false

  function startEdit(flag) {
    editError = null
    const { id, key, type, description, rollout, variants, version } = flag
    editing = { id, key, type, description: description ?? '', rollout, variants: variants ?? [], version }
  }

  async function saveEdit() {
    editError = null; saving = true
    try {
      const { id, key, type, description, rollout, variants, version } = editing
      await flags.service.patch(id, {
        description: description || null,
        rollout:     Number(rollout),
        ...(type === 'variant' ? { variants } : {}),
        version,
      })
      toasts.success(`${key} saved`)
      editing = null
      await load()
      if (views.has(id)) await watchFlag(id)
    } catch (e) {
      editError = messageFor(flags, e)
    } finally {
      saving = false
    }
  }

  // Options come from the schema's own enum, through the JSON Schema the build
  // emits — never a list retyped here.
  $: types = flags.fields?.type?.enum ?? ['boolean', 'variant']
  // An environment's name alone is ambiguous: every project has a production.
  const named    = (projectId, name) => projectNames[projectId] ? `${projectNames[projectId]} / ${name}` : name
  const envLabel = (o) => o.environment ? named(o.environment.projectId, o.environment.name) : o.environmentId
  const ROW_COLUMNS = [
    { name: 'environment', label: 'Environment' },
    { name: 'state',       label: 'State' },
    { name: 'rollout',     label: 'Rollout' },
    { name: 'variant',     label: 'Variant' },
    { name: 'actions',     label: 'Actions', hideLabel: true },
  ]
</script>

<div class="section-header">
  <h1>Feature flags</h1>
  <Button variant="primary" id="new-flag" onclick={() => creating = !creating}>
    {creating ? 'Cancel' : 'New flag'}
  </Button>
</div>

<Callout tone="info" title="Overrides point at real environments">
  A flag carries a default for the whole workspace. An override is per environment —
  this project's staging, not a tier called “staging” shared by every project.
  Clearing an override is not the same as turning it off: it means follow the flag.
</Callout>

{#if error}
  <!-- id'd because the shell's notice bar is also `.alert.danger`: a check
       looking for "the screen reported a refusal" would otherwise match a
       fleet notice and pass, or fail, for reasons this screen never caused. -->
  <Alert tone="danger" id="screen-error">{error}</Alert>
{/if}

{#if creating}
  <Card>
    <Form resource={flags} bind:record={draft} onsubmit={create}>
      <Input name="key" id="key" hint="The name your code asks for — new-checkout-flow"
             value={draft.key} oninput={(e) => write('key', e.target.value)} />
      <Textarea name="description" id="description" rows="2" value={draft.description}
                oninput={(e) => write('description', e.target.value)} />
      <Select name="type" id="type" options={types}
              value={draft.type} oninput={(e) => write('type', e.target.value)} />
      <Input name="rollout" id="rollout" type="number" min="0" max="100"
             hint="The share of users it is on for, where it is on"
             value={draft.rollout} oninput={(e) => write('rollout', Number(e.target.value))} />
      {#if draft.type === 'variant'}
        <VariantsEditor idPrefix="new-variant" value={draft.variants} onchange={(next) => write('variants', next)} />
      {/if}
      <Button type="submit" variant="primary">Create flag</Button>
    </Form>
  </Card>
{/if}

{#if loading}
  <p class="text-sm text-muted">Loading…</p>
{:else if !rows.length}
  <EmptyState title="No flags">
    Nothing in this workspace is behind a flag yet.
  </EmptyState>
{:else}
  <div class="stack" id="flag-list">
    {#each rows as flag}
      <Card>
        <div class="section-header">
          <h2 class="h4"><code>{flag.key}</code></h2>
          <span class="cluster">
            <Pill>{flag.type}</Pill>
            {#if flag.isEnabled}
              <Badge tone="success">on by default</Badge>
            {:else}
              <Badge tone="muted">off by default</Badge>
            {/if}
            {#if flag.rollout < 100}
              <Badge tone="info">{flag.rollout}% rollout</Badge>
            {/if}
            {#if flag.override_count}
              <Badge tone="warning">{flag.override_count} override(s)</Badge>
            {/if}
          </span>
        </div>

        {#if flag.description}
          <p class="text-sm text-muted">{flag.description}</p>
        {/if}

        {#if detail[flag.id]}
          {#if detail[flag.id].overrides?.length}
            <Table columns={ROW_COLUMNS} rows={detail[flag.id].overrides} striped hover={false}>
              {#snippet row(o)}
                <tr>
                  <td>{envLabel(o)}</td>
                  <td>
                    {#if o.isEnabled}
                      <Badge tone="success">on</Badge>
                    {:else}
                      <Badge tone="muted">off</Badge>
                    {/if}
                  </td>
                  <td>
                    <Input id={`rollout-${flag.id}-${o.environmentId}`} label="" type="number" min="0" max="100"
                           aria-label={`Rollout in ${envLabel(o)}`} style="--field-inline-size: 5rem"
                           value={o.rollout} disabled={busy === flag.id}
                           onchange={(e) => change(flag, o, { rollout: Number(e.target.value) })} />
                  </td>
                  <td>
                    {#if flag.type === 'variant'}
                      <Select id={`pin-${flag.id}-${o.environmentId}`} label="" aria-label={`Variant in ${envLabel(o)}`}
                              placeholder="By weight" value={o.variantKey ?? ''}
                              options={(detail[flag.id].variants ?? []).map(v => v.key)}
                              onchange={(e) => change(flag, o, { variantKey: e.target.value || null })} />
                    {:else}
                      <span class="text-sm text-muted">—</span>
                    {/if}
                  </td>
                  <td>
                    <Button variant="ghost" disabled={busy === flag.id}
                            onclick={() => change(flag, o, { isEnabled: !o.isEnabled })}>
                      {o.isEnabled ? 'Force off' : 'Turn on'}
                    </Button>
                    <Button variant="ghost" disabled={busy === flag.id}
                            aria-label={`Clear the ${envLabel(o)} override on ${flag.key}`}
                            data-confirm={`${envLabel(o)} falls back to the flag's default.`}
                            data-confirm-title="Clear this override?" data-confirm-label="Clear" data-confirm-tone="warning"
                            onclick={() => clear(flag, o.environmentId)}>Clear</Button>
                  </td>
                </tr>
              {/snippet}
            </Table>
          {:else}
            <p class="text-sm text-muted">Every environment follows the default.</p>
          {/if}

          {#if envs.length}
            <div class="cluster">
              <label class="visually-hidden" for={`env-${flag.id}`}>Override in an environment</label>
              <Select id={`env-${flag.id}`} placeholder="Override in…"
                      value={picked[flag.id] ?? ''}
                      options={envs
                        .filter(e => !(detail[flag.id].overrides ?? []).some(o => o.environmentId === e.id))
                        .map(e => ({ value: e.id, label: named(e.projectId, e.name) }))}
                      onchange={(e) => picked = { ...picked, [flag.id]: e.target.value }} />
              <Button variant="outlined" disabled={busy === flag.id || !picked[flag.id]}
                      onclick={() => override(flag, picked[flag.id], true)}>Turn on here</Button>
              <Button variant="ghost" disabled={busy === flag.id || !picked[flag.id]}
                      onclick={() => override(flag, picked[flag.id], false)}>Force off here</Button>
            </div>
          {/if}
        {/if}

        <div class="cluster">
          <Button variant="outlined" disabled={busy === flag.id}
                  onclick={() => open(flag)}>Environments</Button>
          <Button variant="ghost" disabled={busy === flag.id}
                  aria-label={`Edit ${flag.key}`} onclick={() => startEdit(flag)}>Edit</Button>
          <Button variant="ghost" disabled={busy === flag.id} onclick={() => toggleDefault(flag)}>
            {flag.isEnabled ? 'Turn off by default' : 'Turn on by default'}
          </Button>
          <Button variant="ghost" disabled={busy === flag.id}
                  aria-label={`Delete ${flag.key}`}
                  data-confirm={`${flag.key} is deleted, with its overrides in every environment.`}
                  data-confirm-title="Delete this flag?" data-confirm-label="Delete"
                  onclick={() => remove(flag)}>Delete</Button>
        </div>
      </Card>
    {/each}
  </div>
{/if}

<Drawer open={!!editing} title={editing ? `Edit ${editing.key}` : ''} onclose={() => editing = null}>
  {#if editing}
    <form class="stack" id="flag-edit" novalidate onsubmit={e => { e.preventDefault(); saveEdit() }}>
      {#if editError}
        <Alert tone="danger" id="flag-edit-error">{editError}</Alert>
      {/if}
      <p class="text-sm text-muted">The key is what code asks for, so it cannot change. Delete the flag and make another to rename it.</p>
      <Textarea id="edit-description" name="description" label="Description" rows="2" value={editing.description}
                oninput={(e) => editing = { ...editing, description: e.target.value }} />
      <Input id="edit-rollout" name="rollout" label="Rollout" type="number" min="0" max="100"
             hint="The share of users it is on for, where it is on"
             value={editing.rollout} oninput={(e) => editing = { ...editing, rollout: e.target.value }} />
      {#if editing.type === 'variant'}
        <VariantsEditor idPrefix="edit-variant" value={editing.variants}
                        onchange={(next) => editing = { ...editing, variants: next }} />
      {/if}
      <div class="cluster">
        <Button type="submit" variant="primary" id="flag-edit-save" disabled={saving}>{saving ? 'Saving…' : 'Save'}</Button>
        <Button variant="ghost" onclick={() => editing = null}>Cancel</Button>
      </div>
    </form>
  {/if}
</Drawer>
