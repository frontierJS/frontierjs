---
title: Infrastructure graph
---
<script>
  // The mock's InfraGraphView — the fleet drawn from rows rather than from a
  // constant.
  //
  // The mock had a hand-written GRAPH_NODES/GRAPH_EDGES pair with an internet
  // node, a CDN and app-to-app dependency arrows. Three of those are not rows
  // in db/schema.lite and are therefore not drawn here: nothing records which
  // app talks to which, nothing records what sits in front of the fleet, and
  // nothing samples traffic. What IS drawn is four kinds of node and four
  // kinds of edge, each one a row somebody made — the service assembles them
  // (api/src/services/infra/infra.service.ts) and the layout happens here.
  //
  // ── Why the layout is in the browser ─────────────────────────────────────
  // A position is not a fact about the fleet. Storing one means a column that
  // is wrong the moment a server is added, and the mock's own answer — drag a
  // node, keep the coordinates — is a preference with nowhere to live. So the
  // lanes are derived from the node kinds every render, and the only state
  // this screen keeps is which kinds are shown and how far it is zoomed.
  //
  // ── What this screen deliberately does not have ──────────────────────────
  // Drag-to-move and drag-to-pan. The graph scrolls inside its own box, which
  // is a scroll a keyboard and a trackpad both already know how to do; a drag
  // handler that has to be discovered is not an improvement on that.
  import { session } from '../../session.js'
  import { infra } from '../../resources/Infra.mesa'

  import Badge      from '@frontierjs/ui/components/display/Badge.mesa'
  import Button     from '@frontierjs/ui/components/forms/Button.mesa'
  import Callout    from '@frontierjs/ui/components/display/Callout.mesa'
  import Card       from '@frontierjs/ui/components/layout/Card.mesa'
  import EmptyState from '@frontierjs/ui/components/display/EmptyState.mesa'
  import Pill       from '@frontierjs/ui/components/display/Pill.mesa'
  import Skeleton   from '@frontierjs/ui/components/feedback/Skeleton.mesa'

  $: session.workspaceId

  let graph    = null
  let error    = null
  let loading  = true
  let selected = null
  let zoom     = 1
  let show     = { domain: true, app: true, server: true, network: true }

  async function load() {
    error = null; loading = true
    try {
      // An action, not `find`. The browser client turns anything that is not a
      // list into an EMPTY list with a 200 (`FJS-144`), so a graph asked for
      // as `find` renders as a workspace with nothing in it.
      graph = await infra.service.invoke('graph', null)
    } catch (e) {
      error = e.message
    } finally {
      loading = false
    }
  }

  load()
  $: session.workspaceId, () => load()

  // ── Layout ───────────────────────────────────────────────────────────────
  // Lanes top to bottom, in the order traffic actually travels: a hostname
  // resolves to an app, an app runs on a server, and a network is what the
  // machines and the containers are joined to underneath. Apps sit in the
  // middle because they are the only kind every other kind has an edge to.
  const LANES  = ['domain', 'app', 'server', 'network']
  const LABELS = { domain: 'Domains', app: 'Apps', server: 'Servers', network: 'Networks' }
  const BOX    = { w: 168, h: 52 }
  const GAP_X  = 24
  const GAP_Y  = 96
  const PAD    = 28

  function laneOf(kind) { return LANES.indexOf(kind) }

  // Positions, edge endpoints and the canvas size, in one pass. It runs on
  // every filter change, which is cheap: MAX_NODES is 300 in the service and a
  // fleet at that size is already past what anybody reads off a picture.
  function project(g, visible) {
    if (!g) return null
    const nodes = g.nodes.filter(n => visible[n.kind])
    const lanes = LANES.filter(k => nodes.some(n => n.kind === k))

    const widest = Math.max(1, ...lanes.map(k => nodes.filter(n => n.kind === k).length))
    const width  = PAD * 2 + widest * BOX.w + (widest - 1) * GAP_X
    const height = PAD * 2 + lanes.length * BOX.h + Math.max(0, lanes.length - 1) * GAP_Y

    const placed = new Map()
    for (const [row, kind] of lanes.entries()) {
      const inLane = nodes.filter(n => n.kind === kind)
      const laneW  = inLane.length * BOX.w + (inLane.length - 1) * GAP_X
      const startX = (width - laneW) / 2
      for (const [i, n] of inLane.entries()) {
        placed.set(n.id, {
          ...n,
          x: startX + i * (BOX.w + GAP_X),
          y: PAD + row * (BOX.h + GAP_Y),
        })
      }
    }

    const edges = g.edges
      .filter(e => placed.has(e.src) && placed.has(e.tgt))
      .map(e => {
        const s = placed.get(e.src)
        const t = placed.get(e.tgt)
        return {
          ...e,
          x1: s.x + BOX.w / 2, y1: s.y + BOX.h / 2,
          x2: t.x + BOX.w / 2, y2: t.y + BOX.h / 2,
        }
      })

    return { nodes: [...placed.values()], edges, lanes, width, height }
  }

  $: view = project(graph, show)

  // A dashed edge is a membership and a solid one is traffic or placement —
  // the only two things a line here can mean. No color: the design system
  // decides tone, and an SVG stroke is not one of the places it has a word
  // for (repo invariant 13).
  const DASH = { traffic: null, host: null, peer: '5 4', attach: '2 4' }

  const HREF = {
    server:  n => `/servers/${n.ref}/`,
    app:     n => `/apps/${n.ref}/`,
    network: () => '/networks/',
    domain:  () => '/dns/',
  }

  function pick(node) { selected = selected?.id === node.id ? null : node }
  function toggle(kind) { show = { ...show, [kind]: !show[kind] } }

  const STATUS_TONE = {
    online: 'success', ready: 'success', running: 'success', primary: 'success',
    draining: 'warning', starting: 'warning', deploying: 'warning', stopping: 'warning',
    unreachable: 'danger', error: 'danger', destroyed: 'danger',
  }

  $: edgeCount = view?.edges.length ?? 0
  $: nodeCount = view?.nodes.length ?? 0
</script>

{#if error}
  <article class="alert danger" id="screen-error">
    <div class="alert-content">{error}</div>
  </article>
{/if}

{#if loading}
  <div aria-busy="true" class="stack">
    <Skeleton variant="text" width="14rem" />
    <Skeleton height="26rem" />
  </div>
{:else if view && graph.nodes.length === 0}
  <EmptyState
    title="Nothing to draw yet"
    description="The graph is made of servers, apps, networks and domains. Add one and it appears here."
  >
    {#snippet action()}
      <Button variant="primary" href="/servers/create/">Add a server</Button>
    {/snippet}
  </EmptyState>
{:else if view}
  <div class="cluster" id="graph-filters">
    {#each LANES as kind}
      <Button
        variant={show[kind] ? 'outlined' : 'ghost'}
        aria-pressed={show[kind] ? 'true' : 'false'}
        onclick={() => toggle(kind)}
      >{LABELS[kind]} {graph.counts[`${kind}s`]}</Button>
    {/each}

    <span class="divider" aria-hidden="true"></span>

    <Button variant="ghost" onclick={() => (zoom = Math.max(0.5, +(zoom - 0.25).toFixed(2)))}>&minus;</Button>
    <span class="text-sm text-muted">{Math.round(zoom * 100)}%</span>
    <Button variant="ghost" onclick={() => (zoom = Math.min(2, +(zoom + 0.25).toFixed(2)))}>+</Button>
    <Button variant="ghost" onclick={() => (zoom = 1)}>Reset</Button>
  </div>

  <p class="text-sm text-muted" id="graph-summary">
    {nodeCount} nodes · {edgeCount} edges
    {#if graph.truncated.length}
      · <strong>cut at {graph.limit}</strong>: {graph.truncated.join(', ')}
    {/if}
  </p>

  <div class="split" style:align-items="start" style:gap="1rem">
    <Card>
      <!-- The canvas scrolls inside its own box rather than the page: a wide
           fleet must not make the whole screen scroll sideways. -->
      <div style:overflow="auto" style:max-block-size="34rem">
        <svg
          id="infra-graph"
          role="img"
          aria-label="Infrastructure graph"
          viewBox={`0 0 ${view.width} ${view.height}`}
          width={view.width * zoom}
          height={view.height * zoom}
        >
          <!-- Edges first so a node box sits on top of every line it ends. -->
          {#each view.edges as e (e.id)}
            <line
              x1={e.x1} y1={e.y1} x2={e.x2} y2={e.y2}
              stroke="currentColor"
              stroke-opacity={selected && e.src !== selected.id && e.tgt !== selected.id ? 0.12 : 0.4}
              stroke-width="1"
              stroke-dasharray={DASH[e.kind]}
            />
          {/each}

          {#each view.nodes as n (n.id)}
            <g
              transform={`translate(${n.x}, ${n.y})`}
              style:cursor="pointer"
              onclick={() => pick(n)}
            >
              <rect
                width={BOX.w} height={BOX.h} rx="8"
                fill="none"
                stroke="currentColor"
                stroke-opacity={selected?.id === n.id ? 0.9 : 0.35}
                stroke-width={selected?.id === n.id ? 2 : 1}
              />
              <text x="12" y="22" font-size="12" fill="currentColor">
                {n.label.length > 20 ? n.label.slice(0, 19) + '…' : n.label}
              </text>
              <text x="12" y="38" font-size="10" fill="currentColor" fill-opacity="0.6">
                {[n.sub, n.status].filter(Boolean).join(' · ')}
              </text>
            </g>
          {/each}
        </svg>
      </div>
    </Card>

    <Card>
      {#if selected}
        <div class="section-header">
          <h2 class="h4">{selected.label}</h2>
          <Pill tone={STATUS_TONE[selected.status] ?? 'muted'}>{selected.kind}</Pill>
        </div>
        <dl class="facts">
          <dt>Kind</dt><dd>{selected.kind}</dd>
          {#if selected.sub}<dt>Detail</dt><dd>{selected.sub}</dd>{/if}
          {#if selected.status}<dt>Status</dt><dd>{selected.status}</dd>{/if}
        </dl>
        <div class="cluster">
          <Button variant="outlined" href={HREF[selected.kind](selected)}>Open</Button>
          <Button variant="ghost" onclick={() => (selected = null)}>Clear</Button>
        </div>
      {:else}
        <h2 class="h4">Legend</h2>
        <dl class="facts">
          <dt>Solid line</dt><dd>A hostname pointing at an app, or an app placed on a server</dd>
          <dt>Dashed line</dt><dd>A network membership — a server peered, an app attached</dd>
        </dl>
        <p class="text-sm text-muted">Select a node to see what it is and open its screen.</p>
      {/if}
    </Card>
  </div>

  <Callout title="Not drawn here">
    <p class="text-body">
      <strong>App-to-app dependency.</strong> Nothing records which app calls which, so an
      arrow between two of them would be drawn from a guess.
    </p>
    <p class="text-body">
      <strong>What sits in front of the fleet.</strong> The internet, a CDN and a load balancer
      are not rows in this database. A <a href="/dns/">hostname</a> is, and that is the edge
      this graph can honestly draw.
    </p>
    <p class="text-body">
      <strong>Live traffic.</strong> Nothing here samples a request rate, so no line is
      thicker than another.
    </p>
  </Callout>
{/if}
