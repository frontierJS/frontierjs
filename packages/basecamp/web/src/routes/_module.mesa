---
siteName: Basecamp
---
<script>
  import { page, goto, isActive } from '@frontierjs/sierra/router'
  import { status } from '@frontierjs/sierra/resource'
  import { session, signOut, switchWorkspace } from '../lib/session.js'

  import Badge          from '@frontierjs/ui/components/display/Badge.mesa'
  import Dot            from '@frontierjs/ui/components/display/Dot.mesa'
  import Button         from '@frontierjs/ui/components/forms/Button.mesa'
  import Select         from '@frontierjs/ui/components/forms/Select.mesa'
  import CommandPalette from '@frontierjs/ui/components/overlay/CommandPalette.mesa'
  import Drawer         from '@frontierjs/ui/components/overlay/Drawer.mesa'
  import DropdownMenu      from '@frontierjs/ui/components/overlay/DropdownMenu.mesa'
  import DropdownItem      from '@frontierjs/ui/components/overlay/DropdownItem.mesa'
  import DropdownGroup     from '@frontierjs/ui/components/overlay/DropdownGroup.mesa'
  import DropdownSeparator from '@frontierjs/ui/components/overlay/DropdownSeparator.mesa'
  import Toaster        from '@frontierjs/ui/components/feedback/Toaster.mesa'
  import ConfirmProvider from '@frontierjs/ui/components/overlay/ConfirmProvider.mesa'
  import { commandPalette } from '@frontierjs/ui/stores/commandPaletteStore'

  import NoticeBar from '../components/NoticeBar.mesa'
  import NavIcon   from '../components/NavIcon.mesa'
  import { servers }     from '../resources/Server.mesa'
  import { deployments } from '../resources/Deployment.mesa'
  import { jobs }        from '../resources/Job.mesa'
  import { notifications, INBOX, isUnread, titleOf, bodyOf, actionOf, markRead, markAllRead }
    from '../resources/Notification.mesa'
  import { computeNotices } from '../lib/notices.js'
  import { primary, groups, elsewhere } from '../lib/nav.js'
  import { paletteItems, visible } from '@frontierjs/ui/nav'

  var TOPBAR = primary.entries

  $: (page.siteName, page.route, page.pathname, page.title)
  $: (status.connected, session.user, session.level, session.workspaceId, session.workspaces)
  $: commandPalette.open

  // ── The attention system's data ──────────────────────────────────────────
  // The shell holds three tethers rather than polling: each is the resource's
  // own, fed by the same WebSocket events the screens use, so a server going
  // unreachable reaches the notice bar without this file asking again. They
  // re-read once per workspace, not once per navigation.
  const srvList = servers.tethered({ state: 'local' })
  // Composed: a deployment row arrives with its app and environment included.
  const depList = deployments.tethered({ state: 'local', composed: true })
  const jbsList = jobs.tethered({ state: 'local' })
  const srv = () => srvList.rows
  const dep = () => depList.rows
  const jbs = () => jbsList.rows

  // Failures stay on each list and are not drawn: the shell is not the screen
  // that owns any of these lists, and a workspace the caller cannot read is
  // the guard's problem, not a banner on every page.
  function loadAttention() {
    if (!session.user || !session.workspaceId) return
    srvList.reload()
    depList.reload()
    jbsList.reload()
  }

  // Explicit-dependency effect (Mesa §4.2) — the handler runs untracked, so the
  // reads inside loadAttention() add no subscriptions of their own.
  $: session.workspaceId, () => loadAttention()

  // Derived here, not in the template: one definition of "needs attention",
  // shared with the home screen's queue (src/notices.js).
  $: notices = computeNotices({ servers: srv(), deployments: dep(), jobs: jbs() })

  // ── The bell ─────────────────────────────────────────────────────────────
  // Per PERSON, not per workspace: the rows are scoped by their recipient, so
  // this reloads on sign-in and never on a workspace switch. New rows arrive as
  // pushed frames on the person's own channel; nothing here polls.
  const bell  = notifications.tethered({ state: 'local', directives: INBOX })
  const inbox = () => bell.rows

  $: session.user, () => { if (session.user && !session.user.enrollmentOnly) bell.reload() }

  // The menu shows the newest few unread; /notifications/ is the whole list.
  const BELL_MAX = 6
  $: unread = inbox().filter(isUnread)

  async function openNote(n) {
    await markRead(n).catch(() => {})
    const url = actionOf(n)?.url
    goto(url || '/notifications/')
  }

  // ── Recent ───────────────────────────────────────────────────────────────
  // The screens this browser visited, newest first, so ⌘K then Enter is
  // "back to where I was" — across a reload, which the Back button is not.
  // Keyed on the pathname alone: a `?new=1` is an open dialog, not a place.
  // An id in a path belongs to one workspace, so each entry carries the one
  // it was visited in and the palette offers only the current workspace's.
  // Above ⌘K, whose `$:` list reads it while the component is being built.
  const RECENT_KEY = 'basecamp.recent'
  const RECENT_MAX = 8
  let recent = []
  try { recent = JSON.parse(localStorage.getItem(RECENT_KEY) || '[]') } catch {}
  if (!Array.isArray(recent)) recent = []

  // `page.meta` is committed before `page.pathname`, so the title read here
  // is the new screen's.
  function remember() {
    const path = page.pathname
    if (!session.user || !session.workspaceId || path === '/login/') return
    const entry = { path, label: page.title ?? path, ws: session.workspaceId }
    recent = [entry, ...recent.filter(r => !(r.path === path && r.ws === entry.ws))].slice(0, RECENT_MAX * 2)
    try { localStorage.setItem(RECENT_KEY, JSON.stringify(recent)) } catch {}
  }
  // The workspace too: a reload restores the session after the first screen
  // has already mounted, and that screen is the one to come back to.
  remember()
  $: page.pathname, session.workspaceId, () => remember()

  // The screen on show is not somewhere to go back to.
  function recentHere() {
    return recent
      .filter(r => r.ws === session.workspaceId && r.path !== page.pathname)
      .slice(0, RECENT_MAX)
  }

  // ── ⌘K ───────────────────────────────────────────────────────────────────
  // The commands are the nav and the header's own behaviors, reached a second
  // way — never a second set of actions. `$:` and not a plain const because
  // the Servers and Workspace groups are built from live rows.
  $: COMMANDS = [
    // Navigate is derived from src/lib/nav.js through the same `show`, so it
    // cannot offer a screen the nav hides or miss one the nav lists.
    ...paletteItems([primary, ...groups, ...elsewhere], navSession(), goto),

    // Spread, not a conditional entry: a falsy item in the list renders as a
    // blank row in the palette rather than as nothing.
    ...(session.user?.isSystemAdmin ? [
      { id: 'new-bot',       group: 'Create',   label: 'New bot account', action: () => goto('/hub/users/') },
    ] : []),

    { id: 'new-project', group: 'Create', label: 'New project',    action: () => goto('/projects/create/') },
    { id: 'new-dashboard', group: 'Create', label: 'New dashboard', action: () => goto('/dashboards/?new=1') },
    { id: 'new-server',    group: 'Create', label: 'Provision a machine', action: () => goto('/servers/provision/') },
    { id: 'import-server', group: 'Create', label: 'Import a machine',    action: () => goto('/servers/import/') },
    { id: 'new-network', group: 'Create', label: 'New network',       action: () => goto('/networks/?new=1') },
    { id: 'new-alert',   group: 'Create', label: 'New alert rule',    action: () => goto('/alerts/?new=1') },
    { id: 'new-channel', group: 'Create', label: 'New channel',       action: () => goto('/channels/?new=1') },
    { id: 'new-flag',    group: 'Create', label: 'New feature flag',  action: () => goto('/flags/?new=1') },
    { id: 'new-api-key', group: 'Create', label: 'New API key',       action: () => goto('/api-keys/?new=1') },
    { id: 'new-recipe',  group: 'Create', label: 'New recipe',        action: () => goto('/recipes/?new=1') },
    { id: 'new-job',     group: 'Create', label: 'New job',           action: () => goto('/jobs/?new=1') },
    { id: 'new-secret',  group: 'Create', label: 'New secret',        action: () => goto('/secrets/?new=1') },

    // A server the palette can reach is a server the fleet actually has —
    // the rows are the ones already loaded for the notice rules, so this
    // group costs no extra request.
    ...srv().map(s => ({
      id: `srv-${s.id}`, group: 'Servers', label: s.name, sub: s.status,
      action: () => goto(`/servers/${s.id}/`),
    })),

    ...session.workspaces
      .filter(w => w.id !== session.workspaceId)
      .map(w => ({
        id: `ws-${w.id}`, group: 'Workspace', label: `Switch to ${w.name}`,
        action: () => switchWorkspace(w.id),
      })),

    ...recentHere().map((r, i) => ({
      id: `recent-${r.path}`, group: 'Recent',
      label: i === 0 ? `Go back to ${r.label}` : r.label, sub: r.path,
      action: () => goto(r.path),
    })),

    { id: 'focus',    group: 'Session', label: focus ? 'Leave focus mode' : 'Focus mode', sub: 'Ctrl+.', action: toggleFocus },
    { id: 'rail',     group: 'Session', label: rail ? 'Expand the sidebar' : 'Collapse the sidebar', action: toggleRail },
    { id: 'sign-out', group: 'Session', label: 'Sign out', action: out },
  ]

  // Awaited: signOut ends the session at the server first, and navigating
  // before it returns would put the guard in front of a session that is still
  // there — which sends /login/ straight back to /.
  async function out() {
    await signOut()
    goto('/login/')
  }

  // Select's `onchange` is the NATIVE callback — it hands over the event, not
  // the value, exactly as `onchange` on a bare <select> does.
  function pick(e) {
    switchWorkspace(e.target.value)
  }

  // ── Navigation ───────────────────────────────────────────────────────────
  // The table is src/lib/nav.js. `primary` sits in the topbar; the groups are
  // the sidebar. Both are rendered TWICE — the sidebar at full width, a drawer
  // below 767px — from one snippet, since two copies is how one of them
  // silently loses a screen.
  const current = (entry) => isActive(entry.href, entry.exact ? { exact: true } : undefined)

  // `show` reads two scalars, the shape the kit's Shell hands it.
  const navSession = () => ({ user: session.user, level: session.level })
  const navGroups  = () => visible(groups, navSession())

  // Below 767px the design system hides `.shell > .sidebar` and says its
  // contents belong in a <dialog class="drawer"> — a behavior, so the app owns
  // it (css components/frame.css § Sidebar toggle).
  let navOpen = false
  // Navigating with the drawer open leaves it covering the screen it just went
  // to. The router's own route signal is the event; there is no per-link
  // handler to hang this on.
  $: page.route, () => { navOpen = false }

  // Focus mode drops the sidebar and the notice rail; the shell's grid closes
  // their columns once they are out of the DOM. Remembered per browser, and a
  // storage that throws (a private window) just means it starts off.
  const FOCUS_KEY = 'basecamp.focus'
  let focus = false
  try { focus = localStorage.getItem(FOCUS_KEY) === '1' } catch {}
  function toggleFocus() {
    focus = !focus
    try { localStorage.setItem(FOCUS_KEY, focus ? '1' : '0') } catch {}
  }

  // A collapsed sidebar is a rail of glyphs, not a hidden one — that is focus
  // mode's job. Only the wide sidebar collapses; the drawer below 767px is
  // already out of the way until it is opened.
  const RAIL_KEY = 'basecamp.rail'
  let rail = false
  try { rail = localStorage.getItem(RAIL_KEY) === '1' } catch {}
  function toggleRail() {
    rail = !rail
    try { localStorage.setItem(RAIL_KEY, rail ? '1' : '0') } catch {}
  }
</script>

<!--
  Every class here comes from @frontierjs/css and every control from
  @frontierjs/ui: the frame (shell / topbar / sidebar / screen) and the nav
  (navlist / navlink / navlink-text / navlist-label, and the collapsed
  sidebar's .rail) are vocabulary; the badges, pills, buttons, switcher,
  drawer and account menu are components. The one <style> block below is
  layout only — the notice rail and what the topbar drops below 767px, which
  the vocabulary has no word for. No color,
  no utility classes (repo invariant 13).
-->
<!-- No skip link here: Sierra writes it first in <body> for every shell
     (FJS-D836), and its target is the <main id="main"> below. -->

<!-- One definition of the destination list, rendered in the sidebar and again
     in the small-screen drawer.

     Current-page state is aria-current="page", not a class — the stylesheet
     keys off the attribute so the look and the announcement cannot drift
     apart, and Mesa drops an attribute whose value is null rather than
     rendering aria-current="false".

     The leading `page.route` in the expression is load-bearing: isActive()
     reads it internally, but Mesa decides what an expression depends on from
     the expression's own TEXT, so without the read written here the attribute
     is set once at mount and the highlight never moves.

     The label stays in the DOM when the rail hides it, so it is still the
     link's name; `title` is the only way a sighted person reads it then. -->
{#snippet navlinks(entries)}
  <ul class="navlist">
    {#each entries as link}
      <li>
        <a class="navlink" href={link.href} prefetch="hover"
           aria-current={(page.route, current(link)) ? 'page' : null}
           title={rail ? link.label : null}
        ><NavIcon name={link.icon} /><span class="navlink-text">{link.label}</span></a>
      </li>
    {/each}
  </ul>
{/snippet}

<!-- A group is a native <details>: keyboard and toggle state come free, and a
     group the person opened stays open across navigations because `open` is
     computed once, at mount — no `page.route` read in it, so a navigation
     cannot re-close what the person opened. -->
{#snippet navlists()}
  {#each navGroups() as group}
    {#if group.direct}
      <!-- A group of one screen that is not a Basecamp screen: no fold, the
           label is the link, and the warning tone sets it apart from the rest. -->
      <a class="navlink warning nav-direct" href={group.entries[0].href} prefetch="hover"
         aria-current={(page.route, current(group.entries[0])) ? 'page' : null}
         title={rail ? group.label : null}
      ><NavIcon name={group.icon} /><span class="navlink-text">{group.label}</span></a>
    {:else}
    <details class="nav-group" open={group.open || group.entries.some(current) ? true : null}>
      <summary class="navlist-label" title={rail ? group.label : null}>
        <NavIcon name={group.icon} /><span class="navlink-text">{group.label}</span>
      </summary>
      {@render navlinks(group.entries)}
    </details>
    {/if}
  {/each}
{/snippet}

<div class="shell">
  <!-- Focus mode takes the header out of the DOM, so the screen gets its row
       back. A strip at the top edge brings back the one control that leaves it. -->
  {#if session.user && focus}
    <div class="focus-peek">
      <span class="focus-peek-tab">
        <Button treatment="outlined" size="sm" id="focus-leave" aria-pressed="true"
                title="Show the header and side panels (Ctrl+.)"
                onclick={toggleFocus}>Toggle focus</Button>
      </span>
    </div>
  {/if}
  {#if !focus}
  <header class="topbar">
    <span class="cluster">
      <!-- `.sidebar-toggle` decides WHEN this control exists — the package
           hides it above 767px, where the real sidebar is back, except
           beside a rail on a screen with no hover. Opening the
           drawer is the app's job and is the `navOpen` flag below. -->
      {#if session.user}
        <button class="btn ghost square sidebar-toggle" aria-label="Open navigation"
                aria-expanded={navOpen ? 'true' : 'false'} onclick={() => navOpen = true}>☰</button>
      {/if}
      <a class="cluster" href="/" aria-label="{page.siteName} home" style:text-decoration="none" style:color="inherit">
        <img src="/favicon.svg" alt="" width="20" height="20" />
        <strong>{page.siteName}</strong>
      </a>
      <span class="hide-sm"><Badge tone="muted">beta</Badge></span>
      {#if session.user}
        <span class="hide-sm">
          <Button treatment="ghost" size="sm" id="focus-toggle"
                  aria-pressed="false" title="Hide the header and side panels (Ctrl+.)"
                  onclick={toggleFocus}>Focus</Button>
        </span>
      {/if}
    </span>

    <!-- The few screens opened all day. Below 767px the drawer repeats them
         and this row is hidden (`.hide-sm`, the style block below). -->
    {#if session.user}
      <nav class="cluster hide-sm" aria-label="Primary">
        {#each TOPBAR as link}
          <a class="navlink" href={link.href}
             aria-current={(page.route, current(link)) ? 'page' : null}
          >{link.label}</a>
        {/each}
      </nav>
    {/if}


    <span class="cluster">
      {#if session.user && session.workspaces.length}
        <!-- The switcher is the whole of Phase 2: nothing downstream of here
             works without X-Workspace-Id, and the header is where the scope a
             page is showing has to be legible.
             .field is full-width because that is right in a form column and
             wrong in a topbar; --field-inline-size is the knob the design
             system provides for exactly this (css components/form-core.css). -->
        <label class="visually-hidden" for="workspace-switch">Workspace</label>
        <!-- The custom property is set on a wrapper rather than passed as a
             prop: --field-inline-size inherits, and a kit component takes the
             props it declares — it is not a div with a style attribute. -->
        <span class="hide-sm" style="--field-inline-size: auto">
          <Select
            id="workspace-switch"
            value={session.workspaceId}
            placeholder=""
            options={session.workspaces.map(w => ({ value: w.id, label: w.name }))}
            onchange={pick}
          />
        </span>
      {/if}

      {#if session.user}
        <Button treatment="ghost" id="palette-open" onclick={() => commandPalette.show()}>
          Search <kbd class="kbd hide-sm">⌘K</kbd>
        </Button>

        <!-- The count is a Badge inside the trigger, so the unread number is
             part of the button's name to a screen reader as well as its look. -->
        <DropdownMenu placement="bottom-end">
          {#snippet trigger()}
            <Button treatment="ghost" id="bell"
                    aria-label={unread.length ? `Notifications, ${unread.length} unread` : 'Notifications'}
            >🔔{#if unread.length} <Badge tone="danger" id="bell-count">{unread.length}</Badge>{/if}</Button>
          {/snippet}
          {#if unread.length}
            <DropdownGroup heading="Unread">
              {#each unread.slice(0, BELL_MAX) as n}
                <DropdownItem onclick={() => openNote(n)}>
                  <span class="stack">
                    <strong>{titleOf(n)}</strong>
                    {#if bodyOf(n)}<span class="text-sm text-muted">{bodyOf(n)}</span>{/if}
                  </span>
                </DropdownItem>
              {/each}
            </DropdownGroup>
            <DropdownSeparator />
            <DropdownItem onclick={() => markAllRead(bell).catch(() => {})}>Mark all read</DropdownItem>
          {:else}
            <DropdownItem disabled>Nothing unread</DropdownItem>
            <DropdownSeparator />
          {/if}
          <DropdownItem onclick={() => goto('/notifications/')}>All notifications</DropdownItem>
        </DropdownMenu>

        <!-- Who you are and signing out are one control, not two.
             `.cluster` wraps, so a right-hand cluster that does not fit lays a
             second row. The package no longer draws that row outside the bar —
             --topbar-height is a floor and the bar grows (`FJS-338`) — but a
             bar that grows on a phone is still a bar with too much in it, and
             fewer items is the app's half of the same answer. -->
        <DropdownMenu placement="bottom-end">
          {#snippet trigger()}
            <Button treatment="ghost" id="account-menu">Account</Button>
          {/snippet}
          <DropdownGroup heading={session.user.email}>
            <DropdownItem onclick={() => goto('/settings/')}>Your settings</DropdownItem>
            <DropdownItem onclick={out}>Sign out</DropdownItem>
          </DropdownGroup>
        </DropdownMenu>
      {/if}

      <!-- The live WebSocket as a dot, last in the row: a word that changes
           width between 'live' and 'offline' shifted every control after it.
           It opens only once a token is stored, so offline before sign-in is
           correct. -->
      <Dot class="hide-sm" tone={status.connected ? 'success' : 'muted'}
           role="status"
           title={status.connected ? 'Live' : 'Offline'}
           label={status.connected ? 'Live' : 'Offline'} />
    </span>
  </header>
  {/if}

  <!-- The long tail lives here rather than in the topbar: every `.navlink` in
       a 56px row wrapped to two lines and spilled out of it at every width
       down from 1920px, so the topbar holds the primary handful only.
       Hidden below 767px by the package; the drawer below covers that. -->
  {#if session.user && !focus}
    <nav class="sidebar" class:rail={rail} aria-label="Main">
      <button class="btn ghost square rail-toggle" id="rail-toggle"
              aria-label={rail ? 'Expand the sidebar' : 'Collapse the sidebar'}
              aria-expanded={rail ? 'false' : 'true'}
              title={rail ? 'Expand the sidebar' : 'Collapse the sidebar'}
              onclick={toggleRail}>
        {#if rail}<NavIcon name="panel-open" />{:else}<NavIcon name="panel-close" />{/if}
      </button>
      {@render navlists()}
    </nav>
  {/if}

  <main class="screen" id="main" tabindex="-1">
    <div class="screen-grid">
      <!-- The condensed attention view rides beside every screen — in the
           right rail when there is room for one, above the content when there
           is not. The full list, with the fold and the counts, is the home
           screen's ActionQueue — same notices, same rules, two presentations.
           First in source order either way, so a screen reader meets it
           before the content wherever it is drawn. -->
      {#if session.user && !focus}
        <aside class="notice-rail">
          <NoticeBar notices={notices} max={2} loading={srvList.loading || depList.loading || jbsList.loading} />
        </aside>
      {/if}
      <div class="container stack screen-body">
        <slot />
      </div>
    </div>
  </main>
</div>

<!--
  ⌘K anywhere. `mesa:window` is the one place a global key listener belongs —
  a document listener added by hand in a component outlives the component.
-->
<mesa:window onkeydown={(e) => {
  if ((e.metaKey || e.ctrlKey) && e.key === 'k') { e.preventDefault(); commandPalette.toggle() }
  if ((e.metaKey || e.ctrlKey) && e.key === '.' && session.user) { e.preventDefault(); toggleFocus() }
}} />

{#if commandPalette.open}
  <CommandPalette
    items={COMMANDS}
    groupOrder={['Recent', 'Navigate', 'Create', 'Servers', 'Workspace', 'Session']}
    placeholder="Search commands, servers, workspaces…"
    onclose={() => commandPalette.hide()}
  />
{/if}

<!-- The sidebar below 767px, where the package hides the real one. Its
     contents are the same snippet — a second copy of the list is how one of
     them silently loses a screen. Only ever ONE of the two is in the
     accessibility tree: the sidebar is `display: none` at this width, and a
     closed <dialog> is not exposed at the other. -->
{#if session.user}
  <Drawer side="left" open={navOpen} title="Navigation" onclose={() => navOpen = false}>
    <nav aria-label="Main">
      {#if session.workspaces.length}
        <!-- The topbar's switcher is hidden at this width, and the scope a page
             is showing still has to be reachable. -->
        <div class="drawer-switch">
          <label class="visually-hidden" for="workspace-switch-nav">Workspace</label>
          <Select
            id="workspace-switch-nav"
            value={session.workspaceId}
            placeholder=""
            options={session.workspaces.map(w => ({ value: w.id, label: w.name }))}
            onchange={pick}
          />
        </div>
      {/if}
      {@render navlinks(TOPBAR)}
      {@render navlists()}
    </nav>
  </Drawer>
{/if}

<!-- One Toaster for the app; anything can call toasts.success(). -->
<Toaster position="bottom-right" />

<!-- A destructive button confirms itself with `data-confirm="…"`. Without this
     mounted the attribute does nothing and the button acts on the first click. -->
<ConfirmProvider />

<style>
  /* The topbar below 767px is the drawer button, the name, search, the bell
     and the account menu. The rest is in the drawer or one search away. */
  @media (max-width: 767px) {
    .hide-sm { display: none; }
    .topbar {
      gap:            var(--space-sm);
      padding-inline: var(--space-md);
    }
    .topbar .cluster { flex-wrap: nowrap; gap: var(--space-xs); }
  }
  .drawer-switch { margin-block-end: var(--space-lg); }

  /* The tone only sets --bg-mix; a navlink reads it just when current. */
  .nav-direct { color: var(--bg-mix); }

  /* Focus mode has no header. A thin strip along the top edge is the hover
     target; the toggle waits above the viewport and slides down when the
     cursor reaches the strip, or when the keyboard tabs into it. */
  .focus-peek {
    position:        fixed;
    inset-block-start: 0;
    inset-inline:    0;
    block-size:      var(--space-sm);
    display:         flex;
    justify-content: center;
    z-index:         var(--z-topbar);
  }
  .focus-peek-tab {
    align-self:  flex-start;
    padding:     var(--space-xs);
    background:  var(--topbar-bg, var(--surface));
    border:      var(--border-width) solid var(--rule);
    border-block-start: 0;
    border-end-start-radius: var(--radius-md, 0.5rem);
    border-end-end-radius:   var(--radius-md, 0.5rem);
    transform:   translateY(-100%);
    transition:  transform var(--motion-fast);
  }
  .focus-peek:hover .focus-peek-tab,
  .focus-peek:focus-within .focus-peek-tab { transform: none; }

  .rail-toggle {
    display:             flex;
    margin-inline-start: auto;
  }

  .sidebar.rail .rail-toggle { margin-inline: auto; }
  .sidebar.rail .nav-group + .nav-group {
    margin-block-start: var(--space-sm);
    border-block-start: var(--border-width) solid var(--rule);
  }

  /* Below 1536px a rail would squeeze every table on every screen to
     ~700px, so the notices stack above the content as one column. */
  .screen-grid {
    display: grid;
    gap: var(--screen-pad);
    grid-template-columns: minmax(0, 1fr);
  }
  /* NoticeBar renders nothing once every notice is dismissed; an empty rail
     would still hold a gap above the content, or a blank 20rem column. */
  .notice-rail:not(:has(section)) { display: none; }
  /* The workbench is a working surface, not a reading column: let it take the
     whole width the screen gives it. */
  .screen-body:has(:global(.workbench)) { max-inline-size: none; }

  @media (min-width: 1536px) {
    .screen-grid:has(> .notice-rail section) {
      grid-template-columns: minmax(0, 1fr) 20rem;
    }
    .screen-body { grid-column: 1; grid-row: 1; }
    .notice-rail {
      grid-column: 2;
      grid-row: 1;
      align-self: start;
      /* The document scrolls, not the screen, so the rail sticks under the
         sticky topbar rather than scrolling away with a long page. */
      position: sticky;
      top: calc(var(--topbar-height) + var(--screen-pad));
    }
  }
</style>
