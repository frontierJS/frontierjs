---
siteName: Basecamp
---
<script>
  import { page, goto, isActive } from '@frontierjs/sierra/router'
  import { status, useStore } from '@frontierjs/sierra/junction'
  import { $onDestroy } from '@frontierjs/mesa/runtime'
  import { session, signOut, switchWorkspace } from '../session.js'

  import Badge          from '@frontierjs/ui/components/display/Badge.mesa'
  import Button         from '@frontierjs/ui/components/forms/Button.mesa'
  import Pill           from '@frontierjs/ui/components/display/Pill.mesa'
  import Select         from '@frontierjs/ui/components/forms/Select.mesa'
  import CommandPalette from '@frontierjs/ui/components/overlay/CommandPalette.mesa'
  import Drawer         from '@frontierjs/ui/components/overlay/Drawer.mesa'
  import DropdownMenu      from '@frontierjs/ui/components/overlay/DropdownMenu.mesa'
  import DropdownItem      from '@frontierjs/ui/components/overlay/DropdownItem.mesa'
  import DropdownLabel     from '@frontierjs/ui/components/overlay/DropdownLabel.mesa'
  import DropdownSeparator from '@frontierjs/ui/components/overlay/DropdownSeparator.mesa'
  import Toaster        from '@frontierjs/ui/components/feedback/Toaster.mesa'
  import { commandPalette } from '@frontierjs/ui/stores/commandPaletteStore.js'

  import NoticeBar from '../components/NoticeBar.mesa'
  import { servers }     from '../resources/Server.mesa'
  import { deployments } from '../resources/Deployment.mesa'
  import { jobs }        from '../resources/Job.mesa'
  import { computeNotices } from '../notices.js'

  $: (page.siteName, page.route)
  $: (status.connected, session.user, session.workspaceId, session.workspaces)
  $: commandPalette.open

  // ── The attention system's data ──────────────────────────────────────────
  // The shell subscribes to three stores rather than polling: a resource store
  // is a module singleton fed by the same WebSocket events the screens use, so
  // a server going unreachable reaches the notice bar without this file asking
  // again. load() runs once per workspace, not once per navigation.
  const { get: srv,  unsubscribe: unsubSrv }  = useStore(servers.store)
  const { get: dep,  unsubscribe: unsubDep }  = useStore(deployments.store)
  const { get: jbs,  unsubscribe: unsubJbs }  = useStore(jobs.store)
  $onDestroy(() => { unsubSrv(); unsubDep(); unsubJbs() })

  // Failures are swallowed on purpose: the shell is not the screen that owns
  // any of these lists, and a workspace the caller cannot read is the guard's
  // problem, not a banner on every page. The screens report their own errors.
  function loadAttention() {
    if (!session.user || !session.workspaceId) return
    servers.load().catch(() => {})
    deployments.load().catch(() => {})
    jobs.load().catch(() => {})
  }

  loadAttention()

  // Explicit-dependency effect (Mesa §4.2) — the handler runs untracked, so the
  // reads inside loadAttention() add no subscriptions of their own.
  $: session.workspaceId, () => loadAttention()

  // Derived here, not in the template: one definition of "needs attention",
  // shared with the home screen's queue (src/notices.js).
  $: notices = computeNotices({ servers: srv(), deployments: dep(), jobs: jbs() })

  // ── ⌘K ───────────────────────────────────────────────────────────────────
  // The commands are the nav and the header's own behaviours, reached a second
  // way — never a second set of actions. `$:` and not a plain const because
  // the Servers and Workspace groups are built from live rows.
  $: COMMANDS = [
    { id: 'go-home',        group: 'Navigate', label: 'Overview',    action: () => goto('/') },
    { id: 'go-dashboards',  group: 'Navigate', label: 'Dashboards',  sub: 'saved views',        action: () => goto('/dashboards/') },
    { id: 'go-projects',    group: 'Navigate', label: 'Projects',    action: () => goto('/projects/') },
    { id: 'go-servers',     group: 'Navigate', label: 'Servers',     action: () => goto('/servers/') },
    { id: 'go-deployments', group: 'Navigate', label: 'Deployments', action: () => goto('/deployments/') },
    { id: 'go-jobs',        group: 'Navigate', label: 'Jobs',        action: () => goto('/jobs/') },
    { id: 'go-networks',    group: 'Navigate', label: 'Networking',  sub: 'private networks',   action: () => goto('/networks/') },
    { id: 'go-volumes',     group: 'Navigate', label: 'Volumes',     sub: 'disks the fleet has', action: () => goto('/volumes/') },
    { id: 'go-cleanup',     group: 'Navigate', label: 'Disk cleanup', sub: 'what can be reclaimed', action: () => goto('/cleanup/') },
    { id: 'go-recipes',     group: 'Navigate', label: 'Recipes',     sub: 'scripts to run on a server', action: () => goto('/recipes/') },
    { id: 'go-alerts',      group: 'Navigate', label: 'Alerts',      sub: 'rules and firings',  action: () => goto('/alerts/') },
    { id: 'go-channels',    group: 'Navigate', label: 'Channels',    sub: 'where alerts land',  action: () => goto('/channels/') },
    { id: 'go-flags',       group: 'Navigate', label: 'Flags',       sub: 'feature flags',      action: () => goto('/flags/') },
    { id: 'go-secrets',     group: 'Navigate', label: 'Secrets',     sub: 'machine credentials', action: () => goto('/secrets/') },
    { id: 'go-api-keys',    group: 'Navigate', label: 'API keys',    sub: 'tokens we issue',    action: () => goto('/api-keys/') },
    { id: 'go-activity',    group: 'Navigate', label: 'Activity',    sub: 'what happened here', action: () => goto('/activity/') },
    { id: 'go-portal',      group: 'Navigate', label: 'Portal',      sub: 'shared appliances',  action: () => goto('/portal/') },
    { id: 'go-admin',       group: 'Navigate', label: 'Admin',       action: () => goto('/admin/') },
    { id: 'go-audit',       group: 'Navigate', label: 'Audit trail', sub: 'Admin', action: () => goto('/admin/audit/') },
    { id: 'go-adapters',    group: 'Navigate', label: 'Adapters',    sub: 'Admin', action: () => goto('/admin/adapters/') },

    // Spread, not a conditional entry: a falsy item in the list renders as a
    // blank row in the palette rather than as nothing.
    ...(session.user?.isSystemAdmin ? [
      { id: 'go-hub',        group: 'Navigate', label: 'Platform hub',   sub: 'every workspace', action: () => goto('/hub/') },
      { id: 'go-hub-ws',     group: 'Navigate', label: 'Hub workspaces', sub: 'Hub', action: () => goto('/hub/workspaces/') },
      { id: 'go-hub-users',  group: 'Navigate', label: 'Hub users & bots', sub: 'Hub', action: () => goto('/hub/users/') },
      { id: 'go-hub-flags',  group: 'Navigate', label: 'Hub flags',      sub: 'Hub', action: () => goto('/hub/flags/') },
      { id: 'new-bot',       group: 'Create',   label: 'New bot account', action: () => goto('/hub/users/') },
    ] : []),

    { id: 'new-project', group: 'Create', label: 'New project',    action: () => goto('/projects/create/') },
    { id: 'new-dashboard', group: 'Create', label: 'New dashboard', action: () => goto('/dashboards/') },
    { id: 'new-server',  group: 'Create', label: 'Provision server', action: () => goto('/servers/create/') },
    { id: 'new-network', group: 'Create', label: 'New network',       action: () => goto('/networks/') },
    { id: 'new-alert',   group: 'Create', label: 'New alert rule',    action: () => goto('/alerts/') },
    { id: 'new-channel', group: 'Create', label: 'New channel',       action: () => goto('/channels/') },
    { id: 'new-flag',    group: 'Create', label: 'New feature flag',  action: () => goto('/flags/') },
    { id: 'new-api-key', group: 'Create', label: 'New API key',       action: () => goto('/api-keys/') },
    { id: 'new-recipe',  group: 'Create', label: 'New recipe',        action: () => goto('/recipes/') },

    // A server the palette can reach is a server the fleet actually has —
    // the rows are the ones already loaded for the notice rules, so this
    // group costs no extra request.
    ...srv().map(s => ({
      id: `srv-${s.id}`, group: 'Servers', label: s.name, sub: s.status,
      action: () => goto(`/servers/${s.id}/`),
    })),

    ...session.workspaces
      .filter(w => w.id !== session.workspaceId)
      .map(w => ({
        id: `ws-${w.id}`, group: 'Workspace', label: `Switch to ${w.name}`,
        action: () => switchWorkspace(w.id),
      })),

    { id: 'sign-out', group: 'Session', label: 'Sign out', action: out },
  ]

  // Awaited: signOut ends the session at the server first, and navigating
  // before it returns would put the guard in front of a session that is still
  // there — which sends /login/ straight back to /.
  async function out() {
    await signOut()
    goto('/login/')
  }

  // Select's `onchange` is the NATIVE callback — it hands over the event, not
  // the value, exactly as `on:change` on a bare <select> would.
  function pick(e) {
    switchWorkspace(e.target.value)
  }

  // ── Navigation ───────────────────────────────────────────────────────────
  // Nineteen destinations, grouped the way the mock's Sidebar groups them
  // (docs/mock/BasecampUI.jsx § Sidebar): what you open daily, what you open
  // weekly, what you configure, and the tier above the workspace. The headings
  // are the design system's `.navlist-label`; the mock separated Daily and
  // Weekly with a bare rule, and a heading says the same thing out loud.
  //
  // A table rather than nineteen hand-written anchors: the list is rendered
  // TWICE — the sidebar at full width, a drawer below 767px — and two copies of
  // it is how one of them silently loses a screen.
  const NAV = [
    { label: 'Daily', links: [
      { href: '/',            label: 'Overview', exact: true },
      { href: '/dashboards/', label: 'Dashboards'  },
      { href: '/projects/',   label: 'Projects'    },
      { href: '/deployments/',label: 'Deployments' },
      { href: '/servers/',    label: 'Servers'     },
      { href: '/jobs/',       label: 'Jobs'        },
      { href: '/alerts/',     label: 'Alerts'      },
      { href: '/flags/',      label: 'Flags'       },
    ] },
    { label: 'Weekly', links: [
      { href: '/activity/',   label: 'Activity'    },
      { href: '/networks/',   label: 'Networking'  },
      { href: '/portal/',     label: 'Portal'      },
    ] },
    { label: 'Manage', links: [
      { href: '/volumes/',    label: 'Volumes'     },
      { href: '/cleanup/',    label: 'Cleanup'     },
      { href: '/recipes/',    label: 'Recipes'     },
      { href: '/channels/',   label: 'Channels'    },
      { href: '/secrets/',    label: 'Secrets'     },
      { href: '/api-keys/',   label: 'API keys'    },
      { href: '/admin/',      label: 'Admin'       },
    ] },
  ]

  // The hub tier is not a workspace role, so it is not in the switcher and it
  // is not offered to people who do not hold it. `isSystemAdmin` rides on the
  // session; the service answers 404 to anyone else regardless, which is where
  // the refusal actually is.
  $: session.user
  const navGroups = () => session.user?.isSystemAdmin
    ? [...NAV, { label: 'System', links: [{ href: '/hub/', label: 'Hub' }] }]
    : NAV

  // Below 767px the design system hides `.shell > .sidebar` and says its
  // contents belong in a <dialog class="drawer"> — a behaviour, so the app owns
  // it (css components/frame.css § Sidebar toggle).
  let navOpen = false
  // Navigating with the drawer open leaves it covering the screen it just went
  // to. The router's own route signal is the event; there is no per-link
  // handler to hang this on.
  $: page.route, () => { navOpen = false }
</script>

<!--
  Every class here comes from @frontierjs/css and every control from
  @frontierjs/ui: the frame (shell / topbar / sidebar / screen) and the nav
  (navlist / navlink / navlist-label) are vocabulary; the badges, pills,
  buttons, switcher, drawer and account menu are components. No <style> block,
  no colour, no utility classes (repo invariant 13) — which is also why the
  topbar still crowds below ~600px: there is no way to say "drop this below md"
  without one, and the package refused to ship the vocabulary (FJS-338).
-->
<!-- The skip link is the first focusable thing on the page and is invisible
     until focused. Without it, a keyboard user tabs through the nav, the
     workspace switcher and sign-out on EVERY navigation before reaching the
     content — the design system's frame documents it as part of the shell
     anatomy (css components/frame.css) and it was simply missing. -->
<a class="skip-link" href="#screen">Skip to content</a>

<!-- One definition of the destination list, rendered in the sidebar and again
     in the small-screen drawer.

     Current-page state is aria-current="page", not a class — the stylesheet
     keys off the attribute so the look and the announcement cannot drift
     apart, and Mesa drops an attribute whose value is null rather than
     rendering aria-current="false".

     The leading `page.route` in the expression is load-bearing: isActive()
     reads it internally, but Mesa decides what an expression depends on from
     the expression's own TEXT, so without the read written here the attribute
     is set once at mount and the highlight never moves. -->
{#snippet navlists()}
  {#each navGroups() as group}
    <div class="navlist-label">{group.label}</div>
    <ul class="navlist">
      {#each group.links as link}
        <li>
          <a class="navlink" href={link.href}
             aria-current={(page.route, isActive(link.href, link.exact ? { exact: true } : undefined)) ? 'page' : null}
          >{link.label}</a>
        </li>
      {/each}
    </ul>
  {/each}
{/snippet}

<div class="shell">
  <header class="topbar">
    <span class="cluster">
      <!-- `.sidebar-toggle` decides WHEN this control exists — the package
           hides it above 767px, where the real sidebar is back. Opening the
           drawer is the app's job and is the `navOpen` flag below. -->
      {#if session.user}
        <button class="btn ghost square sidebar-toggle" aria-label="Open navigation"
                aria-expanded={navOpen ? 'true' : 'false'} on:click={() => navOpen = true}>☰</button>
      {/if}
      <strong>{page.siteName}</strong>
      <Badge tone="muted">alpha</Badge>
    </span>


    <span class="cluster">
      {#if session.user && session.workspaces.length}
        <!-- The switcher is the whole of Phase 2: nothing downstream of here
             works without X-Workspace-Id, and the header is where the scope a
             page is showing has to be legible.
             .field is full-width because that is right in a form column and
             wrong in a topbar; --field-inline-size is the knob the design
             system provides for exactly this (css components/form-core.css). -->
        <label class="visually-hidden" for="workspace-switch">Workspace</label>
        <!-- The custom property is set on a wrapper rather than passed as a
             prop: --field-inline-size inherits, and a kit component takes the
             props it declares — it is not a div with a style attribute. -->
        <span style="--field-inline-size: auto">
          <Select
            id="workspace-switch"
            value={session.workspaceId}
            placeholder=""
            options={session.workspaces.map(w => ({ value: w.id, label: w.name }))}
            onchange={pick}
          />
        </span>
      {/if}

      <!-- The live WebSocket as a tone, not a hand-mixed green. It opens only
           once a token is stored, so 'offline' before sign-in is correct. -->
      <Pill tone={status.connected ? 'success' : 'muted'}>
        {status.connected ? 'live' : 'offline'}
      </Pill>

      {#if session.user}
        <Button variant="ghost" id="palette-open" onclick={() => commandPalette.show()}>
          Search <kbd class="kbd">⌘K</kbd>
        </Button>

        <!-- Who you are and signing out are one control, not two.
             `.cluster` wraps, so a right-hand cluster that does not fit lays a
             second row. The package no longer draws that row outside the bar —
             --topbar-height is a floor and the bar grows (`FJS-338`) — but a
             bar that grows on a phone is still a bar with too much in it, and
             fewer items is the app's half of the same answer. -->
        <DropdownMenu placement="bottom-end">
          {#snippet trigger()}
            <!-- A kit component takes its handler as a PROP (`onclick`), not
                 as `on:click` — that directive belongs to elements. -->
            <Button variant="ghost" id="account-menu">Account</Button>
          {/snippet}
          <DropdownLabel>{session.user.email}</DropdownLabel>
          <DropdownSeparator />
          <DropdownItem onclick={out}>Sign out</DropdownItem>
        </DropdownMenu>
      {/if}
    </span>
  </header>

  <!-- The nav lives here rather than in the topbar. Nineteen `.navlink`s in a
       56px row wrapped to two lines and spilled out of it at every width down
       from 1920px — and `.navlink` is documented as the SIDEBAR's link
       (css patterns/nav.css), which is the same answer the mock's shell gives.
       Hidden below 767px by the package; the drawer below covers that. -->
  {#if session.user}
    <nav class="sidebar" aria-label="Main">
      {@render navlists()}
    </nav>
  {/if}

  <main class="screen" id="screen" tabindex="-1">
    <div class="container stack">
      <!-- The condensed attention view rides above every screen. The full list,
           with the fold and the counts, is the home screen's ActionQueue —
           same notices, same rules, two presentations. -->
      {#if session.user}
        <NoticeBar notices={notices} max={2} />
      {/if}
      <slot />
    </div>
  </main>
</div>

<!--
  ⌘K anywhere. `mesa:window` is the one place a global key listener belongs —
  a document listener added by hand in a component outlives the component.
-->
<mesa:window on:keydown={(e) => {
  if ((e.metaKey || e.ctrlKey) && e.key === 'k') { e.preventDefault(); commandPalette.toggle() }
}} />

{#if commandPalette.open}
  <CommandPalette
    items={COMMANDS}
    groupOrder={['Navigate', 'Create', 'Servers', 'Workspace', 'Session']}
    placeholder="Search commands, servers, workspaces…"
    onclose={() => commandPalette.hide()}
  />
{/if}

<!-- The sidebar below 767px, where the package hides the real one. Its
     contents are the same snippet — a second copy of the list is how one of
     them silently loses a screen. Only ever ONE of the two is in the
     accessibility tree: the sidebar is `display: none` at this width, and a
     closed <dialog> is not exposed at the other. -->
{#if session.user}
  <Drawer side="left" open={navOpen} title="Navigation" onclose={() => navOpen = false}>
    <nav aria-label="Main">
      {@render navlists()}
    </nav>
  </Drawer>
{/if}

<!-- One Toaster for the app; anything can call toasts.success(). -->
<Toaster position="bottom-right" />
