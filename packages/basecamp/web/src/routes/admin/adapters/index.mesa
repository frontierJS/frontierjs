---
title: Adapters
---
<script>
  import { portal } from '../../../resources/Portal.mesa'
  import Button from '@frontierjs/ui/components/forms/Button.mesa'

  let rows    = []
  let error   = null
  let loading = true
  let busy    = null

  async function load() {
    error = null; loading = true
    try {
      // find() is the fast path — it reports which adapters are wired without
      // pinging any of them. The ping is per-adapter, on demand, below.
      rows = (await portal.service.find()).data
    } catch (e) {
      error = e.message
    } finally {
      loading = false
    }
  }

  load()

  async function ping(entry) {
    error = null; busy = entry.id
    try {
      const fresh = await portal.service.create({ id: entry.id })
      const i = rows.findIndex(r => r.id === entry.id)
      if (i >= 0) rows = [...rows.slice(0, i), { ...rows[i], ...fresh }, ...rows.slice(i + 1)]
    } catch (e) {
      error = e.message
    } finally {
      busy = null
    }
  }

  const TONE = { healthy: 'success', unconfigured: 'muted', unreachable: 'danger', degraded: 'warning' }

  // Two groups, because *unconfigured* means different work for each: an
  // appliance is installed on a machine and pointed at with a URL, a hosted
  // service is an account somebody opens and a token this app holds. The
  // service says which is which — a list here would be a second answer.
  $: appliances = rows.filter(r => !r.hosted)
  $: hosted     = rows.filter(r => r.hosted)
</script>

<p class="text-body">
  Every party this app speaks to. <strong>Unconfigured</strong> means the adapter is a stub until it is given
  what it needs — it is not an error, and an app can run with none of them.
</p>

{#if error}
  <article class="alert danger">
    <div class="alert-content">{error}</div>
  </article>
{/if}

{#if loading}
  <p class="text-sm text-muted">Loading…</p>
{:else}
  <h2 class="h4">Self-hosted appliances</h2>
  <p class="text-sm text-muted">Installed on a machine you operate. Set its URL to wire it.</p>
  <div class="tiles" style="--tile-min: 17rem" id="adapter-tiles">
    {#each appliances as entry}
      <article class="card stack">
        <div class="cluster">
          <h2 class="h4">{entry.name}</h2>
          <span class="pill {TONE[entry.status] ?? ''}">{entry.status}</span>
        </div>
        <p class="text-sm text-muted">{entry.description}</p>
        <dl class="facts">
          <dt>URL</dt><dd><code>{entry.url ?? 'not set'}</code></dd>
        </dl>
        <div class="cluster">
          <Button variant="ghost" disabled={busy === entry.id} onclick={() => ping(entry)}>
            {busy === entry.id ? 'Checking…' : 'Check now'}
          </Button>
        </div>
      </article>
    {/each}
  </div>

  <h2 class="h4">Hosted services</h2>
  <p class="text-sm text-muted">
    Somebody else's service, reached with a credential. Wiring one is a
    <code>@frontierjs/conduit</code> target plus its token as a <a href="/secrets/">Secret</a> —
    there is no URL to open and no <code>url</code> to show.
  </p>
  <div class="tiles" style="--tile-min: 17rem" id="hosted-tiles">
    {#each hosted as entry}
      <article class="card stack">
        <div class="cluster">
          <h3 class="h5">{entry.name}</h3>
          <span class="pill {TONE[entry.status] ?? ''}">{entry.status}</span>
        </div>
        <p class="text-sm text-muted">{entry.description}</p>
        <dl class="facts">
          <dt>Credential</dt><dd><code>{entry.configured ? 'set' : 'not set'}</code></dd>
        </dl>
        <div class="cluster">
          <Button variant="ghost" disabled={busy === entry.id} onclick={() => ping(entry)}>
            {busy === entry.id ? 'Checking…' : 'Check now'}
          </Button>
        </div>
      </article>
    {/each}
  </div>
{/if}
