---
title: Workspace
---
<script>
  // The workspace itself: its name, a new one beside it, and deleting it.
  //
  // Rename is an admin's and delete an owner's — the service's role hooks say
  // so and answer in words; this screen offers both and shows the refusal.
  // Delete is `@@softDelete(cascade)`: every project, server, secret and job
  // under it is stamped with it, which is why the confirmation asks for the
  // name typed back rather than a click.
  import { goto }      from '@frontierjs/sierra/router'
  import { session, reloadWorkspaces, switchWorkspace } from '../../../lib/session.js'
  import { workspaces } from '../../../resources/Workspace.mesa'
  import { messageFor } from '../../../lib/errors.js'
  import { qrSvg }     from '@frontierjs/toolbelt/qr'
  import Button from '@frontierjs/ui/components/forms/Button.mesa'
  import Input  from '@frontierjs/ui/components/forms/Input.mesa'
  import Card   from '@frontierjs/ui/components/layout/Card.mesa'
  import CopyButton from '@frontierjs/ui/components/display/CopyButton.mesa'
  import Mono   from '@frontierjs/ui/components/display/Mono.mesa'
  import { toasts } from '@frontierjs/ui/stores/toastStore'

  $: session.workspaceId

  let ws      = null
  let error   = null
  let loading = true
  let busy    = null

  // The draft pins the version it was read at (`@version`), so a rename over
  // somebody else's is refused rather than silently winning.
  let draft   = { name: '', slug: '', version: null }
  let newName = ''
  let typed   = ''

  // ─── Phone pings ─────────────────────────────────────────────────────
  // `push` answers the workspace's critical topic, minting it on first view,
  // and which ntfy server it leaves through — the ladder in the api's `push.ts`,
  // restated nowhere here. Only an admin may read it (the topic is the secret on
  // public ntfy.sh), so a developer sees the refusal in words and no card.
  let ping      = null   // { topic, url, rung, subscribeUrl }
  let pingError = null
  let pinged    = null   // 'sent' | an error message

  const RUNG = {
    1: 'your own ntfy server, set by NTFY_BASE_URL',
    2: 'the ntfy App on this Basecamp, with ntfy.sh as the retry',
    3: 'ntfy.sh, the public server — the topic is the secret',
  }

  async function load() {
    error = null; loading = true
    try {
      ws    = session.workspaceId ? await workspaces.service.get(session.workspaceId) : null
      draft = ws ? { name: ws.name, slug: ws.slug, version: ws.version } : draft
      typed = ''
      await loadPing()
    } catch (e) {
      error = e.message
    } finally {
      loading = false
    }
  }

  load()
  $: session.workspaceId, () => load()

  async function loadPing() {
    ping = null; pingError = null; pinged = null
    if (!ws) return
    try {
      ping = await workspaces.service.invoke('push', ws.id)
    } catch (e) {
      // 403 is the ordinary answer for a developer; the card says so and stops.
      pingError = messageFor(workspaces, e)
    }
  }

  async function testPing() {
    pinged = null; busy = 'ping'
    try {
      await workspaces.service.invoke('testPing', ws.id)
      pinged = 'sent'
      toasts.success('Test ping sent. A subscribed phone shows it within a few seconds.')
    } catch (e) {
      pinged = messageFor(workspaces, e)
    } finally {
      busy = null
    }
  }

  async function rename() {
    error = null; busy = 'rename'
    try {
      const patch = { version: draft.version }
      if (draft.name !== ws.name) patch.name = draft.name
      if (draft.slug !== ws.slug) patch.slug = draft.slug
      ws    = await workspaces.service.patch(ws.id, patch)
      draft = { name: ws.name, slug: ws.slug, version: ws.version }
      await reloadWorkspaces()
      toasts.success('Workspace saved')
    } catch (e) {
      error = messageFor(workspaces, e)
    } finally {
      busy = null
    }
  }

  async function create() {
    error = null; busy = 'create'
    try {
      const made = await workspaces.service.create({ name: newName.trim() })
      newName = ''
      await reloadWorkspaces()
      switchWorkspace(made.id)
      toasts.success(`${made.name} created. You are its owner, and it is the one you are in now.`)
      goto('/')
    } catch (e) {
      error = messageFor(workspaces, e)
    } finally {
      busy = null
    }
  }

  async function destroy() {
    error = null; busy = 'delete'
    const { id, name } = ws
    try {
      await workspaces.service.remove(id)
      await reloadWorkspaces()
      toasts.success(`${name} deleted`)
      goto('/')
    } catch (e) {
      error = e.message
      busy  = null
    }
  }

  $: changed = !!ws && (draft.name !== ws.name || draft.slug !== ws.slug)
</script>

{#if error}
  <article class="alert danger" id="workspace-error">
    <div class="alert-content">{error}</div>
  </article>
{/if}

{#if loading}
  <p class="text-sm text-muted">Loading…</p>
{:else if ws}
  <Card id="workspace-rename">
    <h2 class="h5">This workspace</h2>
    <form class="stack" novalidate onsubmit={e => { e.preventDefault(); rename() }}>
      <Input id="ws-name" name="name" label="Name" value={draft.name}
             oninput={(e) => draft = { ...draft, name: e.target.value }} />
      <Input id="ws-slug" name="slug" label="Slug" value={draft.slug}
             hint="Unique across this Basecamp"
             oninput={(e) => draft = { ...draft, slug: e.target.value }} />
      <div class="cluster">
        <Button type="submit" tone="primary" id="ws-save" disabled={!changed || busy === 'rename'}>Save</Button>
      </div>
    </form>
  </Card>

  <Card id="workspace-push">
    <h2 class="h5">Phone pings</h2>
    {#if ping}
      <p class="text-sm text-muted">
        A monitor down, a deploy failed, a server unreachable: each rings every phone subscribed
        to this topic, through {RUNG[ping.rung]}. The topic's random tail is what keeps strangers
        off it — share it like a password.
      </p>
      <div class="cluster gap-lg ws-push">
        <div class="ws-push-qr" aria-label="QR code of the subscribe link">{@html qrSvg(ping.subscribeUrl)}</div>
        <div class="stack text-sm ws-push-facts">
          <div>
            <div class="text-muted">Topic</div>
            <Mono>{ping.topic}</Mono>
          </div>
          <div>
            <div class="text-muted">Server</div>
            <Mono>{ping.url}</Mono>
          </div>
          <ol class="stack gap-2xs ws-push-steps">
            <li>Install the <strong>ntfy</strong> app (Android, iPhone or desktop).</li>
            <li>Scan the code, or add a subscription by hand: topic above, and under
                <em>Use another server</em> the server above.</li>
            <li>Press <strong>Test ping</strong>. The phone shows it at normal priority; a real
                outage rings through do-not-disturb.</li>
          </ol>
          <div class="cluster">
            <Button id="ws-test-ping" treatment="outlined" onclick={testPing} disabled={busy === 'ping'}>Test ping</Button>
            <CopyButton text={ping.subscribeUrl} label="Copy subscribe link" treatment="outlined" />
            <a class="btn outlined" href={ping.subscribeUrl} target="_blank" rel="noopener">Open in ntfy</a>
          </div>
          {#if pinged && pinged !== 'sent'}
            <p class="text-danger" id="ws-test-ping-error">{pinged}</p>
          {/if}
        </div>
      </div>
    {:else if pingError}
      <p class="text-sm text-muted" id="ws-push-refused">{pingError}</p>
    {:else}
      <p class="text-sm text-muted">Loading…</p>
    {/if}
  </Card>

  <Card id="workspace-new">
    <h2 class="h5">Another workspace</h2>
    <p class="text-sm text-muted">A separate fleet with its own members, projects and secrets. You are its owner.</p>
    <form class="cluster" novalidate onsubmit={e => { e.preventDefault(); create() }}>
      <Input id="ws-new-name" name="name" label="" placeholder="Name" aria-label="New workspace name"
             value={newName} oninput={(e) => newName = e.target.value} />
      <Button type="submit" treatment="outlined" id="ws-create" disabled={!newName.trim() || busy === 'create'}>Create workspace</Button>
    </form>
  </Card>

  <article class="card outlined danger stack" id="workspace-delete">
    <h2 class="h5">Delete this workspace</h2>
    <p class="text-sm">
      Deletes <strong>{ws.name}</strong> with every project, environment, app, server record,
      secret and job in it. Machines at a cloud are not destroyed — destroy them first.
      Only an owner can do this. Type the workspace's name to confirm.
    </p>
    <form class="stack" novalidate onsubmit={e => { e.preventDefault(); destroy() }}>
      <Input id="ws-delete-confirm" name="confirm" label="Workspace name" autocomplete="off"
             placeholder={ws.name} value={typed} oninput={(e) => typed = e.target.value} />
      <div class="cluster">
        <Button type="submit" tone="danger" id="ws-delete"
                disabled={typed !== ws.name || busy === 'delete'}>Delete workspace</Button>
      </div>
    </form>
  </article>
{:else}
  <p class="text-sm text-muted">You are not in a workspace.</p>
{/if}

<style>
  .ws-push { align-items: flex-start }
  .ws-push-qr { inline-size: 11rem; max-inline-size: 100%; flex: 0 0 auto }
  .ws-push-qr :global(svg) { display: block; inline-size: 100%; block-size: auto; border-radius: var(--card-radius) }
  .ws-push-facts { flex: 1 1 16rem }
  .ws-push-steps { padding-inline-start: var(--space-3xl) }
</style>
