---
title: Audit trail
---
<script>
  // The forensic table — who did what in this workspace, newest first.
  //
  // **The list is a WINDOW, not a page** (`FJS-D145`). A trail only grows, and
  // it grows at the end a reader starts from, so an offset means something
  // different every second: ask for rows 50–99 a minute after rows 0–49 and
  // whatever arrived in between has pushed the boundary along, serving one row
  // twice and skipping another. On the one screen in this app whose job is to
  // be complete, that is the wrong failure to have quietly.
  //
  // So the tether takes the first window and `more()` grows it from the far
  // edge — by the sort keys of the last row it holds, which is a position
  // rather than a count. The rows live in the tether; this file holds no array
  // of its own, so a row cannot be in the window and not on the screen.
  //
  // It was `service.find(…, { limit: 50 })` — a hard cap with nothing saying
  // rows were missing, which reads exactly like a trail that only has 50.
  import { session } from '../../../session.js'
  import { audit } from '../../../resources/AuditEvent.mesa'
  import { at } from '../../../datetime.js'
  import Button from '@frontierjs/ui/components/forms/Button.mesa'
  import Input  from '@frontierjs/ui/components/forms/Input.mesa'
  import Table  from '@frontierjs/ui/components/display/Table.mesa'

  $: session.workspaceId

  let growing = false
  let filter  = ''

  // The window's own limit. Named once: the tether states it and `more()`
  // reuses the last load's directives, so a second number here would be a
  // window that grows in a different size than it started.
  const PAGE = 50
  const list = audit.tethered({ state: 'local', directives: { limit: PAGE } })
  const rows = () => list.rows

  // The service filters; the browser does not. A page-local .filter() would
  // hide rows that are simply past the far edge and call that a result.
  const load = () => list.apply(filter ? { subjectType: filter } : {})

  // Growing states no query: the cursor was minted under the last load's
  // ordering and names no position in another one, so a new filter is an
  // `apply()` and this is unable to become one.
  async function grow() {
    growing = true
    await list.more()
    growing = false
  }

  $: session.workspaceId, () => list.reload()

  const AUDIT_COLUMNS = [
    { name: 'when',    label: 'When' },
    { name: 'action',  label: 'Action' },
    { name: 'subject', label: 'Subject' },
    { name: 'actor',   label: 'Actor' },
  ]
</script>

<p class="text-body">
  Who did what in this workspace. Written by the application after every mutation, and <strong>append-only</strong> — the service answers 405 to anything that would edit it.
</p>

<!-- A 403 is the service saying this caller is not an admin — the correct
     answer, and worth showing rather than hiding the page. -->
{#if list.error}
  <article class="alert danger">
    <div class="alert-content">{list.error.message}</div>
  </article>
{/if}

<form class="cluster" onsubmit|preventDefault={load}>
  <label class="visually-hidden" for="audit-filter">Subject type</label>
  <Input id="audit-filter" style="--field-inline-size: 14rem"
         placeholder="subject type, e.g. servers" bind:value={filter} />
  <Button treatment="outlined" type="submit">Filter</Button>
</form>

{#if list.loading}
  <p class="text-sm text-muted">Loading…</p>
{:else if !rows().length}
  <article class="alert info">
    <div class="alert-content">Nothing recorded yet — the trail fills as work happens.</div>
  </article>
{:else}
  <Table id="audit-rows" columns={AUDIT_COLUMNS} rows={rows()} striped hover={false}>
    {#snippet row(event)}
      <tr>
        <td class="text-sm text-muted">{at(event.createdAt)}</td>
        <td><code>{event.action}</code></td>
        <td>{event.subjectType} <span class="text-sm text-muted">{event.subjectId?.slice(0, 8)}</span></td>
        <td class="text-sm">{event.actorType} <span class="text-muted">{event.actorId?.slice(0, 8) ?? 'system'}</span></td>
      </tr>
    {/snippet}
  </Table>

  <!-- The count is what this window holds, never a total: the keyset path runs
       no COUNT, and printing the page length as a total is how a capped list
       claims to be complete. What the reader needs is whether there is more,
       which is the button being there. -->
  <div class="cluster" id="audit-window">
    <span class="text-sm text-muted">{rows().length} events</span>
    {#if list.hasMore}
      <Button id="audit-more" treatment="outlined" disabled={growing} onclick={grow}>
        {growing ? 'Loading…' : 'Load more'}
      </Button>
    {:else}
      <span class="text-sm text-muted" id="audit-end">— end of trail</span>
    {/if}
  </div>
{/if}
