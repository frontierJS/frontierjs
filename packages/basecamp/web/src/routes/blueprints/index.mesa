---
title: Blueprints
---
<script>
  // The mock's BlueprintMarketplaceView — the deployment catalog.
  //
  // Two things separate this screen from every other one in the app:
  //
  //   It belongs to NO WORKSPACE. `Blueprint` is `@@tenant(none)`, so the
  //   switcher has no bearing on what is here and this screen does not reload
  //   when it moves. Every other list in this app is keyed on
  //   `session.workspaceId`; this one deliberately is not, and the absence is
  //   the thing to notice rather than an omission. Deploy is the one part that
  //   lands IN a workspace — the switcher's, read when the drawer opens — so
  //   a person with no membership sees the catalog and no Deploy button.
  //
  //   Reading it is VISITOR(1) and writing it is the hub tier. A person with no
  //   membership anywhere can browse the catalog — which is what somebody who
  //   has just accepted an invitation is — and only a sysadmin can change it.
  //   The write controls are rendered for a sysadmin only; the refusal is the
  //   server's either way, which is where a refusal has to live.
  //
  // ─── Deploying one ──────────────────────────────────────────────────────
  //
  // Three calls, each the one an app described by hand would make:
  // `apps.fromBlueprint` makes the app (and records which blueprint), `place`
  // puts it on a machine, and `deployments.create` queues its first release.
  // The last two are optional — an app with nowhere to run is still an app,
  // and its own screen is where it gets placed. A failure after the app exists
  // lands on that screen with the reason, rather than leaving a person to
  // wonder whether pressing Deploy again makes a second one.
  import { session } from '../../session.js'
  import { goto } from '@frontierjs/sierra/router'
  import Blueprint, { blueprints } from '../../resources/Blueprint.mesa'
  import { apps }         from '../../resources/App.mesa'
  import { environments } from '../../resources/Environment.mesa'
  import { projects }     from '../../resources/Project.mesa'
  import { servers }      from '../../resources/Server.mesa'
  import { deployments }  from '../../resources/Deployment.mesa'
  import { schemaFor, buildFieldRules } from '@frontierjs/sierra/resource'

  import Badge      from '@frontierjs/ui/components/display/Badge.mesa'
  import Button     from '@frontierjs/ui/components/forms/Button.mesa'
  import Callout    from '@frontierjs/ui/components/display/Callout.mesa'
  import Card       from '@frontierjs/ui/components/layout/Card.mesa'
  import Checkbox   from '@frontierjs/ui/components/forms/Checkbox.mesa'
  import Drawer     from '@frontierjs/ui/components/overlay/Drawer.mesa'
  import Select     from '@frontierjs/ui/components/forms/Select.mesa'
  import { toasts } from '@frontierjs/ui/stores/toastStore.js'
  import EmptyState from '@frontierjs/ui/components/display/EmptyState.mesa'
  import Input      from '@frontierjs/ui/components/forms/Input.mesa'
  import Pill       from '@frontierjs/ui/components/display/Pill.mesa'
  import Table      from '@frontierjs/ui/components/display/Table.mesa'

  $: session.user
  // Watched for the Deploy button alone; nothing on this screen reloads when
  // it moves (see the header).
  $: session.workspaceId

  let rows       = []
  let categories = []
  let selected   = null
  let selRow     = null      // the record view behind it
  let unwatchSel = null
  let error      = null
  let loading    = true
  let category   = ''      // '' = every category
  let search     = ''
  let showGone   = false

  async function load() {
    error = null; loading = true
    try {
      // `includeDeprecated` is a filter the service reads off the query string,
      // not a client-side one: a withdrawn blueprint is out of the list by
      // default and still readable by id, because the apps built from it point
      // at it.
      const query = showGone ? { includeDeprecated: 'true' } : {}
      const list  = await blueprints.service.find(query, { limit: 200 })
      rows        = list.data
      categories  = (await blueprints.service.invoke('categories', null)).categories
    } catch (e) {
      error = e.message
    } finally {
      loading = false
    }
  }

  load()
  // No `$: session.workspaceId` here, and that is the point — see the header.
  $: showGone, () => load()

  // `categories` is derived from the rows on the server, so a blueprint added
  // in a new category puts a new chip here without a migration. The count is
  // the live one; it does not move with the search box, which filters what is
  // ON SCREEN rather than what exists.
  $: shown = rows.filter(b => {
    if (category && b.category !== category) return false
    if (!search) return true
    const q = search.toLowerCase()
    return b.name.toLowerCase().includes(q)
        || b.description.toLowerCase().includes(q)
        || b.category.toLowerCase().includes(q)
  })

  /** The expanded blueprint, watched rather than read (`FJS-518`).
   *
   *  `blueprints.get()` answers the row WITH its params, so this is a COMPOSED
   *  view: a push carries the row alone and watching the node itself would
   *  empty the parameter table at the first announcement (`FJS-533`). One view
   *  at a time — opening another row re-keys it, closing releases it.
   */
  function watchSelected(id) {
    unwatchSel?.(); selRow?.release()
    unwatchSel = selRow = null
    if (id == null) { selected = null; return }
    selRow = blueprints.record(id, { composed: true })
    unwatchSel = selRow.subscribe(v => { selected = v })
    return selRow.ready
  }

  $.onDestroy(() => { unwatchSel?.(); selRow?.release() })

  /** The row without the params composed onto it. The edit form patches what
   *  it is handed, `blueprints.patch` refuses `params` by name (they are saved
   *  whole with `setParams`), and whether the form counted them as changed
   *  depended on which read it last diffed against — so the edit failed on
   *  some runs and not others. */
  const rowOf = ({ params: _params, ...row }) => row

  async function open(bp) {
    error = null
    if (selected?.id === bp.id) return watchSelected(null)
    try {
      await watchSelected(bp.id)
    } catch (e) {
      error = e.message
    }
  }

  async function withdraw(bp) {
    error = null
    try {
      await blueprints.service.remove(bp.id)
      if (selected?.id === bp.id) watchSelected(null)
      await load()
    } catch (e) {
      // A 409 lands here when somebody else edited the row since this screen
      // read it — `revision` is @version, and the withdrawal carries the one it
      // read. Re-reading is the way out and the sentence says which two
      // revisions disagreed.
      error = e.message
    }
  }

  const PARAM_COLUMNS = [
    { name: 'key',     label: 'Variable' },
    { name: 'label',   label: 'Label' },
    { name: 'default', label: 'Default' },
    { name: 'rule',    label: 'Rule' },
  ]

  // ─── Curating the catalog (sysadmin) ─────────────────────────────────
  // The row through its default form. `deprecatedAt` is Withdraw's, and the
  // slug is refused on a patch — it is the key a URL is built from.
  let authoring = null    // 'new' | the blueprint being edited
  $: isAdmin = !!session.user?.isSystemAdmin

  function authored(row) {
    const made = authoring === 'new'
    authoring = null
    toasts.success(made ? `${row.name} added to the catalog. Give it parameters from its details.` : `${row.name} saved`)
    load()
    if (made) watchSelected(row.id)
  }

  // The parameters are an ORDERED list replaced whole by `setParams`, so this
  // edits a copy and sends the sequence; the order sent is the order stored.
  let params      = null   // the draft, while editing
  let paramsError = null
  let savingParams = false

  // `BlueprintParam` has no resource of its own — `setParams` is the only
  // write — so its rules are read off the registered schema, $refs followed.
  $: generators = (buildFieldRules(schemaFor('BlueprintParam'))?.generate?.enum ?? []).filter(Boolean)

  function editParams() {
    paramsError = null
    params = (selected.params ?? []).map(({ key, label, hint, defaultValue, required, secret, generate }) =>
      ({ key, label, hint: hint ?? '', defaultValue: defaultValue ?? '', required, secret, generate: generate ?? '' }))
  }

  const setParam  = (i, field, v) => params = params.map((p, j) => j === i ? { ...p, [field]: v } : p)
  const addParam  = () => params = [...params, { key: '', label: '', hint: '', defaultValue: '', required: false, secret: false, generate: '' }]
  const dropParam = (i) => params = params.filter((_, j) => j !== i)
  function moveParam(i, d) {
    const to = i + d
    if (to < 0 || to >= params.length) return
    const next = [...params]
    next.splice(to, 0, ...next.splice(i, 1))
    params = next
  }

  async function saveParams() {
    paramsError = null; savingParams = true
    try {
      await blueprints.service.invoke('setParams', selected.id, {
        params: params.map(p => ({
          ...p, hint: p.hint || null, defaultValue: p.defaultValue || null, generate: p.generate || null,
        })),
      })
      params = null
      toasts.success('Parameters saved')
      await selRow?.refresh()
    } catch (e) {
      paramsError = e.message
    } finally {
      savingParams = false
    }
  }

  // ─── Deploy ──────────────────────────────────────────────────────────
  let deploying   = null     // the blueprint whose drawer is open
  let deployForm  = null     // { environmentId, name, serverId, values }
  let envOptions  = []
  let srvOptions  = []
  let deployError = null
  let sending     = false

  async function openDeploy(bp) {
    deployError = null
    deploying   = bp
    deployForm  = { environmentId: '', name: bp.name, serverId: '',
                    values: Object.fromEntries(bp.params.map(p => [p.key, ''])) }
    try {
      // The workspace's own environments and machines — the catalog is shared,
      // where it lands is not.
      const [envs, prjs, srvs] = await Promise.all([
        environments.service.find({}, { limit: 200 }),
        projects.service.find({}, { limit: 200 }),
        servers.service.find({}, { limit: 200 }),
      ])
      const projectName = Object.fromEntries(prjs.data.map(p => [p.id, p.name]))
      envOptions = envs.data.map(e => ({ value: e.id, label: `${projectName[e.projectId] ?? '—'} / ${e.name}` }))
      srvOptions = srvs.data.filter(x => x.status === 'online')
                            .map(x => ({ value: x.id, label: x.name }))
      if (envOptions.length === 1) deployForm = { ...deployForm, environmentId: envOptions[0].value }
    } catch (e) {
      deployError = e.message
    }
  }

  const setValue = (key, v) => deployForm = { ...deployForm, values: { ...deployForm.values, [key]: v } }

  async function deploy() {
    deployError = null; sending = true
    let made = null
    try {
      made = await apps.service.invoke('fromBlueprint', null, {
        blueprintId:   deploying.id,
        environmentId: deployForm.environmentId,
        name:          deployForm.name,
        values:        deployForm.values,
      })
    } catch (e) {
      deployError = e.message
      sending = false
      return
    }
    // The app exists from here on, so anything after this goes to its screen
    // with the reason rather than back to a form that would make a second one.
    let note = `${made.name} created`
    if (deployForm.serverId) {
      try {
        await apps.service.invoke('place', made.id, { serverId: deployForm.serverId })
        await deployments.service.create({ appId: made.id })
        note = `${made.name} created — its first release is queued`
      } catch (e) {
        toasts.error(`${made.name} was created, but not released: ${e.message}`)
        note = null
      }
    }
    if (note) toasts.success(note)
    sending = false
    deploying = null
    goto(`/apps/${made.id}/`)
  }

  function storage(bp) {
    return bp.volumePath ?? 'stateless'
  }
</script>

<div class="section-header">
  <h1>Blueprints</h1>
  <span class="cluster">
    <span class="text-sm text-muted">Pre-configured applications. The same catalog in every workspace.</span>
    {#if isAdmin}
      <Button variant="primary" id="new-blueprint" onclick={() => authoring = 'new'}>New blueprint</Button>
    {/if}
  </span>
</div>

<Drawer open={!!authoring} title={authoring === 'new' ? 'New blueprint' : authoring ? `Edit ${authoring.name}` : ''}
        onclose={() => authoring = null}>
  {#if authoring === 'new'}
    <Blueprint except={['deprecatedAt']} oncancel={() => authoring = null} ondone={authored}
               submitLabel="Add to catalog" submitId="blueprint-save" />
  {:else if authoring}
    <Blueprint record={authoring} except={['deprecatedAt', 'slug']} oncancel={() => authoring = null}
               ondone={authored} submitId="blueprint-save" />
  {/if}
</Drawer>

{#if error}
  <article class="alert danger" id="screen-error">
    <div class="alert-content">{error}</div>
  </article>
{/if}

<Drawer open={!!deploying} title={deploying ? `Deploy ${deploying.name}` : ''} onclose={() => deploying = null}>
  {#if deploying && deployForm}
    <div class="stack" id="blueprint-deploy">
      {#if deployError}
        <article class="alert danger" id="deploy-error"><div class="alert-content">{deployError}</div></article>
      {/if}
      {#if deploying.notes}
        <Callout tone="info" title="Before you deploy this">{deploying.notes}</Callout>
      {/if}
      <Select id="deploy-environment" label="Environment" value={deployForm.environmentId}
              placeholder="Choose an environment…" options={envOptions}
              onchange={(e) => deployForm = { ...deployForm, environmentId: e.target.value }} />
      <Input id="deploy-name" label="App name" value={deployForm.name}
             oninput={(e) => deployForm = { ...deployForm, name: e.target.value }} />
      <Select id="deploy-server" label="Run it on" value={deployForm.serverId}
              placeholder="Place it later" options={srvOptions}
              hint={srvOptions.length ? 'Picking a machine queues the first release too.' : 'No machine in this workspace is online, so the app is made and placed later.'}
              onchange={(e) => deployForm = { ...deployForm, serverId: e.target.value }} />

      {#each deploying.params as p}
        <!-- Each lands as a variable on the app, a secret one encrypted. A
             blank field takes the default, then a minted value where the
             blueprint says how to mint one. -->
        <Input id={`deploy-param-${p.key}`} label={`${p.label}${p.required && !p.generate && !p.defaultValue ? ' *' : ''}`}
               type={p.secret ? 'password' : 'text'} autocomplete="off"
               value={deployForm.values[p.key]}
               placeholder={p.generate ? 'Generated if left blank' : (p.defaultValue ?? '')}
               hint={p.hint ? `${p.key} — ${p.hint}` : p.key}
               oninput={(e) => setValue(p.key, e.target.value)} />
      {/each}

      <div class="cluster">
        <Button variant="primary" id="deploy-save" disabled={sending || !deployForm.environmentId}
                onclick={deploy}>{deployForm.serverId ? 'Create and release' : 'Create app'}</Button>
        <Button variant="ghost" onclick={() => deploying = null}>Cancel</Button>
      </div>
    </div>
  {/if}
</Drawer>

<div class="cluster" id="blueprint-filters">
  <label class="visually-hidden" for="blueprint-search">Search blueprints</label>
  <Input id="blueprint-search" placeholder="Search blueprints…" value={search}
         oninput={(e) => search = e.target.value} />

  <button type="button" class={category === '' ? 'pill' : 'pill muted'}
          id="category-all" onclick={() => category = ''}>
    All ({rows.length})
  </button>
  {#each categories as c}
    <button type="button" class={category === c.name ? 'pill' : 'pill muted'}
            onclick={() => category = category === c.name ? '' : c.name}>
      {c.name} ({c.count})
    </button>
  {/each}

  <label class="check">
    <input type="checkbox" checked={showGone} onchange={(e) => showGone = e.target.checked} />
    <span class="text-sm text-muted">Show withdrawn</span>
  </label>
</div>

{#if loading}
  <p class="text-sm text-muted">Loading…</p>
{:else if !shown.length}
  <EmptyState title="Nothing matches">
    {rows.length
      ? 'No blueprint in this catalog matches that search.'
      : 'This installation has no catalog yet. A sysadmin curates it.'}
  </EmptyState>
{:else}
  <div class="grid" id="blueprint-grid">
    {#each shown as bp}
      <Card>
        <div class="section-header">
          <h2 class="h4">
            {#if bp.icon}<span aria-hidden="true">{bp.icon}</span> {/if}{bp.name}
          </h2>
          <Badge tone="muted">{bp.version}</Badge>
        </div>

        <span class="cluster">
          <Pill tone="info">{bp.category}</Pill>
          {#if bp.deprecatedAt}
            <!-- Withdrawn, not deleted: an app built from it still points here. -->
            <Pill tone="warning">withdrawn</Pill>
          {/if}
        </span>

        <p class="text-sm text-muted">{bp.description}</p>

        <div class="cluster text-sm text-muted">
          <span>:{bp.port ?? '—'}</span>
          <span>{storage(bp)}</span>
          <span>{bp.params.filter(p => p.required).length} required</span>
        </div>

        <div class="cluster">
          <Button variant="outlined" onclick={() => open(bp)}>
            {selected?.id === bp.id ? 'Hide details' : 'Details'}
          </Button>
          {#if session.workspaceId && !bp.deprecatedAt}
            <Button variant="primary" aria-label={`Deploy ${bp.name}`} onclick={() => openDeploy(bp)}>Deploy</Button>
          {/if}
          {#if session.user?.isSystemAdmin && !bp.deprecatedAt}
            <Button variant="ghost" aria-label={`Withdraw ${bp.name}`}
                    data-confirm={`${bp.name} is no longer offered to any workspace. There is no button to bring it back.`}
                    data-confirm-title="Withdraw this blueprint?" data-confirm-label="Withdraw"
                    onclick={() => withdraw(bp)}>Withdraw</Button>
          {/if}
        </div>
      </Card>
    {/each}
  </div>
{/if}

{#if selected}
  <Card id="blueprint-detail">
    <div class="section-header">
      <h2 class="h4">{selected.name} {selected.version}</h2>
      <span class="cluster">
        {#if isAdmin}
          <Button variant="outlined" id="blueprint-edit" onclick={() => authoring = rowOf(selected)}>Edit</Button>
          {#if !params}
            <Button variant="outlined" id="blueprint-params-edit" onclick={editParams}>Edit parameters</Button>
          {/if}
        {/if}
        <Button variant="ghost" onclick={() => { params = null; watchSelected(null) }}>Close</Button>
      </span>
    </div>

    <pre class="code" id="blueprint-image"><code>{selected.image}</code></pre>

    <dl class="datalist">
      <div><dt>Type</dt><dd>{selected.appType}</dd></div>
      <div><dt>Port</dt><dd>{selected.port ?? 'none'}</dd></div>
      <div><dt>Storage</dt><dd>{storage(selected)}</dd></div>
      <div><dt>Health check</dt><dd>{selected.healthCheck ?? 'none'}</dd></div>
      <div><dt>Limits</dt><dd>{selected.cpuLimit ?? '—'} CPU · {selected.memLimitMb != null ? `${selected.memLimitMb} MiB` : '—'} memory</dd></div>
    </dl>

    {#if params}
      <div class="stack" id="blueprint-params-editor">
        {#if paramsError}
          <article class="alert danger" id="params-error"><div class="alert-content">{paramsError}</div></article>
        {/if}
        {#each params as p, i}
          <fieldset class="stack" data-param-row>
            <legend class="text-sm">Parameter {i + 1}</legend>
            <div class="cluster">
              <Input id={`param-key-${i}`} label="Variable" value={p.key} placeholder="REDIS_PASSWORD"
                     oninput={(e) => setParam(i, 'key', e.target.value)} />
              <Input id={`param-label-${i}`} label="Label" value={p.label}
                     oninput={(e) => setParam(i, 'label', e.target.value)} />
              <Input id={`param-default-${i}`} label="Default" value={p.defaultValue}
                     oninput={(e) => setParam(i, 'defaultValue', e.target.value)} />
            </div>
            <Input id={`param-hint-${i}`} label="Hint" value={p.hint}
                   oninput={(e) => setParam(i, 'hint', e.target.value)} />
            <div class="cluster">
              <Checkbox id={`param-required-${i}`} label="Required" checked={p.required}
                        onchange={(on) => setParam(i, 'required', on)} />
              <Checkbox id={`param-secret-${i}`} label="Secret" checked={p.secret}
                        onchange={(on) => setParam(i, 'secret', on)} />
              <Select id={`param-generate-${i}`} label="" aria-label="Generate a value" value={p.generate}
                      placeholder="Typed by a person" options={generators}
                      onchange={(e) => setParam(i, 'generate', e.target.value)} />
              <Button variant="ghost" aria-label={`Move parameter ${i + 1} up`} disabled={i === 0} onclick={() => moveParam(i, -1)}>↑</Button>
              <Button variant="ghost" aria-label={`Move parameter ${i + 1} down`} disabled={i === params.length - 1} onclick={() => moveParam(i, 1)}>↓</Button>
              <Button variant="ghost" aria-label={`Remove parameter ${i + 1}`} onclick={() => dropParam(i)}>Remove</Button>
            </div>
          </fieldset>
        {/each}
        <div class="cluster">
          <Button variant="outlined" id="param-add" onclick={addParam}>Add parameter</Button>
          <Button variant="primary" id="params-save" disabled={savingParams} onclick={saveParams}>Save parameters</Button>
          <Button variant="ghost" onclick={() => params = null}>Cancel</Button>
        </div>
      </div>
    {:else if !selected.params.length}
      <p class="text-sm text-muted">This blueprint takes no parameters.</p>
    {:else}
      <Table id="blueprint-params" columns={PARAM_COLUMNS} rows={selected.params} striped hover={false}>
        {#snippet row(p)}
          <tr>
            <td><code>{p.key}</code></td>
            <td class="text-sm">{p.label}</td>
            <!-- A secret's DEFAULT is not a secret: it is what ships with the
                 catalog, never anybody's value. What a person types goes to a
                 Secret, which is @encrypted and never read back. -->
            <td class="text-sm text-muted">{p.defaultValue || '—'}</td>
            <td>
              <span class="cluster">
                {#if p.required}<Pill tone="danger">required</Pill>{/if}
                {#if p.secret}<Pill tone="warning">secret</Pill>{/if}
                {#if p.generate}<Pill tone="success">{p.generate}</Pill>{/if}
              </span>
            </td>
          </tr>
          {#if p.hint}
            <tr><td colspan="4" class="text-sm text-muted">{p.hint}</td></tr>
          {/if}
        {/snippet}
      </Table>
    {/if}

    {#if selected.notes}
      <Callout tone="info" title="Before you deploy this">{selected.notes}</Callout>
    {/if}

    {#if (selected.links ?? []).length}
      <div class="cluster">
        {#each selected.links as link}
          <a href={link.url} target="_blank" rel="noreferrer">{link.label} ↗</a>
        {/each}
      </div>
    {/if}
  </Card>
{/if}
