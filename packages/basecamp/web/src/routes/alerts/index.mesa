---
title: Alerts
---
<script>
  // The mock's AlertRulesView. `AlertRule` and `AlertEvent` had been in the
  // schema with no API at all until 2026-08-06.
  //
  // What this screen does NOT do is decide that a rule has been breached.
  // Nothing evaluates rules yet — that needs whatever measures, and inventing
  // it in the browser would be a page-out fired from the client's idea of the
  // truth. So an event list that is empty is honest, and says so.
  import { session } from '../../session.js'
  import { messageFor } from '../../errors.js'
  import AlertRule, { alerts } from '../../resources/AlertRule.mesa'
  import { channels } from '../../resources/NotificationChannel.mesa'
  import { at }       from '../../datetime.js'

  import Alert from '@frontierjs/ui/components/feedback/Alert.mesa'
  import Badge      from '@frontierjs/ui/components/display/Badge.mesa'
  import Button     from '@frontierjs/ui/components/forms/Button.mesa'
  import Callout    from '@frontierjs/ui/components/display/Callout.mesa'
  import Card       from '@frontierjs/ui/components/layout/Card.mesa'
  import EmptyState from '@frontierjs/ui/components/display/EmptyState.mesa'
  import Pill       from '@frontierjs/ui/components/display/Pill.mesa'
  import Select     from '@frontierjs/ui/components/forms/Select.mesa'
  import DropdownMenu from '@frontierjs/ui/components/overlay/DropdownMenu.mesa'
  import DropdownItem from '@frontierjs/ui/components/overlay/DropdownItem.mesa'
  import { toasts } from '@frontierjs/ui/stores/toastStore.js'
  import { page } from '@frontierjs/sierra/router'

  $: session.workspaceId

  let rows     = []
  let events   = {}      // ruleId → recent events
  let delivery = {}      // ruleId → attached channel rows
  let allChannels = []
  let picked   = {}      // ruleId → the channel id the picker is showing
  let error    = null
  let loading  = true
  let busy     = null
  let creating = page.query?.new !== undefined
  // ⌘K's New … entries land here with ?new, on this route or from another.
  $: page.query, () => { if (page.query?.new !== undefined) creating = true }
  let editing  = null    // the rule id whose card is showing its form
  let metric   = {}      // ruleId → the series it watches, or null

  async function load() {
    error = null; loading = true
    try {
      rows = (await alerts.service.find({}, { limit: 100 })).data
      // Where each rule delivers. `find` answers the rule rows; only `get`
      // pays for the join, so the list is one request plus one per rule —
      // acceptable at this size, and it is what makes "reaches nobody"
      // sayable at a glance rather than after a click.
      const full = await Promise.all(rows.map(r => alerts.service.get(r.id)))
      delivery = Object.fromEntries(full.map(r => [r.id, r.channels ?? []]))
      // Whether the metric this rule watches EXISTS. `metricName` is not a
      // foreign key — a series is minted by the first scrape that sees it, so
      // a rule may legitimately precede it — and the cost is a rule watching a
      // typo, which never fires and looks exactly like a threshold nobody
      // crossed. The server answers it because only the server can see the
      // series; the card says it because otherwise nobody ever finds out.
      metric = Object.fromEntries(full.map(r => [r.id, r.series ?? null]))
      allChannels = (await channels.service.find({}, { limit: 200 })).data
    } catch (e) {
      error = e.message
    } finally {
      loading = false
    }
  }

  load()
  $: session.workspaceId, () => load()

  const READS = new Set(['get', 'find', 'events'])
  const off = alerts.service.on('*', (method, row) => {
    if (READS.has(method) || !row?.id) return
    load()
  })
  $.onDestroy(off)

  // Loaded on demand rather than for every rule at once: a rule that has never
  // fired is the common case, and eight requests to prove that is a waste.
  async function showEvents(rule) {
    busy = rule.id
    try {
      const raw = await alerts.service.invoke('events', rule.id)
      events = { ...events, [rule.id]: Array.isArray(raw) ? raw : raw?.data ?? [] }
    } catch (e) {
      error = e.message
    } finally {
      busy = null
    }
  }

  async function attach(rule) {
    const channelId = picked[rule.id]
    if (!channelId) return
    error = null; busy = rule.id
    try {
      const updated = await alerts.service.invoke('attachChannel', rule.id, { channelId })
      delivery = { ...delivery, [rule.id]: updated.channels ?? [] }
      picked   = { ...picked, [rule.id]: '' }
    } catch (e) {
      error = messageFor(alerts, e)
    } finally {
      busy = null
    }
  }

  async function detach(rule, channelId) {
    error = null; busy = rule.id
    try {
      const updated = await alerts.service.invoke('detachChannel', rule.id, { channelId })
      delivery = { ...delivery, [rule.id]: updated.channels ?? [] }
    } catch (e) {
      error = e.message
    } finally {
      busy = null
    }
  }

  // The default form saves through the resource; this page only closes the
  // form and re-reads, because a rule's card is composed from three reads.
  async function created(rule) {
    toasts.success(`${rule?.name ?? 'Rule'} created`)
    creating = false
    await load()
  }

  async function saved(rule) {
    toasts.success(`${rule?.name ?? 'Rule'} saved`)
    editing = null
    await load()
  }

  async function toggle(rule) {
    error = null; busy = rule.id
    try {
      replaceRow(await alerts.service.patch(rule.id, { isActive: !rule.isActive }))
    } catch (e) {
      error = messageFor(alerts, e)
    } finally {
      busy = null
    }
  }

  // A snooze is asked for as a duration; the server turns it into an instant
  // on its own clock, which is the one the evaluator compares against.
  const SNOOZES = [
    { minutes: 60,        label: '1 hour' },
    { minutes: 4 * 60,    label: '4 hours' },
    { minutes: 24 * 60,   label: '1 day' },
    { minutes: 7 * 24 * 60, label: '1 week' },
  ]

  // A past `snoozedUntil` is not a snooze — nothing clears the column when one
  // runs out — so the card asks the same question the evaluator does.
  const snoozed = (rule) => Date.parse(rule.snoozedUntil ?? '') > Date.now()

  function replaceRow(updated) {
    const i = rows.findIndex(r => r.id === updated.id)
    if (i >= 0) rows = [...rows.slice(0, i), { ...rows[i], ...updated }, ...rows.slice(i + 1)]
  }

  async function snooze(rule, s) {
    error = null; busy = rule.id
    try {
      replaceRow(await alerts.service.invoke('snooze', rule.id, { minutes: s.minutes }))
      toasts.success(`${rule.name} snoozed for ${s.label}`)
    } catch (e) {
      error = messageFor(alerts, e)
    } finally {
      busy = null
    }
  }

  async function unsnooze(rule) {
    error = null; busy = rule.id
    try {
      replaceRow(await alerts.service.invoke('unsnooze', rule.id))
    } catch (e) {
      error = messageFor(alerts, e)
    } finally {
      busy = null
    }
  }

  async function acknowledge(rule, event) {
    error = null; busy = rule.id
    try {
      await alerts.service.invoke('acknowledge', rule.id, { eventId: event.id })
      await showEvents(rule)
    } catch (e) {
      error = e.message
    } finally {
      busy = null
    }
  }

  // A person closing an incident by hand — the evaluator closes one only on
  // `recovered`, and an operator may know better (a machine retired, say).
  async function resolve(rule, event) {
    error = null; busy = rule.id
    try {
      await alerts.service.invoke('resolve', rule.id, { eventId: event.id })
      await showEvents(rule)
    } catch (e) {
      error = e.message
    } finally {
      busy = null
    }
  }

  async function remove(rule) {
    error = null; busy = rule.id
    try {
      await alerts.service.remove(rule.id)
      toasts.success(`${rule.name} deleted`)
      await load()
    } catch (e) {
      error = e.message
    } finally {
      busy = null
    }
  }

  $: severities = alerts.fields?.severity?.enum ?? []
  $: operators  = alerts.fields?.operator?.enum ?? []

  const TONE = { critical: 'danger', warning: 'warning', info: 'info' }
  // How the four operators read. Not a second vocabulary: the LIST comes from
  // the schema above, and this only spells each word — a value missing here
  // renders as the enum's own name rather than as blank.
  const SYMBOL = { gt: '>', gte: '≥', lt: '<', lte: '≤' }
</script>

<div class="section-header">
  <h1>Alerts</h1>
  <Button variant="primary" id="new-alert" onclick={() => creating = !creating}>
    {creating ? 'Cancel' : 'New rule'}
  </Button>
</div>

<Callout tone="info" title="Evaluated once a minute, against the metric store">
  A rule watches a series by name. The evaluator reads it on the server — never here, because
  a rule that fired from the browser's view of the fleet would be theater — and fires when the
  reading has held past its threshold for the whole duration.
</Callout>

{#if error}
  <!-- id'd because the shell's notice bar is also `.alert.danger`: a check
       looking for "the screen reported a refusal" would otherwise match a
       fleet notice and pass, or fail, for reasons this screen never caused. -->
  <Alert tone="danger" id="screen-error">{error}</Alert>
{/if}

{#if creating}
  <!-- The model's default form: every column, the enums from the schema and
       each default already in place, so a rule states only what differs. -->
  <Card>
    <AlertRule method="create" submitLabel="Create rule" submitId="alert-create-save"
               oncancel={() => creating = false} ondone={created} />
  </Card>
{/if}

{#if loading}
  <p class="text-sm text-muted">Loading…</p>
{:else if !rows.length}
  <EmptyState title="No alert rules">
    Nothing in this workspace is being watched yet.
  </EmptyState>
{:else}
  <div class="stack" id="alert-list">
    {#each rows as rule}
      <Card>
        <div class="section-header">
          <h2 class="h4">{rule.name}</h2>
          <span class="cluster">
            <Pill tone={TONE[rule.severity] ?? ''}>{rule.severity}</Pill>
            {#if !rule.isActive}<Badge tone="muted">paused</Badge>{/if}
            {#if snoozed(rule)}
              <Badge tone="warning" data-snoozed={rule.id}>snoozed until {at(rule.snoozedUntil)}</Badge>
            {/if}
          </span>
        </div>

        {#if editing === rule.id}
          <AlertRule record={rule} submitId={`alert-edit-save-${rule.id}`}
                     oncancel={() => editing = null} ondone={saved} />
        {/if}

        {#if rule.description}<p class="text-sm">{rule.description}</p>{/if}

        <dl class="facts">
          <dt>Metric</dt><dd><code>{rule.metricName}</code></dd>
          <dt>Condition</dt>
          <dd><code>{SYMBOL[rule.operator] ?? rule.operator} {rule.threshold}{rule.forMinutes ? ` for ${rule.forMinutes}m` : ''}</code></dd>
          <dt>Series</dt>
          <dd>
            {#if metric[rule.id] === null}
              <Badge tone="warning">nothing writes this metric</Badge>
            {:else if metric[rule.id]?.stale}
              <Badge tone="warning">last seen {at(metric[rule.id].lastSeenAt)}</Badge>
            {:else if metric[rule.id]}
              <Badge tone="success">live</Badge>
            {:else}
              <span class="text-sm text-muted">—</span>
            {/if}
          </dd>
        </dl>

        <!-- Where this rule delivers. A rule with no channel fires into a
             table nobody is watching, so it says so rather than showing an
             empty row: that was the state EVERY rule was in until channels
             existed, and `AlertRule.channels` was a Json array of ids that
             could not have told you. -->
        <div class="cluster" data-delivery={rule.id}>
          <span class="text-sm text-muted">Delivers to</span>
          {#if (delivery[rule.id] ?? []).length}
            {#each delivery[rule.id] as link}
              <span class="cluster">
                <Pill>{link.channel?.name ?? link.channelId}</Pill>
                <Button variant="ghost" disabled={busy === rule.id}
                        aria-label={`Stop delivering ${rule.name} to ${link.channel?.name}`}
                        onclick={() => detach(rule, link.channelId)}>Remove</Button>
              </span>
            {/each}
          {:else}
            <Badge tone="warning">nobody</Badge>
          {/if}
        </div>

        {#if allChannels.length}
          <div class="cluster">
            <label class="visually-hidden" for={`attach-${rule.id}`}>Add a channel</label>
            <Select id={`attach-${rule.id}`} placeholder="Add a channel…"
                    value={picked[rule.id] ?? ''}
                    options={allChannels
                      .filter(c => !(delivery[rule.id] ?? []).some(l => l.channelId === c.id))
                      .map(c => ({ value: c.id, label: c.name }))}
                    onchange={(e) => picked = { ...picked, [rule.id]: e.target.value }} />
            <Button variant="outlined" disabled={busy === rule.id || !picked[rule.id]}
                    onclick={() => attach(rule)}>Attach</Button>
          </div>
        {/if}

        {#if events[rule.id]}
          {#if events[rule.id].length}
            <ul class="stack">
              {#each events[rule.id] as ev}
                <li class="cluster">
                  <Pill tone={ev.status === 'resolved' ? 'muted' : TONE[ev.severity] ?? ''}>{ev.status}</Pill>
                  <span class="text-sm">{ev.message}</span>
                  <span class="text-sm text-muted">{at(ev.firedAt)}</span>
                  {#if !ev.acknowledgedAt && ev.status !== 'resolved'}
                    <Button variant="ghost" disabled={busy === rule.id}
                            onclick={() => acknowledge(rule, ev)}>Acknowledge</Button>
                  {:else if ev.acknowledgedAt}
                    <Badge tone="success">acknowledged</Badge>
                  {/if}
                  {#if ev.status !== 'resolved'}
                    <Button variant="ghost" disabled={busy === rule.id}
                            data-confirm="It closes now, whatever the metric says next; a new breach opens a new one."
                            data-confirm-title="Resolve this alert?" data-confirm-label="Resolve"
                            onclick={() => resolve(rule, ev)}>Resolve</Button>
                  {/if}
                </li>
              {/each}
            </ul>
          {:else}
            <p class="text-sm text-muted">This rule has never fired.</p>
          {/if}
        {/if}

        <div class="cluster">
          <Button variant="outlined" disabled={busy === rule.id}
                  onclick={() => showEvents(rule)}>History</Button>
          <Button variant="ghost" disabled={busy === rule.id} aria-label={`Edit ${rule.name}`}
                  onclick={() => editing = editing === rule.id ? null : rule.id}>
            {editing === rule.id ? 'Close' : 'Edit'}
          </Button>
          <Button variant="ghost" disabled={busy === rule.id} onclick={() => toggle(rule)}>
            {rule.isActive ? 'Pause' : 'Resume'}
          </Button>
          <!-- Pause is until somebody resumes it; a snooze ends by itself, and
               a breach still holding then fires. -->
          {#if snoozed(rule)}
            <Button variant="ghost" disabled={busy === rule.id} data-unsnooze={rule.id}
                    onclick={() => unsnooze(rule)}>Unsnooze</Button>
          {:else}
            <DropdownMenu>
              {#snippet trigger()}
                <Button variant="ghost" disabled={busy === rule.id} data-snooze={rule.id}
                        aria-label={`Snooze ${rule.name}`}>Snooze</Button>
              {/snippet}
              {#each SNOOZES as s}
                <DropdownItem onclick={() => snooze(rule, s)}>{s.label}</DropdownItem>
              {/each}
            </DropdownMenu>
          {/if}
          <Button variant="ghost" disabled={busy === rule.id}
                  data-confirm={`${rule.name} stops being evaluated and nobody is paged by it.`}
                  data-confirm-title="Delete this alert rule?" data-confirm-label="Delete"
                  onclick={() => remove(rule)}>Delete</Button>
        </div>
      </Card>
    {/each}
  </div>
{/if}
