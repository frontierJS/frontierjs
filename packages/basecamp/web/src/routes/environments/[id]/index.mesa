---
title: Environment
---
<script>
  import { page } from '@frontierjs/sierra/router'
  import Environment, { environments } from '../../../resources/Environment.mesa'
  import { apps } from '../../../resources/App.mesa'
  import { projects } from '../../../resources/Project.mesa'
  import { deployments, DEPLOY_TONE } from '../../../resources/Deployment.mesa'
  import { at } from '../../../datetime.js'
  import Pill from '@frontierjs/ui/components/display/Pill.mesa'
  import { goto } from '@frontierjs/sierra/router'
  import { toasts } from '@frontierjs/ui/stores/toastStore.js'
  import Button   from '@frontierjs/ui/components/forms/Button.mesa'
  import Drawer   from '@frontierjs/ui/components/overlay/Drawer.mesa'
  import Select   from '@frontierjs/ui/components/forms/Select.mesa'
  import Input    from '@frontierjs/ui/components/forms/Input.mesa'
  import Table    from '@frontierjs/ui/components/display/Table.mesa'
  import NoRecord from '../../../components/NoRecord.mesa'
  import VariablesEditor from '../../../components/VariablesEditor.mesa'
  import { offerUndo } from '../../../resources/Trash.mesa'

  $: page.params

  let environment = null
  let project     = null
  let appRows     = []
  let releases    = null   // null until read; [] is "never released"
  let editing     = false
  let error       = null
  let loadError   = null
  let loading     = true

  // The environment itself is WATCHED, not read. `service.get(id)` answers a
  // plain object and nothing reaches a plain object — not a push, not a job,
  // not another tab — so this screen used to be stale from the moment somebody
  // else renamed or re-tiered it, and looked correct the whole time because it
  // re-reads after its OWN actions (`FJS-533`). A record view is a subscription
  // to the row's node.
  let row = null, unwatch = null

  function watch() {
    row?.release()
    unwatch?.()
    row     = environments.record(page.params.id)
    unwatch = row.subscribe(v => { environment = v })
    return row.ready
  }

  $.onDestroy(() => { unwatch?.(); row?.release() })

  async function load() {
    error = null; loadError = null; loading = true
    try {
      await watch()
      // For the breadcrumb only; a project that cannot be read leaves the
      // link standing with a generic label rather than failing the screen.
      project = await projects.service.get(environment.projectId).catch(() => null)
      // The app list is its own read: it is a different service's rows, and
      // nothing about the environment moving changes which apps sit in it.
      appRows = (await apps.service.find({ environmentId: page.params.id })).data
    } catch (e) {
      error = e.message; loadError = e
    } finally {
      loading = false
    }
    loadReleases()
  }

  // What shipped HERE, whichever app it was. A release records the environment
  // it went to, so an app moved since still shows where its old releases landed.
  // Not fatal: the environment is the screen, this is a section of it.
  const RELEASE_LIMIT = 10
  async function loadReleases() {
    try {
      releases = (await deployments.service.find({ environmentId: page.params.id }, { limit: RELEASE_LIMIT })).data
    } catch {
      releases = null
    }
  }

  load()
  $: page.params.id, () => load()

  // ── Deploy ────────────────────────────────────────────────────────────
  // A release starts from the app it releases. Creating the Deployment is the
  // whole of the user action: the service snapshots the app's source/config,
  // writes the step list for that app type, and hands off to Caravan — so the
  // job is running before this navigation lands.
  let deploying = null

  async function deploy(app) {
    error = null; deploying = app.id
    try {
      const deployment = await deployments.service.create({ appId: app.id, trigger: 'manual' })
      goto(`/deployments/${deployment.id}/`)
    } catch (e) {
      error = e.message
    } finally {
      deploying = null
    }
  }

  // ── Apps ──────────────────────────────────────────────────────────────
  // An App belongs to exactly one environment, so it is created here rather
  // than on a screen of its own — there is no useful "all apps" form.
  let newApp  = { name: '', slug: '', type: 'container' }
  let adding  = false

  $: (newApp.name, newApp.slug, newApp.type)

  // The type list comes from `enum AppType` in db/schema.lite, through the
  // JSON Schema the build generated. Adding a type to the schema adds it here.
  $: appTypes = apps.fields?.type?.enum ?? ['container', 'worker', 'cron', 'static']

  async function addApp() {
    error = null; adding = true
    try {
      await apps.service.create({
        environmentId: environment.id,
        name:          newApp.name,
        slug:          newApp.slug || slugify(newApp.name),
        type:          newApp.type,
      })
      newApp  = { name: '', slug: '', type: 'container' }
      appRows = (await apps.service.find({ environmentId: environment.id })).data
    } catch (e) {
      error = e.message
    } finally {
      adding = false
    }
  }

  function slugify(v) {
    return v.toLowerCase().replace(/[^a-z0-9]+/g, '-').replace(/^-|-$/g, '').slice(0, 64)
  }

  // ── The environment itself ────────────────────────────────────────────
  // The row is watched, so a save lands on screen through the push; the
  // drawer only has to close.
  function saved() {
    editing = false
    toasts.success('Environment saved')
  }

  let removing = false

  async function removeEnvironment() {
    error = null; removing = true
    // Read before the write: the row is watched, and the delete's own push
    // empties `environment` before the next line runs.
    const { id, name, projectId } = environment
    try {
      await environments.service.remove(id)
      offerUndo(name, environments, id)
      goto(`/projects/${projectId}/`)
    } catch (e) {
      // A protected environment is refused by the service, in its own words.
      error = e.message
      removing = false
    }
  }

  async function removeApp(app) {
    error = null; deploying = app.id
    try {
      await apps.service.remove(app.id)
      offerUndo(app.name, apps, app.id, (row) => { appRows = [...appRows, row] })
      appRows = appRows.filter(a => a.id !== app.id)
    } catch (e) {
      error = e.message
    } finally {
      deploying = null
    }
  }

  const RELEASE_COLUMNS = [
    { name: 'queued', label: 'Queued' },
    { name: 'app',    label: 'App' },
    { name: 'status', label: 'Status' },
    { name: 'branch', label: 'Branch' },
  ]

  const APP_COLUMNS = [
    { name: 'name',    label: 'Name' },
    { name: 'type',    label: 'Type' },
    { name: 'status',  label: 'Status' },
    { name: 'domain',  label: 'Domain' },
    { name: 'actions', label: 'Actions', hideLabel: true },
  ]
</script>

{#if loading}
  <p class="text-sm text-muted">Loading…</p>
{:else if environment}
  <nav aria-label="Breadcrumb" class="cluster" id="env-breadcrumb">
    <a class="navlink" href={`/projects/${environment.projectId}/`}>{project?.name ?? 'Project'}</a>
  </nav>

  <div class="section-header">
    <div class="cluster">
      <h1>{environment.name}</h1>
      <span class="pill" id="env-tier">{environment.tier}</span>
      {#if environment.isProtected}<span class="pill warning" id="env-protected">protected</span>{/if}
    </div>
    <div class="cluster">
      <Button variant="outlined" id="env-edit" onclick={() => editing = true}>Edit</Button>
      <!-- Not disabled when protected: the service refuses it in a sentence
           that says what to do, and a dead button says nothing. -->
      <Button variant="ghost" tone="danger" id="env-delete" disabled={removing}
              data-confirm={`${environment.name} is deleted with its ${appRows.length} app${appRows.length === 1 ? '' : 's'} and their jobs.`}
              data-confirm-title="Delete this environment?" data-confirm-label="Delete"
              onclick={removeEnvironment}>Delete</Button>
    </div>
  </div>

  <Drawer open={editing} title={`Edit ${environment.name}`} onclose={() => editing = false}>
    {#if editing}
      <Environment record={environment} oncancel={() => editing = false}
                   ondone={saved} submitId="env-edit-save" />
    {/if}
  </Drawer>

  {#if error}
    <article class="alert danger" id="screen-error">
      <div class="alert-content">{error}</div>
    </article>
  {/if}

  {#if environment.isProtected}
    <article class="alert warning">
      <div class="alert-content">
        This environment is marked protected in the schema. That flag is advisory in the UI — what enforces it is the service.
      </div>
    </article>
  {/if}

  <h2 class="h4">Apps</h2>
  {#if !appRows.length}
    <article class="alert info">
      <div class="alert-content">No apps in this environment yet — add one below.</div>
    </article>
  {:else}
    <Table id="app-rows" columns={APP_COLUMNS} rows={appRows} striped>
      {#snippet row(app)}
        <tr>
          <!-- An App has its own screen now: placement, hostnames and
               certificates, config, release history. -->
          <td><a href={`/apps/${app.id}/`}>{app.name}</a></td>
          <td><code>{app.type}</code></td>
          <!-- The tone is derived from the value, not chosen per row: a
               status is a fact, and 'error' is the only one that is bad
               news. No color is named here (invariant 13). -->
          <td>
            <span class="pill" class:success={app.status === 'running'}
                               class:danger={app.status === 'error'}>{app.status}</span>
          </td>
          <!-- The primary hostname, from the app's `domains`. `App.domain`
               was one nullable string and is gone — an apex and a www is
               the ordinary case, and one column could not hold both. -->
          <td><code>{app.domains?.find(d => d.isPrimary)?.hostname ?? '—'}</code></td>
          <td class="cluster">
            <Button variant="outlined" disabled={deploying === app.id} onclick={() => deploy(app)}>
              {deploying === app.id ? 'Starting…' : 'Deploy'}
            </Button>
            <Button variant="ghost" href={`/apps/${app.id}/`}>Open</Button>
            <Button variant="ghost" tone="danger" disabled={deploying === app.id}
                    aria-label={`Delete ${app.name}`}
                    data-confirm={`${app.name} stops serving, and its releases, jobs and domains go with it.`}
                    data-confirm-title="Delete this app?" data-confirm-label="Delete"
                    onclick={() => removeApp(app)}>Delete</Button>
          </td>
        </tr>
      {/snippet}
    </Table>
  {/if}

  <!-- novalidate: the service answers a blank name in its own words, and a
       browser bubble would stop the submit before it could. -->
  <form class="card stack" novalidate on:submit|preventDefault={addApp}>
    <div class="field-row">
      <!-- `bind:` is not used on a component here: a component binding takes a
           writable top-level `let` in the caller, and `newApp.name` is a member
           expression. The callback is the way a field of a record is written. -->
      <Input label="App name" name="app-name" id="app-name" placeholder="web" required
             value={newApp.name} oninput={(e) => newApp.name = e.target.value} />
      <Select label="Type" name="app-type" id="app-type" placeholder=""
              options={appTypes} value={newApp.type}
              onchange={(e) => newApp.type = e.target.value} />
    </div>
    <div class="cluster">
      <Button variant="primary" type="submit" disabled={adding}>
        {adding ? 'Adding…' : 'Add app'}
      </Button>
    </div>
  </form>

  <h2 class="h4">Recent releases</h2>
  {#if releases === null}
    <p class="text-sm text-muted">Releases could not be read.</p>
  {:else if !releases.length}
    <p class="text-sm text-muted" id="env-no-releases">Nothing has been released to this environment yet.</p>
  {:else}
    <Table id="env-releases" columns={RELEASE_COLUMNS} rows={releases} striped>
      {#snippet row(d)}
        <tr>
          <td class="text-sm text-muted">{at(d.queuedAt)}</td>
          <td>{#if d.app}<a href={`/apps/${d.appId}/`}>{d.app.name}</a>{:else}—{/if}</td>
          <td><a href={`/deployments/${d.id}/`}><Pill tone={DEPLOY_TONE[d.status] ?? 'muted'}>{d.status}</Pill></a></td>
          <td class="text-sm text-muted">{d.branch ?? '—'}</td>
        </tr>
      {/snippet}
    </Table>
    {#if releases.length >= RELEASE_LIMIT}
      <p class="text-sm text-muted">The last {RELEASE_LIMIT}. Every release is on <a href="/deployments/">Deployments</a>.</p>
    {/if}
  {/if}

  <h2 class="h4">Variables</h2>
  <p class="text-sm text-muted">Every app in {environment.name} starts with these. An app's own variable of the same key wins.</p>
  <VariablesEditor environmentId={environment.id} idPrefix="var" />
{:else}
  <NoRecord error={loadError} noun="Environment" onretry={load}
            backHref="/projects/" backLabel="Back to projects" />
{/if}
