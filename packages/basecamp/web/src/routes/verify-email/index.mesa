---
title: Verify email
---
<script>
  // Where the verification mail's link lands. The token is spent on arrival —
  // there is nothing to confirm, and a button would only be one more step
  // between the person and the answer.
  //
  // Open signed in or out (App.mesa): the link is opened wherever the mail is
  // read, which is often not the browser that holds the session.
  import { page, goto }          from '@frontierjs/sierra/router'
  import { session, verifyEmail } from '../../lib/session.js'
  import Button from '@frontierjs/ui/components/forms/Button.mesa'
  import Alert  from '@frontierjs/ui/components/feedback/Alert.mesa'

  $: session.user

  let state = 'working'   // working | done | failed
  let error = null

  async function spend(token) {
    if (!token) { state = 'failed'; error = 'This link has no token in it.'; return }
    try {
      // A registration's link signs in; one that owes a second factor leaves
      // the code box open on the sign-in page. A signed-in session is read
      // again, which lifts the unverified grading without a sign-out.
      await verifyEmail(token)
      if (session.awaitingCode) return goto('/login/')
      state = 'done'
    } catch (e) {
      const status = e.code ?? e.status
      error = status === 400 || status === 401
        ? 'This link has expired or was already used. Send a new one from Your settings.'
        : e.message
      state = 'failed'
    }
  }

  // The token rides the fragment (/verify-email/#token=…), which no request or
  // analytics tag carries.
  spend(new URLSearchParams(String(page.hash ?? '').replace(/^#/, '')).get('token'))
</script>

<div class="section-header">
  <h1>Verify your email</h1>
  <span class="text-sm text-muted">Basecamp</span>
</div>

<div class="container narrow" id="verify-email" data-state={state}>
  {#if state === 'working'}
    <p class="text-sm text-muted">Checking the link…</p>
  {:else if state === 'done'}
    <Alert tone="success" title="Address verified">Your email address is confirmed.</Alert>
    <Button tone="primary" href={session.user ? '/' : '/login/'}>{session.user ? 'Continue' : 'Sign in'}</Button>
  {:else}
    <Alert tone="danger" title="Not verified">{error}</Alert>
    <Button treatment="ghost" href={session.user ? '/settings/' : '/login/'}>{session.user ? 'Your settings' : 'Sign in'}</Button>
  {/if}
</div>
