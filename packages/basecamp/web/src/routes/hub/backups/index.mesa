---
title: Hub backups
---
<script>
  // The mock's HubBackupView — archives of the application's databases.
  //
  // The mock simulated this: a two-second timer, a fabricated size, and a
  // download of a JSON file with `{hub_backup:true}` in it. This one asks the
  // server, which writes a row and dispatches a job, and the job runs SQLite's
  // own `VACUUM INTO` — the only way to take a consistent copy of a live WAL
  // database, since a file copy silently omits whatever is still in the -wal.
  //
  // ─── Two of the mock's controls are absent, each for its own reason ───
  //
  //   RESTORE. Restoring is replacing the database this process is reading
  //   from, in place, while it serves. That is an operator's job with the
  //   process stopped, and a button that appears to do it from inside the
  //   running app is the most dangerous control this app could have.
  //   S3 CREDENTIALS. A bucket is a `BackupDestination`, declared once in
  //   settings with its key lifted into a Secret; this screen names the one
  //   the schedule points at and asks for nothing.
  //
  // What IS here is the schedule, read from the settings row; `job-schedule.ts`
  // keeps the clock agreeing with it.
  import { backups }            from '../../../resources/Backup.mesa'
  import { hubConfig }          from '../../../resources/HubConfig.mesa'
  import { backupDestinations } from '../../../resources/BackupDestination.mesa'
  import { postures }           from '../../../resources/ServerPosture.mesa'
  import { ago }       from '../../../lib/datetime.js'
  import { formatBytes as size } from '@frontierjs/toolbelt/units'

  import Badge      from '@frontierjs/ui/components/display/Badge.mesa'
  import Button     from '@frontierjs/ui/components/forms/Button.mesa'
  import Callout    from '@frontierjs/ui/components/display/Callout.mesa'
  import Card       from '@frontierjs/ui/components/layout/Card.mesa'
  import EmptyState from '@frontierjs/ui/components/display/EmptyState.mesa'
  import Pill       from '@frontierjs/ui/components/display/Pill.mesa'
  import Table      from '@frontierjs/ui/components/display/Table.mesa'
  import { toasts } from '@frontierjs/ui/stores/toastStore'

  let rows     = []
  let config   = null
  // The hub App (`FJS-D1606`): its schedule, destination and replica.
  $: hub = config?.app ?? null
  // The schedule's destination, by name. Null is the local disk; a row this
  // workspace cannot see shows as its id rather than as local.
  let destination = null
  let error    = null
  let loading  = true
  let asking   = false
  let busy     = null

  async function load() {
    error = null; loading = true
    try {
      rows = (await backups.service.find({}, { limit: 50 })).data
      try {
        config = await hubConfig.service.invoke('current', null)
      } catch {
        // A 404 here is *nobody has saved settings yet*, which is a real state
        // on a fresh installation and not an error on this screen.
        config = null
      }
      destination = null
      if (config?.app?.backupDestinationId) {
        try { destination = await backupDestinations.service.get(config.app.backupDestinationId) } catch {}
      }
      await loadEscrow()
    } catch (e) {
      error = e.message
    } finally {
      loading = false
    }
  }

  load()

  // ─── The key every archive turns on ────────────────────────────────────
  //
  // An archive holds `Secret.data` and the fleet's secret Variables as
  // ciphertext under ENCRYPTION_KEY, which never travels with it. Whether a
  // copy is kept off this box is `hub.key-escrowed`, graded by the one grader
  // (`domain/host/posture.ts`) and read here as the control it is, so this line and
  // /hub/security/ cannot disagree. Attesting is a person's word: the server
  // records when and the key's digest, and a regenerated key voids it.
  let escrow    = null
  let replica   = null
  let attesting = false
  async function loadEscrow() {
    try {
      const host = await postures.service.invoke('host', null, {})
      escrow  = host.controls.find(c => c.id === 'hub.key-escrowed') ?? null
      // The box's own `backup.replica-lag`, which grades Basecamp's database
      // beside its apps' once a replica is set.
      replica = config?.app?.replicaDestinationId ? host.controls.find(c => c.id === 'backup.replica-lag') ?? null : null
    } catch { escrow = null; replica = null }
  }
  // Set by the reconcile after a hub restore (`IDEAS/backups.md` 4.5): this
  // hub's own replica is in the bucket and may be newer than the archive.
  async function dismissFound() {
    error = null
    try {
      config = await hubConfig.service.invoke('dismissFound', null, {})
    } catch (e) {
      error = e.message
    }
  }
  async function attest() {
    error = null; attesting = true
    try {
      await hubConfig.service.invoke('attestEscrow', null, {})
      toasts.success('Attested. The control turns green while this key is the one in use.')
      await loadEscrow()
    } catch (e) {
      error = e.message
    } finally {
      attesting = false
    }
  }

  // ─── This screen POLLS, and it is the only one here that does ──────────
  //
  // Every other list in this app learns about a change from the socket. This
  // one cannot: `announceDataWrites` broadcasts through the app's channels, and
  // the only channel this app has is the WORKSPACE's — `workspaceChannel`
  // answers null without one. `Backup` is `@@tenant(none)`, so there is no
  // workspace to broadcast into, and a hub-tier channel would need a
  // membership rule that does not exist.
  //
  // So while an archive is in flight the screen asks again. Measured rather
  // than assumed: `verify:screens` watched a row sit at `pending` on screen
  // while the job had already finished it in 80ms.
  let poll = null
  function watch() {
    clearTimeout(poll)
    if (!inFlight) return
    poll = setTimeout(async () => { await load(); watch() }, 1500)
  }
  $: inFlight, () => watch()
  $.onDestroy(() => clearTimeout(poll))

  async function takeOne() {
    error = null; asking = true
    try {
      await backups.service.invoke('take', null, { destinationId: hub?.backupDestinationId ?? null })
      toasts.success('Backup queued. The row fills in as the job runs.')
      await load()
      // `inFlight` is derived from the rows `load()` just fetched, so the watch
      // starts from a row that really is pending rather than from an assumption
      // that one will be.
      watch()
    } catch (e) {
      // 'A backup is already running' arrives here. The button is not
      // pre-emptively disabled on `inFlight` below — whether one is in flight is
      // the server's answer, and two administrators clicking at once is exactly
      // the case the refusal exists for.
      error = e.message
    } finally {
      asking = false
    }
  }

  // The server answers a link and the browser follows it: a bucket's pre-signed
  // GET, or a five-minute link to this disk's copy. Both answer as an
  // attachment, so the screen stays where it is.
  async function download(b) {
    error = null; busy = b.id
    try {
      const { url } = await backups.service.invoke('download', b.id, {})
      location.assign(url)
    } catch (e) {
      error = e.message
    } finally {
      busy = null
    }
  }

  // `remove` deletes the archive — its directory here or its object in the
  // bucket — and then the row (`FJS-D1494`); a refused delete is a 409 that
  // keeps both, and arrives as the screen error.
  async function drop(b) {
    error = null; busy = b.id
    try {
      await backups.service.invoke('discard', b.id, {})
      toasts.success('Backup deleted')
      await load()
    } catch (e) {
      error = e.message
    } finally {
      busy = null
    }
  }

  // An archive in the bucket that no row names is invisible to this list and to
  // retention until a rescan gives it a `found` row (`FJS-D1493`).
  let rescanning = false
  async function rescan() {
    error = null; rescanning = true
    try {
      const { listed, found } = await backups.service.invoke('rescan', null, { destinationId: hub.backupDestinationId })
      toasts.success(found ? `${found} archive${found === 1 ? '' : 's'} found in the bucket` : `Nothing new — ${listed} listed`)
      await load()
    } catch (e) {
      error = e.message
    } finally {
      rescanning = false
    }
  }

  const SETTLED = new Set(['success', 'failed', 'timeout'])

  $: inFlight = rows.find(b => !['success', 'failed', 'timeout'].includes(b.status)) ?? null

  function tone(status) {
    if (status === 'success') return 'success'
    if (status === 'failed')  return 'danger'
    if (status === 'timeout') return 'warning'
    return 'info'
  }

  const COLUMNS = [
    { name: 'when',   label: 'Taken' },
    { name: 'kind',   label: 'Kind' },
    { name: 'status', label: 'Status' },
    { name: 'size',   label: 'Size' },
    { name: 'where',  label: 'Where' },
    { name: 'actions', label: 'Actions', hideLabel: true },
  ]
</script>

<div class="section-header">
  <h2 class="h3">Backups</h2>
  <Button tone="primary" id="take-backup" disabled={asking} onclick={takeOne}>
    {asking ? 'Asking…' : 'Back up now'}
  </Button>
</div>

{#if error}
  <article class="alert danger" id="screen-error">
    <div class="alert-content">{error}</div>
  </article>
{/if}

<Callout tone="warning" title="Taking one is here. Restoring one is not.">
  A backup is a folder holding every database the app keeps — the main database, the audit trail
  and the job queue. Each SQLite file is <code>VACUUM INTO</code>, SQLite's own consistent copy of
  a live database, taken without locking out writers. Restoring means replacing the files this
  process is reading from while it serves, which is an operator's job with the process stopped.
  <em>Download</em> fetches one as <code>basecamp-&lt;stamp&gt;.tar.gz</code>, from the bucket or this disk.
</Callout>

{#if escrow}
  <Card id="key-escrow">
    <div class="section-header">
      <h3 class="h5">Encryption key</h3>
      <Pill tone={escrow.ok === true ? 'success' : escrow.ok === false ? 'danger' : 'muted'}>
        {escrow.ok === true ? 'escrowed' : escrow.ok === false ? 'not escrowed' : 'unknown'}
      </Pill>
    </div>
    <p class="text-sm text-muted">
      Every archive carries this installation's secrets as ciphertext under <code>ENCRYPTION_KEY</code>,
      and the key never travels with one — an archive without its key cannot be read. The key is
      <code>secrets/ENCRYPTION_KEY</code> on this box and the copy <code>fli deploy:setup</code> left in the
      operator's local <code>.env</code>. Nothing here can see that copy, so a person attests it.
    </p>
    <p class="text-sm" id="key-escrow-reading">{escrow.message}</p>
    {#if escrow.ok !== true}
      <Button treatment="outlined" id="attest-escrow" disabled={attesting}
              data-confirm="Only attest a copy you have read back from somewhere that is not this machine. A wrong answer here costs every archive the day this box is lost."
              data-confirm-title="A copy of the key is kept off this box?" data-confirm-label="Attest"
              onclick={attest}>
        {attesting ? 'Recording…' : 'I keep a copy off this box'}
      </Button>
    {/if}
  </Card>
{/if}

{#if hub?.replicaFoundAt}
  <Card id="hub-found">
    <h3 class="h5">Replica found</h3>
    <p class="text-sm">
      This hub was restored from an archive, and its bucket holds Basecamp's own replica, last synced
      {hub.replicaSyncedAt ? ago(hub.replicaSyncedAt) : 'at an unknown time'}. When that is newer
      than the archive, the minutes between are in the replica.
    </p>
    <p class="text-sm text-muted">
      A hub cannot replace itself while it serves, so that restore is the runbook:
      <code>docs/BACKUPS.md</code> § 7, <em>The hub, from its own replica</em>, before this box's Outpost is enrolled.
    </p>
    <div class="cluster">
      <Button treatment="ghost" id="hub-found-dismiss" onclick={dismissFound}>Dismiss</Button>
    </div>
  </Card>
{/if}

{#if replica}
  <Card id="hub-replica">
    <div class="section-header">
      <h3 class="h5">Continuous replica</h3>
      <Pill tone={replica.ok === true ? 'success' : replica.ok === false ? 'danger' : 'muted'}>
        {replica.ok === true ? 'replicating' : replica.ok === false ? 'behind' : 'unknown'}
      </Pill>
    </div>
    <p class="text-sm text-muted">
      Litestream on this box streams the database to its bucket within seconds of each write —
      the minutes between the archives below. Set in <a href="/hub/settings/">settings</a>.
    </p>
    <p class="text-sm" id="hub-replica-reading">{replica.message}</p>
  </Card>
{/if}

{#if hub}
  <Card id="backup-schedule">
    <div class="section-header">
      <h3 class="h5">Schedule</h3>
      <span class="cluster">
        <Pill tone={hub.backupCron ? 'success' : 'muted'}>
          {hub.backupCron ? 'enabled' : 'off'}
        </Pill>
        {#if hub.backupCron}<Badge tone="muted"><code>{hub.backupCron}</code></Badge>{/if}
        <Badge tone="muted">
          {hub.backupDestinationId ? (destination ? `${destination.name} — ${destination.bucket}` : hub.backupDestinationId) : 'local'}
        </Badge>
      </span>
    </div>
    <p class="text-sm text-muted">
      While enabled, each fire of this expression takes an archive to the destination shown,
      marked <em>scheduled</em> below; a fire while another archive is still running is skipped.
      After each one finishes, archives past the keep limits are deleted, the newest always kept.
      Edit both in <a href="/hub/settings/">settings</a>.
    </p>
    {#if hub.backupDestinationId}
      <Button treatment="outlined" id="rescan-bucket" disabled={rescanning} onclick={rescan}>
        {rescanning ? 'Listing…' : 'Rescan the bucket'}
      </Button>
    {/if}
  </Card>
{/if}

{#if loading}
  <p class="text-sm text-muted">Loading…</p>
{:else if !rows.length}
  <EmptyState title="No backups">
    Nothing has been archived yet. <em>Back up now</em> writes one to the machine this process
    runs on.
  </EmptyState>
{:else}
  <Table id="backup-history" columns={COLUMNS} rows={rows} striped hover={false}>
    {#snippet row(b)}
      <tr>
        <td class="text-sm">{ago(b.finishedAt ?? b.startedAt ?? b.createdAt)}</td>
        <td><Pill tone="muted">{b.kind}</Pill></td>
        <td>
          <Pill tone={tone(b.status)}>{b.status}</Pill>
          {#if b.durationMs}<span class="text-sm text-muted"> {(b.durationMs / 1000).toFixed(1)}s</span>{/if}
        </td>
        <!-- Absent until it finishes, rather than 0 B — the size is what the
             machine reported and there is nothing to report while it runs. -->
        <td class="text-sm">{b.sizeBytes ? size(b.sizeBytes) : '—'}</td>
        <td class="text-sm text-muted"><code>{b.location ?? '—'}</code></td>
        <td>
          {#if b.status === 'success' && b.location}
            <Button treatment="ghost" disabled={busy === b.id} aria-label={`Download the backup taken ${ago(b.finishedAt ?? b.startedAt ?? b.createdAt)}`}
                    onclick={() => download(b)}>Download</Button>
          {/if}
          {#if SETTLED.has(b.status)}
            <Button treatment="ghost" disabled={busy === b.id} aria-label={`Delete the backup taken ${ago(b.finishedAt ?? b.startedAt ?? b.createdAt)}`}
                    data-confirm={b.location
                      ? `The archive at ${b.location} is deleted ${b.location.startsWith('/') ? 'from this disk' : 'from the bucket'}, then the row.`
                      : 'The row goes from this list.'}
                    data-confirm-title="Delete this backup?" data-confirm-label="Delete" data-confirm-tone="danger"
                    onclick={() => drop(b)}>Delete</Button>
          {/if}
        </td>
      </tr>
      {#if b.error}
        <tr><td colspan="6"><pre class="code"><code>{b.error}</code></pre></td></tr>
      {/if}
    {/snippet}
  </Table>
{/if}
