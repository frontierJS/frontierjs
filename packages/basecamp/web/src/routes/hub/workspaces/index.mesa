---
title: Hub workspaces
---
<script>
  // The mock's WorkspacesView — every tenant, not the caller's.
  //
  // The workspaces service cannot answer this and should not learn to: its
  // `find` is deliberately "workspaces I am a member of", and widening it with
  // a scope parameter would put the tenancy decision in a query string. This
  // reads through /hub, which is behind requireSystemAdmin and nothing else.
  //
  // Suspension is the action worth understanding. It is NOT deletion — the rows
  // stay, the servers keep running — and it bites in scopeToWorkspace, the one
  // hook every workspace-scoped service already runs, so a suspended tenant is
  // refused everywhere rather than merely labeled here.
  import { hub } from '../../../resources/Hub.mesa'

  import Badge      from '@frontierjs/ui/components/display/Badge.mesa'
  import Button     from '@frontierjs/ui/components/forms/Button.mesa'
  import EmptyState from '@frontierjs/ui/components/display/EmptyState.mesa'
  import Pill       from '@frontierjs/ui/components/display/Pill.mesa'
  import { toasts } from '@frontierjs/ui/stores/toastStore.js'
  import Input from '@frontierjs/ui/components/forms/Input.mesa'
  import Table from '@frontierjs/ui/components/display/Table.mesa'

  let rows    = []
  let error   = null
  let loading = true
  let busy    = null
  let q       = ''

  async function load() {
    error = null; loading = true
    try {
      // A collection-level action: no subject row, so it posts to /hub rather
      // than /hub/{id}. `null` as the id is what expresses that (FJS-122).
      const page = await hub.service.invoke('workspaces', null, {}, q ? { q } : {})
      rows = page.data ?? []
    } catch (e) {
      error = e.message
    } finally {
      loading = false
    }
  }

  load()

  function search(value) { q = value; load() }

  async function setStatus(ws, status) {
    error = null; busy = ws.id
    try {
      await hub.service.invoke('setWorkspaceStatus', null, { workspaceId: ws.id, status })
      toasts[status === 'suspended' ? 'warning' : 'success'](
        status === 'suspended' ? `${ws.name} suspended` : `${ws.name} reinstated`,
        status === 'suspended'
          ? 'Its members are refused by every scoped service until it is restored.'
          : 'Its members can reach the API again.',
      )
      await load()
    } catch (e) {
      error = e.message
    } finally {
      busy = null
    }
  }

  const when = (iso) => iso ? new Date(iso).toLocaleDateString() : '—'

  $: active    = rows.filter(w => w.status === 'active').length
  $: suspended = rows.length - active
  const HUB_WORKSPACE_COLUMNS = [
    { key: 'workspace', label: 'Workspace' },
    { key: 'type',      label: 'Type' },
    { key: 'status',    label: 'Status' },
    { key: 'members',   label: 'Members' },
    { key: 'servers',   label: 'Servers' },
    { key: 'projects',  label: 'Projects' },
    { key: 'owner',     label: 'Owner' },
    { key: 'created',   label: 'Created' },
    { key: 'actions',   label: 'Actions', hideLabel: true },
  ]
</script>

{#if error}
  <article class="alert danger" id="screen-error">
    <div class="alert-content">{error}</div>
  </article>
{/if}

<p class="text-body">
  Every workspace on this hub. Suspending one leaves its data and its servers alone and
  refuses its members at the API — it is not a delete, and there is no undo to need.
</p>

<div class="cluster" id="hub-ws-stats">
  <Badge tone="muted">{rows.length} workspaces</Badge>
  <Badge tone="success">{active} active</Badge>
  <Badge tone={suspended ? 'danger' : 'muted'}>{suspended} suspended</Badge>
</div>

<div class="cluster">
  <label class="visually-hidden" for="ws-search">Filter workspaces</label>
  <Input id="ws-search" type="search" placeholder="Filter workspaces…"
         value={q} oninput={(e) => search(e.target.value)} />
</div>

{#if loading}
  <p class="text-sm text-muted">Loading…</p>
{:else if !rows.length}
  <EmptyState title="No workspaces">
    Nothing matched. A workspace is created by whoever signs up, or from the Projects
    screen inside one — the hub reads them, it does not mint them.
  </EmptyState>
{:else}
  <Table id="hub-workspace-rows" columns={HUB_WORKSPACE_COLUMNS} rows={rows} striped hover={false}>
    {#snippet row(w)}
      <tr>
        <td>
          {w.name}
          <span class="text-sm text-muted"><code>{w.slug}</code></span>
        </td>
        <td><Badge tone="muted">{w.type}</Badge></td>
        <td><Pill tone={w.status === 'active' ? 'success' : 'danger'}>{w.status}</Pill></td>
        <td>{w.members}</td>
        <td>{w.servers}</td>
        <td>{w.projects}</td>
        <td class="text-sm text-muted">{w.owner?.email ?? '—'}</td>
        <td class="text-sm text-muted">{when(w.createdAt)}</td>
        <td>
          {#if w.status === 'active'}
            <Button variant="ghost" tone="danger" disabled={busy === w.id}
                    aria-label={`Suspend ${w.name}`}
                    onclick={() => setStatus(w, 'suspended')}>Suspend</Button>
          {:else}
            <Button variant="ghost" disabled={busy === w.id}
                    aria-label={`Reinstate ${w.name}`}
                    onclick={() => setStatus(w, 'active')}>Reinstate</Button>
          {/if}
        </td>
      </tr>
    {/snippet}
  </Table>
{/if}

<article class="alert info">
  <div class="alert-content">
    The mock also offers <strong>Impersonate</strong>. It is not built: minting a session as
    somebody else needs a trail that keeps saying who is really acting, a way back that cannot
    be forgotten, and a rule for what an impersonator may not do. A half-built one is
    credential sharing with a button (<code>FJS-142</code>).
  </div>
</article>
