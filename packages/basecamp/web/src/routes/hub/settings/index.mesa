---
title: Hub settings
---
<script>
  // The mock's HubSettingsView — the installation's own settings.
  //
  // ONE ROW, and the service says so: `hub-config` answers `current` and `save`
  // and no CRUD verb at all, because a singleton has no collection and its id is
  // a constant no screen should have to know.
  //
  // ─── The mock had four credentials on this screen and none is here ──────
  //
  // Its auth secret, agent secret, Resend key and Infisical token are all absent
  // from the model, and the reasons are worth repeating where somebody would go
  // looking for them: they are read at BOOT, before any database, so a row would
  // never reach the running process; rotating one is a deploy rather than a
  // form; and this app already models credential material as `Secret`, whose
  // `data` is @encrypted and unreadable at every level. A form that appeared to
  // set them would be a form that silently did nothing.
  //
  // ─── Why a version travels with the save ────────────────────────────────
  //
  // `HubConfig` carries @version, so an update must carry the revision it read.
  // Two administrators with this form open is exactly the case it exists for:
  // without it the second save silently erases the first, and with it the second
  // gets a 409 naming both revisions and can re-read.
  //
  // ─── The backup destination is a row in THIS workspace ───────────────────
  //
  // `BackupDestination` is workspace-owned (`FJS-D1491`) because its key is a
  // `Secret` and a Secret has a workspace. The hub's one schedule points at one
  // from above, so the picker lists the current workspace's destinations — the
  // header names the workspace, nothing on this screen does — and the inline
  // form makes one here rather than on a screen of its own. The credential is
  // typed once as `<accessKeyId>:<secretAccessKey>`, sent beside the record
  // and never shown again; the row that comes back carries an address only.
  import { hubConfig }          from '../../../resources/HubConfig.mesa'
  import { hub }                from '../../../resources/Hub.mesa'
  import { backupDestinations } from '../../../resources/BackupDestination.mesa'
  import { session }            from '../../../lib/session.js'
  import { at }                 from '../../../lib/datetime.js'

  import Button   from '@frontierjs/ui/components/forms/Button.mesa'
  import Callout  from '@frontierjs/ui/components/display/Callout.mesa'
  import Card     from '@frontierjs/ui/components/layout/Card.mesa'
  import Form     from '@frontierjs/ui/components/forms/Form.mesa'
  import Input    from '@frontierjs/ui/components/forms/Input.mesa'
  import Select   from '@frontierjs/ui/components/forms/Select.mesa'
  import Switch   from '@frontierjs/ui/components/forms/Switch.mesa'
  import Badge    from '@frontierjs/ui/components/display/Badge.mesa'
  import { toasts } from '@frontierjs/ui/stores/toastStore'

  let config    = null
  let hubApp    = null
  // What the draft was filled from, so a save sends only what changed.
  let base      = {}
  let draft     = {}
  let error     = null
  let fieldErrs = {}
  let loading   = true
  let saving    = false
  // A fresh installation has no row. Not an error: the form is the way to make
  // one, and the screen says which state it is in.
  let unset     = false

  let destinations = []
  // The probe: `test` PUTs and DELETEs a key under the prefix for real, and the
  // answer lands here — beside the picker, where the person who typed the key
  // is looking — rather than in the job log at 02:00 (`IDEAS/backups.md` 1.8).
  let testing      = null      // the destination id under test
  let testSaid     = null      // { tone, text } of the last probe
  let addingDest   = false
  let destDraft    = backupDestinations.make()
  let destSecret   = ''
  let destError    = null

  // The controls take a value and hand back a change rather than binding to
  // `draft.x` — `bind:` on a COMPONENT needs a writable top-level let and a
  // member expression is not one. Replacing the object is what makes it
  // reactive.
  //
  // **`Switch` hands its `onchange` a BOOLEAN, where `Input` hands `oninput` an
  // event.** They are not interchangeable: `e.target.checked` on a Switch reads
  // a property of `undefined`, which throws inside the handler and leaves the
  // control looking dead. Measured — it is what the first run of
  // `verify:screens` found on this screen and on /settings/.
  function write(name, value) { draft = { ...draft, [name]: value } }

  // The schedule, its destination and the replica are the hub App's
  // (`FJS-D1606`), answered under `app` and saved through the same call. The
  // switch is the draft's alone: off saves no cron.
  const HUB_APP_KEYS = ['backupEnabled', 'backupCron', 'backupDestinationId', 'replicaDestinationId']
  function adopt({ app, ...row }) {
    config = row
    hubApp = app
    base   = { ...row, ...(app ? {
      backupEnabled: !!app.backupCron, backupCron: app.backupCron ?? '0 2 * * *',
      backupDestinationId: app.backupDestinationId, replicaDestinationId: app.replicaDestinationId,
    } : {}) }
    draft  = { ...base }
  }

  async function load() {
    error = null; loading = true; fieldErrs = {}
    try {
      adopt(await hubConfig.service.invoke('current', null))
      unset  = false
    } catch (e) {
      if (e?.data?.code === 404 || /no settings yet/.test(e.message ?? '')) {
        unset  = true
        config = null
        base   = {}
        draft  = {
          heartbeatTimeoutSeconds: 120,
          requireTwoFactorForOwners: false, allowApiKeyAuth: true, allowBotUsers: true,
          backupEnabled: false, backupCron: '0 2 * * *', backupDestinationId: null, replicaDestinationId: null,
          backupKeepLocalCount: 7, backupKeepLocalDays: null, backupKeepRemoteCount: 7, backupKeepRemoteDays: null,
        }
      } else {
        error = e.message
      }
    } finally {
      loading = false
    }
  }

  load()

  // Read-only, and a failed read costs only this card: the form above is the row.
  let variables = []
  hub.service.invoke('environment', null)
    .then(r => { variables = r.variables })
    .catch(() => {})
  const STATE_TONE = { set: 'success', default: 'muted', unset: 'warning' }

  // The workspace's destinations, re-read when the header switches workspace:
  // a destination the schedule names in another workspace still shows by id
  // in the picker's "elsewhere" entry rather than vanishing.
  async function loadDestinations() {
    try {
      destinations = (await backupDestinations.service.find({}, { limit: 200 })).data
    } catch {
      destinations = []
    }
  }
  $: session.workspaceId, () => loadDestinations()

  $: destOptions = [
    { value: '', label: 'This machine (local disk)' },
    ...destinations.map(d => ({ value: d.id, label: `${d.name} — ${d.bucket}` })),
    ...(draft.backupDestinationId && !destinations.some(d => d.id === draft.backupDestinationId)
      ? [{ value: draft.backupDestinationId, label: 'A destination in another workspace' }]
      : []),
  ]

  $: picked = destinations.find(d => d.id === draft.backupDestinationId) ?? null

  $: replicaOptions = [
    { value: '', label: 'None' },
    ...destinations.map(d => ({ value: d.id, label: `${d.name} — ${d.bucket}` })),
    ...(draft.replicaDestinationId && !destinations.some(d => d.id === draft.replicaDestinationId)
      ? [{ value: draft.replicaDestinationId, label: 'A destination in another workspace' }]
      : []),
  ]

  function writeDest(name, value) { destDraft = { ...destDraft, [name]: value } }

  // The failure is the connector's kind in words — `forbidden: …`,
  // `clock_skew: …` — and it is shown whole, because which of the three 403s
  // this is decides whether the person fixes the key, the policy or the clock.
  async function testDestination(dest) {
    testing = dest.id; testSaid = null
    const said = toasts.loading(`Testing ${dest.name}…`)
    try {
      const updated = await backupDestinations.service.invoke('test', dest.id)
      destinations  = destinations.map(d => d.id === dest.id ? { ...d, ...updated } : d)
      testSaid = { tone: 'success', text: `${dest.name}: a probe key was written and deleted under ${updated.prefix || 'the bucket root'}` }
      said.update('success', `${dest.name} tested`)
    } catch (e) {
      testSaid = { tone: 'danger', text: `${dest.name}: ${e.message}` }
      said.update('danger', `Test failed: ${e.message}`)
    } finally {
      testing = null
    }
  }

  async function createDestination(data) {
    destError = null
    try {
      // `secret` is @transient — not a column, so not on the record the form
      // validates. It rides alongside and the server lifts it into a Secret.
      const made = await backupDestinations.service.create({ ...data, secret: destSecret })
      toasts.success(`${made.name} added`)
      addingDest = false
      destDraft  = backupDestinations.make()
      destSecret = ''
      await loadDestinations()
      write('backupDestinationId', made.id)
      // Tested at once: a wrong key fails here, where the person who typed it
      // is looking, and not at the first scheduled fire. The row stays either
      // way — the fix is a patch, not a retype.
      await testDestination(made)
    } catch (e) {
      destError = e.message
      throw e
    }
  }

  async function save() {
    error = null; fieldErrs = {}; saving = true
    try {
      // The revision this screen READ, not one off a store: a push moving the
      // number would carry a revision nobody here has seen, which is the race
      // @version exists to lose (`FJS-341`).
      // Only what this form changed. The row echoed whole names its `@system`
      // columns (the key escrow), which litestone refuses by name rather than
      // dropping — so an untouched save would be a 403 about a column no
      // control here shows.
      const { backupEnabled, ...payload } = unset ? { ...draft }
        : Object.fromEntries(Object.entries(draft).filter(([k, v]) => v !== base[k]))
      if (backupEnabled !== undefined || 'backupCron' in payload)
        payload.backupCron = draft.backupEnabled ? draft.backupCron : null
      // Before the hub App exists there is no row to hold them.
      if (!hubApp) for (const k of HUB_APP_KEYS) delete payload[k]
      if (!unset) payload.version = config.version

      adopt(await hubConfig.service.invoke('save', null, payload))
      unset  = false
      toasts.success('Settings saved')
    } catch (e) {
      // Litestone validates on the write — `hub-config` mounts no create or
      // patch, so there is no autoValidate — and its refusal carries an
      // `errors` array, which the resource turns into per-field messages.
      const mapped = hubConfig.fieldErrors(e)
      fieldErrs    = mapped.fields ?? {}
      error        = mapped.message ?? e.message
    } finally {
      saving = false
    }
  }
</script>

<div class="section-header">
  <h2 class="h3">Settings</h2>
  {#if config}
    <span class="text-sm text-muted">revision {config.version}</span>
  {/if}
</div>

{#if error}
  <article class="alert danger" id="screen-error">
    <div class="alert-content">{error}</div>
  </article>
{/if}

{#if loading}
  <p class="text-sm text-muted">Loading…</p>
{:else}
  {#if unset}
    <Callout tone="info" title="This installation has no settings yet">
      Every field below has a default. Saving once creates the row.
    </Callout>
  {/if}

  <Card id="hub-settings-app">
    <h3 class="h5">This Basecamp</h3>
    {#if hubApp?.server}
      <p class="text-sm">
        {hubApp.name} runs on <a href={`/servers/${hubApp.server.id}/`}>{hubApp.server.name}</a>
        {#if hubApp.server.ipAddress}at {hubApp.server.ipAddress}{:else}, which has no address yet{/if}
        — {hubApp.server.status}.
      </p>
    {:else if hubApp}
      <p class="text-sm">{hubApp.name} is placed on no server. Press <a href="/servers/">Use this Basecamp server</a> to place it again.</p>
    {:else}
      <p class="text-sm text-muted">Not enrolled yet. <a href="/servers/">Use this Basecamp server</a> makes it an App on its own box.</p>
    {/if}
  </Card>

  <Card id="hub-settings-limits">
    <h3 class="h5">Timings</h3>
    <Input name="heartbeatTimeoutSeconds" id="cfg-heartbeat" type="number"
           label="Heartbeat timeout (seconds)" value={draft.heartbeatTimeoutSeconds}
           error={fieldErrs.heartbeatTimeoutSeconds}
           hint="A server goes unreachable after this long without checking in. Below the outpost's own interval, every healthy machine reads unreachable between beats."
           oninput={(e) => write('heartbeatTimeoutSeconds', Number(e.target.value))} />
  </Card>

  <Card id="hub-settings-policy">
    <h3 class="h5">Policy</h3>
    <Switch id="cfg-2fa" label="Require 2FA for owners" checked={draft.requireTwoFactorForOwners}
            description="A workspace owner with no authenticator can sign in only to set one up; every other call is refused until they do."
            onchange={(checked) => write('requireTwoFactorForOwners', checked)} />
    <Switch id="cfg-api-keys" label="Allow API key authentication" checked={draft.allowApiKeyAuth}
            description="Off refuses every request made with an API key, the CLI and MCP clients included. Sign-in sessions and outposts are unaffected."
            onchange={(checked) => write('allowApiKeyAuth', checked)} />
    <Switch id="cfg-bots" label="Allow bot accounts" checked={draft.allowBotUsers}
            description="Off refuses creating a bot. Bots that exist keep their keys."
            onchange={(checked) => write('allowBotUsers', checked)} />
  </Card>

  <Card id="hub-settings-backup">
    <h3 class="h5">Scheduled backup</h3>
    {#if !hubApp}
      <p class="text-sm text-muted" id="backup-no-hub-app">
        The schedule is this Basecamp's App row's, made when its box is enrolled — press
        <a href="/servers/">Use this Basecamp server</a> first.
      </p>
    {/if}
    <Switch id="cfg-backup" label="Take a scheduled backup" checked={draft.backupEnabled}
            onchange={(checked) => write('backupEnabled', checked)} />
    <Input name="backupCron" id="cfg-backup-cron" label="Cron expression" value={draft.backupCron}
           error={fieldErrs.backupCron}
           hint="0 2 * * * is 02:00 daily"
           oninput={(e) => write('backupCron', e.target.value)} />
    <Select name="backupDestinationId" id="cfg-backup-destination" label="Destination"
            value={draft.backupDestinationId ?? ''} options={destOptions} placeholder=""
            error={fieldErrs.backupDestinationId}
            hint="An S3-compatible bucket this workspace has declared, or the disk this process runs on. An upload that fails keeps the archive on this disk and says why."
            oninput={(e) => write('backupDestinationId', e.target.value || null)} />
    {#if picked}
      <p class="text-sm text-muted" id="destination-tested">
        Last tested {at(picked.lastTestAt, 'never')}.
        {#if !picked.lastTestAt}
          A test writes and deletes a probe key under the prefix with the stored key — the same path the schedule takes.
        {/if}
      </p>
    {/if}
    {#if testSaid}
      <article class="alert {testSaid.tone}" id="destination-test" role="status"><div class="alert-content">{testSaid.text}</div></article>
    {/if}
    {#if !addingDest}
      <div class="cluster">
        <Button treatment="outlined" id="add-destination" onclick={() => { addingDest = true; destError = null; testSaid = null }}>
          Add a bucket
        </Button>
        {#if picked}
          <Button treatment="outlined" id="test-destination" disabled={testing !== null}
                  onclick={() => testDestination(picked)}>
            {testing === picked.id ? 'Testing…' : 'Test bucket'}
          </Button>
        {/if}
      </div>
    {:else}
      <div class="stack" id="new-destination">
        {#if destError}
          <article class="alert danger"><div class="alert-content">{destError}</div></article>
        {/if}
        <Form resource={backupDestinations} bind:record={destDraft} onsubmit={createDestination}>
          <Input name="name" id="dest-name" value={destDraft.name}
                 hint="Backblaze B2, Hetzner Object Storage, R2 — whatever you call the bucket"
                 oninput={(e) => writeDest('name', e.target.value)} />
          <Input name="endpoint" id="dest-endpoint" value={destDraft.endpoint}
                 hint="https://s3.us-west-000.backblazeb2.com — the vendor's S3 endpoint, without the bucket in it"
                 oninput={(e) => writeDest('endpoint', e.target.value)} />
          <Input name="region" id="dest-region" value={destDraft.region}
                 hint="us-west-000 — the region in the endpoint; SigV4 signs with it"
                 oninput={(e) => writeDest('region', e.target.value)} />
          <Input name="bucket" id="dest-bucket" value={destDraft.bucket}
                 oninput={(e) => writeDest('bucket', e.target.value)} />
          <Input name="prefix" id="dest-prefix" value={destDraft.prefix}
                 hint="backups — archives land at backups/<name>. A key scoped to a prefix at the vendor needs this plus a slash."
                 oninput={(e) => writeDest('prefix', e.target.value)} />
          <Input id="dest-secret" name="secret" type="password" label="Credential"
                 hint="<accessKeyId>:<secretAccessKey> — stored encrypted, never shown again; rotating means typing a new one"
                 value={destSecret} oninput={(e) => destSecret = e.target.value} />
          <div class="cluster">
            <Button type="submit" tone="primary">Add bucket</Button>
            <Button treatment="ghost" onclick={() => { addingDest = false }}>Cancel</Button>
          </div>
        </Form>
      </div>
    {/if}
    <h4 class="h6">Keep</h4>
    <div class="grid" style="--grid-min: 12rem" id="backup-retention">
      <Input name="backupKeepLocalCount" id="cfg-keep-local-count" type="number"
             label="On this disk — newest" value={draft.backupKeepLocalCount}
             error={fieldErrs.backupKeepLocalCount}
             oninput={(e) => write('backupKeepLocalCount', Number(e.target.value))} />
      <Input name="backupKeepLocalDays" id="cfg-keep-local-days" type="number"
             label="On this disk — days" value={draft.backupKeepLocalDays ?? ''}
             error={fieldErrs.backupKeepLocalDays} hint="Empty is no age limit"
             oninput={(e) => write('backupKeepLocalDays', e.target.value === '' ? null : Number(e.target.value))} />
      <Input name="backupKeepRemoteCount" id="cfg-keep-remote-count" type="number"
             label="In each bucket — newest" value={draft.backupKeepRemoteCount}
             error={fieldErrs.backupKeepRemoteCount}
             oninput={(e) => write('backupKeepRemoteCount', Number(e.target.value))} />
      <Input name="backupKeepRemoteDays" id="cfg-keep-remote-days" type="number"
             label="In each bucket — days" value={draft.backupKeepRemoteDays ?? ''}
             error={fieldErrs.backupKeepRemoteDays} hint="Empty is no age limit"
             oninput={(e) => write('backupKeepRemoteDays', e.target.value === '' ? null : Number(e.target.value))} />
    </div>
    <p class="text-sm text-muted">
      Saving puts the expression on the clock, or takes it off when the switch is off. The
      archives it takes are listed in <a href="/hub/backups/">backups</a>. After each backup
      finishes, an archive past either limit is deleted — the newest is always kept, and a
      lowered limit applies at the next backup, not on save. A bucket keeping every version
      bills a deleted archive until its lifecycle drops old versions.
    </p>
    <Select name="replicaDestinationId" id="cfg-replica-destination" label="Continuous replica"
            value={draft.replicaDestinationId ?? ''} options={replicaOptions} placeholder=""
            error={fieldErrs.replicaDestinationId}
            hint="Litestream on this box streams the database to this bucket within seconds, under basecamp/ in its prefix. Its key sits on this box, so give it a destination of its own — one an app replicates with is refused."
            oninput={(e) => write('replicaDestinationId', e.target.value || null)} />
  </Card>

  <Card id="hub-settings-environment">
    <h3 class="h5">Environment</h3>
    <p class="text-sm text-muted">
      Read at boot, before any database, so none of these is set from this screen: change one in
      the env file and restart the API. <code>FRONTIER_APP_URL</code>, <code>FRONTIER_API_URL</code>
      and the mailer are graded on <a href="/hub/security/">Host security</a>. A secret shows
      whether it is set and never its value.
    </p>
    {#if variables.length}
      <table class="table" id="hub-environment">
        <thead>
          <tr><th>Variable</th><th>State</th><th>Value</th></tr>
        </thead>
        <tbody>
          {#each variables as v}
            <tr data-variable={v.name}>
              <td><code>{v.name}</code>{#if v.required} <span class="text-sm text-muted">required</span>{/if}</td>
              <td><Badge tone={STATE_TONE[v.state]}>{v.state}</Badge></td>
              <td class="text-sm">{#if v.secret}<span class="text-muted">secret</span>{:else if v.value !== null}<code>{v.value}</code>{/if}</td>
            </tr>
          {/each}
        </tbody>
      </table>
    {/if}
  </Card>

  <div class="cluster">
    <Button tone="primary" id="save-settings" disabled={saving} onclick={save}>
      {saving ? 'Saving…' : unset ? 'Create settings' : 'Save settings'}
    </Button>
    {#if !unset}
      <Button treatment="ghost" onclick={load}>Discard changes</Button>
    {/if}
  </div>
{/if}
