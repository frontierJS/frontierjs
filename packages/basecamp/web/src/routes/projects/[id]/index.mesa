---
title: Project
---
<script>
  import { page, goto } from '@frontierjs/sierra/router'
  import { projects } from '../../../resources/Project.mesa'
  import { messageFor } from '../../../lib/errors.js'
  import { environments } from '../../../resources/Environment.mesa'
  import { apps } from '../../../resources/App.mesa'
  import Alert    from '@frontierjs/ui/components/feedback/Alert.mesa'
  import Button   from '@frontierjs/ui/components/forms/Button.mesa'
  import Select   from '@frontierjs/ui/components/forms/Select.mesa'
  import Input    from '@frontierjs/ui/components/forms/Input.mesa'
  import Table    from '@frontierjs/ui/components/display/Table.mesa'
  import TabList  from '@frontierjs/ui/components/layout/TabList.mesa'
  import Tab      from '@frontierjs/ui/components/layout/Tab.mesa'
  import NavIcon  from '../../../components/NavIcon.mesa'
  import NoRecord from '../../../components/NoRecord.mesa'
  import VariablesEditor from '../../../components/VariablesEditor.mesa'
  import { offerUndo } from '../../../resources/Trash.mesa'

  $: page.params
  $: page.query.env

  let project   = null
  let error     = null
  let loadError = null
  let loading   = true

  // Renaming happens in place rather than on a separate edit page: a project
  // has three editable fields, and a round trip to another route to change one
  // of them is ceremony.
  let editing = false
  // `version` is in the draft on purpose. Project declares @version, and the
  // resource otherwise fills one in from what the STORE holds — which a live
  // push moves while this draft sits still, so the save would carry a version
  // nobody here read and quietly win the race it exists to lose. A stated one
  // wins over the remembered one, which is the documented way to pin it.
  let draft   = { name: '', description: '', version: null }

  // Watched, not read. `service.get(id)` answers a plain object and nothing
  // reaches a plain object — not a push, not a job, not another tab — so this
  // screen looked correct the whole time and was stale from the moment somebody
  // else wrote the row, because it re-reads after its OWN actions and never
  // after anyone else's (`FJS-533`).
  let rowView = null, unwatch = null

  function watchRow() {
    rowView?.release()
    unwatch?.()
    rowView = projects.record(page.params.id)
    unwatch = rowView.subscribe(v => { project = v })
    return rowView.ready
  }

  $.onDestroy(() => { unwatch?.(); rowView?.release() })

  // This project's environments: an EMBEDDED list, so its state is local — the
  // address bar belongs to the project — and `projectId` is its scope rather
  // than a filter. The workspace is already on the header. A different project
  // is a different route key, and the router remounts this page for it, so a
  // scope read once here cannot go stale.
  const envList = environments.tethered({ state: 'local', where: { projectId: page.params.id } })

  // Every app in every environment of this project. An App belongs to one
  // Environment, so "the api app" across environments is the rows sharing a
  // slug; a slug that differs between environments shows as two apps.
  const appList = apps.tethered({ state: 'local', composed: true, where: { projectId: page.params.id } })

  // Production first: it is the environment a person opening a project most
  // often means. The selection is `?env=<slug>`, so a link carries it.
  $: tierOrder = environments.fields?.tier?.enum ?? []
  $: envs      = [...envList.rows].sort((a, b) => tierOrder.indexOf(b.tier) - tierOrder.indexOf(a.tier))
  $: env       = envs.find(e => e.slug === page.query?.env) ?? envs[0] ?? null
  $: envById   = Object.fromEntries(envs.map(e => [e.id, e]))

  $: appGroups = groupBySlug(appList.rows)

  function groupBySlug(rows) {
    const out = new Map()
    for (const app of rows) {
      if (!out.has(app.slug)) out.set(app.slug, { slug: app.slug, byEnv: {} })
      out.get(app.slug).byEnv[app.environmentId] = app
    }
    return [...out.values()].sort((a, b) => a.slug.localeCompare(b.slug))
  }

  const primaryHost = (app) => app?.domains?.find(d => d.isPrimary)?.hostname ?? null
  const envHref     = (e) => `/projects/${page.params.id}/?env=${e.slug}`

  async function load() {
    error = null; loadError = null; loading = true
    try {
      await watchRow()
      draft   = fromRow(project)
    } catch (e) {
      // A project in another workspace answers 404, not 403 — an id you cannot
      // see should not be confirmable by asking.
      error = e.message; loadError = e
    } finally {
      loading = false
    }
  }

  load()
  $: page.params.id, () => load()

  const fromRow = row => ({ name: row.name, description: row.description ?? '', version: row.version })

  async function save() {
    error = null
    try {
      project = await projects.service.patch(project.id, draft)
      // Reseed from the answer, version included: a second save off the old
      // draft would carry the version this one just consumed and 409 on a race
      // that did not happen.
      draft   = fromRow(project)
      editing = false
    } catch (e) { error = messageFor(projects, e) }
  }

  async function remove() {
    error = null
    try {
      const { id, name } = project
      await projects.service.remove(id)
      offerUndo(name, projects, id)
      goto('/projects/')
    } catch (e) { error = e.message }
  }

  // Environments are created from here because a tier is only meaningful
  // inside a project — there is no useful "all environments" screen.
  let newTier = 'development'
  let adding  = false

  async function addEnvironment() {
    error = null; adding = true
    try {
      await environments.service.create({
        projectId:   project.id,
        name:        newTier[0].toUpperCase() + newTier.slice(1),
        slug:        newTier,
        tier:        newTier,
        isProtected: newTier === 'production',
      })
      // Asked again rather than waited for: the row this call wrote is the one a
      // person is looking for, and a push is a second path it may not take.
      await envList.reload()
    } catch (e) {
      error = e.message
    } finally {
      adding = false
    }
  }

  // The tier list is not written here. It comes from the enum in
  // db/schema.lite, through the JSON Schema the build generated — so adding a
  // tier to the schema adds it to this picker with no edit.
  $: tiers = environments.fields?.tier?.enum ?? ['development', 'staging', 'production']
  const APP_COLUMNS = [
    { name: 'name',   label: 'Name' },
    { name: 'type',   label: 'Type' },
    { name: 'status', label: 'Status' },
    { name: 'domain', label: 'Domain' },
    { name: 'also',   label: 'Also in' },
  ]
</script>

{#if loading}
  <p class="text-sm text-muted">Loading…</p>
{:else if project}
  <div class="section-header">
    <h1>{project.name}</h1>
    <div class="cluster">
      <Button treatment="ghost" href="/projects/">All projects</Button>
      <Button treatment="outlined" onclick={() => editing = !editing}>
        {editing ? 'Cancel' : 'Edit'}
      </Button>
      <Button treatment="ghost" tone="danger"
              data-confirm={`${project.name} is deleted with every environment, app and job inside it. Trash brings all of it back.`}
              data-confirm-title="Delete this project?" data-confirm-label="Delete project"
              onclick={remove}>Delete</Button>
    </div>
  </div>

  {#if error}
    <Alert tone="danger">{error}</Alert>
  {/if}

  {#if editing}
    <div class="container narrow">
      <form class="card stack" onsubmit|preventDefault={save}>
        <Input label="Name" name="name" id="name" required
               value={draft.name} oninput={(e) => draft.name = e.target.value} />
        <Input label="Description" name="description" id="description"
               value={draft.description} oninput={(e) => draft.description = e.target.value} />
        <div class="cluster">
          <Button tone="primary" type="submit">Save</Button>
        </div>
      </form>
    </div>
  {:else}
    <dl class="facts">
      <dt>Slug</dt>      <dd><code>{project.slug}</code></dd>
      <dt>Status</dt>    <dd><span class="pill">{project.status}</span></dd>
      <dt>Description</dt><dd>{project.description ?? '—'}</dd>
    </dl>
  {/if}

  {#if envList.error}
    <article class="alert danger">
      <div class="alert-content">{envList.error.message}</div>
    </article>
  {/if}

  <div class="split" style:align-items="start" style:flex-wrap="wrap" style:gap="1.5rem" id="project-layout">
    <div class="stack" style:flex="1 1 32rem" style:min-width="0">
      {#if !env}
        <article class="alert info">
          <div class="alert-content">No environments yet. An app lives in an environment, so add one first — each tier exists once per project.</div>
        </article>
      {:else}
        <div class="section-header">
          <h2 class="h4">Apps <span class="text-muted">· {env.name}</span></h2>
          <Button treatment="outlined" href={`/environments/${env.id}/`} id="project-add-app">Add app</Button>
        </div>

        {#if appList.error}
          <article class="alert danger">
            <div class="alert-content">{appList.error.message}</div>
          </article>
        {/if}

        {#if !appGroups.length}
          <article class="alert info">
            <div class="alert-content">No apps in this project yet.</div>
          </article>
        {:else}
          <Table id="project-apps" columns={APP_COLUMNS} rows={appGroups} striped>
            {#snippet row(group)}
              <tr>
                {#if group.byEnv[env.id]}
                  <td><a href={`/apps/${group.byEnv[env.id].id}/`}>{group.byEnv[env.id].name}</a></td>
                  <td><code>{group.byEnv[env.id].type}</code></td>
                  <td>
                    <span class="pill" class:success={group.byEnv[env.id].status === 'running'}
                                       class:danger={group.byEnv[env.id].status === 'error'}>{group.byEnv[env.id].status}</span>
                  </td>
                  <td>
                    {#if primaryHost(group.byEnv[env.id])}
                      <code>{primaryHost(group.byEnv[env.id])}</code>
                      <a href={`https://${primaryHost(group.byEnv[env.id])}`} target="_blank" rel="noopener"
                         aria-label={`Open ${primaryHost(group.byEnv[env.id])} in a new tab`}><NavIcon name="external" /></a>
                    {:else}<code>—</code>{/if}
                  </td>
                {:else}
                  <td class="text-muted">{group.slug}</td>
                  <td colspan="3" class="text-sm text-muted">not in {env.name}</td>
                {/if}
                <td class="cluster text-sm">
                  {#each Object.entries(group.byEnv).filter(([id]) => id !== env.id) as [id, app] (id)}
                    <a href={`/apps/${app.id}/`}>{envById[id]?.name ?? 'other'}</a>
                  {/each}
                </td>
              </tr>
            {/snippet}
          </Table>
        {/if}

        <h2 class="h4">Variables <span class="text-muted">· {env.name}</span></h2>
        <p class="text-sm text-muted">Every app in {env.name} starts with these. An app's own variable of the same key wins.</p>
        <VariablesEditor environmentId={env.id} idPrefix="var" />
      {/if}
    </div>

    <aside class="stack" style:flex="0 1 18rem" style:min-width="0" id="project-envs" aria-label="Environments">
      <h2 class="h4">Environment</h2>
      {#if envs.length}
        <TabList nav variant="pills" label="Environment">
          {#each envs as e (e.id)}
            <Tab href={envHref(e)} current={e.id === env?.id}>{e.name}</Tab>
          {/each}
        </TabList>
      {/if}

      {#if env}
        <dl class="facts" id="project-env-facts">
          <dt>Tier</dt>      <dd><span class="pill">{env.tier}</span></dd>
          <dt>Protected</dt> <dd>{env.isProtected ? 'yes' : 'no'}</dd>
        </dl>
        <a href={`/environments/${env.id}/`} id="env-open">Releases and settings</a>
      {/if}

      <div class="cluster">
        <label class="visually-hidden" for="tier-select">Tier</label>
        <Select id="tier-select" style="--field-inline-size: auto"
                placeholder="" options={tiers} bind:value={newTier} />
        <Button treatment="outlined" onclick={addEnvironment} disabled={adding}>
          {adding ? 'Adding…' : 'Add environment'}
        </Button>
      </div>
    </aside>
  </div>
{:else}
  <NoRecord error={loadError} noun="Project" onretry={load}
            backHref="/projects/" backLabel="Back to projects" />
{/if}
