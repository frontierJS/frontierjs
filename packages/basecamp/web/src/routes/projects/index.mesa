---
title: Projects
---
<script>
  import { session } from '../../session.js'
  import { projects } from '../../resources/Project.mesa'
  import { useStore } from '@frontierjs/sierra/junction'
  import { $onDestroy } from '@frontierjs/mesa/runtime'
  import Button from '@frontierjs/ui/components/forms/Button.mesa'
  import Table  from '@frontierjs/ui/components/display/Table.mesa'

  const { get: rows, unsubscribe } = useStore(projects.store)
  $onDestroy(unsubscribe)

  $: session.workspaceId

  let error   = null
  let loading = true

  async function load() {
    error = null; loading = true
    // No workspace filter is passed: the client stamps X-Workspace-Id on every
    // request. A page that had to remember to filter by workspace would
    // eventually forget, and that is a tenancy leak rather than a missing where.
    try { await projects.load() } catch (e) { error = e.message } finally { loading = false }
  }

  load()
  $: session.workspaceId, () => load()

  async function remove(project) {
    error = null
    try {
      await projects.service.remove(project.id)
      // The store drops the row on its own — the service publishes `removed`
      // and useStore is subscribed. load() again would also work and costs a
      // round trip to learn what we already know.
    } catch (e) {
      error = e.message
    }
  }
  const PROJECT_COLUMNS = [
    { key: 'name',    label: 'Name' },
    { key: 'slug',    label: 'Slug' },
    { key: 'status',  label: 'Status' },
    { key: 'actions', label: 'Actions', hideLabel: true },
  ]
</script>

<div class="section-header">
  <h1>Projects</h1>
  <Button variant="primary" href="/projects/create/">New project</Button>
</div>

{#if error}
  <article class="alert danger">
    <div class="alert-content">{error}</div>
  </article>
{/if}

{#if loading}
  <p class="text-sm text-muted">Loading…</p>
{:else if !rows().length}
  <article class="alert info">
    <div class="alert-content">
      No projects in this workspace yet. <a href="/projects/create/">Create one</a>, or seed the example fleet with <code>bun run db:seed</code>.
    </div>
  </article>
{:else}
  <Table id="project-rows" columns={PROJECT_COLUMNS} rows={rows()} striped>
    {#snippet row(project)}
      <tr>
        <td><a href={`/projects/${project.id}/`}>{project.name}</a></td>
        <td><code>{project.slug}</code></td>
        <td><span class="pill">{project.status}</span></td>
        <td>
          <div class="cluster">
            <Button variant="ghost" href={`/projects/${project.id}/`}>Open</Button>
            <!-- Not disabled by a permission check. The schema declares no
                 @@gate yet, so the client can only guess — and the server
                 refuses regardless. A button that lies about what will
                 happen is worse than one that reports the refusal. -->
            <Button variant="ghost" tone="danger" onclick={() => remove(project)}>Delete</Button>
          </div>
        </td>
      </tr>
    {/snippet}
  </Table>
{/if}
