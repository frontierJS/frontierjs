---
title: Projects
---
<script>
  import { session } from '../../session.js'
  import { projects } from '../../resources/Project.mesa'
  import Button from '@frontierjs/ui/components/forms/Button.mesa'
  import Table  from '@frontierjs/ui/components/display/Table.mesa'
  import { offerUndo } from '../../resources/Trash.mesa'

  // No workspace filter is passed: the client stamps X-Workspace-Id on every
  // request. A page that had to remember to filter by workspace would
  // eventually forget, and that is a tenancy leak rather than a missing where.
  const list = projects.tethered({ state: 'local' })
  const rows = () => list.rows

  let error = null

  $: session.workspaceId, () => list.reload()

  async function remove(project) {
    error = null
    try {
      await projects.service.remove(project.id)
      offerUndo(project.name, projects, project.id)
      // The tether drops the row on its own — the service publishes `removed`.
      // A reload would cost a round trip to learn what we already know.
    } catch (e) {
      error = e.message
    }
  }
  const PROJECT_COLUMNS = [
    { name: 'name',    label: 'Name' },
    { name: 'slug',    label: 'Slug' },
    { name: 'status',  label: 'Status' },
    { name: 'actions', label: 'Actions', hideLabel: true },
  ]
</script>

<div class="section-header">
  <h1>Projects</h1>
  <Button tone="primary" href="/projects/create/">New project</Button>
</div>

{#if error || list.error}
  <article class="alert danger">
    <div class="alert-content">{error ?? list.error.message}</div>
  </article>
{/if}

{#if list.loading && !rows().length}
  <p class="text-sm text-muted">Loading…</p>
{:else if !rows().length}
  <article class="alert info">
    <div class="alert-content">
      No projects in this workspace yet. <a href="/projects/create/">Create one</a>, or seed the example fleet with <code>bun run db:seed</code>.
    </div>
  </article>
{:else}
  <Table id="project-rows" columns={PROJECT_COLUMNS} rows={rows()} striped>
    {#snippet row(project)}
      <tr>
        <td><a href={`/projects/${project.id}/`}>{project.name}</a></td>
        <td><code>{project.slug}</code></td>
        <td><span class="pill">{project.status}</span></td>
        <td>
          <div class="cluster">
            <Button treatment="ghost" href={`/projects/${project.id}/`}>Open</Button>
            <!-- Not disabled by a permission check. The schema declares no
                 @@gate yet, so the client can only guess — and the server
                 refuses regardless. A button that lies about what will
                 happen is worse than one that reports the refusal. -->
            <Button treatment="ghost" tone="danger"
                    data-confirm={`${project.name} is deleted with every environment, app and job inside it.`}
                    data-confirm-title="Delete this project?" data-confirm-label="Delete project"
                    onclick={() => remove(project)}>Delete</Button>
          </div>
        </td>
      </tr>
    {/snippet}
  </Table>
{/if}
