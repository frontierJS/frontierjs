  .decide-actions { display: flex; flex-wrap: wrap; gap: var(--space-xs); }
  .decide-actions :global(.btn) { flex: 1; min-block-size: 3rem; justify-content: center; }
  .decide-actions :global(#decide-accept) { flex: 2.5; }
  .decide-hint { margin: 0; text-align: center; }
  @media (pointer: coarse) { .decide-hint { display: none; } }

  .decide-undo {
    position: relative;
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: var(--space-sm);
    padding: var(--space-xs) var(--space-sm);
