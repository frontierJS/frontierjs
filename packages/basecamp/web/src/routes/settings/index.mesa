---
title: Your settings
---
<script>
  // The mock's UserSettingsView — the caller's own account.
  //
  // Four of its five tabs are real here and the fifth is honestly absent:
  //
  //   Profile        the caller's own User row, `users.get('me')`, edited by
  //                  User.mesa's default form. The address and the standing
  //                  come from `client.auth.me()`, the session, and are not
  //                  a person's to edit.
  //   Password       `client.auth.changePassword` — the current one is required
  //                  by the server, which is the whole point of the control.
  //   Notifications  the new `notification-preferences` service.
  //   Sessions       `client.auth.sessions()` — every live sign-in, revocable.
  //   Two-step       `client.auth.setupTotp` → `confirmTotp`; three of the four
  //                  writes re-ask for the password, because they change what
  //                  signing in requires and an open session on a shared
  //                  machine is not the account holder.
  //
  // ─── Why this reaches client.auth and not a resource ────────────────────
  //
  // `account` and `sessions` are auth's own services, and the client already
  // holds the half that knows both prefixes and the token. A resource over
  // `account` would also have to state `model: 'User'` — because
  // `modelNameFor('account')` resolves this app's ORGANIZATION model, which is
  // a different table entirely and would generate a form for the wrong thing.
  //
  // ─── Why the preference rows are not `find`'s rows ──────────────────────
  //
  // The service answers seven kinds and stores fewer: a row exists only where
  // somebody has chosen, and what comes back is stored merged over the kind's
  // default. `source` is what separates *defaulted to on* from *turned on*, and
  // this screen renders that distinction rather than flattening it — a person
  // resetting a kind has to be able to see that it went back to a default
  // rather than to off.
  import { getClient } from '@frontierjs/sierra/junction'
  import { session, currentWorkspace, reloadWorkspaces } from '../../session.js'
  import { ago }       from '../../datetime.js'
  import { notificationPreferences as prefs } from '../../resources/NotificationPreference.mesa'
  import User, { users } from '../../resources/User.mesa'
  import { workspaces } from '../../resources/Workspace.mesa'

  import Badge      from '@frontierjs/ui/components/display/Badge.mesa'
  import Button     from '@frontierjs/ui/components/forms/Button.mesa'
  import Callout    from '@frontierjs/ui/components/display/Callout.mesa'
  import Card       from '@frontierjs/ui/components/layout/Card.mesa'
  import CopyButton from '@frontierjs/ui/components/display/CopyButton.mesa'
  import Mono       from '@frontierjs/ui/components/display/Mono.mesa'
  import Input      from '@frontierjs/ui/components/forms/Input.mesa'
  import Pill       from '@frontierjs/ui/components/display/Pill.mesa'
  import Switch     from '@frontierjs/ui/components/forms/Switch.mesa'
  import Table      from '@frontierjs/ui/components/display/Table.mesa'
  import { toasts } from '@frontierjs/ui/stores/toastStore.js'

  // The standing pill reads the membership row out of `session.workspaces` and
  // picks it with `session.workspaceId`; watching `session.user` alone leaves it
  // showing the previous workspace's role after a switch.
  $: (session.user, session.workspaces, session.workspaceId, session.canMail)

  let me        = null
  let profile   = null
  let kinds     = []
  let sessions  = []
  let error     = null
  let loading   = true
  let busy      = null

  let current   = ''
  let next      = ''
  let confirm   = ''
  let pwError   = null
  let changing  = false

  let totp          = null   // { enabled, recoveryCodesRemaining }
  let enrollment    = null   // { secret, qr } between setup and confirm
  let recoveryCodes = []     // shown once, straight after they are issued
  let totpPassword  = ''
  let totpCode      = ''
  let totpError     = null

  async function load() {
    error = null; loading = true
    try {
      const client = getClient()
      me       = await client.auth.me()
      profile  = await users.service.get('me')
      sessions = await client.auth.sessions()
      kinds    = (await prefs.service.find()).data
      totp     = await client.auth.totpStatus()
    } catch (e) {
      error = e.message
    } finally {
      loading = false
    }
  }

  load()

  async function toggle(kind, transport, value) {
    error = null; busy = `${kind.kind}:${transport}`
    try {
      // Only the transport that moved is sent. The service fills the OTHER one
      // from the kind's default when it writes the row for the first time —
      // not from the column's, which would silently reset a transport the
      // person was looking at.
      await prefs.service.invoke('save', null, { kind: kind.kind, [transport]: value })
      kinds = (await prefs.service.find()).data
    } catch (e) {
      error = e.message
    } finally {
      busy = null
    }
  }

  async function reset(kind) {
    error = null; busy = kind.kind
    try {
      await prefs.service.invoke('reset', null, { kind: kind.kind })
      kinds = (await prefs.service.find()).data
      toasts.success(`${kind.label} back to its default`)
    } catch (e) {
      error = e.message
    } finally {
      busy = null
    }
  }

  async function changePassword() {
    pwError = null
    if (next !== confirm) { pwError = 'The two new passwords do not match'; return }
    changing = true
    try {
      await getClient().auth.changePassword(current, next)
      current = ''; next = ''; confirm = ''
      toasts.success('Password changed. Your other sessions stay signed in.')
    } catch (e) {
      // 'Current password is incorrect' arrives here. Never checked in the
      // browser: the only copy of the password is the server's hash.
      pwError = e.message
    } finally {
      changing = false
    }
  }

  async function revoke(s) {
    error = null; busy = s.id
    try {
      await getClient().auth.revokeSession(s.id)
      sessions = await getClient().auth.sessions()
      toasts.success('Session revoked')
    } catch (e) {
      error = e.message
    } finally {
      busy = null
    }
  }

  async function revokeOthers() {
    error = null; busy = 'others'
    try {
      const { revoked } = await getClient().auth.revokeOtherSessions()
      sessions = await getClient().auth.sessions()
      toasts.success(`Signed out of ${revoked} other session(s)`)
    } catch (e) {
      error = e.message
    } finally {
      busy = null
    }
  }

  // ─── Leaving the workspace ────────────────────────────────────────────
  // The only owner is refused by the server with the sentence that says what
  // to do instead, so the button is not hidden for them: hiding it would leave
  // them looking for a control that does not exist.
  $: here = (session.workspaces, session.workspaceId, currentWorkspace())

  async function leave() {
    error = null; busy = 'leave'
    const name = here?.name ?? 'the workspace'
    try {
      await workspaces.service.invoke('leave', here.id)
      await reloadWorkspaces()
      toasts.success(`You left ${name}`)
    } catch (e) {
      error = e.message
    } finally {
      busy = null
    }
  }

  // ─── Email ────────────────────────────────────────────────────────────
  // auth puts `verifiedAt: null` on the session of an unverified address and
  // leaves the key off otherwise, so absence is verified.
  $: unverified = me != null && 'verifiedAt' in me && me.verifiedAt == null

  async function resendVerification() {
    error = null; busy = 'verify'
    try {
      await getClient().auth.requestEmailVerification()
      toasts.success(`Verification sent. Check ${me.email} for the link.`)
    } catch (e) {
      error = e.message
    } finally {
      busy = null
    }
  }

  // ─── Two-step sign-in ─────────────────────────────────────────────────
  async function totpStep(fn) {
    totpError = null; busy = 'totp'
    try { await fn(getClient().auth) } catch (e) { totpError = e.message } finally { busy = null }
  }

  const beginTotp = () => totpStep(async a => {
    enrollment   = await a.setupTotp(totpPassword)
    totpPassword = ''
  })

  const confirmTotp = () => totpStep(async a => {
    recoveryCodes = (await a.confirmTotp(totpCode.trim())).recoveryCodes
    enrollment    = null
    totpCode      = ''
    totp          = await a.totpStatus()
    toasts.success('Two-step sign-in is on')
  })

  const regenerateCodes = () => totpStep(async a => {
    recoveryCodes = (await a.regenerateRecoveryCodes(totpPassword)).recoveryCodes
    totpPassword  = ''
    totp          = await a.totpStatus()
  })

  const disableTotp = () => totpStep(async a => {
    await a.disableTotp(totpPassword)
    totpPassword  = ''
    recoveryCodes = []
    totp          = await a.totpStatus()
    toasts.info('Two-step sign-in is off')
  })

  // The pending secret stays on the server until the next setup supersedes it;
  // only a confirmed factor is asked for at sign-in.
  const abandonTotp = () => { enrollment = null; totpCode = ''; totpError = null }

  const SESSION_COLUMNS = [
    { name: 'where', label: 'Where' },
    { name: 'seen',  label: 'Last seen' },
    { name: 'act',   label: '' },
  ]
</script>

<div class="section-header">
  <h1>Your settings</h1>
  {#if me}<span class="text-sm text-muted">{me.email}</span>{/if}
</div>

{#if error}
  <article class="alert danger" id="screen-error">
    <div class="alert-content">{error}</div>
  </article>
{/if}

{#if loading}
  <p class="text-sm text-muted">Loading…</p>
{:else}

  <Card id="settings-profile">
    <h2 class="h5">Profile</h2>
    <User record={profile} submitId="profile-save"
          ondone={(row) => { profile = row; toasts.success('Profile saved') }} />
    <dl class="datalist">
      <div><dt>Email</dt><dd>
        <span class="cluster">
          {me?.email}
          {#if unverified}
            <Pill tone="warning">not verified</Pill>
            <Button variant="ghost" id="resend-verification" disabled={busy === 'verify'}
                    onclick={resendVerification}>Send the link again</Button>
          {/if}
        </span>
      </dd></div>
      <div><dt>Standing</dt><dd>
        <span class="cluster">
          {#if session.user?.isSystemAdmin}<Pill tone="warning">system admin</Pill>{/if}
          <Pill tone="muted" id="standing-role">{here?.role ?? 'no membership'} here</Pill>
          {#if here?.role}
            <Button variant="ghost" tone="danger" id="leave-workspace" disabled={busy === 'leave'}
                    data-confirm={`You lose access to ${here.name}. Somebody there has to invite you back.`}
                    data-confirm-title={`Leave ${here.name}?`} data-confirm-label="Leave"
                    onclick={leave}>Leave {here.name}</Button>
          {/if}
        </span>
      </dd></div>
    </dl>
  </Card>

  <Card id="settings-password">
    <h2 class="h5">Password</h2>
    {#if pwError}
      <article class="alert danger" id="password-error">
        <div class="alert-content">{pwError}</div>
      </article>
    {/if}
    <Input id="pw-current" name="currentPassword" type="password" label="Current password"
           autocomplete="current-password" value={current}
           oninput={(e) => current = e.target.value} />
    <Input id="pw-new" name="newPassword" type="password" label="New password"
           autocomplete="new-password" value={next}
           hint="At least 8 characters"
           oninput={(e) => next = e.target.value} />
    <Input id="pw-confirm" name="confirmPassword" type="password" label="Confirm new password"
           autocomplete="new-password" value={confirm}
           oninput={(e) => confirm = e.target.value} />
    <Button variant="primary" id="change-password" disabled={changing || !current || !next}
            onclick={changePassword}>
      {changing ? 'Changing…' : 'Change password'}
    </Button>
  </Card>

  <Card id="settings-notifications">
    <div class="section-header">
      <h2 class="h5">Notifications</h2>
      <span class="text-sm text-muted">{kinds.filter(k => k.source === 'chosen').length} of {kinds.length} chosen</span>
    </div>

    <p class="text-sm text-muted">
      A kind you have never touched follows its default. <em>Default</em> below means exactly
      that — nobody has chosen — which is not the same as having chosen these values, and it is
      why resetting one is its own control rather than switching both off.
    </p>

    <div class="stack" id="notification-kinds">
      {#each kinds as k}
        <div class="section-header">
          <div>
            <strong>{k.label}</strong>
            <Badge tone={k.source === 'chosen' ? 'info' : 'muted'}>{k.source}</Badge>
            <p class="text-sm text-muted">{k.description}</p>
          </div>
          <span class="cluster">
            <!-- `Switch` hands `onchange` a BOOLEAN, not an event — `Input`
                 hands `oninput` an event, and mixing the two reads a property
                 of `undefined` and leaves the control looking dead. -->
            <Switch id={`notify-${k.kind}-email`} label="Email" checked={k.email}
                    disabled={busy === `${k.kind}:email`}
                    onchange={(checked) => toggle(k, 'email', checked)} />
            <Switch id={`notify-${k.kind}-inapp`} label="In app" checked={k.inApp}
                    disabled={busy === `${k.kind}:inApp`}
                    onchange={(checked) => toggle(k, 'inApp', checked)} />
            {#if k.source === 'chosen'}
              <Button variant="ghost" disabled={busy === k.kind}
                      aria-label={`Reset ${k.label} to its default`}
                      onclick={() => reset(k)}>Reset</Button>
            {/if}
          </span>
        </div>
      {/each}
    </div>

    <p class="text-sm text-muted" id="notification-delivery">
      {#if session.canMail}
        Email goes out as soon as the kind fires.
      {:else}
        <strong>This Basecamp has no mail provider</strong>, so an Email switch is kept for when
        one is set and nothing is mailed until then.
      {/if}
      In-app ones land in <a href="/notifications/">your notifications</a> and the bell in the top bar.
    </p>
  </Card>

  <Card id="settings-sessions">
    <div class="section-header">
      <h2 class="h5">Where you are signed in</h2>
      {#if sessions.length > 1}
        <Button variant="outlined" id="revoke-others" disabled={busy === 'others'}
                data-confirm="Every other browser and device signed in as you is signed out."
                data-confirm-title="Sign out everywhere else?" data-confirm-label="Sign out" data-confirm-tone="warning"
                onclick={revokeOthers}>Sign out everywhere else</Button>
      {/if}
    </div>

    <Table columns={SESSION_COLUMNS} rows={sessions} striped hover={false}>
      {#snippet row(s)}
        <tr>
          <td class="text-sm">
            {s.userAgent ?? 'unknown device'}
            {#if s.current}<Pill tone="success">this one</Pill>{/if}
            <div class="text-sm text-muted">{s.ip ?? ''}</div>
          </td>
          <td class="text-sm text-muted">{ago(s.lastSeenAt ?? s.createdAt)}</td>
          <td>
            {#if !s.current}
              <Button variant="ghost" disabled={busy === s.id}
                      aria-label="Revoke this session"
                      onclick={() => revoke(s)}>Revoke</Button>
            {/if}
          </td>
        </tr>
      {/snippet}
    </Table>
  </Card>

  <Card id="settings-totp" data-totp-state={totp ? (totp.enabled ? 'on' : 'off') : 'loading'}>
    <div class="cluster">
      <h2 class="h5">Two-step sign-in</h2>
      {#if totp}<Pill tone={totp.enabled ? 'success' : 'muted'}>{totp.enabled ? 'on' : 'off'}</Pill>{/if}
    </div>

    {#if totpError}
      <article class="alert danger" id="totp-error">
        <div class="alert-content">{totpError}</div>
      </article>
    {/if}

    {#if recoveryCodes.length}
      <!-- First on the card: this is the only time they exist in readable form. -->
      <Callout tone="warning" title="Save these recovery codes now">
        Each one signs you in once, in place of a code. They are not shown again.
      </Callout>
      <ol class="stack" id="recovery-codes">
        {#each recoveryCodes as rc}
          <li><Mono data-recovery-code>{rc}</Mono></li>
        {/each}
      </ol>
      <div class="cluster">
        <CopyButton text={recoveryCodes.join('\n')} label="Copy all" variant="outlined" />
        <Button variant="ghost" id="recovery-done" onclick={() => { recoveryCodes = [] }}>I have saved them</Button>
      </div>
    {:else if !totp}
      <p class="text-sm text-muted">Asking…</p>
    {:else if enrollment}
      <!-- No QR image: this app ships no encoder. The secret and the
           otpauth:// link are both what an authenticator accepts by hand. -->
      <p class="text-sm">Add this account to your authenticator app, then type the six-digit code it shows.</p>
      <div class="cluster">
        <Mono id="totp-secret">{enrollment.secret}</Mono>
        <CopyButton text={enrollment.secret} label="Copy secret" />
        <CopyButton text={enrollment.qr} label="Copy otpauth:// link" variant="outlined" />
      </div>
      <form class="stack" novalidate onsubmit={e => { e.preventDefault(); confirmTotp() }}>
        <Input id="totp-code" name="code" label="Code from the app" autocomplete="one-time-code"
               inputmode="numeric" required value={totpCode} oninput={e => totpCode = e.target.value} />
        <div class="cluster">
          <Button type="submit" variant="primary" id="totp-confirm" disabled={busy === 'totp'}>Turn it on</Button>
          <Button variant="ghost" id="totp-abandon" onclick={abandonTotp}>Cancel</Button>
        </div>
      </form>
    {:else if !totp.enabled}
      <p class="text-sm text-muted">Signing in asks for your password only. Turn this on and it also asks for a code from an app on your phone.</p>
      <form class="stack" novalidate onsubmit={e => { e.preventDefault(); beginTotp() }}>
        <Input id="totp-password" name="currentPassword" type="password" label="Your password"
               hint="Asked again because this changes how you sign in" autocomplete="current-password"
               required value={totpPassword} oninput={e => totpPassword = e.target.value} />
        <div class="cluster">
          <Button type="submit" variant="primary" id="totp-enable" disabled={busy === 'totp' || !totpPassword}>Set up two-step sign-in</Button>
        </div>
      </form>
    {:else}
      <p class="text-sm">
        Signing in asks for a code as well as your password.
        <span id="totp-remaining">{totp.recoveryCodesRemaining}</span>
        recovery {totp.recoveryCodesRemaining === 1 ? 'code' : 'codes'} left.
      </p>
      <div class="stack">
        <Input id="totp-password" name="currentPassword" type="password" label="Your password"
               hint="Needed for either of these" autocomplete="current-password"
               value={totpPassword} oninput={e => totpPassword = e.target.value} />
        <div class="cluster">
          <Button variant="outlined" id="totp-regenerate" disabled={busy === 'totp' || !totpPassword}
                  data-confirm="Every recovery code you saved stops working."
                  data-confirm-title="Replace your recovery codes?" data-confirm-label="Replace"
                  onclick={regenerateCodes}>New recovery codes</Button>
          <Button variant="outlined" tone="danger" id="totp-disable" disabled={busy === 'totp' || !totpPassword}
                  data-confirm="Signing in asks for your password only."
                  data-confirm-title="Turn off two-step sign-in?" data-confirm-label="Turn off"
                  onclick={disableTotp}>Turn it off</Button>
        </div>
      </div>
    {/if}
  </Card>
{/if}
