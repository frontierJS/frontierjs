---
title: Dashboard
---
<script>
  // The mock's DashboardDetailView + AddTileModal — one board, its tiles,
  // and the picker that adds one.
  //
  // **Nothing on this page reads on the board's behalf.** Each card asks the
  // service that owns its data, with the reader's own session — so a dashboard
  // can show exactly what its reader could have opened, and a card they may not
  // read says so instead of quietly appearing for everyone. That is the whole
  // reason a tile names a KIND rather than carrying a query: a stored query
  // would be run by the server for whoever opened the page, graded against
  // nothing.
  //
  // **The picker is built from the service's own vocabulary**, fetched through
  // the collection-level `kinds` action rather than shipped in this bundle. A
  // list retyped here would drift from what the service accepts, and the
  // failure would be an option that exists until you press it.
  //
  // The mock's picker is a modal. This is an inline panel, like every other
  // create form in this app: the same three fields, one fewer layer to trap
  // focus in, and it survives being the only thing on a narrow screen.
  import { page, goto } from '@frontierjs/sierra/router'
  import { createRoot } from '@frontierjs/mesa/runtime'
  import Dashboard, { dashboards } from '../../../resources/Dashboard.mesa'
  import { servers } from '../../../resources/Server.mesa'
  import { apps } from '../../../resources/App.mesa'

  import Button     from '@frontierjs/ui/components/forms/Button.mesa'
  import Card       from '@frontierjs/ui/components/layout/Card.mesa'
  import Drawer     from '@frontierjs/ui/components/overlay/Drawer.mesa'
  import EmptyState from '@frontierjs/ui/components/display/EmptyState.mesa'
  import Input      from '@frontierjs/ui/components/forms/Input.mesa'
  import Select     from '@frontierjs/ui/components/forms/Select.mesa'
  import { toasts } from '@frontierjs/ui/stores/toastStore'
  import Tile   from '../../../components/tiles/Tile.mesa'
  import NoRecord from '../../../components/NoRecord.mesa'
  import { offerUndo } from '../../../resources/Trash.mesa'

  $: page.params

  let board     = null
  let kinds     = []
  let sources   = []          // what a counter may count
  let adapters  = []         // portal ids a service_health tile may name
  let error     = null
  let loadError = null
  let loading   = true
  let busy      = null
  let editing   = false
  let renaming  = false

  // The add-tile panel. `chosen` is the kind spec, not just its name — the
  // second step is built from what that kind needs.
  let adding  = false
  let chosen  = null
  let subject = ''          // server id or app id, depending on the kind
  let config  = {}
  let cols    = 1

  // Subject options, loaded when a kind that takes one is chosen. Not on page
  // load: most boards are read, not edited, and two list requests per visit for
  // a picker nobody opened is two requests too many.
  let serverOptions = []
  let appOptions    = []

  // The board, watched rather than read (`FJS-518`). `dashboards.get()` answers
  // the board WITH its tiles, so this is a COMPOSED view: the node says the
  // row moved and the composed answer is read again. Watching the node's own
  // value would empty the tile list at the first push (`FJS-533`).
  let row     = null
  let unwatch = null

  function watchBoard(id) {
    if (row && String(row.id) === String(id)) return row.refresh()
    unwatch?.(); row?.release()
    row = dashboards.record(id, { composed: true })
    unwatch = row.subscribe(v => { board = v })
    return row.ready
  }

  async function load() {
    error = null; loadError = null
    try {
      await watchBoard(page.params.id)
    } catch (e) {
      error = e.message; loadError = e
    } finally {
      loading = false
    }
  }

  async function loadKinds() {
    try {
      const answer = await dashboards.service.invoke('kinds', null)
      // `answer.kinds`, not `answer.data`: the vocabulary is deliberately not
      // shaped like a list, because a list envelope keeps `total` and `data`
      // and drops every other key without saying so.
      kinds    = answer.kinds ?? []
      sources  = answer.statSources ?? []
      adapters = answer.portalServices ?? []
    } catch (e) {
      // Not fatal: the board still renders. What breaks is adding a tile,
      // and the panel says so rather than offering an empty picker.
      kinds = []
    }
  }

  load()
  loadKinds()
  $: page.params.id, () => load()

  $.onDestroy(() => { unwatch?.(); row?.release() })

  const specFor = (kind) => kinds.find(k => k.kind === kind) ?? null

  async function openPicker() {
    adding = !adding
    chosen = null
    if (!adding) return
    await loadSubjects()
  }

  // Both lists, once, and every row of each rather than a page. Which one is
  // needed depends on the kind chosen next, and fetching then would put a
  // spinner between two clicks. Made under a root on first use, so the `$:`
  // that may ask for them does not dispose them on its next run. A member who
  // cannot list servers can still add the tiles that take no subject; the
  // picker below shows an empty select and says why.
  let subjects = null
  function loadSubjects() {
    if (subjects) return
    subjects = createRoot((dispose) => ({
      servers: servers.tethered({ state: 'local', all: true }),
      // Composed: the apps service includes each app's environment and domains.
      apps:    apps.tethered({ state: 'local', composed: true, directives: { limit: 100 } }),
      dispose,
    }))
  }
  $.onDestroy(() => subjects?.dispose())
  $: {
    serverOptions = (subjects?.servers.rows ?? []).map(s => ({ value: s.id, label: s.name }))
    appOptions    = (subjects?.apps.rows ?? []).map(a => ({ value: a.id, label: a.name }))
  }

  function choose(spec) {
    chosen  = spec
    subject = ''
    cols    = spec.cols
    // The knobs this kind reads, blank. `config` keys the service does not
    // accept are refused by name, so this cannot send one it invented.
    config  = spec.kind === 'stat_counter'   ? { source: sources[0] ?? 'servers', label: '' }
            : spec.kind === 'service_health' ? { serviceId: '' }
            : {}
  }

  async function add() {
    error = null; busy = 'add'
    try {
      board = await dashboards.service.invoke('addTile', board.id, {
        kind: chosen.kind,
        ...(chosen.subject === 'server' ? { serverId: subject || null } : {}),
        ...(chosen.subject === 'app'    ? { appId:    subject || null } : {}),
        config,
        cols,
      })
      toasts.success(`${chosen.label} added`)
      adding = false
      chosen = null
    } catch (e) {
      // 'A Server health tile needs a server', 'not countable here' — both
      // arrive here, and neither is guessable from the form.
      error = e.message
    } finally {
      busy = null
    }
  }

  async function removeTile(tile) {
    error = null; busy = tile.id
    try {
      board = await dashboards.service.invoke('removeTile', board.id, { tileId: tile.id })
    } catch (e) {
      error = e.message
    } finally {
      busy = null
    }
  }

  async function resizeTile(tile, next) {
    error = null; busy = tile.id
    try {
      board = await dashboards.service.invoke('updateTile', board.id, { tileId: tile.id, cols: next })
    } catch (e) {
      error = e.message
    } finally {
      busy = null
    }
  }

  // The whole order, not one move: the service rewrites every position, which
  // is what makes two people rearranging at once end up with one board rather
  // than an interleaving neither chose.
  async function moveTile(tile, direction) {
    const ids = board.tiles.map(w => w.id)
    const at  = ids.indexOf(tile.id)
    const to  = at + direction
    if (at < 0 || to < 0 || to >= ids.length) return

    ids.splice(to, 0, ...ids.splice(at, 1))
    error = null; busy = tile.id
    try {
      board = await dashboards.service.invoke('reorder', board.id, { ids })
    } catch (e) {
      error = e.message
    } finally {
      busy = null
    }
  }

  // ─── The board itself ────────────────────────────────────────────────
  function renamed() {
    renaming = false
    toasts.success('Dashboard saved')
  }

  async function removeBoard() {
    error = null; busy = 'remove'
    // Read before the write: the board is watched, and the delete's own push
    // empties it before the next line runs.
    const { id, name } = board
    try {
      await dashboards.service.remove(id)
      offerUndo(name, dashboards, id)
      goto('/dashboards/')
    } catch (e) {
      error = e.message
      busy  = null
    }
  }

  async function togglePin() {
    error = null; busy = 'pin'
    try {
      // No version stated: the board is a composed view, which re-reads after
      // the push a save causes, so its copy can trail the store's. The resource
      // stamps the one the store holds.
      await dashboards.service.patch(board.id, { isPinned: !board.isPinned })
    } catch (e) {
      error = e.message
    } finally {
      busy = null
    }
  }

  // ─── A tile whose server or app is gone ────────────────────────────
  // The card says `subject removed`; this points it at another one, or — for
  // a kind whose subject is optional — back at the whole workspace.
  let repoint = {}      // tileId → the chosen subject id

  async function repointTile(tile) {
    const spec = specFor(tile.kind)
    const to   = repoint[tile.id] || null
    error = null; busy = tile.id
    try {
      board = await dashboards.service.invoke('updateTile', board.id, {
        tileId: tile.id,
        ...(spec?.subject === 'server' ? { serverId: to } : { appId: to }),
      })
      toasts.success(`${spec?.label ?? tile.kind} re-pointed`)
    } catch (e) {
      error = e.message
    } finally {
      busy = null
    }
  }

  $: orphaned = board ? board.tiles.filter(w => w.subjectMissing).length : 0
  $: (orphaned, () => { if (orphaned) loadSubjects() })

  $: subjectOptions = chosen?.subject === 'server' ? serverOptions
                    : chosen?.subject === 'app'    ? appOptions
                    : []
</script>

{#if loading}
  <p class="text-sm text-muted">Loading…</p>
{:else if !board}
  <NoRecord error={loadError} noun="Dashboard" onretry={load}
            backHref="/dashboards/" backLabel="Back to dashboards" />
{:else}
  <div class="section-header">
    <h1>{board.icon ?? ''} {board.name}</h1>
    <span class="cluster">
      <Button treatment="ghost" id="pin-board" disabled={busy === 'pin'}
              aria-pressed={board.isPinned ? 'true' : 'false'} onclick={togglePin}>
        {board.isPinned ? 'Unpin' : 'Pin to home'}
      </Button>
      <Button treatment="ghost" id="rename-board" onclick={() => renaming = true}>Rename</Button>
      <Button treatment="ghost" tone="danger" id="delete-board" disabled={busy === 'remove'}
              data-confirm={`${board.name} and its tiles are deleted. What they showed is not.`}
              data-confirm-title="Delete this dashboard?" data-confirm-label="Delete"
              onclick={removeBoard}>Delete</Button>
      <Button treatment={editing ? 'outlined' : 'ghost'} id="edit-board"
              onclick={() => editing = !editing}>{editing ? 'Done' : 'Edit layout'}</Button>
      <Button tone="primary" id="add-tile" onclick={openPicker}>
        {adding ? 'Cancel' : 'Add tile'}
      </Button>
    </span>
  </div>

  <p class="text-sm text-muted">
    <a href="/dashboards/">← Dashboards</a>
    {#if board.description} · {board.description}{/if}
  </p>

  <Drawer open={renaming} title={`Rename ${board.name}`} onclose={() => renaming = false}>
    {#if renaming}
      <Dashboard record={board} only={['name', 'description', 'icon']}
                 oncancel={() => renaming = false} ondone={renamed} submitId="board-save" />
    {/if}
  </Drawer>

  {#if error}
    <article class="alert danger" id="screen-error">
      <div class="alert-content">{error}</div>
    </article>
  {/if}

  {#if adding}
    <Card>
      {#if !kinds.length}
        <p class="text-sm text-muted">
          The tile vocabulary could not be read, so nothing can be added right now.
        </p>
      {:else if !chosen}
        <h2 class="h4">Choose a tile</h2>
        <div class="tiles" style="--tile-min: 15rem" id="tile-kinds">
          {#each kinds as spec}
            <Card>
              <h3 class="h5">{spec.label}</h3>
              <p class="text-sm text-muted">{spec.description}</p>
              <Button treatment="outlined" onclick={() => choose(spec)}>Choose</Button>
            </Card>
          {/each}
        </div>
      {:else}
        <h2 class="h4">{chosen.label}</h2>
        <p class="text-sm text-muted">{chosen.description}</p>
        {#if chosen.needs}
          <p class="text-xs text-muted">Not shown on this card: {chosen.needs}.</p>
        {/if}

        {#if chosen.subject}
          <Select id="tile-subject"
                  label={chosen.subject === 'server' ? 'Server' : 'App'}
                  value={subject} options={subjectOptions}
                  placeholder={chosen.required ? 'Pick one' : 'Everything in this workspace'}
                  onchange={(e) => subject = e.target.value} />
        {/if}

        {#if chosen.kind === 'stat_counter'}
          <Select id="tile-source" label="Count" value={config.source} options={sources}
                  onchange={(e) => config = { ...config, source: e.target.value }} />
          <Input id="tile-label" label="Label" value={config.label}
                 hint="What this number is called on the card"
                 oninput={(e) => config = { ...config, label: e.target.value }} />
        {/if}

        {#if chosen.kind === 'service_health'}
          <!-- The adapter ids come from the same answer as the kinds, so this
               cannot offer one the service would refuse. -->
          <Select id="tile-service" label="Service" value={config.serviceId} options={adapters}
                  placeholder="Pick one"
                  onchange={(e) => config = { ...config, serviceId: e.target.value }} />
        {/if}

        <div class="cluster" role="group" aria-label="Width">
          {#each [1, 2, 3] as n}
            <Button treatment={cols === n ? 'outlined' : 'ghost'} onclick={() => cols = n}>{n}/3</Button>
          {/each}
        </div>

        <div class="cluster">
          <Button tone="primary" id="confirm-tile" disabled={busy === 'add'} onclick={add}>
            Add to dashboard
          </Button>
          <Button treatment="ghost" onclick={() => chosen = null}>Back</Button>
        </div>
      {/if}
    </Card>
  {/if}

  {#if !board.tiles.length}
    <EmptyState title="No tiles yet">
      Add cards to build the view you actually check in the morning.
    </EmptyState>
  {:else}
    <!-- Thirds of a row, and the browser handles the wrapping. The mock packs
         tiles into rows in JavaScript, which decides the layout at a width
         nobody is looking at. -->
    <div id="tile-grid"
         style="display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); gap: var(--space-md, 1rem)">
      {#each board.tiles as tile}
        <div style={`grid-column: span ${Math.min(tile.cols ?? 1, 3)}`}>
          <Tile tile={tile} spec={specFor(tile.kind)} editing={editing}
                  onremove={() => removeTile(tile)}
                  onresize={(n) => resizeTile(tile, n)}
                  onmove={(d) => moveTile(tile, d)} />
          {#if tile.subjectMissing}
            <div class="cluster" data-repoint={tile.id}>
              <Select id={`repoint-${tile.id}`} label="" aria-label="Point this tile at"
                      value={repoint[tile.id] ?? ''}
                      placeholder={specFor(tile.kind)?.required ? 'Pick one' : 'Everything in this workspace'}
                      options={specFor(tile.kind)?.subject === 'server' ? serverOptions : appOptions}
                      onchange={(e) => repoint = { ...repoint, [tile.id]: e.target.value }} />
              <Button treatment="outlined" disabled={busy === tile.id || (specFor(tile.kind)?.required && !repoint[tile.id])}
                      onclick={() => repointTile(tile)}>Re-point</Button>
            </div>
          {/if}
        </div>
      {/each}
    </div>
  {/if}
{/if}
