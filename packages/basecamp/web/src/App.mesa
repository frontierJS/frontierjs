<script>
  import { RouterView, beforeNavigate } from '@frontierjs/sierra/router'
  import { session, ready } from './session.js'

  // Registered here, in component setup, on purpose. Sierra defers its boot
  // navigation by a microtask precisely so guards registered during mount are
  // in place before the first route commits — register this anywhere later and
  // a direct load or refresh of a protected URL goes through unguarded, while
  // client-side navigation to the same URL is stopped. See the note at
  // sierra/src/router/index.js ~262.
  beforeNavigate(async ({ to }) => {
    await ready

    const path = to.path.split('?')[0]

    // Order matters. Setup outranks auth: with no account, there is nobody to
    // log in as, and /auth/login would answer 401 forever.
    if (session.needsSetup) return path === '/setup/' ? undefined : '/setup/'
    if (path === '/setup/')  return '/'

    // The one URL a stranger may open. An invitation is addressed to somebody
    // who is not a member yet and may not have an account at all, so a guard
    // that asks for a session here would bounce the entire population the link
    // exists for. The token IS the credential and the service grades it —
    // `invitations.preview` and `.accept` are exempt from sessionScope for the
    // same reason, which is where the actual refusals live.
    if (path.startsWith('/invite/')) return undefined

    if (!session.user) return path === '/login/' ? undefined : '/login/'
    if (path === '/login/') return '/'

    // The hub tier. `isSystemAdmin` reaches the browser on the SessionContext
    // (core/session-auth.ts puts it there from the User column of the same
    // name), so this is a redirect rather than a screen full of refusals.
    //
    // It is an affordance, not the boundary: the hub service answers 404 to
    // anyone without the flag whatever the router does, which is what the
    // refusal actually is. Deleting these two lines changes nothing about who
    // can read another tenant.
    if (path.startsWith('/hub/') && !session.user.isSystemAdmin) return '/'
  })
</script>

<RouterView />
