<script>
  // ActionQueue.mesa — the full half of the mock's attention system.
  //
  // NoticeBar is the shell's condensed view; this is the list the home screen
  // shows: every notice, counted by priority, with the "show N more" fold the
  // mock has. Same rules, same notices — one definition of "needs attention"
  // (src/notices.js), two presentations, and one memory of what was
  // acknowledged (src/dismissals.js) — "Got it" here survives a reload and
  // hides the notice from the bar too.
  //
  // The empty state is not an absence: "All clear" is the answer to a question
  // the operator asked, so it renders as a result rather than as nothing.

  import Badge      from '@frontierjs/ui/components/display/Badge.mesa'
  import Button     from '@frontierjs/ui/components/forms/Button.mesa'
  import Card       from '@frontierjs/ui/components/layout/Card.mesa'
  import EmptyState from '@frontierjs/ui/components/display/EmptyState.mesa'
  import Pill       from '@frontierjs/ui/components/display/Pill.mesa'
  import { goto } from '@frontierjs/sierra/router'
  import { PRIORITY_TONE, noticeCounts } from '../lib/notices.js'
  import { dismissals, dismiss, restore } from '../lib/dismissals.js'

  export let notices = []
  export let fold    = 6      // how many before the fold

  let showAll = false

  $: dismissals.ids

  $: live    = notices.filter(n => !dismissals.ids.includes(n.id))
  $: counts  = noticeCounts(live)
  $: visible = showAll ? live : live.slice(0, fold)
  $: hidden  = live.length - visible.length

  function dismissAll() { dismiss(live.map(n => n.id)) }
</script>

<Card>
  <div class="section-header">
    <h2 class="h4">Needs attention</h2>
    <span class="cluster">
      {#if counts.critical}
        <Badge tone="danger" id="notice-critical">{counts.critical} critical</Badge>
      {/if}
      {#if counts.warning}
        <Badge tone="warning" id="notice-warning">{counts.warning} warning</Badge>
      {/if}
      {#if live.length}
        <Button treatment="ghost" id="notice-dismiss-all" onclick={dismissAll}>Acknowledge all</Button>
      {/if}
    </span>
  </div>

  {#if !live.length}
    <div class="queue-empty">
      <EmptyState title="All clear">No issues detected in this workspace.</EmptyState>
    </div>
    {#if notices.length}
      <Button treatment="ghost" id="notice-restore" onclick={restore}>Show recent ({notices.length})</Button>
    {/if}
  {:else}
    <ul class="stack" id="notice-rows">
      {#each visible as n}
        <li class="cluster">
          <Pill tone={PRIORITY_TONE[n.priority]}>{n.priority}</Pill>
          <span class="stack">
            <strong class="text-sm">{n.title}</strong>
            <span class="text-sm text-muted">{n.detail}</span>
          </span>
          {#if n.href}
            <Button treatment="ghost" onclick={() => goto(n.href)}>{n.action} →</Button>
          {/if}
          <Button treatment="ghost" aria-label={`Dismiss: ${n.title}`} onclick={() => dismiss([n.id])}>Got it</Button>
        </li>
      {/each}
    </ul>

    {#if hidden > 0 || showAll}
      <Button treatment="ghost" id="notice-fold" onclick={() => showAll = !showAll}>
        {showAll ? 'Show less' : `Show ${hidden} more`}
      </Button>
    {/if}
  {/if}
</Card>

<style>
  /* text column takes the slack, so the action buttons line up on the right edge */
  li > :global(.stack) { flex: 1; }
  /* empty state: icon, title and message share one row. Baseline alignment
     hangs the 2rem icon above the text, so center the row and size all three
     to one line box. */
  .queue-empty > :global(*) {
    display: flex;
    flex-direction: row;
    align-items: center;
    justify-content: flex-start;
    gap: var(--space-sm);
    padding-block: 0;
    margin-block: 0;
    text-align: start;
  }
  .queue-empty :global(.empty-icon) {
    --icon-size: 1.25rem;
    display: flex;
    align-items: center;
  }
  .queue-empty :global(.empty-title),
  .queue-empty :global(.empty-text) {
    font-size: var(--text-md);
    line-height: 1.25rem;
  }
</style>
