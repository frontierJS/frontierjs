<script>
  // AppBackups.mesa — an App's archives of its data volume: the rows, Back up
  // now, Restore, Download, Discard, Rescan bucket (`IDEAS/backups.md` 5.3) and
  // Upload (`IDEAS/app-archives.md` 3.2).
  //
  // Every action names a MACHINE, because the volume is per machine: *Back up
  // now* archives that placement's copy, and *Restore* extracts onto it. One
  // select serves both, defaulting to the first online placement.
  //
  // This list POLLS while a row is unsettled or a rescan is listing, as
  // /hub/backups/ does: the job writes the outcome at system, and that write
  // announces nothing, so a tether would show `running` after the machine had
  // answered.
  import { appBackups } from '../resources/AppBackup.mesa'
  import { apps }       from '../resources/App.mesa'
  import { getClient }  from '@frontierjs/sierra/resource'
  import { ago }        from '../lib/datetime.js'
  import { formatBytes as size } from '@frontierjs/toolbelt/units'

  import Badge      from '@frontierjs/ui/components/display/Badge.mesa'
  import Button     from '@frontierjs/ui/components/forms/Button.mesa'
  import Card       from '@frontierjs/ui/components/layout/Card.mesa'
  import EmptyState from '@frontierjs/ui/components/display/EmptyState.mesa'
  import FileUpload from '@frontierjs/ui/components/forms/FileUpload.mesa'
  import Pill       from '@frontierjs/ui/components/display/Pill.mesa'
  import Select     from '@frontierjs/ui/components/forms/Select.mesa'
  import Table      from '@frontierjs/ui/components/display/Table.mesa'
  import { toasts } from '@frontierjs/ui/stores/toastStore'

  export let app = null

  let rows    = []
  let loading = true
  let error   = null
  let busy    = null
  let chosen  = ''
  let listingUntil = 0
  let files   = []

  $: placements = app?.placement ?? []
  $: machine = chosen || ((placements.find(p => p.server?.status === 'online') ?? placements[0])?.serverId ?? '')
  $: machineName = placements.find(p => p.serverId === machine)?.server?.name ?? machine

  async function load() {
    try {
      rows  = (await appBackups.service.find({ appId: app.id }, { limit: 50 })).data
      error = null
    } catch (e) {
      error = e.message
    } finally {
      loading = false
    }
  }

  load()

  const SETTLED = new Set(['success', 'failed', 'timeout'])
  $: inFlight = rows.some(b => !SETTLED.has(b.status))

  let poll = null
  function watch() {
    clearTimeout(poll)
    if (!inFlight && Date.now() > listingUntil) return
    poll = setTimeout(async () => { await load(); watch() }, 1500)
  }
  $: inFlight, () => watch()
  $.onDestroy(() => clearTimeout(poll))

  async function takeOne() {
    error = null; busy = 'take'
    try {
      await appBackups.service.invoke('take', null,
        { appId: app.id, serverId: machine, destinationId: app.backupDestinationId ?? null })
      toasts.success(`Backup asked of ${machineName}. The row fills in as it runs.`)
      await load()
      watch()
    } catch (e) {
      error = e.message
    } finally {
      busy = null
    }
  }

  // In the bucket is the server's `isRemote`: a row whose upload failed keeps
  // its destination and its local path, with the failure in `error`, and
  // both `download` and `restoreVolume` refuse it.
  const inBucket = (b) => b.status === 'success' && !!b.destinationId && !b.error && !!b.location

  // A success row the machine still holds: `location` is a path there, with no
  // destination or with the failed upload in `error`. Download pulls it through
  // the hub (`FJS-D1833`); Restore by id still refuses it.
  const onMachine = (b) => b.status === 'success' && !inBucket(b) && !!b.location?.startsWith('/')

  // The machine fetches the archive by a link the hub signs and refuses one
  // whose sha256 is not the recorded one (`FJS-D1521`), so only a row in the
  // bucket with a hash offers Restore.
  const restorable = (b) => inBucket(b) && !!b.sha256

  // The server answers a link that saves as an attachment named for the app,
  // so the screen stays where it is. For a bucket row that is the bucket's
  // pre-signed GET at once; for a machine-kept one the call WAITS while the
  // machine sends the file to the hub, so the button says it is fetching.
  async function download(b) {
    error = null; busy = b.id
    try {
      const { url } = await appBackups.service.invoke('download', b.id, {})
      location.assign(url)
    } catch (e) {
      error = e.message
    } finally {
      busy = null
    }
  }

  const discardText = (b) => inBucket(b) ? 'The archive is deleted from the bucket, and its copy from the machine.'
    : onMachine(b) ? 'The archive is deleted from the machine that holds it, which is its only copy.'
    : 'No archive was kept, so only this row goes.'

  // The server refuses the app's newest good archive and says why (`FJS-3902`).
  async function discard(b) {
    error = null; busy = b.id
    try {
      await appBackups.service.invoke('discard', b.id, {})
      toasts.success(`Discarded the backup taken ${when(b)}`)
      await load()
    } catch (e) {
      error = e.message
    } finally {
      busy = null
    }
  }

  async function restore(b) {
    error = null; busy = b.id
    try {
      await apps.service.invoke('restoreVolume', app.id, { serverId: machine, backupId: b.id, isOverwriting: true })
      toasts.success(`Restored onto ${machineName}`)
    } catch (e) {
      error = e.message
    } finally {
      busy = null
    }
  }

  // An archive in the bucket that no row names is invisible here until a
  // rescan writes a `found` row, `pending` until the hub has read its sha256.
  async function rescan() {
    error = null; busy = 'rescan'
    try {
      await appBackups.service.invoke('rescan', null, { appId: app.id })
      toasts.success('Listing the bucket. Archives no row names appear below.')
      listingUntil = Date.now() + 15_000
      watch()
    } catch (e) {
      error = e.message
    } finally {
      busy = null
    }
  }

  // Bun refuses a request body over 128 MB before the route reads it
  // (`FJS-3090`), so Upload refuses one first and says so, and the hub refuses
  // to pull a machine-kept archive past it (`BODY_CEILING_BYTES`, the API's
  // one copy of this number).
  const UPLOAD_MB = 128

  // Two hops: `upload` grades the caller and signs a link, and the bytes go to
  // that link, because a service body is buffered and capped (`FJS-D1732`).
  async function upload(file) {
    error = null; busy = 'upload'
    try {
      const { url, method } = await appBackups.service.invoke('upload', null, { appId: app.id, name: file.name })
      await getClient().fetch(url, {
        method, body: file, headers: { accept: 'application/json', 'content-type': 'application/octet-stream' },
      })
      toasts.success(`${file.name} is in the bucket. Restore it from its row.`)
      files = []
      await load()
    } catch (e) {
      error = e.code === 413 ? `${file.name} is over ${UPLOAD_MB} MB; put it in the bucket and Rescan instead.` : e.message
    } finally {
      busy = null
    }
  }

  // A bare `.db` upload is wrapped under a `.db.tar.gz` key and restores per
  // file (`FJS-D1724`), so its confirmation must not promise a whole volume.
  const wrapped = (b) => !!b.location?.endsWith('.db.tar.gz')
  const confirmText = (b) => wrapped(b)
    ? `The database in this archive, and its -wal and -shm, are replaced in this app's volume on ${machineName}. Its other databases and files stay. Stop the app there first.`
    : `The files in this app's volume on ${machineName} are replaced by this archive. Stop the app there first.`

  function tone(status) {
    if (status === 'success') return 'success'
    if (status === 'failed')  return 'danger'
    if (status === 'timeout') return 'warning'
    return 'info'
  }
  const when = (b) => ago(b.finishedAt ?? b.startedAt ?? b.createdAt)

  const COLUMNS = [
    { name: 'when',    label: 'Taken' },
    { name: 'kind',    label: 'Kind' },
    { name: 'status',  label: 'Status' },
    { name: 'size',    label: 'Size' },
    { name: 'where',   label: 'Where' },
    { name: 'actions', label: 'Actions', hideLabel: true },
  ]
</script>

<div class="stack" id="app-backups">
  {#if error}
    <article class="alert danger" id="app-backups-error">
      <div class="alert-content">{error}</div>
    </article>
  {/if}

  <Card>
    <div class="section-header">
      <h2 class="h4">Backups</h2>
      <span class="cluster">
        <Badge tone="muted" id="app-backups-destination">
          {app.backupDestinationId ? 'to its backup destination' : 'kept on the machine'}
        </Badge>
        {#if app.backupCron}<Badge tone="muted"><code>{app.backupCron}</code></Badge>{/if}
      </span>
    </div>
    <p class="text-sm text-muted">
      An archive of this app's data volume, taken on the machine that holds it. Restore extracts one
      onto the machine chosen here, replacing the files in its volume — stop the app there first.
    </p>
    {#if placements.length}
      <div class="cluster">
        <Select id="app-backups-machine" value={machine} label="Machine"
                options={placements.map(p => ({ value: p.serverId, label: `${p.server?.name ?? p.serverId} · ${p.server?.status ?? 'gone'}` }))}
                oninput={(e) => chosen = e.target.value}
                onchange={(e) => chosen = e.target.value} />
        <Button tone="primary" id="app-backups-take" disabled={!machine || !!busy} onclick={takeOne}>
          {busy === 'take' ? 'Asking…' : 'Back up now'}
        </Button>
        {#if app.backupDestinationId}
          <Button treatment="outlined" id="app-backups-rescan" disabled={!!busy} onclick={rescan}>
            {busy === 'rescan' ? 'Listing…' : 'Rescan bucket'}
          </Button>
        {/if}
      </div>
    {:else}
      <p class="text-sm text-muted" id="app-backups-unplaced">It is placed nowhere, so there is no volume to archive or restore onto.</p>
    {/if}
    {#if app.backupDestinationId}
      <div class="stack" id="app-backups-upload">
        <FileUpload label="Upload an archive" name="archive" accept=".gz,.db,application/gzip"
                    maxSizeMB={UPLOAD_MB} bind:files={files}
                    hint={`A .tar.gz from Download, or one .db, up to ${UPLOAD_MB} MB. It lands in the bucket as a row to Restore; a .db restores over that database only.`} />
        <div class="cluster">
          <Button treatment="outlined" id="app-backups-upload-send" disabled={!files.length || !!busy} onclick={() => upload(files[0])}>
            {busy === 'upload' ? 'Uploading…' : 'Upload'}
          </Button>
        </div>
      </div>
    {/if}
  </Card>

  {#if loading}
    <p class="text-sm text-muted">Loading…</p>
  {:else if !rows.length}
    <EmptyState title="No backups">Nothing of this app has been archived yet.</EmptyState>
  {:else}
    <Table id="app-backups-history" columns={COLUMNS} rows={rows} striped hover={false}>
      {#snippet row(b)}
        <tr data-backup={b.id}>
          <td class="text-sm">{when(b)}</td>
          <td><Pill tone="muted">{b.kind}</Pill></td>
          <td>
            <Pill tone={tone(b.status)}>{b.status}</Pill>
            {#if b.kind === 'found' && !b.sha256}<span class="text-sm text-muted"> until the hub reads its sha256</span>{/if}
          </td>
          <td class="text-sm">{b.sizeBytes ? size(b.sizeBytes) : '—'}</td>
          <td class="text-sm text-muted"><code>{b.location ?? '—'}</code></td>
          <td>
            {#if inBucket(b) || onMachine(b)}
              <Button treatment="ghost" disabled={!!busy} aria-label={`Download the backup taken ${when(b)}`}
                      onclick={() => download(b)}>{busy === b.id && onMachine(b) ? 'Fetching…' : 'Download'}</Button>
            {/if}
            {#if restorable(b)}
              <Button treatment="ghost" disabled={!machine || !!busy} aria-label={`Restore the backup taken ${when(b)}`}
                      data-confirm={confirmText(b)}
                      data-confirm-title="Restore this backup?" data-confirm-label="Restore" data-confirm-tone="danger"
                      onclick={() => restore(b)}>Restore</Button>
            {/if}
            {#if SETTLED.has(b.status)}
              <Button treatment="ghost" tone="danger" disabled={!!busy} aria-label={`Discard the backup taken ${when(b)}`}
                      data-confirm={discardText(b)}
                      data-confirm-title="Discard this backup?" data-confirm-label="Discard" data-confirm-tone="danger"
                      onclick={() => discard(b)}>Discard</Button>
            {/if}
          </td>
        </tr>
        {#if b.error}
          <tr><td colspan="6"><pre class="code"><code>{b.error}</code></pre></td></tr>
        {/if}
      {/snippet}
    </Table>
    <p class="text-sm text-muted">
      <em>Download</em> saves an archive as <code>{app.slug}-&lt;stamp&gt;.tar.gz</code>; one kept on the machine is
      fetched through the hub first, up to {UPLOAD_MB} MB.
    </p>
  {/if}
</div>
