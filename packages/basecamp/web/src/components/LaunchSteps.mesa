<script>
  // The setup checklist: from nothing to one app live on one machine, with
  // the DNS provider on the path. Home and /onboarding/ both render this, so
  // there is one list to keep true.
  //
  // Every step is answered by `infra.launch` on load and none is stored, so
  // the only thing a step can do is take you to the screen where the work is.
  // The server names that screen — the app a step means lives three levels
  // deep, and working out which one is a read of rows this component does not
  // hold. Every undone step carries its button: Cloudflare is step two and
  // needs no machine, and a button only on the next step hid it until one was
  // online.
  //
  // `always` is /onboarding/'s: home hides the card once every step is done,
  // because the fleet is the home screen from then. An `advisory` step (the
  // hub host's machine backups, FJS-D1895) is outside the count and is never
  // `next`, so it cannot hold the card open; past setup, home shows each one
  // undone as a single line instead, or it would only ever be seen here.
  import { session } from '../lib/session.js'
  import { infra } from '../resources/Infra.mesa'
  import Button from '@frontierjs/ui/components/forms/Button.mesa'

  export let always = false

  $: session.workspaceId

  let state = null
  let error = null

  async function load() {
    error = null
    try {
      state = await infra.service.invoke('launch', null)
    } catch (e) {
      error = e.message
    }
  }

  load()
  $: session.workspaceId, () => load()

  $: next  = state?.steps.find(s => !s.done && !s.advisory) ?? null
  $: owing = state?.steps.filter(s => !s.done && s.advisory) ?? []
</script>

{#if error}
  <article class="alert danger" id="launch-error">
    <div class="alert-content">{error}</div>
  </article>
{:else if state && (next || always)}
  <article class="card stack" id="launch-steps">
    <div class="section-header">
      <h2 class="h4">Ship your first app</h2>
      <span class="text-sm text-muted">{state.done} of {state.total}</span>
    </div>
    <progress class="progress" id="launch-progress" value={state.done} max={state.total}></progress>
    {#if !next}
      <p class="text-body">Everything is set up. <a href="/">The overview</a> is where the fleet lives from here.</p>
    {/if}
    <ol class="steps">
      {#each state.steps as step (step.id)}
        <li class={step.done ? 'step complete' : 'step'} data-step={step.id} data-advisory={step.advisory ? '' : null} aria-current={next?.id === step.id ? 'step' : null}>
          <span class="step-marker"></span>
          <span class="step-label">{step.title}{#if step.advisory}<span class="text-sm text-muted"> · not counted</span>{/if}</span>
          <span class="step-hint">{step.detail}</span>
          {#if step.href}
            <Button treatment={next?.id === step.id ? '' : 'ghost'} href={step.href}>
              {step.done ? 'Open' : 'Do this'}
            </Button>
          {/if}
        </li>
      {/each}
    </ol>
  </article>
{:else if state}
  {#each owing as step (step.id)}
    <article class="alert warning" data-owing={step.id}>
      <div class="alert-content"><strong>{step.title}.</strong> {step.detail}</div>
      <Button treatment="ghost" href={step.href}>Open</Button>
    </article>
  {/each}
{/if}
