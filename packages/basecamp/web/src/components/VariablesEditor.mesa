<script>
  // VariablesEditor.mesa — the variables set on one environment or one app.
  //
  // One editor for both scopes, because they are one model: `appId` given is
  // that app's own, otherwise the environment's (`appId: null`). A secret's
  // value is `@encrypted` and never in the response: it is replaced, or an
  // administrator reveals it on demand (`variables.reveal`, filed in the trail).
  import { variables, revealVariable, exportVariables, importVariables } from '../resources/Variable.mesa'
  import { session } from '../lib/session.js'
  import { download } from '@frontierjs/ui/utils'
  import CopyButton from '@frontierjs/ui/components/display/CopyButton.mesa'
  import Button     from '@frontierjs/ui/components/forms/Button.mesa'
  import Input      from '@frontierjs/ui/components/forms/Input.mesa'
  import Checkbox   from '@frontierjs/ui/components/forms/Checkbox.mesa'
  import Textarea   from '@frontierjs/ui/components/forms/Textarea.mesa'
  import FileUpload from '@frontierjs/ui/components/forms/FileUpload.mesa'
  import Table      from '@frontierjs/ui/components/display/Table.mesa'

  export let environmentId = null
  export let appId         = null
  export let idPrefix      = 'var'

  let rows      = []
  let error     = null
  let newKey    = ''
  let newValue  = ''
  let newSecret = false
  let busyId    = null
  let editId    = null
  let editValue = ''
  let shown     = {}     // id -> revealed value; held in memory only, gone on reload

  // The gate is the service's (administrator). This is the affordance: a role
  // that is known and below admin hides the button, an unknown one shows it, and
  // the server answers 403 either way.
  $: (session.workspaces, session.workspaceId)
  $: myRole    = session.workspaces.find(w => w.id === session.workspaceId)?.role
  $: mayReveal = !myRole || myRole === 'admin' || myRole === 'owner'

  async function reveal(v) {
    error = null; busyId = v.id
    try {
      const r = await revealVariable(v.id)
      shown = { ...shown, [v.id]: r.value ?? '' }
    } catch (e) {
      error = e.message
    } finally {
      busyId = null
    }
  }
  function hide(v) { const { [v.id]: _gone, ...rest } = shown; shown = rest }

  $: scope = appId ? { appId } : { environmentId, appId: null }

  // Every variable in the scope, not a page — the server refuses a page above
  // its max. Made again when the scope moves.
  const list = variables.tethered({ state: 'local', where: scope, all: true })
  $: { rows = list.rows }
  $: { if (list.error) error = list.error.message }
  const load = () => list.reload()

  // Another tab, or another person, setting a key in this scope.
  const READS = new Set(['get', 'find'])
  var off = variables.service.on('*', (method, changed) => {
    if (READS.has(method)) return
    if (appId ? changed?.appId === appId : (changed?.environmentId === environmentId && !changed?.appId)) load()
  })
  $.onDestroy(() => off())

  async function add() {
    error = null; busyId = 'new'
    try {
      // An app's variable names the app alone; the schema takes the
      // environment from it (`@default(app.environmentId)`).
      await variables.service.create({ ...(appId ? { appId } : { environmentId }), key: newKey, value: newValue, isSecret: newSecret })
      newKey = ''; newValue = ''; newSecret = false
      await load()
    } catch (e) {
      error = e.message
    } finally {
      busyId = null
    }
  }

  function startEdit(v) { editId = v.id; editValue = v.isSecret ? '' : (v.value ?? '') }

  async function save(v) {
    error = null; busyId = v.id
    try {
      // The version this editor read, so a second person's save in between is
      // a conflict rather than an overwrite.
      await variables.service.patch(v.id, { value: editValue, version: v.version })
      editId = null
      await load()
    } catch (e) {
      error = e.message
    } finally {
      busyId = null
    }
  }

  async function drop(v) {
    error = null; busyId = v.id
    try {
      await variables.service.remove(v.id)
      await load()
    } catch (e) {
      error = e.message
    } finally {
      busyId = null
    }
  }

  // ─── .env out and in ──────────────────────────────────────────────────
  let withSecrets = false
  let importing   = false
  let envText     = ''
  let envFiles    = []
  let preview     = null   // the dry run's rows, until applied or cancelled
  let secretKeys  = {}     // key -> keep secret, for the keys the file creates

  const named = () => appId ? { appId } : { environmentId }

  async function exportEnv() {
    error = null; busyId = 'export'
    try {
      const out = await exportVariables(named(), { secrets: withSecrets })
      download(new Blob([out.text], { type: 'text/plain' }), out.filename)
    } catch (e) {
      error = e.message
    } finally {
      busyId = null
    }
  }

  async function readPicked(files) { if (files[0]) { envText = await files[0].text(); preview = null } }

  async function previewImport() {
    error = null; busyId = 'import'
    try {
      const r = await importVariables({ ...named(), text: envText, dryRun: true })
      preview    = r.rows
      secretKeys = Object.fromEntries(r.rows.filter(row => row.action !== 'update' && row.action !== 'unchanged')
        .map(row => [row.key, row.isSecret]))
    } catch (e) {
      error = e.message
    } finally {
      busyId = null
    }
  }

  async function applyImport() {
    error = null; busyId = 'import'
    try {
      const secrets = Object.keys(secretKeys).filter(k => secretKeys[k])
      await importVariables({ ...named(), text: envText, secrets })
      closeImport()
      await load()
    } catch (e) {
      error = e.message
    } finally {
      busyId = null
    }
  }

  function closeImport() { importing = false; envText = ''; envFiles = []; preview = null; secretKeys = {} }

  const CHANGE = { create: 'new', update: 'changed', unchanged: 'unchanged', skip: 'skipped' }
  $: changing = preview ? preview.filter(r => r.action === 'create' || r.action === 'update').length : 0

  const PREVIEW_COLUMNS = [
    { name: 'key',    label: 'Key' },
    { name: 'action', label: 'Change' },
    { name: 'secret', label: 'Secret' },
  ]

  const COLUMNS = [
    { name: 'key',     label: 'Key' },
    { name: 'value',   label: 'Value' },
    { name: 'actions', label: 'Actions', hideLabel: true },
  ]
</script>

{#if error}
  <p class="alert danger" role="alert">{error}</p>
{/if}

{#if rows.length}
  <Table id={`${idPrefix}-rows`} columns={COLUMNS} {rows} striped hover={false}>
    {#snippet row(v)}
      <tr data-key={v.key}>
        <td><code>{v.key}</code></td>
        <td>
          {#if editId === v.id}
            <form class="cluster" onsubmit|preventDefault={() => save(v)}>
              <Input label="" aria-label={`Value of ${v.key}`} id={`${idPrefix}-edit-${v.key}`} value={editValue}
                     type={v.isSecret ? 'password' : 'text'} autocomplete="off"
                     placeholder={v.isSecret ? 'New value' : ''}
                     oninput={(e) => editValue = e.target.value} />
              <Button type="submit" tone="primary" disabled={busyId === v.id}>Save</Button>
              <Button treatment="ghost" onclick={() => editId = null}>Cancel</Button>
            </form>
          {:else if v.isSecret && v.id in shown}
            <span class="cluster">
              <code data-revealed>{shown[v.id]}</code>
              <CopyButton text={shown[v.id]} label="Copy" treatment="outlined" size="sm" />
              <Button treatment="ghost" onclick={() => hide(v)}>Hide</Button>
            </span>
          {:else if v.isSecret}
            <span class="text-muted">secret · set</span>
          {:else}
            <code>{v.value}</code>
          {/if}
        </td>
        <td class="cluster">
          {#if v.isSecret && mayReveal && !(v.id in shown) && editId !== v.id}
            <Button treatment="ghost" data-reveal disabled={busyId === v.id}
                    onclick={() => reveal(v)}>Reveal</Button>
          {/if}
          {#if editId !== v.id}
            <Button treatment="ghost" onclick={() => startEdit(v)}>{v.isSecret ? 'Replace' : 'Edit'}</Button>
          {/if}
          <Button treatment="ghost" tone="danger" disabled={busyId === v.id}
                  data-confirm={`${v.key} is removed; the next release runs without it.`}
                  data-confirm-title="Remove this variable?" data-confirm-label="Remove"
                  onclick={() => drop(v)}>Remove</Button>
        </td>
      </tr>
    {/snippet}
  </Table>
{:else}
  <p class="text-sm text-muted">No variables set.</p>
{/if}

<form class="card stack" novalidate onsubmit|preventDefault={add}>
  <div class="field-row">
    <Input label="Key" name={`${idPrefix}-key`} id={`${idPrefix}-key`} placeholder="DATABASE_URL"
           required bind:value={newKey} />
    <Input label="Value" name={`${idPrefix}-value`} id={`${idPrefix}-value`} required bind:value={newValue}
           type={newSecret ? 'password' : 'text'} autocomplete="off" />
  </div>
  <Checkbox id={`${idPrefix}-secret`} label="Secret — stored encrypted, never shown again" bind:checked={newSecret} />
  <div class="cluster">
    <Button tone="primary" type="submit" disabled={busyId !== null}>Set variable</Button>
  </div>
</form>

<div class="cluster">
  <Button treatment="outlined" id={`${idPrefix}-export`} disabled={busyId !== null} onclick={exportEnv}>Export .env</Button>
  {#if mayReveal}
    <Checkbox id={`${idPrefix}-export-secrets`} label="Include secret values (each is recorded as a reveal)"
              bind:checked={withSecrets} />
  {/if}
  {#if !importing}
    <Button treatment="outlined" id={`${idPrefix}-import`} onclick={() => importing = true}>Import .env</Button>
  {/if}
</div>

{#if importing}
  <div class="card stack" id={`${idPrefix}-import-panel`}>
    <FileUpload label="A .env file" name={`${idPrefix}-env-file`} bind:files={envFiles} onchange={readPicked}
                hint="Or paste it below. Keys in the file are added or updated; keys not in it are left alone." />
    <Textarea label="Contents" id={`${idPrefix}-env-text`} name={`${idPrefix}-env-text`} rows="8"
              value={envText} oninput={(e) => { envText = e.target.value; preview = null }} />
    {#if preview}
      <Table id={`${idPrefix}-import-preview`} columns={PREVIEW_COLUMNS} rows={preview} striped hover={false}>
        {#snippet row(r)}
          <tr data-key={r.key} data-action={r.action}>
            <td><code>{r.key}</code></td>
            <td>{CHANGE[r.action]}{#if r.note}<span class="text-muted"> — {r.note}</span>{/if}</td>
            <td>
              {#if r.key in secretKeys}
                <Checkbox id={`${idPrefix}-import-secret-${r.key}`} label="" aria-label={`Keep ${r.key} secret`}
                          checked={secretKeys[r.key]}
                          onchange={(checked) => secretKeys = { ...secretKeys, [r.key]: checked }} />
              {:else}
                <span class="text-muted">{r.isSecret ? 'secret' : 'plain'}</span>
              {/if}
            </td>
          </tr>
        {/snippet}
      </Table>
    {/if}
    <div class="cluster">
      {#if preview}
        <Button tone="primary" id={`${idPrefix}-import-apply`} disabled={busyId !== null || !changing}
                onclick={applyImport}>Apply {changing} {changing === 1 ? 'change' : 'changes'}</Button>
      {/if}
      <Button treatment={preview ? 'ghost' : 'outlined'} id={`${idPrefix}-import-preview-btn`}
              disabled={busyId !== null || !envText.trim()} onclick={previewImport}>Preview</Button>
      <Button treatment="ghost" onclick={closeImport}>Cancel</Button>
    </div>
  </div>
{/if}
