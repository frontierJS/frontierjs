<script>
  // VariablesEditor.mesa — the variables set on one environment or one app.
  //
  // One editor for both scopes, because they are one model: `appId` given is
  // that app's own, otherwise the environment's (`appId: null`). A secret's
  // value is `@encrypted` and never in the response: it is replaced, or an
  // administrator reveals it on demand (`variables.reveal`, filed in the trail).
  import { variables, revealVariable } from '../resources/Variable.mesa'
  import { session } from '../lib/session.js'
  import CopyButton from '@frontierjs/ui/components/display/CopyButton.mesa'
  import Button   from '@frontierjs/ui/components/forms/Button.mesa'
  import Input    from '@frontierjs/ui/components/forms/Input.mesa'
  import Checkbox from '@frontierjs/ui/components/forms/Checkbox.mesa'
  import Table    from '@frontierjs/ui/components/display/Table.mesa'

  export let environmentId = null
  export let appId         = null
  export let idPrefix      = 'var'

  let rows      = []
  let error     = null
  let newKey    = ''
  let newValue  = ''
  let newSecret = false
  let busyId    = null
  let editId    = null
  let editValue = ''
  let shown     = {}     // id -> revealed value; held in memory only, gone on reload

  // The gate is the service's (administrator). This is the affordance: a role
  // that is known and below admin hides the button, an unknown one shows it, and
  // the server answers 403 either way.
  $: (session.workspaces, session.workspaceId)
  $: myRole    = session.workspaces.find(w => w.id === session.workspaceId)?.role
  $: mayReveal = !myRole || myRole === 'admin' || myRole === 'owner'

  async function reveal(v) {
    error = null; busyId = v.id
    try {
      const r = await revealVariable(v.id)
      shown = { ...shown, [v.id]: r.value ?? '' }
    } catch (e) {
      error = e.message
    } finally {
      busyId = null
    }
  }
  function hide(v) { const { [v.id]: _gone, ...rest } = shown; shown = rest }

  $: scope = appId ? { appId } : { environmentId, appId: null }

  // Every variable in the scope, not a page — the server refuses a page above
  // its max. Made again when the scope moves.
  const list = variables.tethered({ state: 'local', where: scope, all: true })
  $: { rows = list.rows }
  $: { if (list.error) error = list.error.message }
  const load = () => list.reload()

  // Another tab, or another person, setting a key in this scope.
  const READS = new Set(['get', 'find'])
  var off = variables.service.on('*', (method, changed) => {
    if (READS.has(method)) return
    if (appId ? changed?.appId === appId : (changed?.environmentId === environmentId && !changed?.appId)) load()
  })
  $.onDestroy(() => off())

  async function add() {
    error = null; busyId = 'new'
    try {
      // `environmentId` on an app's too: the resource checks the schema's
      // required list before sending, so a create naming only the app is
      // refused here before the server can fill it from the app.
      await variables.service.create({ environmentId, ...(appId ? { appId } : {}), key: newKey, value: newValue, secret: newSecret })
      newKey = ''; newValue = ''; newSecret = false
      await load()
    } catch (e) {
      error = e.message
    } finally {
      busyId = null
    }
  }

  function startEdit(v) { editId = v.id; editValue = v.secret ? '' : (v.value ?? '') }

  async function save(v) {
    error = null; busyId = v.id
    try {
      // The version this editor read, so a second person's save in between is
      // a conflict rather than an overwrite.
      await variables.service.patch(v.id, { value: editValue, version: v.version })
      editId = null
      await load()
    } catch (e) {
      error = e.message
    } finally {
      busyId = null
    }
  }

  async function drop(v) {
    error = null; busyId = v.id
    try {
      await variables.service.remove(v.id)
      await load()
    } catch (e) {
      error = e.message
    } finally {
      busyId = null
    }
  }

  const COLUMNS = [
    { name: 'key',     label: 'Key' },
    { name: 'value',   label: 'Value' },
    { name: 'actions', label: 'Actions', hideLabel: true },
  ]
</script>

{#if error}
  <p class="alert danger" role="alert">{error}</p>
{/if}

{#if rows.length}
  <Table id={`${idPrefix}-rows`} columns={COLUMNS} {rows} striped hover={false}>
    {#snippet row(v)}
      <tr data-key={v.key}>
        <td><code>{v.key}</code></td>
        <td>
          {#if editId === v.id}
            <form class="cluster" onsubmit|preventDefault={() => save(v)}>
              <Input label="" aria-label={`Value of ${v.key}`} id={`${idPrefix}-edit-${v.key}`} value={editValue}
                     type={v.secret ? 'password' : 'text'} autocomplete="off"
                     placeholder={v.secret ? 'New value' : ''}
                     oninput={(e) => editValue = e.target.value} />
              <Button type="submit" tone="primary" disabled={busyId === v.id}>Save</Button>
              <Button treatment="ghost" onclick={() => editId = null}>Cancel</Button>
            </form>
          {:else if v.secret && v.id in shown}
            <span class="cluster">
              <code data-revealed>{shown[v.id]}</code>
              <CopyButton text={shown[v.id]} label="Copy" treatment="outlined" size="sm" />
              <Button treatment="ghost" onclick={() => hide(v)}>Hide</Button>
            </span>
          {:else if v.secret}
            <span class="text-muted">secret · set</span>
          {:else}
            <code>{v.value}</code>
          {/if}
        </td>
        <td class="cluster">
          {#if v.secret && mayReveal && !(v.id in shown) && editId !== v.id}
            <Button treatment="ghost" data-reveal disabled={busyId === v.id}
                    onclick={() => reveal(v)}>Reveal</Button>
          {/if}
          {#if editId !== v.id}
            <Button treatment="ghost" onclick={() => startEdit(v)}>{v.secret ? 'Replace' : 'Edit'}</Button>
          {/if}
          <Button treatment="ghost" tone="danger" disabled={busyId === v.id}
                  data-confirm={`${v.key} is removed; the next release runs without it.`}
                  data-confirm-title="Remove this variable?" data-confirm-label="Remove"
                  onclick={() => drop(v)}>Remove</Button>
        </td>
      </tr>
    {/snippet}
  </Table>
{:else}
  <p class="text-sm text-muted">No variables set.</p>
{/if}

<form class="card stack" novalidate onsubmit|preventDefault={add}>
  <div class="field-row">
    <Input label="Key" name={`${idPrefix}-key`} id={`${idPrefix}-key`} placeholder="DATABASE_URL"
           required bind:value={newKey} />
    <Input label="Value" name={`${idPrefix}-value`} id={`${idPrefix}-value`} required bind:value={newValue}
           type={newSecret ? 'password' : 'text'} autocomplete="off" />
  </div>
  <Checkbox id={`${idPrefix}-secret`} label="Secret — stored encrypted, never shown again" bind:checked={newSecret} />
  <div class="cluster">
    <Button tone="primary" type="submit" disabled={busyId !== null}>Set variable</Button>
  </div>
</form>
