<script>
  // job_history — scheduled and one-shot jobs, with the outcome of their last
  // run.
  //
  // `Job.lastRunAt` / `lastRunStatus` are columns the job run stamps, so this
  // is one read rather than a run query per job — the same pair the jobs screen
  // renders in its table.
  import { jobs } from '../../resources/Job.mesa'
  import { at } from '../../lib/datetime.js'
  import Badge from '@frontierjs/ui/components/display/Badge.mesa'


  const TONE = { success: 'success', failed: 'danger', timeout: 'danger', running: 'info', pending: 'muted' }

  // The jobs tether the shell already holds, newest first, and the card shows
  // its head. A capped read of its own would narrow the shell's list too: a
  // list stating no filter IS the resource's tether.
  const list = jobs.tethered({ state: 'local' })
  $: rows    = list.rows.slice(0, 6)
  $: error   = list.error?.message ?? null
  $: loading = list.loading && !list.rows.length

</script>

{#if loading}
  <p class="text-sm text-muted">Loading…</p>
{:else if error}
  <p class="text-sm">{error}</p>
{:else if !rows.length}
  <p class="text-sm text-muted">No jobs in this workspace.</p>
{:else}
  <ul class="stack" style="list-style: none; padding: 0">
    {#each rows as job}
      <li class="cluster">
        <Badge tone={TONE[job.lastRunStatus] ?? 'muted'}>{job.lastRunStatus ?? job.status}</Badge>
        <a href={`/jobs/${job.id}/`}>{job.name}</a>
        <span class="text-xs text-muted">{at(job.lastRunAt, 'never run')}</span>
      </li>
    {/each}
  </ul>
{/if}
