<script>
  // server_health — CPU, memory and disk for one server.
  //
  // Two readings of the same machine, and they answer different questions.
  //
  // `Server.health` is a SNAPSHOT — one column, overwritten every check-in — so
  // the bars are what the machine said a moment ago. The sparklines beside them
  // come from the metric store, which the heartbeat now records into
  // (`FJS-956`): `server.cpuPercent{serverId}` and its two siblings, read back
  // through `servers.metrics`, whose confinement is a scoped read of this very
  // server.
  //
  // The trend is fetched ONCE and not watched. A push moves the bars, which is
  // what a card three inches wide is for; re-reading a day of points on every
  // heartbeat would spend a query a minute to move a line by one pixel.
  //
  // A server with no `health` has not checked in. That is a state worth naming
  // rather than three bars at zero, which reads as a machine at rest.
  import { servers } from '../../resources/Server.mesa'
  import Bar       from '@frontierjs/ui/components/display/Bar.mesa'
  import Sparkline from '@frontierjs/ui/components/display/Sparkline.mesa'

  export let widget = null

  let server  = null
  let error   = null
  let loading = true

  // Watched rather than read (`FJS-518`): a heartbeat is a write to this row
  // from a machine nobody on this page is driving, which is the whole of what
  // this card shows. `servers.get()` answers the row itself, so this is the
  // plain form — no `composed:`, and the node IS the value.
  let row      = null
  let unwatch  = null
  let trend    = {}     // series name → number[], oldest first
  let readings = []     // the declaration, answered by `metrics` — see below

  async function load() {
    error = null
    if (!widget?.serverId) { loading = false; return }
    try {
      unwatch?.(); row?.release()
      row = servers.record(widget.serverId)
      unwatch = row.subscribe(v => { server = v })
      await row.ready

      // A day, which is inside the raw window the store keeps at minute
      // resolution — so this is a range scan and never the fold.
      const to  = Date.now()
      const res = await servers.service.invoke('metrics', widget.serverId,
                                               { from: to - 24 * 3600 * 1000, to })
      // `null` for a series nothing has ever written, which is not the same as
      // an empty one and must not draw a flat line at zero.
      readings = res?.readings ?? []
      trend = Object.fromEntries(
        Object.entries(res?.series ?? {})
              .map(([name, s]) => [name, s ? s.points.map(p => p.value) : null]))
    } catch (e) {
      error = e.message
    } finally {
      loading = false
    }
  }

  load()
  $.onDestroy(() => { unwatch?.(); row?.release() })

  // The reading list comes from the ANSWER, never from here. `metrics` returns
  // it beside the series because it is the declaration — which keys this app
  // keeps, and what a person calls each — and a card holding its own copy is a
  // second place for it to be wrong, which is how two of the three bars drew
  // nothing for a year (`FJS-1027`).
  //
  // Only the ones the outpost actually reported: anything else it sends is its
  // own vocabulary and belongs on the server's screen, not on a card three
  // inches wide.
  //
  // The value has to BE a number, not merely coerce to one: `health` is an open
  // Json document another process writes, and `Number(null)` is 0 — a disk bar
  // at 0% reads as an empty disk, which is the opposite of what a machine that
  // sent no figure means. The API's own rule is `readingOf` in
  // `core/server-metrics.ts`; a browser cannot import it, so the shape is
  // stated twice on purpose and this is the second one.
  $: bars = readings
    .map(r => ({ ...r, value: server?.health?.[r.key], line: trend[r.name] }))
    .filter(r => typeof r.value === 'number' && Number.isFinite(r.value))
  // Two points is the fewest that is a line. One reading drawn as a sparkline
  // is a dot the reader takes for a flat trend.
  const hasLine = (b) => Array.isArray(b.line) && b.line.length > 1
  // The reading states its unit; a bar prints a symbol. A card that printed `%`
  // on whatever it was handed would label the first non-percentage reading
  // wrongly and say nothing.
  const symbol = (unit) => unit === 'percent' ? '%' : (unit ?? '')
  const when = (iso) => iso ? new Date(iso).toLocaleString() : 'never'
</script>

{#if loading}
  <p class="text-sm text-muted">Loading…</p>
{:else if error}
  <p class="text-sm">{error}</p>
{:else if !server}
  <p class="text-sm text-muted">This widget points at a server that is no longer here.</p>
{:else if !bars.length}
  <p class="text-sm text-muted">
    No outpost reading for {server.name} — last heartbeat {when(server.lastHeartbeatAt)}.
  </p>
{:else}
  <p class="text-sm text-muted">{server.name} · {when(server.lastHeartbeatAt)}</p>
  {#each bars as bar}
    <!-- `cluster` brings its own gap from the token ladder; the only thing
         stated here is that the bar takes the room the sparkline does not. -->
    <div class="cluster" style="justify-content: space-between">
      <div style="flex: 1"><Bar label={bar.label} value={bar.value} unit={symbol(bar.unit)} /></div>
      {#if hasLine(bar)}
        <Sparkline data={bar.line} width={64} height={20}
                   label={`${bar.label} over the last day`} />
      {/if}
    </div>
  {/each}
{/if}
