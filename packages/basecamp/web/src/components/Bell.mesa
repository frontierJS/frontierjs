<script>
  // Bell.mesa — the topbar's notifications menu.
  //
  // Mount it only while someone is signed in: `tethered()` reads on creation,
  // and a shell that built it on /login/ asked the server for a stranger's
  // notifications and got a 401 every visit. Unmounting on sign-out releases
  // the tether with the person.
  //
  // Per PERSON, not per workspace: the rows are scoped by their recipient, so
  // this never re-reads on a workspace switch. New rows arrive as pushed frames
  // on the person's own channel; nothing here polls.

  import { goto } from '@frontierjs/sierra/router'
  import Badge             from '@frontierjs/ui/components/display/Badge.mesa'
  import Button            from '@frontierjs/ui/components/forms/Button.mesa'
  import DropdownMenu      from '@frontierjs/ui/components/overlay/DropdownMenu.mesa'
  import DropdownItem      from '@frontierjs/ui/components/overlay/DropdownItem.mesa'
  import DropdownGroup     from '@frontierjs/ui/components/overlay/DropdownGroup.mesa'
  import DropdownSeparator from '@frontierjs/ui/components/overlay/DropdownSeparator.mesa'
  import { session } from '../lib/session.js'
  import { notifications, INBOX, isUnread, titleOf, bodyOf, actionOf, markRead, markAllRead }
    from '../resources/Notification.mesa'

  const bell  = notifications.tethered({ state: 'local', directives: INBOX })
  const inbox = () => bell.rows

  $: session.user, () => { if (session.user) bell.reload() }

  // The menu shows the newest few unread; /notifications/ is the whole list.
  const BELL_MAX = 6
  $: unread = inbox().filter(isUnread)

  async function openNote(n) {
    await markRead(n).catch(() => {})
    const url = actionOf(n)?.url
    goto(url || '/notifications/')
  }
</script>

<!-- The count is a Badge inside the trigger, so the unread number is part of
     the button's name to a screen reader as well as its look. -->
<DropdownMenu placement="bottom-end">
  {#snippet trigger()}
    <Button treatment="ghost" id="bell"
            aria-label={unread.length ? `Notifications, ${unread.length} unread` : 'Notifications'}
    >🔔{#if unread.length} <Badge tone="danger" id="bell-count">{unread.length}</Badge>{/if}</Button>
  {/snippet}
  {#if unread.length}
    <DropdownGroup heading="Unread">
      {#each unread.slice(0, BELL_MAX) as n}
        <DropdownItem onclick={() => openNote(n)}>
          <span class="stack">
            <strong>{titleOf(n)}</strong>
            {#if bodyOf(n)}<span class="text-sm text-muted">{bodyOf(n)}</span>{/if}
          </span>
        </DropdownItem>
      {/each}
    </DropdownGroup>
    <DropdownSeparator />
    <DropdownItem onclick={() => markAllRead(bell).catch(() => {})}>Mark all read</DropdownItem>
  {:else}
    <DropdownItem disabled>Nothing unread</DropdownItem>
    <DropdownSeparator />
  {/if}
  <DropdownItem onclick={() => goto('/notifications/')}>All notifications</DropdownItem>
</DropdownMenu>
