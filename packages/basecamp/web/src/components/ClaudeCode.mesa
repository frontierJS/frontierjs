<script>
  // The Claude Code tab on the Workbench: what Claude Code loads on THIS machine --
  // plugins, marketplaces, skills and agents, hooks, MCP servers and settings, each a
  // searchable table (api services/claude, domain/claude/claude-scan.ts) -- and the
  // writes to it.
  //
  // Machine-wide, unlike the Workbench's other tab, which is per checkout; the
  // heading says so. Every file the scan reads comes back as `Loaded<T>`, and a
  // read that failed is shown as "unavailable: reason" -- never as a zero or a blank
  // row, which would read as "nothing configured".
  //
  // Account and limits, context, usage, what drives the limit and sessions are
  // sibling components (ClaudeLimits, ClaudeContext, ClaudeUsage, ClaudeDrivers,
  // ClaudeSessions), each read the first time its section opens and kept mounted.
  // The writes are siblings too: ClaudeActions on a row, ClaudeMcpEdit,
  // ClaudeMarketplaceAdd, ClaudeSettingsEditor, ClaudeChanges and, in the drawer,
  // ClaudeFileEdit. Every write ends in `wrote`, which reads the scan and the change
  // list again so the screen shows the new state.
  //
  // A name opens a drawer. A plugin's or a hook's comes from the scan already
  // here; a skill, agent, command or memory file's text is asked for
  // (`claude.file`), and the server reads and writes only a path its own scan lists.
  //
  // The screen is POLLED for a digest of the scan (`claude.rev`) and rereads when
  // it moves, so a plugin toggled in a terminal redraws it. A scan has no model,
  // and a broadcast here is graded per recipient against a model's row, so there
  // is nothing to announce on. A write of its own already reread, and the reread
  // carries the new digest, so it does not redraw twice.
  import { ago }    from '../lib/datetime.js'
  import { slug }   from '../lib/claude-edit.js'
  import { claude } from '../resources/Claude.mesa'

  import Badge      from '@frontierjs/ui/components/display/Badge.mesa'
  import Button     from '@frontierjs/ui/components/forms/Button.mesa'
  import ClaudeActions  from './ClaudeActions.mesa'
  import ClaudeChanges  from './ClaudeChanges.mesa'
  import ClaudeContext  from './ClaudeContext.mesa'
  import ClaudeDoctor   from './ClaudeDoctor.mesa'
  import ClaudeDrivers  from './ClaudeDrivers.mesa'
  import ClaudeFileEdit from './ClaudeFileEdit.mesa'
  import ClaudeLimits   from './ClaudeLimits.mesa'
  import ClaudeMarketplaceAdd from './ClaudeMarketplaceAdd.mesa'
  import ClaudeMcpEdit  from './ClaudeMcpEdit.mesa'
  import ClaudeMcpHealth from './ClaudeMcpHealth.mesa'
  import ClaudeMcpTools from './ClaudeMcpTools.mesa'
  import ClaudeSessions from './ClaudeSessions.mesa'
  import ClaudeSettingsEditor from './ClaudeSettingsEditor.mesa'
  import ClaudeUsage    from './ClaudeUsage.mesa'
  import Callout    from '@frontierjs/ui/components/display/Callout.mesa'
  import Code       from '@frontierjs/ui/components/display/Code.mesa'
  import Drawer     from '@frontierjs/ui/components/overlay/Drawer.mesa'
  import Markdown   from '@frontierjs/ui/components/display/Markdown.mesa'
  import Input      from '@frontierjs/ui/components/forms/Input.mesa'
  import Pill       from '@frontierjs/ui/components/display/Pill.mesa'
  import Select     from '@frontierjs/ui/components/forms/Select.mesa'
  import Stat       from '@frontierjs/ui/components/display/Stat.mesa'
  import Table      from '@frontierjs/ui/components/display/Table.mesa'
  import Tab        from '@frontierjs/ui/components/layout/Tab.mesa'
  import TabList    from '@frontierjs/ui/components/layout/TabList.mesa'
  import TabPanel   from '@frontierjs/ui/components/layout/TabPanel.mesa'
  import Tabs       from '@frontierjs/ui/components/layout/Tabs.mesa'

  const SECTIONS = [
    ['overview', 'Overview'], ['plugins', 'Plugins'], ['marketplaces', 'Marketplaces'],
    ['skills', 'Skills & agents'], ['hooks', 'Hooks'], ['mcp', 'MCP'], ['settings', 'Settings'],
    ['editor', 'Edit settings'], ['changes', 'Changes'], ['doctor', 'Doctor'],
    ['limits', 'Account & limits'], ['context', 'Context'], ['usage', 'Usage'],
    ['drivers', 'What drives the limit'], ['sessions', 'Sessions'],
  ]

  const PLUGIN_COLUMNS = [
    { name: 'name', label: 'Plugin' }, { name: 'version', label: 'Version' }, { name: 'scope', label: 'Scope' },
    { name: 'enabled', label: 'Enabled' }, { name: 'enabledIn', label: 'Projects' },
    { name: 'items', label: 'Items' }, { name: 'hooks', label: 'Hooks' }, { name: 'mcp', label: 'MCP' },
    { name: 'warn', label: 'Health' }, { name: 'actions', label: 'Actions', hideLabel: true },
  ]
  const MARKETPLACE_COLUMNS = [
    { name: 'name', label: 'Marketplace' }, { name: 'source', label: 'Source' },
    { name: 'lastUpdated', label: 'Updated' }, { name: 'manifest', label: 'Manifest' },
    { name: 'actions', label: 'Actions', hideLabel: true },
  ]
  const AVAILABLE_COLUMNS = [
    { name: 'id', label: 'Available plugin' }, { name: 'description', label: 'Description' },
    { name: 'category', label: 'Category' }, { name: 'actions', label: 'Actions', hideLabel: true },
  ]
  const ITEM_COLUMNS = [
    { name: 'kind', label: 'Kind' }, { name: 'name', label: 'Name' }, { name: 'description', label: 'Description' },
    { name: 'origin', label: 'Origin' }, { name: 'model', label: 'Model' }, { name: 'warn', label: 'Health' },
  ]
  const HOOK_COLUMNS = [
    { name: 'event', label: 'Event' }, { name: 'matcher', label: 'Matcher' }, { name: 'command', label: 'Command' },
    { name: 'programs', label: 'Programs' }, { name: 'timeout', label: 'Timeout' }, { name: 'origin', label: 'Origin' },
  ]
  const MCP_COLUMNS = [
    { name: 'name', label: 'Server' }, { name: 'scope', label: 'Scope' }, { name: 'where', label: 'Project / plugin' },
    { name: 'transport', label: 'Transport' }, { name: 'target', label: 'Command / URL' },
    { name: 'keys', label: 'Env / header names' }, { name: 'actions', label: 'Actions', hideLabel: true },
  ]
  const SETTING_COLUMNS = [{ name: 'key', label: 'Setting' }, { name: 'value', label: 'Value' }]
  const PROJECT_COLUMNS = [
    { name: 'path', label: 'Project' }, { name: 'source', label: 'Found by' }, { name: 'exists', label: 'On disk' },
    { name: 'lastActive', label: 'Last active' }, { name: 'transcripts', label: 'Transcripts' },
    { name: 'model', label: 'Model' }, { name: 'plugins', label: 'Plugins on' }, { name: 'warn', label: 'Health' },
  ]
  const KIND_OPTIONS = [
    { value: '', label: 'All kinds' }, { value: 'skill', label: 'Skills' },
    { value: 'agent', label: 'Agents' }, { value: 'command', label: 'Commands' },
  ]

  let cfg      = null
  let error    = null
  let offered  = true
  let loading  = false
  let section  = 'overview'
  let seen     = { overview: true }
  let qs       = { plugins: '', marketplaces: '', skills: '', hooks: '', mcp: '', settings: '' }
  let kind     = ''
  let tables   = null
  let shown    = null
  let detail   = null   // { kind: 'item' | 'plugin' | 'hook' | 'memory', row }
  let drawer   = false
  let file     = null   // { path, bytes, text } for an item or memory drawer
  let fileErr  = null
  let writes   = null   // { rows, disabled } from `writes`
  let writesErr = null
  let editing  = false  // the drawer's file is open in ClaudeFileEdit
  let programs = null   // { path, byHook: { 'file\ncommand': [{ tool, found, unknown }] } } from `hookTools`
  let programsErr = null
  let root     = null

  async function readConfig() {
    try {
      cfg   = await claude.service.invoke('config', null)
      error = null
    } catch (err) {
      if (err.code === 404) offered = false
      error = err.message
    }
  }
  async function readWrites() {
    try {
      writes    = await claude.service.invoke('writes', null, {})
      writesErr = null
    } catch (err) {
      writesErr = err.message
    }
  }
  async function load() {
    loading = true
    await Promise.all([readConfig(), readWrites()])
    loading = false
  }
  // ─── live ────────────────────────────────────────────────────────────────────

  const POLL_MS = 3000
  // A poll in flight when the tab goes would reschedule itself after clearTimeout.
  let timer = null
  let destroyed = false
  function schedule() { if (!destroyed) timer = setTimeout(poll, POLL_MS) }
  // Only while someone can see it: the Workbench keeps this tab mounted behind its others.
  const watched = () => document.visibilityState === 'visible' && !!root?.isConnected && root.checkVisibility?.() !== false
  async function poll() {
    try {
      if (cfg && !loading && watched()) {
        const { rev } = await claude.service.invoke('rev', null)
        if (rev !== cfg.rev && !loading) await load()
      }
    } catch {}
    schedule()
  }
  $.onMount(() => { load(); schedule() })
  $.onDestroy(() => { destroyed = true; clearTimeout(timer) })

  // ─── hook programs ───────────────────────────────────────────────────────────

  async function readPrograms() {
    try {
      const r = await claude.service.invoke('hookTools', null)
      programs = { path: r.path, byHook: Object.fromEntries(r.hooks.map(h => [`${h.file}\n${h.command}`, h.tools])) }
      programsErr = null
    } catch (err) {
      programsErr = err.message
    }
  }
  // Read when the hooks section opens, and again after a reread while it shows.
  $: { if (section === 'hooks' && cfg) readPrograms() }
  const missing = (tools) => (tools ?? []).filter(t => !t.found)

  // After any write: the scan and the change list, so every control shows the new state.
  const wrote = () => load()

  $: { tables = cfg ? build(cfg) : null }
  $: { shown = tables ? narrow(tables, qs, kind) : null }

  // A section is read the first time it opens, so the rate-limited usage endpoint is
  // not asked for by a person looking at plugins.
  const onSection = (id) => { if (!seen[id]) seen = { ...seen, [id]: true } }

  const setQ = (id, v) => { qs = { ...qs, [id]: v } }

  // ─── detail drawer ───────────────────────────────────────────────────────────

  let asked = 0
  async function show(kind, row) {
    const n = ++asked
    detail  = { kind, row }
    drawer  = true
    file    = null
    fileErr = null
    editing = false
    if (kind !== 'item' && kind !== 'memory') return
    // A memory file the scan lists as absent has no text to read; Save creates it.
    if (kind === 'memory' && !row.exists) { file = { path: row.abs, bytes: 0, text: '' }; return }
    try {
      const f = await claude.service.invoke('file', null, { path: row.abs })
      // A slow answer for a drawer since closed or swapped must not land in the new one.
      if (n === asked) file = f
    } catch (err) {
      if (n === asked) fileErr = err.message
    }
  }
  const hide = () => { drawer = false; asked++; editing = false }

  async function saved() {
    const row = detail.row
    detail = { ...detail, row: { ...row, exists: true } }
    try { file = await claude.service.invoke('file', null, { path: row.abs }) } catch (err) { fileErr = err.message }
    await wrote()
  }
  const trashed = async () => { hide(); await wrote() }

  // ─── writes ──────────────────────────────────────────────────────────────────

  const act = (id, label, aria, method, args, confirm) => ({ id, label, aria, confirm, tone: confirm ? 'danger' : '', run: () => claude.service.invoke(method, null, args) })

  // An install's own scope, and the checkout a project or local one belongs to.
  function pluginActions(p) {
    if (!['user', 'project', 'local'].includes(p.scope)) return []
    const t = { id: p.id, scope: p.scope, ...(p.install.projectPath ? { project: p.install.projectPath } : {}) }
    const key = slug(p.id)
    return [
      p.enabled
        ? act(`claude-plugin-disable-${key}`, 'Disable', `Disable ${p.id}`, 'plugin', { ...t, action: 'disable' })
        : act(`claude-plugin-enable-${key}`, 'Enable', `Enable ${p.id}`, 'plugin', { ...t, action: 'enable' }),
      act(`claude-plugin-update-${key}`, 'Update', `Update ${p.id}`, 'plugin', { ...t, action: 'update' }),
      act(`claude-plugin-uninstall-${key}`, 'Uninstall', `Uninstall ${p.id}`, 'plugin', { ...t, action: 'uninstall' }, `Uninstall ${p.id}?`),
    ]
  }
  const installAction = (a) => [act(`claude-plugin-install-${slug(a.id)}`, 'Install', `Install ${a.id}`, 'plugin', { id: a.id, action: 'install', scope: 'user' })]
  const marketplaceActions = (k) => [
    act(`claude-marketplace-update-${slug(k.name)}`, 'Update', `Update ${k.name}`, 'marketplace', { action: 'update', name: k.name }),
    act(`claude-marketplace-remove-${slug(k.name)}`, 'Remove', `Remove ${k.name}`, 'marketplace', { action: 'remove', name: k.name }, `Remove ${k.name}?`),
  ]

  // A plugin's servers go with the plugin. A `.mcp.json` server is checked in, so it is
  // turned off in the local layer; a user or local one is removed (its config is kept for Enable).
  function mcpActions(m) {
    if (m.plugin) return []
    const t = { name: m.name, scope: m.scope, ...(m.scope === 'user' ? {} : { project: m.project }) }
    const key = slug(`${m.name}-${m.scope}`)
    const off = act(`claude-mcp-disable-${key}`, 'Disable', `Disable ${m.name}`, 'mcp', { ...t, action: 'disable' })
    if (m.scope === 'project') return [off, act(`claude-mcp-enable-${key}`, 'Enable', `Enable ${m.name}`, 'mcp', { ...t, action: 'enable' })]
    return [
      off,
      act(`claude-mcp-remove-${key}`, 'Remove', `Remove ${m.name}`, 'mcp', { ...t, action: 'remove' }, `Remove ${m.name}?`),
      ...(m.transport && m.transport !== 'stdio' ? [act(`claude-mcp-logout-${key}`, 'Log out', `Log out ${m.name}`, 'mcp', { ...t, action: 'logout' })] : []),
    ]
  }

  // The frontmatter is shown as facts above, so the drawer renders what follows it.
  const body = (text) => text.replace(/^---\r?\n[\s\S]*?\r?\n---\r?\n?/, '')
  const list = (v) => (v && v.length ? v.join(', ') : '—')
  const yes  = (v) => (v === null || v === undefined ? '—' : v ? 'yes' : 'no')

  // ─── shaping ─────────────────────────────────────────────────────────────────

  const plural = (n, word) => `${n} ${word}${n === 1 ? '' : 's'}`
  const squash = (s) => String(s ?? '').replace(/\s+/g, ' ').trim()
  const dash   = (v) => (v === null || v === undefined || v === '' ? '—' : String(v))
  const hay    = (...parts) => parts.flat().filter(p => p !== null && p !== undefined).join(' ').toLowerCase()

  function build(c) {
    const tilde = (p) => (p && c.home && (p === c.home || p.startsWith(`${c.home}/`)) ? `~${p.slice(c.home.length)}` : p ?? '')
    const notes = { plugins: [], marketplaces: [], skills: [], hooks: [], mcp: [], settings: [] }
    // A file that exists and would not read. An absent one is a state, not a failure.
    const failed = (section, label, loaded) => {
      if (loaded.result.ok || loaded.absent) return
      notes[section].push({ label, path: tilde(loaded.path), reason: loaded.result.reason })
    }
    const origin = (o) => o.scope === 'user' ? 'user' : o.scope === 'plugin' ? o.plugin : tilde(o.project)

    failed('settings', 'user settings', c.user.settings)
    failed('mcp', '~/.claude.json', c.mcp)
    failed('plugins', 'installed plugins', c.plugins.installed)
    failed('marketplaces', 'known marketplaces', c.plugins.marketplaces)

    const handlers = (sh) => sh.entries.ok ? sh.entries.value.reduce((n, e) => n + Math.max(1, e.handlers.length), 0) : 0

    // ─── plugins and marketplaces
    const plugins = c.plugins.list.map(p => {
      failed('plugins', `${p.install.id} manifest`, p.manifest)
      const bad = []
      if (!p.rootExists) bad.push('install folder is missing')
      if (!p.manifest.result.ok && !p.manifest.absent) bad.push(`manifest unavailable: ${p.manifest.result.reason}`)
      const r = {
        id: p.install.id, name: p.name, version: dash(p.install.version), scope: dash(p.install.scope),
        project: p.install.projectPath ? tilde(p.install.projectPath) : '',
        enabled: p.enabled, enabledIn: p.enabledIn.length, items: p.items.length,
        hooks: p.hooks.reduce((n, h) => n + handlers(h), 0), mcp: p.mcp.length, warn: bad.join('; '),
        manifest: p.manifest.result.ok ? p.manifest.result.value : null, install: p.install,
        installPath: tilde(p.install.installPath), projects: p.enabledIn.map(tilde),
        contents: p.items.map(i => ({ kind: i.kind, name: i.name })),
        hookEvents: p.hooks.flatMap(h => h.entries.ok ? h.entries.value.map(e => e.event) : []),
        servers: p.mcp.map(m => m.name),
      }
      return { ...r, hay: hay(r.id, r.name, r.version, r.scope, r.project, r.enabled ? 'enabled' : 'disabled', r.warn) }
    })

    const describeSource = (s) => s.kind === 'github' ? `github ${s.repo}${s.ref ? `@${s.ref}` : ''}`
      : s.kind === 'git' ? `git ${s.url}${s.ref ? `@${s.ref}` : ''}`
      : s.kind === 'url' ? `url ${s.url}`
      : s.kind === 'path' ? `path ${tilde(s.path)}` : 'unrecognized source'
    const catalogs = c.plugins.catalogs.map(k => {
      failed('marketplaces', `${k.marketplace.name} manifest`, k.manifest)
      const m = k.manifest.result
      const manifest = m.ok ? `${plural(m.value.plugins.length, 'plugin')} offered`
        : k.manifest.absent ? 'no manifest' : `unavailable: ${m.reason}`
      const r = {
        name: k.marketplace.name, source: describeSource(k.marketplace.source),
        lastUpdated: k.marketplace.lastUpdated ? ago(k.marketplace.lastUpdated) : '—',
        manifest, bad: !m.ok && !k.manifest.absent,
      }
      return { ...r, hay: hay(r.name, r.source, r.manifest) }
    })

    const installed = new Set(c.plugins.list.map(p => p.install.id))
    const available = c.plugins.catalogs.flatMap(k => {
      const m = k.manifest.result
      if (!m.ok) return []
      return m.value.plugins.map(o => ({ id: `${o.name}@${k.marketplace.name}`, name: o.name, marketplace: k.marketplace.name, description: squash(o.description), category: dash(o.category) }))
        .filter(o => !installed.has(o.id))
        .map(o => ({ ...o, hay: hay(o.id, o.description, o.category) }))
    })

    // ─── skills, agents, commands
    const items = []
    const addItems = (list) => {
      for (const s of list) {
        const v = s.item.ok ? s.item.value : null
        const bad = !s.item.ok ? [`unavailable: ${s.item.reason}`] : v.issues
        const r = {
          kind: s.kind, name: s.name, full: squash(v?.description), description: squash(v?.description),
          origin: origin(s.origin), originScope: s.origin.scope, model: dash(v?.model),
          file: tilde(s.file), abs: s.file, item: v, reason: s.item.ok ? null : s.item.reason, warn: bad.join('; '),
        }
        items.push({ ...r, hay: hay(r.kind, r.name, r.full, r.origin, r.model, r.warn) })
      }
    }
    addItems(c.user.items)
    c.plugins.list.forEach(p => addItems(p.items))
    c.projects.forEach(p => addItems(p.items))

    // ─── hooks
    const hooks = []
    const addHooks = (list) => {
      for (const sh of list) {
        if (!sh.entries.ok) {
          notes.hooks.push({ label: `hooks of ${origin(sh.origin)}`, path: tilde(sh.file), reason: sh.entries.reason })
          continue
        }
        for (const e of sh.entries.value) {
          for (const h of e.handlers.length ? e.handlers : [null]) {
            const r = {
              event: e.event, matcher: dash(e.matcher), command: h?.command ?? (h?.type ? `(${h.type})` : '—'),
              timeout: h?.timeout != null ? `${h.timeout}s` : '—', origin: origin(sh.origin), file: tilde(sh.file),
              handler: h, originScope: sh.origin.scope, warn: e.issues.join('; '), key: `${sh.file}\n${h?.command ?? ''}`,
            }
            hooks.push({ ...r, hay: hay(r.event, r.matcher, r.command, r.origin, r.file, r.warn) })
          }
        }
      }
    }
    addHooks(c.user.hooks)
    c.plugins.list.forEach(p => addHooks(p.hooks))
    c.projects.forEach(p => addHooks(p.hooks))

    // ─── MCP
    const mcp = []
    const addMcp = (list) => {
      for (const m of list) {
        const target = m.url ?? [m.command, ...m.args].filter(Boolean).join(' ')
        const r = {
          name: m.name, scope: m.scope, where: m.plugin ?? tilde(m.project) ?? '', transport: dash(m.transport),
          target: dash(target), keys: [...m.envKeys.map(k => `env ${k}`), ...m.headerKeys.map(k => `header ${k}`)].join(', '),
          oauth: m.hasOauth, warn: m.issues.join('; '), project: m.project, plugin: m.plugin, server: m,
        }
        mcp.push({ ...r, hay: hay(r.name, r.scope, r.where, r.transport, r.target, r.keys, r.warn) })
      }
    }
    if (c.mcp.result.ok) { addMcp(c.mcp.result.value.user); addMcp(c.mcp.result.value.local) }
    c.plugins.list.forEach(p => addMcp(p.mcp))
    for (const p of c.projects) {
      failed('mcp', `${tilde(p.path)} .mcp.json`, p.mcpJson)
      if (p.mcpJson.result.ok) addMcp(p.mcpJson.result.value)
    }

    // ─── settings
    const s = c.user.settings.result.ok ? c.user.settings.result.value : null
    const settings = []
    if (s) {
      const n = (list) => String(list.length)
      const rows = [
        ['model', s.model], ['effortLevel', s.effortLevel], ['theme', s.theme], ['outputStyle', s.outputStyle],
        ['language', s.language], ['alwaysThinkingEnabled', s.alwaysThinkingEnabled],
        ['cleanupPeriodDays', s.cleanupPeriodDays], ['permissions.defaultMode', s.permissions.defaultMode],
        ['permissions.allow', `${n(s.permissions.allow)} rules`], ['permissions.ask', `${n(s.permissions.ask)} rules`],
        ['permissions.deny', `${n(s.permissions.deny)} rules`],
        ['permissions.additionalDirectories', n(s.permissions.additionalDirectories)],
        ['enabledPlugins', `${Object.values(s.enabledPlugins).filter(Boolean).length} on of ${Object.keys(s.enabledPlugins).length}`],
        ['env (names only)', s.envKeys.join(', ') || 'none'], ['apiKeyHelper', s.apiKeyHelper ? 'set' : 'not set'],
        ...s.issues.map(i => ['issue', i]),
      ]
      for (const [key, value] of rows) settings.push({ key, value: dash(value), hay: hay(key, dash(value)) })
    }
    const projects = c.projects.map(p => {
      const bad = []
      for (const [label, l] of [['project settings', p.settings.project], ['local settings', p.settings.local]]) {
        if (!l.result.ok && !l.absent) { bad.push(`${label} unavailable: ${l.result.reason}`); failed('settings', `${tilde(p.path)} ${label}`, l) }
      }
      const r = {
        path: tilde(p.path), abs: p.path, source: p.source, exists: p.exists, lastActive: p.lastActive,
        transcripts: p.transcripts, model: dash(p.settings.merged.model), plugins: p.enabledPlugins.length, warn: bad.join('; '),
      }
      return { ...r, hay: hay(r.path, r.source, r.exists ? 'on disk' : 'gone', r.model, r.warn) }
    })

    // ─── overview
    const kinds = (k) => items.filter(i => i.kind === k).length
    const memory = [
      ...c.user.memory.map(m => ({ ...m, abs: m.path, path: tilde(m.path) })),
      ...c.projects.flatMap(p => p.memory.filter(m => m.exists).map(m => ({ ...m, abs: m.path, path: tilde(m.path) }))),
    ]
    const issues = c.issues.map(i => ({ path: tilde(i.path), message: i.message }))
    const counts = [
      ['Plugins', plugins.length, `${plugins.filter(p => p.enabled).length} enabled`],
      ['Marketplaces', catalogs.length, ''],
      ['Skills & agents', items.length, [plural(kinds('skill'), 'skill'), plural(kinds('agent'), 'agent'), plural(kinds('command'), 'command')].join(', ')],
      ['Hook handlers', hooks.length, ''],
      ['MCP servers', mcp.length, ''],
      ['Projects', projects.length, `${projects.filter(p => !p.exists).length} gone from disk`],
    ]
    const unavailable = Object.values(notes).flat()

    // Pinned checkouts first, as the scan lists them.
    const choices = projects.map(p => ({ value: p.abs, label: p.path, pinned: p.source !== 'transcript', exists: p.exists }))
    return { choices, plugins, catalogs, available, items, hooks, mcp, settings, projects, notes, memory, issues, counts, unavailable }
  }

  // Case-insensitive match on the text a row shows, section by section.
  function narrow(t, q, k) {
    const pick = (rows, term) => {
      const w = (term ?? '').trim().toLowerCase()
      return w ? rows.filter(r => r.hay.includes(w)) : rows
    }
    return {
      plugins: pick(t.plugins, q.plugins), catalogs: pick(t.catalogs, q.marketplaces), available: pick(t.available, q.marketplaces),
      items: pick(k ? t.items.filter(i => i.kind === k) : t.items, q.skills),
      hooks: pick(t.hooks, q.hooks), mcp: pick(t.mcp, q.mcp),
      settings: pick(t.settings, q.settings), projects: pick(t.projects, q.settings),
    }
  }

  const clip = (s, n) => (s.length > n ? `${s.slice(0, n - 1)}…` : s)
</script>

<section id="claude-code" class="stack" bind:this={root}>
  <header class="cluster claude-head">
    <div>
      <h2>Claude Code on this machine</h2>
      <p class="text-sm text-muted">
        Machine-wide, not per checkout.
        {#if cfg}
          Config dir <code>{cfg.configDir.replace(cfg.home, '~')}</code>,
          scanned in {cfg.durationMs} ms, {ago(cfg.scannedAt)}.
        {/if}
      </p>
    </div>
    <Button id="claude-refresh" treatment="outlined" size="sm" loading={loading} disabled={loading || !offered}
            onclick={load}>Refresh</Button>
  </header>

  {#if !offered}
    <Callout tone="muted" title="Not offered on this Basecamp">{error}</Callout>
  {:else if error && !cfg}
    <Callout tone="danger" title="Could not read Claude Code's configuration">{error}</Callout>
  {:else if !shown}
    <p class="text-sm text-muted">Reading…</p>
  {:else}
    {#if error}<Callout tone="warning" title="Refresh failed, showing the last read">{error}</Callout>{/if}

    <Tabs bind:activeId={section} onchange={onSection}>
      <TabList label="Claude Code sections" class="claude-sections">
        {#each SECTIONS as s}
          <Tab id={s[0]}>{s[1]}</Tab>
        {/each}
      </TabList>

      <TabPanel id="overview">
        <div class="grid" id="claude-overview">
          {#each tables.counts as c}
            <Stat label={c[0]} value={c[1]} sub={c[2]} />
          {/each}
        </div>

        {#if tables.unavailable.length || tables.issues.length}
          <Callout tone="warning" title="Reads that did not complete">
            <ul>
              {#each tables.unavailable as u}
                <li>{u.label}: <strong>unavailable: {u.reason}</strong> <code>{u.path}</code></li>
              {/each}
              {#each tables.issues as i}
                <li><code>{i.path}</code> {i.message}</li>
              {/each}
            </ul>
          </Callout>
        {/if}

        <h3>Memory files</h3>
        <Table id="claude-memory" compact striped hover={false} emptyText="No memory files"
               columns={[{ name: 'kind', label: 'Kind' }, { name: 'path', label: 'Path' }, { name: 'exists', label: 'Exists' }, { name: 'bytes', label: 'Bytes', align: 'right' }]}
               rows={tables.memory}>
          {#snippet row(m)}
            <tr>
              <td><Badge>{m.kind}</Badge></td>
              <td>
                {#if m.exists}<Button treatment="link" size="sm" onclick={() => show('memory', m)}><code>{m.path}</code></Button>
                {:else if m.kind !== 'managed'}<Button treatment="link" size="sm" aria-label={`Create ${m.path}`} onclick={() => show('memory', m)}><code>{m.path}</code></Button>
                {:else}<code>{m.path}</code>{/if}
              </td>
              <td>{#if m.exists}<Pill tone="success">yes</Pill>{:else}<Pill>no</Pill>{/if}</td>
              <td class="text-right">{m.bytes ?? '—'}</td>
            </tr>
          {/snippet}
        </Table>
      </TabPanel>

      <TabPanel id="plugins">
        {#each tables.notes.plugins as n}
          <Callout tone="warning" title={`${n.label} unavailable`}>{n.reason} <code>{n.path}</code></Callout>
        {/each}
        <Input id="claude-search-plugins" type="search" placeholder="Filter plugins…" aria-label="Filter plugins"
               value={qs.plugins} oninput={(e) => setQ('plugins', e.target.value)} />
        <Table id="claude-plugins" columns={PLUGIN_COLUMNS} rows={shown.plugins} striped hover={false} emptyText="No plugins match">
          {#snippet row(p)}
            <tr>
              <td>
                <Button treatment="link" size="sm" onclick={() => show('plugin', p)}>{p.name}</Button>
                <span class="text-sm text-muted"><code>{p.id}</code></span>
              </td>
              <td>{p.version}</td>
              <td>
                <Badge>{p.scope}</Badge>
                {#if p.project}<span class="text-sm text-muted"><code>{p.project}</code></span>{/if}
              </td>
              <td>{#if p.enabled}<Pill tone="success">on</Pill>{:else}<Pill>off</Pill>{/if}</td>
              <td>{p.enabledIn}</td>
              <td>{p.items}</td>
              <td>{p.hooks}</td>
              <td>{p.mcp}</td>
              <td>{#if p.warn}<Badge tone="warning" title={p.warn}>{p.warn}</Badge>{:else}<span class="text-muted">ok</span>{/if}</td>
              <td><ClaudeActions actions={pluginActions(p)} onwrote={wrote} /></td>
            </tr>
          {/snippet}
        </Table>
      </TabPanel>

      <TabPanel id="marketplaces">
        {#each tables.notes.marketplaces as n}
          <Callout tone="warning" title={`${n.label} unavailable`}>{n.reason} <code>{n.path}</code></Callout>
        {/each}
        <ClaudeMarketplaceAdd onwrote={wrote} />
        <Input id="claude-search-marketplaces" type="search" placeholder="Filter marketplaces…" aria-label="Filter marketplaces"
               value={qs.marketplaces} oninput={(e) => setQ('marketplaces', e.target.value)} />
        <Table id="claude-marketplaces" columns={MARKETPLACE_COLUMNS} rows={shown.catalogs} striped hover={false} emptyText="No marketplaces match">
          {#snippet row(k)}
            <tr>
              <td>{k.name}</td>
              <td><code class="clip" title={k.source}>{k.source}</code></td>
              <td class="text-sm text-muted">{k.lastUpdated}</td>
              <td>{#if k.bad}<Badge tone="warning" title={k.manifest}>{k.manifest}</Badge>{:else}<span class="text-sm text-muted">{k.manifest}</span>{/if}</td>
              <td><ClaudeActions actions={marketplaceActions(k)} onwrote={wrote} /></td>
            </tr>
          {/snippet}
        </Table>
        <h3>Available plugins</h3>
        <Table id="claude-available" columns={AVAILABLE_COLUMNS} rows={shown.available} limit={25} striped hover={false} compact emptyText="Every offered plugin is installed, or none match">
          {#snippet row(a)}
            <tr>
              <td><code>{a.id}</code></td>
              <td class="text-sm" title={a.description}>{clip(a.description, 120)}</td>
              <td class="text-sm">{a.category}</td>
              <td><ClaudeActions actions={installAction(a)} onwrote={wrote} /></td>
            </tr>
          {/snippet}
        </Table>
      </TabPanel>

      <TabPanel id="skills">
        <div class="cluster">
          <Input id="claude-search-skills" type="search" placeholder="Filter skills and agents…" aria-label="Filter skills and agents"
                 value={qs.skills} oninput={(e) => setQ('skills', e.target.value)} />
          <Select id="claude-kind" name="kind" label="" placeholder="" aria-label="Kind" options={KIND_OPTIONS}
                  value={kind} onchange={(e) => { kind = e.target.value }} />
        </div>
        <Table id="claude-skills" columns={ITEM_COLUMNS} rows={shown.items} striped hover={false} compact emptyText="No skills or agents match">
          {#snippet row(i)}
            <tr>
              <td><Badge tone={i.kind === 'agent' ? 'info' : ''}>{i.kind}</Badge></td>
              <td title={i.file}><Button treatment="link" size="sm" onclick={() => show('item', i)}><code>{i.name}</code></Button></td>
              <td class="text-sm" title={i.full}>{clip(i.description, 140)}</td>
              <td class="text-sm"><Badge>{i.originScope}</Badge> {#if i.originScope !== 'user'}<code>{i.origin}</code>{/if}</td>
              <td class="text-sm">{i.model}</td>
              <td>{#if i.warn}<Badge tone="warning" title={i.warn}>{clip(i.warn, 60)}</Badge>{:else}<span class="text-muted">ok</span>{/if}</td>
            </tr>
          {/snippet}
        </Table>
      </TabPanel>

      <TabPanel id="hooks">
        {#each tables.notes.hooks as n}
          <Callout tone="warning" title={`${n.label} unavailable`}>{n.reason} <code>{n.path}</code></Callout>
        {/each}
        {#if programsErr}<Callout tone="warning" title="Could not check the programs hooks call">{programsErr}</Callout>{/if}
        <Input id="claude-search-hooks" type="search" placeholder="Filter hooks…" aria-label="Filter hooks"
               value={qs.hooks} oninput={(e) => setQ('hooks', e.target.value)} />
        <p class="text-sm text-muted">
          Programs are read off each command line and looked up on the Basecamp API's PATH, which is the shell it was
          started from and may not be the one Claude Code runs in.
          <Button id="claude-hooks-recheck" treatment="link" size="sm" onclick={readPrograms}>Check again</Button>
        </p>
        <Table id="claude-hooks" columns={HOOK_COLUMNS} rows={shown.hooks} striped hover={false} compact emptyText="No hooks match">
          {#snippet row(h)}
            <tr>
              <td><Button treatment="link" size="sm" onclick={() => show('hook', h)}>{h.event}</Button></td>
              <td>{#if h.matcher === '—'}—{:else}<code>{h.matcher}</code>{/if}</td>
              <td>
                <code class="wrap">{h.command}</code>
                {#if h.warn}<Badge tone="warning" title={h.warn}>issue</Badge>{/if}
              </td>
              <td class="text-sm">{@render tools(programs?.byHook[h.key], false)}</td>
              <td>{h.timeout}</td>
              <td class="text-sm" title={h.file}><code class="wrap">{h.origin}</code></td>
            </tr>
          {/snippet}
        </Table>
      </TabPanel>

      <TabPanel id="mcp">
        {#each tables.notes.mcp as n}
          <Callout tone="warning" title={`${n.label} unavailable`}>{n.reason} <code>{n.path}</code></Callout>
        {/each}
        <Input id="claude-search-mcp" type="search" placeholder="Filter MCP servers…" aria-label="Filter MCP servers"
               value={qs.mcp} oninput={(e) => setQ('mcp', e.target.value)} />
        <Table id="claude-mcp" columns={MCP_COLUMNS} rows={shown.mcp} striped hover={false} emptyText="No MCP servers match">
          {#snippet row(m)}
            <tr>
              <td>
                <Button treatment="link" size="sm" aria-label={`Tools of ${m.name}`} onclick={() => show('mcp', m)}><code>{m.name}</code></Button>
                {#if m.oauth}<Badge>oauth</Badge>{/if}
                {#if m.warn}<Badge tone="warning" title={m.warn}>issue</Badge>{/if}
              </td>
              <td><Badge>{m.scope}</Badge></td>
              <td class="text-sm">{#if m.where}<code>{m.where}</code>{:else}—{/if}</td>
              <td>{m.transport}</td>
              <td><code class="clip" title={m.target}>{clip(m.target, 90)}</code></td>
              <td class="text-sm text-muted">{m.keys || '—'}</td>
              <td><ClaudeActions actions={mcpActions(m)} onwrote={wrote} /></td>
            </tr>
          {/snippet}
        </Table>
        <ClaudeMcpEdit projects={tables.choices} disabled={writes?.disabled ?? []} home={cfg.home} onwrote={wrote} />
        <ClaudeMcpHealth projects={tables.choices} home={cfg.home} />
      </TabPanel>

      <TabPanel id="settings">
        {#each tables.notes.settings as n}
          <Callout tone="warning" title={`${n.label} unavailable`}>{n.reason} <code>{n.path}</code></Callout>
        {/each}
        <Input id="claude-search-settings" type="search" placeholder="Filter settings and projects…" aria-label="Filter settings and projects"
               value={qs.settings} oninput={(e) => setQ('settings', e.target.value)} />
        <h3>User settings</h3>
        {#if !cfg.user.settings.result.ok && !cfg.user.settings.absent}
          <p class="text-sm"><Badge tone="warning">unavailable: {cfg.user.settings.result.reason}</Badge></p>
        {:else}
          <Table id="claude-settings" columns={SETTING_COLUMNS} rows={shown.settings} compact striped hover={false}
                 emptyText={cfg.user.settings.absent ? 'No user settings file' : 'No settings match'}>
            {#snippet row(r)}
              <tr><td><code>{r.key}</code></td><td>{r.value}</td></tr>
            {/snippet}
          </Table>
        {/if}
        <h3>Projects</h3>
        <Table id="claude-projects" columns={PROJECT_COLUMNS} rows={shown.projects} compact striped hover={false} emptyText="No projects match">
          {#snippet row(p)}
            <tr>
              <td><code class="wrap">{p.path}</code></td>
              <td><Badge>{p.source}</Badge></td>
              <td>{#if p.exists}<Pill tone="success">yes</Pill>{:else}<Pill tone="warning">gone</Pill>{/if}</td>
              <td class="text-sm text-muted">{ago(p.lastActive)}</td>
              <td>{p.transcripts}</td>
              <td class="text-sm">{p.model}</td>
              <td>{p.plugins}</td>
              <td>{#if p.warn}<Badge tone="warning" title={p.warn}>{clip(p.warn, 60)}</Badge>{:else}<span class="text-muted">ok</span>{/if}</td>
            </tr>
          {/snippet}
        </Table>
      </TabPanel>

      <TabPanel id="editor">
        <ClaudeSettingsEditor config={cfg} onwrote={wrote} />
      </TabPanel>

      <TabPanel id="changes">
        {#if writesErr}<Callout tone="danger" title="Could not read the change list">{writesErr}</Callout>{/if}
        <ClaudeChanges rows={writes?.rows ?? []} home={cfg.home} onwrote={wrote} />
      </TabPanel>

      <TabPanel id="doctor">
        {#if seen.doctor}<ClaudeDoctor projects={tables.choices} home={cfg.home} />{/if}
      </TabPanel>

      <TabPanel id="limits">
        {#if seen.limits}<ClaudeLimits />{/if}
      </TabPanel>

      <TabPanel id="context">
        {#if seen.context}<ClaudeContext projects={tables.choices} />{/if}
      </TabPanel>

      <TabPanel id="usage">
        {#if seen.usage}<ClaudeUsage home={cfg.home} />{/if}
      </TabPanel>

      <TabPanel id="drivers">
        {#if seen.drivers}<ClaudeDrivers home={cfg.home} />{/if}
      </TabPanel>

      <TabPanel id="sessions">
        {#if seen.sessions}<ClaudeSessions projects={tables.choices} home={cfg.home} />{/if}
      </TabPanel>
    </Tabs>
  {/if}

  <Drawer open={drawer} onclose={hide} resizable width={640}
          title={!detail ? '' : detail.kind === 'hook' ? `${detail.row.event} hook` : detail.kind === 'memory' ? detail.row.path : detail.kind === 'mcp' ? `${detail.row.name} MCP server` : detail.row.name}>
    {#if detail?.kind === 'item'}
      {@const i = detail.row}
      {@const v = i.item}
      <dl class="facts" id="claude-detail-item">
        <dt>Kind</dt><dd><Badge>{i.kind}</Badge></dd>
        <dt>Origin</dt><dd><Badge>{i.originScope}</Badge> {#if i.originScope !== 'user'}<code>{i.origin}</code>{/if}</dd>
        <dt>File</dt><dd><code class="wrap">{i.file}</code></dd>
        {#if v}
          <dt>Description</dt><dd>{v.description ?? '—'}</dd>
          {#if v.whenToUse}<dt>When to use</dt><dd>{v.whenToUse}</dd>{/if}
          <dt>Model</dt><dd>{v.model ?? '—'}</dd>
          {#if v.tools}<dt>Tools</dt><dd><code class="wrap">{list(v.tools)}</code></dd>{/if}
          {#if v.allowedTools}<dt>Allowed tools</dt><dd><code class="wrap">{list(v.allowedTools)}</code></dd>{/if}
          {#if v.disallowedTools}<dt>Disallowed tools</dt><dd><code class="wrap">{list(v.disallowedTools)}</code></dd>{/if}
          {#if v.argumentHint}<dt>Argument hint</dt><dd><code>{v.argumentHint}</code></dd>{/if}
          <dt>Model may invoke</dt><dd>{v.disableModelInvocation === null ? 'yes, by default' : yes(!v.disableModelInvocation)}</dd>
          <dt>User may invoke</dt><dd>{v.userInvocable === null ? 'yes, by default' : yes(v.userInvocable)}</dd>
          <dt>Listing cost</dt><dd>~{v.indexTokens} tokens always loaded; body {v.bodyChars} characters when used</dd>
          {#if v.otherKeys.length}<dt>Other keys</dt><dd><code class="wrap">{list(v.otherKeys)}</code></dd>{/if}
          {#if v.issues.length}<dt>Health</dt><dd>{#each v.issues as w}<Badge tone="warning">{w}</Badge> {/each}</dd>{/if}
        {:else}
          <dt>Frontmatter</dt><dd><Badge tone="warning">unavailable: {i.reason}</Badge></dd>
        {/if}
      </dl>
      {#if file && i.originScope !== 'plugin'}
        <ClaudeFileEdit path={i.abs} text={file.text} trashable bind:editing={editing} onsaved={saved} ontrashed={trashed} />
      {/if}
      {#if !editing}{@render text()}{/if}
    {:else if detail?.kind === 'memory'}
      {@const m = detail.row}
      <dl class="facts" id="claude-detail-memory">
        <dt>Kind</dt><dd><Badge>{m.kind}</Badge></dd>
        <dt>Bytes</dt><dd>{m.bytes ?? '—'} <span class="text-sm text-muted">its own; @imports are not followed</span></dd>
      </dl>
      {#if file && m.kind !== 'managed'}
        <ClaudeFileEdit path={m.abs} text={file.text} exists={m.exists} bind:editing={editing} onsaved={saved} />
      {/if}
      {#if !editing}{@render text()}{/if}
    {:else if detail?.kind === 'plugin'}
      {@const p = detail.row}
      <dl class="facts" id="claude-detail-plugin">
        <dt>Id</dt><dd><code>{p.id}</code></dd>
        <dt>Description</dt><dd>{p.manifest?.description ?? '—'}</dd>
        <dt>Author</dt><dd>{#if p.manifest?.author}{p.manifest.author.name}{#if p.manifest.author.email} <span class="text-muted">&lt;{p.manifest.author.email}&gt;</span>{/if}{:else}—{/if}</dd>
        <dt>Version</dt><dd>{p.version}{#if p.install.gitCommitSha} <code class="text-sm">{p.install.gitCommitSha.slice(0, 12)}</code>{/if}</dd>
        <dt>Scope</dt><dd><Badge>{p.scope}</Badge> {#if p.project}<code>{p.project}</code>{/if}</dd>
        <dt>Enabled</dt><dd>{#if p.enabled}<Pill tone="success">on</Pill>{:else}<Pill>off</Pill>{/if} at user level</dd>
        <dt>On in projects</dt>
        <dd>
          {#if p.projects.length}
            <details><summary>{plural(p.projects.length, 'project')}</summary>
              {#each p.projects as pp}<code class="wrap">{pp}</code><br>{/each}
            </details>
          {:else}—{/if}
        </dd>
        <dt>Installed</dt><dd>{p.install.installedAt ? ago(p.install.installedAt) : '—'}, updated {p.install.lastUpdated ? ago(p.install.lastUpdated) : '—'}</dd>
        <dt>Install folder</dt><dd><code class="wrap">{p.installPath || '—'}</code></dd>
        {#if p.warn}<dt>Health</dt><dd><Badge tone="warning">{p.warn}</Badge></dd>{/if}
      </dl>
      <h3>Skills, agents and commands ({p.contents.length})</h3>
      {#if p.contents.length}
        <ul class="plain">{#each p.contents as c}<li><Badge>{c.kind}</Badge> <code>{c.name}</code></li>{/each}</ul>
      {:else}<p class="text-sm text-muted">None</p>{/if}
      <h3>Hooks ({p.hookEvents.length})</h3>
      <p class="text-sm">{p.hookEvents.length ? p.hookEvents.join(', ') : 'None'}</p>
      <h3>MCP servers ({p.servers.length})</h3>
      <p class="text-sm">{#if p.servers.length}{#each p.servers as n}<code>{n}</code> {/each}{:else}None{/if}</p>
    {:else if detail?.kind === 'mcp'}
      {@const m = detail.row}
      <dl class="facts" id="claude-detail-mcp">
        <dt>Scope</dt><dd><Badge>{m.scope}</Badge> {#if m.where}<code class="wrap">{m.where}</code>{/if}</dd>
        <dt>Transport</dt><dd>{m.transport}</dd>
        <dt>Command / URL</dt><dd><code class="wrap">{m.target}</code></dd>
        <dt>Env / header names</dt><dd class="text-sm">{m.keys || '—'}</dd>
        {#if m.warn}<dt>Health</dt><dd><Badge tone="warning">{m.warn}</Badge></dd>{/if}
      </dl>
      <h3>Tools</h3>
      {#key m}<ClaudeMcpTools server={m.server} />{/key}
    {:else if detail?.kind === 'hook'}
      {@const h = detail.row}
      <dl class="facts" id="claude-detail-hook">
        <dt>Event</dt><dd>{h.event}</dd>
        <dt>Matcher</dt><dd>{#if h.matcher === '—'}— <span class="text-sm text-muted">every call</span>{:else}<code class="wrap">{h.matcher}</code>{/if}</dd>
        <dt>Type</dt><dd>{h.handler?.type ?? '—'}</dd>
        <dt>Timeout</dt><dd>{h.timeout}</dd>
        <dt>Async</dt><dd>{yes(h.handler?.async)}</dd>
        {#if h.handler?.statusMessage}<dt>Status message</dt><dd>{h.handler.statusMessage}</dd>{/if}
        {#if h.handler?.otherKeys.length}<dt>Other keys</dt><dd><code>{list(h.handler.otherKeys)}</code></dd>{/if}
        <dt>Origin</dt><dd><Badge>{h.originScope}</Badge> {#if h.originScope !== 'user'}<code class="wrap">{h.origin}</code>{/if}</dd>
        <dt>Declared in</dt><dd><code class="wrap">{h.file}</code></dd>
        {#if h.warn}<dt>Health</dt><dd><Badge tone="warning">{h.warn}</Badge></dd>{/if}
      </dl>
      <h3>Programs</h3>
      <p class="text-sm">{@render tools(programs?.byHook[h.key], true)}</p>
      <h3>Command</h3>
      {#if h.handler?.command}<Code text={h.handler.command} language="bash" />{:else}<p class="text-sm text-muted">No command</p>{/if}
    {/if}
  </Drawer>
</section>

{#snippet tools(list, all)}
  {#if !list}<span class="text-muted">—</span>
  {:else if !list.length}<span class="text-muted">none read</span>
  {:else}
    {#each all ? list : missing(list) as t}
      {#if t.found}<Badge tone="success" title={t.found}>{t.tool}</Badge>
      {:else if t.unknown}<Badge title={t.unknown}>{t.tool}: {t.unknown}</Badge>
      {:else}<Badge tone="danger" title="not found on PATH">{t.tool} missing</Badge>{/if}
    {/each}
    {#if !all && !missing(list).length}<span class="text-muted">all found</span>{/if}
  {/if}
{/snippet}

{#snippet text()}
  <h3>Contents</h3>
  {#if fileErr}
    <Callout tone="warning" title="Could not read the file">{fileErr}</Callout>
  {:else if !file}
    <p class="text-sm text-muted">Reading…</p>
  {:else}
    <div id="claude-detail-text" class="detail-text"><Markdown text={body(file.text)} headingBase={4} /></div>
  {/if}
{/snippet}

<style>
  /* Eleven tabs do not fit one row, and the kit's strip scrolls with its scrollbar hidden, which hides the tabs past the edge. */
  :global(.tablist.claude-sections) { flex-wrap: wrap; overflow: visible; mask-image: none; animation: none; }
  .claude-head { justify-content: space-between; align-items: flex-start; }
  .wrap { overflow-wrap: anywhere; }
  .facts > dd { overflow-wrap: anywhere; }
  .plain { list-style: none; padding: 0; margin: 0; }
  .detail-text { overflow-wrap: anywhere; }
  .clip { display: inline-block; max-inline-size: var(--measure, 64ch); overflow: hidden; text-overflow: ellipsis; white-space: nowrap; vertical-align: bottom; }
</style>
