<script>
  // ReadOnlyCopy.mesa — an App's read-only copy turned on or off, its refresh
  // schedule and its machine (`IDEAS/read-only-copy.md` 2.1, `FJS-D2001`).
  //
  // `AppCopy` is `@@gate(5)` for reads as well, and `session.level` does not
  // know the workspace role, so the server's 403 is what tells this card the
  // caller is not an administrator.
  //
  // It POLLS while a refresh is unsettled, as AppBackups does: the job writes
  // the outcome at system, and that write announces nothing.
  //
  // "Serve at the main address" sends every user of the App to yesterday's
  // data (3.1), so the button asks once more on the card before it writes.
  import { appCopies } from '../resources/AppCopy.mesa'
  import { servers }   from '../resources/Server.mesa'
  import { at, ago }   from '../lib/datetime.js'

  import Button from '@frontierjs/ui/components/forms/Button.mesa'
  import Card   from '@frontierjs/ui/components/layout/Card.mesa'
  import Pill   from '@frontierjs/ui/components/display/Pill.mesa'
  import Select from '@frontierjs/ui/components/forms/Select.mesa'
  import Switch from '@frontierjs/ui/components/forms/Switch.mesa'
  import { toasts } from '@frontierjs/ui/stores/toastStore'

  export let app = null

  const SCHEDULES = [
    { value: '0 3 * * *',   label: 'Nightly, 03:00' },
    { value: '0 */6 * * *', label: 'Every 6 hours' },
    { value: '0 * * * *',   label: 'Hourly' },
    { value: '0 3 * * 0',   label: 'Weekly, Sunday 03:00' },
  ]
  const STATUS_TONE = { success: 'success', failed: 'danger', timeout: 'danger', running: 'info', pending: 'info' }

  let copy     = null
  let machines = []
  let loading  = true
  let denied   = false
  let error    = null
  let busy     = false
  let serverId = ''
  let cron     = SCHEDULES[0].value
  let confirm  = false

  // A cron set some other way is offered as itself, not snapped to a preset.
  $: schedules = copy && !SCHEDULES.some(s => s.value === copy.cron)
    ? [...SCHEDULES, { value: copy.cron, label: copy.cron }]
    : SCHEDULES
  $: machineName = (id) => machines.find(m => m.id === id)?.name ?? id

  async function load() {
    try {
      const [rows, fleet] = await Promise.all([
        appCopies.service.find({ appId: app.id }, { limit: 1 }),
        machines.length ? null : servers.service.find({}, { limit: 200 }),
      ])
      if (fleet) machines = fleet.data
      copy  = rows.data[0] ?? null
      error = null
      if (copy) { serverId = copy.serverId; cron = copy.cron }
      else if (!serverId) serverId = (machines.find(m => m.status === 'online') ?? machines[0])?.id ?? ''
    } catch (e) {
      if (e.status === 403) denied = true
      else error = e.message
    } finally {
      loading = false
    }
  }

  load()

  // A row with no status is a refresh queued; one the queue never runs would
  // poll forever, so watching stops ten minutes after the last act.
  $: unsettled = !!copy && (copy.status == null || copy.status === 'pending' || copy.status === 'running')
  let watching   = true
  let watchRuns  = 0
  $.every(2000, load, { when: unsettled && watching })
  $.after(600_000, () => { watching = false }, { key: watchRuns, when: watching })

  // The off answer and a move say whether the old machine stopped serving;
  // one that could not be reached may still be, and the person has to know.
  function leftBehind(machine, name) {
    if (machine && !machine.ok) toasts.warning(`${name} could not be told to stop serving the copy: ${machine.why}`)
  }

  async function act(fn) {
    error = null; busy = true
    try { await fn() } catch (e) { error = e.message } finally { busy = false }
  }

  const turnOn = () => act(async () => {
    copy = await appCopies.service.create({ appId: app.id, serverId, cron })
    toasts.success(`Copy turned on. ${machineName(serverId)} is staging it now.`)
    watching = true
    watchRuns++
  })

  const turnOff = () => act(async () => {
    const was = copy
    const answer = await appCopies.service.remove(was.id)
    copy = null
    leftBehind(answer.machine, machineName(was.serverId))
    toasts.success('Copy turned off')
  })

  const serveMain = (on) => act(async () => {
    copy = await appCopies.service.patch(copy.id, { isServingMainAddress: on })
    confirm = false
    toasts.success(on
      ? `The main address now points at ${machineName(copy.serverId)}. Resolvers follow within about five minutes.`
      : 'The main address points back at the app. The copy keeps answering it until its next refresh.')
  })

  const change = (data) => act(async () => {
    const from = copy.serverId
    const answer = await appCopies.service.patch(copy.id, data)
    copy = answer
    leftBehind(answer.machine, machineName(from))
    watching = true
    watchRuns++
  })
</script>

<Card id="app-copy">
  <div class="section-header">
    <h2 class="h4">Read-only copy</h2>
    {#if copy}
      <Pill tone={STATUS_TONE[copy.status] ?? 'muted'} data-copy-status>{copy.status ?? 'waiting'}</Pill>
    {/if}
  </div>
  <p class="text-sm text-muted">
    This app's own API over its replica, on a machine of your choosing. It answers reads and refuses
    every write, and is re-staged on the schedule below.
  </p>

  {#if error}
    <article class="alert danger" id="app-copy-error"><div class="alert-content">{error}</div></article>
  {/if}

  {#if loading}
    <p class="text-sm text-muted">Loading…</p>
  {:else if denied}
    <p class="text-sm text-muted" id="app-copy-denied">An administrator of this workspace turns the copy on or off.</p>
  {:else if !app.replicaDestinationId && !copy}
    <p class="text-sm text-muted" id="app-copy-no-replica">
      A copy is served from the app's replica, and this app names no replica destination.
    </p>
  {:else}
    <Switch id="app-copy-on" label={copy ? 'On' : 'Off'} checked={!!copy} disabled={busy || (!copy && !serverId) || copy?.isServingMainAddress}
            onchange={(on) => on ? turnOn() : turnOff()} />

    {#if copy}
      <p class="text-sm" id="app-copy-as-of">
        {#if copy.asOf}As of {at(copy.asOf)}{:else}No copy served yet{/if}
        on <strong>{machineName(copy.serverId)}</strong>
        {#if copy.refreshedAt} · last refreshed {ago(copy.refreshedAt)}{/if}
      </p>
      <p class="text-sm" id="app-copy-address">
        {#if copy.address && copy.asOf}
          Address <a href={`https://${copy.address}/`} target="_blank" rel="noopener"><code>{copy.address}</code></a>
        {:else if copy.address}
          Will answer at <code>{copy.address}</code> once a refresh has served it
        {:else}
          <span class="text-muted">No address yet: the workspace needs an ingress zone and its wildcard certificate</span>
        {/if}
      </p>
      {#if copy.error}
        <p class="text-sm text-danger" id="app-copy-refresh-error">The last refresh failed: {copy.error}</p>
      {/if}
      {#if copy.certError}
        <p class="text-sm text-danger" id="app-copy-cert-error">
          Not every hostname's certificate is on the copy's machine, so serving at the main address would order them then: {copy.certError}
        </p>
      {/if}

      {#if copy.isServingMainAddress}
        <article class="alert warning" id="app-copy-serving">
          <div class="alert-content">
            Users reach this copy at the app's own address, read-only, as of {copy.asOf ? at(copy.asOf) : 'its last refresh'}.
            Switch back once the app is running again.
          </div>
        </article>
        <Button id="app-copy-switch-back" treatment="outlined" disabled={busy} onclick={() => serveMain(false)}>Switch back to the app</Button>
      {:else if confirm}
        <p class="text-sm" id="app-copy-confirm">
          Every user of this app will be sent to this copy, read-only and as of {copy.asOf ? at(copy.asOf) : 'its last refresh'}.
          Anything written since then is not there.
        </p>
        <div class="cluster">
          <Button id="app-copy-serve-confirm" tone="danger" disabled={busy} onclick={() => serveMain(true)}>Send users to the copy</Button>
          <Button treatment="outlined" disabled={busy} onclick={() => confirm = false}>Cancel</Button>
        </div>
      {:else}
        <Button id="app-copy-serve" treatment="outlined" disabled={busy || !copy.refreshedAt}
                title={copy.refreshedAt ? null : 'Waits for the first refresh to serve the copy'}
                onclick={() => confirm = true}>Serve at the main address</Button>
      {/if}
    {/if}

    <div class="cluster">
      <Select id="app-copy-cron" label="Refresh" value={cron} options={schedules} disabled={busy}
              onchange={(e) => { cron = e.target.value; if (copy && cron !== copy.cron) change({ cron }) }} />
      <Select id="app-copy-machine" label="Machine" value={serverId} disabled={busy || copy?.isServingMainAddress}
              options={machines.map(m => ({ value: m.id, label: `${m.name} · ${m.status}` }))}
              onchange={(e) => { serverId = e.target.value; if (copy && serverId !== copy.serverId) change({ serverId }) }} />
    </div>
  {/if}
</Card>
