{
  "name": "@frontierjs/basecamp",
  "version": "0.1.0",
  "private": true,
  "description": "Basecamp — developer command central for the FJS World. An FJS application, not a library.",
  "type": "module",
  "license": "MIT",
  "author": "Kobami",
  "scripts": {
    "dev": "bun scripts/preflight.mjs && (bun run api & bun run web & wait)",
    "api": "bun --watch api/src/index.ts",
    "web": "vite -c web/config/vite.config.js",
    "stop": "pkill -f 'bun.*api/src/inde[x].ts'; pkill -f 'vite.*web/config/vite.confi[g].js'; true",
    "start": "bun api/src/index.ts",
    "preview": "vite preview -c web/config/vite.config.js",
    "build": "bun run build:db && bun run build:web",
    "build:db": "bun db/generate.js --check",
    "build:web": "vite build -c web/config/vite.config.js",
    "test": "bun test",
    "verify": "bun web/test/verify.mjs",
    "typecheck": "node ../../scripts/typecheck.mjs",
    "db:ddl": "bun db/generate.js",
    "db:check": "bun db/generate.js --check",
    "db:seed": "bun db/seed.js",
    "db:tables": "sqlite3 db/basecamp.db '.schema'",
    "db:reset": "bun run stop; rm -rf db/basecamp.db db/basecamp.db-shm db/basecamp.db-wal db/basecamp-jobs.db db/basecamp-jobs.db-shm db/basecamp-jobs.db-wal db/audit"
  },
  "dependencies": {
    "@frontierjs/auth": "workspace:*",
    "@frontierjs/caravan": "workspace:*",
    "@frontierjs/conduit": "workspace:*",
    "@frontierjs/css": "workspace:*",
    "@frontierjs/junction": "workspace:*",
    "@frontierjs/litestone": "workspace:*",
    "@frontierjs/mesa": "workspace:*",
    "@frontierjs/sierra": "workspace:*",
    "@frontierjs/ui": "workspace:*"
  },
  "devDependencies": {
    "@types/bun": "latest",
    "vite": "^8.0.3"
  },
  "engines": {
    "bun": ">=1.0.0"
  }
}
