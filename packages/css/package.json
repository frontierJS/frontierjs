{
  "name": "@frontierjs/css",
  "version": "0.16.7",
  "description": "FrontierJS CSS — a minimal, composable, semantics-first design system in plain CSS, the styling language of a FrontierJS app",
  "type": "module",
  "scripts": {
    "demo": "bun demo/serve.js",
    "test": "node ../../scripts/tmp-run.mjs 'bun test/run.js && bun test test/doc-examples.test.js'",
    "build": "bun build.js && bun run build:vocabulary",
    "build:vocabulary": "bun build-vocabulary.js",
    "prepack": "bun run build",
    "prepublishOnly": "bun run test",
    "typecheck": "node ../../scripts/typecheck.mjs"
  },
  "main": "./src/index.css",
  "style": "./src/index.css",
  "sideEffects": [
    "**/*.css"
  ],
  "exports": {
    ".": "./src/index.css",
    "./index.css": "./src/index.css",
    "./utilities.css": "./src/utilities.css",
    "./print.css": "./src/print.css",
    "./foundation/*.css": "./src/foundation/*.css",
    "./themes/*.css": "./src/themes/*.css",
    "./components/*.css": "./src/components/*.css",
    "./patterns/*.css": "./src/patterns/*.css",
    "./a11y/*.css": "./src/a11y/*.css",
    "./bundle.css": "./dist/frontier.css",
    "./bundle.min.css": "./dist/frontier.min.css",
    "./vocabulary.json": "./vocabulary.json",
    "./vocabulary.js": "./vocabulary.js",
    "./themes.js": "./themes.js"
  },
  "files": [
    "src",
    "dist",
    "vocabulary.js",
    "vocabulary.json",
    "themes.js",
    "AGENTS.md"
  ],
  "devDependencies": {
    "@frontierjs/toolbelt": "workspace:*"
  },
  "keywords": [
    "frontierjs",
    "css",
    "design-system",
    "svelte"
  ],
  "license": "MIT",
  "author": "FrontierJS",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/frontierJS/frontierjs.git",
    "directory": "packages/css"
  },
  "homepage": "https://github.com/frontierJS/frontierjs/tree/main/packages/css#readme",
  "bugs": {
    "url": "https://github.com/frontierJS/frontierjs/issues"
  },
  "publishConfig": {
    "access": "public"
  }
}
