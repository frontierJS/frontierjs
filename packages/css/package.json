{
  "name": "@frontierjs/css",
  "version": "0.10.0",
  "description": "FrontierJS CSS \u2014 a minimal, composable, semantics-first design system for Svelte/Vite/UnoCSS apps",
  "type": "module",
  "scripts": {
    "demo": "bun demo/serve.js",
    "test": "bun test/run.js",
    "typecheck": "node ../../scripts/typecheck.mjs"
  },
  "main": "./index.css",
  "style": "./index.css",
  "sideEffects": [
    "*.css"
  ],
  "exports": {
    ".": "./index.css",
    "./*.css": "./*.css"
  },
  "files": [
    "*.css"
  ],
  "keywords": [
    "frontierjs",
    "css",
    "design-system",
    "svelte"
  ],
  "license": "MIT"
}
