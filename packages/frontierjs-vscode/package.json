{
  "name": "vscode-frontierjs",
  "displayName": "FrontierJS VSCode Plugin",
  "description": "Language support for Litestone (.lite) and (.mesa)",
  "version": "0.1.1",
  "publisher": "frontierJS",
  "license": "MIT",
  "private": true,
  "repository": {
    "type": "git",
    "url": "https://github.com/frontierJS/frontierjs.git",
    "directory": "packages/frontierjs-vscode"
  },
  "bugs": {
    "url": "https://github.com/frontierJS/frontierjs/issues"
  },
  "homepage": "https://github.com/frontierJS/frontierjs/tree/main/packages/frontierjs-vscode#readme",
  "engines": {
    "vscode": "^1.85.0"
  },
  "categories": [
    "Programming Languages",
    "Linters",
    "Formatters"
  ],
  "keywords": [
    "litestone",
    "lite",
    "sqlite",
    "schema",
    "mesa",
    "frontierjs"
  ],
  "icon": "icons/frontierjs.png",
  "activationEvents": [],
  "main": "./out/extension.js",
  "capabilities": {
    "untrustedWorkspaces": {
      "supported": false,
      "description": "Mesa diagnostics run the WORKSPACE's own @frontierjs/mesa compiler, so opening a folder would execute code from it."
    },
    "virtualWorkspaces": {
      "supported": false,
      "description": "The Litestone server is a node process and resolves imports and the Mesa compiler through the filesystem."
    }
  },
  "contributes": {
    "languages": [
      {
        "id": "litestone",
        "aliases": [
          "Litestone",
          "litestone",
          "lite"
        ],
        "extensions": [
          ".lite",
          ".litestone"
        ],
        "configuration": "./language-configuration/litestone.json",
        "icon": {
          "light": "./icons/litestone.png",
          "dark": "./icons/litestone.png"
        }
      },
      {
        "id": "mesa",
        "aliases": [
          "MESA"
        ],
        "extensions": [
          ".mesa"
        ],
        "configuration": "./language-configuration/mesa.json",
        "icon": {
          "light": "./icons/mesa.png",
          "dark": "./icons/mesa.png"
        }
      }
    ],
    "grammars": [
      {
        "language": "litestone",
        "scopeName": "source.litestone",
        "path": "./syntaxes/litestone.tmLanguage.json"
      },
      {
        "language": "mesa",
        "scopeName": "source.mesa",
        "path": "./syntaxes/mesa.tmLanguage.json",
        "embeddedLanguages": {
          "source.js.embedded.mesa": "javascript",
          "source.css.embedded.mesa": "css"
        }
      }
    ],
    "commands": [
      {
        "command": "litestone.format",
        "title": "Litestone: Format Document",
        "when": "editorLangId == litestone"
      },
      {
        "command": "litestone.restartServer",
        "title": "Litestone: Restart Language Server"
      }
    ],
    "configuration": {
      "title": "FrontierJS",
      "properties": {
        "litestone.trace.server": {
          "scope": "window",
          "type": "string",
          "enum": [
            "off",
            "messages",
            "verbose"
          ],
          "default": "off",
          "description": "Trace LSP communication for debugging"
        },
        "litestone.formatOnSave": {
          "scope": "resource",
          "type": "boolean",
          "default": true,
          "description": "Format .lite files on save"
        },
        "litestone.parserPath": {
          "scope": "machine",
          "type": "string",
          "default": "",
          "description": "Absolute path to litestone/src directory. Leave empty to auto-resolve (sibling monorepo directory or installed npm package)."
        },
        "mesa.compilerPath": {
          "scope": "machine",
          "type": "string",
          "default": "",
          "description": "Path to @frontierjs/mesa's src/compiler.js, or to the package directory. Leave empty to auto-resolve (node_modules/@frontierjs/mesa, or a packages/mesa above the edited file)."
        },
        "mesa.validateOnType": {
          "scope": "resource",
          "type": "boolean",
          "default": true,
          "description": "Validate Mesa files as you type (debounced). Disable for large files."
        },
        "mesa.validateDelay": {
          "scope": "resource",
          "type": "number",
          "default": 300,
          "description": "Debounce delay in milliseconds for on-type validation."
        }
      }
    },
    "snippets": [
      {
        "language": "litestone",
        "path": "./snippets/litestone.json"
      },
      {
        "language": "mesa",
        "path": "./snippets/mesa.json"
      }
    ],
    "configurationDefaults": {
      "emmet.includeLanguages": {
        "mesa": "html"
      },
      "editor.tokenColorCustomizations": {
        "textMateRules": [
          {
            "comment": "Mesa: let — reactive signal (orange, mutable)",
            "scope": "keyword.declaration.let.mesa",
            "settings": {
              "foreground": "#fe8a11"
            }
          },
          {
            "comment": "Mesa: const — derived/static (teal, settled)",
            "scope": "keyword.declaration.const.mesa",
            "settings": {
              "foreground": "#2ec4b6"
            }
          },
          {
            "comment": "Mesa: var — non-reactive sampler (dim, escapes graph)",
            "scope": "keyword.declaration.var.mesa",
            "settings": {
              "foreground": "#545470"
            }
          },
          {
            "comment": "Mesa: reactive variable name",
            "scope": "variable.other.reactive.mesa",
            "settings": {
              "foreground": "#f0dfc0"
            }
          },
          {
            "comment": "Mesa: reactive prop name",
            "scope": "variable.other.reactive.prop.mesa",
            "settings": {
              "foreground": "#f0dfc0"
            }
          },
          {
            "comment": "Mesa: derived variable name (slightly muted)",
            "scope": "variable.other.derived.mesa",
            "settings": {
              "foreground": "#c49a84"
            }
          },
          {
            "comment": "Mesa: immutable prop name",
            "scope": "variable.other.immutable.prop.mesa",
            "settings": {
              "foreground": "#c49a84"
            }
          },
          {
            "comment": "Mesa: non-reactive / sampler (dim)",
            "scope": "variable.other.sampler.mesa, variable.other.nonreactive.prop.mesa",
            "settings": {
              "foreground": "#545470"
            }
          }
        ]
      }
    }
  },
  "scripts": {
    "vscode:prepublish": "npm run build && npm run bundle",
    "build": "npm run build:parser && tsc -p tsconfig.json",
    "build:parser": "node scripts/build-parser.js",
    "bundle": "node scripts/bundle.js",
    "watch": "concurrently \"npm run watch:parser\" \"npm run watch:tsc\"",
    "watch:tsc": "tsc -watch -p tsconfig.json",
    "watch:parser": "node scripts/build-parser.js --watch",
    "dev": "npm run watch",
    "package": "vsce package --no-dependencies",
    "publish": "vsce publish --no-dependencies",
    "test": "npm run build && node test/lsp.test.js && node test/mesa.test.js && node test/snippets.test.js",
    "test:nobuild": "node test/lsp.test.js && node test/mesa.test.js && node test/snippets.test.js",
    "verify:package": "node scripts/verify-package.js",
    "typecheck": "node ../../scripts/typecheck.mjs"
  },
  "dependencies": {
    "vscode-languageclient": "^9.0.1",
    "vscode-languageserver": "^9.0.1",
    "vscode-languageserver-textdocument": "^1.0.11"
  },
  "devDependencies": {
    "@types/node": "^20.0.0",
    "@types/vscode": "^1.85.0",
    "@vscode/vsce": "^2.24.0",
    "typescript": "^5.3.0",
    "esbuild": "^0.20.0",
    "concurrently": "^8.2.0"
  }
}
