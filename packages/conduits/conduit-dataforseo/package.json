    "sink.ts",
    "README.md"
  ],
  "scripts": {
    "drive": "bun test/dataforseo.drive.ts",
    "test": "node ../../../scripts/tmp-run.mjs 'bun run drive'",
    "typecheck": "node ../../../scripts/typecheck.mjs"
  },
  "peerDependencies": {
    "@frontierjs/conduit": "^0.1.0"
  },
  "devDependencies": {
    "@frontierjs/conduit": "workspace:*",
    "bun-types": "^1.3.14"
  }
