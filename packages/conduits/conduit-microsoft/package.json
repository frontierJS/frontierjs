    "sink.ts",
    "README.md"
  ],
  "scripts": {
    "test": "node ../../../scripts/tmp-run.mjs 'bun run drive'",
    "drive": "bun test/microsoft.drive.ts",
    "sink": "bun sink.ts",
    "typecheck": "node ../../../scripts/typecheck.mjs"
  },
  "peerDependencies": {
    "@frontierjs/conduit": "^0.1.0"
  },
  "devDependencies": {
    "bun-types": "^1.3.14"
  }
