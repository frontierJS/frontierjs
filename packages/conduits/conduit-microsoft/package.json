{
  "name": "@frontierjs/conduit-microsoft",
  "version": "0.0.1",
  "description": "Microsoft identity platform + Graph mail over @frontierjs/conduit — delegated grant with rotating refresh, delta sync, change notifications, drafts/replies/send, MIME send.",
  "type": "module",
  "license": "MIT",
  "exports": {
    ".": "./src/index.ts",
    "./sink": "./sink.ts"
  },
  "files": [
