{
  "name": "@frontierjs/sierra",
  "version": "0.1.15",
  "description": "Vite-native meta-framework built on Mesa",
  "type": "module",
  "license": "MIT",
  "exports": {
    ".": {
      "types": "./src/index.d.ts",
      "default": "./src/index.js"
    },
    "./scanner": {
      "types": "./src/scanner/index.d.ts",
      "default": "./src/scanner/index.js"
    },
    "./build": {
      "types": "./src/build/index.d.ts",
      "default": "./src/build/index.js"
    },
    "./router": {
      "types": "./src/router/entry.d.ts",
      "default": "./src/router/entry.js"
    },
    "./router/internals": {
      "types": "./src/router/internals.d.ts",
      "default": "./src/router/internals.js"
    },
    "./analytics": {
      "types": "./src/analytics/index.d.ts",
      "default": "./src/analytics/index.js"
    },
    "./resource": {
      "types": "./src/resource/index.d.ts",
      "default": "./src/resource/index.js"
    },
    "./field-rules": {
      "types": "./src/resource/field-rules.d.ts",
      "default": "./src/resource/field-rules.js"
    },
    "./islands": {
      "types": "./src/islands/loader.d.ts",
      "default": "./src/islands/loader.js"
    },
    "./fetch": {
      "types": "./src/fetch/index.d.ts",
      "default": "./src/fetch/index.js"
    },
    "./theme": {
      "types": "./src/theme/index.d.ts",
      "default": "./src/theme/index.js"
    },
    "./postbuild": {
      "types": "./src/postbuild/index.d.ts",
      "default": "./src/postbuild/index.js"
    },
    "./components/RouterView": "./src/components/RouterView.mesa",
    "./components/ChainRenderer": "./src/components/ChainRenderer.mesa",
    "./components/SupportBanner": "./src/resource/SupportBanner.mesa",
    "./presence": {
      "types": "./src/presence/index.d.ts",
      "default": "./src/presence/index.js"
    },
    "./devtools": {
      "types": "./src/devtools/index.d.ts",
      "default": "./src/devtools/index.js"
    },
    "./widget": {
      "types": "./src/widget/index.d.ts",
      "default": "./src/widget/index.js"
    },
    "./widget/serve": {
      "types": "./src/widget/serve.d.ts",
      "default": "./src/widget/serve.js"
    },
    "./widget-headers": {
      "types": "./src/postbuild/widget-headers.d.ts",
      "default": "./src/postbuild/widget-headers.js"
    },
    "./mcp": {
      "types": "./src/mcp/index.d.ts",
      "default": "./src/mcp/index.js"
    },
    "./site/serve": {
      "types": "./src/site/serve.d.ts",
      "default": "./src/site/serve.js"
    },
    "./site/compile": {
      "types": "./src/site/compile.d.ts",
      "default": "./src/site/compile.js"
    },
    "./site/cloudflare": {
      "types": "./src/site/cloudflare.d.ts",
      "default": "./src/site/cloudflare.js"
    },
    "./check": {
      "types": "./src/build/mesa-check.d.ts",
      "default": "./src/build/mesa-check.js"
    },
    "./tui": {
      "types": "./src/tools/tui.d.ts",
      "default": "./src/tools/tui.js"
    }
  },
  "bin": {
    "sierra": "./src/tools/cli.js"
  },
  "scripts": {
    "test": "node ../../scripts/tmp-run.mjs 'node ../../scripts/emit-types.mjs --check && vitest run && node bench/run.mjs && bun test test/doc-examples.test.js'",
    "types": "node ../../scripts/emit-types.mjs",
    "bench": "node bench/run.mjs",
    "test:safety": "bun test/static-safety-real.mjs && bun test/filter-operators-real.mjs && bun test/page-reads-real.mjs",
    "test:installable": "node test/browser/installable.mjs",
    "test:push-worker": "node test/browser/push-worker.mjs",
    "test:connect-app": "bun test/browser/connect-app.mjs",
    "test:hydrate": "node test/fixtures/hydrate-site/verify.mjs --build",
    "test:widgets": "cd test/fixtures/widget-site && node ../../../src/tools/cli.js widgets --config config/sierra.config.js && node test/verify.mjs",
    "test:watch": "vitest",
    "typecheck": "node ../../scripts/typecheck.mjs",
    "example:api": "bun run example/api/index.ts",
    "example": "vite --config example/vite.config.js"
  },
  "dependencies": {
    "@frontierjs/toolbelt": "workspace:*"
  },
  "devDependencies": {
    "@frontierjs/junction": "workspace:*",
    "@frontierjs/litestone": "workspace:*",
    "@frontierjs/mesa": "workspace:*",
    "happy-dom": "^20.11.6",
    "playwright-core": "1.62.1",
    "vite": "^8.3.2",
    "vitest": "^5.0.3"
  },
  "_built": "2026-04-13",
  "files": [
    "AGENTS.md",
    "src",
    "README.md",
    "LICENSE"
  ],
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/frontierJS/frontierjs.git",
    "directory": "packages/sierra"
  },
  "peerDependencies": {
    "@frontierjs/mesa": "^0.1.0",
    "@frontierjs/junction": "^0.1.0",
    "@frontierjs/litestone": "^1.1.0",
    "vite": "^8.3.2"
  },
  "peerDependenciesMeta": {
    "@frontierjs/junction": {
      "optional": true
    },
    "@frontierjs/litestone": {
      "optional": true
    },
    "vite": {
      "optional": true
    }
  }
}
