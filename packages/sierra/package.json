{
  "name": "@frontierjs/sierra",
  "version": "0.1.7",
  "description": "Vite-native meta-framework built on Mesa",
  "type": "module",
  "license": "MIT",
  "exports": {
    ".": "./src/index.js",
    "./scanner": "./src/scanner/index.js",
    "./build": "./src/build/index.js",
    "./router": "./src/router/entry.js",
    "./router/internals": "./src/router/internals.js",
    "./analytics": "./src/analytics/index.js",
    "./junction": "./src/junction/index.js",
    "./islands": "./src/islands/loader.js",
    "./fetch": "./src/fetch/index.js",
    "./theme": "./src/theme/index.js",
    "./postbuild": "./src/postbuild/index.js",
    "./components/RouterView": "./src/components/RouterView.mesa",
    "./components/ChainRenderer": "./src/components/ChainRenderer.mesa",
    "./presence": "./src/presence/index.js",
    "./devtools": "./src/devtools/index.js",
    "./widget": "./src/widget/index.js",
    "./widget/serve": "./src/widget/serve.js",
    "./site/serve": "./src/site/serve.js",
    "./check": "./src/build/mesa-check.js"
  },
  "bin": {
    "sierra": "./src/tools/cli.js"
  },
  "scripts": {
    "test": "vitest run",
    "test:safety": "bun test/static-safety-real.mjs && bun test/filter-operators-real.mjs",
    "test:installable": "node test/browser/installable.mjs",
    "test:widgets": "cd test/fixtures/widget-site && node ../../../src/tools/cli.js widgets --config config/sierra.config.js && node test/verify.mjs",
    "test:watch": "vitest",
    "typecheck": "node ../../scripts/typecheck.mjs",
    "example:api": "bun run example/api/index.ts",
    "example": "vite --config example/vite.config.js"
  },
  "dependencies": {
    "@frontierjs/toolbelt": "workspace:*"
  },
  "devDependencies": {
    "@frontierjs/junction": "workspace:*",
    "@frontierjs/litestone": "workspace:*",
    "@frontierjs/mesa": "workspace:*",
    "happy-dom": "^20.11.6",
    "vite": "^8.3.2",
    "vitest": "^5.0.3"
  },
  "_built": "2026-04-13",
  "files": [
    "AGENTS.md",
    "src",
    "README.md",
    "LICENSE"
  ],
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/frontierJS/frontierjs.git",
    "directory": "packages/sierra"
  },
  "peerDependencies": {
    "@frontierjs/mesa": "^0.1.0",
    "@frontierjs/junction": "^0.1.0",
    "@frontierjs/litestone": "^1.1.0",
    "vite": "^8.3.2"
  },
  "peerDependenciesMeta": {
    "@frontierjs/junction": {
      "optional": true
    },
    "@frontierjs/litestone": {
      "optional": true
    },
    "vite": {
      "optional": true
    }
  }
}
