---
title: New lead
---
<script>
  // The whole form is derived. Look for a field list, a type, an enum value, a
  // required flag or the name of the account resource in this file — none of
  // them are here, because all of them are in db/schema.lite.
  import { leads, accounts } from '../../resources/leads.js'
  import { createResource, ResourceValidationError } from '@frontierjs/sierra/junction'
  import { goto } from '@frontierjs/sierra/router'
  import { session } from '../../session.js'

  const fields = leads.fields

  // Which fields to render, in schema order, minus the foreign key — that one
  // gets a picker instead of an input.
  const fk    = fields.accountId.references          // { model:'Account', field:'id', relation:'account' }
  const plain = Object.entries(fields).filter(([name]) => name !== 'accountId')

  // The picker's options come from the RELATION, not from a name written here:
  // leads.relations.account.model is 'Account', and that is a name the registry
  // resolves — so the related resource can be built from it.
  const related = createResource(
    leads.relations.account.model.toLowerCase() + 's',
    { model: leads.relations.account.model },
  )

  let draft   = leads.make()      // stage is null: a required enum has no blank member
  let options = []
  let errors  = []
  let saving  = false
  let failed  = null

  $: session.level

  related.service.getOptions({}, { limit: 100, orderBy: 'name' })
    .then(res => { options = res.data ?? [] })
    .catch(() => { options = [] })

  const problem = (name) => errors.find(e => e.field === name)?.message

  async function save() {
    failed = null
    // The same rules the server will apply, checked here first. Nothing stops
    // you submitting anyway — validate: true on the resource does that.
    // Validate what will actually be SENT, not what the DOM holds: the inputs
    // give back strings, and coerce() casts them using the schema's types.
    // Checking the raw draft would report "value must be a number" for a
    // perfectly good "42".
    const payload = leads.coerce(draft)
    errors = leads.validate(payload, 'create')
    if (errors.length) return

    saving = true
    try {
      const created = await leads.service.create(payload)
      goto('/leads/')
    } catch (e) {
      // A ResourceValidationError never left the browser. Anything else is the
      // server's answer — including the 401 from @@gate when not signed in.
      errors = e instanceof ResourceValidationError ? e.errors : []
      failed = e.message
    } finally {
      saving = false
    }
  }
</script>

<h1>New lead</h1>

{#if session.level < leads.gate.create}
  <p class="warn">
    Not signed in. <code>@@gate</code> wants level {leads.gate.create} to create,
    so this will come back 401 — which is the point: the button is not disabled,
    because the server is the thing that decides.
  </p>
{/if}

<form on:submit|preventDefault={save}>
  {#each plain as [name, rule]}
    <label>
      <span class="lbl">
        <b>{name}</b>
        {#if rule.required}<i class="req">*</i>{/if}
        <em class="hint">{rule.type}{rule.enum ? ' · enum' : ''}{rule.nullable ? ' · nullable' : ''}</em>
      </span>

      {#if rule.enum}
        <!-- Options come from fields.stage.enum, which exists only because
             {"$ref":"#/$defs/Stage"} is resolved against the registry. -->
        <select bind:value={draft[name]}>
          <option value="">—</option>
          {#each rule.enum as choice}
            <option value={choice}>{choice}</option>
          {/each}
        </select>
      {:else if rule.type === 'number' || rule.type === 'integer'}
        <input type="number" bind:value={draft[name]} min={rule.minimum} max={rule.maximum} />
      {:else if rule.type === 'boolean'}
        <input type="checkbox" bind:checked={draft[name]} />
      {:else}
        <input
          type={rule.format === 'email' ? 'email' : 'text'}
          bind:value={draft[name]}
          maxlength={rule.maxLength}
        />
      {/if}

      {#if problem(name)}<span class="err">{problem(name)}</span>{/if}
    </label>
  {/each}

  <label>
    <span class="lbl">
      {fk.relation}
      <b class="req">*</b>
      <em class="hint">→ {fk.model}.{fk.field}</em>
    </span>
    <select bind:value={draft.accountId}>
      <option value="">—</option>
      {#each options as opt}
        <option value={opt.id}>{opt.name}</option>
      {/each}
    </select>
    {#if problem('accountId')}<span class="err">{problem('accountId')}</span>{/if}
  </label>

  <button type="submit" disabled={saving}>{saving ? 'Saving…' : 'Create lead'}</button>
</form>

{#if failed}<p class="err">{failed}</p>{/if}

<p class="muted">
  Leave <code>slug</code> and <code>notes</code> empty and submit twice. Both
  save: <code>blankToNull</code> writes NULL rather than <code>''</code>, and
  SQLite allows any number of NULLs in a UNIQUE column.
</p>

<style>
  form { display: grid; gap: 14px; max-width: 460px; margin-top: 16px }
  label { display: grid; gap: 4px }
  .lbl { font-size: 13px; color: #374151 }
  .req { color: #b91c1c }
  .hint { color: #9ca3af; font-style: normal; font-size: 11px; margin-left: 6px }
  input, select { padding: 6px 8px; border: 1px solid #d1d5db; border-radius: 6px; font: inherit }
  .err { color: #b91c1c; font-size: 12px }
  .warn { background: #fffbeb; border: 1px solid #fde68a; padding: 8px 12px; border-radius: 6px; font-size: 14px }
  .muted { color: #6b7280; font-size: 13px }
  button { border: 1px solid #d1d5db; background: #fff; border-radius: 6px; padding: 6px 12px; cursor: pointer }
</style>
