<script module>
  // src/resources/Lead.mesa — the Resource layer.
  //
  // A Resource is a UI-realm noun, so it is a .mesa file (repo invariant 18).
  // No markup: everything is module scope, which is what <script module> means.
  // The file is named for the MODEL, singular, one Resource in it (invariant 19)
  // — which is what makes the directory listing the index of what this app has.
  //
  // Read this file next to db/schema.lite. Nothing here restates anything there:
  // no field list, no types, no enum values, no required list, no relations.
  // A resource names a model, and that is the whole of it: the payload pipeline
  // — coerce, blankToNull, validate — is already on, and each half takes an
  // explicit `false` on the resource where it is wrong.

  import { createResource } from '@frontierjs/sierra/junction'

  export const leads = createResource('leads')
</script>
