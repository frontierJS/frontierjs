---
siteName: Sierra example
---
<script>
  import { page, isActive, goto } from '@frontierjs/sierra/router'
  import { status, login, logout } from '@frontierjs/sierra/junction'
  import { session, setLevel } from '../session.js'

  $: (page.siteName, page.route)
  $: (status.connected, session.level)

  // A plain `let` is already component state — it must NOT go in the `$:` path
  // watch above, which is for fields of plain objects (Mesa RULE 43). Listing it
  // there compiles, then throws `$runtime.get(...) is not a function` on mount.
  let authError = null

  async function signIn(admin) {
    authError = null
    try {
      const res = await fetch('/login', {
        method:  'POST',
        headers: { 'content-type': 'application/json' },
        body:    JSON.stringify({ admin }),
      })

      // Check the response BEFORE parsing it. `/login` is proxied to the API on
      // :3500, and with that process down Vite answers 502 with an empty body —
      // so res.json() threw `Unexpected end of JSON input` from inside a promise
      // nobody awaited, and the only visible trace was the dev overlay logging a
      // PromiseRejectionEvent. The cause is "the API isn't running"; say that.
      if (!res.ok) {
        authError = res.status === 502
          ? 'API not reachable on :3500 — run `bun run api`'
          : `sign-in failed: HTTP ${res.status}`
        return
      }

      const { token, level } = await res.json()
      login(token)
      setLevel(level)
    } catch (e) {
      authError = `sign-in failed: ${e.message}`
    }
  }

  function signOut() {
    logout()
    setLevel(0)
    goto('/')
  }
</script>

<!--
  Every class below comes from @frontierjs/css. There is no <style> block in
  this file any more: the frame (shell / topbar / screen), the nav, the buttons
  and the alert are all vocabulary, not bespoke CSS.

  Current-page state is `aria-current="page"`, not a class — the stylesheet
  keys off the attribute so the look and the announcement cannot drift apart.
  Mesa removes an attribute whose value is null, which is what makes the
  ternary below produce a bare <a> rather than aria-current="false".

  The leading `page.route` in each expression is load-bearing. isActive()
  reads that path internally, but Mesa decides what an expression depends on
  from the expression's own text — so without the read written here, the
  attribute is set once at mount and the highlight never moves. Verified by
  clicking: with it, [current] follows the route; without it, it stays on Home.
-->
<div class="shell">
  <header class="topbar">
    <span class="cluster">
      <strong>{page.siteName}</strong>
      <span class="badge muted">alpha</span>
    </span>

    <nav class="cluster" aria-label="Main">
      <a class="navlink" href="/"             aria-current={(page.route, isActive('/', { exact: true })) ? 'page' : null}>Home</a>
      <!-- exact, because isActive() prefix-matches by default and /leads/ is a
           prefix of /leads/create/ — without it both links light up at once. -->
      <a class="navlink" href="/leads/"       aria-current={(page.route, isActive('/leads/', { exact: true })) ? 'page' : null}>Leads</a>
      <a class="navlink" href="/leads/create/" aria-current={(page.route, isActive('/leads/create/')) ? 'page' : null}>New lead</a>
    </nav>

    <span class="cluster">
      <!-- The live WebSocket, as a tone rather than a hand-mixed green. -->
      <span class="pill" class:success={status.connected} class:muted={!status.connected}>
        {status.connected ? 'live' : 'offline'}
      </span>
      {#if session.level > 0}
        <span class="badge info">gate level {session.level}</span>
        <button class="btn ghost" on:click={signOut}>Sign out</button>
      {:else}
        <button class="btn outlined" on:click={() => signIn(false)}>Sign in (user)</button>
        <button class="btn primary"  on:click={() => signIn(true)}>Sign in (admin)</button>
      {/if}
    </span>
  </header>

  <main class="screen">
    {#if authError}
      <article class="alert danger">
        <div class="alert-content">{authError}</div>
      </article>
    {/if}

    <div class="container stack"><slot /></div>
  </main>
</div>
