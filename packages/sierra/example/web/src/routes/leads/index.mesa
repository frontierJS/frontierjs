---
title: Leads
---
<script>
  import { leads } from '../../resources/Lead.mesa'
  import { session } from '../../session.js'
  import { useStore } from '@frontierjs/sierra/junction'

  const { get: rows, unsubscribe } = useStore(leads.store)
  $.onDestroy(unsubscribe)

  $: session.level

  let error = null

  leads.load().catch(e => { error = e.message })

  // The schema says delete needs level 5. Asking before rendering is the only
  // reason this button can be disabled rather than 403-ing on click — and it is
  // still the server that actually refuses.
  $: canDelete = leads.can('delete', session.level)

  // `var`, not `const`: a gate level comes off the schema and never changes,
  // so a snapshot is what it is. Read straight in the template it is still a
  // one-time read, only silently.
  var deleteLevel = leads.gate.delete

  async function remove(id) {
    error = null
    try { await leads.service.remove(id) } catch (e) { error = e.message }
  }
</script>

<div class="section-header">
  <h1>Leads</h1>
  <a class="btn primary" href="/leads/create/">New lead</a>
</div>

{#if error}
  <article class="alert danger">
    <div class="alert-content">{error}</div>
  </article>
{/if}

<!-- table-wrap is what lets a wide table scroll inside the page instead of
     widening it; the tone on a <tr> would work the same way if a row needed one. -->
<div class="table-wrap">
  <table class="table striped hover">
    <thead>
      <tr>
        <th scope="col">Name</th>
        <th scope="col">Email</th>
        <th scope="col">Stage</th>
        <th scope="col">Value</th>
        <th scope="col">Slug</th>
        <th scope="col"><span class="visually-hidden">Actions</span></th>
      </tr>
    </thead>
    <tbody>
      {#each rows() as lead}
        <tr>
          <td>{lead.name}</td>
          <td>{lead.email}</td>
          <td><span class="pill">{lead.stage}</span></td>
          <td>{lead.value}</td>
          <td class="text-muted">{lead.slug === null ? 'null' : lead.slug}</td>
          <td>
            <button class="btn ghost danger" on:click={() => remove(lead.id)} disabled={!canDelete}>
              Delete
            </button>
          </td>
        </tr>
      {/each}
    </tbody>
  </table>
</div>

{#if !canDelete}
  <article class="alert muted">
    <div class="alert-content">
      Delete is disabled because <code>@@gate</code> wants level
      {deleteLevel} and this session is {session.level}. Sign in as admin.
    </div>
  </article>
{/if}

<p class="text-sm text-muted">
  The <code>Slug</code> column shows <code>null</code>, not an empty string —
  <code>blankToNull: true</code> on the resource. That is what keeps
  <code>slug String? @unique</code> from rejecting the second lead saved with an
  empty slug.
</p>
