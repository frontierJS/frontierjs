<script>
  // SupportBanner — you are acting as somebody else, and here is the way out.
  //
  // Mount it once in the app shell, not on the screen that started the episode:
  // the operator navigates the whole app as the subject, so a banner that is
  // only where the episode began is missing from every screen where forgetting
  // it matters. It is not dismissible.
  //
  // Rendered from `session.user.support` and from nothing else — a field the
  // server put on the principal. A banner derived from state the app kept
  // beside it survives the episode ending.
  //
  // Plain @frontierjs/css classes, because the UI kit sits above this package.
  // Styling it further is the app's: wrap it, or write the Alert yourself over
  // `session.user.support`.

  import { session, refresh } from './session.js'
  import { getClient } from './index.js'

  // Called once the episode has ended and the session is re-read.
  export let onend = undefined

  let busy = false

  $: session.user
  $: support = session.user?.support ?? null

  async function stop() {
    busy = true
    try {
      await getClient().auth.endSupport()
      // The server closes this session's sockets on both edges, so the client
      // reconnects and resolves afresh, but nothing tells THIS page who the
      // caller is now. refresh() is that question.
      await refresh()
      onend?.()
    } finally {
      busy = false
    }
  }
</script>

{#if support}
  <div role="alert" class="alert warning">
    <div class="alert-content">
      <strong>You are acting as another user</strong>
      Everything you do is recorded against your own name, and this ends
      automatically. Reason: {support.reason}
      <button type="button" class="btn warning" disabled={busy} onclick={stop}>
        {busy ? 'Stopping…' : 'Stop'}
      </button>
    </div>
  </div>
{/if}
