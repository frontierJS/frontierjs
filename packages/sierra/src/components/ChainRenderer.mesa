<script>
  import { page } from '@frontierjs/sierra/router'
  import ChainRendererInner from './ChainRenderer.mesa'

  // `page` is a plain object — inert until watched. These declarations are what
  // make this component track navigation; without them the reads below compile
  // to static values and the outlet would never update.
  $: (page.data, page.params)

  export let chain    // { component, ownParams, meta }[]
  export let depth    // current depth in chain
  // The app's `failed(error, reset)`, handed down from RouterView's `failed`.
  //
  // Every level of the chain renders inside a `<mesa:boundary>`, so a throw
  // while a page or a layout renders replaces that level with `failed` rather
  // than leaving it half-drawn (FJS-D376). The nearest level catches, so a
  // page's throw leaves its layouts standing. The three boundaries below share
  // the one `failed` snippet through RULE 40's global fallback, and read no
  // async value, so none of them waits on anything (FJS-D378).
  export let appFailed = null

  // A chain can be empty: nothing registered a component for the route. The
  // router refuses that navigation now, naming the file — this is the belt, so
  // the outlet renders nothing instead of throwing on an internal expression.
  //
  // `Component` and the remount key both read `chain` directly. Routing the
  // component through an `entry` memo put it one derived layer BELOW the key,
  // so on `apps/[id]` → `deployments/[id]` the key block re-ran first and mounted
  // the screen being left, still the stale `Component`, with the new id —
  // `apps.get` asked for a deployment (`FJS-1684`).
  const Component = chain[depth]?.component
  const isLast    = depth === chain.length - 1

  // getRemountKey — for same-route param changes (e.g. /blog/a/ → /blog/b/).
  // The component at this depth is the same, but ownParams changed.
  function getRemountKey() {
    if (!isLast) return null
    const entry = chain[depth]
    const remount = entry?.meta?.remount
    if (remount === false) return null
    const own = entry?.ownParams ?? []
    if (own.length === 0) return null
    if (remount === 'params') return JSON.stringify(page.params)
    return own.map(p => page.params[p]).join('/')
  }
</script>

{#snippet failed(error, reset)}
  {#if appFailed}
    {@render appFailed(error, reset)}
  {:else}
    <div role="alert">
      <p>Something went wrong showing this page.</p>
      <button type="button" onclick={reset}>Try again</button>
    </div>
  {/if}
{/snippet}

{#if Component}
  {#key Component}
    {#if isLast}
      {#if getRemountKey() !== null}
        {#key getRemountKey()}
          <mesa:boundary><Component data={page.data} /></mesa:boundary>
        {/key}
      {:else}
        <mesa:boundary><Component data={page.data} /></mesa:boundary>
      {/if}
    {:else}
      {#snippet inner()}
        <ChainRendererInner {chain} depth={depth + 1} {appFailed} />
      {/snippet}
      <mesa:boundary><Component children={inner} /></mesa:boundary>
    {/if}
  {/key}
{/if}
