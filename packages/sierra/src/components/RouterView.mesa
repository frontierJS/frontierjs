<script module>
  // RouterView — Sierra's router outlet.
  //
  // Previously used {#key page.route} to remount ChainRenderer on every navigation.
  // That caused ALL layouts — even shared ones — to be torn down and recreated on
  // every route change, re-running their instance scripts (console.logs, effects, etc).
  //
  // Now: RouterView passes a reactive chain prop. ChainRenderer keys on
  // entry.component at each depth — so layouts that appear in both the old and new
  // chain are REUSED. Only levels where the component actually changes remount.
</script>

<script>
  import { page } from '@frontierjs/sierra/router'
  import { resolveChain } from '@frontierjs/sierra/router/internals'

  // `page` is a plain object — these watches are what drive the outlet.
  $: (page.route, page.pending)
  import ChainRenderer from './ChainRenderer.mesa'

  export let loading = null
  // `failed(error, reset)`: what a route that threw while rendering shows in
  // its place. Without one, a plain message and a Try again button (FJS-D376).
  export let failed = null
</script>

{#if page.pending && loading}
  {@render loading()}
{/if}

{#if page.route}
  <ChainRenderer
    chain={resolveChain(page.route)}
    depth={0}
    appFailed={failed}
  />
{/if}
