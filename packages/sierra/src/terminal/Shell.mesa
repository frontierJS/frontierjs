<script>
  // Shell.mesa — the terminal shell's frame: a heading, a note, and on the list
  // screen a button per route that lowers and takes no param, a field for a
  // path (how a route that takes one is reached), and one line saying how many
  // do not lower. Mounted once, first, so an open route sits below it. `state`
  // is a signal's read function rather than an object: a `$:` watch on a
  // prop is local to this component and would not hear the shell's writes.
  // Compiled for the terminal by the loader that compiles the app, so it is
  // held to the same table.
  //
  // The refused routes are a count rather than a list: one line each overflows
  // a screen with no scrolling, and `fli dev:tui --list` prints them whole.
  export let state  // () => { app, note, routes, patterns, refused }
  export let onopen = null

  let path = ''
  const go = () => { if (path.trim()) onopen?.(path.trim()) }
</script>

<h1>{state().app}</h1>
{#if state().note}
  <p>{state().note}</p>
{/if}
{#if state().routes}
  <p>Tab moves, Enter opens, Esc goes back, Ctrl+C quits</p>
  {#each state().routes as r (r.path)}
    <button on:click={() => onopen?.(r.path)}>{r.path}</button>
  {:else}
    <p>No route without a param lowers yet.</p>
  {/each}
  <form on:submit|preventDefault={go}>
    <label>Path <input name="path" placeholder="/orders/7/" on:input={(e) => path = e.target.value} /></label>
  </form>
  {#if state().patterns.length}
    <p>By path: {state().patterns.join('  ')}</p>
  {/if}
  {#if state().refused}
    <p>{state().refused} more do not lower yet: fli dev:tui --list names the first blocker of each.</p>
  {/if}
{/if}
