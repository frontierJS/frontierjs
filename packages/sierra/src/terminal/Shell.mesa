<script>
  // Shell.mesa — the terminal shell's frame: a heading, a note, and on the list
  // screen a button per route that lowers and takes no param, a field for a
  // path (how a route that takes one is reached), and one line saying how many
  // do not lower. Mounted once, first, so an open route sits below it. `state`
  // is a signal's read function rather than an object: a `$:` watch on a
  // prop is local to this component and would not hear the shell's writes.
  // Compiled for the terminal by the loader that compiles the app, so it is
  // held to the same table.
  //
  // The refused routes are a count rather than a list: one line each would
  // push the list past the screen, and `fli dev:tui --list` prints them whole.
  //
  // Ctrl+P, from the list or from inside a route, opens the jump: a modal
  // over the screen with a field and the routes that match it, best first.
  import { rank } from '@frontierjs/toolbelt/search'

  export let state  // () => { app, note, routes, patterns, refused }
  export let paths = []     // every route the list offers, for the jump
  export let onopen = null
  export let onjump = null  // (path) => the route on screen goes there
  export let onmove = null  // (step) => focus the control `step` away
  export let onmode = null  // ({ mode, field }) => the line Mode.mesa paints

  let path = ''
  const go = () => { if (path.trim()) onopen?.(path.trim()) }

  // The keys are modal, and only `i` enters INSERT, where the field takes every
  // key but Esc. Landing on a text field does not: a route focuses its first
  // control when it mounts, and a scene that opened already typing would eat
  // the h j k l it walks on. Every focus is NORMAL, so Tab to the next field
  // is too. In NORMAL a letter types nothing, and `/` enters INSERT and is
  // typed, so a line that begins with a slash is one keystroke away. h j k l reach this as the arrows (shell.js).
  // Esc out of INSERT stops here, so a dialog or the shell's back hears only a second one.
  const NOT_TEXT = new Set(['checkbox', 'radio', 'file', 'button', 'submit', 'reset'])
  const types = (el) => el?.tagName === 'TEXTAREA' || (el?.tagName === 'INPUT' && !NOT_TEXT.has(el.type))

  let mode  = 'normal'
  let field = false
  const set = (m) => { mode = m; onmode?.({ mode, field }) }
  const focusin = (e) => {
    field = types(e.target)
    set(e.target === jumpField ? 'insert' : 'normal')
  }
  const keydown = (e) => {
    if (e.defaultPrevented) return
    // `key` is the control character the terminal sent; `code` is the letter.
    if (e.ctrlKey && e.code === 'p') { e.preventDefault(); openJump(); return }
    if (e.ctrlKey || e.altKey || e.metaKey) return
    const typing = types(e.target)
    if (mode === 'insert' && typing) {
      if (e.key !== 'Escape') return
      e.preventDefault()
      e.stopPropagation()
      set('normal')
      return
    }
    if (!typing) return
    if (e.key === 'i' || e.key === '/') set('insert')
    if (e.key === '/') return
    if (e.key.length === 1 || e.key === 'Backspace' || e.key === 'Delete') e.preventDefault()
  }

  // The arrows move between the list's own buttons only: a route reads them.
  // Prevented, so shell.js does not move focus a second time for a j or k.
  const ARROW = { ArrowDown: 1, ArrowUp: -1 }
  const arrow = (e) => {
    if (!ARROW[e.key]) return
    e.preventDefault()
    onmove?.(ARROW[e.key])
  }

  // ─── the jump ──────────────────────────────────────────────────────
  // The field is INSERT from the moment it opens, and its keys stop at it: a
  // scene listening on the window would otherwise walk on every letter typed.
  // A typed path no route lists still opens on Enter, as the list's field does.
  const ROWS = 12
  let jumper
  let jumpField
  let query = ''
  let pick  = 0

  const matches = (q, all) => rank(all, q.trim()).map((r) => r.item)
  const hits    = (q, all) => matches(q, all).slice(0, ROWS)
  const typedPath = (q) => q.trim().startsWith('/') ? q.trim() : null

  function openJump() {
    if (!paths.length || jumper.open) return
    query = ''
    pick  = 0
    jumper.showModal()
    set('insert')
  }

  const STEP = { ArrowDown: 1, ArrowUp: -1 }
  const jumpKey = (e) => {
    e.stopPropagation()
    const step = STEP[e.key] ?? (e.ctrlKey && e.code === 'n' ? 1 : e.ctrlKey && e.code === 'p' ? -1 : 0)
    const shown = hits(query, paths)
    if (step) {
      e.preventDefault()
      if (shown.length) pick = (pick + step + shown.length) % shown.length
      return
    }
    if (e.key === 'Escape') { e.preventDefault(); jumper.close(); return }
    if (e.key !== 'Enter') return
    e.preventDefault()
    const to = shown[pick] ?? typedPath(query)
    if (!to) return
    jumper.close()
    onjump?.(to)
  }
  const typed = (e) => { query = e.target.value; pick = 0 }
</script>

<mesa:window onkeydown={keydown} onfocusin={focusin} />
<h1>{state().app}</h1>
{#if state().note}
  <p>{state().note}</p>
{/if}
{#if state().routes}
  <p>Tab or j/k moves, Enter opens, Ctrl+P jumps, Esc goes back, Ctrl+C quits</p>
  {#each state().routes as r (r.path)}
    <button onclick={() => onopen?.(r.path)} onkeydown={arrow}>{r.path}</button>
  {:else}
    <p>No route without a param lowers yet.</p>
  {/each}
  <form onsubmit|preventDefault={go}>
    <label>Path <input name="path" placeholder="/orders/7/" oninput={(e) => path = e.target.value} /></label>
  </form>
  {#if state().patterns.length}
    <p>By path: {state().patterns.join('  ')}</p>
  {/if}
  {#if state().refused}
    <p>{state().refused} more do not lower yet: fli dev:tui --list names the first blocker of each.</p>
  {/if}
{/if}
<dialog bind:this={jumper} onclose={() => set('normal')}>
  <p>Jump to a route · ↑↓ picks, Enter opens, Esc closes</p>
  <input bind:this={jumpField} value={query} placeholder="type to filter, or a /path/" oninput={typed} onkeydown={jumpKey} />
  {#each hits(query, paths) as h, i (h)}
    <p>{i === pick ? '› ' : '  '}{h}</p>
  {:else}
    <p>{typedPath(query) ? `Enter opens ${typedPath(query)}` : 'no route matches'}</p>
  {/each}
  {#if matches(query, paths).length > ROWS}
    <p>  … {matches(query, paths).length - ROWS} more — type to narrow</p>
  {/if}
</dialog>
