<!--
  Block — the wrapper a content block names with `layout: Block`. Every key of
  the block's front-matter arrives as a prop, and its Markdown is the slot.

  The element follows where the block sits, never its name (FJS-D654): a
  top-level block is a Band, `<section class="band">` holding a `.container`;
  a nested one is an `<article>`; one with a `url` is an `<a>`; and a caller
  that states `tag` gets that element, or none with `tag={false}`. A block is
  nested when its caller says `nested` or when it renders inside another
  Block's element, which that Block tells it through `$context`: a Band is
  100vw, so a second one inside the first scrolls the page sideways (FJS-2716).

  Its look is six typed keys, each a word @frontierjs/css already ships
  (FJS-D621, FJS-D823): `template` is a Layout helper, `tone`, `treatment` and
  `density` are the css axes, `align` the align axis, and `background` a photo
  under the Band's scrim. A value css does not ship fails the build naming the
  key, because a misspelt class is a block that renders unstyled and says
  nothing. `classes:` is refused for the same reason: nothing checks a free
  string. A look the six cannot state belongs in the site's own stylesheet,
  keyed on the block's `name`.
-->
<script module>
  import { badLook, bandClasses, cellClasses } from '../block-look.js'

  const kebab = (s) => s?.match(/[A-Z]{2,}(?=[A-Z][a-z]+[0-9]*|\b)|[A-Z]?[a-z]+[0-9]*|[A-Z]|[0-9]+/g)
    ?.map((x) => x.toLowerCase()).join('-')

  function refuse(name, message) {
    throw new Error(`[site-kit] Block${name ? ` "${name}"` : ''}: ${message}`)
  }

  function checkAxes(name, look) {
    const bad = badLook(look)
    if (bad) refuse(name, `${bad.key}: "${bad.value}" is not one of ${bad.allowed.join(', ')}`)
  }
</script>

<script>
  export let name = undefined
  export let nested = false
  export let url = undefined
  export let tag = undefined
  export let id = undefined
  export let template = undefined
  export let tone = undefined
  export let treatment = undefined
  export let density = undefined
  export let align = undefined
  export let background = undefined
  export let classes = undefined

  if (classes) {
    refuse(name, `classes: "${classes}" is not read — state template, tone, treatment, density, align or background, and put anything else in the site's stylesheet under .${kebab(name) ?? 'the-block-name'}`)
  }
  checkAxes(name, { template, tone, treatment, density, align })

  const kind = kebab(name)
  // `tag={false}` renders no element, so it passes on what it was told.
  const inBlock = $context.inBlock
  const element = tag !== undefined ? tag : url ? 'a' : nested || inBlock ? 'article' : 'section'
  $context.inBlock = Boolean(element) || inBlock
  const band = element === 'section' && tag === undefined
  const look = { kind, template, tone, treatment, density, align }
  const { outer, inner: innerClass } = bandClasses(look)
  const blockClass = band ? outer : cellClasses(look)
</script>

{#if element}
  <mesa:element this={element} class={blockClass} {class} {id} href={url} data-track={kind}>
    {#if band}
      {#if background}
        <img class="band-media" src={background} alt="" />
      {/if}
      <div class={innerClass}><slot /></div>
    {:else}
      <slot />
    {/if}
  </mesa:element>
{:else}
  <slot />
{/if}
