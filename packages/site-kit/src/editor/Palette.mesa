<script>
  // Palette.mesa — the editor's command palette, opened with Cmd/Ctrl+K. Going
  // to another page is the reason it exists: a click on a link is a pick while
  // editing, so the pages are listed here, with the files and the bar's actions.
  //
  // Escape stops at the palette, so it never also closes the panel under it.
  import { matching } from './palette.js'

  export let commands
  export let onclose

  let input
  let list
  let query = ''
  let at    = 0

  const shown = () => matching(commands, query)

  $.onMount(() => input.focus())

  function choose(c) {
    if (!c) return
    onclose?.()
    c.run()
  }

  async function move(by) {
    const n = shown().length
    if (!n) return
    at = (at + by + n) % n
    await $.tick()
    list?.querySelector('[aria-selected="true"]')?.scrollIntoView({ block: 'nearest' })
  }

  function keydown(e) {
    if (e.key === 'ArrowDown') { e.preventDefault(); move(1) }
    else if (e.key === 'ArrowUp') { e.preventDefault(); move(-1) }
    else if (e.key === 'Enter') { e.preventDefault(); choose(shown()[at]) }
    else if (e.key === 'Escape') { e.preventDefault(); e.stopPropagation(); onclose?.() }
  }
</script>

<div class="fjs-palette-scrim" data-fjs-editor-ui onclick={(e) => { if (e.target === e.currentTarget) onclose?.() }}>
  <article class="card glass theme-basecamp fjs-palette" role="dialog" aria-label="Commands">
    <input bind:this={input} id="fjs-palette" type="text" placeholder="Go to a page, edit a file…" autocomplete="off"
           role="combobox" aria-expanded="true" aria-controls="fjs-palette-list" value={query}
           oninput={(e) => { query = e.target.value; at = 0 }} onkeydown={keydown} />
    <ul bind:this={list} id="fjs-palette-list" role="listbox" aria-label="Commands">
      {#each shown() as c, i (c.id)}
        <li role="option" aria-selected={i === at ? 'true' : 'false'} data-id={c.id}
            onpointermove={() => at = i} onclick={() => choose(c)}>
          <span class="fjs-palette-group">{c.group}</span>
          <span class="fjs-palette-label">{c.label}</span>
          {#if c.hint}<span class="fjs-palette-hint">{c.hint}</span>{/if}
        </li>
      {/each}
      {#if !shown().length}<li class="fjs-palette-none">Nothing matches “{query}”</li>{/if}
    </ul>
  </article>
</div>

<style>
  .fjs-palette-scrim {
    position: fixed;
    inset: 0;
    z-index: 2147483001;
    display: flex;
    justify-content: center;
    align-items: flex-start;
    padding: 12vh 1rem 1rem;
    background: rgb(0 0 0 / 0.2);
  }
  .fjs-palette {
    --glass-alpha: 96%;
    width: min(36rem, 100%);
    max-height: 70vh;
    display: flex;
    flex-direction: column;
    padding: 0;
    overflow: hidden;
    box-shadow: var(--shadow-lg);
  }
  input {
    box-sizing: border-box;
    width: 100%;
    margin: 0;
    padding: 0.9rem 1rem;
    border: 0;
    border-bottom: 1px solid var(--color-border);
    outline: none;
    background: transparent;
    font-size: 1rem;
  }
  ul {
    list-style: none;
    margin: 0;
    padding: 0.35rem;
    overflow-y: auto;
  }
  li {
    display: flex;
    gap: 0.6rem;
    align-items: baseline;
    padding: 0.5rem 0.65rem;
    border-radius: var(--radius-sm, 0.375rem);
    cursor: pointer;
  }
  li[aria-selected="true"] {
    background: var(--surface-sunken);
  }
  .fjs-palette-group {
    flex: none;
    width: 4.5rem;
    font-size: 0.8rem;
    color: var(--color-muted);
  }
  .fjs-palette-label {
    flex: 1;
    min-width: 0;
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
  }
  .fjs-palette-hint {
    flex: none;
    font-size: 0.8rem;
    color: var(--color-muted);
  }
  .fjs-palette-none {
    cursor: default;
    color: var(--color-muted);
  }
</style>
