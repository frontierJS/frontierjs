<script>
  // Editor.mesa — the Edit button a draft's preview carries (`FJS-D1225`). It
  // shows to anyone holding the link; signing in is basecamp's, and every write
  // is graded against the person's grant there, so a reviewer with none is
  // refused at basecamp rather than hidden from here.
  //
  // Signed in, it names who is editing and checks the key still reaches the
  // draft: a key outliving its grant, or revoked from the workspace's API keys,
  // is forgotten with the reason shown.
  //
  // Signed in, the page is picked rather than browsed: a pointer outlines the
  // element whose stamp it is over, and a click changes its words in place, or
  // opens the file when they cannot be changed alone, instead of following a
  // link. Browse hands clicks back to the page, and Cmd/Ctrl+K lists the
  // draft's pages to go to. Ask is a change across the draft in the owner's
  // words, kept at once and undone in one step.
  import Ask from './Ask.mesa'
  import Field from './Field.mesa'
  import Inline from './Inline.mesa'
  import Palette from './Palette.mesa'
  import { arrive, begin, clientFor, forget, held, onHeldChange } from './handoff.js'
  import { pagesOf } from './palette.js'
  import { LOC, OURS, fieldFor, parseLoc, stampedFrom } from './pick.js'

  export let site

  let who   = held()
  let error = null
  let busy  = false
  let files = null
  let picking = true
  let over    = null
  let box     = null
  let opened  = null
  let notice  = null
  let asking  = false
  let palette = false

  const MAC = /Mac|iPhone|iPad/.test(navigator.platform)

  async function check() {
    if (!who) return
    try {
      files = (await clientFor(site, who.key).service('drafts').invoke('files', null, { appId: site.appId, draft: site.draft })).files
    } catch (err) {
      // 401 is a dead key and 404 a grant that is gone; anything else is the
      // draft's trouble, and the person stays signed in to see it fixed.
      if (err.code === 401 || err.code === 404) { forget(); who = null }
      error = err.message
    }
  }

  function settle(back) {
    if (back && 'error' in back) error = back.error
    if (back && 'held' in back) who = back.held
  }

  arrive(site).then((back) => { settle(back); check() })

  async function edit() {
    busy = true; error = null
    settle(await begin(site).catch(err => ({ error: err.message })))
    busy = false
    check()
  }

  function signedOut() {
    who = null; files = null; opened = null; over = null; box = null; asking = false; palette = false
  }

  function signOut() { forget(); signedOut() }

  // The key is shared by every tab of the preview, so a sign-in or sign-out
  // in one reaches the rest.
  var unhear = onHeldChange((h) => {
    if (!h) return signedOut()
    who = h; error = null
    check()
  })

  const live = () => !!(who && files && picking)

  function hover(e) {
    const el = live() ? stampedFrom(e.target) : null
    if (el === over) return
    over = el
    const r = el?.getBoundingClientRect()
    box = r ? { x: r.left, y: r.top, w: r.width, h: r.height, editable: files.includes(parseLoc(el.getAttribute(LOC))?.path) } : null
  }

  // Capture, so a link on the page never navigates away from a pick.
  function pick(e) {
    if (!live()) return
    const el = stampedFrom(e.target)
    if (!el) return
    e.preventDefault()
    e.stopPropagation()
    const field = fieldFor(el.getAttribute(LOC), files, location.pathname)
    notice = null
    asking = false
    opened = field?.path ? { ...field, inline: el } : field
  }

  function inlineClosed(result) {
    if (result?.saved) notice = `Saved to ${site.draft}. The preview rebuilds with it shortly.`
    opened = null
  }

  function toForm(why, typed) {
    opened = { path: opened.path, line: opened.line, why: why && (typed ? `${why}. Your words: “${typed}”` : why) }
  }

  function leave() { over = null; box = null }

  // The menu's words name a page before a button's ("Contact Us", not "Get started").
  const rank = (a) => 2 * !!a.closest('nav, header') + !a.classList.contains('btn')

  function commands() {
    const links = [...document.querySelectorAll('a[href]')]
      .filter((a) => !a.closest(OURS) && a.origin === location.origin && !a.getAttribute('href').startsWith('#'))
      .sort((a, b) => rank(b) - rank(a))
      .map((a) => ({ pathname: a.pathname, text: a.textContent }))
    const pages = pagesOf(files, links, location.pathname)
    const shown = new Set(pages.map((p) => p.file))
    return [
      ...pages.map((p) => ({ id: `go:${p.address}`, group: 'Go to', label: p.label, hint: p.here ? 'this page' : p.address,
                             run: () => location.assign(p.address) })),
      { id: 'ask', group: 'Action', label: 'Ask for a change', run: () => { asking = true; opened = null } },
      { id: 'pick', group: 'Action', label: picking ? 'Browse — let clicks follow links' : 'Pick — click words to edit them',
        run: () => { picking = !picking; leave() } },
      ...pages.map((p) => ({ id: `edit:${p.file}`, group: 'Edit', label: p.label, hint: p.file.replace(/^content\//, ''),
                             run: () => { asking = false; opened = { path: p.file, line: null } } })),
      ...files.filter((f) => !shown.has(f)).map((f) => ({ id: `edit:${f}`, group: 'Edit', label: f.replace(/^content\//, ''),
                             run: () => { asking = false; opened = { path: f, line: null } } })),
      { id: 'basecamp', group: 'Action', label: 'Open in basecamp', run: () => location.assign(site.page) },
      { id: 'signout', group: 'Action', label: 'Sign out', run: signOut },
    ]
  }

  function keydown(e) {
    if ((e.metaKey || e.ctrlKey) && e.key?.toLowerCase() === 'k' && who && files?.length) {
      e.preventDefault()
      palette = !palette
    } else if (e.key === 'Escape') { opened = null; asking = false; palette = false }
  }

  document.addEventListener('pointermove', hover, { capture: true, passive: true })
  document.addEventListener('click', pick, { capture: true })
  addEventListener('scroll', leave, { passive: true })
  $.onDestroy(() => {
    document.removeEventListener('pointermove', hover, { capture: true })
    document.removeEventListener('click', pick, { capture: true })
    removeEventListener('scroll', leave)
    unhear()
  })
</script>

<mesa:window onkeydown={keydown} />

{#if palette}
  <Palette commands={commands()} onclose={() => palette = false} />
{/if}

{#if box && picking && who}
  <div class="fjs-editor-outline" class:editable={box.editable} aria-hidden="true"
       style:left="{box.x}px" style:top="{box.y}px" style:width="{box.w}px" style:height="{box.h}px"></div>
{/if}

{#if opened?.inline}
  <Inline {site} key={who.key} path={opened.path} line={opened.line} el={opened.inline}
          onclose={inlineClosed} onform={toForm} />
{:else if opened?.path}
  <Field {site} key={who.key} path={opened.path} line={opened.line} why={opened.why} onclose={() => opened = null} />
{:else if opened?.template}
  <article class="card glass theme-basecamp fjs-editor-field" data-fjs-editor-ui aria-label="Pick a file">
    <div class="surface-header">
      <span>Drawn by <code>{opened.template}</code>, a developer's file. Its words are in one of these:</span>
      <button class="btn ghost" onclick={() => opened = null}>Close</button>
    </div>
    <ul class="surface-body stack" id="fjs-files">
      {#each opened.files as f (f)}
        <li><button class="btn ghost" onclick={() => opened = { path: f, line: null }}>{f}</button></li>
      {/each}
    </ul>
  </article>
{/if}

<div class="fjs-editor-dock">
  {#if asking}
    <Ask {site} key={who.key} {files} onclose={() => asking = false} />
  {/if}
  {#if who}
  <article class="card glass theme-basecamp fjs-editor" data-fjs-editor-ui data-fjs-editor-bar>
      <span>Editing <strong>{site.draft}</strong> as <strong>{who.editor?.name}</strong>
        {#if files?.length} · {files.length} {files.length === 1 ? 'page' : 'pages'}{:else if files} · nothing on this site is editable{/if}</span>
      {#if files?.length}<button class="btn ghost" id="fjs-ask-open" aria-pressed={asking} onclick={() => { asking = !asking; opened = null }}>Ask</button>{/if}
      <button class="btn ghost" aria-pressed={picking} onclick={() => { picking = !picking; leave() }}>{picking ? 'Browse' : 'Pick'}</button>
      {#if files?.length}<button class="btn ghost" id="fjs-palette-open" title="Go to a page, edit a file" onclick={() => palette = true}>
        Pages <kbd>{MAC ? '⌘K' : 'Ctrl K'}</kbd></button>{/if}
      <a class="btn ghost" href={site.page}>Open in basecamp</a>
      <button class="btn ghost" onclick={signOut}>Sign out</button>
    {#if notice}<span role="status">{notice}</span>{/if}
    {#if error}<span class="text-danger" role="alert">{error}</span>{/if}
  </article>
  {:else}
  {#if error}
    <article class="card glass theme-basecamp fjs-editor" data-fjs-editor-ui><span class="text-danger" role="alert">{error}</span></article>
  {/if}
  <button class="btn primary raised theme-basecamp fjs-editor-launch" id="fjs-editor-launch" data-fjs-editor-ui data-fjs-editor-bar
          aria-busy={busy ? 'true' : 'false'} disabled={busy} onclick={edit}>
    <svg aria-hidden="true" viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor"
         stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
      <path d="M12 20h9" /><path d="M16.5 3.5a2.1 2.1 0 0 1 3 3L7 19l-4 1 1-4Z" />
    </svg>
    {busy ? 'Opening…' : 'Launch Editor'}
  </button>
  {/if}
</div>

<style>
  /* Ask sits on the bar, whatever height the bar wraps to. The column is wider
     than the bar, so only its children take the pointer; Ask's root is Ask's
     element, which a scoped selector would miss. */
  .fjs-editor-dock {
    position: fixed;
    right: 1rem;
    bottom: 1rem;
    z-index: 2147483000;
    max-width: calc(100vw - 2rem);
    max-height: calc(100vh - 2rem);
    display: flex;
    flex-direction: column;
    align-items: flex-end;
    gap: 0.75rem;
    pointer-events: none;
  }
  .fjs-editor-dock > :global(*) {
    pointer-events: auto;
  }
  .fjs-editor {
    --glass-alpha: 96%;
    display: flex;
    gap: 0.5rem;
    align-items: center;
    max-width: 100%;
    flex-wrap: wrap;
  }
  /* One floating control while signed out, not a card around a button. */
  .fjs-editor-launch {
    border-radius: var(--pill-radius);
    padding: 0.75rem 1.35rem;
    gap: 0.5rem;
    box-shadow: var(--shadow-lg);
    transition: transform var(--motion-base), box-shadow var(--motion-base), filter var(--motion-base);
  }
  .fjs-editor-launch:hover:not(:disabled) {
    transform: translateY(-2px);
    box-shadow: var(--shadow-lg), var(--shadow-md);
  }
  .fjs-editor-launch:active:not(:disabled) {
    transform: none;
  }
  kbd {
    margin-inline-start: 0.35rem;
    padding: 0 0.3rem;
    border: 1px solid var(--color-border);
    border-radius: 0.25rem;
    font: inherit;
    font-size: 0.75rem;
    color: var(--color-muted);
  }
  .fjs-editor-outline {
    position: fixed;
    z-index: 2147482999;
    pointer-events: none;
    outline: 2px dashed var(--color-muted);
    outline-offset: 2px;
  }
  .fjs-editor-outline.editable {
    outline: 2px solid var(--color-primary);
  }
  .fjs-editor-field {
    --glass-alpha: 96%;
    position: fixed;
    top: 1rem;
    right: 1rem;
    z-index: 2147483000;
    width: min(32rem, calc(100vw - 2rem));
    max-height: calc(100vh - 6rem);
    overflow: auto;
  }
</style>
