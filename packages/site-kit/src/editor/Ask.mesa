<script>
  // Ask.mesa — the owner asks a model for a change across the draft
  // (`FJS-D1242`, `FJS-D2120`). Basecamp runs it over a copy of the draft's content, grades
  // what it changed, and commits what passes to the draft at once; Undo is that
  // commit's revert, and publishing stays the gate to the live site. The change
  // may reach pages this one does not draw, so it is also listed as lines per file.
  //
  // A run this panel watched end shows its words on the page straight away, as
  // a typed edit does (`FJS-D2121`); what the page cannot show waits for the
  // rebuild, and the panel says when the preview has it.
  //
  // It looks like the dev server's Ask panel (`cli/core/vite-ask-client.js`)
  // with that panel's developer controls left out: basecamp holds one ask per
  // draft, so the log is that ask, and Close is the whole toolbar because the
  // bar's Ask button reopens it.
  import { clientFor } from './handoff.js'
  import { hunkChanges, liveWords } from './live.js'

  export let site
  export let key
  export let onclose

  const drafts = clientFor(site, key).service('drafts')
  const call   = (method, data) => drafts.invoke(method, null, { appId: site.appId, draft: site.draft, ...data })
  const RUNNING = ['queued', 'running']
  const CHANGED = ['kept', 'undone']
  const live    = liveWords()

  let request = ''
  let ask     = null
  let diff    = null
  let preview = null
  let error   = null
  let busy    = false
  // What this page showed of the change, and whether it was loaded before the preview had it.
  let shown   = null
  let stale   = false

  // The preview catches up once it has built a head past the one the ask read.
  $: rebuilt = preview?.state === 'ready' && preview.built === preview.commit && preview.commit !== ask?.commit
  $: { if (CHANGED.includes(ask?.state) && !rebuilt) stale = true }
  // A page loaded before the rebuild shows only what could be swapped into it.
  $: reload = CHANGED.includes(ask?.state) && rebuilt && stale && (!shown || shown.waiting > 0)

  async function look() {
    const was = ask?.state
    try {
      const got = await call('asked')
      ask = got.ask; diff = got.diff; preview = got.preview ?? null
    } catch (err) {
      ask = null; diff = null
      if (err.code !== 404) error = err.message
    }
    if (RUNNING.includes(was) && ask?.state === 'kept') show(false)
  }

  // The kept lines on the page now, or put back after an Undo.
  function show(back) {
    let unplaced = 0
    const changes = (diff ?? []).flatMap((f) => {
      const r = hunkChanges(f.path, f.hunks)
      unplaced += r.unplaced
      return r.changes
    })
    const swapped = back ? changes.map((c) => ({ ...c, old: c.next, next: c.old })) : changes
    shown = { waiting: unplaced + live.show(swapped) }
    live.keep()
  }

  async function act(method, data) {
    busy = true; error = null
    try {
      await call(method, data)
      if (method === 'ask') { request = ''; shown = null; stale = false }
      if (method === 'undo' && shown) show(true)
    } catch (err) {
      error = err.message
    }
    await look()
    busy = false
  }

  function send() {
    if (!busy && request.trim()) act('ask', { request: request.trim() })
  }

  function keydown(e) {
    if (e.key === 'Enter' && (e.metaKey || e.ctrlKey)) { e.preventDefault(); send() }
  }

  const linesOf = (hunks) => hunks.split('\n').filter((l) => l && !l.startsWith('+++') && !l.startsWith('---'))
  const count   = (hunks, sign) => linesOf(hunks).filter((l) => l[0] === sign).length
  const opOf    = (l) => l.startsWith('@@') ? 'gap' : l[0] === '+' ? 'add' : l[0] === '-' ? 'del' : 'keep'
  const shownAs = (l) => l.startsWith('@@') ? '…' : l
  const changes = (n) => n === 1 ? 'One change shows' : `${n} changes show`

  function ago(at) {
    const s = Math.max(0, Math.round((Date.now() - Date.parse(at)) / 1000))
    if (!Number.isFinite(s)) return ''
    if (s < 60) return 'just now'
    if (s < 3600) return `${Math.round(s / 60)} min ago`
    return new Date(at).toLocaleTimeString([], { hour: 'numeric', minute: '2-digit' })
  }

  look()
  $.every(2000, look, { when: RUNNING.includes(ask?.state) || (CHANGED.includes(ask?.state) && !rebuilt && preview?.state !== 'failed') })
</script>

<article class="card glass theme-basecamp fjs-ask" data-fjs-editor-ui aria-label="Ask for a change">
  <header class="fjs-ask-head">
    <strong>Ask for a change</strong>
    <span class="text-muted">on {site.draft}</span>
    <button class="btn ghost square" aria-label="Close" title="Close (the ask is kept)" onclick={() => onclose?.()}>
      <svg class="icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" aria-hidden="true">
        <path d="M18 6 6 18" /><path d="m6 6 12 12" />
      </svg>
    </button>
  </header>

  <div class="fjs-ask-log" role="log">
    {#if !ask}
      <p class="text-muted">Say what should change, in your own words. Claude changes the draft's pages, shows you every line it changed, and Undo puts them back. Nothing reaches the live site until you publish.</p>
    {:else}
      <div class="fjs-ask-you">
        <div class="fjs-ask-who"><strong>You</strong><span class="text-muted">{ago(ask.at)}</span></div>
        <p>{ask.request}</p>
      </div>
      {#if RUNNING.includes(ask.state)}
        <p class="fjs-ask-doing text-muted" role="status" id="fjs-ask-running">Claude is working…</p>
      {/if}
      {#if ask.reply}
        <div class="fjs-ask-claude">
          <div class="fjs-ask-who"><strong>Claude</strong></div>
          <p id="fjs-ask-reply">{ask.reply}</p>
        </div>
      {/if}
      {#if CHANGED.includes(ask.state)}
        <div class="fjs-ask-run">
          {#if ask.state === 'kept'}
            <span role="status" id="fjs-ask-kept">
              {#if rebuilt}Changed on {site.draft}. The preview has it now{reload ? '; reload to see all of it here.' : '.'}
              {:else if shown?.waiting}Changed on {site.draft}. {changes(shown.waiting)} once the preview rebuilds…
              {:else if shown}Changed on {site.draft}, shown on this page. The preview is rebuilding…
              {:else}Changed on {site.draft}. The preview is rebuilding…{/if}
            </span>
          {:else}
            <span class="text-muted" role="status" id="fjs-ask-undone">{rebuilt ? `Undone. The preview has it back${reload ? '; reload to see it here.' : '.'}` : 'Undone. The preview is rebuilding without it…'}</span>
          {/if}
          <span class="fjs-ask-acts">
            {#if reload}<button class="btn ghost" id="fjs-ask-reload" onclick={() => location.reload()}>Reload</button>{/if}
            {#if ask.state === 'kept'}<button class="btn ghost" id="fjs-ask-undo" title="Put back what this ask changed" disabled={busy} onclick={() => act('undo')}>Undo</button>{/if}
          </span>
        </div>
        {#if ask.state === 'kept'}
          {#each diff ?? [] as f (f.path)}
            <details class="fjs-ask-file" data-path={f.path} open>
              <summary>
                <span class="fjs-ask-path">{f.path}</span>
                <span class="text-muted">+{count(f.hunks, '+')} −{count(f.hunks, '-')}</span>
              </summary>
              <pre>{#each linesOf(f.hunks) as l}<span class={opOf(l)}>{shownAs(l)}</span>{/each}</pre>
            </details>
          {/each}
        {/if}
      {/if}
      {#if preview?.state === 'failed' && CHANGED.includes(ask.state)}
        <p class="fjs-ask-error" role="alert" id="fjs-ask-build-failed">The preview did not rebuild: {preview.error ?? 'its build failed'}</p>
      {/if}
      {#if ask.state === 'failed'}
        <p class="fjs-ask-error" role="alert" id="fjs-ask-failed">{ask.error}</p>
      {/if}
    {/if}
    {#if error}<p class="fjs-ask-error" role="alert">{error}</p>{/if}
  </div>

  {#if !RUNNING.includes(ask?.state)}
    <footer class="fjs-ask-compose">
      <textarea id="fjs-ask" rows="3" aria-label="What should change?" value={request}
                oninput={(e) => request = e.target.value} onkeydown={keydown}
                placeholder="Change the opening hours to 8am on every page"></textarea>
      <div class="fjs-ask-foot">
        <span class="text-muted"><kbd class="kbd">Ctrl</kbd> + <kbd class="kbd">Enter</kbd></span>
        <button class="btn primary" id="fjs-ask-send" disabled={busy || !request.trim()} onclick={send}>Send</button>
      </div>
    </footer>
  {/if}
</article>

<style>
  /* Over a white page the kit's 85% reads grey; the dev panel dims its backdrop for the same reason. */
  .fjs-ask {
    --glass-alpha: 96%;
    width: min(40rem, calc(100vw - 2rem));
    min-height: 0;
    display: flex;
    flex-direction: column;
    gap: 0.75rem;
    padding: 1rem;
  }
  .fjs-ask-head,
  .fjs-ask-foot,
  .fjs-ask-run,
  .fjs-ask-who {
    display: flex;
    align-items: center;
    gap: 0.5rem;
  }
  .fjs-ask-head .btn {
    margin-left: auto;
  }
  .fjs-ask-foot {
    justify-content: flex-end;
  }
  .fjs-ask-compose .fjs-ask-foot {
    justify-content: space-between;
    margin-top: 0.5rem;
  }
  .fjs-ask-log {
    flex: 1;
    min-height: 0;
    overflow-y: auto;
    overscroll-behavior: contain;
    display: flex;
    flex-direction: column;
    gap: 0.625rem;
  }
  .fjs-ask-log > * {
    flex-shrink: 0;
  }
  p {
    margin: 0;
  }
  .fjs-ask-you,
  .fjs-ask-claude {
    max-width: 88%;
    padding: 0.45rem 0.7rem;
    border: 1px solid var(--rule);
    border-radius: 0.625rem;
  }
  .fjs-ask-you p,
  .fjs-ask-claude p {
    white-space: pre-wrap;
    overflow-wrap: anywhere;
  }
  .fjs-ask-you {
    align-self: flex-end;
    border-color: color-mix(in srgb, var(--color-primary) 60%, transparent);
    background: color-mix(in srgb, var(--color-primary) 22%, transparent);
    border-bottom-right-radius: 0.2rem;
  }
  .fjs-ask-claude {
    align-self: flex-start;
    background: var(--surface-raised);
    border-bottom-left-radius: 0.2rem;
  }
  .fjs-ask-who {
    font-size: 0.85em;
    margin-bottom: 0.15rem;
  }
  .fjs-ask-doing {
    font-style: italic;
  }
  .fjs-ask-file {
    border: 1px solid var(--rule);
    border-radius: 0.375rem;
    overflow: hidden;
  }
  .fjs-ask-file summary {
    display: flex;
    gap: 0.5rem;
    padding: 0.3rem 0.6rem;
    background: var(--surface-raised);
    font: 0.8rem/1.4 var(--font-mono, ui-monospace, monospace);
  }
  .fjs-ask-path {
    flex: 1;
    min-width: 0;
    overflow-wrap: anywhere;
  }
  .fjs-ask-file pre {
    margin: 0;
    padding: 0.2rem 0;
    overflow-x: auto;
    font: 0.8rem/1.45 var(--font-mono, ui-monospace, monospace);
  }
  .fjs-ask-file pre span {
    display: block;
    white-space: pre;
    padding: 0 0.6rem;
  }
  .fjs-ask-file .add {
    background: color-mix(in srgb, var(--color-success) 18%, transparent);
  }
  .fjs-ask-file .del {
    background: color-mix(in srgb, var(--color-danger) 20%, transparent);
  }
  .fjs-ask-file .keep,
  .fjs-ask-file .gap {
    color: var(--ink-soft);
  }
  .fjs-ask-run {
    justify-content: space-between;
    flex-wrap: wrap;
    font-size: 0.9em;
  }
  .fjs-ask-acts {
    display: flex;
    gap: 0.25rem;
    margin-left: auto;
  }
  .fjs-ask-error {
    padding: 0.45rem 0.7rem;
    border: 1px solid color-mix(in srgb, var(--color-danger) 45%, transparent);
    border-radius: 0.5rem;
    background: color-mix(in srgb, var(--color-danger) 12%, transparent);
    white-space: pre-wrap;
    overflow-wrap: anywhere;
  }
  textarea {
    box-sizing: border-box;
    width: 100%;
    resize: vertical;
    font: inherit;
  }
</style>
