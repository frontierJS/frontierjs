// ─── @frontierjs/auth — the identity model ───────────────────────────────────
//
// User is the one auth model an app OWNS. It is written into the app's own
// db/schema.lite rather than imported, because everything an app does next
// happens to this model and to none of the other three: columns get added
// (avatarUrl, timezone, a tenant key), relations point at it, sessionFields
// reads it, and its gate and policies are the app's decisions to change.
// auth.lite beside this one holds what only asSystem() touches.
//
// This file is REAL .lite and parses standalone against a host declaring
// `database main` and `database audit`. `fli auth:install` appends it to the
// app's schema.lite, rewriting @@db(main) when --db names another database;
// the same swap is what schema.ts does in memory. Keep @@db(main) spelled
// exactly — it is what both substitutions match on.

/// Who an account is. `user` is a person. `bot` is an automation a person set
/// up, and `peer` is another app calling this one (`FJS-D1196`). It is what the
/// audit trail files as `actorType`, and only a `user` may sign in: the other
/// two hold API keys and nothing else.
enum UserKind { user bot peer }

model User {
  id             String    @id @default(uuid())
  // The address a password reset is mailed to. Written by its owner it is an
  // account taken over by whoever holds a session, with `emailVerified` still
  // true for an address nobody proved; a new one has to be verified before it
  // is kept, and a flow that does that writes through asSystem().
  email          String    @email @unique @lower @allow('write', auth().isAdmin) @personal(contact)
  name           String?   @trim @personal(contact)
  // The columns a caller must not write about themselves. role is what an
  // app's own resolver grades on, and marking your own address verified is
  // skipping the verification. auth().isAdmin is the standing
  // FrontierGateGetLevel and sessionGateLevel() both read for ADMINISTRATOR(5),
  // so the level that may delete a person is the level that may set their role
  // — one idea, not two. asSystem() writes all of them regardless, which is how
  // this package sets them.
  emailVerified  Boolean   @default(false) @allow('write', auth().isAdmin)
  role           String    @default("user") @allow('write', auth().isAdmin)
  // Written once by the app, never by the caller. A person who could mark
  // themselves a bot would refile who did what, and a later change would make
  // every past entry's actorType disagree with the row.
  kind           UserKind  @default(user) @system @immutable
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @default(now()) @updatedAt

  @@db(main)
  // R.C.U.D. Read, create and update are USER: an app's own screens list its
  // people, and a signed-in caller edits their own profile. Delete is
  // ADMINISTRATOR — removing a person is not self-service.
  //
  // A GATE IS PER MODEL, NOT PER ROW, so the level alone would say *any
  // signed-in caller may write any user row*. The policy is what makes it
  // their own row, and an admin's the exception — the same standing the gate's
  // delete position names. Together with the two field policies above, this is
  // the whole shape an app needs: a level for what kind of caller, a policy for
  // whose row, and a field policy for the columns the level itself is graded
  // from. A column the caller can write is not a column a level can be graded
  // from.
  //
  // Registration is unaffected: every write this package makes goes through
  // asSystem(), which is above the ladder. Every model in auth.lite stays at 8
  // — they hold the credential material, and that is the case 8 is for.
  // @@auth names the principal model, which is what makes `auth().x` GRADED:
  // without it litestone can check no claim name, and a misspelling compiles to
  // NULL — which the SQL half reads as "nobody" and the JS half as "everybody",
  // so one typo is a lockout on read and an open door on create (FJS-666). Every
  // app scaffolded with `fli new --auth` booted with that warning and its
  // policies unchecked.
  @@auth
  @@gate(4.4.4.5)
  @@allow('update', id == auth().id || auth().isAdmin)
  @@trail(audit)
}
