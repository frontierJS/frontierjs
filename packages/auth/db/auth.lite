// ─── @frontierjs/auth — the credential machinery ─────────────────────────────
//
// Credentials:   how you prove who you are — passwords, API keys, OAuth tokens,
//                a TOTP secret, a recovery code
// Sessions:      are you currently logged in
// Verifications: ephemeral tokens — password reset, email verify
// In flight:     an authorization mid-redirect (OauthFlow), a login that has
//                passed a password and owes a second factor (LoginChallenge)
//
// Every model here is @@gate(8): nothing outside asSystem() has anything to
// say to them, and this package is the only thing that calls asSystem() on
// them. That
// is the line between this file and user.lite beside it — User is the model an
// app extends, relates to and puts on screens, so it goes into the app's own
// schema.lite where it can be read and edited. These three change when this
// package changes, so they are imported rather than pasted.
//
// This file is REAL .lite and parses standalone. `fli auth:install` copies it
// into an app's db/ and rewrites @@db(main) when --db names another database;
// the same swap is what schema.ts does in memory. Keep @@db(main) spelled
// exactly — it is what both substitutions match on.
//
// Session carries @@trail(audit), so a host schema must declare `database audit`.
//
// Every id here is a uuid rather than a rowid, and the deciding one is
// Credential's: `connections()` hands it to the browser and `removeConnection`
// takes it back, so a sequential integer there is enumerable and publishes how
// many credentials the whole installation holds. The other three follow it
// because one file with two id strategies is a question every reader has to
// answer again.
//
// An app adds what this file cannot know — a relation back to its own User,
// @@trail(audit), @@tenant(none) under row tenancy — with `extend model`, NOT by
// pasting these models into its own schema. A copy stops being this file's the
// first time either side moves and nothing fails: basecamp's had @guarded
// where this file writes @secret, so it stored every OAuth token in plain text
// with its whole suite green. See litestone's docs/traits.md.

model Credential {
  id              String     @id @default(uuid())
  userId          String
  type            String
  value           String     @guarded
  label           String?
  accessToken     String?    @secret
  refreshToken    String?    @secret
  tokenExpiresAt  DateTime?
  scope           String?
  /// TOTP only — the last step this secret was accepted at, which is what makes
  /// a code single-use. A code is valid for its whole 30-second window, so
  /// without this the window IS a replay window and nothing about the second
  /// code looks wrong. Null until the first successful login.
  ///
  /// Beside `scope`, `accessToken` and `tokenExpiresAt`, which are OAuth-only in
  /// the same way: one table per KIND of credential would be four tables whose
  /// only difference is which columns are null.
  totpLastStep    Int?
  /// OAuth only — true when the provider was attached to an account that
  /// already existed, which the mailbox vouched for before the provider did.
  /// `providerOnly` and the reset refusal count only an unmarked `oauth:*`
  /// row: an account a provider MADE has nothing but the provider securing it,
  /// and one the mailbox made keeps the mailbox as a way in (`FJS-D1011`).
  linked          Boolean?
  createdAt       DateTime   @default(now())

  @@db(main)
  @@gate(8)
  @@index([userId, type])
  @@index([type, value])
  /// One (provider, subject) is one row. `oauthResolve` reads then writes in
  /// separate awaits, so two callbacks for a subject nobody has seen both
  /// write, and branch 1 then answers whichever row it reaches first. The
  /// predicate names the types whose `value` is NOT an identity — a password
  /// hash, a TOTP secret, a recovery-code hash — because `.lite` has no prefix
  /// test to say `oauth:` and an unlisted type is constrained, which is the
  /// safe side.
  @@unique([type, value], where: type != "password" && type != "totp" && type != "totpPending" && type != "recoveryCode")
}

model Session {
  id         String    @id @default(uuid())
  userId     String
  token      String    @unique @guarded
  expiresAt  DateTime
  ipAddress  String?
  userAgent  String?
  createdAt  DateTime  @default(now())

  /// SUPPORT MODE — this session is an operator's, and while these are set it
  /// resolves to somebody else.
  ///
  /// Three columns on the operator's OWN row rather than a second session or a
  /// second model. A session minted for the subject would be a credential to
  /// keep somewhere, swap for, and lose with the tab; clearing a column is a
  /// way back that cannot be forgotten. The permanent record is the audit
  /// trail, which this model already writes through @@trail(audit) and which
  /// outlives the row by construction — a second table recording the same
  /// episode would be a second origin for it.
  ///
  /// `impersonationEndsAt` is READ AT RESOLUTION, so an episode stops applying
  /// the instant it lapses whether or not anything has swept it. The reason is
  /// required by the route and nullable here, for every row written before
  /// these columns existed.
  impersonatingUserId  String?
  impersonationReason  String?
  impersonationEndsAt  DateTime?

  @@db(main)
  @@gate(8)
  @@trail(audit)

  /// `expiresAt` is the window, so a lapsed session is not there to be read and
  /// the five `expiresAt: { gt: new Date() }` clauses that used to say so are
  /// gone. The filter reads the CLIENT's clock, which is what makes a lapse
  /// testable at all — a `new Date()` in this package read the host's, so
  /// `env.clock.advance()` moved nothing.
  ///
  /// `impersonationEndsAt` is a SECOND deadline and stays read by hand: one
  /// model declares one window, and an episode lapsing does not put the session
  /// out of force.
  @@expires(expiresAt)

  @@index([userId])
  @@index([expiresAt])
}

/// What a `Verification` row is for. Five acts and one question — does this
/// person control this address? — which is what makes them one table rather
/// than four, and what `purpose` stops them being: without it both lookups
/// matched on the token alone, so a token minted for one act was accepted by
/// another's endpoint and refused two steps later by a coincidence of string
/// handling (FJS-476).
enum VerificationPurpose { passwordReset emailVerify oauthLink magicLink emailChange }

model Verification {
  id          String               @id @default(uuid())
  purpose     VerificationPurpose
  /// The address being proved. Required, and every purpose has one — that is
  /// the test for whether something belongs in this table at all.
  identifier  String
  /// The secret the caller presents, and what the row is found by. One meaning
  /// on every row.
  value       String               @unique @guarded

  /// oauthLink only: which identity is waiting to be attached once the address
  /// answers for itself. Null for the others, which attach nothing.
  provider    String?
  subject     String?

  /// emailChange only: whose account the address replaces the current one on.
  /// The identifier is the NEW address, which belongs to nobody yet, so the
  /// account cannot be found from it the way every other purpose finds one.
  userId      String?

  /// magicLink only: the six digits a person types on a device other than the
  /// one reading the mail. Found by `identifier` and compared, never looked up
  /// by itself — a million values cannot be unique across every address in
  /// flight, and a lookup by code alone would sign in whoever's code it was.
  code        String?              @guarded
  /// magicLink only: wrong codes against this row. Counted on the row for the
  /// reason `LoginChallenge.attempts` is — a process-local count resets on a
  /// redeploy, and here that is six digits with no ceiling.
  attempts    Int                  @default(0)

  expiresAt   DateTime
  createdAt   DateTime             @default(now())

  @@db(main)
  @@gate(8)

  /// A lapsed proof is not a proof. Declared rather than filtered, so the four
  /// purposes cannot drift — the reset path and the verify path used to carry
  /// the same clause and one of them could have lost it silently.
  @@expires(expiresAt)

  @@index([purpose, identifier])
  @@index([expiresAt])
}

/// A login that is half done.
///
/// The password was right and there is a second factor, so the caller holds a
/// ticket and no session. It is its own model rather than a fifth
/// `VerificationPurpose` for the reason `OauthFlow` below is not one either:
/// nobody is proving control of an ADDRESS here — there is no `identifier` and
/// the address was settled a step ago. Three answers to what a column means is
/// three tables wearing one name (`FJS-D261`).
///
/// `attempts` is the whole of what stands between a six-digit code and a
/// million guesses, so it is counted on the row rather than in a limiter: a
/// process-local count is reset by a redeploy and is not shared by two
/// instances, and this is the one table where both of those are an authorization
/// bypass rather than a slow path.
model LoginChallenge {
  id         String    @id @default(uuid())
  userId     String
  /// What the caller presents to finish the login. Found by this value alone,
  /// which is safe here and is not in `OauthFlow`: a ticket is handed straight
  /// back to the caller that asked for it, never carried by a redirect somebody
  /// else can start.
  value      String    @unique @guarded
  /// Counted up on every wrong code. The row is spent when it reaches the
  /// ceiling — the caller signs in from the top rather than guessing again.
  attempts   Int       @default(0)

  expiresAt  DateTime
  createdAt  DateTime  @default(now())

  @@db(main)
  @@gate(8)

  /// `completeLogin` is the one read here that deliberately does NOT filter and
  /// now says so: it wants the lapsed row in hand, because *this ticket ran
  /// out* and *no such ticket* are different lines in the audit trail and one
  /// of them tells a person to sign in again.
  @@expires(expiresAt)

  @@index([userId])
  @@index([expiresAt])
}

/// An authorization in flight.
///
/// `Oauth` and not `OAuth`, for the reason basecamp's `ThreeCX` is not `3CX`:
/// the accessor is the model name with its first character lowered and nothing
/// else, so `OAuthFlow` would be reached as `db.oAuthFlow`.
///
/// NOT a Verification, and the reuse was the mistake: nobody is proving
/// anything here, there is no address yet and there may be no account at the
/// end of it. `state` is a CSRF token echoed back by a redirect rather than a
/// secret sent to a person, its life is minutes rather than hours, and it
/// carries a PKCE verifier that no other row in this schema has a use for.
/// Three different answers to what a column means is three tables wearing one
/// name.
model OauthFlow {
  id          String   @id @default(uuid())
  /// Half of the browser binding. The other half is a cookie, and a flow found
  /// by this value ALONE is login CSRF — RFC 9700 requires the token be bound
  /// to the user agent, which a database row cannot do by itself.
  state       String   @unique @guarded
  provider    String
  /// PKCE code_verifier. Never leaves this process — it goes to the token
  /// endpoint and nowhere else.
  verifier    String   @guarded
  /// Already checked against the app's allow-list when the flow started, so
  /// what is stored here is known good and the way back decides nothing.
  returnTo    String?
  /// The oauthLink invitation this flow is answering, when it was started from
  /// the mailed link. The callback attaches only if the provider returns the
  /// subject the invitation stored: the token proves the mailbox and the
  /// subject proves the identity, and neither proves the other (FJS-D611).
  invitation  String?  @guarded

  expiresAt   DateTime
  createdAt   DateTime @default(now())

  @@db(main)
  @@gate(8)

  /// Minutes rather than hours, and a flow that has run out is a flow nobody
  /// may finish.
  @@expires(expiresAt)

  @@index([expiresAt])
}
