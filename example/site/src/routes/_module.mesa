<!--
  The storefront's layout — every page under src/routes/ is rendered inside it.

  It is the first LAYOUT this repo prerenders. `composeWrapper` walks up from a
  page to the nearest `_module.mesa` and builds a synthetic module that nests
  them, so the chain is resolved at build time and appears in the committed
  route table; nothing here runs in a browser.

  Which is the constraint worth stating: **a layout on a static target may not
  hold state.** There is no application around these pages — no router, no
  session, no store — so a header that wanted to show a basket count would have
  to be an island. This one is markup, and that is why it costs nothing.
-->
<script>
  import { BASE }   from '../money.js'
</script>

<a class="skip-link" href="#main">Skip to content</a>

<header class="topbar">
  <div class="container topbar-inner">
    <a class="topbar-brand" href="/">FrontierJS Supply Co.</a>
    <nav class="topbar-nav" aria-label="Storefront">
      <a href="/">Home</a>
      <a href="/catalog/">Catalogue</a>
      <a href="/pricing/">Pricing</a>
      <a href="/account/">Account</a>
      <!--
        A plain link, and no count on it.

        The note at the top of this file says a layout on a static target may
        not hold state, and this is where that stops being an abstract rule: a
        header that wanted a basket count would have to be an island, and an
        island in a LAYOUT hangs `vite build` in the prerender pass with no
        output at all (`FJS-549`). The link still works from every page, which
        is what a header owes a shopper; the count is on the two screens that
        already know it — the buy box says how many, the basket page shows them.
      -->
      <a href="/cart/" id="nav-basket">Basket</a>
    </nav>
  </div>
</header>

<main id="main" class="site-main">
  <slot />
</main>

<footer class="site-footer">
  <div class="container stack">
    <p class="text-sm text-muted">
      Prices in {BASE}. This is the public storefront — one HTML file per page,
      built ahead of time. The parts that have to be current ask the shop when
      you open the page.
    </p>
    <p class="text-sm text-muted">
      Staff sign in at the <a href="http://localhost:8010/">operations app</a>.
    </p>
  </div>
</footer>

<style>
  /* A prerendered page has no application around it, so the shell is here.
     Everything below reads a @frontierjs/css token — the package owns the
     scale, and a surface that invented its own would drift from the SPA's the
     first time either moved. */
  .skip-link {
    position: absolute;
    left: -9999px;
  }
  .skip-link:focus {
    left: var(--space-2xl);
    top: var(--space-2xl);
    z-index: 10;
    background: var(--surface);
    padding: var(--space-sm) var(--space-lg);
    border-radius: var(--card-radius);
  }

  .topbar {
    border-bottom: 1px solid var(--rule);
    background: var(--surface);
  }
  .topbar-inner {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: var(--space-2xl);
    padding-block: var(--space-lg);
  }
  .topbar-brand {
    font-weight: 600;
    text-decoration: none;
    color: inherit;
  }
  .topbar-nav {
    display: flex;
    gap: var(--space-2xl);
  }
  /*
   * The nav is the only place on this surface with bare <a>s, and bare means
   * the UA's own link blue: reset.css deliberately only unstyles `a:where([class])`,
   * so a classless anchor keeps the browser's color and underline. Four bright
   * blue links over the promo hero were the loudest thing on the page.
   */
  .topbar-nav a {
    color:           var(--ink-soft);
    text-decoration: none;
    font-size:       var(--text-md);
  }
  .topbar-nav a:hover {
    color:           var(--ink);
    text-decoration: underline;
  }

  .site-main {
    display: block;
    padding-block: var(--space-4xl);
    min-height: 60vh;
  }

  .site-footer {
    border-top: 1px solid var(--rule);
    padding-block: var(--space-3xl);
    margin-top: var(--space-5xl);
  }
</style>
