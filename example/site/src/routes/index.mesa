---
title: FrontierJS Supply Co.
render: static
---
<!--
  The front page. Prerendered — every byte below is in the file a visitor gets,
  and there is no JavaScript on this page at all.

  That is the claim `verify:site` checks by reading the built HTML rather than a
  rendered DOM: a page whose product names arrive from a fetch is a page a
  crawler sees empty, and it looks identical in a browser.
-->
<script>
  import { priceRange } from '../money.js'

  export let data = null

  const products = data?.products ?? []
</script>

<div class="container stack">
  <section class="stack">
    <h1>Kit for people who ship</h1>
    <p class="text-muted">
      Tees, mugs and stickers for the three realms. Everything below was written
      into this page when the site was built.
    </p>
  </section>

  <section class="stack">
    <h2 class="h4">Latest</h2>
    <ul class="cards" id="home-featured">
      {#each products as p}
        <li class="card" data-slug={p.slug}>
          <a class="card-link" href={`/products/${p.slug}/`}>
            {#if p.image}
              <img class="card-shot" src={p.image.src} alt={p.image.alt} loading="lazy" />
            {/if}
            <strong>{p.name}</strong>
            <span class="badge">{priceRange(p.from, p.to)}</span>
            {#if p.blurb}<p class="text-sm text-muted">{p.blurb}</p>{/if}
          </a>
        </li>
      {:else}
        <!--
          True in both places and that is the point of writing it here rather
          than something about the build: in the published page it means the
          shop has nothing active, and under `vite dev` it means `data` is null
          because this route's `load()` runs at build time. Sierra says the
          second one in the console; the page says what it can see.
        -->
        <li class="text-muted text-sm">Nothing to show.</li>
      {/each}
    </ul>
  </section>

  <p><a class="btn" href="/catalog/">Browse the whole catalogue</a></p>
</div>

<style>
  .cards {
    list-style: none;
    padding: 0;
    margin: 0;
    display: grid;
    gap: var(--space-2xl);
    /* `minmax(0, …)` and not `auto`: an <img> at width:100% contributes no
       intrinsic minimum, and a track sized from content collapses the card. */
    grid-template-columns: repeat(auto-fill, minmax(min(100%, 16rem), 1fr));
  }
  .card-link {
    display: grid;
    /* start, not stretch: a Badge is an inline term, and a grid item defaults
       to filling its column — which turns a price into a full-width bar. */
    justify-items: start;
    gap: var(--space-sm);
    text-decoration: none;
    color: inherit;
  }
  .card-shot {
    width: 100%;
    aspect-ratio: 4 / 3;
    object-fit: contain;
    background: var(--surface-sunken);
    border-radius: var(--card-radius);
  }
</style>
