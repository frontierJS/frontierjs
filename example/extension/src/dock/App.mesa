<script>
  // The popup — the shop's despatch queue, in the toolbar.
  //
  // It has NO connection of its own. `harbor` is the port to the service
  // worker, supplied by jetty's auto-generated entry, and every service call
  // and every pushed event travels over it. That is the whole shape of a jetty
  // app: one socket, in the one context that outlives the surfaces.
  //
  // Everything below is `@frontierjs/jetty/resources`, which is jetty's own
  // orchestrator and deliberately NOT a copy of Sierra's — Sierra calls
  // `client.service(name)` and this calls `harbor.request('service:call')`.
  import { createResource, login, submitCode, logout, getConnectionState } from '@frontierjs/jetty/resources'
  import { formatMoney, fromMinor } from '@frontierjs/toolbelt/units'

  export let harbor = null

  // The cached state first, because the reply to this popup's `init` can arrive
  // before the listener below exists — which is how a popup opened after the
  // password would draw a password form over an attempt still waiting.
  let session  = getConnectionState()
  let orders   = []
  let status   = harbor ? 'connecting' : 'no harbor'
  let error    = ''
  let email    = 'alex@shop.test'
  let password = ''
  let code     = ''

  // One resource, one channel. `createResource` subscribes to `orders` and the
  // EVENT that arrives decides what happens to the store — `orders pay` from
  // another tab is an upsert here, with nothing in this file polling.
  const queue = createResource('orders')

  // The store is the filter now. An order this dock has just SHIPPED arrives
  // back as `orders ship`, and the record no longer matches the query `load()`
  // asked for — so the store REMOVES it rather than upserting it into a list it
  // has left (`FJS-493`). This used to re-filter on the way out, which was the
  // screen making a decision the store could not.
  queue.store.subscribe(rows => { orders = rows ?? [] })

  // Paid and not yet shipped: what a person standing at the bench is for.
  const load = () => guard(() => queue.load({ status: 'paid' }, { orderBy: 'createdAt' }))

  async function guard(fn) {
    try { error = ''; return await fn() }
    catch (e) { error = e?.message ?? String(e) }
  }

  if (harbor) {
    harbor.on('session', p => {
      // `awaitingCode` rides the same broadcast: a password was accepted and a
      // code is owed. It comes from the HARBOR and not from the promise below,
      // because this popup closes on a click elsewhere and the next one to open
      // has to find the attempt still standing.
      session = { authenticated: p?.authenticated, user: p?.user, awaitingCode: p?.awaitingCode ?? null }
      status  = p?.authenticated ? 'signed in' : 'signed out'
      if (p?.authenticated) load()
    })
    harbor.onDisconnect(() => status = 'harbor gone')
  }

  const signIn  = () => guard(async () => { await login({ email, password }); password = '' })
  const verify  = () => guard(async () => { await submitCode(code.trim()); code = '' })
  const signOut = () => guard(async () => { await logout(); orders = [] })

  // `ship` is a TRANSITION, declared in db/schema.lite and named by the orders
  // service. Not a PATCH of `status`: the machine narrows the UPDATE with the
  // state it expects, so two people shipping the same order produce one winner
  // and one 409 rather than two silent successes.
  const ship = row => guard(() => queue.service.call('ship', row.id, null))

  // The order's own columns are `@money(USD)`, so what arrives is a whole
  // number of CENTS in the shop's base currency. This used to hand-roll
  // `£${n / 100}` against a column that held dollars — a pound sign on a dollar
  // amount, at a hundredth of it — which is `FJS-440`'s shape twice over and is
  // exactly what one owner of the conversion removes.
  const money = cents => formatMoney(fromMinor(cents ?? 0, 'USD'), 'USD')
</script>

<div class="dock">
  <header>
    <strong>Shop Desk</strong>
    <span class="status" data-status>{status}</span>
  </header>

  {#if session?.authenticated}
    <div class="who">
      <span data-who>{session.user?.email ?? 'signed in'}</span>
      <button onclick={signOut}>Sign out</button>
    </div>

    <div class="bar">
      <span>Awaiting despatch</span>
      <span class="count" data-count>{orders.length}</span>
      <button onclick={load} data-refresh>Refresh</button>
    </div>

    <ul class="orders" data-orders>
      {#each orders as row (row.id)}
        <li data-order={row.id}>
          <span class="ref">#{row.id}</span>
          <span class="total">{money(row.total)}</span>
          <button onclick={() => ship(row)} data-ship={row.id}>Ship</button>
        </li>
      {:else}
        <li class="empty">Nothing waiting.</li>
      {/each}
    </ul>
  {:else if session?.awaitingCode}
    <!-- Nothing is stored and the socket is not upgraded until this is
         answered. A spent attempt comes back as a broadcast with no
         awaitingCode, which is what returns the popup to the password. -->
    <div class="signin" data-code-box>
      <span>Code from your authenticator, or a recovery code</span>
      <input bind:value={code} autocomplete="one-time-code" placeholder="123456" data-code />
      <button onclick={verify} data-code-submit>Verify</button>
      <button onclick={signOut} data-code-cancel>Start over</button>
    </div>
  {:else}
    <div class="signin">
      <input bind:value={email} placeholder="email" data-email />
      <input bind:value={password} type="password" placeholder="password" data-password />
      <button onclick={signIn} data-signin>Sign in</button>
    </div>
  {/if}

  {#if error}
    <p class="error" data-error>{error}</p>
  {/if}
</div>

<style>
  /* The popup page loads no @frontierjs/css, so the tokens it reads are
     declared here under the package's own names — importing the stylesheet
     is then deleting this block, not rewriting every rule below it. */
  .dock    { --space-2xs: 4px; --space-xs: 6px; --space-sm: 8px; --space-md: 10px; --space-lg: 12px;
             --text-2xs: 11px; --text-xs: 12px; --text-sm: 13px;
             --card-radius: 4px; --pill-radius: 10px; --orders-max: 220px; --dock-width: 320px;
             --rule: #f0f0f0; --rule-strong: #e3e3e3; --surface-sunken: #eee;
             --ink-soft: #666; --ink-mute: #999; --color-danger: #b3261e;
             font: var(--text-sm) system-ui, sans-serif; padding: var(--space-lg); width: var(--dock-width); }
  header   { display: flex; justify-content: space-between; align-items: baseline;
             padding-bottom: var(--space-sm); border-bottom: 1px solid var(--rule-strong); margin-bottom: var(--space-md); }
  .status  { font-size: var(--text-2xs); color: var(--ink-soft); }
  .who     { display: flex; justify-content: space-between; align-items: center;
             margin-bottom: var(--space-md); font-size: var(--text-xs); }
  .bar     { display: flex; align-items: center; gap: var(--space-sm); margin-bottom: var(--space-xs); }
  .bar span:first-child { flex: 1; font-weight: 600; }
  .count   { background: var(--surface-sunken); border-radius: var(--pill-radius); padding: 1px var(--space-sm); }
  .orders  { list-style: none; margin: 0; padding: 0; border: 1px solid var(--rule-strong);
             border-radius: var(--card-radius); max-height: var(--orders-max); overflow-y: auto; }
  .orders li { display: flex; align-items: center; gap: var(--space-sm); padding: var(--space-xs) var(--space-sm);
               border-bottom: 1px solid var(--rule); }
  .ref     { font-variant-numeric: tabular-nums; }
  .total   { flex: 1; text-align: right; font-variant-numeric: tabular-nums; }
  .empty   { color: var(--ink-mute); justify-content: center; }
  .signin  { display: grid; gap: var(--space-xs); }
  .error   { color: var(--color-danger); margin: var(--space-sm) 0 0; }
</style>
