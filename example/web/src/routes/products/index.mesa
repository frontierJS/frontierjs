---
title: Products
---
<script>
  // The catalogue, one row per PRODUCT — the family, not the buyable thing.
  //
  // Which means every number in this table is an aggregate over a second
  // table: a price is a range because four colourways may not agree, and stock
  // is a sum because the family does not have any. They are `@from` columns on
  // `Product`, so SQLite answers them on the row and this page reads them like
  // any other field.
  //
  // It used to load every variant of every product and reduce them here, which
  // is honest at 43 rows and the wrong shape at 43,000 — a second full read to
  // render three columns. A `@from` is a correlated subquery: no extra round
  // trip, no column to go stale, and no summary method to keep in step with
  // the screen that reads it.
  import { products }      from '../../resources/Product.mesa'
  import { productImages } from '../../resources/ProductImage.mesa'
  import { session } from '../../session.js'
  import { prefs }   from '../../prefs.js'
  import { money }   from '../../money.js'
  import { useStore } from '@frontierjs/sierra/junction'
  import { goto }     from '@frontierjs/sierra/router'

  import Alert         from '@frontierjs/ui/components/feedback/Alert.mesa'
  import Button        from '@frontierjs/ui/components/forms/Button.mesa'
  import Combobox      from '@frontierjs/ui/components/forms/Combobox.mesa'
  import EmptyState    from '@frontierjs/ui/components/display/EmptyState.mesa'
  import MultiSelect   from '@frontierjs/ui/components/forms/MultiSelect.mesa'
  import Pagination    from '@frontierjs/ui/components/display/Pagination.mesa'
  import Pill          from '@frontierjs/ui/components/display/Pill.mesa'
  import SectionHeader from '@frontierjs/ui/components/display/SectionHeader.mesa'
  import Slider        from '@frontierjs/ui/components/forms/Slider.mesa'
  import Table         from '@frontierjs/ui/components/display/Table.mesa'

  const { get: rows,   unsubscribe: offP } = useStore(products.store)
  const { get: images, unsubscribe: offI } = useStore(productImages.store)
  $.onDestroy(() => { offP(); offI() })

  $: (session.level, prefs.perPage, prefs.dense, prefs.currency)

  let error   = null
  let loading = true

  // The image store is loaded with a limit above the seeded row count on
  // purpose: a default page of 20 would leave later products with no
  // thumbnail, which looks like a catalogue problem rather than a paging one.
  // The price and stock columns no longer have that hazard at all — they
  // arrive on the product row.
  Promise.all([
    products.load(),
    productImages.load({}, { limit: 500 }),
  ])
    .then(() => { high = ceiling; widened = true })
    .catch(e => { error = e.message })
    .finally(() => { loading = false })

  const columns = [
    { key: 'name',    label: 'Product' },
    { key: 'brand',   label: 'Brand' },
    { key: 'variants',label: 'Variants' },
    { key: 'price',   label: 'Price' },
    { key: 'stock',   label: 'Stock' },
    { key: 'active',  label: 'Active' },
  ]

  // ── Derived, per product ─────────────────────────────────────────────────
  const thumbOf = (id) => images().filter(i => i.productId === id)
                                  .sort((a, b) => a.position - b.position)[0]

  // `priceFrom` / `priceTo` are equal when there is nothing to choose between,
  // and both are null for a product with no variants — which is a family
  // nobody can buy yet, not a price of zero.
  const priceRange = (p) =>
    p.variantCount ? { lo: p.priceFrom, hi: p.priceTo, one: p.priceFrom === p.priceTo } : null

  // ── Filters ──────────────────────────────────────────────────────────────
  //
  // Client-side, over what arrived — the point here is the controls. The
  // options each one offers are read off the rows, so a filter never offers a
  // value no record has.
  let pick     = undefined
  let brands   = []
  let statuses = []
  let low      = 0
  let high     = 0
  let pageNo   = 1
  const PER_PAGE = prefs.perPage

  const names      = rows().map(p => p.name)
  const brandNames = [...new Set(rows().map(p => p.brand))]

  // The ceiling is the dearest variant in the catalogue, which is what
  // `priceTo` already is per product. Read a price off the product itself and
  // it would be 10 — the floor — and the slider would filter everything out.
  const ceiling = Math.max(10, ...rows().map(p => Math.ceil(p.priceTo ?? 0)))
  let widened = false

  const filtered = rows().filter(p => {
    const r = priceRange(p)
    return (!pick || p.name === pick)
        && (!brands.length   || brands.includes(p.brand))
        && (!statuses.length || statuses.includes(p.active ? 'active' : 'retired'))
        && (!widened || !r || (r.hi >= low && r.lo <= high))
  })

  const paged = filtered.slice((pageNo - 1) * PER_PAGE, pageNo * PER_PAGE)

  function clearFilters() {
    pick = undefined; brands = []; statuses = []
    low = 0; high = ceiling; pageNo = 1
  }
</script>

<SectionHeader title="Products" level={1} sub="read is public — no sign-in needed" />

{#if error}
  <Alert tone="danger">{error}</Alert>
{/if}

<div class="card cluster" style="align-items: flex-end; gap: 1rem; flex-wrap: wrap">
  <Combobox
    id="f-name"
    label="Product"
    placeholder="Any product"
    options={names}
    bind:value={pick}
    hint="one name, or clear it"
  />

  <MultiSelect
    id="f-brand"
    label="Brand"
    multiple
    placeholder="Any brand"
    options={brandNames}
    bind:value={brands}
    hint="Product.brand, an enum"
  />

  <MultiSelect
    id="f-status"
    label="Status"
    multiple
    placeholder="Any status"
    options={['active', 'retired']}
    bind:value={statuses}
    hint="derived from Product.active"
  />

  <Slider
    id="f-price"
    label="Price"
    range
    min={0}
    max={ceiling}
    step={1}
    bind:start={low}
    bind:end={high}
  />

  <Button variant="ghost" id="f-clear" onclick={clearFilters}>Clear</Button>
</div>

<Table {columns} rows={paged} {loading} striped hover compact={prefs.dense}>
  {#snippet row(p)}
    <tr class="product-row" onclick={() => goto(`/products/${p.id}/`)}>
      <td>
        <span class="cluster" style="align-items: center; gap: .6rem">
          {#if thumbOf(p.id)}
            <img class="thumb" src={thumbOf(p.id).file} alt={thumbOf(p.id).alt} width="40" height="40" loading="lazy" />
          {:else}
            <span class="thumb thumb-empty" aria-hidden="true"></span>
          {/if}
          <a href={`/products/${p.id}/`}>{p.name}</a>
        </span>
      </td>
      <td><Pill tone="info">{p.brand}</Pill></td>
      <td>{p.variantCount}</td>
      <td>
        {#if priceRange(p) === null}
          <span class="text-muted">—</span>
        {:else if priceRange(p).one}
          {money(priceRange(p).lo)}
        {:else}
          {money(priceRange(p).lo)}–{money(priceRange(p).hi)}
        {/if}
      </td>
      <td>
        {#if p.onHand === 0}
          <Pill tone="danger">out of stock</Pill>
        {:else}
          {p.onHand}
        {/if}
      </td>
      <td><Pill tone={p.active ? 'success' : 'muted'}>{p.active ? 'active' : 'retired'}</Pill></td>
    </tr>
  {/snippet}

  {#snippet empty()}
    <tr>
      <td colspan={columns.length}>
        <EmptyState
          title={rows().length ? 'No product matches those filters' : 'No products yet'}
          description={rows().length ? 'Widen the price range or clear the brand.' : 'Seed the database and reload.'}
        >
          {#snippet action()}
            <Button variant="outlined" onclick={clearFilters}>Clear filters</Button>
          {/snippet}
        </EmptyState>
      </td>
    </tr>
  {/snippet}
</Table>

<Pagination
  page={pageNo}
  total={filtered.length}
  perPage={PER_PAGE}
  onchange={(n) => pageNo = n}
/>

<p class="text-sm text-muted">
  A price here is a RANGE and a stock a SUM, because neither belongs to the family — <code>ProductVariant</code> carries them, one row per <code>(colour, size)</code>. The thumbnail is a <code>File</code> column: the row holds a reference and the bytes come from the API's own storage.
</p>

<style>
  .product-row { cursor: pointer }
  .thumb {
    width: 40px; height: 40px;
    object-fit: contain;
    border-radius: var(--btn-radius);
    background: var(--surface-sunken);
    flex: none;
  }
  .thumb-empty { display: inline-block }
</style>
