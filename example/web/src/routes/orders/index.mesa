---
title: Orders
---
<script>
  import { orders } from '../../resources/Order.mesa'
  import { session } from '../../session.js'
  import { prefs } from '../../prefs.js'
  import { useStore } from '@frontierjs/sierra/junction'

  import Alert         from '@frontierjs/ui/components/feedback/Alert.mesa'
  import Button        from '@frontierjs/ui/components/forms/Button.mesa'
  import ConfirmationPopover from '@frontierjs/ui/components/overlay/ConfirmationPopover.mesa'
  import CopyButton    from '@frontierjs/ui/components/display/CopyButton.mesa'
  import DatePicker    from '@frontierjs/ui/components/forms/DatePicker.mesa'
  import Drawer        from '@frontierjs/ui/components/overlay/Drawer.mesa'
  import Mono          from '@frontierjs/ui/components/display/Mono.mesa'
  import Pill          from '@frontierjs/ui/components/display/Pill.mesa'
  import SectionHeader from '@frontierjs/ui/components/display/SectionHeader.mesa'
  import Table         from '@frontierjs/ui/components/display/Table.mesa'
  import Tag           from '@frontierjs/ui/components/display/Tag.mesa'

  // The columns a Table draws are a UI decision, so they are written here —
  // but every VALUE below still comes from the schema. Nothing in this list
  // adds a field the model does not have.
  const columns = [
    { key: 'reference',  label: 'Reference' },
    { key: 'status',     label: 'Status' },
    { key: 'total',      label: 'Total' },
    { key: 'customerId', label: 'Customer' },
    { key: 'note',       label: 'Note' },
    // Written by a job, not by anything on this page — see the note below.
    { key: 'trackingCode', label: 'Tracking' },
    { key: 'moves',      label: 'Moves' },
    { key: 'actions',    label: 'Actions' },
  ]

  const { get: rows, unsubscribe } = useStore(orders.store)
  $.onDestroy(unsubscribe)

  $: (session.level, prefs.dense, prefs.quickView)

  let error = null

  orders.load().catch(e => { error = e.message })

  // The schema says delete needs level 5. Asking before rendering is the only
  // reason this button can be disabled rather than 403-ing on click — and it is
  // still the server that actually refuses.
  $: canDelete = orders.can('delete', session.level)

  // `var`, not `const`: a gate level comes off the schema and never changes,
  // so a snapshot is what it is. Read straight in the template it is still a
  // one-time read, only silently — the compiler reports an uncovered member
  // read on an imported object, and saying `var` is how you agree with it.
  var deleteLevel = orders.gate.delete

  // A transition IS an update, so it answers to the model's @@gate as well as
  // to its own @gate. transitionsAt() only grades the per-move gate — it is
  // given a row and a level, not the model's gate table — so without this a
  // signed-out visitor sees `pay` enabled (it declares no @gate, and unknown
  // answers are permissive) and learns otherwise from a 403.
  $: canMove = orders.can('update', session.level)

  // ── Placed-between ───────────────────────────────────────────────────────
  //
  // A DatePicker is the control an app CHOOSES — Sierra's control table answers
  // `input type="date"` for a Date column, which round-trips a zoneless date
  // with no JS at all, and that is the right default. A range with presets is
  // not something a type can imply, so it is wired by hand here.
  //
  // Client-side, like the product filters: the point is the control, not a
  // query builder. `createdAt` is an ISO-8601 instant (Litestone stores
  // DateTime as TEXT), so it is compared as a timestamp and not as a string.
  let placedFrom = undefined
  let placedTo   = undefined

  // A preset carrying `start`/`end` applies itself; the picker has no callback
  // for "a preset was chosen" and does not need one.
  const DAY   = 86_400_000
  const TODAY = new Date().setHours(0, 0, 0, 0)
  const PRESETS = [
    { value: 'today', text: 'Today',        start: TODAY,            end: TODAY },
    { value: '7d',    text: 'Last 7 days',  start: TODAY - 6 * DAY,  end: TODAY },
    { value: '30d',   text: 'Last 30 days', start: TODAY - 29 * DAY, end: TODAY },
  ]

  function clearPlaced() {
    placedFrom = undefined
    placedTo   = undefined
  }

  // `inclusiveEnd` is the picker's default, so the end date means the whole of
  // that day — comparing against midnight would drop every order placed after
  // it on the last day of the range.
  const visible = rows().filter(o => {
    if (placedFrom === undefined && placedTo === undefined) return true
    const at = Date.parse(o.createdAt)
    return (placedFrom === undefined || at >= placedFrom)
        && (placedTo   === undefined || at <= placedTo + DAY - 1)
  })

  // Which tone a status gets is a mapping the design system owns; the STATES
  // come from the enum in the schema, not from a list written here.
  const tone = (s) => ({
    pending:   'warning',
    paid:      'info',
    shipped:   'success',
    refunded:  'muted',
    cancelled: 'danger',
  })[s] ?? 'muted'

  async function remove(id) {
    error = null
    try { await orders.service.remove(id) } catch (e) { error = e.message }
  }

  // ── The state machine ────────────────────────────────────────────────────
  //
  // No list of moves appears in this file. `orders.transitions(row, level)`
  // reads x-transitions — the same @@transitions block Litestone enforces with
  // — and answers with exactly the moves legal FROM THIS ROW'S CURRENT STATE,
  // each carrying the level it needs. A `shipped` order offers nothing, because
  // the schema says nothing leaves `shipped`.
  //
  // `allowed` is an affordance on the same permissive contract as can(): a move
  // the caller cannot make comes back with allowed:false rather than vanishing,
  // so it renders disabled and the reason stays visible. The server refuses
  // regardless — signed in as a user, refund is a 403 whatever this renders.

  let busy = null

  // The row you are looking at without leaving the list. A Drawer is a native
  // <dialog>, so focus trapping, Escape and the backdrop come from the platform
  // — the same reason the confirmation below is a popover and not a div: it
  // needs none of that, and a dialog would trap focus for a two-button answer.
  let peek = null

  async function run(name, id) {
    error = null
    busy  = id + ':' + name
    try {
      // Dispatched as POST /api/orders/{id} with X-Service-Method: {name}.
      // Nothing in the app registers that route.
      const row = await orders.service.invoke(name, id)

      // No refetch. The server announces the move as `orders pay` and the
      // client's '*' handler upserts it, so THIS table and every other open
      // one re-grade from the same broadcast — proved by web/test/verify-live.mjs.
      // The upsert below is for the socketless case (the HTTP fallback), where
      // no broadcast arrives; it is idempotent, so it costs the live path
      // nothing. Until 2026-08-06 this line was `await orders.load()`, and that
      // refetch was the only reason the page looked right — an action announced
      // nothing at all, and a second tab went stale in silence.
      if (row?.id) orders.store.upsert(row)
    } catch (e) {
      // 409 Conflict — the row moved, or the move was never legal from here.
      // 403 Forbidden — the move is gated above this session.
      error = e.message
    } finally {
      busy = null
    }
  }
</script>

<SectionHeader title="Orders" level={1}>
  {#snippet action()}
    <Button href="/orders/create/">New order</Button>
  {/snippet}
</SectionHeader>

{#if error}
  <Alert tone="danger">{error}</Alert>
{/if}

<!--
  Placed-between. A Tag is the removable half of a Pill: the chip says a filter
  is on AND is the way to turn it off, which a Pill deliberately cannot do.
-->
<div class="card cluster" style="align-items: flex-end; gap: 1rem; flex-wrap: wrap">
  <DatePicker
    isRange
    showPresets
    presetRanges={PRESETS}
    label="Placed between"
    bind:startDate={placedFrom}
    bind:endDate={placedTo}
  />

  {#if placedFrom !== undefined || placedTo !== undefined}
    <Tag tone="info" label="Clear the placed-between filter" onremove={clearPlaced}>
      {placedFrom !== undefined ? new Date(placedFrom).toLocaleDateString() : 'any'}
      →
      {placedTo !== undefined ? new Date(placedTo).toLocaleDateString() : 'any'}
    </Tag>
    <span class="text-sm text-muted">{visible.length} of {rows().length}</span>
  {/if}
</div>

<!--
  The kit's Table owns the structure, the wrap, the striping and the empty
  state; the row snippet stays here because what a cell CONTAINS is this app's
  business. `rows()` is named inside the prop expression so the store's next
  value re-renders the body.
-->
<Table {columns} rows={visible} striped hover compact={prefs.dense}>
  {#snippet row(order)}
    <tr>
      <!-- Which of these two the reference is depends on a preference read
           from /settings/ — a setting that changes nothing is decoration. -->
      <td>
        {#if prefs.quickView}
          <Button variant="link" onclick={() => peek = order}><Mono>{order.reference}</Mono></Button>
        {:else}
          <a href={'/orders/' + order.id + '/'}><Mono>{order.reference}</Mono></a>
        {/if}
      </td>
      <td><Pill tone={tone(order.status)}>{order.status}</Pill></td>
      <td>{order.total}</td>
      <td class="text-muted">#{order.customerId}</td>
      <td class="text-muted">{order.note === null ? '—' : order.note}</td>
      <td>
        {#if order.trackingCode}
          <span class="cluster">
            <Mono size="xs">{order.trackingCode}</Mono>
            <!-- A tracking code exists to be pasted somewhere else. -->
            <CopyButton text={order.trackingCode} label="" />
          </span>
        {:else if order.status === 'shipped'}
          <span class="text-sm text-muted">booking…</span>
        {:else}
          <span class="text-sm text-muted">—</span>
        {/if}
      </td>
      <td>
        <!-- `session.level` is named in the expression on purpose: Mesa reads
             an expression's dependencies from its text, so calling
             transitions() without mentioning it would compute the moves once
             at mount and never re-grade them on sign-in. -->
        <div class="cluster">
          {#each orders.transitions(order, session.level) as move}
            <Button
              variant="ghost"
              loading={busy === order.id + ':' + move.name}
              disabled={!move.allowed || !canMove || busy !== null}
              title={!canMove ? 'sign in to move an order'
                   : move.allowed ? move.from + ' → ' + move.to
                   : 'needs level ' + move.gate}
              onclick={() => run(move.name, order.id)}
            >{move.name}</Button>
          {/each}
          {#if !orders.transitions(order, session.level).length}
            <span class="text-sm text-muted">—</span>
          {/if}
        </div>
      </td>
      <td>
        <div class="cluster">
          <Button variant="ghost" onclick={() => peek = order}>View</Button>

          <!--
            Delete asks first, and asks where the button is. Not a Modal: a
            two-button question does not need focus trapped or the top layer,
            and the popover keeps the row you are deleting on screen behind it.
            The trigger is still the same `.btn.danger`, still disabled by the
            same gate answer — the server refuses either way.

            It said "there is no undo" until `Order` declared `@@softDelete`.
            It stamps `deletedAt` now and `(cascade)` takes the lines with it,
            so the row leaves every list and the receipt is still there. The
            copy says what actually happens, because a warning that overstates
            the consequence is the one people learn to click through.
          -->
          <ConfirmationPopover
            title="Delete this order?"
            message={'@@gate wants level ' + deleteLevel + ' — it leaves every list, and its lines go with it.'}
            confirmLabel="Delete"
            onconfirm={() => remove(order.id)}
          >
            {#snippet trigger()}
              <Button variant="ghost" tone="danger" disabled={!canDelete}>Delete</Button>
            {/snippet}
          </ConfirmationPopover>
        </div>
      </td>
    </tr>
  {/snippet}
</Table>

{#if !canDelete}
  <Alert tone="muted">
    Delete is disabled because <code>@@gate</code> wants level
    {deleteLevel} and this session is {session.level}. Sign in as admin.
  </Alert>
{/if}

<Alert tone="info">
  The <strong>Moves</strong> column is <code>@@transitions</code> from
  <code>db/schema.lite</code>, read back through <code>x-transitions</code> — no
  list of moves exists in this component. A <code>shipped</code> order offers
  none, because nothing leaves <code>shipped</code>. <code>refund</code> carries
  <code>@gate(5)</code>, so signed in as <em>sam</em> it renders disabled and
  signed in as <em>alex</em> it does not — and the server answers 403 either way
  if you get past the button.
</Alert>

<Alert tone="info">
  <strong>Tracking</strong> is written by a job, not by a request. Press
  <em>ship</em> and the cell says <em>booking…</em> — the move has happened, the
  courier has not been called yet. A second or two later the code appears
  <strong>without this page asking for anything</strong>: a
  <code>@frontierjs/caravan</code> worker booked the courier off the request,
  wrote the result through the orders <em>service</em>, and the announcement
  came down the same channel every other change uses. Leave a second tab open on
  this page and watch it fill in there too.
</Alert>

<!--
  Quick view. `peek` is the whole state — closing the drawer is setting it to
  null, the same shape the confirmation Modal on the detail page uses. The
  content is deliberately thin: this is the row you already have, not a second
  fetch, and the link is what takes you to the page that loads more.
-->
<Drawer
  open={peek !== null}
  title={peek ? peek.reference : ''}
  side="right"
  onclose={() => peek = null}
>
  {#snippet footer()}
    <div class="cluster">
      <Button href={peek ? '/orders/' + peek.id + '/' : '/orders/'}>Open the order</Button>
      <Button variant="ghost" onclick={() => peek = null}>Close</Button>
    </div>
  {/snippet}

  {#if peek}
    <dl class="facts">
      <dt>Reference</dt><dd><Mono>{peek.reference}</Mono> <CopyButton text={peek.reference} /></dd>
      <dt>Status</dt><dd><Pill tone={tone(peek.status)}>{peek.status}</Pill></dd>
      <dt>Total</dt><dd>{peek.total}</dd>
      <dt>Customer</dt><dd>#{peek.customerId}</dd>
      <dt>Note</dt><dd>{peek.note === null ? '—' : peek.note}</dd>
      <dt>Placed</dt><dd>{peek.createdAt}</dd>
    </dl>
  {/if}
</Drawer>
