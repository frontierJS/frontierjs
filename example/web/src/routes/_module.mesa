---
siteName: Kitchen sink
---
<script>
  import { page, isActive, goto } from '@frontierjs/sierra/router'
  import { session, signIn, completeSignIn, signOut, status, getClient } from '@frontierjs/sierra/resource'
  import { cart, refresh as refreshCart } from '@/stores/cart.js'

  import AccountStatus  from '@frontierjs/ui/components/display/AccountStatus.mesa'
  import Alert          from '@frontierjs/ui/components/feedback/Alert.mesa'
  import AlertProvider  from '@frontierjs/ui/components/feedback/AlertProvider.mesa'
  import Badge          from '@frontierjs/ui/components/display/Badge.mesa'
  import Button         from '@frontierjs/ui/components/forms/Button.mesa'
  import CommandPalette from '@frontierjs/ui/components/overlay/CommandPalette.mesa'
  import Dot            from '@frontierjs/ui/components/display/Dot.mesa'
  import Field          from '@frontierjs/ui/components/forms/Field.mesa'
  import Input          from '@frontierjs/ui/components/forms/Input.mesa'
  import Kbd            from '@frontierjs/ui/components/display/Kbd.mesa'
  import Pill           from '@frontierjs/ui/components/display/Pill.mesa'
  import Shell          from '@frontierjs/ui/components/layout/Shell.mesa'
  import Toaster        from '@frontierjs/ui/components/feedback/Toaster.mesa'
  import DropdownItem      from '@frontierjs/ui/components/overlay/DropdownItem.mesa'
  import DropdownGroup     from '@frontierjs/ui/components/overlay/DropdownGroup.mesa'
  import DropdownMenu      from '@frontierjs/ui/components/overlay/DropdownMenu.mesa'
  import DropdownSeparator from '@frontierjs/ui/components/overlay/DropdownSeparator.mesa'
  import { alert }          from '@frontierjs/ui/stores/alertStore'
  import { commandPalette } from '@frontierjs/ui/stores/commandPaletteStore'
  import { toasts }         from '@frontierjs/ui/stores/toastStore'
  import { paletteItems }   from '@frontierjs/ui/nav'

  import { groups } from '@/lib/nav.js'

  import { notifications, isUnread } from '../resources/Notification.mesa'

  $: (session.oauthError, session.oauthMessage)

  // The bell. `notifications` is a resource like any other, and its rows are
  // fed by the same WS events every other table uses — the inApp driver
  // publishes to `notifications:user:<id>`, api/src/app.ts joins a signed-in
  // connection to it, and nothing here polls.
  const bell  = notifications.tethered({ state: 'local' })
  const notes = () => bell.rows

  // Reload on sign-in and sign-out, not once at mount: the list is scoped to
  // the caller by the model's own row policy, so a session change is a
  // different list. Signed out it is empty and the bell does not render.
  $: session.user, () => { if (session.user) bell.reload() }

  $: unread = notes().filter(isUnread).length

  // The bell groups rather than sorts: an unread row and a read one are two
  // different things to a reader, so the menu says so with a label over each
  // and a rule between them, instead of relying on a tone the eye has to
  // decode. Both lists come off the same tether.
  $: fresh  = notes().filter(isUnread)
  $: seen   = notes().filter(n => !isUnread(n))

  // The socket dropping is app-wide system feedback with nowhere to land — no
  // screen owns it, and a toast for it would queue behind whatever the page is
  // saying. `alert` is the one floating channel, mounted once below.
  //
  // Edge-triggered, and the initial value is `false`: the socket is not
  // connected at mount either, and firing on that state rather than on the
  // TRANSITION into it means every cold load announces a drop that never
  // happened.
  let wasConnected = false
  $: {
    if (wasConnected && !status.connected) {
      alert.warning('The live connection dropped. Changes made elsewhere will not appear until it is back.')
    }
    wasConnected = status.connected
  }

  async function openNote(note) {
    // Marking read is a patch of one field — `readAt` is the only thing the
    // service accepts, and the model's @@allow(update) is what stops it being
    // somebody else's row.
    if (isUnread(note)) await notifications.service.patch(note.id, {}).catch(() => {})
    const url = note.data?.action?.url
    if (url) goto(url)
  }

  // The basket is restored once, here, rather than on the basket screen — a
  // count in the header that only appears after you visit /cart/ is a count
  // nobody trusts. A browser holding no token makes no request at all.
  refreshCart()

  $: (cart.count)
  $: (page.siteName, page.pathname, page.query)
  $: (status.connected, session.user, session.level, session.checked, session.error, session.awaitingCode)
  $: commandPalette.open

  // ⌘K. The commands are ordinary functions — the palette is a way to reach
  // what the nav and the header already do, not a second set of behaviors.
  // Navigate is derived from src/lib/nav.js through the same `show`, so it
  // cannot offer a screen the nav hides or miss one the nav lists.
  $: COMMANDS = [
    ...paletteItems(groups, { user: session.user, level: session.level }, goto),
    { id: 'go-sign-in',   group: 'Session',  label: 'Sign in with an email and password', action: () => goto('/sign-in/') },
    { id: 'sign-in-user',  group: 'Session', label: 'Sign in as sam (level 4)',  action: () => as('user') },
    { id: 'sign-in-admin', group: 'Session', label: 'Sign in as alex (level 5)', action: () => as('admin') },
    { id: 'sign-out',      group: 'Session', label: 'Sign out',                  action: out },
  ]

  // Plain `let`s are already component state — they must NOT go in the `$:`
  // path-watch above, which is for fields of plain objects (Mesa RULE 43).
  // Listing one there compiles cleanly and throws `$runtime.get(...) is not a
  // function` on mount.
  let email    = 'sam@shop.test'
  let password = 'correct-horse-battery'
  let busy     = false

  // Which providers to draw a button for is ASKED, never listed here. The API
  // configures them (api/src/app.ts, `oauthProviders`) and this app is a
  // separate build — a copy of the list here would be a button that redirects
  // into `oauth_error=unavailable` the first time the two disagree.
  //
  // Empty in the ordinary run: the shop only configures a provider under
  // SHOP_COOKIE_AUTH=1, because the callback can only hand back a cookie. So
  // this row appears and disappears with the server's own configuration, which
  // is the whole point of asking.
  let providers = []

  $.onMount(async () => {
    try { providers = await getClient().auth.providers() } catch { providers = [] }
  })

  async function submit() {
    busy = true
    // signIn puts the refusal on session.error as well as throwing it, and
    // the shell renders that — so this catch is the whole error handling.
    try { await signIn(email, password) } catch {} finally { busy = false }
  }

  function as(who) {
    email = who === 'admin' ? 'alex@shop.test' : 'sam@shop.test'
    password = 'correct-horse-battery'
    return submit()
  }

  // Awaited: signOut ends the session at the SERVER first — dropping the token
  // locally and leaving the row alive is what this app used to do.
  async function out() {
    await signOut()
    goto('/')
  }

  // ── The second step ──────────────────────────────────────────────────────
  //
  // In the shell rather than on /sign-in/, because any sign-in can owe one —
  // the dev buttons above and the palette's commands call the same signIn — and
  // a box that lived on one page would leave the others holding a password
  // accepted and nowhere to type the code.
  //
  // A refusal lands on session.error like any other; `retryable: false` closes
  // the box in sierra, which is what sends the person back to the password
  // rather than typing into an attempt that is already spent.
  let code      = ''
  let codeBusy  = false

  async function verify() {
    codeBusy = true
    try { await completeSignIn(code.trim()); code = '' } catch {} finally { codeBusy = false }
  }

  const lapses = (iso) => new Date(iso).toLocaleTimeString([], { hour: '2-digit', minute: '2-digit' })
</script>

<!--
  Every class here comes from @frontierjs/css. There is no <style> block in this
  app: the frame (shell / topbar / screen), the nav, the tables, the forms and
  the alerts are all vocabulary.

  The Shell draws the bar and the nav from src/lib/nav.js, and marks the current
  page with aria-current through Sierra's isActive. A guest gets the same frame,
  because the table offers a shopper Basket at level 0.
-->
<Shell {groups} layout="topbar"
       path={page.pathname} query={page.query}
       user={session.user} level={session.level} checked={session.checked}
       {isActive} onsignout={out}>
  {#snippet brand()}
    <span class="cluster">
      <strong>{page.siteName}</strong>
      <Badge tone="muted">pre-alpha</Badge>
    </span>
  {/snippet}

  {#snippet badge(entry)}
    {#if entry.href === '/cart/' && cart.count}<Badge tone="info" id="nav-basket-count">{cart.count}</Badge>{/if}
  {/snippet}

  {#snippet topbar()}
    <!-- The live WebSocket, as a tone rather than a hand-mixed green. The kit
         takes the tone as a prop; naming status.connected inside the
         expression is what makes it re-evaluate when the socket drops. -->
    <Pill tone={status.connected ? 'success' : 'muted'}>
      {status.connected ? 'live' : 'offline'}
    </Pill>

    <Button treatment="ghost" id="palette-open" onclick={() => commandPalette.show()}>
      Search <Kbd>⌘K</Kbd>
    </Button>

    {#if session.user}
      <DropdownMenu>
        {#snippet trigger()}
          <Button treatment="ghost" id="bell" aria-label="Notifications">
            🔔{#if unread}<Badge tone="danger" id="bell-count">{unread}</Badge>{/if}
          </Button>
        {/snippet}

        {#if fresh.length}
          <DropdownGroup heading="Unread">
            {#each fresh as note}
              <DropdownItem tone="info" onclick={() => openNote(note)}>
                <!-- A pulsing dot is the unread marker rather than a word: the
                     row already carries the notification's own words, and the
                     dot names itself for a screen reader. -->
                <Dot tone="info" pulse label="unread" />
                {note.data?.title ?? note.type} — {note.data?.body ?? ''}
              </DropdownItem>
            {/each}
          </DropdownGroup>
        {/if}

        {#if fresh.length && seen.length}<DropdownSeparator />{/if}

        {#if seen.length}
          <DropdownGroup heading="Earlier">
            {#each seen as note}
              <DropdownItem onclick={() => openNote(note)}>
                {note.data?.title ?? note.type} — {note.data?.body ?? ''}
              </DropdownItem>
            {/each}
          </DropdownGroup>
        {/if}

        {#if !notes().length}
          <DropdownItem disabled>Nothing yet</DropdownItem>
        {/if}
      </DropdownMenu>

      <!--
        The badge is the identity; the status is the STANDING, and they are
        two facts. `verifiedAt: null` is what puts a registered account at
        level 1 — api/gate.ts says so — so an account that has not verified
        reads `pending` here rather than looking identical to one that has and
        differing only in a number.
      -->
      <AccountStatus
        status={session.level >= 4 ? 'active' : 'pending'}
        sub={'level ' + session.level}
      />
      <Badge tone="info">{session.user.email} · level {session.level}</Badge>
    {:else}
      <Button treatment="outlined" onclick={() => as('user')}  disabled={busy}>Sign in (user)</Button>
      <Button tone="primary"  onclick={() => as('admin')} disabled={busy}>Sign in (admin)</Button>
      <a class="navlink" id="nav-sign-in" href="/sign-in/">Sign in…</a>
      {#each providers as name}
        <!-- signInWithProvider LEAVES THE PAGE — the flow is a browser navigation, so
             nothing after it runs and there is no promise to await. -->
        <Button
          treatment="ghost"
          data-oauth={name}
          onclick={() => getClient().auth.signInWithProvider(name, { returnTo: page.pathname + page.search })}
        >Continue with {name}</Button>
      {/each}
    {/if}
  {/snippet}

  {#if session.error}
    <Alert tone="danger" id="session-error">{session.error}</Alert>
  {/if}

  <!--
    A password was accepted and nothing is signed in yet: no token is stored and
    no socket is open until this box is answered. `one-time-code` is what lets a
    phone offer the code from the message it just received.
  -->
  {#if session.awaitingCode}
    <form class="card stack" id="code-box" style="max-width: 28rem"
          onsubmit={e => { e.preventDefault(); verify() }}>
      <h2 class="h4">Enter the code from your authenticator</h2>
      <p class="text-sm text-muted">A recovery code works here too. This attempt lapses at {lapses(session.awaitingCode)}.</p>
      <Field label="Code">
        <Input id="code-input" bind:value={code} autocomplete="one-time-code" required />
      </Field>
      <div class="cluster">
        <Button type="submit" id="code-submit" disabled={codeBusy}>Verify</Button>
        <Button treatment="ghost" id="code-cancel" onclick={out}>Start over</Button>
      </div>
    </form>
  {/if}

  <!--
    How a provider sign-in ended. It cannot arrive the way session.error does:
    the callback is a redirect, so there is no promise to reject — the only
    channel back is a query parameter, which sierra lifts off the URL at boot.

    TWO TONES, from one field. `link_required` is not a failure — the flow
    worked and the next step is in the person's inbox — and rendering all five
    codes in one red alert says the opposite. The sentence comes from sierra
    (`session.oauthMessage`) so this app writes no switch; the code is what
    the branch is on.
  -->
  {#if session.oauthError}
    <Alert
      id="oauth-alert"
      tone={session.oauthError === 'link_required' ? 'info' : 'danger'}
    >{session.oauthMessage}</Alert>
  {/if}

  <div class="container stack"><slot /></div>
</Shell>

<!--
  ⌘K anywhere. `mesa:window` is the one place a global key listener belongs —
  a document listener added by hand in a component outlives the component.
-->
<mesa:window onkeydown={(e) => {
  if ((e.metaKey || e.ctrlKey) && e.key === 'k') { e.preventDefault(); commandPalette.toggle() }
}} />

{#if commandPalette.open}
  <CommandPalette items={COMMANDS} onclose={() => commandPalette.hide()} />
{/if}

<!-- One Toaster for the app; anything can call toasts.success(). -->
<Toaster position="bottom-right" />

<!--
  One AlertProvider, and it is not a second Toaster. A toast reports what THIS
  screen just did; a floating alert reports what happened TO the app — the
  socket dropping is nobody's click, so it has no screen to land on.
-->
<AlertProvider />
