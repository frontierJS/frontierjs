<script module>
  // web/src/resources/PlanVersion.mesa — the Resource layer.
  //
  // Named for the model, exporting the accessor — see Order.mesa.
  //
  // The rows nothing edits. `price` and `effectiveFrom` are `@immutable`
  // (`FJS-D162`), so the Data boundary refuses a PATCH naming either BY NAME —
  // which is what makes *a price is a statement about a window* a rule rather
  // than a convention. `@immutable` reaches the client as `readOnly` in the
  // UPDATE schema alone, so the create form below still offers a price box and
  // an edit form would not.

  import { createResource } from '@frontierjs/sierra/junction'

  export const planVersions = createResource('plan-versions', { model: 'PlanVersion' })
</script>

<script>
  // …and the markup half is this model's DEFAULT form (repo Invariant 18).
  //
  // **This is the form the money control was built for.** `price` is
  // `@money(USD)`, so what the column holds is a whole number of CENTS and what
  // a person types is dollars — and without a control that knows the
  // difference, somebody raising a plan to twenty-nine dollars types 29 and the
  // shop charges twenty-nine cents, with every screen agreeing (`FJS-582`).
  // The control is registered in `web/src/money-control.js` off `x-money` on
  // the rule, so nothing here names a currency, a step or a divisor.
  //
  // The plan's own screen passes `only={['price']}` and an `onsubmit` that
  // calls `plans.reprice`, because closing one window and opening the next is
  // one write and a create is not it — see api/src/services/plans.service.ts.
  import Form   from '@frontierjs/ui/components/forms/Form.mesa'
  import Button from '@frontierjs/ui/components/forms/Button.mesa'

  export let record      = undefined
  export let method      = undefined
  export let submitLabel = 'Save'
  export let cancelHref  = null
  export let oncancel    = null
  export let submitId    = undefined
  export let actions     = null
  export let only        = undefined   // the reprice form narrows to `price`
  export let onsubmit    = undefined   // …and replaces the request with reprice
</script>

<Form resource={planVersions} bind:record={record} {method} {only} {onsubmit} {actions} {...$attributes}>
  <!--
    Both buttons unconditionally, and that is not a style choice: `slot=` is an
    attribute on an ELEMENT, so an `{#if}` wrapping one is itself default
    content — which turns the generated field list off (`auto ?? !$slots.default`)
    and leaves a form with no price box in it and nothing saying so.
  -->
  <Button slot="actions" type="submit" id={submitId}>{submitLabel}</Button>
  <Button slot="actions" variant="ghost" href={cancelHref} onclick={oncancel}>Cancel</Button>
</Form>
