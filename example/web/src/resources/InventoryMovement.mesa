<script module>
  // web/src/resources/InventoryMovement.mesa — the Resource layer.
  //
  // Named for the model, exporting the service name (`FJS-D1751`): the model is
  // InventoryMovement, the service `inventoryMovements`, and this file exports
  // `inventoryMovements`. `model:` stays stated so the entry key is the model's.
  //
  // ─── Why this file has no markup half ─────────────────────────────────────
  //
  // A resource file carries its model's default form, and this model has none
  // to carry: `InventoryMovement` is `@@gate(5.5.9.9)` — append-only, with
  // update and delete LOCKED at 9, which nothing passes including `asSystem()`.
  // A movement is written beside a shelf moving, by `inventoryMovements.receive` and
  // `inventoryMovements.adjust`, and a generated form over the row itself would offer to
  // file one on its own — a ledger entry with nothing behind it, which is the
  // exact drift the table exists to make impossible.
  //
  // The two forms that DO exist are on /inventory/ and are hand-written, for
  // the reason the checkout form is: their payloads are `type StockReceipt` and
  // `type StockAdjustment` in db/schema.lite, which are not models, so there is
  // no record to generate a form from.

  import { createResource } from '@frontierjs/sierra/resource'

  // ─── offlineQuery — what a stockroom must already have ────────────────────
  //
  // The ledger the /inventory/ screen opens on, warmed at boot and on every
  // reconnect so the screen has it the FIRST time it is opened with no network
  // (`FJS-D307`). The cache underneath only ever remembers a read that arrived,
  // which means it can only answer a question somebody already asked — and
  // *which screens did I visit before I lost signal* is not something a person
  // in a basement can have planned.
  //
  // The directives are the screen's own, character for character. The cache is
  // keyed by the QUESTION, so a warm under a different `limit` fills a slot that
  // screen never reads, and nothing about the app looks wrong until the outage.
  export const inventoryMovements = createResource('inventoryMovements', {
    model:        'InventoryMovement',
    offlineQuery: { directives: { limit: 40, orderBy: '-id' } },
  })
</script>
