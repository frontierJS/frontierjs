<script module>
  // web/src/resources/ProductVariant.mesa — the Resource layer.
  //
  // Named for the model, exporting the accessor — see Order.mesa for the split
  // and why the filename carries it.
  //
  // `model:` is STATED here, and this is the case the option exists for. The
  // registry resolves a model from the service name by inflection, and the
  // service is called `product-variants` because that is its URL segment —
  // which singularizes to `product-variant`, a model name nothing declares.
  // A miss warns and degrades to a bare `make()`, so the symptom would be a
  // form with no fields rather than an error.

  import { createResource } from '@frontierjs/sierra/resource'

  // ─── offlineQuery — and it is a FOREIGN KEY that makes it required ────────
  //
  // `ProductVariant` declares `@@sync(field)`, which puts it in the schema the
  // device gets — and `InventoryMovement`, which the stockroom already
  // hydrates, has a relation to it. Before the policy the device held no
  // variant table at all, so that column was an inert number; with the table
  // there the constraint is real, and hydrating movements against an empty
  // variants table fails the whole batch with a FOREIGN KEY error the screen
  // never sees.
  //
  // So this is warmed too, and **it is imported BEFORE the movements in
  // `main.js`**: the warm walks the declarations in the order they registered,
  // so on a device that order is the order the tables fill.
  export const productVariants = createResource('product-variants', {
    model:        'ProductVariant',
    offlineQuery: { directives: { limit: 200, orderBy: '-id' } },
  })
</script>
