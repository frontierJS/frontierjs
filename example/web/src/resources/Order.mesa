<script module>
  // web/src/resources/Order.mesa — the Resource layer.
  //
  // A Resource is a UI-realm noun, so it is a .mesa file. The data half is
  // module scope, which is what `<script module>` means — it runs once at
  // import, shared by every instance, and its named exports are importable by
  // any other module (Mesa VISION §11, rule 30). Markup below it would be this
  // model's DEFAULT form; there is none here because `orders` is edited through
  // the order screen's own state machine rather than a plain form.
  //
  // **The file is named for the MODEL, not the service** — `Order.mesa`, not
  // `orders.mesa` (repo Invariant 19). The export stays `orders`, because that
  // is the accessor: the same split the Data realm already makes between
  // `model Order` and `db.order`. It also puts the irregular cases in the
  // filename, where they are visible — `AlertRule.mesa` exporting `alerts` says
  // out loud that regular pluralisation does not bridge those two.
  //
  // Read this file next to db/schema.lite. Nothing here restates anything there:
  // no field list, no types, no enum values, no required list, no relations, no
  // gate levels. A resource names a model. That is the whole file.
  //
  // It used to name a model and turn on three flags — coerce, validate,
  // blankToNull — with a paragraph each explaining why you would want them.
  // Every resource in this app set all three, and so did eight of the nine in
  // packages/basecamp, because each one answers something the DOM does that the
  // schema has already said no to: every control hands back a string when
  // `total` is a Float, and an untouched text box submits '' when SQLite will
  // not treat that as the NULL a nullable column wants. A flag that every app
  // turns on is a default, so as of 2026-08-06 they are on and the reasoning
  // lives once, in createResource's own header.

  import { createResource } from '@frontierjs/sierra/junction'

  export const orders = createResource('orders')
</script>

<script>
  // …and the markup half is this model's DEFAULT form (repo Invariant 18).
  //
  // <Form> with no children renders every WRITABLE column in schema order,
  // each with the control its type implies: `status` is a select over the
  // enum's members, `customerId` a picker whose rows come from the Customer
  // relation, `total` a number, the rest text. Not one of those names is
  // written down here, and `trackingCode` is absent for the same reason —
  // `@system` on the column, so it reaches the browser as `readOnly` and the
  // control table has no control for one. This app's only hard-coded field
  // name lived on the create page until then (`FJS-095`).
  //
  // <Form> also owns submit, in-flight state, the reveal rule, and the map
  // from a rejection to a message under the right control — including a 401,
  // which arrives with no field information and lands in the form-level Alert.
  // It sets `novalidate` itself, which is load-bearing: the kit's controls put
  // a real `required` on the input, so the browser's own constraint validation
  // would refuse to fire submit at all while one is empty — silently in a
  // headless browser. The message this app shows is the one authored in
  // db/schema.lite.
  import Form   from '@frontierjs/ui/components/forms/Form.mesa'
  import Button from '@frontierjs/ui/components/forms/Button.mesa'

  export let record      = undefined   // absent → Form makes one from the schema
  export let method      = undefined   // Form's auto | create | patch
  export let submitLabel = 'Save'
  export let cancelHref  = null        // Cancel navigates…
  export let oncancel    = null        // …or calls back, for a drawer
  export let submitId    = undefined   // a drive needs to find the button
  export let actions     = null        // snippet — replaces the whole button row

  // Everything else — class, style, ondone, onerror, showError — rides
  // $attributes onto <Form>, which is where those props are declared.
</script>

<Form resource={orders} bind:record={record} {method} {actions} {...$attributes}>
  <!--
    `slot="actions"` rather than children: children mean "I am writing this
    form myself" and turn the generated field list off, where a named slot does
    not. <Form> puts them in a `.cluster` so a button row is a row, and two
    elements may name the same slot.

    No `loading`, no `disabled`, no "Saving…" — a type="submit" button inside a
    <Form> reads the form's in-flight state from context and disables and spins
    on its own. Cancel does not, and must not: you abandon a save while it runs.
  -->
  <Button slot="actions" type="submit" id={submitId}>{submitLabel}</Button>
  <Button slot="actions" variant="ghost" href={cancelHref} onclick={oncancel}>Cancel</Button>
</Form>
