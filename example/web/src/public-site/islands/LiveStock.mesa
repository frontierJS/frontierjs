<!--
  What the shop can sell RIGHT NOW — an island that talks to the API.

  Two things are being proved here that CatalogList cannot prove:

  1. `client:visible`. This sits below the fold, so its chunk is not fetched
     until it is scrolled to. A page whose every island is `client:load` never
     shows the difference.
  2. A prerendered page can go live. The list above is a build-time snapshot;
     availability is not something to bake into a file that a CDN will hold for
     a week. So this asks the running API — through the Junction browser
     client, the same seam the SPA uses, not a hand-rolled fetch.

  The client is created inside $onMount and not at module scope: an island's
  body also runs during the static render, where there is no window and no
  origin to talk to. `$onMount` is a no-op on the server, which is what makes
  that safe rather than merely lucky.

  Anonymous on purpose. `Product` reads at level 0 — that is why this page is
  allowed to be public at all — so the fallback text is the truth for a reader
  with the API down, not an error dialog.
-->
<script>
  import { createJunctionClient } from '@frontierjs/junction/client'

  let state    = 'loading'   // loading | ready | offline
  let live     = []

  $onMount(async () => {
    try {
      // apiPrefix matches the app's own — api/app.ts mounts services at /api.
      const client = createJunctionClient({ apiPrefix: '/api' })
      // Two traps in one line, both paid for in this drive:
      //   findData(), not find() — find() answers the list ENVELOPE
      //     ({ kind, object, data, total }) and only `data` is the rows;
      //   limit goes in the SECOND argument — the first is the filter, and
      //     `find({ limit: 100 })` asks for products whose `limit` column is
      //     100, which is an empty list and not an error (ISSUES FJS-104).
      live  = await client.service('products').findData({}, { limit: 100 })
      state = 'ready'
    } catch {
      // A static page must survive its API being down: it is still a
      // catalogue, it just cannot say what is in stock.
      state = 'offline'
    }
  })

  const sellable = live.filter(p => p.active)
</script>

<section class="stack" id="live-stock">
  <h2 class="h4">Available now</h2>

  {#if state === 'loading'}
    <p class="text-muted" id="live-stock-state">Checking with the shop…</p>
  {:else if state === 'offline'}
    <p class="text-muted" id="live-stock-state">
      The catalogue above is up to date as of the last build; live availability is unavailable.
    </p>
  {:else}
    <p class="text-muted" id="live-stock-state">
      <strong id="live-stock-count">{sellable.length}</strong> of {live.length} products can be ordered today.
    </p>
    <ul class="list" id="live-stock-list">
      {#each sellable as p}
        <li class="list-row" data-sku={p.sku}>
          <strong>{p.name}</strong>
          <span class="badge">{p.price}</span>
        </li>
      {/each}
    </ul>
  {/if}
</section>
