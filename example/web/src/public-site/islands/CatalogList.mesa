<!--
  The catalogue list — prerendered, then live.

  This is an ISLAND. The build renders it to plain HTML inside comment markers
  (so a crawler and a reader with no JavaScript see every product), and
  `client:load` on the call site makes Sierra ship one chunk that mounts it for
  real. Mounting REPLACES the prerendered markup with a live render, which is
  why the search box only does something after the chunk has run — and why the
  drive asserts a click and not a snapshot.

  `products` arrives as a PROP, serialised into the marker at build time. The
  island makes no request: the data was read once, at build, through the app's
  own Litestone client, and checked against `Product`'s @@gate before this page
  was allowed to exist.
-->
<script>
  export let products = []

  let q = ''

  const needle  = q.trim().toLowerCase()
  const matches = products.filter(p =>
    !needle || `${p.name} ${p.sku}`.toLowerCase().includes(needle)
  )
</script>

<div class="stack">
  <div class="field-group">
    <label class="label" for="catalog-search">Search the catalogue</label>
    <input
      id="catalog-search"
      class="input"
      type="search"
      autocomplete="off"
      placeholder="name or SKU"
      bind:value={q}
    />
  </div>

  <p id="catalog-count" class="text-sm text-muted">
    {matches.length} of {products.length} products
  </p>

  <ul class="list" id="catalog-list">
    {#each matches as p}
      <li class="list-row" data-sku={p.sku}>
        <strong>{p.name}</strong>
        <span class="badge">{p.sku}</span>
      </li>
    {/each}
  </ul>

  {#if matches.length === 0}
    <p id="catalog-empty" class="text-muted">Nothing here matches “{q}”.</p>
  {/if}
</div>
