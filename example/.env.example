# example/.env — copy to .env (gitignored) and fill in what you need.
#
# Everything here has a working dev default, so `bun run api` runs with none of
# it set. What each value BUYS is a real credential against a real service
# instead of the stand-in listener the app starts for itself.

# Encryption at rest. 32 bytes as hex — `openssl rand -hex 32`.
# Parsed as hex, so 64 characters is not necessarily 32 bytes: non-hex padding
# decodes short and is refused.
ENCRYPTION_KEY=

# ─── Stripe ─────────────────────────────────────────────────────────────────
#
# STRIPE_URL is the switch. Without it the connector talks to the dev Stripe on
# :8114 and a real key below is never used — which looks like it works.
#
# STRIPE_URL=https://api.stripe.com
# STRIPE_SECRET_KEY=sk_test_...
#
# The webhook secret is NOT on the API-keys screen: it belongs to an endpoint.
# For a local forward, `stripe listen --forward-to localhost:8110/api/webhooks/stripe`
# prints it. Stripe cannot reach your laptop otherwise.
# STRIPE_WEBHOOK_SECRET=whsec_...
#
# The PUBLISHABLE key (pk_...) has no home in this app. It is a browser
# credential for Stripe.js, and nothing here collects card details.

# ─── The other stand-ins ────────────────────────────────────────────────────
# Each has a dev default; set the URL to point at something real.
# MAIL_SINK_URL= / SHOP_MAIL_KEY=            mail   (dev sink on :8111)
# PSP_URL=       / SHOP_PSP_KEY=             payments (dev sink on :8112)
#                  SHOP_PSP_WEBHOOK_SECRET=
# IDP_URL=                                   OAuth  (dev sink on :8113)
