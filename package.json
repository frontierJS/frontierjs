{
  "name": "frontierjs",
  "version": "0.0.0",
  "private": true,
  "registers": {
    "prefix": "FJS"
  },
  "workspaces": [
    "packages/*",
    "packages/sierra/example",
    "example",
    "website",
    "packages/conduits/*"
  ],
  "scripts": {
    "build": "bun run --filter '*' build",
    "test": "bun run --filter '*' test",
    "typecheck": "bun run --filter '*' typecheck",
    "ci": "node scripts/ci.mjs",
    "ci:fast": "node scripts/ci.mjs --fast",
    "prep": "node scripts/prep.mjs",
    "hooks:install": "node scripts/install-hooks.mjs",
    "fix:loop": "bun scripts/fix-loop.mjs",
    "frame:loop": "bun scripts/frame-loop.mjs",
    "stress:loop": "bun scripts/stress-loop.mjs",
    "feed:loop": "bun scripts/feed-loop.mjs",
    "loop:review": "bun scripts/loop-review.mjs",
    "skills:reach": "bun scripts/skill-reach.mjs"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.8",
    "bun-types": "^1.3.14",
    "typescript": "^5.9.3"
  }
}
