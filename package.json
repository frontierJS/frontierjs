{
  "name": "frontierjs",
  "version": "0.0.0",
  "private": true,
  "workspaces": [
    "packages/*",
    "packages/sierra/example",
    "example"
  ],
  "scripts": {
    "build":         "bun run --filter '*' build",
    "test":          "bun run --filter '*' test",
    "typecheck":     "bun run --filter '*' typecheck",
    "ci":            "node scripts/ci.mjs",
    "ci:fast":       "node scripts/ci.mjs --fast",
    "hooks:install": "node scripts/install-hooks.mjs"
  },
  "devDependencies": {
    "typescript": "^5.0.0",
    "bun-types": "^1.3.14"
  }
}
